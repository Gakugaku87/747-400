{
  "name": "aero_rotation",
  "description": "測定（合否なし、全シナリオの実行に入れない）：離陸の引き起こしと浮揚（FCTM p.95–96：VR で毎秒約 2.5° の滑らかな引き起こしを 15° へ、浮揚はその約 3〜5 秒後、フラップ 20 で姿勢約 10°。尾部の接地は 12.5°（脚が伸びた状態）：p.96）。RJAA 34L でエンジン運転中に始め（機体を読み直す、約 270 t）、フラップ 20、s109 と同じ離陸トリム、最大推力。VR（FMC の表：270 t・フラップ 20・海面で 128 kt）で FlyWithLua の B747_rotate.lua（目標の姿勢を毎秒 2.5° で 15° まで上げ、操縦輪で追う）を始め、浮いた時刻と姿勢、35 ft の姿勢を mark と記録から読む（notes/AERO.md §3.13）",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "cmd", "note": "離陸トリム（s109 と同じ：代替トリムで機首下げを 5.2 秒）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "check", "note": "トリムは比 −0.28〜−0.42", "dref": "sim/flightmodel2/controls/elevator_trim", "op": "between", "value": [-0.42, -0.28] },
    { "do": "snapshot", "note": "重さと VR", "drefs": [ "sim/flightmodel/weight/m_total", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/airspeed/Vr", "laminar/B747/airspeed/V2" ] },
    { "do": "wait", "note": "フラップ 20 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 19.5, "timeout": 120 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "FMC の離陸フラップ 20（TAKEOFF REF の代わり。CONFIG FLAPS が比べる値）", "dref": "laminar/B747/airspeed/flapsRef", "value": 20 },
    { "do": "record_start" },
    { "do": "mark", "note": "1：離陸滑走" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "watch", "note": "VR 128 kt まで CONFIG FLAPS が出ない（フラップ 20 と FMC の 20。2026-10-30〜11-02 は X-Plane の翼の 15.1° と比べて出た：notes/AERO.md §3.13）", "dref": "laminar/B747/CAS/warning_status[2]", "max": 0, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 128 }, "timeout": 90 },
    { "do": "mark", "note": "2：VR、引き起こし" },
    { "do": "cmd", "note": "毎秒 2.5° で 15° へ（B747_rotate.lua）", "name": "FlyWithLua/B747_rotate/start" },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "mark", "note": "3：浮揚" },
    { "do": "snapshot", "note": "浮揚", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "B747/test/rotate_target" ] },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 35 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 35, "timeout": 30 },
    { "do": "mark", "note": "4：35 ft" },
    { "do": "snapshot", "note": "35 ft", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot" ] },
    { "do": "wait", "note": "電波高度 400 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 400, "timeout": 60 },
    { "do": "cmd", "note": "引き起こしの操縦を終える", "name": "FlyWithLua/B747_rotate/stop" },
    { "do": "set", "note": "操縦輪を中立に", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "record_stop" }
  ]
}
