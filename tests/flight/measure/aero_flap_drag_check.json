{
  "name": "aero_flap_drag_check",
  "description": "測定（合否なし、全シナリオの実行に入れない）：フラップを出した形態の抵抗の確かめ（2026-11-02、notes/AERO.md §3.13：acf のフラップと前縁の抵抗の係数を変えた後）。aero_flap_drag.json の前半と同じ（銚子沖の海上 5,000 ft、FCOM PI.10.39–10.40 の形態と速さ、約 270 t）に、フラップ UP（230 kt）と 1（210 kt）を足し、係数は変えない",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 1524.0, "heading_true": 90, "speed_in_meters_per_second": 118.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 5000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 230 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 230 },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "snapshot", "note": "acf の値", "drefs": [ "sim/aircraft/controls/acf_flap_cd", "sim/aircraft/controls/acf_flap2_cd", "sim/aircraft/controls/acf_slat_cd", "sim/aircraft/controls/acf_slat2_cd", "sim/flightmodel/weight/m_total" ] },
    { "do": "record_start" },
    { "do": "wait", "note": "230 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [228, 232], "timeout": 150 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "0a：フラップ UP、230 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "MCP 速度 210 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 210 },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.1667 },
    { "do": "wait", "note": "210 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [208, 212], "timeout": 150 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "0b：フラップ 1、210 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "MCP 速度 190 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 190 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "wait", "note": "フラップ 5 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 4.5, "timeout": 120 },
    { "do": "wait", "note": "190 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [188, 192], "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "1：フラップ 5、190 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "wait", "note": "フラップ 10 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 9.5, "timeout": 120 },
    { "do": "wait", "note": "170 kt（最小機動速度の保護で数 kt 上になることがある）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [168, 176], "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "2：フラップ 10、170 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "wait", "note": "フラップ 20 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 19.5, "timeout": 120 },
    { "do": "wait", "note": "脚が下りる", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": ">", "value": 0.99, "timeout": 60 },
    { "do": "wait", "note": "160 kt（同上）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [158, 168], "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "3：フラップ 20・脚下げ、160 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "MCP 速度 165 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 165 },
    { "do": "set", "note": "レバー 25", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.8333 },
    { "do": "wait", "note": "フラップ 25 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 21.5, "timeout": 120 },
    { "do": "wait", "note": "165 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [163, 168], "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "4：フラップ 25・脚下げ、165 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "MCP 速度 159 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 159 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "wait", "note": "フラップ 30 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 29.5, "timeout": 120 },
    { "do": "wait", "note": "159 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [157, 162], "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "5：フラップ 30・脚下げ、159 kt" },
    { "do": "sleep", "seconds": 32 },
    { "do": "record_stop" }
  ]
}
