{
  "name": "aero_gear_down",
  "description": "測定（合否なし、全シナリオの実行に入れない）：脚下げ・フラップ上げの抵抗（FCOM PI.16.3 (p.303) の Gear Down の Long Range Cruise Control：260 t で 10,000 ft・244 KIAS・EPR 1.13、280 t で 252 KIAS・1.15）と、脚の抵抗の補正（B747.45.xt.aero_corr.lua、notes/AERO.md §3.16）の効き。銚子沖の海上 10,000 ft・東向きで開始（機体を読み直す、約 270 t）。A/P の ALT HOLD・HDG SEL と A/T の SPD で、脚下げのまま表の速さ（270 t の内挿：248 kt）で水平飛行を mark（1：補正あり）、laminar/B747/debug/aero_corr_off を 1 にして mark（2：X-Plane の脚だけ。1 との推力の差が補正の力）、戻して脚上げで mark（3）。読むのは EPR（表示：EPR のモデル）と抵抗（notes/AERO.md §3.13・§3.16）。2026-11-02 までは 17,000 ft の点もあったが、V/S で上がらず 10,000 ft のままだった",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 90, "speed_in_meters_per_second": 145.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "補正あり（前の回の残りを消す）", "dref": "laminar/B747/debug/aero_corr_off", "value": 0 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 10000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 248 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 248 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "snapshot", "note": "重さ", "drefs": [ "sim/flightmodel/weight/m_total" ] },
    { "do": "record_start" },
    { "do": "wait", "note": "脚が下りる", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": ">", "value": 0.99, "timeout": 60 },
    { "do": "wait", "note": "248 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [246, 250], "timeout": 150 },
    { "do": "sleep", "seconds": 40, "note": "落ち着く" },
    { "do": "snapshot", "note": "補正の力（脚下げ）", "drefs": [ "sim/aircraft/bodies/acf_fuse_cd", "sim/flightmodel/forces/drag_path_axis", "sim/flightmodel/misc/cd_overall", "laminar/B747/debug/aero_corr_off" ] },
    { "do": "mark", "note": "1：脚下げ・フラップ上げ、10,000 ft・248 kt（補正あり）" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "補正を切る", "dref": "laminar/B747/debug/aero_corr_off", "value": 1 },
    { "do": "sleep", "seconds": 45, "note": "落ち着く" },
    { "do": "snapshot", "note": "補正の力（切った）", "drefs": [ "sim/aircraft/bodies/acf_fuse_cd", "sim/flightmodel/forces/drag_path_axis", "sim/flightmodel/misc/cd_overall", "laminar/B747/debug/aero_corr_off" ] },
    { "do": "mark", "note": "2：脚下げ・フラップ上げ、10,000 ft・248 kt（補正なし：X-Plane の脚だけ）" },
    { "do": "sleep", "seconds": 32 },
    { "do": "set", "note": "補正を戻す", "dref": "laminar/B747/debug/aero_corr_off", "value": 0 },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "脚が上がる", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "<", "value": 0.01, "timeout": 60 },
    { "do": "sleep", "seconds": 45, "note": "落ち着く" },
    { "do": "snapshot", "note": "補正の力（脚上げ）", "drefs": [ "sim/aircraft/bodies/acf_fuse_cd", "sim/flightmodel/forces/drag_path_axis", "sim/flightmodel/misc/cd_overall" ] },
    { "do": "mark", "note": "3：脚上げ・フラップ上げ、10,000 ft・248 kt（脚の分の比べ）" },
    { "do": "sleep", "seconds": 32 },
    { "do": "record_stop" }
  ]
}
