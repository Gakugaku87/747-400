{
  "name": "aero_idle_taxi",
  "description": "測定（合否なし、全シナリオの実行に入れない）：地上のアイドルの推力で地上滑走を保てるか（FCTM p.76：アイドルでほとんどの条件の地上滑走に足り、動き出すには少し上の推力が要る）。RJAA 34L でエンジン運転中に始め、パーキング・ブレーキを外してアイドルのまま 30 秒（動き出すか）、レバー 0.3 で 20 kt にしてアイドルに戻し、X-Plane のアイドルの比を EEC の地上の最小アイドル（約 1.07）・1.3・1.6 と上げてそれぞれ 45 秒（low_idle_ratio：X-Plane は low と high の大きい方を使う。2026-10-30 の aero_idle_ground）。速度の変わり方から転がり抵抗を出す（`luajit tests/flight/tools/idle_sweep.lua <記録のフォルダー>` の各 mark の後の窓と対地速度）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 15 },
    { "do": "snapshot", "note": "開始", "drefs": [ "sim/flightmodel/weight/m_total", "sim/weather/aircraft/temperature_ambient_deg_c", "sim/aircraft2/engine/high_idle_ratio", "sim/aircraft2/engine/low_idle_ratio", "sim/flightmodel/engine/POINT_thrust[0]", "sim/flightmodel/position/groundspeed" ] },
    { "do": "record_start" },
    { "do": "mark", "note": "1：ブレーキを外す（アイドル、地上の最小アイドル）" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 30 },
    { "do": "snapshot", "note": "30 秒後（動き出したか）", "drefs": [ "sim/flightmodel/position/groundspeed", "sim/flightmodel/engine/POINT_thrust[0]" ] },
    { "do": "set", "note": "レバー 0.3", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.3 },
    { "do": "wait", "note": "20 kt", "dref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 10.3, "timeout": 90 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 8, "note": "エンジンが下がる" },
    { "do": "mark", "note": "2：アイドル（地上の最小アイドル）" },
    { "do": "sleep", "seconds": 45 },
    { "do": "set", "note": "アイドルの比 1.3", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.3 },
    { "do": "sleep", "seconds": 8 },
    { "do": "mark", "note": "3：アイドルの比 1.3" },
    { "do": "sleep", "seconds": 45 },
    { "do": "set", "note": "アイドルの比 1.6", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.6 },
    { "do": "sleep", "seconds": 8 },
    { "do": "mark", "note": "4：アイドルの比 1.6" },
    { "do": "sleep", "seconds": 45 },
    { "do": "snapshot", "note": "終わり", "drefs": [ "sim/flightmodel/position/groundspeed", "sim/flightmodel/engine/POINT_thrust[0]", "sim/aircraft2/engine/low_idle_ratio" ] },
    { "do": "record_stop" },
    { "do": "set", "note": "アイドルの比を戻す", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.0 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 }
  ]
}
