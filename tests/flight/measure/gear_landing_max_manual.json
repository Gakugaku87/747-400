{
  "name": "gear_landing_max_manual",
  "description": "測定（合否なし、全シナリオの実行に入れない）：最大の手のブレーキの着陸距離（GAP_ANALYSIS.md N19-GEAR-01、2026-11-20）。s340 と同じ自動着陸（245 t・フラップ 30・150 kt）で、オートブレーキ OFF、接地で左右のブレーキを全踏み（コマンド sim/flight_controls/brakes_toggle_max：brakes.lua が X-Plane のトウブレーキを上書きするので、left/right_brake_ratio を書いても効かない。2026-11-20 の 1 回目はそれで減速が弱く止まらなかった）、4 発の逆推力いっぱいを 60 kt まで、その後 reverse idle、止まるまで。記録（session.csv の緯度経度）から 50 ft から接地、接地から停止の距離を出し、FCOM PI.12 の乾いた路面・MAX MANUAL（p.275：250 t・海面・無風・4 発の逆推力いっぱい・自動のスピードブレーキで 1,055 m、50 ft から接地 約 305 m を含む）と比べる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 9000.0, 22000.0, 22000.0, 9000.0, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "スピードブレーキを ARM", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "set", "note": "オートブレーキ OFF（手のブレーキで止める）", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 1 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（s114 と同じ）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300, "stop": true },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200, "stop": true },
    { "do": "wait", "note": "FLARE（FMA のピッチ 3）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 3, "timeout": 200, "stop": true },
    { "do": "wait", "note": "接地で FLARE が消える（FCOM p.671）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 0, "timeout": 40, "stop": true },
    { "do": "mark", "note": "接地" },
    { "do": "cmd", "note": "ブレーキ全踏み（brakes_toggle_max。押して離す 0.2 秒：Web API の 0 秒のコマンドは離しが届かない）", "name": "sim/flight_controls/brakes_toggle_max", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "ブレーキ", "drefs": [ "sim/cockpit2/controls/left_brake_ratio", "sim/cockpit2/controls/right_brake_ratio", "laminar/B747/gear/autobrakes/sel_dial_pos", "sim/flightmodel/position/groundspeed" ] },
    { "do": "wait", "note": "スピードブレーキが自動で UP", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": ">", "value": 0.9, "timeout": 5 },
    { "do": "check", "note": "接地の時点で master WARNING なし", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0, "level": "warn" },
    { "do": "mark", "note": "逆推力いっぱい" },
    { "do": "snapshot", "note": "逆推力の前：レバー、空地、油圧、A/T", "drefs": [ "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio[1]", "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio[2]", "sim/cockpit2/engine/actuators/throttle_ratio_all", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/engines/reverser_lockout", "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/gear/air_ground/alt_gnd", "laminar/B747/hydraulics/pressure_2", "laminar/B747/hydraulics/pressure_3", "laminar/B747/autothrottle/servo", "laminar/B747/engine/throttle[1]", "laminar/B747/CAS/advisory_status[127]" ] },
    { "do": "cmd", "note": "逆推力を引く（全エンジン、10 秒：Web API のコマンドは 10 秒まで）：FCOM p.148 の逆推力いっぱい", "name": "sim/engines/thrust_reverse_hold", "duration": 10, "async": true },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "逆推力の 1 秒後", "drefs": [ "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio[1]", "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio[2]", "sim/cockpit2/engine/actuators/throttle_ratio_all", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/engines/reverser_lockout", "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/gear/air_ground/alt_gnd", "laminar/B747/hydraulics/pressure_2", "laminar/B747/hydraulics/pressure_3", "laminar/B747/autothrottle/servo", "laminar/B747/engine/throttle[1]", "laminar/B747/CAS/advisory_status[127]" ] },
    { "do": "wait", "note": "逆推力 2 が展開", "dref": "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "op": ">", "value": 0.98, "timeout": 8 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "逆推力いっぱい", "drefs": [ "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/display_N1[1]", "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "sim/flightmodel/engine/ENGN_thro_use[1]", "laminar/B747/warning/master_warning", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_reverse_full" },
    { "do": "view", "note": "上の EICAS に寄せる", "the": -22, "psi": 29, "fov": 14 },
    { "do": "shot", "name": "eicas_reverse_full_close" },
    { "do": "watch", "note": "逆推力の間、エンジン 2 の EPR は赤くならない（赤は前進推力の max EPR：FCOM p.834、p.873）。60 kt まで", "dref": "laminar/B747/engines/EPR/red_on[1]", "max": 0, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 60 }, "timeout": 60, "level": "warn" },
    { "do": "mark", "note": "60 kt" },
    { "do": "wait", "note": "逆推力のレバーが reverse idle に戻る（hold の終わり）", "dref": "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio[1]", "op": ">", "value": -0.05, "timeout": 25 },
    { "do": "mark", "note": "reverse idle" },
    { "do": "watch", "note": "reverse idle の間、master WARNING が鳴らない（対地 30 kt まで：PFD の速度は 30 kt で止まる）", "dref": "laminar/B747/warning/master_warning", "max": 0, "until": { "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 15.4 }, "timeout": 60, "level": "warn" },
    { "do": "mark", "note": "格納" },
    { "do": "set", "note": "推力レバーを前のアイドルへ（逆推力のレバーを下げきる：格納）", "dref": "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "value": 0 },
    { "do": "watch", "note": "格納の間（レバーを戻した後 15 秒）、master WARNING が鳴らない（離陸形態警報の武装：notes/ATA-31-warning.md §11 の候補 1）", "dref": "laminar/B747/warning/master_warning", "max": 0, "timeout": 15, "level": "warn" },
    { "do": "snapshot", "note": "格納の後", "drefs": [ "laminar/B747/CAS/warning_status[0]", "laminar/B747/CAS/warning_status[2]", "laminar/B747/CAS/warning_status[6]", "laminar/B747/warning/master_warning", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "laminar/B747/engines/display_N1[1]", "laminar/B747/engines/display_EPR[1]", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "cas", "note": "EICAS のメッセージ（格納の後）" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_after_stow" },
    { "do": "mark", "note": "A/P を外す" },
    { "do": "cmd", "note": "操縦輪の A/P 解除スイッチ（1 回目：>AUTOPILOT DISC）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "A/P を外した後", "drefs": [ "laminar/B747/CAS/warning_status[0]", "laminar/B747/warning/master_warning" ] },
    { "do": "cmd", "note": "2 回目（>AUTOPILOT DISC と音が消える：FCOM p.655）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTOPILOT DISC が消える", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "master WARNING が消える", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0 },
    { "do": "cmd", "note": "ブレーキを離す（brakes_toggle_max をもう一度）", "name": "sim/flight_controls/brakes_toggle_max", "duration": 0.2 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
