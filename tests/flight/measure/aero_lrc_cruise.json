    { "do": "mark", "note": "FL310 303 kt" },
    { "do": "sleep", "seconds": 35 },
    { "do": "snapshot", "note": "FL310", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel/misc/machno", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_N1[0]", "sim/flightmodel/engine/POINT_thrust[0]", "sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0]", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "set", "note": "MCP 速度 297 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 297 },
