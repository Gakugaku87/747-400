{
  "name": "aero_holding_terminal",
  "description": "測定（合否なし、全シナリオの実行に入れない）：カスタム acf の空力の比較（PROGRESS.md 5f）、水平飛行。銚子沖の海上 10,000 ft・250 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD・HDG SEL と A/T の SPD で、10,000 ft の待機（FCOM PI.10.39 の Holding：約 270 t の 231 kt）と 290 kt（PI.10.38 の Cruise の 10,000 ft の行）、FLCH で 5,000 ft に降りて終端区域（PI.10.39 の Terminal Area）のフラップ UP（VREF30+80）・1（+60）・5（+40）・10（+20）・20 と脚下げ（+10）。速度は機体の VREF30 とフラップの機動速度（`laminar/B747/airspeed/Vf0`〜`Vf20`）。各形態で落ち着いてから mark。記録は `luajit tests/flight/tools/aero_compare.lua <記録のフォルダー>` で FCOM の姿勢・EPR・N1 と比べる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 90, "speed_in_meters_per_second": 148.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 231 kt（FCOM PI.10.39 の待機：250 t の 224 kt と 300 t の 242 kt の間）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 231 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "wait", "note": "水平飛行に落ち着く", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 90 },
    { "do": "snapshot", "note": "開始の状態（重量・重心・外気温・VREF30）", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/engines/type", "laminar/B747/airspeed/Vref30", "laminar/B747/airspeed/Vf0", "laminar/B747/airspeed/Vf1", "laminar/B747/airspeed/Vf5", "laminar/B747/airspeed/Vf10", "laminar/B747/airspeed/Vf20", "laminar/B747/airspeed/Vf25" ] },
    { "do": "record_start" },

    { "do": "wait", "note": "231 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [229, 233], "timeout": 180 },
    { "do": "sleep", "seconds": 60, "note": "速度と推力が落ち着く" },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "holding 10,000 ft" },
    { "do": "sleep", "seconds": 35 },

    { "do": "set", "note": "MCP 速度 290 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 290 },
    { "do": "wait", "note": "290 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [288, 292], "timeout": 240 },
    { "do": "sleep", "seconds": 60 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "cruise 10,000 ft 290 kt" },
    { "do": "sleep", "seconds": 35 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf0", "as": "vf0" },
    { "do": "set", "note": "MCP 速度 VREF30+80（フラップ UP の機動速度）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf0", "round": 1 },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "5,000 ft で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 400 },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 60 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "terminal area flaps UP" },
    { "do": "sleep", "seconds": 35 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf1", "as": "vf1" },
    { "do": "set", "note": "VREF30+60", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf1", "round": 1 },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.1667 },
    { "do": "sleep", "seconds": 70, "note": "フラップと速度が落ち着く" },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "terminal area flaps 1" },
    { "do": "sleep", "seconds": 35 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf5", "as": "vf5" },
    { "do": "set", "note": "VREF30+40", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf5", "round": 1 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "sleep", "seconds": 70 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "terminal area flaps 5" },
    { "do": "sleep", "seconds": 35 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf10", "as": "vf10" },
    { "do": "set", "note": "VREF30+20", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf10", "round": 1 },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 70 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "terminal area flaps 10" },
    { "do": "sleep", "seconds": 35 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf20", "as": "vf20" },
    { "do": "set", "note": "VREF30+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf20", "round": 1 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "sleep", "seconds": 70 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "terminal area flaps 20, gear down" },
    { "do": "sleep", "seconds": 35 },
    { "do": "snapshot", "note": "終わりの状態", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/flightmodel2/gear/deploy_ratio[0]", "sim/flightmodel2/wing/flap1_deg[0]", "laminar/B747/airspeed/Vref30" ] },
    { "do": "record_stop" }
  ]
}
