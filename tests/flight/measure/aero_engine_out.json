{
  "name": "aero_engine_out",
  "description": "測定（合否なし、全シナリオの実行に入れない）：カスタム acf の空力の比較（PROGRESS.md 5f）、片発の方向の釣り合い（FCTM p.55 (1.25)：エンジン故障ではラダートリムだけで操縦輪を水平にする）。銚子沖の海上 10,000 ft・250 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD・HDG SEL と A/T の SPD で落ち着かせ、エンジン 1 を止める（A/T は残りの 3 発で速度を保つ）。ラダートリムを 0・0.25・0.5・0.75・1（`sim/cockpit2/controls/rudder_trim`、右。ペダルの 80 % の量）と進め、それぞれ落ち着いてから mark（A/P が保つ補助翼とスポイラーの舵角・バンク・横すべりを記録）。補助翼が中立になるトリムが範囲の中にあるかを見る（値の基準は資料に無いので記録だけ）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 90, "speed_in_meters_per_second": 148.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "ラダートリム 0", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "wait", "note": "水平飛行に落ち着く", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 90 },
    { "do": "sleep", "seconds": 30 },
    { "do": "record_start" },
    { "do": "mark", "note": "all engines, trim 0" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "エンジン 1 の故障", "dref": "sim/operation/failures/rel_engfai0", "value": 6 },
    { "do": "sleep", "seconds": 60, "note": "A/T と A/P が落ち着く" },
    { "do": "mark", "note": "engine 1 out, trim 0" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "トリム 0", "drefs": [ "sim/flightmodel2/wing/aileron1_deg[0]", "sim/flightmodel2/wing/aileron1_deg[1]", "sim/flightmodel2/wing/aileron2_deg[0]", "sim/flightmodel2/wing/aileron2_deg[1]", "sim/flightmodel2/wing/spoiler1_deg[2]", "sim/flightmodel2/wing/spoiler1_deg[3]", "sim/flightmodel/position/phi", "sim/flightmodel/position/beta", "sim/flightmodel2/wing/rudder1_deg[0]", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "set", "note": "ラダートリム右 0.25", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.25 },
    { "do": "sleep", "seconds": 40 },
    { "do": "mark", "note": "trim 0.25" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "トリム 0.25", "drefs": [ "sim/flightmodel2/wing/aileron1_deg[0]", "sim/flightmodel2/wing/aileron1_deg[1]", "sim/flightmodel2/wing/aileron2_deg[0]", "sim/flightmodel2/wing/aileron2_deg[1]", "sim/flightmodel2/wing/spoiler1_deg[2]", "sim/flightmodel2/wing/spoiler1_deg[3]", "sim/flightmodel/position/phi", "sim/flightmodel/position/beta", "sim/flightmodel2/wing/rudder1_deg[0]" ] },
    { "do": "set", "note": "ラダートリム右 0.5", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.5 },
    { "do": "sleep", "seconds": 40 },
    { "do": "mark", "note": "trim 0.5" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "トリム 0.5", "drefs": [ "sim/flightmodel2/wing/aileron1_deg[0]", "sim/flightmodel2/wing/aileron1_deg[1]", "sim/flightmodel2/wing/aileron2_deg[0]", "sim/flightmodel2/wing/aileron2_deg[1]", "sim/flightmodel2/wing/spoiler1_deg[2]", "sim/flightmodel2/wing/spoiler1_deg[3]", "sim/flightmodel/position/phi", "sim/flightmodel/position/beta", "sim/flightmodel2/wing/rudder1_deg[0]" ] },
    { "do": "set", "note": "ラダートリム右 0.75", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.75 },
    { "do": "sleep", "seconds": 40 },
    { "do": "mark", "note": "trim 0.75" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "トリム 0.75", "drefs": [ "sim/flightmodel2/wing/aileron1_deg[0]", "sim/flightmodel2/wing/aileron1_deg[1]", "sim/flightmodel2/wing/aileron2_deg[0]", "sim/flightmodel2/wing/aileron2_deg[1]", "sim/flightmodel2/wing/spoiler1_deg[2]", "sim/flightmodel2/wing/spoiler1_deg[3]", "sim/flightmodel/position/phi", "sim/flightmodel/position/beta", "sim/flightmodel2/wing/rudder1_deg[0]" ] },
    { "do": "set", "note": "ラダートリム右いっぱい", "dref": "sim/cockpit2/controls/rudder_trim", "value": 1 },
    { "do": "sleep", "seconds": 40 },
    { "do": "mark", "note": "trim 1" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "トリム 1", "drefs": [ "sim/flightmodel2/wing/aileron1_deg[0]", "sim/flightmodel2/wing/aileron1_deg[1]", "sim/flightmodel2/wing/aileron2_deg[0]", "sim/flightmodel2/wing/aileron2_deg[1]", "sim/flightmodel2/wing/spoiler1_deg[2]", "sim/flightmodel2/wing/spoiler1_deg[3]", "sim/flightmodel/position/phi", "sim/flightmodel/position/beta", "sim/flightmodel2/wing/rudder1_deg[0]" ] },
    { "do": "record_stop" },
    { "do": "set", "note": "ラダートリムを戻す", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 }
  ]
}
