{
  "name": "aero_flaps",
  "description": "測定（合否なし、全シナリオの実行に入れない）：カスタム acf の空力の比較（PROGRESS.md 5f）、フラップごとの水平飛行の姿勢（揚力）。銚子沖の海上 5,000 ft・250 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD・HDG SEL と A/T の SPD で、FCOM PI.10.39 の Terminal Area のフラップ UP（VREF30+80）・1（+60）・5（+40）・10（+20）・20 と脚下げ（+10）、PI.10.40 の Final Approach の速さのフラップ 25（VREF25+10）・30（VREF30+10）を水平で（迎角は 3° の降下と同じ揚力：道具が姿勢から経路角を引いて比べる）。速度は機体の VREF とフラップの機動速度（`laminar/B747/airspeed/Vf0`〜`Vf30`）。各形態で落ち着いてから mark。記録は `luajit tests/flight/tools/aero_compare.lua <記録のフォルダー>`。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 1524.0, "heading_true": 90, "speed_in_meters_per_second": 135.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf0", "as": "vf0" },
    { "do": "set", "note": "VREF30+80", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf0", "round": 1 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "wait", "note": "水平飛行に落ち着く", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 90 },
    { "do": "snapshot", "note": "開始の状態（重量・重心・外気温・VREF）", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/engines/type", "laminar/B747/airspeed/Vref30", "laminar/B747/airspeed/Vf25" ] },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 50 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps UP" },
    { "do": "sleep", "seconds": 32 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf1", "as": "vf1" },
    { "do": "set", "note": "VREF30+60", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf1", "round": 1 },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.1667 },
    { "do": "sleep", "seconds": 60 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps 1" },
    { "do": "sleep", "seconds": 32 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf5", "as": "vf5" },
    { "do": "set", "note": "VREF30+40", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf5", "round": 1 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "sleep", "seconds": 60 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps 5" },
    { "do": "sleep", "seconds": 32 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf10", "as": "vf10" },
    { "do": "set", "note": "VREF30+20", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf10", "round": 1 },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 60 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps 10" },
    { "do": "sleep", "seconds": 32 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf20", "as": "vf20" },
    { "do": "set", "note": "VREF30+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf20", "round": 1 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "sleep", "seconds": 60 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps 20, gear down" },
    { "do": "sleep", "seconds": 32 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf25", "as": "vref25" },
    { "do": "set", "note": "VREF25+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 10, "rel": "vref25", "round": 1 },
    { "do": "set", "note": "レバー 25", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.8333 },
    { "do": "sleep", "seconds": 50 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps 25 level (final approach speed)" },
    { "do": "sleep", "seconds": 32 },

    { "do": "remember", "dref": "laminar/B747/airspeed/Vf30", "as": "vref30" },
    { "do": "set", "note": "VREF30+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 10, "rel": "vref30", "round": 1 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "sleep", "seconds": 50 },
    { "do": "wait", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-100, 100], "timeout": 60 },
    { "do": "mark", "note": "flaps 30 level (final approach speed)" },
    { "do": "sleep", "seconds": 32 },
    { "do": "snapshot", "note": "終わりの状態", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/flightmodel2/gear/deploy_ratio[0]", "sim/flightmodel2/wing/flap1_deg[0]", "sim/flightmodel2/wing/flap2_deg[0]" ] },
    { "do": "record_stop" }
  ]
}
