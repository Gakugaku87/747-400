  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMC の空中の初期化" },
    { "do": "record_start" },
    { "do": "wait", "note": "空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "set", "note": "MCP 高度 FL350", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 35000 },
    { "do": "set", "note": "MCP を Mach に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "note": "窓 M.84", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 84 },
    { "do": "set", "note": "MCP 方位 098（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 98 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "switch", "note": "ALT（空中の初期化の ALT HOLD。違えば押す）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "value": 9, "cmd": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 90, "note": "落ち着かせる（空中開始の上昇と ALT HOLD：air-start settle）" },
    { "do": "cmd", "note": "HDG HOLD", "name": "sim/autopilot/heading_hold" },
    { "do": "snapshot", "note": "doublet の前", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/misc/machno", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "laminar/B747/flt_ctrls/yaw_damper_mode" ] },

    { "do": "mark", "note": "ヨーダンパー OFF" },
    { "do": "switch", "note": "YAW DAMPER UPPER OFF", "dref": "laminar/B747/button_switch/position[82]", "value": 0, "cmd": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "switch", "note": "YAW DAMPER LOWER OFF", "dref": "laminar/B747/button_switch/position[83]", "value": 0, "cmd": "laminar/B747/button_switch/yaw_damper_lwr" },
    { "do": "sleep", "seconds": 8 },
    { "do": "mark", "note": "doublet 右から（YD OFF）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 30 },
    { "do": "mark", "note": "doublet 左から（YD OFF）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 30 },

    { "do": "mark", "note": "ヨーダンパー ON" },
    { "do": "switch", "note": "YAW DAMPER UPPER ON", "dref": "laminar/B747/button_switch/position[82]", "value": 1, "cmd": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "switch", "note": "YAW DAMPER LOWER ON", "dref": "laminar/B747/button_switch/position[83]", "value": 1, "cmd": "laminar/B747/button_switch/yaw_damper_lwr" },
    { "do": "wait", "note": "flight mode（fade-in 5 秒）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 4, "timeout": 15 },
    { "do": "sleep", "seconds": 10 },
    { "do": "mark", "note": "doublet 右から（YD ON）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 30 },
    { "do": "mark", "note": "doublet 左から（YD ON）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 30 },
    { "do": "check", "note": "A/P のまま", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "record_stop" }
  ]
