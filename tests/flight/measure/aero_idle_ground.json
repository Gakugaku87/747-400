{
  "name": "aero_idle_ground",
  "description": "測定（合否なし、全シナリオの実行に入れない）：X-Plane のアイドルの比（idle ratio）と燃料流量の比（ff_rat_idle_JET）を変えたときの、地上の静止アイドルの推力・N1・N2・燃料流量（PROGRESS.md 5f のエンジン）。RJAA 34L でエンジン運転中に始め、パーキング・ブレーキのまま。全エンジンを X-Plane の low idle（idle_speed_ratio 0）にして、EEC が書かない low_idle_ratio を 1.071（EEC の 15 °C の最小アイドルと同じ）・1.5・2.0・2.625・3.0・4.0 と変え、1.071 で ff_rat_idle_JET を 0.05・0.10・0.20 と変える。各値で 20 秒待って mark、その後 20 秒を平均する（`luajit tests/flight/tools/idle_sweep.lua <記録のフォルダー>`）。最後に元に戻す。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "開始（EEC の最小アイドル）", "drefs": [ "sim/weather/aircraft/temperature_ambient_deg_c", "sim/aircraft2/engine/high_idle_ratio", "sim/aircraft2/engine/low_idle_ratio", "sim/cockpit2/engine/actuators/idle_speed_ratio[0]", "sim/aircraft/overflow/ff_rat_idle_JET", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/POINT_thrust[0]", "sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0]", "sim/flightmodel/weight/m_total" ] },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5 },
    { "do": "mark", "note": "1：EEC の最小アイドル（high idle）" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low idle に（1）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[0]", "value": 0 },
    { "do": "set", "note": "low idle に（2）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[1]", "value": 0 },
    { "do": "set", "note": "low idle に（3）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[2]", "value": 0 },
    { "do": "set", "note": "low idle に（4）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[3]", "value": 0 },
    { "do": "set", "note": "low_idle_ratio 1.071", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.071 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "low idle になったか", "drefs": [ "sim/cockpit2/engine/actuators/idle_speed_ratio[0]", "sim/cockpit2/engine/actuators/idle_speed_ratio[3]", "sim/aircraft2/engine/low_idle_ratio", "sim/aircraft2/engine/high_idle_ratio", "sim/flightmodel/engine/ENGN_N2_[0]" ] },
    { "do": "mark", "note": "2：low 1.071" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low_idle_ratio 1.5", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.5 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "3：low 1.5" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low_idle_ratio 2.0", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 2.0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "4：low 2.0" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low_idle_ratio 2.625", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 2.625 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "5：low 2.625" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low_idle_ratio 3.0", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 3.0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "6：low 3.0" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low_idle_ratio 4.0", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 4.0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "7：low 4.0" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "4.0", "drefs": [ "sim/flightmodel/engine/ENGN_N1_[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/POINT_thrust[0]", "sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0]", "sim/flightmodel/position/groundspeed" ] },
    { "do": "set", "note": "low_idle_ratio 1.071", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.071 },
    { "do": "set", "note": "ff_rat_idle_JET 0.05", "dref": "sim/aircraft/overflow/ff_rat_idle_JET", "value": 0.05 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "8：low 1.071・ff 0.05" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "ff_rat_idle_JET 0.10", "dref": "sim/aircraft/overflow/ff_rat_idle_JET", "value": 0.10 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "9：low 1.071・ff 0.10" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "ff_rat_idle_JET 0.20", "dref": "sim/aircraft/overflow/ff_rat_idle_JET", "value": 0.20 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "10：low 1.071・ff 0.20" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "low_idle_ratio 2.625（ff 0.20 のまま）", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 2.625 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "11：low 2.625・ff 0.20" },
    { "do": "sleep", "seconds": 20 },
    { "do": "record_stop" },
    { "do": "set", "note": "ff_rat_idle_JET を戻す", "dref": "sim/aircraft/overflow/ff_rat_idle_JET", "value": 0.01 },
    { "do": "set", "note": "low_idle_ratio を戻す", "dref": "sim/aircraft2/engine/low_idle_ratio", "value": 1.0 },
    { "do": "set", "note": "high idle に（1）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[0]", "value": 1 },
    { "do": "set", "note": "high idle に（2）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[1]", "value": 1 },
    { "do": "set", "note": "high idle に（3）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[2]", "value": 1 },
    { "do": "set", "note": "high idle に（4）", "dref": "sim/cockpit2/engine/actuators/idle_speed_ratio[3]", "value": 1 }
  ]
}
