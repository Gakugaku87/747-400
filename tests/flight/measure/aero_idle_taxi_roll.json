{
  "name": "aero_idle_taxi_roll",
  "description": "測定（合否なし、全シナリオの実行に入れない）：acf の転がり抵抗（`_roll_co`、走行中に `sim/aircraft/overflow/acf_roll_co` で書ける）を 0.020・0.015・0.012 と変えて、地上アイドル（EEC の地上の最小アイドル）で地上滑走を保てるか、止まった所からアイドルで動き出すかを測る（FCTM p.76：アイドルでほとんどの条件の地上滑走に足り、動き出すには少し上の推力が要る。2026-10-30 の利用者の許可で下げる）。RJAA 34L でエンジン運転中に始め、値ごとに、ブレーキを外してアイドルのまま 20 秒（mark）、レバー 0.3 で 20 kt にしてアイドルに戻し 40 秒（mark）、パーキング・ブレーキで止める。`luajit tests/flight/tools/idle_sweep.lua <記録のフォルダー> 20` で各 mark の後の対地速度とその変わり方を読む。最後に acf の値に戻す。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 15 },
    { "do": "snapshot", "note": "開始", "drefs": [ "sim/flightmodel/weight/m_total", "sim/aircraft/overflow/acf_roll_co", "sim/aircraft2/engine/high_idle_ratio", "sim/flightmodel/engine/POINT_thrust[0]" ] },
    { "do": "record_start" },
    { "do": "set", "note": "転がり抵抗 0.020", "dref": "sim/aircraft/overflow/acf_roll_co", "value": 0.020 },
    { "do": "mark", "note": "1：0.020、止まった所からアイドル" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "0.020：20 秒後", "drefs": [ "sim/flightmodel/position/groundspeed" ] },
    { "do": "set", "note": "レバー 0.3", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.3 },
    { "do": "wait", "note": "20 kt", "dref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 10.3, "timeout": 90 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 8, "note": "エンジンが下がる" },
    { "do": "mark", "note": "2：0.020、20 kt からアイドル" },
    { "do": "sleep", "seconds": 40 },
    { "do": "snapshot", "note": "0.020：アイドルで 40 秒", "drefs": [ "sim/flightmodel/position/groundspeed", "sim/flightmodel/engine/POINT_thrust[0]" ] },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 0.2, "timeout": 60 },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "転がり抵抗 0.015", "dref": "sim/aircraft/overflow/acf_roll_co", "value": 0.015 },
    { "do": "mark", "note": "3：0.015、止まった所からアイドル" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "0.015：20 秒後", "drefs": [ "sim/flightmodel/position/groundspeed" ] },
    { "do": "set", "note": "レバー 0.3", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.3 },
    { "do": "wait", "note": "20 kt", "dref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 10.3, "timeout": 90 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 8, "note": "エンジンが下がる" },
    { "do": "mark", "note": "4：0.015、20 kt からアイドル" },
    { "do": "sleep", "seconds": 40 },
    { "do": "snapshot", "note": "0.015：アイドルで 40 秒", "drefs": [ "sim/flightmodel/position/groundspeed", "sim/flightmodel/engine/POINT_thrust[0]" ] },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 0.2, "timeout": 60 },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "転がり抵抗 0.012", "dref": "sim/aircraft/overflow/acf_roll_co", "value": 0.012 },
    { "do": "mark", "note": "5：0.012、止まった所からアイドル" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "0.012：20 秒後", "drefs": [ "sim/flightmodel/position/groundspeed" ] },
    { "do": "set", "note": "レバー 0.3", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.3 },
    { "do": "wait", "note": "20 kt", "dref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 10.3, "timeout": 90 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 8, "note": "エンジンが下がる" },
    { "do": "mark", "note": "6：0.012、20 kt からアイドル" },
    { "do": "sleep", "seconds": 40 },
    { "do": "snapshot", "note": "0.012：アイドルで 40 秒", "drefs": [ "sim/flightmodel/position/groundspeed", "sim/flightmodel/engine/POINT_thrust[0]" ] },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 0.2, "timeout": 60 },
    { "do": "sleep", "seconds": 3 },
    { "do": "record_stop" },
    { "do": "set", "note": "転がり抵抗を acf の値に戻す", "dref": "sim/aircraft/overflow/acf_roll_co", "value": 0.025 }
  ]
}
