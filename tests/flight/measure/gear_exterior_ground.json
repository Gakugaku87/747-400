{
  "name": "gear_exterior_ground",
  "description": "測定（合否なし）：カスタム acf の脚の strut を変えた前後の、地上の脚のたわみと外から見た写真（CLAUDE.md の acf の手順。2026-11-04：主脚の strut の低い方の点を下げると地上で機体が沈む）。RJAA 34L、エンジン運転中、270 t 付近。各脚のたわみ（X-Plane の tire_vrt_def_veh、m：0 が前脚、1〜4 が主脚）と重量を snapshot し、チェースビューと周回のビュー（左後ろの横から）を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": { "definition": "vfr_few_clouds", "vertical_speed_in_thermal_in_feet_per_minute": 0, "wave_height_in_meters": 0.5, "wave_direction_in_degrees": 0, "terrain_state": "dry", "variation_across_region_percentage": 0, "evolution_over_time_enum": "static" }
  },
  "steps": [
    { "do": "sleep", "seconds": 15, "note": "脚が落ち着く" },
    { "do": "snapshot", "note": "重量と各脚のたわみ（m）", "drefs": [
      "sim/flightmodel/weight/m_total",
      "sim/flightmodel/parts/tire_vrt_def_veh[0]", "sim/flightmodel/parts/tire_vrt_def_veh[1]", "sim/flightmodel/parts/tire_vrt_def_veh[2]",
      "sim/flightmodel/parts/tire_vrt_def_veh[3]", "sim/flightmodel/parts/tire_vrt_def_veh[4]",
      "sim/flightmodel/position/theta", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot" ] },
    { "do": "cmd", "note": "チェースビュー", "name": "sim/view/chase" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "gear_chase" },
    { "do": "cmd", "note": "周回のビュー", "name": "sim/view/circle" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "gear_circle", "note": "左後ろの横から、主脚と前脚が見える（2026-11-04：rot_left は機体を回らずカメラの向きを変え、機体が写らなかったので外した）" },
    { "do": "cmd", "note": "操縦席に戻す", "name": "sim/view/3d_cockpit_cmnd_look" },
    { "do": "sleep", "seconds": 2 }
  ]
}
