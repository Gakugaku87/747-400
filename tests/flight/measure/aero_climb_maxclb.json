{
  "name": "aero_climb_maxclb",
  "description": "測定（合否なし、全シナリオの実行に入れない）：カスタム acf の空力の比較（PROGRESS.md 5f）、最大上昇推力の上昇（FCOM PI.10.38 の Climb (290/.84)）。銚子沖の海上 8,000 ft・290 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD・HDG SEL と A/T の SPD で落ち着かせ、FLCH 290 kt（速度は昇降舵）で A/T を切り、FlyWithLua の `B747_epr_hold.lua` でレバーを FCOM PI.10.36 (p.262) の Max Climb EPR（気圧高度と TAT）に合わせて 35,000 ft へ（2026-10-29 の利用者の希望：A/T の CLB の基準は決まった上昇率に要る推力で、最大上昇推力ではない：ATHR-04）。10,000・20,000・30,000 ft を通る所の姿勢と昇降率を、`luajit tests/flight/tools/aero_compare.lua <記録のフォルダー>` で FCOM の表と比べる。合わせた EPR は B747/test/epr_hold_target。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2438.4, "heading_true": 90, "speed_in_meters_per_second": 168.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 8,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 8000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 290 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 290 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "wait", "note": "水平飛行に落ち着く", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 90 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "開始の状態（重量・重心・外気温）", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/weather/aircraft/temperature_ambient_deg_c", "sim/weather/aircraft/temperature_leadingedge_deg_c", "laminar/B747/engines/type" ] },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 35,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "cmd", "note": "FLCH（290 kt、速度は昇降舵）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "cmd", "note": "レバーを Max Climb EPR に（FlyWithLua）", "name": "FlyWithLua/B747_epr_hold/max_climb" },
    { "do": "sleep", "seconds": 30 },
    { "do": "snapshot", "note": "上昇の始め", "drefs": [ "B747/test/epr_hold_target", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_EPR[3]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/cockpit2/engine/actuators/throttle_ratio_all", "sim/weather/aircraft/temperature_leadingedge_deg_c", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "remember", "dref": "B747/test/epr_hold_target", "as": "eprt" },
    { "do": "check", "note": "EPR は合わせた値の ±0.02（推定の許し）", "dref": "sim/flightmodel/engine/ENGN_EPR[0]", "op": "between", "value": [-0.02, 0.02], "rel": "eprt", "level": "warn" },
    { "do": "wait", "note": "10,000 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 10300, "timeout": 300 },
    { "do": "snapshot", "note": "10,000 ft", "drefs": [ "B747/test/epr_hold_target", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/flightmodel/engine/POINT_thrust[0]", "sim/weather/aircraft/temperature_leadingedge_deg_c", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "sim/flightmodel/position/theta" ] },
    { "do": "wait", "note": "20,000 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 20300, "timeout": 600 },
    { "do": "snapshot", "note": "20,000 ft", "drefs": [ "B747/test/epr_hold_target", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/flightmodel/engine/POINT_thrust[0]", "sim/weather/aircraft/temperature_leadingedge_deg_c", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "sim/flightmodel/position/theta" ] },
    { "do": "wait", "note": "30,000 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 30300, "timeout": 900 },
    { "do": "snapshot", "note": "30,000 ft", "drefs": [ "B747/test/epr_hold_target", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/flightmodel/engine/POINT_thrust[0]", "sim/weather/aircraft/temperature_leadingedge_deg_c", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "sim/flightmodel/position/theta" ] },
    { "do": "wait", "note": "34,000 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 34000, "timeout": 900 },
    { "do": "record_stop" },
    { "do": "cmd", "note": "EPR を合わせるのをやめる", "name": "FlyWithLua/B747_epr_hold/stop" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "35,000 ft で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 300 }
  ]
}
