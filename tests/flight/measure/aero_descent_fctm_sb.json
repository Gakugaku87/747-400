{
  "name": "aero_descent_fctm_sb",
  "description": "測定（合否なし、全シナリオの実行に入れない）：FCTM p.138 のアイドルの降下率の 340 kt（クリーン、重量の記載なし：4,300 fpm、スピードブレーキなし 2,800）と、FCTM p.139 の減速の「スピードブレーキで約 40 % 短い」の確かめ。銚子沖の海上 20,000 ft・340 KIAS・東向きで開始（機体を読み直す）、空中開始の初期化を待ち、ALT・A/T の SPD で 340 kt に落ち着いてから FLCH（MCP 10,000 ft）・A/T OFF のアイドル、スピードブレーキ FLT DETENT で 340 kt を mark、スピードブレーキを DN にして mark。12,500 ft で A/T を戻す（1 回目の版は A/T OFF・アイドル・スピードブレーキのまま MCP 高度を捕捉して失速した：2026-11-02、notes/AERO.md §3.15）。250 kt と VREF30 + 100 は aero_descent_fctm_sb250.json",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 6096, "heading_true": 90, "speed_in_meters_per_second": 236 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる（FMS：IRS の方位の後に F/D・A/T・ALT HOLD・CMD L。先に MCP を変えると初期化が上書きする：2026-11-02）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40 },
    { "do": "wait", "note": "初期化の MCP の速度の巻き取りが終わる", "dref": "laminar/B747/autopilot/speed/target", "op": "==", "value": -1, "timeout": 20 },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "set", "note": "MCP 速度 340 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 340 },
    { "do": "cmd", "note": "SPD（初期化の ALT のまま 340 kt に落ち着かせる：2 回目は空中開始の揺れで 278 kt に落ちたところから FLCH が −8,200 fpm で降り、10,000 ft の捕捉が 7,400 ft 上で始まって速さを保てなくなり、A/T OFF のまま失速した）", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "340 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [336, 344], "timeout": 180 },
    { "do": "wait", "note": "水平", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-200, 200], "timeout": 120 },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "FLCH（速度は昇降舵）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "switch", "note": "スピードブレーキを FLT DETENT", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "value": 0.53, "cmd": "sim/flight_controls/speed_brakes_down_one", "cmd_down": "sim/flight_controls/speed_brakes_up_one" },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "sim/flightmodel/weight/m_total", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/airspeed/Vref30", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/flt_ctrls/stab_trim/units" ] },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 40, "note": "降下に落ち着く（FLCH は最初に速さを一度落とす）" },
    { "do": "check", "note": "340 kt（FLCH）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [334, 346] },
    { "do": "mark", "note": "1：340 kt のアイドルの降下、スピードブレーキ" },
    { "do": "sleep", "seconds": 30 },
    { "do": "switch", "note": "スピードブレーキを DN", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "value": 0, "cmd": "sim/flight_controls/speed_brakes_down_one", "cmd_down": "sim/flight_controls/speed_brakes_up_one" },
    { "do": "sleep", "seconds": 40, "note": "降下に落ち着く（FLCH は最初に速さを一度落とす）" },
    { "do": "mark", "note": "2：340 kt のアイドルの降下、スピードブレーキなし" },
    { "do": "sleep", "seconds": 30 },
    { "do": "cmd", "note": "A/T ARM（FLCH では THR/HOLD で入る。捕捉の前に戻す）", "name": "laminar/B747/authrottle_arm" },
    { "do": "check", "note": "まだ FLCH（捕捉の前）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "record_stop" }
  ]
}
