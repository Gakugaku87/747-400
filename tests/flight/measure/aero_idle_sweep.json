{
  "name": "aero_idle_sweep",
  "description": "測定（合否なし、全シナリオの実行に入れない）：X-Plane のアイドルの比（idle ratio）を変えたときの、空中のアイドルの推力・N1・N2・燃料流量（PROGRESS.md 5f のエンジン）。銚子沖の海上 31,000 ft・290 KIAS・東向きで開始（機体を読み直す）。A/P の FLCH 290 kt（速度は昇降舵）、A/T OFF・アイドルで 4,000 ft へ降り、全エンジンを X-Plane の low idle（idle_speed_ratio 0）にして、EEC が書かない low_idle_ratio を 1・2・3・4・5 と 5 回まわす。各値で 15 秒待って mark、その後 20 秒を平均する（`luajit tests/flight/tools/idle_sweep.lua <記録のフォルダー>`）。最後に元に戻す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 9448.8, "heading_true": 90, "speed_in_meters_per_second": 236.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
