{
  "name": "aero_final",
  "description": "測定（合否なし、全シナリオの実行に入れない）：カスタム acf の空力の比較（PROGRESS.md 5f）、最終進入の形態（FCOM PI.10.40 の Final Approach (1500 FT)：脚下げ、3° のグライドスロープの推力）。銚子沖の海上 4,000 ft・230 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD・HDG SEL と A/T の SPD で、フラップを 1・5・10・20 と出して脚を下げ、3,000 ft でフラップ 25 と VREF25+10、V/S で 3° の降下（対地速度から約 900 fpm）に入れて落ち着いたら mark、ALT HOLD で止めてフラップ 30 と VREF30+10 で同じく。記録は `luajit tests/flight/tools/aero_compare.lua <記録のフォルダー>` で FCOM の姿勢・EPR・N1 と比べる（無風なので対地速度は真対気速度）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 1219.2, "heading_true": 90, "speed_in_meters_per_second": 125.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf1", "as": "vf1" },
    { "do": "set", "note": "MCP 速度 VREF30+60", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf1", "round": 1 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "FLCH（3,000 ft へ）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.1667 },
    { "do": "wait", "note": "3,000 ft で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 240 },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf5", "as": "vf5" },
    { "do": "set", "note": "VREF30+40", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf5", "round": 1 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "sleep", "seconds": 40 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf10", "as": "vf10" },
    { "do": "set", "note": "VREF30+20", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf10", "round": 1 },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 30 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf20", "as": "vf20" },
    { "do": "set", "note": "VREF30+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "vf20", "round": 1 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "sleep", "seconds": 30 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf25", "as": "vref25" },
    { "do": "set", "note": "VREF25+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 10, "rel": "vref25", "round": 1 },
    { "do": "set", "note": "レバー 25", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.8333 },
    { "do": "sleep", "seconds": 50, "note": "フラップと速度が落ち着く" },
    { "do": "snapshot", "note": "開始の状態（重量・重心・外気温・速度）", "drefs": [ "sim/flightmodel/weight/m_total", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/engines/type", "laminar/B747/airspeed/Vref30", "laminar/B747/airspeed/Vf25", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel2/gear/deploy_ratio[0]", "sim/flightmodel2/wing/flap1_deg[0]" ] },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 35 },

    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "V/S −900 fpm（約 170 kt の対地速度で 3°）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -900 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": -900 },
    { "do": "set", "note": "MCP 高度 1,000 ft（捕捉させない）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 1000 },
    { "do": "sleep", "seconds": 25, "note": "降下と推力が落ち着く" },
    { "do": "mark", "note": "final approach flaps 25" },
    { "do": "sleep", "seconds": 32 },
    { "do": "snapshot", "note": "フラップ 25 の 3°", "drefs": [ "sim/flightmodel/position/vpath", "sim/flightmodel/position/theta", "sim/flightmodel/position/alpha", "sim/flightmodel2/position/groundspeed", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_N1_[0]" ] },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },

    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf30", "as": "vref30" },
    { "do": "set", "note": "VREF30+10", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 10, "rel": "vref30", "round": 1 },
    { "do": "sleep", "seconds": 50 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "V/S −880 fpm（約 165 kt の対地速度で 3°）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -880 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": -880 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "final approach flaps 30" },
    { "do": "sleep", "seconds": 32 },
    { "do": "snapshot", "note": "フラップ 30 の 3°", "drefs": [ "sim/flightmodel/position/vpath", "sim/flightmodel/position/theta", "sim/flightmodel/position/alpha", "sim/flightmodel2/position/groundspeed", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "record_stop" }
  ]
}
