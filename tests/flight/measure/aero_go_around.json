{
  "name": "aero_go_around",
  "description": "測定（合否なし、全シナリオの実行に入れない）：自動着陸の進入からの着陸復行（FCTM p.206：100 ft より上で始めると約 40 ft 下がって上昇に移る。p.208・FCOM p.673：TO/GA を 1 回押すと推力は 1,000〜2,000 fpm の上昇の分）。s114_autoland.json の始めから LAND 3 まで（RJAA 34L の ILS、フラップ 30・150 kt、約 270 t）、電波高度 200 ft で TO/GA を 1 回、フラップ 20、上昇の確認で脚上げ。下がった量と 20 秒後の昇降率を記録から読む（notes/AERO.md §3.13）",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる（先に MCP やスイッチを変えると初期化が上書きする：2026-11-02 の 1 回目は A/T が SPD に入らず 291 kt で進入した）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40 },
    { "do": "wait", "note": "初期化の MCP の速度の巻き取りが終わる", "dref": "laminar/B747/autopilot/speed/target", "op": "==", "value": -1, "timeout": 20 },
    { "do": "sleep", "seconds": 3 },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "スピードブレーキを ARM（着陸の準備：FCOM の着陸前の手順）", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "set", "note": "オートブレーキ 2", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 4 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "A/T が SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3, "timeout": 10 },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（純正の ils_dots は目的地の 50 NM 以内でしか 1 にならない：DSP-14、5-1 段 3 で作り直すまで）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200 },
    { "do": "wait", "note": "電波高度 200 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 200, "timeout": 300 },
    { "do": "snapshot", "note": "TO/GA の前", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "進入の速さ（150 kt 付近でないと測定にならない）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [140, 175] },
    { "do": "mark", "note": "1：TO/GA を 1 回" },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "wait", "note": "上昇に移る", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 0, "timeout": 20 },
    { "do": "mark", "note": "2：上昇に移った（下がった量は記録から）" },
    { "do": "cmd", "note": "脚上げ（上昇の確認）", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "sleep", "seconds": 18 },
    { "do": "mark", "note": "3：TO/GA から約 20 秒" },
    { "do": "snapshot", "note": "TO/GA から約 20 秒", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/engines/display_EPR[0]" ] },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "TO/GA から約 40 秒", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "record_stop" }
  ]
}
