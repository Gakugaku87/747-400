{
  "name": "aero_flap_sweep",
  "description": "測定（合否なし、全シナリオの実行に入れない）：X-Plane のフラップの揚力が、フラップの最大角（`sim/aircraft/controls/acf_flap_dn`・`acf_flap2_dn` の [6]：最後の detent）、detent 20 の角度（[4]）、揚力の増し分（`acf_flap_cl`・`acf_flap2_cl`）でどう変わるかを、走行中に書き換えて測る（PROGRESS.md 5f のフラップ）。銚子沖の海上 5,000 ft・160 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD と A/T の SPD、脚上げ。フラップ 20 と 30 で、値ごとに 25 秒待って mark（`luajit tests/flight/tools/aero_compare.lua <記録のフォルダー> 15` の「pitch - path」が無風の迎角）。最後に acf の値に戻す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 1524.0, "heading_true": 90, "speed_in_meters_per_second": 88.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "フラップ 20 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 19.5, "timeout": 120 },
    { "do": "wait", "note": "160 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [158, 162], "timeout": 120 },
    { "do": "sleep", "seconds": 40, "note": "落ち着く" },
    { "do": "snapshot", "note": "acf の値", "drefs": [ "sim/aircraft/controls/acf_flap_dn[4]", "sim/aircraft/controls/acf_flap_dn[5]", "sim/aircraft/controls/acf_flap_dn[6]", "sim/aircraft/controls/acf_flap2_dn[6]", "sim/aircraft/controls/acf_flap_cl", "sim/aircraft/controls/acf_flap2_cl", "sim/flightmodel/weight/m_total", "sim/flightmodel2/wing/flap1_deg[0]" ] },
    { "do": "record_start" },
    { "do": "mark", "note": "1：フラップ 20、acf の値" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "最後の detent 50", "dref": "sim/aircraft/controls/acf_flap_dn[6]", "value": 50 },
    { "do": "set", "note": "最後の detent 50（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[6]", "value": 50 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "2：フラップ 20、最後の detent 50" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "最後の detent 100", "dref": "sim/aircraft/controls/acf_flap_dn[6]", "value": 100 },
    { "do": "set", "note": "最後の detent 100（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[6]", "value": 100 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "3：フラップ 20、最後の detent 100" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "最後の detent を戻す 75", "dref": "sim/aircraft/controls/acf_flap_dn[6]", "value": 75 },
    { "do": "set", "note": "最後の detent を戻す 75（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[6]", "value": 75 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "4：フラップ 20、戻した" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "detent 20 の角度 15", "dref": "sim/aircraft/controls/acf_flap_dn[4]", "value": 15 },
    { "do": "set", "note": "detent 20 の角度 15（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[4]", "value": 15 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "5：フラップ 20、detent 4 を 15" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "detent 20 の角度を戻す 20", "dref": "sim/aircraft/controls/acf_flap_dn[4]", "value": 20 },
    { "do": "set", "note": "detent 20 の角度を戻す 20（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[4]", "value": 20 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "6：フラップ 20、戻した" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "揚力の増し分 1.2", "dref": "sim/aircraft/controls/acf_flap_cl", "value": 1.2 },
    { "do": "set", "note": "揚力の増し分 1.2（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_cl", "value": 1.2 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "7：フラップ 20、揚力の増し分 1.2" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "揚力の増し分を戻す 1.62", "dref": "sim/aircraft/controls/acf_flap_cl", "value": 1.62 },
    { "do": "set", "note": "揚力の増し分を戻す 1.62（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_cl", "value": 1.62 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "8：フラップ 20、戻した" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "wait", "note": "フラップ 30 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 29.5, "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "mark", "note": "9：フラップ 30、acf の値" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "最後の detent 50", "dref": "sim/aircraft/controls/acf_flap_dn[6]", "value": 50 },
    { "do": "set", "note": "最後の detent 50（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[6]", "value": 50 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "10：フラップ 30、最後の detent 50" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "最後の detent 100", "dref": "sim/aircraft/controls/acf_flap_dn[6]", "value": 100 },
    { "do": "set", "note": "最後の detent 100（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[6]", "value": 100 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "11：フラップ 30、最後の detent 100" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "最後の detent を戻す 75", "dref": "sim/aircraft/controls/acf_flap_dn[6]", "value": 75 },
    { "do": "set", "note": "最後の detent を戻す 75（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_dn[6]", "value": 75 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "12：フラップ 30、戻した" },
    { "do": "sleep", "seconds": 15 },
    { "do": "record_stop" }
  ]
}
