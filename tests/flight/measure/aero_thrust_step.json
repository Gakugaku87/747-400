  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMC の空中の初期化" },
    { "do": "record_start" },
    { "do": "wait", "note": "空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP を IAS に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 0 },
    { "do": "set", "note": "フラップのレバー", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.667 },
    { "do": "set", "note": "窓 165 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 165 },
    { "do": "set", "note": "MCP 方位 098（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 98 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "switch", "note": "ALT（空中の初期化の ALT HOLD。違えば押す）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "value": 9, "cmd": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 90, "note": "落ち着かせる（空中開始の上昇と ALT HOLD：air-start settle）" },
    { "do": "cmd", "note": "HDG HOLD", "name": "sim/autopilot/heading_hold" },
    { "do": "snapshot", "note": "doublet の前", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/misc/machno", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "laminar/B747/flt_ctrls/yaw_damper_mode" ] },

    { "do": "snapshot", "note": "A/P を外す前", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/misc/machno", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "sim/flightmodel2/controls/elevator_trim", "laminar/B747/flt_ctrls/l_elev_inner", "sim/cockpit2/controls/yoke_pitch_ratio", "sim/flightmodel/position/alpha", "sim/flightmodel/position/theta", "sim/aircraft/weight/acf_Jyy_unitmass", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/flightmodel2/misc/cg_offset_z" ] },
    { "do": "cmd", "note": "A/T を切る", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "A/T の警告を消す（2 回目）", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "remember", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "as": "lev0" },
    { "do": "cmd", "note": "操縦輪の A/P 解除スイッチ（1 回目）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "2 回目（>AUTOPILOT DISC を消す）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt", "duration": 0.2 },
    { "do": "set", "note": "操縦輪を中立", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "set", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0 },
    { "do": "sleep", "seconds": 6 },
    { "do": "snapshot", "note": "推力を上げる前", "drefs": [ "sim/flightmodel/forces/M_prop", "sim/flightmodel/engine/POINT_thrust[0]", "sim/flightmodel/engine/POINT_thrust[1]", "sim/flightmodel/engine/POINT_thrust[2]", "sim/flightmodel/engine/POINT_thrust[3]", "sim/flightmodel/forces/M_aero", "sim/flightmodel/forces/M_total", "sim/flightmodel/position/Q", "sim/flightmodel/position/theta", "sim/flightmodel/position/alpha", "laminar/B747/flt_ctrls/stab_corr_deg", "sim/flightmodel2/controls/elevator_trim", "laminar/B747/flt_ctrls/l_elev_inner", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "sim/aircraft/weight/acf_Jxx_unitmass" ] },
    { "do": "mark", "note": "スラスト・レバーを前へ" },
    { "do": "set", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.95 },
    { "do": "sleep", "seconds": 6 },
    { "do": "snapshot", "note": "6 秒後", "drefs": [ "sim/flightmodel/forces/M_prop", "sim/flightmodel/engine/POINT_thrust[0]", "sim/flightmodel/engine/POINT_thrust[1]", "sim/flightmodel/engine/POINT_thrust[2]", "sim/flightmodel/engine/POINT_thrust[3]", "sim/flightmodel/forces/M_aero", "sim/flightmodel/forces/M_total", "sim/flightmodel/position/Q", "sim/flightmodel/position/theta", "sim/flightmodel/position/alpha", "laminar/B747/flt_ctrls/stab_corr_deg", "sim/flightmodel2/controls/elevator_trim", "laminar/B747/flt_ctrls/l_elev_inner", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "sim/aircraft/weight/acf_Jxx_unitmass" ] },
    { "do": "mark", "note": "戻す" },
    { "do": "set", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0, "rel": "lev0" },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "戻した後", "drefs": [ "sim/flightmodel/forces/M_prop", "sim/flightmodel/engine/POINT_thrust[0]", "sim/flightmodel/engine/POINT_thrust[1]", "sim/flightmodel/engine/POINT_thrust[2]", "sim/flightmodel/engine/POINT_thrust[3]", "sim/flightmodel/forces/M_aero", "sim/flightmodel/forces/M_total", "sim/flightmodel/position/Q", "sim/flightmodel/position/theta", "sim/flightmodel/position/alpha", "laminar/B747/flt_ctrls/stab_corr_deg", "sim/flightmodel2/controls/elevator_trim", "laminar/B747/flt_ctrls/l_elev_inner", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "sim/aircraft/weight/acf_Jxx_unitmass" ] },
    { "do": "record_stop" }
  ]
}
