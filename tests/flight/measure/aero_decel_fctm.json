{
  "name": "aero_decel_fctm",
  "description": "測定（合否なし、全シナリオの実行に入れない）：水平の減速（FCTM p.139：スピードブレーキなしで 340 kt から 250 kt まで約 90 秒・8 NM、フラップ上げの機動速度までさらに 13 秒・1 NM、スピードブレーキで約 40 % 短く。重量は「平均的な総重量」）。銚子沖の海上 10,000 ft・340 kt・東向きで開始（機体を読み直す）。A/P の ALT HOLD・HDG SEL で高度を保ち、A/T を切ってレバーをアイドルにして 340→250→225 kt の時間を測る（mark の時刻）。そのあと A/T で 340 kt に戻し、スピードブレーキを FLT DETENT にして同じく測る。2026-11-02 の 1 回目は A/T の SPD のまま測り、A/T が 270 kt から推力を足し、高度も 1,200 ft 動いて使えなかった（notes/AERO.md §3.13）",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 90, "speed_in_meters_per_second": 200.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 10000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 340 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 340 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "FLCH（MCP の 10,000 ft へ）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "10,000 ft で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 300 },
    { "do": "wait", "note": "340 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [337, 343], "timeout": 180 },
    { "do": "sleep", "seconds": 40, "note": "落ち着く" },
    { "do": "snapshot", "note": "減速の前", "drefs": [ "sim/flightmodel/weight/m_total", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vf0" ] },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5 },
    { "do": "mark", "note": "1：340 kt から、A/T OFF・アイドル、スピードブレーキなし" },
    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "sleep", "seconds": 1, "note": "A/T が離れてから（同じフレームではレバーを A/T が書き戻す：2026-11-02 の 1 回目のスピードブレーキの段はレバーが 0.63〜0.72 のまま）" },
    { "do": "set", "note": "レバーを動かす（A/T OFF の後は X-Plane のスロットルの入力が変わったときだけ機体のレバーが追う：同じ 0 を書いても動かない、2 回目の段は 0.63〜0.70 のまま）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.05 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "機体のレバーがアイドル", "dref": "laminar/B747/engine/throttle[0]", "op": "<", "value": 0.05, "timeout": 10 },
    { "do": "wait", "note": "250 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 250, "timeout": 300 },
    { "do": "mark", "note": "2：250 kt" },
    { "do": "wait", "note": "225 kt（フラップ上げの機動速度の付近）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 225, "timeout": 120 },
    { "do": "mark", "note": "3：225 kt" },
    { "do": "set", "note": "MCP 速度 340 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 340 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "340 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [337, 343], "timeout": 300 },
    { "do": "sleep", "seconds": 40, "note": "落ち着く" },
    { "do": "mark", "note": "4：340 kt から、A/T OFF・アイドル、スピードブレーキ FLT DETENT" },
    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "sleep", "seconds": 1, "note": "A/T が離れてから（同じフレームではレバーを A/T が書き戻す：2026-11-02 の 1 回目のスピードブレーキの段はレバーが 0.63〜0.72 のまま）" },
    { "do": "set", "note": "レバーを動かす（A/T OFF の後は X-Plane のスロットルの入力が変わったときだけ機体のレバーが追う：同じ 0 を書いても動かない、2 回目の段は 0.63〜0.70 のまま）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.05 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "機体のレバーがアイドル", "dref": "laminar/B747/engine/throttle[0]", "op": "<", "value": 0.05, "timeout": 10 },
    { "do": "switch", "note": "スピードブレーキを FLT DETENT", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "value": 0.53, "cmd": "sim/flight_controls/speed_brakes_down_one", "cmd_down": "sim/flight_controls/speed_brakes_up_one" },
    { "do": "wait", "note": "250 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 250, "timeout": 300 },
    { "do": "mark", "note": "5：250 kt（スピードブレーキ）" },
    { "do": "switch", "note": "スピードブレーキを DN", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "value": 0, "cmd": "sim/flight_controls/speed_brakes_down_one", "cmd_down": "sim/flight_controls/speed_brakes_up_one" },
    { "do": "sleep", "seconds": 5 },
    { "do": "record_stop" }
  ]
}
