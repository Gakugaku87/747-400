{
  "name": "aero_flap_crat",
  "description": "測定（合否なし、全シナリオの実行に入れない）：X-Plane のフラップの翼弦比（`sim/aircraft/controls/acf_flap_crat`・`acf_flap2_crat`、カスタム acf は 0.26）でフラップ 20 と 30 の揚力の比がどう変わるか（PROGRESS.md 5f のフラップ：X-Plane の揚力は 20° の先で伸びない）。銚子沖の海上 5,000 ft・160 kt・東向きで開始、A/P の ALT HOLD と A/T の SPD、脚上げ。翼弦比を 0.26・0.20・0.35・0.45 と変えて 25 秒待って mark（`luajit tests/flight/tools/aero_compare.lua <記録のフォルダー> 15` の「pitch - path」と CL）。最後に acf の値（0.26）に戻す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 1524.0, "heading_true": 90, "speed_in_meters_per_second": 88.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "note": "MCP 方位 097（東向き）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 97 },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "フラップ 20 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 19.5, "timeout": 120 },
    { "do": "wait", "note": "160 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [158, 162], "timeout": 120 },
    { "do": "sleep", "seconds": 30, "note": "落ち着く" },
    { "do": "snapshot", "note": "acf の値", "drefs": [ "sim/aircraft/controls/acf_flap_crat", "sim/aircraft/controls/acf_flap2_crat", "sim/aircraft/controls/acf_flap_cl" ] },
    { "do": "record_start" },
    { "do": "set", "note": "翼弦比 0.26", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.26 },
    { "do": "set", "note": "翼弦比 0.26（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.26 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "1：フラップ 20、翼弦比 0.26" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比 0.20", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.20 },
    { "do": "set", "note": "翼弦比 0.20（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.20 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "2：フラップ 20、翼弦比 0.20" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比 0.35", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.35 },
    { "do": "set", "note": "翼弦比 0.35（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.35 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "3：フラップ 20、翼弦比 0.35" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比 0.45", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.45 },
    { "do": "set", "note": "翼弦比 0.45（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.45 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "4：フラップ 20、翼弦比 0.45" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比を acf の値に", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.26 },
    { "do": "set", "note": "翼弦比を acf の値に（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.26 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "wait", "note": "フラップ 30 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": ">", "value": 29.5, "timeout": 120 },
    { "do": "sleep", "seconds": 25, "note": "落ち着く" },
    { "do": "set", "note": "翼弦比 0.26", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.26 },
    { "do": "set", "note": "翼弦比 0.26（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.26 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "5：フラップ 30、翼弦比 0.26" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比 0.20", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.20 },
    { "do": "set", "note": "翼弦比 0.20（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.20 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "6：フラップ 30、翼弦比 0.20" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比 0.35", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.35 },
    { "do": "set", "note": "翼弦比 0.35（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.35 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "7：フラップ 30、翼弦比 0.35" },
    { "do": "sleep", "seconds": 15 },
    { "do": "set", "note": "翼弦比 0.45", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.45 },
    { "do": "set", "note": "翼弦比 0.45（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.45 },
    { "do": "sleep", "seconds": 25 },
    { "do": "mark", "note": "8：フラップ 30、翼弦比 0.45" },
    { "do": "sleep", "seconds": 15 },
    { "do": "record_stop" },
    { "do": "set", "note": "翼弦比を acf の値に", "dref": "sim/aircraft/controls/acf_flap_crat", "value": 0.26 },
    { "do": "set", "note": "翼弦比を acf の値に（flap 2）", "dref": "sim/aircraft/controls/acf_flap2_crat", "value": 0.26 }
  ]
}
