  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT 点 1・点 2・点 3", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "N3557.0E14148.0", "R1", "N3548.2E14203.0", "R2", "N3532.0E14148.5", "R3"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30, "stop": true },
    { "do": "check", "note": "脚の上（外れ 0.3 NM 以内）", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.3, 0.3], "stop": true },

    { "do": "mark", "note": "45 degree turn" },
    { "do": "wait", "note": "点 1 の 4 NM 手前（経度 141.72）", "dref": "sim/flightmodel/position/longitude", "op": ">", "value": 141.72, "timeout": 400 },
    { "do": "check", "note": "旋回の前にフラップ 10・170 kt の付近（2026-11-24 の 2 回目は LNAV の直後に見て、空中開始の 195 kt から減速の途中の 186.6 kt で不合格。旋回の前には 170 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [160, 180] },
    { "do": "watch", "note": "45° 右の旋回とその後：バンク（逆のバンクは 2° まで）、点 1 を過ぎて南東へ約 2 分（緯度 35.88 を切るまで）", "dref": "sim/flightmodel/position/phi", "min": -2, "max": 30, "until": { "dref": "sim/flightmodel/position/latitude", "op": "<", "value": 35.88 }, "timeout": 400 },
    { "do": "snapshot", "note": "45° の後", "drefs": [ "laminar/B747/fms/lnav/xtk", "laminar/B747/fms/lnav/dtk", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "sim/flightmodel/position/phi", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },

    { "do": "mark", "note": "90 degree turn" },
    { "do": "wait", "note": "点 2 の 4 NM 手前（緯度 35.84）", "dref": "sim/flightmodel/position/latitude", "op": "<", "value": 35.84, "timeout": 400 },
    { "do": "watch", "note": "90° 右の旋回とその後：バンク（逆のバンクは 2° まで）、点 2 を過ぎて南西へ約 3 分（経度 141.95 を切るまで）", "dref": "sim/flightmodel/position/phi", "min": -2, "max": 30, "until": { "dref": "sim/flightmodel/position/longitude", "op": "<", "value": 141.95 }, "timeout": 400 },
    { "do": "snapshot", "note": "90° の後", "drefs": [ "laminar/B747/fms/lnav/xtk", "laminar/B747/fms/lnav/dtk", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "sim/flightmodel/position/phi", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "record_stop" }
  ]
}
