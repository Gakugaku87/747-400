{
  "name": "afds6_lnav_flyby_low",
  "description": "低速・フラップ 10 の LNAV の fly-by の測定（2026-11-24、段 4 のレビューの AFDS-6：ROLL_LAG 0.9 秒は FL370 の 1 点、フラップを出すとロールの遅れは記録で 0.0〜0.5 秒。模型では 150〜170 kt で外へ 0.03〜0.08 NM、目安は利用者の 2026-11-20 の 0.02 NM 以内・コースに 1° 以内・逆のバンク 2° まで）。銚子沖の海の上、5,000 ft・フラップ 10・170 kt（270 t）で、RJAA から緯度経度の点 1（N3557.0E14148.0）への脚の 15 NM 手前で空中開始（機体を読み直す）。点 1 で 45° 右（081 → 126）、点 2（N3548.2E14203.0）で 90° 右（126 → 216）、点 3（N3532.0E14148.5）へ。それぞれの旋回の始めから後の約 2 分の LNAV の外れ（fms/lnav/xtk）とバンクを記録する",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.911, "longitude": 141.495, "elevation_in_meters": 1524, "heading_true": 81, "speed_in_meters_per_second": 87.46 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
