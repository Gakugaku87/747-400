{
  "about": "The keys a scenario's steps may carry, by step type (2026-11-13; the 2026-11-12 review C-5). run_scenario.ps1 does not start a scenario with a key that is not here, a key missing, an op or a level not listed; tests/static/scenario_keys_test.lua checks every scenario and measurement against it. docs/overhaul/TESTING.md 4.2 says what each key does. A new key: add it here and in run_scenario.ps1 together.",
  "top": { "need": ["name", "steps"], "may": ["description", "flight", "reload", "livery"] },
  "common": ["do", "note", "cite", "stop"],
  "steps": {
    "record_start": { "need": [], "may": [] },
    "record_stop": { "need": [], "may": [] },
    "mark": { "need": [], "may": [] },
    "traffic": { "need": ["targets"], "may": [] },
    "traffic_stop": { "need": [], "may": [] },
    "route": { "need": ["entries"], "may": [] },
    "route_clear": { "need": [], "may": [] },
    "cmd": { "need": ["name"], "may": ["duration", "async"] },
    "set": { "need": ["dref", "value"], "may": ["rel", "round"] },
    "switch": { "need": ["dref", "value", "cmd"], "may": ["cmd_down"] },
    "wait": { "need": ["dref", "op", "value"], "may": ["timeout", "rel", "level"] },
    "watch": { "need": ["dref"], "may": ["abs", "max", "min", "spread", "until", "timeout", "level", "rel"] },
    "check": { "need": ["dref", "op", "value"], "may": ["rel", "level"] },
    "remember": { "need": ["dref", "as"], "may": [] },
    "sleep": { "need": ["seconds"], "may": [] },
    "copy": { "need": ["from", "to"], "may": [] },
    "remove": { "need": ["path"], "may": [] },
    "snapshot": { "need": ["drefs"], "may": [] },
    "cas": { "need": [], "may": ["has", "lacks", "level"] },
    "view": { "need": [], "may": ["name", "the", "psi", "fov"], "need_one_of": [["name"], ["the", "psi"]] },
    "shot": { "need": ["name"], "may": [] },
    "cdu": { "need": ["keys"], "may": ["cdu"] }
  },
  "until": { "need": ["dref", "op", "value"], "may": ["rel"] },
  "ops": ["==", "!=", ">", ">=", "<", "<=", "between", "outside", "contains", "matches", "in"],
  "levels": ["warn", "fail"],
  "numbers": ["seconds", "duration", "timeout", "round", "min", "max", "spread", "the", "psi", "fov"],
  "booleans": ["stop", "async", "abs"]
}
