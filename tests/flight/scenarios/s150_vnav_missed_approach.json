{
  "name": "s150_vnav_missed_approach",
  "description": "6-1/6-2 段 9e3（進入復行）の X-Plane での確認。s149 と同じく RJBB の ILS06LY（遷移 GATES）の GATES の約 8 NM 手前（035°）から 10,000 ft・250 kt で空中開始（機体を読み直す）、フラップ 5、同じ経路（RJAA→RJBB、STAR ATMUGA、ILS06LY、遷移 GATES）を ACTIVATE と EXEC、GATES へ DIRECT TO、LNAV、PERF INIT（ZFW 200・CI 100・CRZ ALT FL300）、MCP 2,000 ft で VNAV の降下。on approach で MCP の 2,000 ft の VNAV ALT まで降りて TO/GA（AFDS の G/A：FMA のピッチ TO/GA）、MCP 高度を 3,000 ft に。FMC は進入復行（FCOM p.1262、ATA34_2 p.472）：G/A は MCP の 2,000 ft の捕捉の途中（初めの s150 はここで、古い経路の T/D の先で MCP が 200 ft 以上下のため同じフレームで降下の段階に戻り、経路が消えて VNAV が無効になった）。上昇の段階、CRZ ALT は進入復行の最高高度（LILAC の 3,000）、on approach を出る、機体より下の降下の制限を消す。LNAV と VNAV を押すと VNAV SPD（p.1264）、3,000 ft で VNAV PTH（FMC の高度と MCP 高度が同じ）・巡航の段階、目標は SPD TRANS（240）・最良の待機速度・ECON 巡航の最も厳しいもの（p.1262）、A/T の SPD でそこへ。滑走路を過ぎても END OF DES にならず巡航のまま。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.0301, "longitude": 134.7248, "elevation_in_meters": 3048, "heading_true": 35, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 2,000 ft（機体より下）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 2000 },
    { "do": "cmd", "note": "フラップ 1", "name": "sim/flight_controls/flaps_down" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "フラップ 5", "name": "sim/flight_controls/flaps_down" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：GATES へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "GATES", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が GATES", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "GATES" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "CRZ ALT FL300", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 30000 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV で engage", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2, "timeout": 10 },
    { "do": "check", "note": "FMC は降下（3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3 },
    { "do": "wait", "note": "GATES を過ぎて on approach", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 1, "timeout": 180 },
    { "do": "wait", "note": "MCP の 2,000 ft で VNAV ALT の水平", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 5, "timeout": 400 },
    { "do": "sleep", "seconds": 5 },
    { "do": "cdu", "note": "LEGS（1 行目の点を見る）", "keys": ["LEGS"] },
    { "do": "snapshot", "note": "TO/GA の前", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line05_S", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/vnav/phase", "laminar/B747/fms/vnav/cas", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot" ] },
    { "do": "check", "note": "FMC は降下のまま、on approach", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3 },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "G/A：FMA のピッチ TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "set", "note": "MCP 高度 3,000 ft（進入復行の高度）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "前の則の目標も（G/A の捕捉はこれを見る。つまみなら 3 秒後に写る：初めの s150 は G/A のまま 4,500 ft へ）", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 3000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CRZ ALT は進入復行の最高高度 3,000（LILAC：FCOM p.1262）", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 3000 },
    { "do": "check", "note": "FMC は上昇の段階（1）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 1 },
    { "do": "check", "note": "on approach を出る（p.1261）", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 0 },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC の VNAV SPD（1）", "dref": "laminar/B747/fms/vnav/mode", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "TO/GA の直後", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line05_S", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/alt", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD（FCOM p.1264）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "wait", "note": "LNAV", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 10 },
    { "do": "check", "note": "A/T は THR REF", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5 },
    { "do": "wait", "note": "3,000 ft の捕捉で VNAV PTH（p.1264：VNAV SPD から VNAV PATH。G/A の推力の上昇率で 750 ft 下から捕捉が始まる：二つ目の s150 は 2,255 ft で）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 120 },
    { "do": "wait", "note": "3,000 ft で水平", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [2900, 3100], "timeout": 60 },
    { "do": "wait", "note": "FMC は巡航の段階（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2, "timeout": 30 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "目標は SPD TRANS の 240 以下（最良の待機速度か 240：p.1262）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [200, 240.5] },
    { "do": "check", "note": "A/T は SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "remember", "dref": "laminar/B747/fms/vnav/cas", "as": "ma_cas" },
    { "do": "snapshot", "note": "3,000 ft の巡航", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/alt", "laminar/B747/fms3/Line03_L", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/weight/m_total" ] },
    { "do": "wait", "note": "A/T の SPD で目標の速さへ", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [-5, 5], "rel": "ma_cas", "timeout": 180 },
    { "do": "wait", "note": "滑走路（RW06L）を過ぎる", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^(?!.*RW06L)", "timeout": 300 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "END OF DES にならず巡航のまま", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "check", "note": "on approach でない", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 0 },
    { "do": "check", "note": "VNAV PTH のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "3,000 ft の近く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [2900, 3100] },
    { "do": "record_stop" }
  ]
}
