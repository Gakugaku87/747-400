{
  "name": "s113_afds_multi",
  "description": "AFDS の作り直し 6-3 段 4a（multi-channel と autoland の状態表示）の X-Plane での確認、空中。RJAA 34L の進入路の G/S のアンテナから 12 NM、2,500 ft・フラップ 20・脚下げ・170 kt で開始（機体を読み直す）。CMD L、ALT HOLD、HDG SEL 337、A/T の SPD、CDU で ILS を同調。APP で C と R が arm（CMD 灯が点き、engage はしない：ATA22 p.288、p.314）、LOC と G/S を捕まえて電波高度 1,500 ft の下で 5 秒後に C と R が engage（p.288、p.318）、LAND 3（状態表示 4）と FMA の FLARE・ROLLOUT の arm（FCOM p.671）。電波高度計 R の故障で LAND 2（3）、戻して LAND 3。800 ft で TO/GA：3 台のまま、1,000 ft を超えて ALT HOLD を押すと最初の L だけ残る（p.318）。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（純正の ils_dots は目的地の 50 NM 以内でしか 1 にならない：DSP-14、5-1 段 3 で作り直すまで）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "check", "note": "状態表示 CMD（2）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 2 },
    { "do": "check", "note": "C は arm していない", "dref": "laminar/B747/autopilot/cmd_armed[1]", "op": "==", "value": 0 },

    { "do": "mark", "note": "APP：C と R の arm" },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "C が arm（ATA22 p.314）", "dref": "laminar/B747/autopilot/cmd_armed[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "R が arm", "dref": "laminar/B747/autopilot/cmd_armed[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "C は engage していない（前は APP で 3 台とも engage）", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 0 },
    { "do": "check", "note": "CMD C の灯が点く（ATA22 p.288）", "dref": "laminar/B747/annunciator/brightness_ratio[268]", "op": ">", "value": 0.1 },
    { "do": "check", "note": "CMD R の灯が点く", "dref": "laminar/B747/annunciator/brightness_ratio[269]", "op": ">", "value": 0.1 },
    { "do": "wait", "note": "LOC を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 60 },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "check", "note": "1,500 ft より上：C はまだ arm", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 0 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },

    { "do": "mark", "note": "1,500 ft の下で 5 秒：multi-channel" },
    { "do": "wait", "note": "C が engage", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 1, "timeout": 200 },
    { "do": "snapshot", "note": "engage の時", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/autopilot/cmd_R_mode/status", "laminar/B747/autopilot/cmd_armed[1]", "laminar/B747/autopilot/AFDS/status_annun_pilot" ] },
    { "do": "check", "note": "電波高度 1,500 ft の下（1,500 ft を通って 5 秒）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 1490 },
    { "do": "check", "note": "R も engage", "dref": "laminar/B747/autopilot/cmd_R_mode/status", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LAND 3（状態表示 4）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4 },
    { "do": "check", "note": "FMA の ROLLOUT の arm（4）", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "FMA の FLARE の arm（3）", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "arm は残らない", "dref": "laminar/B747/autopilot/cmd_armed[1]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：LAND 3", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_land3" },

    { "do": "mark", "note": "電波高度計 R の故障：LAND 2" },
    { "do": "set", "note": "電波高度計 R の故障", "dref": "laminar/B747/ra/fail[2]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LAND 2（状態表示 3）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 3 },
    { "do": "check", "note": "FLARE の arm のまま", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "段 5b：LAND 3 の後の故障なので NO LAND 3 は caution（ATA22 p.373；FCOM p.677）", "dref": "laminar/B747/CAS/caution_status[50]", "op": "==", "value": 1 },
    { "do": "check", "note": "advisory の NO LAND 3 は出ない", "dref": "laminar/B747/CAS/advisory_status[248]", "op": "==", "value": 0 },
    { "do": "cas", "note": ">NO LAND 3（caution）" },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_no_land3" },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/ra/fail[2]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LAND 3 に戻る", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4 },
    { "do": "check", "note": "NO LAND 3 が消える", "dref": "laminar/B747/CAS/caution_status[50]", "op": "==", "value": 0 },

    { "do": "mark", "note": "800 ft で TO/GA：3 台のまま、ALT HOLD で L だけ" },
    { "do": "wait", "note": "電波高度 800 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 800, "timeout": 120 },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMA のピッチは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "C は engage のまま（multi-channel の G/A）", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 1 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "wait", "note": "電波高度 1,000 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 1000, "timeout": 90 },
    { "do": "cmd", "note": "ALT HOLD（巡航のモード）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L（最初のチャンネル）は engage のまま", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "C は外れる（ATA22 p.318）", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 0 },
    { "do": "check", "note": "R も外れる", "dref": "laminar/B747/autopilot/cmd_R_mode/status", "op": "==", "value": 0 },
    { "do": "check", "note": "状態表示 CMD", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
