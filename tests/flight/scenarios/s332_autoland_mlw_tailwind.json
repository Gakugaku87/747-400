{
  "name": "s332_autoland_mlw_tailwind",
  "description": "最大着陸重量・追い風の自動着陸（2026-11-12 のフルレビュー T-3：REVIEW_2026-11-12.md 案 23 の P10）。s114 の手順（RJAA 34L の 12 NM・2,500 ft から ILS・LAND 3・フラップ 30・FLARE・接地）を 285.7 t（109 の最大着陸重量）、追い風 10 kt（150° から：滑走路は真方位 330°）で。見る量は s114 と同じ（FLARE の始まり、接地の沈下率、接地点、浮き）。重さと追い風で s114 の幅を外れたら、その値を記録する（幅は s114 のまま：ATA22 p.342、FCOM p.78 (L.10.2)、p.77 (L.10.1)）",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "weight": {
      "payload_weight_in_kilograms": [2000, 2000, 3000, 3000, 1000, 5000, 4000, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 27650, 27650, 13499.4, 0, 0, 0, 0]
    },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": {
        "latitude_in_degrees": 35.76,
        "longitude_in_degrees": 140.39,
        "elevation_in_meters": 0,
        "visibility_in_kilometers": 40,
        "temperature_in_degrees_celsius": 15,
        "altimeter_setting_in_hpa": 1013.25,
        "precipitation_ratio": 0,
        "clouds": [],
        "wind": [
          {"altitude_in_feet_msl": 0, "speed_in_knots": 10, "direction_in_degrees_true": 150, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 3000, "speed_in_knots": 10, "direction_in_degrees_true": 150, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 10000, "speed_in_knots": 10, "direction_in_degrees_true": 150, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0}
        ]
      },
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "snapshot", "note": "重さと風", "drefs": [ "sim/flightmodel/weight/m_total", "sim/weather/aircraft/wind_speed_kts", "sim/weather/aircraft/wind_direction_degt" ] },
    { "do": "check", "note": "重さは約 285.7 t（109 の最大着陸重量）", "dref": "sim/flightmodel/weight/m_total", "op": "between", "value": [282000, 290000], "stop": true },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "スピードブレーキを ARM（着陸の準備：FCOM の着陸前の手順）", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "set", "note": "オートブレーキ 2", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 4 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（純正の ils_dots は目的地の 50 NM 以内でしか 1 にならない：DSP-14、5-1 段 3 で作り直すまで）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200 },
    { "do": "check", "note": "FLARE の arm", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 3 },

    { "do": "mark", "note": "FLARE" },
    { "do": "wait", "note": "FLARE（FMA のピッチ 3）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 3, "timeout": 200 },
    { "do": "snapshot", "note": "FLARE の engage", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "laminar/B747/autopilot/pitch_law" ] },
    { "do": "check", "note": "FLARE は新しい則（ピッチの則 1）", "dref": "laminar/B747/autopilot/pitch_law", "op": "==", "value": 1 },
    { "do": "wait", "note": "25 ft で A/T の IDLE（2）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "snapshot", "note": "IDLE の時", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "watch", "note": "FLARE で浮き上がらない（昇降率 +100 fpm まで、接地で FLARE が消えるまで：ROLLOUT は電波高度 5 ft の下で入り、浮く前に入ることがある）。段 4d で WARN：横風 20 kt の decrab では横滑りでピッチが高く、主脚の高さ 2 ft で降下が止まって電波高度 12 ft まで浮き、2.07 g で接地した（notes/ATA-22.md §31。フラップの揚力の補正の後に FLARE を見直す）", "dref": "sim/flightmodel/position/vh_ind_fpm", "max": 100, "until": { "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 0 }, "timeout": 30, "level": "warn" },
    { "do": "wait", "note": "ROLLOUT（電波高度 5 ft の下：FCOM p.664）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "snapshot", "note": "ROLLOUT の時：G/S の旗（X-Plane は最後の数 ft で旗を出す：FLARE からは数えない）と状態表示", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "sim/cockpit2/radios/indicators/nav1_flag_glideslope", "sim/cockpit2/radios/indicators/nav2_flag_glideslope", "laminar/B747/autopilot/AFDS/status_annun_pilot", "sim/flightmodel/failures/onground_any" ] },
    { "do": "wait", "note": "接地で FLARE が消える（FCOM p.671）。接地は FMA で待つ：onground_any を待つと、最初の 0.2 秒ほどの接地を読み取りの間隔で取りこぼし、跳ねた後の 2 回目の接地から見てしまう（段 4c の 2 回目）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 0, "timeout": 30 },
    { "do": "snapshot", "note": "接地", "drefs": [ "sim/flightmodel/failures/onground_any", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/forces/g_nrml", "laminar/B747/ra/capt/value" ] },
    { "do": "check", "note": "接地での PFD の電波高度は 0 の近く（ATA34_2 p.78：接地で 0。2026-11-13 の校正 3.3 ft。前の 8 ft では約 −5）", "dref": "laminar/B747/ra/capt/value", "op": "between", "value": [ -2.5, 1.5 ] },
    { "do": "watch", "note": "接地から 3 秒、跳ねない（地上のまま）。段 4b から WARN：ピッチ 6.7° の接地だと、揚力が重さに近いまま脚の台車が水平にならず（ATA29_32 p.322 の地上の条件）、スピードブレーキが出る前に 1 ft ほど 1.5〜1.7 秒浮く（notes/ATA-22.md §26、§28。フラップの揚力の形で見直す）", "dref": "sim/flightmodel/failures/onground_any", "min": 1, "timeout": 3, "level": "warn" },
    { "do": "check", "note": "IDLE のまま", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 2 },
    { "do": "wait", "note": "スピードブレーキが自動で UP（FCOM p.951。アクチュエータは DN から UP まで 2 秒：B747.45.speedbrake_model.lua）", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": ">", "value": 0.9, "timeout": 4 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "機首が下りる（NOSE LETDOWN）", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": "<", "value": 1.5 },
    { "do": "check", "note": "地上のまま", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1 },
    { "do": "check", "note": "ROLLOUT（FMA のロール 4：電波高度 5 ft の下で、FCOM p.664）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 4 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：ROLLOUT", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_rollout" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "mark", "note": "ROLLOUT：中心線を 60 kt まで" },
    { "do": "watch", "note": "ROLLOUT の間、LOC の偏位 0.1 ドット以内（LOC の手前約 6,000 ft で約 15 ft）、60 kt まで", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "abs": true, "max": 0.1, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 60 }, "timeout": 90 },
    { "do": "check", "note": "60 kt の下でも A/P のまま（前の 65 kt の解除は無い：FCTM p.159）", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "ROLLOUT のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 4 },
    { "do": "set", "note": "パーキング・ブレーキで止める（試験の後始末）", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる（対地 8 m/s の下：速度計は 30 kt で止まる）", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 8, "timeout": 60 },
    { "do": "cmd", "note": "操縦輪の解除スイッチで A/P を外す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/P が外れて ROLLOUT が終わる（FCOM p.671）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "!=", "value": 4 },
    { "do": "cmd", "note": "AUTOPILOT DISC を消す（2 回目）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 2 },
    { "do": "record_stop" }
  ]
}
