{
  "name": "s309_adc_irs",
  "description": "ADC と IRS の故障の配線（2026-11-12 のフルレビュー FG-5・FG-6：案 25）の X-Plane での確認。空中 300 kt で X-Plane の ADC 1 の故障：外側エルロンはロックのまま、STATUS STAB SPEED TRIM なし（前は ADC 1 つで両方の air data を失ったことになった）。IRU L の故障で機長の IRS を C に：オートブレーキ 3 のまま（FCOM p.1044。前は常に IRU L を見て DISARM に戻った）",
  "reload": true,
  "flight": {
    "lle_air_start": { "elevation_in_meters": 3048, "heading_true": 0, "latitude": 35.4, "longitude": 141.3, "speed_in_meters_per_second": 149 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weight": {
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ],
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 300 },
    { "do": "cmd", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "300 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 297, "timeout": 120, "stop": true },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "300 kt クリーン、故障なし", "drefs": [ "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "laminar/B747/flt_ctrls/rudder_ratio_upr", "laminar/B747/flt_ctrls/rudder_ratio_lwr", "laminar/B747/CAS/status_status[93]", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_copilot" ] },
    { "do": "mark", "note": "X-Plane の ADC 1 の故障（rel_adc_comp 6）" },
    { "do": "set", "dref": "sim/operation/failures/rel_adc_comp", "value": 6 },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "故障の 8 秒後", "drefs": [ "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "laminar/B747/flt_ctrls/rudder_ratio_upr", "laminar/B747/flt_ctrls/rudder_ratio_lwr", "laminar/B747/CAS/status_status[93]", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_copilot" ] },
    { "do": "check", "note": "300 kt では外側エルロンはロックのまま（前は ADC 1 つでロックが外れた）", "dref": "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "op": "<", "value": 0.5 },
    { "do": "check", "note": "STATUS STAB SPEED TRIM なし（もう 1 つの ADC が生きている）", "dref": "laminar/B747/CAS/status_status[93]", "op": "==", "value": 0 },
    { "do": "set", "note": "故障を戻す", "dref": "sim/operation/failures/rel_adc_comp", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "mark", "note": "全 IRU でオートブレーキ 3（基準）" },
    { "do": "set", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 5 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "オートブレーキ 3、故障なし", "drefs": [ "laminar/B747/gear/autobrakes/sel_dial_pos", "laminar/B747/CAS/advisory_status[17]", "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos" ] },
    { "do": "set", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 2 },
    { "do": "mark", "note": "IRU L の故障、機長の IRS セレクターを C に" },
    { "do": "set", "dref": "laminar/B747/irs/fail/iru[0]", "value": 1 },
    { "do": "set", "dref": "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 4 },
    { "do": "set", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 5 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "IRU L の故障でオートブレーキ 3", "drefs": [ "laminar/B747/gear/autobrakes/sel_dial_pos", "laminar/B747/CAS/advisory_status[17]", "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos" ] },
    { "do": "check", "note": "機長の選んだ IRU でオートブレーキは 3 のまま（FCOM p.1044。前は DISARM に戻った）", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "op": "==", "value": 5 },
    { "do": "set", "dref": "laminar/B747/irs/fail/iru[0]", "value": 0 }
  ]
}
