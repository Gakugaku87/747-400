{
  "name": "s272_nd_klax_final",
  "description": "2026-11-09（性能計測の KSEA-KLAX の全自動の飛行で利用者が見たこと：ND のマゼンタの線が最終進入の点の端から出て次の点の真ん中に入る：notes/ATA-34-61-FMC.md §154）の X-Plane での確認、空中。KLAX の ILS24R の最終の脚（MERCE → KOBEE → RW24R：磁方位 251° で点に入る CF の脚、推奨の航法援助施設は IOSS、その偏差 11.97° E）。経路は KSEA-KLAX の計画に APP I24R を足した tests/flight/data/simbrief/KLAXI24R.fms を FMC COMM の RTE REQUEST で受ける（CO ROUTE KLAXI24R）。MERCE の 6 NM 手前（最終進入のコースの延長）の 4,000 ft・約 230 kt で空中開始（235 t、機体を読み直す）、LEGS で MERCE へ DIRECT TO、LNAV。(1) 機長の ND（MAP 20 NM と 10 NM）の写真：マゼンタの線が MERCE と KOBEE の記号の真ん中を通り、滑走路の延長の破線に重なる（前は線がいちばん近い VOR の偏差 15° E で 3° 回り、点の脇 約 0.4 NM から出た）。(2) LNAV で MERCE から KOBEE への CF の脚を飛ぶ間、LOC の偏位が 0.3 ドットの内（前の 3° では KOBEE で約 0.4 NM、2 ドット近く外れる）。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 33.99303, "longitude": -117.99859, "elevation_in_meters": 1219, "heading_true": 263.0, "speed_in_meters_per_second": 125 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 3899.2, 4104.4, 4925.3, 6361.8, 1231.3, 10281.5, 9173.3, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 2975, 2975, 2975, 2975, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "copy", "note": "KSEA-KLAX の .fms に APP I24R を足したものを simbrief へ（性能計測のファイル KSEAKLAX とは別の名前）", "from": "tests/flight/data/simbrief/KLAXI24R.fms", "to": "simbrief/KLAXI24R.fms" },
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30, "stop": true },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 速度 230 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 230 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 4,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 4000 },
    { "do": "set", "note": "機長の ND は MAP 20 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "cdu", "note": "CLR 2 回、MENU、<FMC（IDENT）", "keys": ["CLR", "CLR", "MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON", "stop": true },
    { "do": "cdu", "note": "FMC COMM、NEXT、CO ROUTE に KLAXI24R（1R）、RTE REQUEST <SEND", "keys": ["FMCCOMM", "NEXT", "KLAXI24R", "R1", "L1"] },
    { "do": "wait", "note": "経路のアップリンク（RTE REQUEST の見出しが消える）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ +CO ROUTE$", "timeout": 45, "stop": true },
    { "do": "cdu", "note": "PREV、<RTE 1、<LOAD", "keys": ["PREV", "L1", "L4"] },
    { "do": "sleep", "seconds": 4 },
    { "do": "cdu", "note": "ACTIVATE、EXEC", "keys": ["R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1", "stop": true },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "スクラッチパッド（文言の出ている間は文字が入らない）", "drefs": [ "laminar/B747/fms3/Line14_L", "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L" ] },
    { "do": "cdu", "note": "CLR を 3 回（文言を消す。無ければ何もしない）", "keys": ["CLR", "CLR", "CLR"] },
    { "do": "cdu", "note": "MERCE へ DIRECT TO（1L）", "keys": ["MERCE", "L1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "DIRECT TO の後", "drefs": [ "laminar/B747/fms3/Line14_L", "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line05_L" ] },
    { "do": "check", "note": "MOD の 1 行目が MERCE", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "MERCE", "stop": true },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS", "stop": true },
    { "do": "check", "note": "次は KOBEE（進入の CF の脚）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "KOBEE" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30, "stop": true },
    { "do": "sleep", "seconds": 4, "note": "ND の線" },
    { "do": "snapshot", "note": "ILS の同調と LOC の偏位、LNAV の横のずれ", "drefs": [ "sim/cockpit/radios/nav1_freq_hz", "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "laminar/B747/fms/lnav/xtk", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude" ] },
    { "do": "wait", "note": "ILS（IOSS 108.50）が同調される（無ければ (2) の偏位は意味が無い）", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 10850, "timeout": 30 },
    { "do": "check", "note": "LOC の電波がある（偏位が有効）", "dref": "sim/cockpit2/radios/indicators/nav1_display_horizontal", "op": "==", "value": 1 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_final_20nm" },
    { "do": "set", "note": "機長の ND は MAP 10 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "capt_nd_final_10nm" },
    { "do": "view", "name": "forward" },
    { "do": "wait", "note": "MERCE を過ぎる（KOBEE が有効な脚）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "KOBEE", "timeout": 180, "stop": true },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_after_merce_10nm" },
    { "do": "view", "name": "forward" },
    { "do": "watch", "note": "(2) MERCE から KOBEE の 1 NM 手前まで、LNAV で CF の脚を飛ぶ間の LOC の偏位は 0.3 ドットの内（前の 3° 回ったコースでは KOBEE で約 0.4 NM・2 ドット近く外れる）", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "abs": true, "max": 0.3, "until": { "dref": "laminar/B747/nd/waypoint_distance", "op": "matches", "value": "^ *[01][.][0-9]nm$" }, "timeout": 240 },
    { "do": "snapshot", "note": "KOBEE の手前", "drefs": [ "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "laminar/B747/fms/lnav/xtk", "laminar/B747/nd/waypoint_distance", "laminar/B747/nd/current_waypoint" ] },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_near_kobee_10nm" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" },
    { "do": "remove", "note": "写したファイルを消す", "path": "simbrief/KLAXI24R.fms" }
  ]
}
