{
  "name": "s118_afds_interlocks",
  "description": "AFDS の作り直し 6-3 段 5a（engage のインターロック）の X-Plane での確認、空中。10,000 ft・約 290 kt で空中から始め（機体を読み直す）、空中の初期化の CMD L で、SRM L の故障（autotrim valid を失う）で単一チャンネルの L が外れて AUTOPILOT DISC、CMD L は入らず CMD C は SRM R のもので入る（L FCC は SRM L、R は SRM R、C は両方：ATA22 p.224、p.318）、SRM R も故障で C が外れ、どの CMD も入らない（FCOM p.47）、戻して CMD L。ADC は 1 台の故障では外れず、2 台目で外れて engage できない（ATA22 p.316、p.382）、戻して CMD R。最後に IRU を 2 台故障にして外れる（戻すには整列が要る）。操縦輪 25° の arm と単一チャンネルのエルロンの上限、FCC の電源と DC STBY は回帰試験だけ（X-Plane では操縦輪と母線を Web API から動かせない）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の空中の初期化を待つ" },
    { "do": "wait", "note": "空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 20 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CMD L", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "SRM L の autotrim valid", "dref": "laminar/B747/flt_ctrls/stab_trim/autotrim_valid[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "SRM R の autotrim valid", "dref": "laminar/B747/flt_ctrls/stab_trim/autotrim_valid[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "AUTOPILOT DISC は無い", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "SRM L の故障：単一チャンネルの L は外れる、C は SRM R のもので入る（ATA22 p.224、p.318）" },
    { "do": "set", "note": "SRM L の故障", "dref": "laminar/B747/flt_ctrls/fail/srm[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "SRM L の autotrim valid を失う", "dref": "laminar/B747/flt_ctrls/stab_trim/autotrim_valid[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "L は外れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CMD L は入らない", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/P CMD C", "name": "laminar/B747/autopilot/button_switch/cmd_C" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CMD C は SRM R の autotrim valid で入る", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "engage で AUTOPILOT DISC が消える", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 5, "note": "C で保つ" },
    { "do": "check", "note": "C のまま", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 1 },

    { "do": "mark", "note": "SRM R も故障：C も外れ、どの CMD も入らない（FCOM p.47）" },
    { "do": "set", "note": "SRM R の故障", "dref": "laminar/B747/flt_ctrls/fail/srm[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "C は外れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "cas", "note": "AUTOPILOT DISC（NO AUTOLAND の EICAS は段 5b）" },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_srm_both" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "cmd", "note": "A/P CMD C", "name": "laminar/B747/autopilot/button_switch/cmd_C" },
    { "do": "cmd", "note": "A/P CMD R", "name": "laminar/B747/autopilot/button_switch/cmd_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "どの CMD も入らない", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "set", "note": "SRM L を戻す", "dref": "laminar/B747/flt_ctrls/fail/srm[0]", "value": 0 },
    { "do": "set", "note": "SRM R を戻す", "dref": "laminar/B747/flt_ctrls/fail/srm[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "戻すと CMD L が入る", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "engage で AUTOPILOT DISC が消える", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "ADC：1 台の故障では外れず、2 台目で外れる（ATA22 p.316、p.382）" },
    { "do": "set", "note": "ADC L の故障", "dref": "laminar/B747/airdata/fail/adc[0]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ADC L は無効", "dref": "laminar/B747/airdata/valid[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "1 台では外れない", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "set", "note": "ADC C の故障", "dref": "laminar/B747/airdata/fail/adc[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 台目で外れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "A/P CMD R", "name": "laminar/B747/autopilot/button_switch/cmd_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "engage できない", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "set", "note": "ADC L を戻す", "dref": "laminar/B747/airdata/fail/adc[0]", "value": 0 },
    { "do": "set", "note": "ADC C を戻す", "dref": "laminar/B747/airdata/fail/adc[1]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "A/P CMD R", "name": "laminar/B747/autopilot/button_switch/cmd_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "戻すと CMD R が入る", "dref": "laminar/B747/autopilot/cmd_R_mode/status", "op": "==", "value": 1 },

    { "do": "mark", "note": "IRU：2 台の故障で外れる（ATA22 p.316。戻すには整列が要るので最後）" },
    { "do": "set", "note": "IRU L の故障", "dref": "laminar/B747/irs/fail/iru[0]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "IRU L の姿勢は無効", "dref": "laminar/B747/irs/att_valid[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "1 台では外れない", "dref": "laminar/B747/autopilot/cmd_R_mode/status", "op": "==", "value": 1 },
    { "do": "set", "note": "IRU C の故障", "dref": "laminar/B747/irs/fail/iru[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 台目で外れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "set", "note": "IRU L を戻す", "dref": "laminar/B747/irs/fail/iru[0]", "value": 0 },
    { "do": "set", "note": "IRU C を戻す", "dref": "laminar/B747/irs/fail/iru[1]", "value": 0 },
    { "do": "view", "name": "forward" }
  ]
}
