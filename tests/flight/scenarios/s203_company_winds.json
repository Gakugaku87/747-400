{
  "name": "s203_company_winds",
  "description": "6-1・6-2 段 12h2（会社のデータリンク：風のアップリンク）と 12h3（OFP の ACARS の文）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。tests/flight/data/simbrief の .fms と OFP を simbrief に写し、SIM CONFIG で FMC DATALINK を ON（最後に AUTO、保存しない）。FMC COMM 2/2 の RTE REQUEST で経路を受けて RTE 1 に LOAD、ACTIVATE と EXEC。経路の答えといっしょに会社の OFP の文（EICAS の ACARS MESSAGE、ACARS の UPLINK の一覧の OFP RJAA-RJBB）。WIND REQUEST <SEND の SENDING と SENT、約 20 秒後に FMC COMM 1/2 の <DES FORECAST と <RTE DATA の上に UPLINK。RTE DATA の 6R の WIND DATA LOAD> で MOD RTE 1 DATA と <ERASE、EXEC で ACT に戻り ATMUG が W>。DESCENT FORECAST の FORECAST UPLINK の <LOAD で 4 つの高度の風、REQUEST <SEND と DES> に戻る。CDU を撮る。最後に写したファイルを消す。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "copy", "note": "SimBrief の .fms を simbrief へ", "from": "tests/flight/data/simbrief/RJAARJBB01.fms", "to": "simbrief/RJAARJBB01.fms" },
    { "do": "copy", "note": "OFP の XML を simbrief へ", "from": "tests/flight/data/simbrief/ofp_rjaa_rjbb.xml", "to": "simbrief/ofp_rjaa_rjbb.xml" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "FMC COMM、NEXT、CO ROUTE に RJAARJBB01（1R）、RTE REQUEST <SEND。2026-11-03 から CO ROUTE を入れる：SIMBRIEF PILOT ID が入っていると、CO ROUTE なしの要求は利用者の SimBrief のいちばん新しい計画を取ってきて使う（simbrief/README.txt。全シナリオの回の s201 で RJFF→PANC が来た）", "keys": ["FMCCOMM", "NEXT", "RJAARJBB01", "R1", "L1"] },
    { "do": "wait", "note": "経路のアップリンク（RTE REQUEST の見出しが消える）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ +CO ROUTE$", "timeout": 45 },
    { "do": "cdu", "note": "PREV、<RTE 1、<LOAD", "keys": ["PREV", "L1", "L4"] },
    { "do": "sleep", "seconds": 4 },
    { "do": "cdu", "note": "ACTIVATE、EXEC", "keys": ["R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "check", "note": "（段 12h3）会社の OFP の文で EICAS の ACARS MESSAGE", "dref": "laminar/B747/CAS/memo_status[0]", "op": "==", "value": 1 },
    { "do": "cdu", "note": "MENU、<ACARS、MSGS>、<UPLINK", "keys": ["MENU", "L2", "R1", "L2"] },
    { "do": "check", "note": "会社の OFP の文", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "OFP RJAA-RJBB" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_acars_ofp_list" },
    { "do": "cdu", "note": "その文を開く", "keys": ["L1"] },
    { "do": "shot", "name": "cdu_acars_ofp_text" },
    { "do": "cdu", "note": "FMC COMM、NEXT", "keys": ["FMCCOMM", "NEXT"] },
    { "do": "check", "note": "WIND REQUEST（FCOM p.773）", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "WIND REQUEST" },
    { "do": "cdu", "note": "WIND REQUEST <SEND", "keys": ["L2"] },
    { "do": "check", "note": "SENDING", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "SENDING" },
    { "do": "wait", "note": "網の受け取りで SENT", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "SENT", "timeout": 15 },
    { "do": "wait", "note": "約 20 秒後に風のアップリンク（SENT が消える）", "dref": "laminar/B747/fms3/Line05_S", "op": "matches", "value": "^ *$", "timeout": 40 },
    { "do": "cdu", "note": "PREV（1/2）", "keys": ["PREV"] },
    { "do": "check", "note": "<DES FORECAST の上に UPLINK（FMSPG p.368）", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "UPLINK" },
    { "do": "check", "note": "<RTE DATA の上に UPLINK（FMSPG p.369）", "dref": "laminar/B747/fms3/Line06_S", "op": "contains", "value": "UPLINK" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_fmc_comm_wind_uplink" },
    { "do": "cdu", "note": "<RTE DATA", "keys": ["L3"] },
    { "do": "check", "note": "ACT RTE 1 DATA", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 DATA" },
    { "do": "check", "note": "<LEGS と LOAD>（FCOM p.1363）", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<LEGS              LOAD>" },
    { "do": "check", "note": "WIND DATA", "dref": "laminar/B747/fms3/Line12_S", "op": "contains", "value": "WIND DATA" },
    { "do": "shot", "name": "cdu_rte_data_load" },
    { "do": "cdu", "note": "LOAD>", "keys": ["R6"] },
    { "do": "check", "note": "MOD RTE 1 DATA（FMSPG p.378）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 DATA" },
    { "do": "check", "note": "<ERASE と SEND>", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<ERASE             SEND>" },
    { "do": "shot", "name": "cdu_rte_data_mod" },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ACT RTE 1 DATA", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 DATA" },
    { "do": "check", "note": "ATMUG に W>（風が入った）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "ATMUG +W>$" },
    { "do": "cdu", "note": "FMC COMM、<DES FORECAST", "keys": ["FMCCOMM", "L2"] },
    { "do": "check", "note": "DESCENT FORECAST", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "DESCENT FORECAST" },
    { "do": "check", "note": "FORECAST UPLINK（FCOM p.1395）", "dref": "laminar/B747/fms3/Line12_S", "op": "contains", "value": "FORECAST UPLINK" },
    { "do": "check", "note": "<LOAD と PURGE>", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<LOAD             PURGE>" },
    { "do": "shot", "name": "cdu_des_forecast_uplink" },
    { "do": "cdu", "note": "<LOAD", "keys": ["L6"] },
    { "do": "check", "note": "1 つ目の高度 FL250", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "FL250" },
    { "do": "check", "note": "4 つ目の高度 5000", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "5000" },
    { "do": "check", "note": "REQUEST <SEND と DES> に戻る（FCOM p.1397）", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<SEND               DES>" },
    { "do": "shot", "name": "cdu_des_forecast_loaded" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "remove", "note": "写したファイルを消す", "path": "simbrief/RJAARJBB01.fms" },
    { "do": "remove", "path": "simbrief/ofp_rjaa_rjbb.xml" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
