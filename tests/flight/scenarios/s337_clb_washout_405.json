    { "do": "check", "note": "EEC のモードも CLB 2", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CLB 2" },
    { "do": "snapshot", "note": "CLB 2、FL200", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/fms/thrlim/eicas", "laminar/B747/freighter", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/flightmodel2/position/pressure_altitude", "sim/flightmodel/misc/machno" ] },
    { "do": "check", "note": "気圧高度は 15,000 ft より上（19,000〜21,500 ft）", "dref": "sim/flightmodel2/position/pressure_altitude", "op": "between", "value": [19000, 21500] },
    { "do": "check", "note": "405：15,000 ft より上の CLB 2 は CLB と同じ（109 なら約 0.1 下）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [-0.005, 0.005], "rel": "clb_ref", "cite": "FCOM p.1273 (11.32.3)" },
    { "do": "check", "note": "EICAS の行は CLB 2 のまま（高度では変わらない）", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "CLB 2" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_clb2_405_fl200" },
    { "do": "cdu", "note": "CLB>（R2）に戻す", "keys": ["R2"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CLB", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 20 },
    { "do": "view", "name": "forward" }
  ]
