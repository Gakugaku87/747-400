{
  "name": "s196_atc_whencanwe",
  "description": "6-1・6-2 段 12g3a（WHEN CAN WE EXPECT）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO に戻す、保存はしない）。ATC INDEX の WHEN CAN WE> でページ、CLIMB TO の入力で CRZ CLB TO と HIGHER ALT が消えること、SPEED と BACK ON RTE の選択、VERIFY REQUEST の WHEN CAN WE EXPECT と 6L の <WHEN CAN WE、DATA LINK NO COMM、<WHEN CAN WE で戻って ERASE WHEN CAN WE を確かめる。AutoATC の無いこの PC では送れない。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "ATC キー（LOGON/STATUS）、<INDEX、WHEN CAN WE>", "keys": ["ATC", "L6", "R2"] },
    { "do": "check", "note": "WHEN CAN WE EXPECT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "WHEN CAN WE EXPECT" },
    { "do": "check", "note": "CRZ CLB TO の dashes", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "-----" },
    { "do": "check", "note": "HIGHER ALT>", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "HIGHER ALT>" },
    { "do": "cdu", "note": "2L に FL370", "keys": ["FL370", "L2"] },
    { "do": "check", "note": "CLIMB TO FL370", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "FL370" },
    { "do": "check", "note": "CRZ CLB TO が消える（FMSPG p.320）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ *$" },
    { "do": "check", "note": "HIGHER ALT が消える（FMSPG p.322）", "dref": "laminar/B747/fms3/Line05_S", "op": "matches", "value": "^ *$" },
    { "do": "cdu", "note": "4L に .84、4R の BACK ON RTE", "keys": [".84", "L4", "R4"] },
    { "do": "check", "note": "BACK ON RTE が大きい字に", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "BACK ON RTE" },
    { "do": "check", "note": "<ERASE WHEN CAN WE", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "<ERASE WHEN CAN WE" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_when_can_we" },
    { "do": "cdu", "note": "VERIFY>", "keys": ["R6"] },
    { "do": "check", "note": "VERIFY REQUEST", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "VERIFY REQUEST" },
    { "do": "check", "note": "WHEN CAN WE EXPECT", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "WHEN CAN WE EXPECT" },
    { "do": "check", "note": "CLIMB TO FL370", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "FL370" },
    { "do": "check", "note": "6L は <WHEN CAN WE（FCOM p.745）", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<WHEN CAN WE" },
    { "do": "shot", "name": "cdu_verify_when_can_we" },
    { "do": "cdu", "note": "NEXT（SEND の欄）", "keys": ["NEXT"] },
    { "do": "check", "note": "AutoATC が無いので NO COMM", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "NO COMM" },
    { "do": "cdu", "note": "<WHEN CAN WE、<ERASE WHEN CAN WE", "keys": ["L6", "L5"] },
    { "do": "check", "note": "消えて CRZ CLB TO の dashes", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "-----" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
