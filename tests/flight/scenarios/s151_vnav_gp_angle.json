{
  "name": "s151_vnav_gp_angle",
  "description": "6-1/6-2 段 9e4（進入の glide path angle）の X-Plane での確認。s149 と同じく RJBB の ILS06LY（遷移 GATES）の GATES の約 8 NM 手前（035°）から 10,000 ft・250 kt で空中開始（機体を読み直す）、フラップ 5、同じ経路（RJAA→RJBB、STAR ATMUGA、ILS06LY、遷移 GATES）を ACTIVATE と EXEC、GATES へ DIRECT TO、LNAV、PERF INIT（ZFW 200・CI 100・CRZ ALT FL300）。LEGS の BOLAL（FAF）と RW06L へ入る脚の見出しに GP 3.00（CIFP の −3.00：FCOM p.1405）。MCP 1,000 ft で VNAV の降下：BOLAL の先の最終進入は 3 度の線の VNAV PTH（FCOM p.1262）で、経路からのずれが小さく、降下率は 3 度の分（対地速度 180〜240 kt で 950〜1,270 fpm）。MCP の 1,000 ft で VNAV ALT。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.0301, "longitude": 134.7248, "elevation_in_meters": 3048, "heading_true": 35, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 1,000 ft（機体より下）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 1000 },
    { "do": "cmd", "note": "フラップ 1", "name": "sim/flight_controls/flaps_down" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "フラップ 5", "name": "sim/flight_controls/flaps_down" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：GATES へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "GATES", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が GATES", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "GATES" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "snapshot", "note": "LEGS の 1 ページ目", "drefs": [ "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line06_S", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line08_S", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "4 行目は BOLAL（FAF）", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "BOLAL" },
    { "do": "check", "note": "BOLAL へ入る脚の見出しに GP 3.00（FCOM p.1405）", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "GP  3.00" },
    { "do": "check", "note": "5 行目は RW06L", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "RW06L" },
    { "do": "check", "note": "RW06L へ入る脚の見出しにも GP 3.00", "dref": "laminar/B747/fms3/Line10_S", "op": "contains", "value": "GP  3.00" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV で engage", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2, "timeout": 10 },
    { "do": "check", "note": "FMC は降下（3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3 },
    { "do": "wait", "note": "GATES を過ぎて on approach", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 1, "timeout": 180 },
    { "do": "wait", "note": "BOLAL（約 4,100 ft）の先の最終進入、3,000 ft より下", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 3000, "timeout": 500 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "最終進入の 3 度の線", "drefs": [ "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/at", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/position/groundspeed", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "VNAV PTH", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "経路からのずれは 150 ft の内", "dref": "laminar/B747/fms/vnav/path_dev", "op": "between", "value": [-150, 150] },
    { "do": "check", "note": "FMC の V/S は 3 度の分（対地速度 180〜240 kt で 950〜1,270 fpm）", "dref": "laminar/B747/fms/vnav/vs", "op": "between", "value": [-1400, -800] },
    { "do": "check", "note": "降下率も 3 度の分", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-1500, -700] },
    { "do": "wait", "note": "MCP の 1,000 ft で VNAV ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 5, "timeout": 200 },
    { "do": "wait", "note": "1,000 ft で水平", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [950, 1100], "timeout": 60 },
    { "do": "record_stop" }
  ]
}
