{
  "name": "s48_pfd_ra",
  "description": "PFD の TCAS RA の表示（5-1 段 5d、パネルの変更）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt で開始（機体を読み直す）。X-Plane の TCAS が advisory を出さなくなっていると通らない（X-Plane を起動し直してから流す：TESTING.md）。試験用の相手機（tests/flight/fwl/B747_traffic.lua）で、上昇中に上の相手機の RA（CLIMB 系なら下の赤枠のピッチ領域と VSI の下の赤帯）、水平飛行で上の相手機の RA（X-Plane は DON'T CLIMB の予防 RA を出すことが多い：上の赤枠と上の赤帯。上昇して VS ポインタが赤、降下で白）。昇降率が赤の範囲にあるうちは VS ポインタが赤、出ると白（FCOM p.1536–1537）。X-Plane の RA は数秒で終わることがあるので、上昇中の RA では始まりだけを撮る。赤枠が姿勢と一緒に回ることと、赤枠の切り抜き（ポインタの CLIP、464 px 四方）は、窓のマスクを外した実験で確かめた（TESTING.md）。機長と副操縦士の PFD を撮る（撮る間は操縦輪を隠す：この 3D では hide_yoke 0 で隠れる）。RA の向きは X-Plane の TCAS が決めるので、向きに依る確認は warn。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007（磁方位で真北）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 15, "note": "水平飛行に落ち着く" },
    { "do": "check", "note": "TCAS が働く", "dref": "laminar/B747/tcas/operating", "op": "==", "value": 1 },
    { "do": "check", "note": "RA を出せる", "dref": "laminar/B747/tcas/ra_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "RA の表示なし", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 0 },
    { "do": "check", "note": "VS ポインタは白", "dref": "laminar/B747/tcas/pfd/vs_red", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_start" },

    { "do": "mark", "note": "上昇中の RA（下の領域）" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt1" },
    { "do": "set", "note": "MCP 高度を 3,000 ft 上に", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000, "rel": "alt1", "round": 100 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S +1,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "wait", "note": "上昇", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 700, "timeout": 30 },
    { "do": "traffic", "note": "正面から、上昇の始めの高度の 300 ft 上、50 秒で最接近", "targets": [ "tcpa=50 brg=0 gs=300 dh=300 vs=0 miss=0" ] },
    { "do": "wait", "note": "X-Plane の TCAS の RA（出なければ下の確認は通らない：TESTING.md）", "dref": "sim/cockpit2/tcas/indicators/tcas_active_advisory", "op": "==", "value": 2, "timeout": 50, "level": "warn" },
    { "do": "wait", "note": "RA（PFD の RA の値）", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 1, "timeout": 5 },
    { "do": "snapshot", "note": "RA の値", "drefs": [ "sim/cockpit2/tcas/indicators/tcas_message", "sim/cockpit2/tcas/indicators/tcas_vs_bands",
      "laminar/B747/tcas/pfd/lo_on", "laminar/B747/tcas/pfd/hi_on", "laminar/B747/tcas/pfd/vs_lo", "laminar/B747/tcas/pfd/vs_hi",
      "laminar/B747/tcas/pfd/pitch_lo", "laminar/B747/tcas/pfd/pitch_hi", "laminar/B747/tcas/pfd/vs_red",
      "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/position/theta", "sim/flightmodel/position/true_airspeed" ] },
    { "do": "check", "note": "CLIMB 系：下に赤の領域（X-Plane が向きを決める）", "dref": "laminar/B747/tcas/pfd/lo_on", "op": "==", "value": 1, "level": "warn" },
    { "do": "check", "note": "+1,000 fpm は赤の範囲：VS ポインタが赤（FCOM p.1537）", "dref": "laminar/B747/tcas/pfd/vs_red", "op": "==", "value": 1, "level": "warn" },
    { "do": "check", "note": "機体シンボルは下の領域の中：境はシンボルより上", "dref": "laminar/B747/tcas/pfd/pitch_lo", "op": ">", "value": 0, "level": "warn" },
    { "do": "shot", "name": "pfd_ra_climb" },
    { "do": "view", "note": "副操縦士の PFD", "the": -19, "psi": 47, "fov": 20 },
    { "do": "shot", "name": "fo_pfd_ra_climb" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "wait", "note": "CLEAR OF CONFLICT", "dref": "laminar/B747/tcas/last_voice", "op": "==", "value": 14, "timeout": 60, "level": "warn" },
    { "do": "wait", "note": "RA の表示が消える", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 0, "timeout": 30 },
    { "do": "check", "note": "VS ポインタは白", "dref": "laminar/B747/tcas/pfd/vs_red", "op": "==", "value": 0 },
    { "do": "traffic_stop" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt2" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt2", "round": 100 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "wait", "note": "水平飛行", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-300, 300], "timeout": 60 },
    { "do": "wait", "note": "翼が水平", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3], "timeout": 60 },
    { "do": "shot", "name": "pfd_after_climb_ra" },

    { "do": "mark", "note": "水平飛行の RA（上の領域）" },
    { "do": "traffic", "note": "正面から 300 ft 上、50 秒で最接近（水平の自機）", "targets": [ "tcpa=50 brg=0 gs=300 dh=300 vs=0 miss=0" ] },
    { "do": "wait", "note": "X-Plane の TCAS の RA", "dref": "sim/cockpit2/tcas/indicators/tcas_active_advisory", "op": "==", "value": 2, "timeout": 50, "level": "warn" },
    { "do": "wait", "note": "RA（PFD の RA の値）", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 1, "timeout": 5 },
    { "do": "snapshot", "note": "RA の値", "drefs": [ "sim/cockpit2/tcas/indicators/tcas_message", "sim/cockpit2/tcas/indicators/tcas_vs_bands",
      "laminar/B747/tcas/pfd/lo_on", "laminar/B747/tcas/pfd/hi_on", "laminar/B747/tcas/pfd/vs_lo", "laminar/B747/tcas/pfd/vs_hi",
      "laminar/B747/tcas/pfd/pitch_lo", "laminar/B747/tcas/pfd/pitch_hi", "laminar/B747/tcas/pfd/vs_red", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "上に赤の領域（X-Plane は DON'T CLIMB の予防 RA（MONITOR VERTICAL SPEED）か DESCEND を出す）", "dref": "laminar/B747/tcas/pfd/hi_on", "op": "==", "value": 1, "level": "warn" },
    { "do": "shot", "name": "pfd_ra_level" },
    { "do": "set", "note": "MCP 高度を 2,000 ft 上に（V/S で上るため）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 2000, "rel": "alt2", "round": 100 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "赤の範囲へ：V/S +800 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 800 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 800 },
    { "do": "wait", "note": "昇降率が赤の範囲：VS ポインタが赤（FCOM p.1537）", "dref": "laminar/B747/tcas/pfd/vs_red", "op": "==", "value": 1, "timeout": 15, "level": "warn" },
    { "do": "snapshot", "note": "赤の範囲の値", "drefs": [ "laminar/B747/tcas/pfd/ra", "laminar/B747/tcas/pfd/hi_on", "laminar/B747/tcas/pfd/vs_hi", "laminar/B747/tcas/pfd/pitch_hi", "laminar/B747/tcas/pfd/vs_red", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "機体シンボルは上の領域の中：境はシンボルより下", "dref": "laminar/B747/tcas/pfd/pitch_hi", "op": "<", "value": 0, "level": "warn" },
    { "do": "shot", "name": "pfd_ra_level_climbing" },
    { "do": "view", "note": "副操縦士の PFD", "the": -19, "psi": 47, "fov": 20 },
    { "do": "shot", "name": "fo_pfd_ra_level_climbing" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "set", "note": "MCP 高度を 2,000 ft 下に", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": -2000, "rel": "alt2", "round": 100 },
    { "do": "set", "note": "RA に従う：V/S -1,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -1000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": -1000 },
    { "do": "wait", "note": "赤の範囲を出る：VS ポインタが白", "dref": "laminar/B747/tcas/pfd/vs_red", "op": "==", "value": 0, "timeout": 20, "level": "warn" },
    { "do": "snapshot", "note": "従ったあとの値", "drefs": [ "laminar/B747/tcas/pfd/ra", "laminar/B747/tcas/pfd/hi_on", "laminar/B747/tcas/pfd/vs_hi", "laminar/B747/tcas/pfd/pitch_hi", "laminar/B747/tcas/pfd/vs_red", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "shot", "name": "pfd_ra_level_follow" },
    { "do": "wait", "note": "RA の表示が消える", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 0, "timeout": 60 },
    { "do": "check", "note": "VS ポインタは白", "dref": "laminar/B747/tcas/pfd/vs_red", "op": "==", "value": 0 },
    { "do": "traffic_stop" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt3" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt3", "round": 100 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "pfd_end" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
