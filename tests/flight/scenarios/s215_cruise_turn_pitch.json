{
  "name": "s215_cruise_turn_pitch",
  "description": "巡航の高度保持のピッチの揺れ（2026-11-02、notes/ATA-22.md §44）の X-Plane での確認、空中。伊豆諸島の南の海上 FL250・指示約 334 kt（真 245 m/s）・西向きで開始（機体を読み直す、カスタム acf）、A/P と A/T、HDG SEL、FLCH で FL250 を捕捉して ALT・SPD 334 kt。まっすぐ 60 秒のあと MCP の方位で右へ 90° 旋回し、戻してから 60 秒置いて、90 秒の昇降率が ±60 fpm 以内、続く 30 秒の荷重倍数が 0.98〜1.02 か見る。ラインフライト（LF2〜LF5）と s206 は、FL250 の巡航で旋回のあとに周期 9.6 秒・±140 fpm・0.947〜1.051 g の揺れが減らずに続いた（姿勢の指令は 0.05 g の速さの制限に張り付く）。記録を取る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 32.80, "longitude": 139.20, "elevation_in_meters": 7620.0, "heading_true": 270, "speed_in_meters_per_second": 245.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 方位：今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 277 },
    { "do": "set", "note": "MCP 速度 334 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 334 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "set", "note": "MCP 高度 FL250（空中開始の揺れで数百 ft 動くので、FLCH で戻して捕捉する：1 回目は ALT HOLD で 25,329 ft を保った）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 25000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 25000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FL250 で ALT（捕捉の始まりから ALT）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 240 },
    { "do": "wait", "note": "捕捉が終わる：FL250 の ±50 ft（2 回目は空中開始の後に 27,300 ft・246 kt まで上がり、4,300 fpm の FLCH からの捕捉の終わりがまっすぐの 60 秒に入った）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [24950, 25050], "timeout": 240 },
    { "do": "wait", "note": "捕捉が終わる：昇降率 ±60 fpm", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-60, 60], "timeout": 180 },
    { "do": "cmd", "note": "SPD（FLCH の間は効かない：FCOM p.642）", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 60, "note": "落ち着く" },
    { "do": "snapshot", "note": "まっすぐ", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/active_roll_mode" ] },
    { "do": "watch", "note": "まっすぐの 60 秒：昇降率 ±60 fpm", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -60, "max": 60, "timeout": 60 },
    { "do": "mark", "note": "旋回" },
    { "do": "set", "note": "MCP 方位 007：右へ 90°", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "wait", "note": "旋回に入る（バンク 15° 超え）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 15, "timeout": 20 },
    { "do": "wait", "note": "旋回から戻る（バンク 2° 未満）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "<", "value": 2, "timeout": 180 },
    { "do": "mark", "note": "旋回のあと" },
    { "do": "sleep", "seconds": 60 },
    { "do": "watch", "note": "旋回のあとの 90 秒：昇降率 ±60 fpm（前は ±140 fpm で続いた）", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -60, "max": 60, "timeout": 90 },
    { "do": "watch", "note": "続く 30 秒：荷重倍数 0.98〜1.02（前は 0.947〜1.051）", "dref": "sim/flightmodel2/misc/gforce_normal", "min": 0.98, "max": 1.02, "timeout": 30 },
    { "do": "snapshot", "note": "旋回のあと", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel2/misc/gforce_normal", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "FL250 の ±50 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 24950 },
    { "do": "check", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 25050 },
    { "do": "record_stop" }
  ]
}
