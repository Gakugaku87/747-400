{
  "name": "s158_rta_pages",
  "description": "6-1/6-2 段 9h5a（RTA PROGRESS のページと RTA の変更・EXEC）の X-Plane での確認。空中、FL350 の巡航（機体を読み直す）、RJAA→RJBB の経路、PERF INIT で ZFW 200・CRZ ALT FL350・COST INDEX 100、VNAV PTH。PROGRESS 1/3 で PREV：RTA PROGRESS 3/3（FMSPG p.3.4-52）、1L は箱。経路に無い点は INVALID ENTRY、SPENS で MOD RTA PROGRESS と 1R の箱、時刻 1740.0B で 1740.0zB と EXEC の灯、EXEC で ACT RTA PROGRESS、2R に ALT/ETA（予測の SPENS の高度と時刻）、MAX SPD の入力と DELETE（.880 小さい字）、CRZ のページの <RTA PROGRESS で 3/3、時刻の DELETE で終わり PRIOR RTA>、ERASE（FCOM p.1354、p.1383–1385）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "set", "note": "MCP 高度 35,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "sleep", "seconds": 5 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH（巡航）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 60 },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと）" },

    { "do": "mark", "note": "PROGRESS 1/3 から PREV で RTA PROGRESS 3/3" },
    { "do": "cdu", "note": "PROG", "keys": ["PROG"] },
    { "do": "check", "note": "PROGRESS 1/3", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "1/3" },
    { "do": "cdu", "note": "PREV", "keys": ["PREV"] },
    { "do": "check", "note": "RTA PROGRESS 3/3（FMSPG p.3.4-52）", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "3/3" },
    { "do": "check", "note": "題は RTA PROGRESS（ACT も MOD もなし）", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "^ +RTA PROGRESS +$" },
    { "do": "check", "note": "1L の FIX は箱（FCOM p.1384：経路がある）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^[*]{5}" },
    { "do": "check", "note": "3L の MAX SPD は .880 の小さい字", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "^[.]880" },

    { "do": "mark", "note": "FIX と時刻、EXEC" },
    { "do": "cdu", "note": "経路に無い点", "keys": ["NOFIX", "L1"] },
    { "do": "check", "note": "INVALID ENTRY", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cdu", "note": "CLR を 7 回（1 回目は通知を消すだけで NOFIX が書き込み行に戻る：初めの版（2026-11-01 3:45）はそこへ SPENS を続けて打ち、NOFIXSPENS になった）", "keys": ["CLR", "CLR", "CLR", "CLR", "CLR", "CLR", "CLR"] },
    { "do": "check", "note": "書き込み行は空", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^ *$" },
    { "do": "cdu", "note": "SPENS を 1L へ", "keys": ["SPENS", "L1"] },
    { "do": "check", "note": "MOD RTA PROGRESS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTA PROGRESS" },
    { "do": "check", "note": "1L SPENS、1R は箱", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^SPENS +[*]{7}$" },
    { "do": "check", "note": "時刻の前は EXEC の灯なし", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 0 },
    { "do": "cdu", "note": "1740.0B を 1R へ", "keys": ["1740.0B", "R1"] },
    { "do": "check", "note": "1R 1740.0zB", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "1740[.]0zB$" },
    { "do": "check", "note": "EXEC の灯", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 1 },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ACT RTA PROGRESS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTA PROGRESS" },
    { "do": "check", "note": "EXEC の灯は消える", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 0 },
    { "do": "check", "note": "2R は ALT/ETA（予測の SPENS の高度と時刻）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "[0-9]/[0-9]{4}[.][0-9]z$" },
    { "do": "snapshot", "note": "RTA PROGRESS", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_S", "laminar/B747/fms3/Line13_L" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_rta_progress" },
    { "do": "cdu", "note": "MAX SPD .85", "keys": [".85", "L3"] },
    { "do": "check", "note": "MAX SPD .850 の大きい字", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^[.]850" },
    { "do": "cdu", "note": "MAX SPD の DELETE", "keys": ["DEL", "L3"] },
    { "do": "check", "note": ".880 の小さい字に戻る", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "^[.]880" },

    { "do": "mark", "note": "CRZ のページの <RTA PROGRESS" },
    { "do": "cdu", "note": "VNAV（CRZ のページ）", "keys": ["VNAV"] },
    { "do": "check", "note": "6L <RTA PROGRESS", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^<RTA PROGRESS" },
    { "do": "cdu", "note": "6L", "keys": ["L6"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "RTA PROGRESS 3/3（FCOM p.1354）", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "3/3" },

    { "do": "mark", "note": "時刻の DELETE で終わり、PRIOR RTA>" },
    { "do": "cdu", "note": "時刻の DELETE", "keys": ["DEL", "R1"] },
    { "do": "check", "note": "題は RTA PROGRESS に戻る", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "^ +RTA PROGRESS +$" },
    { "do": "check", "note": "6R PRIOR RTA>（FCOM p.1384）", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "PRIOR RTA>$" },
    { "do": "cdu", "note": "PRIOR RTA>", "keys": ["R6"] },
    { "do": "check", "note": "MOD に前の SPENS と時刻", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^SPENS +1740[.]0zB$" },
    { "do": "cdu", "note": "6L <ERASE", "keys": ["L6"] },
    { "do": "check", "note": "ERASE で消える", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "^ +RTA PROGRESS +$" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
