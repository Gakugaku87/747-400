{
  "name": "s148_vnav_speed_reversion",
  "description": "6-1/6-2 段 9e1（降下の速さの許容と速度の逆戻り）の X-Plane での確認。s143 と同じ（FL300 の T/D の手前から東へ空中開始、機体を読み直す、同じ経路・LNAV・ZFW 200・CI 100・FL300、MCP は FL300 のまま VNAV）で、RESET MCP ALT の後 4 分（T/D を約 2 分過ぎ、経路が機体の数千 ft 下になる）待ってから MCP を 10,000 ft に：FMC は降下に入り、VNAV PTH が経路へ急に降りて速くなる。VMO/MMO −16（349 kt）を超えると DRAG REQUIRED（FCOM p.1259、p.1431）、354 kt を超えても経路の 150 ft の内に戻れないと速度の逆戻り：VNAV SPD で 349 kt、A/T は IDLE か HOLD。経路に戻ると VNAV PTH（FMSPG p.3.5-17 の図：推定）。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 133.52, "elevation_in_meters": 9144, "heading_true": 97, "speed_in_meters_per_second": 225 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 FL300（巡航高度のまま：T/D を過ぎても FMC は高度を保つ）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 30000 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage（巡航）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "wait", "note": "RESET MCP ALT（T/D の 2 分の内、MCP が巡航高度）", "dref": "laminar/B747/fms/notification[33]", "op": "==", "value": 1, "timeout": 120 },
    { "do": "sleep", "seconds": 240, "note": "4 分：T/D を約 2 分過ぎ、経路は機体の数千 ft 下に（ATC に高く保たれた形）" },
    { "do": "check", "note": "FMC は巡航（2）のまま（MCP が巡航高度）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "wait", "note": "FMC は降下（3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 10 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "降下の始め", "drefs": [ "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/cas", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "経路の 2,000 ft より上", "dref": "laminar/B747/fms/vnav/path_dev", "op": ">", "value": 2000 },
    { "do": "check", "note": "VNAV PTH（経路へ）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "wait", "note": "349 kt（VMO/MMO −16）を超えると DRAG REQUIRED（FCOM p.1259）", "dref": "laminar/B747/fms/vnav/msg", "op": "==", "value": 2, "timeout": 400 },
    { "do": "snapshot", "note": "DRAG REQUIRED の時", "drefs": [ "laminar/B747/fms3/Line14_L", "laminar/B747/fms/notification[9]", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms/vnav/path_dev", "laminar/B747/autopilot/FMA/active_pitch_mode", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "CDU の DRAG REQUIRED の旗（9）", "dref": "laminar/B747/fms/notification[9]", "op": "==", "value": 1 },
    { "do": "check", "note": "349 kt より速い", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 348 },
    { "do": "wait", "note": "354 kt を超えて経路の 150 ft の内に戻れない：速度の逆戻りで VNAV SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 300 },
    { "do": "snapshot", "note": "逆戻りの時", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mode", "laminar/B747/fms/vnav/at", "laminar/B747/fms/vnav/msg", "laminar/B747/fms/vnav/path_dev", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "check", "note": "FMC の目標は 349 kt の近く（VMO/MMO −16）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [340, 352] },
    { "do": "check", "note": "FMC は VNAV SPD（1）", "dref": "laminar/B747/fms/vnav/mode", "op": "==", "value": 1 },
    { "do": "check", "note": "DRAG REQUIRED のまま", "dref": "laminar/B747/fms/vnav/msg", "op": "==", "value": 2 },
    { "do": "check", "note": "A/T は IDLE か HOLD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "in", "value": [1, 2] },
    { "do": "wait", "note": "経路に戻ると VNAV PTH（FMSPG p.3.5-17：推定）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 600 },
    { "do": "snapshot", "note": "経路に戻った時", "drefs": [ "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/msg", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "check", "note": "経路の ±400 ft の中", "dref": "laminar/B747/fms/vnav/path_dev", "op": "between", "value": [-400, 400] },
    { "do": "check", "note": "FMC の目標は降下の予定の速さに戻る", "dref": "laminar/B747/fms/vnav/cas", "op": "<", "value": 330 },
    { "do": "record_stop" }
  ]
}
