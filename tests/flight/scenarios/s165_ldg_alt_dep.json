{
  "name": "s165_ldg_alt_dep",
  "description": "6-1/6-2 段 11b（FMC から与圧系への着陸高度）の X-Plane での確認、出発側。RJAA 34L でエンジン運転中に始める（機体を読み直す）。経路なしでは FMC の着陸高度が無く、与圧系は 2,000 ft と LANDING ALT（FCOM p.608）。RJAA→RJBB を ACTIVATE・EXEC すると出発空港の標高 135 ft、DEPARTURES で 34L を入れて EXEC すると滑走路の閾値の標高 139 ft（FCOM p.993、p.1400）。与圧系の着陸高度も同じで、LANDING ALT は消える。ECS の synoptic で EICAS の data block を出して撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "sleep", "seconds": 2 },

    { "do": "mark", "note": "経路なし" },
    { "do": "check", "note": "FMC の着陸高度なし", "dref": "laminar/B747/fms/landing_alt_valid", "op": "==", "value": 0 },
    { "do": "check", "note": "与圧系は 2,000 ft（FCOM p.608）", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 2000 },
    { "do": "check", "note": "LANDING ALT（advisory 240）", "dref": "laminar/B747/CAS/advisory_status[240]", "op": "==", "value": 1 },

    { "do": "mark", "note": "RJAA→RJBB、滑走路なし" },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、ACTIVATE、EXEC", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "R6", "EXEC"] },
    { "do": "wait", "note": "FMC の着陸高度", "dref": "laminar/B747/fms/landing_alt_valid", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "出発空港の標高 135 ft（FCOM p.993）", "dref": "laminar/B747/fms/landing_alt", "op": "==", "value": 135 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "与圧系も 135 ft", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 135 },
    { "do": "check", "note": "LANDING ALT は消える", "dref": "laminar/B747/CAS/advisory_status[240]", "op": "==", "value": 0 },

    { "do": "mark", "note": "DEPARTURES で 34L" },
    { "do": "cdu", "note": "DEP ARR（地上の有効な経路：DEPARTURES）", "keys": ["DEPARR"] },
    { "do": "check", "note": "RUNWAYS の 3 行目が 34L", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "34L" },
    { "do": "cdu", "note": "34L、EXEC", "keys": ["R3", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "34L の閾値の標高 139 ft（CIFP）", "dref": "laminar/B747/fms/landing_alt", "op": "==", "value": 139 },
    { "do": "check", "note": "与圧系も 139 ft", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 139 },
    { "do": "cmd", "note": "ECS の synoptic（EICAS の data block も出る）", "name": "laminar/B747/dsp/ecs_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "data block が出る", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_ldg_alt_139" },
    { "do": "cmd", "note": "ECS の synoptic を消す", "name": "laminar/B747/dsp/ecs_switch", "duration": 0.2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
