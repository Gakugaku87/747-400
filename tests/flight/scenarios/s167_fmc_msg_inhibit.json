{
  "name": "s167_fmc_msg_inhibit",
  "description": "6-1/6-2 段 11c1（FMC のメッセージの表示の規則）の X-Plane での確認。空中、RJAA 34L の進入方向の 24 NM、海の上の 390 ft、250 kt（機体を読み直す）。経路なしでは警告（UNABLE NEXT ALT の旗を Web API で立てる）が書き込み行と FMC MESSAGE に出る。V/S で 400 ft に下げる。RJBB→RJAA に ILS34L を入れ、LEGS で RW34L へ DIRECT TO（滑走路を点として入れる：FMSPG p.82。滑走路が現用点で 25 NM 以内：進入の段階、FCOM p.1236）。500 ft 未満なので警告は抑えられ、FMC MESSAGE も出ない（ATA34_2 p.635）。FLCH で上がり 1,000 ft を越えると出る。もう一つの警告（LIMIT ALT FLXXX の旗）が来ると上に出て、CLR で下の警告に戻る（積み重ね）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.3751, "longitude": 140.5829, "elevation_in_meters": 120, "heading_true": 337, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 400 ft（空中開始の後に 800 ft 近くまで上がるので、V/S で下げる）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 400 },
    { "do": "cmd", "note": "V/S（400 ft で ALT に捕まる）", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1, "note": "V/S に入ると目標がその時の昇降率に合わさるので、後から入れる" },
    { "do": "set", "note": "V/S −1,000 fpm（AFDS が読む X-Plane の V/S の目標）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -1000 },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "wait", "note": "電波高度 480 ft 未満", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 480, "timeout": 180 },

    { "do": "mark", "note": "経路なし：警告が出る" },
    { "do": "set", "note": "UNABLE NEXT ALT の旗（DRindex 46）", "dref": "laminar/B747/fms/notification[47]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "書き込み行に出る", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "UNABLE NEXT ALT" },
    { "do": "check", "note": "FMC MESSAGE（advisory 145）", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 1 },
    { "do": "cdu", "note": "CLR", "keys": ["CLR"] },
    { "do": "set", "note": "旗を戻す", "dref": "laminar/B747/fms/notification[47]", "value": 0 },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "経路、ILS34L、RW34L へ DIRECT TO" },
    { "do": "cdu", "note": "RTE：RJBB→RJAA", "keys": ["RTE", "RJBB", "L1", "RJAA", "R1"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJAA ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA ARRIVALS" },
    { "do": "cdu", "note": "NEXT（進入の 6〜10 番目）", "keys": ["NEXT"] },
    { "do": "check", "note": "3R が ILS34L", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "ILS34L" },
    { "do": "cdu", "note": "ILS34L（R3）、RTE、ACTIVATE、EXEC", "keys": ["R3", "RTE", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "CLR（書き込み行のメッセージを消す）、LEGS、RW34L を 1L へ（DIRECT TO）、EXEC", "keys": ["CLR", "CLR", "CLR", "LEGS", "RW34L", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "現用点が RW34L", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RW34L" },

    { "do": "mark", "note": "進入の段階で 500 ft 未満：抑える" },
    { "do": "set", "note": "UNABLE NEXT ALT の旗", "dref": "laminar/B747/fms/notification[47]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "書き込み行に出ない（ATA34_2 p.635）", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^(?!.*UNABLE NEXT ALT)" },
    { "do": "check", "note": "FMC MESSAGE も出ない", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_alert_held" },

    { "do": "mark", "note": "1,000 ft を越えて上がる：出る" },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "電波高度 1,000 ft を越える", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 1050, "timeout": 90 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "書き込み行に出る", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "UNABLE NEXT ALT" },
    { "do": "check", "note": "FMC MESSAGE", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 1 },

    { "do": "mark", "note": "積み重ね：新しい警告が上" },
    { "do": "set", "note": "LIMIT ALT FLXXX の旗（DRindex 23）", "dref": "laminar/B747/fms/notification[24]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "新しい警告が上に出る（ATA34_2 p.635）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "LIMIT ALT FLXXX" },
    { "do": "shot", "name": "cdu_alert_stack" },
    { "do": "cdu", "note": "CLR", "keys": ["CLR"] },
    { "do": "check", "note": "CLR で下の警告に戻る", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "UNABLE NEXT ALT" },
    { "do": "set", "note": "旗を戻す", "dref": "laminar/B747/fms/notification[24]", "value": 0 },
    { "do": "set", "note": "旗を戻す", "dref": "laminar/B747/fms/notification[47]", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
