{
  "name": "s292_fd_windup_engage",
  "description": "A/P を入れたときのピッチの指令（2026-11-12 のフルレビュー AFDS-5：REVIEW_2026-11-12.md）の X-Plane での確認。銚子沖の海上 10,000 ft・250 kt・北向きの空中開始（機体を読み直す、270 t）。ALT HOLD・A/T SPD で落ち着かせてから A/P を外し、F/D だけで V/S +1,000 fpm を選んで、誰もバーを追わずに 30 秒（指令の積分が巻き上がる）。その後 CMD L。前：CMD の後、巻き上がった指令へ機首を上げて 1.83 g。直した後（ATA22 p.332：A/P が外れている間、ピッチ姿勢の積分器は姿勢に同期する）：CMD の次の瞬間の指令は姿勢の近く、その後 20 秒の荷重倍数 0.9〜1.1。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 149.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "stop": true },
    { "do": "record_start" },

    { "do": "mark", "note": "A/P を外し、F/D だけで V/S +1,000 fpm を 30 秒（バーを追わない）" },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "もう一度押して AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt", "duration": 0.2 },
    { "do": "check", "note": "A/P が外れた", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0, "stop": true },
    { "do": "set", "note": "MCP 高度 15,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 15000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 15000 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S +1,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "sleep", "seconds": 30 },
    { "do": "snapshot", "note": "30 秒後（指令と姿勢）", "drefs": [ "laminar/B747/autopilot/pitch_cmd", "sim/flightmodel/position/theta", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "remember", "dref": "sim/flightmodel/position/theta", "as": "th" },

    { "do": "mark", "note": "CMD L" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "CMD の直後の指令は姿勢の 2° 以内（前は巻き上がった 8° 上）", "dref": "laminar/B747/autopilot/pitch_cmd", "op": "between", "value": [-2, 2], "rel": "th" },
    { "do": "watch", "note": "CMD の後 20 秒、荷重倍数 0.9〜1.1（前は 1.83 g）", "dref": "sim/flightmodel2/misc/gforce_normal", "min": 0.9, "max": 1.1, "timeout": 20 },
    { "do": "snapshot", "note": "20 秒後", "drefs": [ "laminar/B747/autopilot/pitch_cmd", "sim/flightmodel/position/theta", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "V/S +1,000 を飛ぶ（±400）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [600, 1400] },
    { "do": "record_stop" }
  ]
}
