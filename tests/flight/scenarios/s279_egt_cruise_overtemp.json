    { "do": "snapshot", "note": "巡航の EGT", "drefs": [ "laminar/B747/engines/display_EGT[0]", "laminar/B747/engines/display_EGT[1]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_N1[0]", "sim/weather/aircraft/temperature_leadingedge_deg_c", "sim/weather/aircraft/temperature_ambient_deg_c", "sim/flightmodel/misc/machno", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "巡航の EGT（約 350 °C：推定。前は約 250 °C）", "dref": "laminar/B747/engines/display_EGT[0]", "op": "between", "value": [320, 420] },
    { "do": "check", "note": "白", "dref": "laminar/B747/engines/EGT/amber_on[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "EGT OVERTEMP（エンジン 1）" },
    { "do": "set", "note": "故障：ENGINE 1 EGT OVERTEMP", "dref": "laminar/B747/engines/fail/egt_high[0]", "value": 1 },
    { "do": "wait", "note": "最大連続の 629 °C を超えて琥珀（約 2 分：推定）", "dref": "laminar/B747/engines/EGT/amber_on[0]", "op": "==", "value": 1, "timeout": 240 },
    { "do": "wait", "note": "離陸の 654 °C を超えて赤", "dref": "laminar/B747/engines/EGT/red_on[0]", "op": "==", "value": 1, "timeout": 120 },
    { "do": "check", "note": "赤い枠", "dref": "laminar/B747/engines/EGT/box_red[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "ほかのエンジンは白のまま", "dref": "laminar/B747/engines/EGT/amber_on[1]", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "赤になったときの EGT", "drefs": [ "laminar/B747/engines/display_EGT[0]", "laminar/B747/engines/display_EGT[1]", "laminar/B747/engines/display_N1[0]" ] },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 24 },
    { "do": "shot", "name": "eicas_eng1_egt_overtemp" },
    { "do": "view", "name": "forward" },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/engines/fail/egt_high[0]", "value": 0 },
    { "do": "wait", "note": "629 °C の下に戻る", "dref": "laminar/B747/engines/display_EGT[0]", "op": "<", "value": 629, "timeout": 90 },
