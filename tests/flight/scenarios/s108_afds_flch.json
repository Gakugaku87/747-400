{
  "name": "s108_afds_flch",
  "description": "AFDS の作り直し 6-3 段 3b（速度を昇降舵で保つ則：FLCH と速度の保護）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・指示 250 kt・北向きで開始（機体を読み直す）。A/P CMD L・HDG SEL・ALT HOLD・A/T SPD 250 kt で落ち着かせ、FLCH で 15,000 ft へ上昇（速度は昇降舵：ATA22 p.344。上昇に入る間 ±12 kt、その後 ±5 kt）、上昇中に MCP 速度 280 kt（行き過ぎ 6 kt まで）、捕捉（ALT）。FLCH で 9,000 ft へ降下（同じく）、降下中に MCP 速度を最小機動速度より下の 200 kt にすると、目標は最小機動速度（フラップ UP は余裕なし：FCOM p.675）、MCP 速度 250 kt に戻して捕捉。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 149.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 25 },
    { "do": "check", "note": "250 kt で水平（±6 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [244, 256] },

    { "do": "mark", "note": "FLCH で 15,000 ft へ上昇（速度は昇降舵：ATA22 p.344）" },
    { "do": "set", "note": "MCP 高度 15,000 ft（前の則の目標にも）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 15000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 15000 },
    { "do": "set", "note": "MCP 速度 250 kt のまま（FLCH は今の速度か MCP の高い方に合わせる：ATA22 p.344）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA は FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "check", "note": "FLCH はピッチの則（6-3 段 3b）", "dref": "laminar/B747/autopilot/pitch_law", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "FLCH の始まり", "drefs": [ "laminar/B747/autopilot/ias_dial_value", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vminm", "laminar/B747/airspeed/Vmax" ] },
    { "do": "watch", "note": "上昇に入る間、速度は 250 kt の ±12 kt（40 秒）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 238, "max": 262, "timeout": 40 },
    { "do": "check", "note": "上昇している（1,000 fpm 超）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 1000 },
    { "do": "watch", "note": "その後 20 秒、250 kt の ±5 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 245, "max": 255, "timeout": 20 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_flch_climb" },
    { "do": "set", "note": "上昇中に MCP 速度 280 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 280 },
    { "do": "wait", "note": "280 kt へ（±3 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [277, 283], "timeout": 70 },
    { "do": "watch", "note": "行き過ぎは 6 kt まで（20 秒）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 274, "max": 286, "timeout": 20 },
    { "do": "check", "note": "まだ上昇している", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 300 },
    { "do": "wait", "note": "15,000 ft の捕捉で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 240 },
    { "do": "watch", "note": "行き過ぎは 100 ft まで（60 秒）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 15100, "timeout": 60 },

    { "do": "mark", "note": "FLCH で 9,000 ft へ降下" },
    { "do": "set", "note": "MCP 高度 9,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 9000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 9000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA は FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "check", "note": "ピッチの則", "dref": "laminar/B747/autopilot/pitch_law", "op": "==", "value": 1 },
    { "do": "watch", "note": "降下に入る間、速度は 280 kt の ±12 kt（40 秒）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 268, "max": 292, "timeout": 40 },
    { "do": "check", "note": "降下している（-1,000 fpm より速く）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -1000 },
    { "do": "watch", "note": "その後 15 秒、280 kt の ±5 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 275, "max": 285, "timeout": 15 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_flch_descent" },

    { "do": "mark", "note": "速度の保護：MCP 速度を最小機動速度より下に（FCOM p.675）" },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vminm", "as": "vminm" },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "sleep", "seconds": 60 },
    { "do": "snapshot", "note": "速度の保護", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vminm", "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "check", "note": "最小機動速度で止まる（-6〜+8 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [-6, 8], "rel": "vminm" },
    { "do": "check", "note": "FMA は FLCH SPD のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "wait", "note": "9,000 ft の捕捉で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 300 },
    { "do": "watch", "note": "行き過ぎは 100 ft まで（60 秒）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "min": 8900, "timeout": 60 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
