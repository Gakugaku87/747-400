{
  "name": "s188_perf_factors",
  "description": "6-1・6-2 段 12c1（保守のページ：MAINTENANCE INDEX と PERF FACTORS）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。INIT/REF INDEX の MAINT> で MAINTENANCE INDEX（FCOM p.1239：<CROSS LOAD・BITE>・<PERF FACTORS・<IRS MONITOR、<INDEX の上の線）、<PERF FACTORS で PERF FACTORS（FMSPG p.265 の形、値は ATA34_2 p.681 の機体：+0.0/+0.0・300、-8/-20・CLB/100（THR/CRZ は 2026-11-02 から既定 CLB：利用者の決定。ATA34_2 p.681 の図は CRZ/100）、1.30・FLAPS 5、5・1000/1000、6R は ---）。ARM の前の入力は INVALID ENTRY、6R に ARM を入れると入力できる（ATA34_2 p.679）。MNVR MARGIN 1.25 で laminar/B747/fms/mnvr_margin、TO 2 25 で THRUST LIM の <-25 %、DRAG/F-F +1.5/-2.0 で IDENT の DRAG/FF。最後に元の値へ戻す（保存はしない）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "IDENT の <INDEX で INIT/REF INDEX、6R の MAINT>", "keys": ["L6", "R6"] },
    { "do": "check", "note": "MAINTENANCE INDEX（FCOM p.1239）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MAINTENANCE INDEX" },
    { "do": "check", "note": "<CROSS LOAD と BITE>", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "<CROSS LOAD        BITE>" },
    { "do": "check", "note": "<PERF FACTORS", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<PERF FACTORS" },
    { "do": "check", "note": "<INDEX の上の線", "dref": "laminar/B747/fms3/Line12_L", "op": "==", "value": "------------------------" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_maint_index" },
    { "do": "cdu", "note": "<INDEX で INIT/REF INDEX（前は ACMS）", "keys": ["L6"] },
    { "do": "check", "note": "INIT/REF INDEX", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "INIT/REF INDEX" },
    { "do": "cdu", "note": "MAINT>、<PERF FACTORS", "keys": ["R6", "L2"] },
    { "do": "check", "note": "PERF FACTORS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF FACTORS" },
    { "do": "check", "note": "1111 と OPTION CODE", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "1111        000001004806" },
    { "do": "check", "note": "+0.0/+0.0 と R/C CLB 300", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "+0.0/+0.0            300" },
    { "do": "check", "note": "TO 1/TO 2 -8/-20（P&W）と CLB/100（THR/CRZ の既定は 2026-11-02 から CLB：利用者の決定、7127aa74。前は CRZ/100）", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": " -8/-20          CLB/100" },
    { "do": "check", "note": "1.30 と FLAPS 5", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "1.30             FLAPS 5" },
    { "do": "check", "note": "5 と 1000/1000", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "5              1000/1000" },
    { "do": "check", "note": "6R は ---", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX               ---" },
    { "do": "check", "note": "見出しの小字", "dref": "laminar/B747/fms3/Line02_S", "op": "==", "value": " PERF CODE   OPTION CODE" },
    { "do": "shot", "name": "cdu_perf_factors" },
    { "do": "cdu", "note": "ARM の前に 4L へ 1.25", "keys": ["1.25", "L4"] },
    { "do": "check", "note": "INVALID ENTRY", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cdu", "note": "CLR で INVALID ENTRY と 1.25 を消し、6R に ARM", "keys": ["CLR", "CLR", "CLR", "CLR", "CLR", "CLR", "ARM", "R6"] },
    { "do": "check", "note": "6R は ARM", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX               ARM" },
    { "do": "cdu", "note": "4L に 1.25、3L に /25、2L に 1.5/-2.0", "keys": ["1.25", "L4", "/25", "L3", "1.5/-2.0", "L2"] },
    { "do": "check", "note": "MNVR MARGIN 1.25", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "1.25             FLAPS 5" },
    { "do": "check", "note": "TO 2 25", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": " -8/-25          CLB/100" },
    { "do": "check", "note": "DRAG/F-F +1.5/-2.0", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "+1.5/-2.0            300" },
    { "do": "check", "note": "PFD への MNVR MARGIN（1.25 より上でない）", "dref": "laminar/B747/fms/mnvr_margin", "op": "<", "value": 1.2501 },
    { "do": "check", "note": "PFD への MNVR MARGIN（1.25 より下でない）", "dref": "laminar/B747/fms/mnvr_margin", "op": ">", "value": 1.2499 },
    { "do": "check", "note": "simconfig に FMC.PERF", "dref": "laminar/B747/simconfig", "op": "contains", "value": "\"PERF\"" },
    { "do": "shot", "name": "cdu_perf_factors_armed" },
    { "do": "cdu", "note": "<INDEX 2 回（INIT/REF INDEX）、<IDENT", "keys": ["L6", "L6", "L1"] },
    { "do": "check", "note": "IDENT の DRAG/FF（ATA34_2 p.678）", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "+1.5/-2.0" },
    { "do": "shot", "name": "cdu_ident_dragff" },
    { "do": "cdu", "note": "<INDEX、<THRUST LIM", "keys": ["L6", "L4"] },
    { "do": "check", "note": "TO 2 の derate -25 %", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "<-25 %" },
    { "do": "shot", "name": "cdu_thrust_lim_to2" },
    { "do": "cdu", "note": "元に戻す：<INDEX、MAINT>、<PERF FACTORS、ARM、1.30、/20、0/0", "keys": ["CLR", "CLR", "CLR", "CLR", "CLR", "CLR", "L6", "R6", "L2", "ARM", "R6", "1.30", "L4", "/20", "L3", "0/0", "L2"] },
    { "do": "check", "note": "ページを出て戻ったので、ARM を入れ直した", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX               ARM" },
    { "do": "check", "note": "+0.0/+0.0 に戻る", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "+0.0/+0.0            300" },
    { "do": "check", "note": "-8/-20 に戻る", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": " -8/-20          CLB/100" },
    { "do": "check", "note": "1.30 に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "1.30             FLAPS 5" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
