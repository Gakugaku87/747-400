{
  "name": "s261_mcp_mach_limit",
  "description": "MCP の Mach の目標と上限の X-Plane での確認（2026-11-06、PERF_SIMBRIEF のキットの報告）。FL350・M.85 で東へ空中開始し、機体を読み直す。MCP を Mach にして、窓の M.85 が目標になること、M.91 は上限（Vmo − 10 kt、FL350 で約 311 kt＝M.90）で抑えられること、そこから M.85 に戻すとそれが目標になること（前は上限に張り付き、下の Mach が入らなかった：B747.70.xt.autopilot.lua の B747_ap_ias_mach_mode）を確かめる。FCOM p.642：A/T は窓の IAS か Mach を最小と最大の速さの制限の下で保つ。p.675：最大の速さは Vmo/Mmo など。空中の初期化の速さ（ノット）は、MCP が Mach なら Mach にして窓へ巻き取る（前はノットのまま巻き取り、291 kt が M2.91 になった：B474_ap_target_speed）。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 10668, "heading_true": 90, "speed_in_meters_per_second": 251 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 8, "note": "空中の初期化の速さの巻き取り" },
    { "do": "record_start" },
    { "do": "snapshot", "note": "初期化の後", "drefs": [ "sim/cockpit2/autopilot/airspeed_is_mach", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_dial_kts", "sim/cockpit2/autopilot/airspeed_dial_kts_mach", "laminar/B747/airspeed/Vmo", "sim/flightmodel/misc/machno", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "set", "note": "MCP を Mach に（機体の自動の切り替えは上昇中だけ）", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "note": "窓 M.85", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 85 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "M.85 が目標", "dref": "sim/cockpit2/autopilot/airspeed_dial_kts_mach", "op": "between", "value": [0.849, 0.851] },
    { "do": "set", "note": "窓 M.91（約 315 kt、Vmo − 10 kt より上）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 91 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "M.91 の時", "drefs": [ "sim/cockpit2/autopilot/airspeed_dial_kts", "sim/cockpit2/autopilot/airspeed_dial_kts_mach", "laminar/B747/autopilot/ias_bug_value", "laminar/B747/airspeed/Vmo" ] },
    { "do": "check", "note": "目標は上限（今の高度の Vmo − 10 kt。空中開始の後に約 35,800 ft まで上がると約 306 kt：2026-11-06 の 1 回目）", "dref": "sim/cockpit2/autopilot/airspeed_dial_kts", "op": "between", "value": [300, 316] },
    { "do": "check", "note": "その Mach は約 M.90", "dref": "sim/cockpit2/autopilot/airspeed_dial_kts_mach", "op": "between", "value": [0.893, 0.906] },
    { "do": "set", "note": "窓を M.85 に戻す", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 85 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "M.85 が目標（前は上限の約 M.90 に張り付いた）", "dref": "sim/cockpit2/autopilot/airspeed_dial_kts_mach", "op": "between", "value": [0.849, 0.851] },
    { "do": "wait", "note": "A/T が M.85 まで加速する（空中の初期化の目標が今の速さより低いと、いったん減速している：2026-11-06 の 1 回目は 40 秒で M.827）", "dref": "sim/flightmodel/misc/machno", "op": ">=", "value": 0.84, "timeout": 240 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "Mach は M.85 の近く", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [0.835, 0.865] },
    { "do": "set", "note": "窓を 80（M.80）に", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 80 },
    { "do": "set", "note": "空中の初期化と同じ形で、速さ 291 kt を渡す（FMC の activate_inflightAP）", "dref": "laminar/B747/autopilot/speed/target", "value": 291 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "窓は 291 kt の Mach（FL350 で M.85）へ巻き取られる（前は 291 へ：M2.91）", "dref": "laminar/B747/autopilot/ias_dial_value", "op": "between", "value": [84, 86] },
    { "do": "check", "note": "巻き取りは終わり", "dref": "laminar/B747/autopilot/speed/target", "op": "==", "value": -1 },
    { "do": "record_stop" }
  ]
}
