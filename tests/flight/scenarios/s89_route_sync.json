{
  "name": "s89_route_sync",
  "description": "経路の現用点と X-Plane の FMS（6-1・6-2 段 5e）の X-Plane での確認、空中。XAC の 8 NM 手前、10,000 ft、XAC へ向けて 250 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DIRECT XAC・SPENS・ATMUG を入れ、空中で ACTIVATE と EXEC：X-Plane の FMS の現用点が XAC（流し込んだ計画は最初の点から始まるので FMC が戻す）、ND の現用点と ETA も XAC から。LNAV で XAC を過ぎると FMC が順送りし、LEGS の 1 行目が SPENS（FMSPG p.119；FCOM p.1331）。ATMUG を消して EXEC しても現用点は SPENS のまま。DIRECT TO AKAGI（経路に無い点）を EXEC：始点 DTOPOS（EXEC の時の機体の位置、推定）から AKAGI へ、現用点は AKAGI、機体は AKAGI へ向かう。ND と CDU を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.8185, "longitude": 139.5117, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（XAC へ）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<FMC（IDENT）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DIRECT XAC・SPENS・ATMUG" },
    { "do": "cmd", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/B" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/B" },
    { "do": "cmd", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "name": "laminar/B747/fms1/func_key/next_pg" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/X" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/C" },
    { "do": "cmd", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/P" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/E" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/N" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/T" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/M" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/U" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/G" },
    { "do": "cmd", "name": "laminar/B747/fms1/ls_key/R3" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "DIRECT ATMUG", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": "DIRECT             ATMUG" },

    { "do": "mark", "note": "空中で ACTIVATE と EXEC" },
    { "do": "cmd", "note": "LEGS", "name": "laminar/B747/fms1/func_key/legs" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "ACTIVATE>（R6）", "name": "laminar/B747/fms1/ls_key/R6" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "EXEC", "name": "laminar/B747/fms1/key/execute", "duration": 0.2 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },
    { "do": "check", "note": "現用点 XAC が LEGS の 1 行目（FCOM p.1331）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "check", "note": "AFDS の現用点：X-Plane の FMS の 2 番目の XAC（RJAA・XAC・SPENS・ATMUG・RJBB）", "dref": "laminar/B747/autopilot/ap_monitor/fmscurrentIndex", "op": "==", "value": 2 },
    { "do": "check", "note": "ND の現用点 XAC（X-Plane の FMS の現用点：流し込みの後に FMC が戻す）", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "XAC" },
    { "do": "check", "note": "各点の ETA は XAC から（RJAA は -1）", "dref": "laminar/B747/fms/route_eta", "op": "contains", "value": "[-1," },

    { "do": "mark", "note": "LNAV で XAC を過ぎる：FMC の順送り" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV が入る", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 60 },
    { "do": "wait", "note": "XAC を過ぎて LEGS の 1 行目が SPENS（FMSPG p.119：通過した点は消える）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SPENS", "timeout": 240 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "次の行 ATMUG", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "ATMUG" },
    { "do": "check", "note": "AFDS の現用点：3 番目の SPENS", "dref": "laminar/B747/autopilot/ap_monitor/fmscurrentIndex", "op": "==", "value": 3 },
    { "do": "check", "note": "ND の現用点 SPENS", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "SPENS" },
    { "do": "check", "note": "ETA は SPENS から", "dref": "laminar/B747/fms/route_eta", "op": "contains", "value": "[-1,-1," },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_legs_sequenced" },

    { "do": "mark", "note": "ATMUG を消して EXEC：現用点は SPENS のまま" },
    { "do": "cmd", "note": "DEL", "name": "laminar/B747/fms1/key/del" },
    { "do": "cmd", "note": "ATMUG を削除（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "MOD RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 LEGS" },
    { "do": "cmd", "note": "EXEC", "name": "laminar/B747/fms1/key/execute", "duration": 0.2 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "AFDS の現用点：SPENS のまま（RJAA・XAC・SPENS・RJBB の 3 番目）", "dref": "laminar/B747/autopilot/ap_monitor/fmscurrentIndex", "op": "==", "value": 3 },
    { "do": "check", "note": "ND の現用点 SPENS のまま", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "SPENS" },
    { "do": "check", "note": "ETA も SPENS から", "dref": "laminar/B747/fms/route_eta", "op": "contains", "value": "[-1,-1," },

    { "do": "mark", "note": "DIRECT TO AKAGI（経路に無い点）" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/K" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/G" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/I" },
    { "do": "cmd", "note": "L1：DIRECT TO", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "AKAGI：SELECT DESIRED WPT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "SELECT DESIRED WPT" },
    { "do": "cmd", "note": "日本の AKAGI（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "MOD RTE 1 LEGS、1 行目 AKAGI（FMSPG p.142）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "AKAGI" },
    { "do": "cmd", "note": "EXEC", "name": "laminar/B747/fms1/key/execute", "duration": 0.2 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "AFDS の現用点：4 番目の AKAGI（RJAA・XAC・DTOPOS・AKAGI・SPENS・RJBB）", "dref": "laminar/B747/autopilot/ap_monitor/fmscurrentIndex", "op": "==", "value": 4 },
    { "do": "check", "note": "ND の現用点 AKAGI", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "AKAGI" },
    { "do": "check", "note": "ETA は AKAGI から", "dref": "laminar/B747/fms/route_eta", "op": "contains", "value": "[-1,-1,-1," },
    { "do": "wait", "note": "機体が AKAGI（北、磁方位 約 15°）へ向かう", "dref": "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "op": "outside", "value": [40, 350], "timeout": 150 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2 },
    { "do": "shot", "name": "cdu_legs_direct_to" },
    { "do": "switch", "note": "ND の表示範囲を広く（つまみのコマンドで：dataref を書くと X-Plane の地図の層の範囲が変わらない）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 4, "cmd": "laminar/B747/nd/range/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/range/capt/sel_dial_dn" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_direct_to" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
