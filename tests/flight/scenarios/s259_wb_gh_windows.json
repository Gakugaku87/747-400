{
  "name": "s259_wb_gh_windows",
  "description": "シムの窓 2 つ（2026-11-05 の利用者の依頼、実機に無い）の X-Plane での確認、地上・cold & dark（RJAA 34L、機体を読み直す）。重量の窓（Plugins → 747-400 → Weight and balance...）の LOAD：窓と同じ入力を Web API で書く（laminar/B747/wb/req_field と req_value、req_id を 1 増やす）。乗客 300 人は CDU の PAX/CARGO と同じく A〜E に振り分け、X-Plane のペイロードと重心が動く。貨物 FWD、1 人の重量、燃料の合計（CDU の給油と同じ順に即配分：主翼 1・4 が先に満タン）、貨物の合計（2026-11-11：区画の上限の比で FWD・AFT・BULK に）。Ground Handling の窓（Plugins → 747-400 → Ground handling...）：チョーク・GPU・ASU のボタンと同じコマンド。窓を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": false } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備（燃料の落ち着きを待つ）" },
    { "do": "check", "note": "地上", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1 },
    { "do": "cmd", "note": "重量の窓を開く（メニューと同じコマンド）", "name": "laminar/B747/wb/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "開いた", "dref": "laminar/B747/wb/window_open", "op": ">=", "value": 1 },
    { "do": "check", "note": "1 人の重量は SIM CONFIG の値", "dref": "laminar/B747/wb/load_pax_kg", "op": ">", "value": 0 },
    { "do": "snapshot", "note": "入れる前", "drefs": ["laminar/B747/wb/load_zones", "laminar/B747/wb/load_cargo", "laminar/B747/wb/load_pax_kg", "sim/flightmodel/weight/m_fixed", "sim/flightmodel/weight/m_fuel_total", "sim/flightmodel/misc/cgz_ref_to_default", "sim/flightmodel2/misc/cg_offset_z_mac"] },

    { "do": "mark", "note": "乗客 300 人" },
    { "do": "set", "dref": "laminar/B747/wb/req_field", "value": 0 },
    { "do": "set", "dref": "laminar/B747/wb/req_value", "value": 300 },
    { "do": "remember", "dref": "laminar/B747/wb/req_id", "as": "id0" },
    { "do": "set", "note": "入力（窓の Enter と同じ）", "dref": "laminar/B747/wb/req_id", "value": 1, "rel": "id0" },
    { "do": "wait", "note": "A 区画が満席（23）", "dref": "laminar/B747/wb/load_zones[0]", "op": "==", "value": 23, "timeout": 5 },
    { "do": "check", "note": "B は 70（1 人ずつ A から E へ順に）", "dref": "laminar/B747/wb/load_zones[1]", "op": "==", "value": 70 },
    { "do": "check", "note": "C は 69", "dref": "laminar/B747/wb/load_zones[2]", "op": "==", "value": 69 },
    { "do": "check", "note": "D は 69", "dref": "laminar/B747/wb/load_zones[3]", "op": "==", "value": 69 },
    { "do": "check", "note": "E は 69", "dref": "laminar/B747/wb/load_zones[4]", "op": "==", "value": 69 },
    { "do": "snapshot", "note": "ペイロードと重心（300 × 1 人の重量、重心は区画の位置から）", "drefs": ["sim/flightmodel/weight/m_fixed", "laminar/B747/wb/load_pax_kg", "sim/flightmodel/misc/cgz_ref_to_default", "sim/flightmodel2/misc/cg_offset_z_mac"] },
    { "do": "check", "note": "X-Plane の重心が動いた", "dref": "sim/flightmodel/misc/cgz_ref_to_default", "op": "!=", "value": 0 },

    { "do": "mark", "note": "貨物 FWD 12,000 kg" },
    { "do": "set", "dref": "laminar/B747/wb/req_field", "value": 6 },
    { "do": "set", "dref": "laminar/B747/wb/req_value", "value": 12000 },
    { "do": "set", "dref": "laminar/B747/wb/req_id", "value": 2, "rel": "id0" },
    { "do": "wait", "note": "FWD 12,000", "dref": "laminar/B747/wb/load_cargo[0]", "op": "==", "value": 12000, "timeout": 5 },

    { "do": "mark", "note": "1 人 100 kg" },
    { "do": "set", "dref": "laminar/B747/wb/req_field", "value": 9 },
    { "do": "set", "dref": "laminar/B747/wb/req_value", "value": 100 },
    { "do": "set", "dref": "laminar/B747/wb/req_id", "value": 3, "rel": "id0" },
    { "do": "wait", "note": "100 kg", "dref": "laminar/B747/wb/load_pax_kg", "op": "==", "value": 100, "timeout": 5 },
    { "do": "wait", "note": "ペイロード 300 × 100 + 12,000 = 42,000 kg", "dref": "sim/flightmodel/weight/m_fixed", "op": "between", "value": [41990, 42010], "timeout": 5 },

    { "do": "mark", "note": "燃料 100,000 kg" },
    { "do": "set", "dref": "laminar/B747/wb/req_field", "value": 10 },
    { "do": "set", "dref": "laminar/B747/wb/req_value", "value": 100000 },
    { "do": "set", "dref": "laminar/B747/wb/req_id", "value": 4, "rel": "id0" },
    { "do": "wait", "note": "合計 100 t", "dref": "sim/flightmodel/weight/m_fuel_total", "op": "between", "value": [99900, 100100], "timeout": 5 },
    { "do": "snapshot", "note": "タンクごと（主翼 1・4 が満タン、残りが 2・3）", "drefs": ["sim/flightmodel/weight/m_fuel", "sim/flightmodel/weight/m_fixed", "sim/flightmodel2/misc/cg_offset_z_mac"] },
    { "do": "check", "note": "センターは空", "dref": "sim/flightmodel/weight/m_fuel[0]", "op": "<", "value": 1 },

    { "do": "mark", "note": "貨物の合計 40,000 kg（2026-11-11 の利用者の依頼：区画の上限の比で FWD・AFT・BULK に分ける）" },
    { "do": "set", "dref": "laminar/B747/wb/req_field", "value": 11 },
    { "do": "set", "dref": "laminar/B747/wb/req_value", "value": 40000 },
    { "do": "set", "dref": "laminar/B747/wb/req_id", "value": 5, "rel": "id0" },
    { "do": "wait", "note": "FWD 18,862", "dref": "laminar/B747/wb/load_cargo[0]", "op": "==", "value": 18862, "timeout": 5 },
    { "do": "check", "note": "AFT 16,333", "dref": "laminar/B747/wb/load_cargo[1]", "op": "==", "value": 16333 },
    { "do": "check", "note": "BULK 4,805", "dref": "laminar/B747/wb/load_cargo[2]", "op": "==", "value": 4805 },
    { "do": "wait", "note": "ペイロード 300 × 100 + 40,000 = 70,000 kg", "dref": "sim/flightmodel/weight/m_fixed", "op": "between", "value": [69990, 70010], "timeout": 5 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "shot", "note": "重量の窓", "name": "wb_window_load" },
    { "do": "cmd", "note": "重量の窓を閉じる", "name": "laminar/B747/wb/window_toggle" },

    { "do": "mark", "note": "Ground Handling の窓" },
    { "do": "cmd", "note": "開く", "name": "laminar/B747/gh/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "開いた", "dref": "laminar/B747/gh/window_open", "op": ">=", "value": 1 },
    { "do": "remember", "dref": "laminar/B747/gear/chocked", "as": "ch0" },
    { "do": "cmd", "note": "チョーク（窓のボタンと同じコマンド）", "name": "laminar/B747/gear/chocks_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "チョークが入れ替わった", "dref": "laminar/B747/gear/chocked", "op": "!=", "value": 0, "rel": "ch0" },
    { "do": "cmd", "note": "もう一度：元に戻す", "name": "laminar/B747/gear/chocks_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "元のとおり", "dref": "laminar/B747/gear/chocked", "op": "==", "value": 0, "rel": "ch0" },
    { "do": "cmd", "note": "空気車（ASU）をつなぐ", "name": "laminar/B747/air/ground_air/connect" },
    { "do": "wait", "note": "つながった", "dref": "laminar/B747/air/ground_air/connected", "op": "==", "value": 1, "timeout": 5 },
    { "do": "cmd", "note": "地上電源（GPU）", "name": "laminar/B747/electrical/connect_power" },
    { "do": "wait", "note": "頼んだかつながった", "dref": "laminar/B747/electrical/ext_pwr_requested", "op": ">=", "value": 0, "timeout": 2 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "地上の設備の状態", "drefs": ["laminar/B747/electrical/ext_pwr1_avail", "laminar/B747/electrical/ext_pwr_requested", "laminar/B747/air/ground_air/connected", "laminar/B747/gear/chocked"] },
    { "do": "shot", "note": "Ground Handling の窓", "name": "gh_window" },
    { "do": "cmd", "note": "空気車を外す", "name": "laminar/B747/air/ground_air/connect" },
    { "do": "wait", "note": "外れた", "dref": "laminar/B747/air/ground_air/connected", "op": "==", "value": 0, "timeout": 5 },
    { "do": "cmd", "note": "閉じる", "name": "laminar/B747/gh/window_toggle" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 }
  ]
}
