{
  "name": "s42_irs",
  "description": "IRS（5-1 段 2）の X-Plane での確認。RJAA 34L でエンジン停止から、電池だけで 3 台の IRS を NAV にすると、アライン中（status 4、IRS ALIGN MODE）で AC が無いので >IRS AC と 10 秒で ON BAT（FCOM p.1217、ATA34_2 p.287）。APU の発電機で AC が来ると消える。ND の TIME TO ALIGN と、CDU の POS INIT（SET IRS POS の箱）を撮り、GPS POS を SET IRS POS に入れると箱が消える（FCOM p.1286）。約 10 分のアライン（時間加速は効かない）が終わると NAV（status 2）、memo が消え、PFD の旗が消える（FCOM p.1227）。L を ALIGN に戻すと fast alignment で約 30 秒後に NAV。C を ATT にすると 30 秒で姿勢、CDU の SET HDG（ダッシュ）に 120 を入れると方位が 120（FCOM p.1216、p.1227–1228）。機体を読み直す。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": false } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "switch", "note": "BATTERY ON", "dref": "laminar/B747/button_switch/position[13]", "value": 1, "cmd": "laminar/B747/button_switch/elec_battery" },
    { "do": "switch", "note": "STANDBY POWER AUTO",
      "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "switch", "note": "L IRS OFF（この開始は MSU が NAV で、IRS はアライン済み）", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "switch", "note": "C IRS OFF", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_dn" },
    { "do": "switch", "note": "R IRS OFF", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[2]", "value": 0,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_R_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_R_dn" },
    { "do": "wait", "note": "IRS は OFF", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "PFD の ATT・HDG の旗", "dref": "laminar/B747/pfd/capt/irs", "op": "==", "value": 0 },

    { "do": "mark", "note": "電池だけで NAV" },
    { "do": "switch", "note": "L IRS NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 2,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "switch", "note": "C IRS NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 2,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_dn" },
    { "do": "switch", "note": "R IRS NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[2]", "value": 2,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_R_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_R_dn" },
    { "do": "wait", "note": "アライン中（status 4）", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 4, "timeout": 5 },
    { "do": "check", "note": "IRS ALIGN MODE L", "dref": "laminar/B747/CAS/memo_status[14]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC が無い：>IRS AC LEFT", "dref": "laminar/B747/CAS/advisory_status[226]", "op": "==", "value": 1 },
    { "do": "wait", "note": "DC で 10 秒、地上、ground service bus なし：ON BAT", "dref": "laminar/B747/irs/on_bat", "op": "==", "value": 1, "timeout": 15 },
    { "do": "cas", "note": "電池だけで IRS NAV" },

    { "do": "mark", "note": "APU の発電機" },
    { "do": "cmd", "note": "APU selector ON", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "cmd", "note": "APU selector START", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "wait", "note": "APU GEN 1 AVAIL", "dref": "laminar/B747/electrical/apu_pwr1_avail", "op": "==", "value": 1, "timeout": 180 },
    { "do": "switch", "note": "APU GEN 1 ON", "dref": "laminar/B747/electrical/apu_pwr1_on", "value": 1, "cmd": "laminar/B747/button_switch/elec_apu_gen_1" },
    { "do": "switch", "note": "APU GEN 2 ON", "dref": "laminar/B747/electrical/apu_pwr2_on", "value": 1, "cmd": "laminar/B747/button_switch/elec_apu_gen_2" },
    { "do": "wait", "note": "AC：>IRS AC が消える", "dref": "laminar/B747/CAS/advisory_status[226]", "op": "==", "value": 0, "timeout": 15 },
    { "do": "check", "note": "ON BAT が消える", "dref": "laminar/B747/irs/on_bat", "op": "==", "value": 0 },
    { "do": "check", "note": "C もアライン中（電池の 5 分の前に AC が来た）", "dref": "laminar/B747/flt_mgmt/iru/status[1]", "op": "==", "value": 4 },
    { "do": "check", "note": "PFD の ATT・HDG の旗", "dref": "laminar/B747/pfd/capt/irs", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_time_to_align" },

    { "do": "mark", "note": "SET IRS POS" },
    { "do": "cmd", "note": "CDU の INDEX（INIT/REF INDEX）", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "cmd", "note": "POS（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "check", "note": "SET IRS POS の箱", "dref": "laminar/B747/irs/set_pos", "op": "==", "value": 1 },
    { "do": "view", "note": "左の CDU", "the": -36, "psi": 24, "fov": 30 },
    { "do": "shot", "name": "cdu_pos_init_boxes" },
    { "do": "wait", "note": "GPS L が測位（電源から 75 秒）", "dref": "laminar/B747/gps/valid[0]", "op": "==", "value": 1, "timeout": 90 },
    { "do": "check", "note": ">GPS LEFT・RIGHT なし", "dref": "laminar/B747/CAS/advisory_status[184]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "GPS POS（R4）をスクラッチパッドへ", "name": "laminar/B747/fms1/ls_key/R4" },
    { "do": "cmd", "note": "SET IRS POS（R5）", "name": "laminar/B747/fms1/ls_key/R5" },
    { "do": "wait", "note": "位置が入る：箱が消える", "dref": "laminar/B747/irs/set_pos", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "ENTER IRS POSITION なし", "dref": "laminar/B747/fms/notification[12]", "op": "==", "value": 0 },
    { "do": "shot", "name": "cdu_pos_init_entered" },

    { "do": "mark", "note": "アラインの完了" },
    { "do": "wait", "note": "約 10 分：NAV（status 2）。XTLua の時間は X-Plane の時間加速を含まないので待つ", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 2, "timeout": 660 },
    { "do": "wait", "note": "R も NAV", "dref": "laminar/B747/flt_mgmt/iru/status[2]", "op": "==", "value": 2, "timeout": 10 },
    { "do": "check", "note": "IRS ALIGN MODE が消える", "dref": "laminar/B747/CAS/memo_status[14]", "op": "==", "value": 0 },
    { "do": "check", "note": "PFD の旗が消える", "dref": "laminar/B747/pfd/capt/irs", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "IRU の位置", "drefs": [ "laminar/B747/irs/lat[0]", "laminar/B747/irs/lon[0]", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude" ] },
    { "do": "cas", "note": "アラインの後" },

    { "do": "mark", "note": "fast alignment" },
    { "do": "switch", "note": "L IRS ALIGN", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 1,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "wait", "note": "fast alignment（status 4）", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 4, "timeout": 3 },
    { "do": "check", "note": "IRS ALIGN MODE L", "dref": "laminar/B747/CAS/memo_status[14]", "op": "==", "value": 1 },
    { "do": "switch", "note": "L IRS NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 2,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "wait", "note": "約 30 秒で NAV", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 2, "timeout": 40 },

    { "do": "mark", "note": "ATT" },
    { "do": "switch", "note": "C IRS ATT", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 3,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_dn" },
    { "do": "wait", "note": "ATT（status 3）", "dref": "laminar/B747/flt_mgmt/iru/status[1]", "op": "==", "value": 3, "timeout": 3 },
    { "do": "check", "note": "SET HDG のダッシュ", "dref": "laminar/B747/irs/set_hdg_shown", "op": "==", "value": 1 },
    { "do": "wait", "note": "30 秒で姿勢", "dref": "laminar/B747/irs/att_valid[1]", "op": "==", "value": 1, "timeout": 40 },
    { "do": "check", "note": "方位はまだ", "dref": "laminar/B747/irs/hdg_valid[1]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "CDU の INDEX", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "cmd", "note": "POS（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "cmd", "note": "CLR（通知とスクラッチパッドを消す）", "name": "laminar/B747/fms1/key/clear" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/clear" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "SET HDG（L5）", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "wait", "note": "方位が入る", "dref": "laminar/B747/irs/hdg_valid[1]", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "120°", "dref": "laminar/B747/irs/hdg[1]", "op": "between", "value": [119.5, 120.5] },
    { "do": "shot", "name": "cdu_set_hdg" },
    { "do": "cas", "note": "終わり" }
  ]
}
