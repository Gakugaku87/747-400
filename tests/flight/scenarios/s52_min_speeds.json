{
  "name": "s52_min_speeds",
  "description": "PFD の速度テープの最小速度・最小機動速度・最大機動速度、スティックシェーカー、AIRSPEED LOW と琥珀の枠（5-2 段 3b、パネルの変更）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・200 kt で開始（機体を読み直す）。フラップ 20 で、赤と黒の帯の上端は FCTM p.262 のシェーカー速度（約 270 t で約 138 kt）、琥珀の帯の上端はシェーカーまで 1.3 g（FCOM p.973）。A/T を切ってアイドルで減速し、最小機動速度を切ると AIRSPEED LOW と琥珀の枠（FCOM p.1556）、帯の上端を切るとシェーカー。次に FL350 で巡航し、最小機動速度が低速バフェットまで 1.3 g（FCOM PI.11.1 の最大運用高度から）、フラップのバグが出ないこと（FCOM p.972）。PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "wait", "note": "フラップ 20", "dref": "sim/flightmodel2/wing/flap1_deg[0]", "op": ">", "value": 19.5, "timeout": 90 },
    { "do": "wait", "note": "水平飛行", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 60 },
    { "do": "sleep", "seconds": 25, "note": "フラップを出した後の A/P の機首下げ（荷重倍数が 1 より小さく、帯が下がる）が収まるのを待つ" },
    { "do": "snapshot", "note": "速度テープの値", "drefs": [ "sim/flightmodel/weight/m_total", "laminar/B747/airspeed/Vs", "laminar/B747/airspeed/Vminm",
      "laminar/B747/airspeed/Vmaxm", "laminar/B747/airspeed/Vmax", "laminar/B747/airspeed/Vmc", "laminar/B747/pfd/show_mins", "sim/flightmodel2/position/pressure_altitude", "sim/flightmodel/forces/g_nrml" ] },
    { "do": "check", "note": "赤と黒の帯の上端：FCTM のフラップ 20 のシェーカー速度（約 270 t・1 g で約 138 kt。今の荷重倍数で上下する：A/P が高度を保つ間は 0.9〜1.05 g）", "dref": "laminar/B747/airspeed/Vs", "op": "between", "value": [128, 143] },
    { "do": "check", "note": "琥珀の帯の上端：シェーカーまで 1.3 g（約 157 kt）", "dref": "laminar/B747/airspeed/Vminm", "op": "between", "value": [151, 163] },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vmax", "as": "vmax" },
    { "do": "check", "note": "最大機動速度は出さない（最大速度と同じ）", "dref": "laminar/B747/airspeed/Vmaxm", "op": "between", "value": [-0.5, 0.5], "rel": "vmax" },
    { "do": "check", "note": "空中開始：最小機動速度の帯を出す（推定。空中開始の直後に空地判定が一瞬地上になっても）", "dref": "laminar/B747/pfd/show_mins", "op": "==", "value": 1 },
    { "do": "check", "note": "シェーカーなし", "dref": "sim/flightmodel/failures/stallwarning", "op": "==", "value": 0 },
    { "do": "check", "note": "AIRSPEED LOW なし", "dref": "laminar/B747/CAS/caution_status[0]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_f20" },

    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "最小機動速度を切る：AIRSPEED LOW", "dref": "laminar/B747/CAS/caution_status[0]", "op": "==", "value": 1, "timeout": 90 },
    { "do": "snapshot", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vminm", "laminar/B747/airspeed/Vs", "laminar/B747/airspeed_window/min" ] },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vminm", "as": "vmm" },
    { "do": "check", "note": "最小機動速度の下（FCOM p.1556）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 0.5, "rel": "vmm" },
    { "do": "check", "note": "琥珀の枠", "dref": "laminar/B747/airspeed_window/min", "op": "==", "value": 1 },
    { "do": "shot", "name": "pfd_airspeed_low" },
    { "do": "wait", "note": "帯の上端を切る：シェーカー", "dref": "sim/flightmodel/failures/stallwarning", "op": "==", "value": 1, "timeout": 90 },
    { "do": "snapshot", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vs", "sim/flightmodel/position/alpha", "sim/flightmodel/forces/g_nrml" ] },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vs", "as": "vss" },
    { "do": "check", "note": "シェーカーは帯の上端の付近で（1 kt 以内）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 1.0, "rel": "vss" },
    { "do": "shot", "name": "pfd_shaker" },
    { "do": "set", "note": "回復：推力", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "シェーカーが止まる", "dref": "sim/flightmodel/failures/stallwarning", "op": "==", "value": 0, "timeout": 30 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
