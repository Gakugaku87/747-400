{
  "name": "s109_afds_takeoff",
  "description": "AFDS の作り直し 6-3 段 3b（T/O の速度の則）の X-Plane での確認、離陸。RJAA 34L でエンジン運転中に始め（機体を読み直す）、フラップ 20、MCP 速度を V2 の 160 kt、MCP 高度 5,000 ft。F/D を両方 OFF にしてから F/D L ON で T/O：地上の F/D のピッチは 8°（FCOM p.666）。手で推力を最大にし、150 kt で操縦輪を引いて離陸（この機体はフラップ 20 では 150 kt の前に自分で浮くことがある）、浮いたら A/P CMD L（T/O のまま：FCOM p.666）、脚上げ。T/O の則は V2 + 10 か引き起こし（ピッチ 2° 超え）の速度 + 10 の高い方、5 秒より長く上回れば今の速度（V2 + 25 まで）を保つ（FCOM p.664）。5,000 ft の捕捉（ALT）で推力を戻す。PFD を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 速度 160 kt（V2：FCOM p.664 の注）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "set", "note": "MCP 高度 5,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 5000 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA のピッチは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "T/O はピッチの則（6-3 段 3b）", "dref": "laminar/B747/autopilot/pitch_law", "op": "==", "value": 1 },
    { "do": "check", "note": "地上の F/D のピッチは 8°（FCOM p.666）", "dref": "laminar/B747/autopilot/pitch_cmd", "op": "between", "value": [7.99, 8.01] },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "離陸" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 90 },
    { "do": "set", "note": "操縦輪を引く（引き起こし）", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.35 },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "set", "note": "操縦輪を緩める", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "check", "note": "ピッチは TO/GA のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "T/O の則", "dref": "laminar/B747/autopilot/pitch_law", "op": "==", "value": 1 },
    { "do": "watch", "note": "離陸後 30 秒、速度は浮いた速度（150 kt 付近）から V2 + 30 の間", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 145, "max": 190, "timeout": 30 },
    { "do": "check", "note": "V2 + 10 から V2 + 25 の付近（±4 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [166, 189] },
    { "do": "check", "note": "上昇している", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 1000 },
    { "do": "snapshot", "note": "離陸後", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "laminar/B747/autopilot/pitch_cmd", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/pfd/pli", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_takeoff" },
    { "do": "watch", "note": "その後 20 秒も V2 + 5 から V2 + 30", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 165, "max": 190, "timeout": 20 },
    { "do": "wait", "note": "5,000 ft の捕捉で ALT（T/O からは 800 ft より上）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 150 },
    { "do": "set", "note": "推力を戻す", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.55 },
    { "do": "watch", "note": "行き過ぎは 150 ft まで（40 秒）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 5150, "timeout": 40 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
