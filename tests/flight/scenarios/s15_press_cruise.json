{
  "name": "s15_press_cruise",
  "description": "与圧とパック（3-1 段 1）の X-Plane での確認、巡航。FL350 の空中で開始し（X-Plane の空中開始は約 41,700 ft から落ちて 35,000 ft で落ち着く。A/P は ALT HOLD で入っている）、落ち着いたところで客室が巡航のスケジュール（ΔP 8.8、推定）で始まり cruise モードと cruise clamp、30 秒ほどでパックが normal flow になること（ATA21 p.386-387）、外流弁がほぼ閉。パックを全部 OFF にすると客室高度が上がり（漏れ、推定）、10,000 ft で CABIN ALTITUDE（FCOM p.619）、外流弁は全閉。パックを戻すと客室が下がる。最後に X-Plane の急減圧の故障で、客室高度の急上昇と CABIN ALTITUDE、controller の引継ぎ（STATUS CABIN ALT AUTO A、ATA21 p.436）を見る。期待値は notes/ATA-21.md §4.5。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 254 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れが収まるのを待つ（A/P は ALT HOLD で入った状態で始まる）" },
    { "do": "snapshot", "note": "空中開始直後", "drefs": [
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/air/press/mode", "laminar/B747/air/press/cruise_clamp",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/pressure_diffential_psi",
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/servos_on" ] },
    { "do": "switch", "note": "UPR RECIRC ON（空中開始では OFF のまま：AIR-19）", "dref": "laminar/B747/button_switch/position[38]", "value": 1, "cmd": "laminar/B747/button_switch/temp_recirc_upr" },
    { "do": "switch", "note": "LWR RECIRC ON", "dref": "laminar/B747/button_switch/position[39]", "value": 1, "cmd": "laminar/B747/button_switch/temp_recirc_lwr" },
    { "do": "wait", "note": "水平になる（A/P がどこかで高度を捕捉する。2026-10-24 は 35,000 ft か 37,800 ft だった）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 180 },
    { "do": "sleep", "seconds": 60, "note": "X-Plane の空中開始は約 41,700 ft・速度ほぼ 0 で始まり 35,000 ft まで落ちる（2026-10-24）。与圧は機体が落ち着くまで初期化を続ける（推定）" },
    { "do": "snapshot", "note": "巡航", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel2/position/pressure_altitude",
      "laminar/B747/air/press/mode", "laminar/B747/air/press/cpc", "laminar/B747/air/press/cruise_clamp",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm",
      "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "laminar/B747/air/outflow_valve_left/pos",
      "laminar/B747/air/pack/high_flow[0]", "laminar/B747/air/pack/high_flow[1]", "laminar/B747/air/pack/high_flow[2]",
      "laminar/B747/air/recirc_fan[2]", "laminar/B747/air/duct_pressure_C", "sim/cockpit2/bleedair/indicators/engine_loss_from_bleed_air_ratio[0]",
      "laminar/B747/air/landing_altitude", "laminar/B747/air/pressurization/EICAS1_display_status" ] },
    { "do": "check", "note": "空中開始：落ち着いた高度で cruise（推定）", "dref": "laminar/B747/air/press/mode", "op": "==", "value": 3 },
    { "do": "check", "note": "巡航の ΔP 8.8（推定：FCOM p.585 の表示例）", "dref": "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "op": "between", "value": [8.3, 8.85] },
    { "do": "check", "note": "巡航の客室高度（FL350 で約 4,700 ft、FL380 で約 6,000 ft）", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": "between", "value": [4300, 6500] },
    { "do": "check", "note": "25,000 ft 超の巡航：cruise clamp（ATA21 p.382）", "dref": "laminar/B747/air/press/cruise_clamp", "op": "==", "value": 1 },
    { "do": "check", "note": "外流弁はほぼ閉", "dref": "laminar/B747/air/outflow_valve_left/pos", "op": "between", "value": [-0.99, -0.6] },
    { "do": "sleep", "seconds": 35 },
    { "do": "check", "note": "cruise clamp：パック 1 normal（15 秒ずつ、ATA21 p.387）", "dref": "laminar/B747/air/pack/high_flow[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "パック 3 normal", "dref": "laminar/B747/air/pack/high_flow[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "cruise clamp：下の再循環ファンも運転（ATA21 p.386）", "dref": "laminar/B747/air/recirc_fan[2]", "op": "==", "value": 1 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_cruise" },

    { "do": "mark", "note": "パック全 OFF" },
    { "do": "switch", "note": "PACK 1 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "パック全 OFF", "drefs": [
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm",
      "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "laminar/B747/air/outflow_valve_left/pos",
      "laminar/B747/air/packs_operating" ] },
    { "do": "check", "note": "パックなし：客室が上がる（漏れ、推定）", "dref": "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm", "op": ">", "value": 500 },
    { "do": "check", "note": "外流弁は全閉", "dref": "laminar/B747/air/outflow_valve_left/pos", "op": "==", "value": -1 },
    { "do": "check", "note": "昇降率が大きいと data block（ATA21 p.451）", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "wait", "note": "客室高度 10,000 ft 超", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": ">", "value": 10050, "timeout": 420 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CABIN ALTITUDE（FCOM p.619）", "dref": "laminar/B747/CAS/warning_status[1]", "op": "==", "value": 1 },
    { "do": "cas", "note": "CABIN ALTITUDE" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_cabin_altitude" },
    { "do": "switch", "note": "PACK 1 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "wait", "note": "客室高度 9,500 ft 未満（パックで下がる）", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": "<", "value": 9500, "timeout": 300 },
    { "do": "check", "note": "CABIN ALTITUDE が消える", "dref": "laminar/B747/CAS/warning_status[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "客室は下がっている", "dref": "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm", "op": "<", "value": -200 },

    { "do": "mark", "note": "急減圧" },
    { "do": "set", "note": "X-Plane の急減圧の故障", "dref": "sim/operation/failures/rel_depres_fast", "value": 6 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "急減圧：客室が急上昇", "dref": "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm", "op": ">", "value": 2000 },
    { "do": "wait", "note": "客室高度 10,000 ft 超", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": ">", "value": 10050, "timeout": 60 },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "急減圧", "drefs": [
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit/pressure/cabin_altitude_actual_ft",
      "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm", "sim/cockpit2/pressurization/indicators/pressure_diffential_psi",
      "laminar/B747/air/press/cpc", "laminar/B747/CAS/status_status[29]", "laminar/B747/air/outflow_valve_left/pos" ] },
    { "do": "check", "note": "CABIN ALTITUDE", "dref": "laminar/B747/CAS/warning_status[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "機体の高度が一定で 2,000 fpm：B が引き継ぐ（ATA21 p.436）", "dref": "laminar/B747/air/press/cpc", "op": "==", "value": 2 },
    { "do": "check", "note": "STATUS CABIN ALT AUTO A（ATA21 p.454）", "dref": "laminar/B747/CAS/status_status[29]", "op": "==", "value": 1 },
    { "do": "cas", "note": "急減圧" },
    { "do": "set", "note": "故障を戻す", "dref": "sim/operation/failures/rel_depres_fast", "value": 0 },
    { "do": "sleep", "seconds": 30 },
    { "do": "check", "note": "穴がふさがれば客室は下がり始める", "dref": "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm", "op": "<", "value": 0 },
    { "do": "record_stop" }
  ]
}
