{
  "name": "s339_eicas_sel_climb",
  "description": "EICAS の推力の基準の行の仮定温度（2026-11-19、notes/ATA-34-61-FMC.md §170 の 3。利用者の巡航の写真の「CRZ +47C」）の X-Plane での確認、離陸。RJAA 34L でエンジン運転中に始め（機体を読み直す）、経路（RJAA→RJBB、DIRECT XAC）と PERF INIT、THRUST LIM で SEL 50：EICAS は「D-TO +50C」（FCOM p.831）。s109 と同じ形で離陸（フラップ 20、代替トリム、手の推力、150 kt で引き起こし、F/D を追い、300 ft で A/P）。空中でも離陸の推力制限のうちは「D-TO +50C」。FLCH と THR で上昇の推力制限：「CLB 2」（SEL 50 の減格で自動の CLB 2：FCOM p.1273。仮定温度は離陸のためのもの：FCOM p.831、空中の THRUST LIM に SEL は無い：p.1337–1339）。前は「CLB 2 +50C」で、巡航の CRZ でも「CRZ +50C」だった。THRUST LIM の <CON で「CON」（FLCH の上昇中は CRZ を選んでもモデルが CLB に戻すので、上昇中にも残る CON で）。EICAS を撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 183.5、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "183.5", "L3", "170", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、THRUST LIM", "keys": ["L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM", "stop": true },
    { "do": "cdu", "note": "SEL 50（L1）", "keys": ["50", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "EICAS の行は D-TO +50C（FCOM p.831）", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "D-TO +50C", "stop": true },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "set", "note": "MCP 高度 8,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 8000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 8000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s109 と同じ。notes/AERO.md §3.23）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "mark", "note": "離陸" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方（EEC が D-TO の制限で抑える）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 120, "stop": true },
    { "do": "set", "note": "操縦輪を引く（引き起こし）", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.35 },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "set", "note": "操縦輪を緩める", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20, "stop": true },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40, "stop": true },
    { "do": "cmd", "note": "手の操縦を終える", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "check", "note": "空中でも離陸の推力制限のうちは D-TO +50C", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "D-TO +50C" },
    { "do": "wait", "note": "電波高度 1,200 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 1200, "timeout": 60, "stop": true },
    { "do": "cmd", "note": "FLCH（MCP 8,000 ft へ）", "name": "laminar/B747/autopilot/button_switch/flch_mode", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "THR（上昇の推力制限：FCOM p.642）", "name": "laminar/B747/autopilot/button_switch/thrust_mode", "duration": 0.2 },
    { "do": "wait", "note": "推力制限は上昇（SEL 50 の大きな減格で CLB 2 が自動で入る：FCOM p.1273）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "contains", "value": "CLB", "timeout": 10, "stop": true },
    { "do": "check", "note": "EICAS の行は CLB 2（仮定温度なし。前は CLB 2 +50C）", "dref": "laminar/B747/fms/thrlim/eicas", "op": "matches", "value": "^CLB( [12])?$" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_clb" },
    { "do": "cdu", "note": "INIT REF、<INDEX（INIT/REF INDEX）、THRUST LIM（L4）", "keys": ["INITREF", "L6", "L4"] },
    { "do": "sleep", "seconds": 1, "note": "空中の THRUST LIM の描画（キーの割り当てはページの描画で決まる）" },
    { "do": "check", "note": "空中の THRUST LIM の 3L は <CON（FCOM p.1339）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^<CON" },
    { "do": "cdu", "note": "<CON（L3。FLCH の上昇中は <CRZ を選んでもモデルが CLB に戻す：B747.68.thrlim_model.lua の update）", "keys": ["L3"] },
    { "do": "wait", "note": "推力制限は CON", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CON", "timeout": 5 },
    { "do": "check", "note": "EICAS の行は CON（前は CON +50C。利用者の写真は CRZ +47C）", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "CON" },
    { "do": "shot", "name": "eicas_con" },
    { "do": "set", "note": "スラスト・レバーを 0.8 に（上昇を続ける）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.8 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
