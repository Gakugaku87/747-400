{
  "name": "s19_antiice_air",
  "description": "防氷・防雨（3-2）の X-Plane での確認、空中。10,000 ft の空中で開始し、TAT のヒーターが空中で入ること（FCOM p.634）、WING ANTI-ICE を ON にすると空中では左右の弁が開き（3 秒以内：LH36 p.126）、WAI VALVE 灯が開き終わると消え、X-Plane の翼の熱（主 EICAS の WAI）が入ること（FCOM p.626、p.633）。TAT が 12°C 以下なので >ANTI-ICE は出ないこと（FCOM p.635）。右 TAT のヒーターの故障で 15 秒後の HEAT R TAT（ATA30_32_35_36 p.228）。WAI を切ると弁が閉じること。期待値は notes/ATA-30.md。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 130 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "snapshot", "note": "空中開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/cockpit2/gauges/indicators/altitude_ft_pilot",
      "sim/weather/aircraft/temperature_leadingedge_deg_c", "laminar/B747/gear/air_ground/pri_gnd",
      "laminar/B747/button_switch/position[72]", "laminar/B747/button_switch/position[73]",
      "laminar/B747/antiice/wing/valve_pos[0]", "laminar/B747/antiice/wing/valve_pos[1]",
      "laminar/B747/antiice/light/wai_valve", "sim/cockpit2/ice/ice_TAT_heat_on", "sim/cockpit2/ice/ice_TAT_heat_on_copilot",
      "sim/cockpit2/ice/ice_surfce_heat_left_on", "sim/cockpit2/ice/ice_detect_on", "sim/cockpit2/annunciators/ice",
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_R" ] },
    { "do": "cas", "note": "空中開始直後" },
    { "do": "check", "note": "空中（PSEU）", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 0 },
    { "do": "check", "note": "空中：左 TAT のヒーター（FCOM p.634）", "dref": "sim/cockpit2/ice/ice_TAT_heat_on", "op": "==", "value": 1 },
    { "do": "check", "note": "右 TAT のヒーター", "dref": "sim/cockpit2/ice/ice_TAT_heat_on_copilot", "op": "==", "value": 1 },
    { "do": "check", "note": "HEAT L TAT なし", "dref": "laminar/B747/CAS/advisory_status[187]", "op": "==", "value": 0 },
    { "do": "check", "note": "WAI OFF：左の弁は閉", "dref": "laminar/B747/antiice/wing/valve_pos[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "WAI VALVE 灯なし", "dref": "laminar/B747/annunciator/brightness_ratio[64]", "op": "==", "value": 0 },
    { "do": "check", "note": "氷検知器が入る", "dref": "sim/cockpit2/ice/ice_detect_on", "op": "==", "value": 1 },

    { "do": "mark", "note": "WAI ON（空中）" },
    { "do": "switch", "note": "WING ANTI-ICE ON", "dref": "laminar/B747/button_switch/position[72]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_wing" },
    { "do": "wait", "note": "左の WAI 弁が開く（モーター 3 秒以内：LH36 p.126）", "dref": "laminar/B747/antiice/wing/valve_pos[0]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "右の WAI 弁が開", "dref": "laminar/B747/antiice/wing/valve_pos[1]", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "開き終わると WAI VALVE 灯が消える（FCOM p.633）", "dref": "laminar/B747/annunciator/brightness_ratio[64]", "op": "==", "value": 0 },
    { "do": "check", "note": "X-Plane の左翼の熱（主 EICAS の WAI）", "dref": "sim/cockpit2/ice/ice_surfce_heat_left_on", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の右翼の熱", "dref": "sim/cockpit2/ice/ice_surfce_heat_right_on", "op": "==", "value": 1 },
    { "do": "check", "note": "WAI VALVE LEFT なし", "dref": "laminar/B747/CAS/advisory_status[296]", "op": "==", "value": 0 },
    { "do": "check", "note": "WAI VALVE RIGHT なし", "dref": "laminar/B747/CAS/advisory_status[297]", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "WAI ON", "drefs": [ "sim/weather/aircraft/temperature_leadingedge_deg_c", "laminar/B747/CAS/advisory_status[7]",
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_R" ] },
    { "do": "check", "note": "TAT が 12°C 以下：>ANTI-ICE は出ない（FCOM p.635）", "dref": "laminar/B747/CAS/advisory_status[7]", "op": "==", "value": 0, "level": "warn" },
    { "do": "cas", "note": "WAI ON" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_wai_on" },

    { "do": "mark", "note": "右 TAT のヒーターの故障" },
    { "do": "set", "note": "右 TAT のヒーターを故障に", "dref": "sim/operation/failures/rel_ice_TAT_heat2", "value": 6 },
    { "do": "sleep", "seconds": 12 },
    { "do": "check", "note": "HEAT R TAT は 15 秒まで出ない", "dref": "laminar/B747/CAS/advisory_status[193]", "op": "==", "value": 0 },
    { "do": "wait", "note": "HEAT R TAT（15 秒：ATA30_32_35_36 p.228）", "dref": "laminar/B747/CAS/advisory_status[193]", "op": "==", "value": 1, "timeout": 6 },
    { "do": "check", "note": "X-Plane の右 TAT のヒーターが切れる", "dref": "sim/cockpit2/ice/ice_TAT_heat_on_copilot", "op": "==", "value": 0 },
    { "do": "check", "note": "HEAT L TAT は出ない", "dref": "laminar/B747/CAS/advisory_status[187]", "op": "==", "value": 0 },
    { "do": "cas", "note": "右 TAT のヒーターの故障" },
    { "do": "set", "note": "故障を戻す", "dref": "sim/operation/failures/rel_ice_TAT_heat2", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "HEAT R TAT が消える", "dref": "laminar/B747/CAS/advisory_status[193]", "op": "==", "value": 0 },

    { "do": "mark", "note": "WAI OFF" },
    { "do": "switch", "note": "WING ANTI-ICE OFF", "dref": "laminar/B747/button_switch/position[72]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_wing" },
    { "do": "wait", "note": "左の WAI 弁が閉じる", "dref": "laminar/B747/antiice/wing/valve_pos[0]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WAI VALVE 灯なし", "dref": "laminar/B747/annunciator/brightness_ratio[64]", "op": "==", "value": 0 },
    { "do": "check", "note": "X-Plane の左翼の熱が切れる", "dref": "sim/cockpit2/ice/ice_surfce_heat_left_on", "op": "==", "value": 0 },
    { "do": "cas", "note": "終了" },
    { "do": "record_stop" }
  ]
}
