{
  "name": "s92_hold",
  "description": "FMC のホールド（6-1・6-2 段 7a・7b）の X-Plane での確認、空中。RJAA→XAC の脚の上、XAC の 15 nm 手前、10,000 ft、250 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DIRECT XAC・SPENS・BOKJO を入れ、ACTIVATE と EXEC、LNAV。HOLD キーで RTE LEGS HOLD AT（FCOM p.1414）、XAC に HOLD AT（FMSPG p.158）、INBD CRS 044（来る向きの逆：teardrop の進入）で EXEC。XAC の上で teardrop（FMSPG p.225：出航コースから 40° の脚 2.95r、右に回って入航コースへ）、30° までのバンク（FCOM p.1413）、1 周。2 周目の出航脚で EXIT HOLD と EXEC：すぐ戻りの旋回、XAC で出て SPENS へ（FMSPG p.222）。最後に PPOS のホールド（FCOM p.1415）と、その DELETE で次の点へ直行（FCOM p.1416）。CDU と ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.91121, "longitude": 139.59895, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（脚の向き：真 217）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO、ACTIVATE と EXEC、LNAV" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS、現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "脚の上なので LNAV がすぐ engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 30 },

    { "do": "mark", "note": "HOLD キー：ホールドが無いので RTE LEGS HOLD AT（FCOM p.1413–1414）" },
    { "do": "cdu", "keys": ["HOLD"] },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },
    { "do": "check", "note": "HOLD AT の行", "dref": "laminar/B747/fms3/Line12_L", "op": "==", "value": "--------HOLD AT---------" },
    { "do": "check", "note": "箱と PPOS>", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "*****              PPOS>" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_legs_hold_at" },
    { "do": "view", "name": "forward" },
    { "do": "mark", "note": "XAC に HOLD AT：MOD RTE 1 HOLD（FMSPG p.158）。INBD CRS 044、EXEC" },
    { "do": "cdu", "keys": ["XAC", "L6", "?SEL"] },
    { "do": "check", "note": "MOD RTE 1 HOLD", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 HOLD" },
    { "do": "check", "note": "FIX XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "check", "note": "既定は右回り（FMSPG p.160）", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "/R TURN" },
    { "do": "check", "note": "LEG TIME 1.0（14,000 ft 以下：FMSPG p.222）", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "1.0" },
    { "do": "cdu", "keys": ["044", "L3"] },
    { "do": "check", "note": "INBD CRS/DIR 044/R TURN", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "044`/R TURN" },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1 HOLD", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 HOLD" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_act_rte_hold" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "keys": ["LEGS"] },
    { "do": "check", "note": "LEGS：XAC の後に HOLD AT XAC（FCOM p.1331）", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "HOLD AT" },
    { "do": "check", "note": "その行は XAC", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "XAC" },
    { "do": "check", "note": "まだホールドの外", "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 0 },

    { "do": "mark", "note": "XAC の上で teardrop の進入（FMSPG p.225）" },
    { "do": "switch", "note": "ND の表示範囲 20 nm（つまみのコマンドで：X-Plane の地図の範囲も）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/range/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/range/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 3, "note": "ND が新しい範囲で描き直すのを待つ" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND：XAC のホールドが TO の点のホールドとして実際の大きさで（FMSPG p.223–224）", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_hold_ahead" },
    { "do": "view", "name": "forward" },
    { "do": "wait", "note": "XAC を通ると teardrop（3）", "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 3, "timeout": 360 },
    { "do": "check", "note": "LEGS の先頭は HOLD AT XAC（ホールドがアクティブな脚）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "HOLD AT" },
    { "do": "watch", "note": "teardrop の脚とホールドの向き（右）への戻り：バンクは 30° まで（FCOM p.1413。サーボの行き過ぎを 3° 見る）", "dref": "sim/flightmodel/position/phi", "abs": true, "max": 33, "until": { "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 9 }, "timeout": 420 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "wait", "note": "入航コースで XAC を通る（1 回目）", "dref": "laminar/B747/fms/lnav/hold_loops", "op": "==", "value": 1, "timeout": 300 },
    { "do": "check", "note": "入航コースの上で（0.3 nm 以内）", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.3, 0.3] },

    { "do": "mark", "note": "1 周：保持点の旋回、出航脚、戻りの旋回、入航脚" },
    { "do": "watch", "note": "形から 0.8 nm 以内（旋回と脚）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.8, "until": { "dref": "laminar/B747/fms/lnav/hold_loops", "op": "==", "value": 2 }, "timeout": 480 },
    { "do": "check", "note": "XAC を入航コースの上で（0.3 nm 以内）", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.3, 0.3] },
    { "do": "watch", "note": "保持点の旋回のバンクは 30° まで", "dref": "sim/flightmodel/position/phi", "abs": true, "max": 33, "until": { "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 7 }, "timeout": 200 },
    { "do": "sleep", "seconds": 10, "note": "出航脚に乗る" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_hold_outbound" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "2 周目の出航脚で EXIT HOLD と EXEC：すぐ戻りの旋回（FMSPG p.222）" },
    { "do": "cdu", "keys": ["HOLD"] },
    { "do": "check", "note": "ホールドがあるので ACT RTE 1 HOLD（FCOM p.1416）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 HOLD" },
    { "do": "check", "note": "EXIT HOLD>（アクティブな脚：FMSPG p.162）", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "EXIT HOLD>" },
    { "do": "cdu", "keys": ["R6"] },
    { "do": "check", "note": "EXIT ARMED（修正）", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "EXIT ARMED" },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "wait", "note": "LNAV の EXIT ARMED", "dref": "laminar/B747/fms/lnav/hold_exit", "op": "==", "value": 1, "timeout": 5 },
    { "do": "wait", "note": "出航脚の途中から戻りの旋回（8）", "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 8, "timeout": 10 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_exit_armed" },
    { "do": "view", "name": "forward" },
    { "do": "wait", "note": "XAC で出て SPENS がアクティブに（ホールドが無くなった RTE HOLD のページは RTE LEGS HOLD AT に：推定）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SPENS", "timeout": 300 },
    { "do": "check", "note": "RTE LEGS HOLD AT の行", "dref": "laminar/B747/fms3/Line12_L", "op": "==", "value": "--------HOLD AT---------" },
    { "do": "check", "note": "ホールドの外", "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 0 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2 },
    { "do": "watch", "note": "XAC から SPENS への脚（西：磁方位 277）へ XAC の上から左に約 127° 回る：はみ出しは旋回の半径の 1.6 倍ほど（推定：ホールドから次の脚へ fly-by しない）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 5.5, "until": { "dref": "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "op": "between", "value": [266, 288] }, "timeout": 240 },
    { "do": "watch", "note": "切込んで脚に乗る（0.3 nm 以内へ）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 5.5, "until": { "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.3, 0.3] }, "timeout": 300 },
    { "do": "wait", "note": "翼が水平に", "dref": "sim/flightmodel/position/phi", "op": "between", "value": [-2, 2], "timeout": 90 },

    { "do": "mark", "note": "PPOS のホールド（FCOM p.1415）と、その DELETE（FCOM p.1416）" },
    { "do": "cdu", "keys": ["HOLD"] },
    { "do": "check", "note": "ホールドが無いので RTE LEGS HOLD AT", "dref": "laminar/B747/fms3/Line12_L", "op": "==", "value": "--------HOLD AT---------" },
    { "do": "cdu", "keys": ["R6"] },
    { "do": "check", "note": "MOD RTE 1 HOLD、FIX PPOS", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "PPOS" },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "EXEC：FIX はその時の位置（N34E139 の形）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "N34E139" },
    { "do": "wait", "note": "その場で direct の進入（2）", "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 2, "timeout": 5 },
    { "do": "watch", "note": "LNAV はホールドの向き（右）に回す：左へのバンクを指令しない", "dref": "laminar/B747/fms/lnav/roll", "min": -1, "timeout": 30 },
    { "do": "check", "note": "右に傾いている", "dref": "sim/flightmodel/position/phi", "op": "between", "value": [10, 33] },
    { "do": "cdu", "keys": ["LEGS", "DEL", "L1"] },
    { "do": "check", "note": "DELETE：SPENS が先頭（MOD）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SPENS" },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ホールドの外", "dref": "laminar/B747/fms/lnav/hold_phase", "op": "==", "value": 0 },
    { "do": "watch", "note": "SPENS へ直行（機体のいる所から：0.5 nm 以内）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "timeout": 60 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
