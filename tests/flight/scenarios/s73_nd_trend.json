{
  "name": "s73_nd_trend",
  "description": "ND の位置のトレンドベクトル（5-2 段 5e）の X-Plane での確認、空中。フランクフルトの南 4,000 ft・220 kt・北向きで開始、HDG SEL。40 NM の MAP で 30 秒の区間 3 本（直進では真っすぐ上）、MCP の方位を右に 90° 回して右旋回で右へ曲がる（傾きと対地速度：FCOM p.1147）、20 NM は 2 本、10 NM は 1 本、VOR モードでは出さない。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 49.600000, "longitude": 8.545000, "elevation_in_meters": 1219.2, "heading_true": 0.0, "speed_in_meters_per_second": 113.2 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位は今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 0, "rel": "hdg0", "round": 1 },
    { "do": "set", "note": "MCP 速度 220 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 220 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "範囲 40 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "wait", "note": "40 NM：3 区間の 9 片（FCOM p.1147）", "dref": "laminar/B747/nd/capt/tv_show[8]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "直進：真っすぐ上（3 片目の中点が左右に 2 px の内）", "dref": "laminar/B747/nd/capt/tv_x[2]", "op": "between", "value": [-2, 2] },
    { "do": "check", "note": "最後の片は 3 区間目（90 秒の手前：220 kt で 1 区間 21 px 余り）", "dref": "laminar/B747/nd/capt/tv_y[8]", "op": "between", "value": [50, 70] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_tv_straight" },
    { "do": "set", "note": "MCP 方位を右に 90°", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90, "rel": "hdg0", "round": 1 },
    { "do": "wait", "note": "右に傾く", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 15, "timeout": 20 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "右旋回：右へ曲がる（最後の片が右に）", "dref": "laminar/B747/nd/capt/tv_x[8]", "op": ">", "value": 5 },
    { "do": "check", "note": "最後の片の向きは右へ大きく回る", "dref": "laminar/B747/nd/capt/tv_rot[8]", "op": ">", "value": 30 },
    { "do": "shot", "name": "nd_tv_turn_40" },
    { "do": "set", "note": "範囲 20 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "20 NM：2 区間（6 片目まで）", "dref": "laminar/B747/nd/capt/tv_show[5]", "op": "==", "value": 1 },
    { "do": "check", "note": "7 片目は無し", "dref": "laminar/B747/nd/capt/tv_show[6]", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_tv_turn_20" },
    { "do": "set", "note": "範囲 10 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 0 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "10 NM：1 区間（3 片目まで）", "dref": "laminar/B747/nd/capt/tv_show[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "4 片目は無し", "dref": "laminar/B747/nd/capt/tv_show[3]", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_tv_turn_10" },
    { "do": "switch", "note": "機長の ND を VOR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VOR モードでは出さない（MAP、MAP CTR だけ）", "dref": "laminar/B747/nd/capt/tv_show[0]", "op": "==", "value": 0 },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "set", "note": "範囲を 40 NM に戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
