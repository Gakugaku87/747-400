{
  "name": "s314_at_flch_capture_speed",
  "description": "2026-11-12 のフルレビューの AT-3（案 B5：A/T の SPD がピッチの側の V/S の変化に推力を先回りで合わせる。B747.70.at_model.lua）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・北向き、270 t で開始（機体を読み直す）。A/P CMD L・HDG SEL・A/T SPD 310 kt。MCP 17,000 ft で FLCH の上昇（A/T は THR）、17,000 ft の捕捉で ALT と A/T の SPD：速さは目標の 5 kt 上まで（レビューの見込み：直す前は模型で +8.7 kt、X-Plane の s139 は FL170 で +10.1 kt）、その後 ±3 kt。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 155.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 310 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 310 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "310 kt の ±5 kt に乗る", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [305, 315], "timeout": 120 },
    { "do": "sleep", "seconds": 15 },

    { "do": "mark", "note": "FLCH で 17,000 ft へ" },
    { "do": "set", "note": "MCP 高度 17,000 ft（前の則の目標にも）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 17000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 17000 },
    { "do": "sleep", "seconds": 4, "note": "MCP の高度が中へ写るのを待つ（3 秒）" },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FMA のピッチは FLCH SPD（8）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8, "timeout": 10, "stop": true },
    { "do": "record_start" },
    { "do": "wait", "note": "捕捉で ALT（FMA 9）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 300, "stop": true },
    { "do": "snapshot", "note": "捕捉", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/flightmodel/weight/m_total" ] },
    { "do": "watch", "note": "捕捉の後 90 秒、速さは目標 310 kt の 5 kt 上まで（B5）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "max": 315, "timeout": 90 },
    { "do": "check", "note": "A/T は SPD（3）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "17,000 ft で水平（±40 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [16960, 17040] },
    { "do": "watch", "note": "その後 30 秒、310 kt の ±3 kt", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "min": 307, "max": 313, "timeout": 30 },
    { "do": "record_stop" }
  ]
}
