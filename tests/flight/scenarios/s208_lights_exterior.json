{
  "name": "s208_lights_exterior",
  "description": "照明の 7-2b（notes/ATA-33.md §12）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す。夜）。外部灯のスイッチを全部 OFF にしてから 1 つずつコマンドで ON にし、X-Plane の灯（landing 0–3、taxi、generic 0–3、beacon、nav、strobe）がスイッチの対応どおりに点くこと（notes §3.2）、AC bus 1・3 と GSB が通電し PSEU が地上で gear lever が DOWN のとき landing が最大で点くこと、turnoff と taxi が地上で点くこと。外からの機体と頭上パネルを撮る。最後に全部 OFF で消えること。gear lever UP の減光（70 %）と空中の turnoff・taxi は回帰試験（tests/lighting）だけで見る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 22.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "AC bus 1 が通電（INBD の landing）", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC bus 3 が通電（OUTBD の landing）", "dref": "laminar/B747/electrical/bus/ac[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "GSB が通電", "dref": "laminar/B747/electrical/bus/gnd_svc", "op": "==", "value": 1 },
    { "do": "check", "note": "PSEU が地上", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 1 },
    { "do": "check", "note": "gear lever が DOWN", "dref": "laminar/B747/actuator/gear_handle", "op": "<", "value": 0.05 },
    { "do": "switch", "note": "LANDING OUTBD L を OFF", "dref": "laminar/B747/toggle_switch/position[1]", "value": 1, "cmd": "laminar/B747/toggle_switch/landing_light_OBL" },
    { "do": "switch", "note": "LANDING OUTBD R を OFF", "dref": "laminar/B747/toggle_switch/position[2]", "value": 1, "cmd": "laminar/B747/toggle_switch/landing_light_OBR" },
    { "do": "switch", "note": "LANDING INBD L を OFF", "dref": "laminar/B747/toggle_switch/position[3]", "value": 1, "cmd": "laminar/B747/toggle_switch/landing_light_IBL" },
    { "do": "switch", "note": "LANDING INBD R を OFF", "dref": "laminar/B747/toggle_switch/position[4]", "value": 1, "cmd": "laminar/B747/toggle_switch/landing_light_IBR" },
    { "do": "switch", "note": "RWY TURNOFF L を OFF", "dref": "laminar/B747/toggle_switch/position[5]", "value": 1, "cmd": "laminar/B747/toggle_switch/rwy_tunoff_L" },
    { "do": "switch", "note": "RWY TURNOFF R を OFF", "dref": "laminar/B747/toggle_switch/position[6]", "value": 1, "cmd": "laminar/B747/toggle_switch/rwy_tunoff_R" },
    { "do": "switch", "note": "TAXI を OFF", "dref": "laminar/B747/toggle_switch/position[7]", "value": 1, "cmd": "laminar/B747/toggle_switch/taxi_light" },
    { "do": "switch", "note": "BEACON を OFF（中）", "dref": "laminar/B747/toggle_switch/position[8]", "value": 0, "cmd": "laminar/B747/toggle_switch/beacon_light_up", "cmd_down": "laminar/B747/toggle_switch/beacon_light_down" },
    { "do": "switch", "note": "NAV を OFF", "dref": "laminar/B747/toggle_switch/position[9]", "value": 1, "cmd": "laminar/B747/toggle_switch/nav_light" },
    { "do": "switch", "note": "STROBE を OFF", "dref": "laminar/B747/toggle_switch/position[10]", "value": 1, "cmd": "laminar/B747/toggle_switch/strobe_light" },
    { "do": "switch", "note": "WING を OFF", "dref": "laminar/B747/toggle_switch/position[11]", "value": 1, "cmd": "laminar/B747/toggle_switch/wing_light" },
    { "do": "switch", "note": "LOGO を OFF", "dref": "laminar/B747/toggle_switch/position[12]", "value": 1, "cmd": "laminar/B747/toggle_switch/logo_light" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "全部 OFF：landing 0", "dref": "sim/cockpit2/switches/landing_lights_switch[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：landing 1", "dref": "sim/cockpit2/switches/landing_lights_switch[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：landing 2", "dref": "sim/cockpit2/switches/landing_lights_switch[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：landing 3", "dref": "sim/cockpit2/switches/landing_lights_switch[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：taxi", "dref": "sim/cockpit2/switches/taxi_light_on", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：turnoff L（generic 0）", "dref": "sim/cockpit2/switches/generic_lights_switch[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：logo（generic 3）", "dref": "sim/cockpit2/switches/generic_lights_switch[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：beacon", "dref": "sim/cockpit/electrical/beacon_lights_on", "op": "==", "value": 0 },
    { "do": "check", "note": "全部 OFF：nav", "dref": "sim/cockpit2/switches/navigation_lights_on", "op": "==", "value": 0 },
    { "do": "switch", "note": "LANDING OUTBD L だけ ON", "dref": "laminar/B747/toggle_switch/position[1]", "value": 0, "cmd": "laminar/B747/toggle_switch/landing_light_OBL" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "OUTBD L は X-Plane の landing 0、lever DOWN で最大", "dref": "sim/cockpit2/switches/landing_lights_switch[0]", "op": "==", "value": 1, "cite": "ATA33 p.328" },
    { "do": "check", "note": "landing 1（INBD L）は消えたまま", "dref": "sim/cockpit2/switches/landing_lights_switch[1]", "op": "==", "value": 0 },
    { "do": "switch", "note": "LANDING INBD R を ON", "dref": "laminar/B747/toggle_switch/position[4]", "value": 0, "cmd": "laminar/B747/toggle_switch/landing_light_IBR" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "INBD R は X-Plane の landing 2", "dref": "sim/cockpit2/switches/landing_lights_switch[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "landing 3（OUTBD R）は消えたまま", "dref": "sim/cockpit2/switches/landing_lights_switch[3]", "op": "==", "value": 0 },
    { "do": "switch", "note": "LANDING INBD L を ON", "dref": "laminar/B747/toggle_switch/position[3]", "value": 0, "cmd": "laminar/B747/toggle_switch/landing_light_IBL" },
    { "do": "switch", "note": "LANDING OUTBD R を ON", "dref": "laminar/B747/toggle_switch/position[2]", "value": 0, "cmd": "laminar/B747/toggle_switch/landing_light_OBR" },
    { "do": "switch", "note": "TAXI を ON", "dref": "laminar/B747/toggle_switch/position[7]", "value": 0, "cmd": "laminar/B747/toggle_switch/taxi_light" },
    { "do": "switch", "note": "RWY TURNOFF L を ON", "dref": "laminar/B747/toggle_switch/position[5]", "value": 0, "cmd": "laminar/B747/toggle_switch/rwy_tunoff_L" },
    { "do": "switch", "note": "RWY TURNOFF R を ON", "dref": "laminar/B747/toggle_switch/position[6]", "value": 0, "cmd": "laminar/B747/toggle_switch/rwy_tunoff_R" },
    { "do": "switch", "note": "WING を ON", "dref": "laminar/B747/toggle_switch/position[11]", "value": 0, "cmd": "laminar/B747/toggle_switch/wing_light" },
    { "do": "switch", "note": "LOGO を ON", "dref": "laminar/B747/toggle_switch/position[12]", "value": 0, "cmd": "laminar/B747/toggle_switch/logo_light" },
    { "do": "switch", "note": "BEACON を BOTH（下、-1）", "dref": "laminar/B747/toggle_switch/position[8]", "value": -1, "cmd": "laminar/B747/toggle_switch/beacon_light_up", "cmd_down": "laminar/B747/toggle_switch/beacon_light_down" },
    { "do": "switch", "note": "NAV を ON", "dref": "laminar/B747/toggle_switch/position[9]", "value": 0, "cmd": "laminar/B747/toggle_switch/nav_light" },
    { "do": "switch", "note": "STROBE を ON", "dref": "laminar/B747/toggle_switch/position[10]", "value": 0, "cmd": "laminar/B747/toggle_switch/strobe_light" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "INBD L は X-Plane の landing 1", "dref": "sim/cockpit2/switches/landing_lights_switch[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "OUTBD R は X-Plane の landing 3", "dref": "sim/cockpit2/switches/landing_lights_switch[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "taxi が地上で点く", "dref": "sim/cockpit2/switches/taxi_light_on", "op": "==", "value": 1, "cite": "FCOM p.451" },
    { "do": "check", "note": "turnoff L（generic 0）が地上で点く", "dref": "sim/cockpit2/switches/generic_lights_switch[0]", "op": "==", "value": 1, "cite": "ATA33 p.334" },
    { "do": "check", "note": "turnoff R（generic 1）", "dref": "sim/cockpit2/switches/generic_lights_switch[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "wing（generic 2）", "dref": "sim/cockpit2/switches/generic_lights_switch[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "logo（generic 3）", "dref": "sim/cockpit2/switches/generic_lights_switch[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "beacon（BOTH）", "dref": "sim/cockpit/electrical/beacon_lights_on", "op": "==", "value": 1 },
    { "do": "check", "note": "nav", "dref": "sim/cockpit2/switches/navigation_lights_on", "op": "==", "value": 1 },
    { "do": "check", "note": "strobe", "dref": "sim/cockpit2/switches/strobe_lights_on", "op": "==", "value": 1 },
    { "do": "view", "note": "頭上パネルの外部灯のスイッチ（全部 ON。lights：前の overhead は電源パネルを向いていた）", "name": "lights" },
    { "do": "shot", "name": "overhead_all_on" },
    { "do": "view", "name": "forward" },
    { "do": "cmd", "note": "外からの視点", "name": "sim/view/circle" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "exterior_all_on" },
    { "do": "cmd", "note": "操縦室へ戻る", "name": "sim/view/3d_cockpit_cmnd_look" },
    { "do": "sleep", "seconds": 2 },
    { "do": "switch", "note": "LANDING OUTBD L を OFF", "dref": "laminar/B747/toggle_switch/position[1]", "value": 1, "cmd": "laminar/B747/toggle_switch/landing_light_OBL" },
    { "do": "switch", "note": "TAXI を OFF", "dref": "laminar/B747/toggle_switch/position[7]", "value": 1, "cmd": "laminar/B747/toggle_switch/taxi_light" },
    { "do": "switch", "note": "BEACON を OFF", "dref": "laminar/B747/toggle_switch/position[8]", "value": 0, "cmd": "laminar/B747/toggle_switch/beacon_light_up", "cmd_down": "laminar/B747/toggle_switch/beacon_light_down" },
    { "do": "switch", "note": "LOGO を OFF", "dref": "laminar/B747/toggle_switch/position[12]", "value": 1, "cmd": "laminar/B747/toggle_switch/logo_light" },
