    { "do": "check", "note": "OUTBD L が消える", "dref": "sim/cockpit2/switches/landing_lights_switch[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "taxi が消える", "dref": "sim/cockpit2/switches/taxi_light_on", "op": "==", "value": 0 },
    { "do": "check", "note": "beacon が消える", "dref": "sim/cockpit/electrical/beacon_lights_on", "op": "==", "value": 0 },
    { "do": "check", "note": "logo が消える", "dref": "sim/cockpit2/switches/generic_lights_switch[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "INBD L は点いたまま", "dref": "sim/cockpit2/switches/landing_lights_switch[1]", "op": "==", "value": 1 }
