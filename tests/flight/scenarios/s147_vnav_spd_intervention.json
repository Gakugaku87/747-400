{
  "name": "s147_vnav_spd_intervention",
  "description": "6-1/6-2 段 9d3（速度介入）の X-Plane での確認。s140 と同じ経路・LNAV・ZFW 200・CI 100・FL300・MCP 10,000 ft で、ATMUG の約 30 NM 西から東へ空中開始（機体を読み直す）。T/D からの VNAV PTH の降下の 1 分後に IAS/MACH のノブを押す：速度介入（FCOM p.643、ATA34_2 p.623）。窓が開いて FMC の速さを示し、FMC に伝わる（`laminar/B747/autopilot/spd_intervention`）。VNAV SPD（ピッチが速さを取る）、FMC の A/T は IDLE、DES のページの見出しは ACT MCP SPD DES（ATA34_2 p.563）、PROGRESS の 5L は MCP SPD（p.568）。MCP の速さを 280 kt にすると FMC の目標もそれ、機体もその速さへ。もう一度押すと窓が閉じて FMC の速さ、VNAV PTH で経路へ、見出しは ACT ECON DES。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 133.52, "elevation_in_meters": 9144, "heading_true": 97, "speed_in_meters_per_second": 225 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage（巡航か降下）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "wait", "note": "降下（T/D：FMC の段階 3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 240 },
    { "do": "sleep", "seconds": 60, "note": "1 分（経路の降下が落ち着く）" },
    { "do": "check", "note": "VNAV PTH の降下", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "介入なし", "dref": "laminar/B747/autopilot/spd_intervention", "op": "==", "value": 0 },
    { "do": "check", "note": "窓は閉じている", "dref": "laminar/B747/autopilot/ias_mach/window_open", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "押す前", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_is_mach", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms/vnav/path_dev" ] },
    { "do": "cmd", "note": "IAS/MACH のノブを押す（0.2 秒押して離す：長さ 0 のコマンドでは離しが XTLua に届かず、ノブの絵が押し込みのまま残って、次の押しが離しとして捨てられる）", "name": "laminar/B747/button_switch/press_airspeed", "duration": 0.2 },
    { "do": "wait", "note": "速度介入", "dref": "laminar/B747/autopilot/spd_intervention", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "窓が開く", "dref": "laminar/B747/autopilot/ias_mach/window_open", "op": "==", "value": 1 },
    { "do": "wait", "note": "VNAV SPD（FCOM p.643：PTH の降下で窓を開くと）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 5 },
    { "do": "check", "note": "FMC は VNAV SPD（1）", "dref": "laminar/B747/fms/vnav/mode", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC の A/T は IDLE（2）", "dref": "laminar/B747/fms/vnav/at", "op": "==", "value": 2 },
    { "do": "cdu", "note": "VNAV のページ、NEXT、NEXT（DES）", "keys": ["VNAV", "NEXT", "NEXT"] },
    { "do": "check", "note": "ACT MCP SPD DES（ATA34_2 p.563）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT MCP SPD DES" },
    { "do": "cdu", "note": "PROGRESS", "keys": ["PROG"] },
    { "do": "sleep", "seconds": 1.5 },
    { "do": "check", "note": "5L は MCP SPD（ATA34_2 p.568）", "dref": "laminar/B747/fms3/Line10_S", "op": "contains", "value": "MCP SPD" },
    { "do": "check", "note": "MCP は IAS（降下の速さ）", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "op": "==", "value": 0 },
    { "do": "set", "note": "MCP の速さを 280 kt に", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 280 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC の目標は MCP の 280 kt", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [279.5, 280.5] },
    { "do": "wait", "note": "ピッチで 280 kt に", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [276, 284], "timeout": 120 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "20 秒後も 280 kt の近く", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [274, 286] },
    { "do": "check", "note": "VNAV SPD のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "A/T は IDLE か HOLD（降下の VNAV SPD：ATA34_2 p.658）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "in", "value": [1, 2] },
    { "do": "snapshot", "note": "介入の終わりの前", "drefs": [ "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/alt" ] },
    { "do": "cmd", "note": "もう一度押す（0.2 秒）", "name": "laminar/B747/button_switch/press_airspeed", "duration": 0.2 },
    { "do": "wait", "note": "介入の終わり", "dref": "laminar/B747/autopilot/spd_intervention", "op": "==", "value": 0, "timeout": 5 },
    { "do": "check", "note": "窓が閉じる", "dref": "laminar/B747/autopilot/ias_mach/window_open", "op": "==", "value": 0 },
    { "do": "wait", "note": "VNAV PTH（経路へ）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "MCP の速さは FMC の目標（降下の速さ）", "dref": "laminar/B747/autopilot/ias_dial_value", "op": "between", "value": [285, 330] },
    { "do": "cdu", "note": "VNAV のページ、NEXT、NEXT（DES）", "keys": ["VNAV", "NEXT", "NEXT"] },
    { "do": "check", "note": "ACT ECON DES", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT ECON DES" },
    { "do": "record_stop" }
  ]
}
