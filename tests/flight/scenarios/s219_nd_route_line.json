{
  "name": "s219_nd_route_line",
  "description": "ND の経路の線（FCOM p.1147：現用の経路はマゼンタの実線、旋回は FMC の経路どおり）の X-Plane での確認、空中。最初のラインフライト（s198）で乱れた ATMUG の左 157° の旋回（MAX_FLYBY を超え、点の上を飛び越えてから回る）の手前 30 NM、10,000 ft・250 kt・256.8°（RJAA→ATMUG の大圏の上）で開始。CDU で RJAA→RJBB、ATMUG、STAR ATMUGA、ILS06LZ（遷移 ATVID）を入れて ACTIVATE と EXEC、LEGS で ATMUG へ DIRECT、LNAV。両 EFIS の WXR を入れる。機長の ND は MAP 20 NM、副操縦士の ND は MAP CTR 20 NM（ATMUG の手前から拡大の MAP）。ATMUG の手前・旋回中・旋回の後で両方の ND を撮り、最後に機長の ND を PLN 10 NM にして撮る。線は FMS ブリッジが描き（notes/ATA-34-61-FMC.md §132）、X-Plane の地図の線は出ない（X-Plane の FMS の現用点は計画の最後の行、FMC の現用点の行は fmscurrentIndex）。経路の線が ATMUG で途切れず、FMC の経路（飛び越えて回る形）に沿って記号の星を通ること、PLAN の中心が LEGS の CTR の点（SAKVA）であることを見る。機体を読み直す（前の FMC の経路が残らないように。空中開始で火が付かないエンジンはランナーがやり直す：TESTING.md）。前のフライトの CDU の scratchpad の文は CLR で消す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.6725, "longitude": 134.7186, "elevation_in_meters": 3048.0, "heading_true": 256.8, "speed_in_meters_per_second": 135.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 20, "note": "空中開始の揺れ。空中開始は FMS が A/P を自分で入れる（IRU の方位の後）" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位は今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 0, "rel": "hdg0", "round": 1 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L（入っていれば受け付けない：AFDS の refused）", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "機長の ND は MAP 20 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "note": "副操縦士の ND は MAP 20 NM", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 1 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "check", "note": "副操縦士の ND は MAP", "dref": "laminar/B747/nd/mode/fo/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "cmd", "note": "副操縦士の CTR（MAP CTR）", "name": "laminar/B747/nd/center/fo/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士は MAP CTR", "dref": "laminar/B747/nd/map_center/fo", "op": "==", "value": 1 },
    { "do": "check", "note": "FMS ブリッジ", "dref": "laminar/B747/fms/xp/bridge", "op": "==", "value": 1 },
    { "do": "cdu", "note": "CLR 2 回（前のフライトの scratchpad の文を消す：残った INVALID ENTRY で打った字が入らなかった）、MENU、<FMC（読み込みの後は IDENT、ほかは最後の FMC のページ：§16）", "keys": ["CLR", "CLR", "MENU", "L1"] },
    { "do": "wait", "note": "FMC のページ（MENU でない）", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "^(?!.*MENU).*[A-Z]", "timeout": 60 },
    { "do": "sleep", "seconds": 10, "note": "FMC の航法データベース" },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT ATMUG", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "ATMUG", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LZ（R4）、遷移 ATVID（R2）（s198 と同じ）", "keys": ["L1", "R4", "R2"] },
    { "do": "check", "note": "ILS06LZ を選んだ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ILS06LZ" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS、ATMUG へ DIRECT（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "wait", "note": "X-Plane の FMS に計画が入り、現用点が決まる", "dref": "laminar/B747/fms/xp/current", "op": ">=", "value": 1, "timeout": 20 },
    { "do": "sleep", "seconds": 3, "note": "現用点を合わせ終える" },
    { "do": "snapshot", "note": "LEGS の 1 ページ目", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L", "laminar/B747/fms/xp/current" ] },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV（FMA のロールは LNAV：2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },

    { "do": "mark", "note": "WXR" },
    { "do": "set", "note": "両 EFIS の WXR を切ってから入れる（s45 と同じ）", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "value": 0 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "機長の EFIS の WXR", "name": "laminar/B747/nd/wxr/capt/switch", "duration": 0.2 },
    { "do": "cmd", "note": "副操縦士の EFIS の WXR", "name": "laminar/B747/nd/wxr/fo/switch", "duration": 0.2 },
    { "do": "cmd", "note": "機長の WX", "name": "sim/instruments/EFIS_wxr_radar_wx" },
    { "do": "cmd", "note": "副操縦士の WX", "name": "sim/instruments/EFIS_wxr_radar_wx_copilot" },
    { "do": "set", "note": "チルト -3°（地面の反射）", "dref": "sim/cockpit2/EFIS/EFIS_weather_tilt", "value": -3 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/EFIS_weather_tilt_copilot", "value": -3 },
    { "do": "sleep", "seconds": 8, "note": "アンテナが何度か走査する" },
    { "do": "check", "note": "機長の WXR", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の WXR", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "op": "==", "value": 1 },

    { "do": "mark", "note": "before ATMUG" },
    { "do": "check", "note": "FMC の線の点（B747.68.nd_line_model.lua）", "dref": "laminar/B747/nd/line/n", "op": ">", "value": 10 },
    { "do": "check", "note": "機長の ND は MAP（拡大）", "dref": "laminar/B747/nd/line/view[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の ND は MAP CTR", "dref": "laminar/B747/nd/line/view[5]", "op": "==", "value": 2 },
    { "do": "snapshot", "note": "X-Plane の FMS の現用点は計画の最後の行（地図が線を描かない）、FMC の現用点の行は fmscurrentIndex", "drefs": [ "laminar/B747/fms/xp/current", "laminar/B747/autopilot/ap_monitor/fmscurrentIndex", "laminar/B747/nd/line/n" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_map_before" },
    { "do": "view", "note": "機長席から F/O の ND", "the": -17, "psi": 44, "fov": 28 },
    { "do": "shot", "name": "fo_nd_ctr_before" },
    { "do": "view", "name": "forward" },
    { "do": "wait", "note": "ATMUG の 6 NM 手前", "dref": "sim/flightmodel/position/longitude", "op": "<", "value": 134.25, "timeout": 420 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_map_near" },
    { "do": "view", "note": "機長席から F/O の ND", "the": -17, "psi": 44, "fov": 28 },
    { "do": "shot", "name": "fo_nd_ctr_near" },
    { "do": "cmd", "note": "副操縦士の CTR を戻す（拡大の MAP）", "name": "laminar/B747/nd/center/fo/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "副操縦士の ND は拡大の MAP", "dref": "laminar/B747/nd/line/view[5]", "op": "==", "value": 1 },
    { "do": "shot", "name": "fo_nd_map_near" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "turn at ATMUG" },
    { "do": "wait", "note": "ATMUG を過ぎて SAKVA へ（X-Plane の FMS の現用点が進む）", "dref": "sim/flightmodel/position/longitude", "op": "<", "value": 134.13, "timeout": 300 },
    { "do": "sleep", "seconds": 15, "note": "左旋回に入る" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_map_turn1" },
    { "do": "view", "note": "機長席から F/O の ND", "the": -17, "psi": 44, "fov": 28 },
    { "do": "shot", "name": "fo_nd_map_turn1" },
    { "do": "view", "name": "forward" },
    { "do": "sleep", "seconds": 25, "note": "旋回の半ば" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_map_turn2" },
    { "do": "view", "note": "機長席から F/O の ND", "the": -17, "psi": 44, "fov": 28 },
    { "do": "shot", "name": "fo_nd_map_turn2" },
    { "do": "view", "name": "forward" },
    { "do": "sleep", "seconds": 30, "note": "旋回の終わり" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "capt_nd_map_after" },
    { "do": "snapshot", "note": "旋回の後", "drefs": [ "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/fms/xp/current", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot" ] },

    { "do": "mark", "note": "PLAN" },
    { "do": "switch", "note": "機長の ND を PLN（つまみ 3：s111 と同じ）", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "set", "note": "範囲 10 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "PLAN", "dref": "laminar/B747/nd/line/view[0]", "op": "==", "value": 3 },
    { "do": "shot", "name": "capt_nd_plan" },
    { "do": "view", "name": "forward" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" }
  ]
}
