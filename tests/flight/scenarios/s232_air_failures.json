{
  "name": "s232_air_failures",
  "description": "空調の故障の入力（2026-11-04、故障の窓の F0：notes/ATA-21.md §10）の X-Plane での確認。成田 34L でエンジン運転中に開始（3 パック運転）。パック 2 の過熱：トリップで PACK 2 と PACK RST の SYS FAULT 灯、運転は 2 パック、75 秒で STATUS PACK 2。PTC A の故障：10 秒で STATUS PACK CONTROL A（B が引き継ぐ）。上の左の再循環ファン：10 秒で STATUS RECIRC FAN UPR L。過熱を消して PACK RST で戻る（ATA21 p.102、p.144、FCOM p.560、p.620）。機器冷却の煙：EQUIP COOLING と STATUS EQUIPMENT SMOKE。カードの故障：地上で >E/E CLNG CARD と STATUS（ATA21 p.510、p.578、FCOM p.619）。上の EICAS と STATUS ページ、頭上パネルを撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "laminar/B747/air/packs_operating", "laminar/B747/air/pack/ptc[0]", "laminar/B747/air/pack/ptc[1]", "laminar/B747/air/pack/ptc[2]",
      "laminar/B747/air/recirc_fan[0]", "laminar/B747/air/recirc_fan[1]", "laminar/B747/air/recirc_fan[2]", "laminar/B747/air/recirc_fan[3]",
      "laminar/B747/air/equip_cooling/state" ] },
    { "do": "check", "note": "3 パック運転", "dref": "laminar/B747/air/packs_operating", "op": "==", "value": 3 },
    { "do": "check", "note": "PACK 2 は出ていない", "dref": "laminar/B747/CAS/advisory_status[253]", "op": "==", "value": 0 },

    { "do": "mark", "note": "パック 2 の過熱、PTC A、再循環ファン" },
    { "do": "set", "note": "パック 2 の過熱", "dref": "laminar/B747/air/fail/pack_ovht[1]", "value": 1 },
    { "do": "wait", "note": "パックがトリップ：PACK 2（FCOM p.620）", "dref": "laminar/B747/CAS/advisory_status[253]", "op": "==", "value": 1, "timeout": 3, "cite": "FCOM p.620" },
    { "do": "check", "note": "PACK RST の SYS FAULT 灯（FCOM p.560）", "dref": "laminar/B747/air/light/pack_sys_fault", "op": "==", "value": 1 },
    { "do": "wait", "note": "運転は 2 パック", "dref": "laminar/B747/air/packs_operating", "op": "==", "value": 2, "timeout": 6 },
    { "do": "set", "note": "PTC A の故障", "dref": "laminar/B747/air/fail/ptc[0]", "value": 1 },
    { "do": "set", "note": "上の左の再循環ファンの故障", "dref": "laminar/B747/air/fail/recirc_fan[1]", "value": 1 },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "10 秒たつまで STATUS PACK CONTROL A は出ない", "dref": "laminar/B747/CAS/status_status[126]", "op": "==", "value": 0 },
    { "do": "wait", "note": "STATUS PACK CONTROL A（ATA21 p.102）", "dref": "laminar/B747/CAS/status_status[126]", "op": "==", "value": 1, "timeout": 5, "cite": "ATA21 p.102" },
    { "do": "check", "note": "B が引き継ぐ：パック 1 の PTC は B", "dref": "laminar/B747/air/pack/ptc[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "PACK CONTROL は出ない（B が制御）", "dref": "laminar/B747/CAS/advisory_status[251]", "op": "==", "value": 0 },
    { "do": "wait", "note": "STATUS RECIRC FAN UPR L（ATA21 p.144）", "dref": "laminar/B747/CAS/status_status[128]", "op": "==", "value": 1, "timeout": 3, "cite": "ATA21 p.144" },
    { "do": "check", "note": "上の左のファンは止まる", "dref": "laminar/B747/air/recirc_fan[1]", "op": "==", "value": 0 },
    { "do": "cas", "note": "PACK 2" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_pack2" },
    { "do": "view", "name": "bleed" },
    { "do": "shot", "name": "overhead_pack_sys_fault" },
    { "do": "wait", "note": "75 秒で STATUS PACK 2（ATA21 p.102）", "dref": "laminar/B747/CAS/status_status[124]", "op": "==", "value": 1, "timeout": 70, "cite": "ATA21 p.102" },
    { "do": "set", "note": "下の EICAS を STATUS に", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "status_air" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/pack_ovht[1]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/ptc[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/recirc_fan[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "過熱が消えてもトリップはラッチ（PACK RST まで：FCOM p.560）", "dref": "laminar/B747/CAS/advisory_status[253]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "PACK RST を押す", "name": "laminar/B747/button_switch/temp_pack_rst", "duration": 0.5 },
    { "do": "wait", "note": "PACK 2 が消える", "dref": "laminar/B747/CAS/advisory_status[253]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "3 パック運転に戻る", "dref": "laminar/B747/air/packs_operating", "op": "==", "value": 3, "timeout": 8 },
    { "do": "check", "note": "STATUS PACK 2 が消える", "dref": "laminar/B747/CAS/status_status[124]", "op": "==", "value": 0 },
    { "do": "check", "note": "STATUS PACK CONTROL A が消える", "dref": "laminar/B747/CAS/status_status[126]", "op": "==", "value": 0 },

    { "do": "mark", "note": "機器冷却の煙とカード" },
    { "do": "set", "note": "機器冷却の排気の煙", "dref": "laminar/B747/air/fail/eq_smoke", "value": 1 },
    { "do": "set", "note": "機器冷却のカードの故障", "dref": "laminar/B747/air/fail/eq_card", "value": 1 },
    { "do": "wait", "note": "EQUIP COOLING（FCOM p.619）", "dref": "laminar/B747/CAS/caution_status[27]", "op": "==", "value": 1, "timeout": 3, "cite": "FCOM p.619" },
    { "do": "check", "note": "STATUS EQUIPMENT SMOKE（ATA21 p.578）", "dref": "laminar/B747/CAS/status_status[137]", "op": "==", "value": 1 },
    { "do": "check", "note": "地上：>E/E CLNG CARD（ATA21 p.510）", "dref": "laminar/B747/CAS/advisory_status[87]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS E/E CLNG CARD", "dref": "laminar/B747/CAS/status_status[138]", "op": "==", "value": 1 },
    { "do": "cas", "note": "EQUIP COOLING、>E/E CLNG CARD" },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_equip_cooling" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/eq_smoke", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/eq_card", "value": 0 },
    { "do": "wait", "note": "EQUIP COOLING が消える", "dref": "laminar/B747/CAS/caution_status[27]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": ">E/E CLNG CARD が消える", "dref": "laminar/B747/CAS/advisory_status[87]", "op": "==", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
