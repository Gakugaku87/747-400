{
  "name": "s204_auto_step_climb",
  "description": "シムの便利機能（notes/ATA-34-61-FMC.md §126）のオートステップクライムの X-Plane での確認、空中。FL310・約 M.84 で RJAA の東から東へ空中開始（s130 と同じ所。機体を読み直す）。RTE RJAA→PHNL を ACTIVATE と EXEC（T/D は遠い）、LNAV、PERF INIT の ZFW 200、COST INDEX 100、CRZ ALT FL310、MCP 31,000 ft で VNAV（VNAV PTH）。CRZ のページで乗員の STEP TO FL350（AT NOW を確かめる）。Plugins → 747-400 の Auto step climb を dataref で ON（保存しない）。0.5 秒ごとの判定で MCP の窓と AFDS の高度が 35,000 ft になり、約 1 秒後に高度セレクターの押しで CRZ ALT が FL350 に、VNAV の巡航上昇（VNAV SPD）で上がり始め、FL350 で VNAV PTH に戻る。CDU と PFD を撮る。最後に dataref を OFF。メニューの印と保存は利用者の目視（X-Plane の Plugins メニュー）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 9449, "heading_true": 90, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "check", "note": "プラグインのオプションの dataref がある（新しい b747_fms_bridge）", "dref": "laminar/B747/options/auto_step_climb", "op": "between", "value": [0, 1] },
    { "do": "set", "note": "Auto step climb を OFF から始める（保存しない）", "dref": "laminar/B747/options/auto_step_climb", "value": 0 },
    { "do": "set", "dref": "laminar/B747/options/pause_at_td", "value": 0 },
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "sleep", "seconds": 10 },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "MCP 高度 31,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 31000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 31000 },
    { "do": "set", "note": "MCP 速度 310 kt（1 回目は MCP の既定の 200 kt で FLCH と A/T SPD が減速し、254 kt からのステップクライムが加速で 120 秒に上がらなかった）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 310 },
    { "do": "cmd", "note": "FLCH で FL310 へ", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FL310 に着く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [30850, 31150], "timeout": 300 },
    { "do": "sleep", "seconds": 15, "note": "FL310 で落ち着く" },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→PHNL、ACTIVATE、EXEC", "keys": ["RTE", "RJAA", "L1", "PHNL", "R1", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL310", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "310", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 15 },
    { "do": "wait", "note": "FMC の段階は巡航（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2, "timeout": 20 },
    { "do": "cmd", "note": "VNAV のページ（CRZ）", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "乗員の STEP TO FL350", "keys": ["350", "R1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "STEP TO FL350", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "FL350$" },
    { "do": "check", "note": "AT NOW（OPT は FL330 の上）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "NOW$" },
    { "do": "wait", "note": "巡航の速さ（FL310 の M.839 は約 313 kt）の 13 kt 以内に", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 300, "timeout": 300 },
    { "do": "snapshot", "note": "CRZ のページと重量", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total", "laminar/B747/autopilot/dist/cruise_alt" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_crz_step_now" },
    { "do": "sleep", "seconds": 5, "note": "OFF のままでは何も起きない" },
    { "do": "check", "note": "MCP は 31,000 ft のまま", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "op": "between", "value": [30950, 31050] },
    { "do": "set", "note": "Auto step climb を ON（Plugins → 747-400 の項目の dataref。保存しない）", "dref": "laminar/B747/options/auto_step_climb", "value": 1 },
    { "do": "mark" },
    { "do": "wait", "note": "MCP の窓が STEP TO の 35,000 ft に", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "op": "between", "value": [34950, 35050], "timeout": 5 },
    { "do": "wait", "note": "高度セレクターの押しで CRZ ALT が FL350 に（FCOM p.649）", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "between", "value": [34950, 35050], "timeout": 5 },
    { "do": "wait", "note": "VNAV SPD で巡航上昇（FMA 4）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "check", "note": "CRZ のページは CRZ CLB（FCOM p.1347）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CRZ CLB" },
    { "do": "snapshot", "note": "巡航上昇の目標と推力の制限", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "shot", "name": "cdu_crz_clb" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_step_climb" },
    { "do": "wait", "note": "上がり始める", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 31500, "timeout": 120 },
    { "do": "wait", "note": "FL350 に着く（1 回目は 34,650 ft の捕捉中に VNAV PTH の待ちが通り、段階がまだ上昇だった）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [34900, 35100], "timeout": 600 },
    { "do": "sleep", "seconds": 20, "note": "FL350 で落ち着く" },
    { "do": "check", "note": "FL350 で VNAV PTH（FMA 6）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "snapshot", "note": "FL350 の巡航", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/dist/cruise_alt", "laminar/B747/fms/vnav/phase", "laminar/B747/autopilot/heading/altitude_dial_ft", "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L" ] },
    { "do": "check", "note": "FMC の段階は巡航（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "check", "note": "FL350", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [34800, 35200] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_crz_fl350" },
    { "do": "record_stop" },
    { "do": "set", "note": "Auto step climb を OFF に戻す", "dref": "laminar/B747/options/auto_step_climb", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
