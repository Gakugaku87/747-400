{
  "name": "s381_ap_engage_roll_sync",
  "description": "段 4 のレビューの AFDS-5（2026-11-24）：F/D だけの間に巻き上がったロールの指令が、A/P を入れた瞬間に残らない（ATA22 p.348 (22-12 p.22)：ロールの姿勢の積分器は A/P が入っていない間はロールの姿勢に同期する。ピッチ側は 2026-11-12 の AFDS-5 で直した）。10,000 ft・約 290 kt で空中から始め（機体を読み直す）、FMS の空中の初期化（CMD L・ALT・HDG HOLD）の後、操縦輪のスイッチで A/P を外して F/D L だけにし、MCP 方位を 60° 左にして HDG SEL。だれもバーを追わないので翼は水平のまま、ロールの指令はバンクの制限（25°）まで行く。15 秒後に CMD L。入れた後 10 秒のロールの角速度（sim/flightmodel/position/P）の絶対値の最大が 3.5°/s 以下（指令は今のバンクから 3°/s で動く）。直す前は指令が 25° のまま始まり、A/P はサーボいっぱいで回り込んだ。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30, "stop": true },
    { "do": "wait", "note": "空中の初期化の ALT HOLD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りが終わるのを待つ" },
    { "do": "check", "note": "F/D の既定の HDG HOLD", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "switch", "note": "A/T ARM（空中の初期化は A/T を入れない）", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/T SPD（速さを保つ）", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "翼が水平（±3°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3], "timeout": 30, "stop": true },
    { "do": "record_start" },

    { "do": "mark", "note": "A/P を外して F/D L だけ" },
    { "do": "cmd", "note": "操縦輪の A/P 解除", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "2 回目で AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/P は外れた", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0, "stop": true },
    { "do": "check", "note": "F/D のモードは残る（HDG HOLD）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "remember", "dref": "sim/flightmodel/position/mag_psi", "as": "hdg0" },
    { "do": "set", "note": "MCP 方位を 60° 左", "dref": "laminar/B747/autopilot/heading/degrees", "value": -60, "rel": "hdg0", "round": 1 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6, "stop": true },
    { "do": "sleep", "seconds": 15, "note": "だれもバーを追わない" },
    { "do": "snapshot", "note": "CMD L の前", "drefs": ["laminar/B747/autopilot/roll_cmd", "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "sim/flightmodel/position/mag_psi", "laminar/B747/autopilot/heading/degrees", "laminar/B747/gauges/indicators/airspeed_kts_pilot"] },
    { "do": "check", "note": "F/D のロールの指令はバンクの制限の近く（左へ 20° より深い）", "dref": "laminar/B747/autopilot/roll_cmd", "op": "<", "value": -20 },
    { "do": "check", "note": "翼はまだ水平に近い（±8°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-8, 8], "stop": true },

    { "do": "mark", "note": "CMD L：指令は今のバンクから（ATA22 p.348）" },
    { "do": "cmd", "note": "CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "watch", "note": "入れた後 10 秒のロールの角速度が 3.5°/s 以下（指令は 3°/s。直す前はサーボいっぱい）", "dref": "sim/flightmodel/position/P", "abs": true, "max": 3.5, "timeout": 10 },
    { "do": "check", "note": "A/P が入っている", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "入れた 10 秒後", "drefs": ["laminar/B747/autopilot/roll_cmd", "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "sim/flightmodel/position/mag_psi"] },
    { "do": "check", "note": "左へ旋回している（バンク −15° より深い）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "<", "value": -15 },
    { "do": "wait", "note": "MCP 方位の近く（±5°）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [-65, -55], "rel": "hdg0", "timeout": 90 },
    { "do": "record_stop" }
  ]
}
