{
  "name": "s181_datalink_keys",
  "description": "6-1・6-2 段 12a（FMC のデータリンクの有無）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体（109）では、ATC と FMC COMM のキーは KEY/FUNCTION INOP（FCOM p.1211、p.725）。SIM CONFIG の 2 ページ目（MENU の 6R、NEXT）の 4L で FMC DATALINK を AUTO から ON にすると、ATC で ATC のページ（ATC COMM が無いので LOGON/STATUS：段 12e）。4L をあと 2 回押して AUTO に戻す（保存はしない）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "check", "note": "P&W の機体（109）", "dref": "laminar/B747/engines/type", "op": "==", "value": 0 },
    { "do": "cdu", "note": "ATC キー", "keys": ["ATC"] },
    { "do": "check", "note": "KEY/FUNCTION INOP（FCOM p.1211）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "KEY/FUNCTION INOP" },
    { "do": "check", "note": "ページはそのまま（IDENT）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "IDENT" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_atc_inop" },
    { "do": "cdu", "note": "CLR、FMC COMM キー", "keys": ["CLR", "FMCCOMM"] },
    { "do": "check", "note": "KEY/FUNCTION INOP", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "KEY/FUNCTION INOP" },
    { "do": "cdu", "note": "CLR、MENU、6R の SIM CONFIG、NEXT（2 ページ目）", "keys": ["CLR", "MENU", "R6", "NEXT"] },
    { "do": "check", "note": "4L は AUTO", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "check", "note": "小字は INOP（109）", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "INOP" },
    { "do": "shot", "name": "cdu_simconfig_auto" },
    { "do": "cdu", "note": "4L で ON", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "4L は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "check", "note": "小字は ACTIVE", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "ACTIVE" },
    { "do": "check", "note": "simconfig の fmc_datalink は ON", "dref": "laminar/B747/simconfig", "op": "contains", "value": "\"fmc_datalink\":\"ON\"" },
    { "do": "shot", "name": "cdu_simconfig_on" },
    { "do": "cdu", "note": "ATC キー", "keys": ["ATC"] },
    { "do": "check", "note": "ATC のページ（ATC COMM が無いので LOGON/STATUS：段 12e、FMSPG p.277）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC LOGON/STATUS" },
    { "do": "shot", "name": "cdu_atc_index" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
