{
  "name": "s186_vnav_wpts_des",
  "description": "6-1・6-2 段 12b2（VNAV のページの点）の X-Plane での確認、巡航。s183 と同じ FL300・約 290 kt で、ATMUG の約 30 NM 西（T/D の手前）から東へ空中開始（機体を読み直す）。s140 と同じ経路（STAR ATMUGA、ILS06LY）と PERF INIT、MCP 10,000 ft で VNAV。DES のページの E/D AT は ILS06L の滑走路（閾値の 50 ft 上）、AT XXXXX は T/D の後の次の制限（FCOM p.1392。前は X-Plane の FMS の脚と前の AP の E/D から、箱が出ていた）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 133.52, "elevation_in_meters": 9144, "heading_true": 97, "speed_in_meters_per_second": 225 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "snapshot", "note": "空中開始の後のエンジン・電源・IRU・F/D（2026-11-01 の 1 回目で A/P が入らず、右の CDU が消えていた）", "drefs": [ "sim/flightmodel/engine/ENGN_running", "sim/cockpit2/engine/indicators/N1_percent", "laminar/B747/electrical/bus/ac", "laminar/B747/electrical/display_has_power", "laminar/B747/irs/hdg_valid", "laminar/B747/toggle_switch/position[23]", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC は巡航（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "cdu", "note": "VNAV キー：有効な CRZ のページ", "keys": ["VNAV"] },
    { "do": "check", "note": "ACT ... CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "ACT .*CRZ" },
    { "do": "cdu", "cdu": "fms2", "note": "右の CDU：MENU、<FMC、VNAV、PREV（CLB：有効でない）", "keys": ["MENU", "L1", "VNAV", "PREV"] },
    { "do": "check", "note": "右の CDU は CLB", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "CLB" },
    { "do": "cdu", "note": "左の CDU：NEXT（DES のページ）", "keys": ["NEXT"] },
    { "do": "check", "note": "DES のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "DES" },
    { "do": "check", "note": "E/D AT（FCOM p.1392）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "E/D AT" },
    { "do": "check", "note": "E/D は ILS06L の滑走路（閾値の 50 ft 上：FCOM p.1258）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RW06L" },
    { "do": "check", "note": "AT XXXXX：T/D の後の次の制限（p.1392）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "AT " },
    { "do": "check", "note": "制限の表示（前は箱）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "/[ 0-9F]" },
    { "do": "snapshot", "note": "DES のページの 1 行目と予測", "drefs": [ "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms/vnav/phase" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_des_ed_at" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
