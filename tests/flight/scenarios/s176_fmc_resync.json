{
  "name": "s176_fmc_resync",
  "description": "6-1/6-2 段 11d3（FMC の再同期）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、XAC へ DIRECT、LNAV と VNAV（MCP 36,000 ft の上昇）と A/T。master の左 FMC が内部の試験に落ちる（fail[0] = 2）と、左の CDU は表示が止まってキーが効かず、右の CDU に RESYNCING OTHER FMC、LNAV・VNAV はモード故障、A/T は切れる（FCOM p.1277、p.1434、ATA34_2 p.632–633）。15 秒で戻り、LNAV・VNAV はそのまま、左の CDU のキーも効く。A/T は ARM スイッチの入れ直しで戻る。次に右 FMC の再同期が失敗する（fail[1] = 3）と、左の CDU に RESYNCING OTHER FMC、30 秒で FMC RIGHT、35 秒で右の CDU が MENU と TIMEOUT - RESELECT、左に RESYNC FAIL - SINGLE FMC（FCOM p.1433、ATA34_2 p.633）。PFD と CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "LEGS で XAC へ DIRECT TO、EXEC", "keys": ["LEGS", "XAC", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "set", "note": "MCP 高度 36,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 36000 },
    { "do": "sleep", "seconds": 3 },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV で engage", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 20 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "A/T は engage", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 1 },
    { "do": "cdu", "note": "左の CDU を LEGS に", "keys": ["CLR", "CLR", "LEGS"] },
    { "do": "check", "note": "左の CDU は LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "LEGS" },

    { "do": "mark", "note": "master（左）の内部の試験の失敗と再同期" },
    { "do": "set", "note": "左 FMC が内部の試験に落ちる", "dref": "laminar/B747/fms/fail[0]", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "左 FMC の出力が止まる（ATA34_2 p.632）", "dref": "laminar/B747/fms/fmc_ok[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "左の CDU はつながったまま", "dref": "laminar/B747/fms/cdu_link[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "右の CDU に RESYNCING OTHER FMC（FCOM p.1434）", "dref": "laminar/B747/fms2/Line14_L", "op": "contains", "value": "RESYNCING OTHER FMC" },
    { "do": "check", "note": "右の CDU は切れない", "dref": "laminar/B747/fms/cdu_link[2]", "op": "==", "value": 2 },
    { "do": "check", "note": "LNAV のモード故障（ATA34_2 p.633）", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "VNAV のモード故障", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "A/T は切れる", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 0 },
    { "do": "cmd", "note": "左の CDU で RTE（表示が止まりキーは効かない：FCOM p.1277）", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "左の CDU は LEGS のまま", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "LEGS" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_master_resync" },
    { "do": "wait", "note": "15 秒で戻る（FCOM p.1277）", "dref": "laminar/B747/fms/fmc_ok[0]", "op": "==", "value": 1, "timeout": 20 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV は戻る", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "VNAV も", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "VNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "matches", "value": "^[456]" },
    { "do": "check", "note": "RESYNCING OTHER FMC は消える", "dref": "laminar/B747/fms2/Line14_L", "op": "matches", "value": "^(?!RESYNCING)" },
    { "do": "check", "note": "A/T は切れたまま", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 0 },
    { "do": "cmd", "note": "左の CDU で RTE", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "左の CDU のキーが効く", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RTE" },
    { "do": "cmd", "note": "A/T の ARM スイッチを切る", "name": "laminar/B747/toggle_switch/autothrottle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "入れる", "name": "laminar/B747/toggle_switch/autothrottle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/T が戻る", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 1 },
    { "do": "shot", "name": "pfd_after_resync" },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[0]", "value": 0 },

    { "do": "mark", "note": "右 FMC の再同期の失敗" },
    { "do": "set", "note": "右 FMC の再同期が失敗する", "dref": "laminar/B747/fms/fail[1]", "value": 3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "左の CDU に RESYNCING OTHER FMC", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "RESYNCING OTHER FMC" },
    { "do": "check", "note": "AFDS は master（左）なのでそのまま", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 0 },
    { "do": "wait", "note": "30 秒で FMC RIGHT（LH3460 p.116）", "dref": "laminar/B747/CAS/advisory_status[146]", "op": "==", "value": 1, "timeout": 40 },
    { "do": "wait", "note": "35 秒で右の CDU に TIMEOUT - RESELECT（ATA34_2 p.633）", "dref": "laminar/B747/fms2/Line14_L", "op": "contains", "value": "TIMEOUT - RESELECT", "timeout": 10 },
    { "do": "check", "note": "右の CDU は MENU", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "check", "note": "左の CDU に RESYNC FAIL - SINGLE FMC（FCOM p.1433）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "RESYNC FAIL - SINGLE FMC" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_resync_fail" },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[1]", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
