{
  "name": "s284_ge_level_off_from_idle",
  "description": "GE（Saudia、CF6-80C2B1F）の FLCH の降下から ALT の捕捉で A/T SPD に戻るときの推力（2026-11-11：Opus のレビューの EEC-2 の直しの確かめ。推力 0 の近くの制御の傾きを 2〜3 kN の傾きにした：notes/ATA-70-80.md §20）。s280 と同じ所の空中開始（FL250・290 kt・238 t・ISA の静穏な大気、東向き）。4,000 ft の FLCH の降下は A/T の THR が降下率を抑え、推力は 1 発 2〜12 kN（アイドルの近く）。記録の CSV で、捕捉の後の推力・N1 の行き過ぎと速さのずれを見る（2026-11-11：4.8 kN から 41.1 kN へ 90 % が 30 秒、速さ −4.5〜+1.0 kt）",
  "reload": true,
  "livery": "Saudia",
  "flight": {
    "lle_air_start": { "latitude": 35.4, "longitude": 141.3, "elevation_in_meters": 7620, "heading_true": 90, "speed_in_meters_per_second": 215 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weight": {
      "payload_weight_in_kilograms": [ 3901.4, 4106.8, 4928.1, 6365.5, 1232, 10287.5, 9178.6, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 3750, 3750, 3750, 3750, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": {
        "latitude_in_degrees": 35.4, "longitude_in_degrees": 141.3, "elevation_in_meters": 0,
        "visibility_in_kilometers": 40, "temperature_in_degrees_celsius": 15, "altimeter_setting_in_hpa": 1013.25,
        "precipitation_ratio": 0, "clouds": [],
        "wind": [
          { "altitude_in_feet_msl": 0, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0 },
          { "altitude_in_feet_msl": 10000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0 },
          { "altitude_in_feet_msl": 20000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0 },
          { "altitude_in_feet_msl": 30000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0 },
          { "altitude_in_feet_msl": 38000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0 },
          { "altitude_in_feet_msl": 46000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0 }
        ]
      },
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMC の空中の初期化" },
    { "do": "wait", "note": "FMC の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 8 },
    { "do": "set", "note": "MCP 高度 FL250", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 25000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 25000 },
    { "do": "set", "note": "MCP を IAS に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 0 },
    { "do": "set", "note": "窓 290 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 290 },
    { "do": "set", "note": "MCP 方位 098（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 98 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "switch", "note": "ALT（違えば押す）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "value": 9, "cmd": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "FMA の A/T が SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3, "timeout": 10, "level": "warn" },
    { "do": "wait", "note": "速さが 290 kt の近く", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [286, 294], "timeout": 300, "level": "warn" },
    { "do": "sleep", "seconds": 150, "note": "落ち着かせる（空中開始の後の高度の揺れ：2 分ほど）" },
    { "do": "record_start" },
    { "do": "check", "note": "GE", "dref": "laminar/B747/engines/type", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "FL250 の水平の推力", "drefs": [ "laminar/B747/engines/display_N1[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },

    { "do": "mark", "note": "FLCH で FL210 へ（A/T の THR、推力はアイドルの近く）" },
    { "do": "set", "note": "MCP 高度 FL210", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 21000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 21000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FMA は FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8, "timeout": 5 },
    { "do": "wait", "note": "降下（FL240 を下へ）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 24000, "timeout": 120 },
    { "do": "snapshot", "note": "降下の推力（推力 0 の近く）", "drefs": [ "laminar/B747/engines/display_N1[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/flightmodel/engine/ENGN_thro_use[0]", "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot" ] },
    { "do": "wait", "note": "FL210 の捕捉で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 300 },
    { "do": "mark", "note": "ALT：A/T SPD でアイドルから水平の推力へ" },
    { "do": "wait", "note": "A/T SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3, "timeout": 10 },
    { "do": "watch", "note": "推力が水平の値に落ち着くまでの速さ（±10 kt の内：推定。行き過ぎれば速く、遅れれば遅くなる。レビューの担当の代わりの模型では 16〜20 秒で 90 %）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "min": 280, "max": 300, "timeout": 90 },
    { "do": "snapshot", "note": "FL210 の水平の推力", "drefs": [ "laminar/B747/engines/display_N1[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/flightmodel/engine/ENGN_thro_use[0]", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "check", "note": "速さは 290 kt の近く（A/T SPD）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [284, 296] },
    { "do": "check", "note": "FL210 で水平（±200 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [20800, 21200] },
    { "do": "check", "note": "推力は水平の値（アイドルではない：推定 20 kN より上）", "dref": "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "op": ">", "value": 20000 },
    { "do": "sleep", "seconds": 30 },
    { "do": "record_stop" }
  ]
}
