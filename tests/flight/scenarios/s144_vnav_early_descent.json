{
  "name": "s144_vnav_early_descent",
  "description": "6-1/6-2 段 9d2a（早期降下）の X-Plane での確認。s140 と同じ経路・LNAV・ZFW 200・CI 100・FL300 で、その始めより約 70 NM 西（T/D の約 97 NM 手前。2026-11-03 から 60 NM 下げ（FL300 に戻るのに 240 秒を超えた回があり、待ちを 420 秒に）、T/D まで 45 NM の内になるのを待って押す：前は約 40 NM 手前からで、FL300 に戻るのに 205 秒かかった回は T/D の約 9 NM 手前で押し、30 秒で経路に当たった）から東へ空中開始（機体を読み直す）。MCP 高度 FL300（巡航高度）で VNAV PTH の巡航にしてから、MCP を 10,000 ft にしてノブを押す：T/D の 50 NM の内なので早期降下（FCOM p.649、p.1260、p.1389）。FMC は降下段階（3）、VNAV SPD、A/T は THR から約 1,250 fpm で HOLD（FMSPG p.3.5-5）、CRZ ALT は FL300 のまま、DES のページが ACT。経路が下がってきて機体に当たると VNAV PTH（FCOM p.665）。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.822, "longitude": 131.512, "elevation_in_meters": 9144, "heading_true": 97, "speed_in_meters_per_second": 250 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 FL300（巡航高度。空中開始の MCP は既定の 10,000 ft なので、経路と CRZ ALT の前に）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 30000 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage（巡航）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "check", "note": "FMC は巡航（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "cdu", "note": "VNAV のページ（空中では有効な CRZ のページ：ATA34_2 p.552）", "keys": ["VNAV"] },
    { "do": "snapshot", "note": "CRZ のページの TO T/D（2R）", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/vnav/dist", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "check", "note": "CRZ のページが ACT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT" },
    { "do": "wait", "note": "FL300 に戻る（空中開始の後は 1,000〜2,000 ft 上がり、VNAV PTH が戻す。2026-11-02 から 290 kt の上では経路の則のゲインが低く、約 250 fpm で 200 秒ほど）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [29850, 30150], "timeout": 420 },
    { "do": "wait", "note": "水平の巡航（戻る降下の途中で押すと、ピッチが速さを取る間に V/S が率を一瞬で通る：s144・s145 の初めの版は、そこで HOLD になり巡航の推力のまま上がった）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-300, 300], "timeout": 120 },
    { "do": "wait", "note": "巡航の速さの近く（空中開始の揺れで上がって遅くなるのを A/T の SPD が戻す。THR は速さを目標へ取る間も推力を合わせるが、その分だけ長くかかる）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": ">=", "value": 285, "timeout": 180 },
    { "do": "wait", "note": "T/D まで 20 NM の内（CRZ のページの TO T/D、2R）：押してから 30 秒より長く経路の下を降りる（2026-11-03 の 2 回目の再試験は 45 NM の内で押し、T/D で経路の下 3,000 ft を超え、経路が約 740 fpm で追いつくのに約 16 分：後の 600 秒の待ちに入らなかった。元の版は 40 NM 手前の空中開始から FL300 に戻る間に進み、押したのは T/D の 10 NM 前後）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "/ *([0-9]|1[0-9]|20)NM *$", "timeout": 900 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 3, "note": "MCP の高度が中へ写るのを待つ" },
    { "do": "check", "note": "押す前は巡航（2）のまま（T/D の手前：段 9d2a から）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "cmd", "note": "高度のノブを押す（T/D の 50 NM の内）", "name": "laminar/B747/button_switch/press_altitude" },
    { "do": "wait", "note": "早期降下：FMC は降下（3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 5 },
    { "do": "wait", "note": "VNAV SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 5 },
    { "do": "check", "note": "A/T は THR（4）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "CRZ ALT は FL300 のまま", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 30000 },
    { "do": "cdu", "note": "VNAV のページ（有効な DES のページ）", "keys": ["VNAV"] },
    { "do": "check", "note": "DES のページが ACT", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "ACT .*DES" },
    { "do": "wait", "note": "約 1,250 fpm で降下の速さに落ち着くと A/T は HOLD（FMSPG p.3.5-5：落ち着きの 5 秒と速さの 5 kt は推定）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 1, "timeout": 180 },
    { "do": "snapshot", "note": "HOLD の時", "drefs": [ "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach" ] },
    { "do": "check", "note": "1,250 fpm の近くで降りている（HOLD は慣性の V/S が率の 100 fpm、速さが目標の 5 kt の内に 5 秒とどまってから：推定）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-1600, -900] },
    { "do": "sleep", "seconds": 30 },
    { "do": "check", "note": "30 秒後も VNAV SPD・HOLD（経路の下）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "HOLD の 30 秒後も 1,250 fpm の近く（レバーはそのまま）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-1800, -800] },
    { "do": "snapshot", "note": "30 秒後", "drefs": [ "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/vnav/path_dev" ] },
    { "do": "wait", "note": "経路が下がってきて当たると VNAV PTH（FCOM p.665）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 600 },
    { "do": "snapshot", "note": "経路に当たった時", "drefs": [ "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/at", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/vnav/dist" ] },
    { "do": "check", "note": "FMC の A/T は IDLE（2）か SPD（3）", "dref": "laminar/B747/fms/vnav/at", "op": "in", "value": [2, 3] },
    { "do": "sleep", "seconds": 90, "note": "経路に乗る（1,250 fpm から経路の V/S へ移る間は経路の上に出る）" },
    { "do": "check", "note": "経路からの偏差は ±400 ft の中", "dref": "laminar/B747/fms/vnav/path_dev", "op": "between", "value": [-400, 400] },
    { "do": "check", "note": "VNAV PTH のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "A/T は HOLD・IDLE・SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "between", "value": [1, 3] },
    { "do": "set", "note": "（2026-11-13、フルレビューの DSP-1）機長の ND は MAP・160 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 4 },
    { "do": "set", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "高度到達の弧", "drefs": [ "laminar/B747/nd/toc/capt_active", "laminar/B747/nd/toc/distance/capt", "sim/cockpit2/autopilot/vvi_dial_fpm", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode", "sim/flightmodel2/position/groundspeed" ] },
    { "do": "check", "note": "VNAV PTH の降下で、ND の高度到達の弧が出る（FCOM p.1148。前は V/S の窓の 0 で計算し出なかった：DSP-1）", "dref": "laminar/B747/nd/toc/capt_active", "op": "==", "value": 1 },
    { "do": "record_stop" }
  ]
}
