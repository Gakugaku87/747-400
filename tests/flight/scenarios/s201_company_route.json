{
  "name": "s201_company_route",
  "description": "6-1・6-2 段 12h1（会社のデータリンク：経路の要求とアップリンク）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。tests/flight/data/simbrief の .fms（RJAA 34L、XAC、ATMUG、STAR ATMUGA、I06LZ の ATVID）と OFP（JAL123）を機体フォルダの simbrief に写し、ネイティブのプラグイン（b747_fms_bridge）がその最新のファイルを見つけることを確かめる。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO へ、保存はしない）。FMC COMM 1/2・2/2、RTE REQUEST <SEND の SENDING と SENT、約 20 秒後のアップリンク（UPLINK、FLT NO JAL123）、RTE 1 の ROUTE UPLINK と <LOAD・PURGE>、LOAD の後の経路（RJAA・RJBB・RW34L・CO ROUTE RJAARJBB01、XAC・ATMUG・ATMUGA）、ACTIVATE と EXEC。CDU を撮る。最後に写したファイルを消す。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "copy", "note": "SimBrief の .fms を simbrief へ", "from": "tests/flight/data/simbrief/RJAARJBB01.fms", "to": "simbrief/RJAARJBB01.fms" },
    { "do": "copy", "note": "OFP の XML を simbrief へ", "from": "tests/flight/data/simbrief/ofp_rjaa_rjbb.xml", "to": "simbrief/ofp_rjaa_rjbb.xml" },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "ネイティブのプラグインが最新の .fms を見つける（2 秒ごと）", "dref": "laminar/B747/fms/company/fms_file", "op": "contains", "value": "RJAARJBB01.fms" },
    { "do": "check", "note": "最新の .xml", "dref": "laminar/B747/fms/company/ofp_file", "op": "contains", "value": "ofp_rjaa_rjbb.xml" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "FMC COMM キー", "keys": ["FMCCOMM"] },
    { "do": "check", "note": "FMC COMM 1/2", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "FMC COMM" },
    { "do": "check", "note": "<RTE 1 と POS REPORT>（FMSPG p.368）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<RTE 1       POS REPORT>" },
    { "do": "check", "note": "DATA LINK READY（シムの会社：AutoATC が無くても）", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "READY" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_fmc_comm_1" },
    { "do": "cdu", "note": "NEXT（2/2）", "keys": ["NEXT"] },
    { "do": "check", "note": "RTE REQUEST と CO ROUTE（FCOM p.773）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "RTE REQUEST    CO ROUTE" },
    { "do": "check", "note": "<SEND と CO ROUTE のダッシュ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<SEND         ----------" },
    { "do": "shot", "name": "cdu_fmc_comm_2" },
    { "do": "cdu", "note": "RTE REQUEST <SEND", "keys": ["L1"] },
    { "do": "check", "note": "SENDING", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SENDING" },
    { "do": "wait", "note": "網の受け取りで SENT（小さい字）", "dref": "laminar/B747/fms3/Line03_S", "op": "contains", "value": "SENT", "timeout": 15 },
    { "do": "wait", "note": "約 20 秒後にアップリンク：RTE REQUEST は空白に（FMSPG p.382）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ +CO ROUTE$", "timeout": 40 },
    { "do": "cdu", "note": "PREV（1/2）", "keys": ["PREV"] },
    { "do": "check", "note": "<RTE 1 の上に UPLINK（FMSPG p.368）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "UPLINK" },
    { "do": "shot", "name": "cdu_fmc_comm_uplink" },
    { "do": "cdu", "note": "<RTE 1", "keys": ["L1"] },
    { "do": "check", "note": "ROUTE UPLINK（FCOM p.1291）", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "ROUTE UPLINK" },
    { "do": "check", "note": "<LOAD と PURGE>", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "<LOAD             PURGE>" },
    { "do": "check", "note": "FLT NO は OFP の便名（FCOM p.1433 の FLT NUMBER UPLINK）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "JAL123" },
    { "do": "shot", "name": "cdu_rte_uplink" },
    { "do": "cdu", "note": "<LOAD", "keys": ["L4"] },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "ORIGIN と DEST", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RJAA                RJBB" },
    { "do": "check", "note": "RUNWAY", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "RW34L" },
    { "do": "check", "note": "CO ROUTE は .fms の名前", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "RJAARJBB01" },
    { "do": "check", "note": "ACTIVATE> が戻る", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "ACTIVATE>" },
    { "do": "shot", "name": "cdu_rte_loaded" },
    { "do": "cdu", "note": "NEXT（経路の 2 ページ目）", "keys": ["NEXT"] },
    { "do": "check", "note": "DIRECT XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "DIRECT               XAC" },
    { "do": "check", "note": "STAR ATMUGA で ATVID（ATMUG から始まる STAR が DIRECT ATMUG に続く）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "ATMUGA             ATVID" },
    { "do": "check", "note": "進入の遷移 ATVID で MIBIB（不連続なし）", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "ATVID              MIBIB" },
    { "do": "check", "note": "ILS06LZ", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "ILS06LZ" },
    { "do": "shot", "name": "cdu_rte_loaded_2" },
    { "do": "cdu", "note": "PREV、ACTIVATE、EXEC", "keys": ["PREV", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "remove", "note": "写したファイルを消す", "path": "simbrief/RJAARJBB01.fms" },
    { "do": "remove", "path": "simbrief/ofp_rjaa_rjbb.xml" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
