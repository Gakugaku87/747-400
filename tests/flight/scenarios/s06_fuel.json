{
  "name": "s06_fuel",
  "description": "燃料（2-2）の X-Plane での確認。エンジン運転中の地上で開始し、中央タンク（CWT）に 20 t を入れて CWT から 4 発へ供給（synoptic の流れ、O/J 2・3 は止まる）、CTR L を OFF（CWT ポンプ 1 台は主ポンプ 2 台に勝てない、>FUEL OVD CTR L）、主 1 のポンプ 2 台と X FEED 1 を OFF（吸引供給、FUEL PRESS ENG 1、エンジンは止まらない、X FEED の VALVE 灯は移動中だけ）、最後に FUEL CONTROL 4 を CUTOFF（spar valve 閉でエンジン 4 停止）。頭上の灯と FUEL synoptic を画像で見る。期待値は FCOM 12.10-12.30（notes/ATA-28.md）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/flightmodel/weight/m_fuel_total",
      "sim/flightmodel/weight/m_fuel[0]", "sim/flightmodel/weight/m_fuel[1]", "sim/flightmodel/weight/m_fuel[2]",
      "sim/flightmodel/weight/m_fuel[3]", "sim/flightmodel/weight/m_fuel[4]", "sim/flightmodel/weight/m_fuel[5]",
      "sim/flightmodel/weight/m_fuel[6]", "sim/flightmodel/weight/m_fuel[7]",
      "sim/flightmodel2/engines/has_fuel_flow_before_mixture[0]", "sim/flightmodel2/engines/has_fuel_flow_before_mixture[3]",
      "laminar/B747/fuel/engine1_status", "laminar/B747/fuel/engine4_status",
      "laminar/B747/fuel/main1_tank/main_pump_fwd_on", "laminar/B747/fuel/center_tank/ovrd_jett_pump_L_on",
      "laminar/B747/fuel/main2_tank/ovrd_jett_pump_fwd_on", "laminar/B747/fuel/spar_vlv1_pos",
      "laminar/B747/fuel/engine2/xfeed_vlv_pos", "laminar/B747/fuel/totaliser[4]",
      "sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0]", "sim/operation/override/override_fuel_system" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "燃料系はプラグインが受け持つ", "dref": "sim/operation/override/override_fuel_system", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 1 に燃料", "dref": "sim/flightmodel2/engines/has_fuel_flow_before_mixture[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 4 に燃料", "dref": "sim/flightmodel2/engines/has_fuel_flow_before_mixture[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "spar valve 1 開（FUEL CONTROL RUN）", "dref": "laminar/B747/fuel/spar_vlv1_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "主 1 FWD ポンプが回る（エンジン運転中の開始でスイッチ ON）", "dref": "laminar/B747/fuel/main1_tank/main_pump_fwd_on", "op": "==", "value": 1 },
    { "do": "check", "note": "MAIN 1 FWD の PRESS 灯 消灯（FCOM p.1439）", "dref": "laminar/B747/annunciator/brightness_ratio[48]", "op": "==", "value": 0 },

    { "do": "mark", "note": "CWT に 20 t（重量の画面で入れたのと同じ）" },
    { "do": "set", "dref": "sim/flightmodel/weight/m_fuel[0]", "value": 20000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "外から入れた量を燃料系が引き継ぐ（書き戻さない）", "dref": "sim/flightmodel/weight/m_fuel[0]", "op": ">", "value": 19900 },
    { "do": "wait", "note": "CWT ポンプ 2 台の圧で、エンジン 1 は xfeed マニフォールドから（synoptic 2。FCOM p.1454）", "dref": "laminar/B747/fuel/engine1_status", "op": "==", "value": 2, "timeout": 5 },
    { "do": "check", "note": "エンジン 4 もマニフォールドから", "dref": "laminar/B747/fuel/engine4_status", "op": "==", "value": 2 },
    { "do": "check", "note": "O/J 2 FWD は CWT ポンプ 2 台の圧があると動かない（FCOM p.1467）", "dref": "laminar/B747/fuel/main2_tank/ovrd_jett_pump_fwd_on", "op": "==", "value": 0 },
    { "do": "wait", "note": "FUEL PRESS CTR L が消える", "dref": "laminar/B747/CAS/caution_status[69]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "check", "note": "CTR L の PRESS 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[44]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "CWT から減る（主 1 は減らない）", "dref": "sim/flightmodel/weight/m_fuel[0]", "op": "<", "value": 20000 },
    { "do": "cmd", "note": "FUEL synoptic", "name": "laminar/B747/dsp/fuel_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "fuel_synoptic_ctr" },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_ctr" },
    { "do": "cas", "note": "CWT から供給" },

    { "do": "mark", "note": "CTR L OFF" },
    { "do": "switch", "note": "CTR L OFF", "dref": "laminar/B747/button_switch/position[52]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_ctr_wing_tnk_pump_L" },
    { "do": "wait", "note": "CWT ポンプ 1 台は主ポンプ 2 台に勝てない：エンジン 1 は自タンク（FCOM p.1454）", "dref": "laminar/B747/fuel/engine1_status", "op": "==", "value": 1, "timeout": 5 },
    { "do": "wait", "note": ">FUEL OVD CTR L（地上で CWT 7,700 kg 以上、スイッチ OFF。FCOM p.1474）", "dref": "laminar/B747/CAS/advisory_status[153]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "O/J 2 は動かない（CTR R のスイッチ ON で圧あり）", "dref": "laminar/B747/fuel/main2_tank/ovrd_jett_pump_fwd_on", "op": "==", "value": 0 },
    { "do": "switch", "note": "CTR L ON", "dref": "laminar/B747/button_switch/position[52]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_ctr_wing_tnk_pump_L" },
    { "do": "wait", "note": "エンジン 1 はマニフォールドに戻る", "dref": "laminar/B747/fuel/engine1_status", "op": "==", "value": 2, "timeout": 5 },

    { "do": "mark", "note": "主 1 のポンプ 2 台と X FEED 1 を OFF（吸引供給）" },
    { "do": "switch", "note": "X FEED 1 OFF", "dref": "laminar/B747/button_switch/position[48]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "wait", "note": "移動中は X FEED 1 の VALVE 灯（FCOM p.1440）", "dref": "laminar/B747/annunciator/brightness_ratio[40]", "op": ">", "value": 0, "timeout": 1.5 },
    { "do": "wait", "note": "X FEED 1 閉（3-5 s。ATA26_28 p.464）", "dref": "laminar/B747/fuel/engine1/xfeed_vlv_pos", "op": "==", "value": 0, "timeout": 8 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "閉じ終わると VALVE 灯 消灯", "dref": "laminar/B747/annunciator/brightness_ratio[40]", "op": "==", "value": 0 },
    { "do": "switch", "note": "MAIN 1 FWD OFF", "dref": "laminar/B747/button_switch/position[56]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_1" },
    { "do": "switch", "note": "MAIN 1 AFT OFF", "dref": "laminar/B747/button_switch/position[60]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_1" },
    { "do": "wait", "note": "FUEL PRESS ENG 1（吸引供給。FCOM p.1477）", "dref": "laminar/B747/CAS/caution_status[32]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "エンジン 1 は燃料を吸い続ける（FCOM p.1455）", "dref": "sim/flightmodel2/engines/has_fuel_flow_before_mixture[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "synoptic：エンジン 1 は自タンクから", "dref": "laminar/B747/fuel/engine1_status", "op": "==", "value": 1 },
    { "do": "check", "note": "MAIN 1 FWD の PRESS 灯", "dref": "laminar/B747/annunciator/brightness_ratio[48]", "op": ">", "value": 0 },
    { "do": "check", "note": "FUEL PUMP 1 FWD は FUEL PRESS ENG 1 で抑止（FCOM p.1477）", "dref": "laminar/B747/CAS/advisory_status[165]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "エンジン 1 は回り続ける", "dref": "sim/flightmodel/engine/ENGN_running[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "overhead_suction" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_suction" },
    { "do": "cas", "note": "吸引供給" },
    { "do": "switch", "note": "MAIN 1 FWD ON", "dref": "laminar/B747/button_switch/position[56]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_1" },
    { "do": "switch", "note": "MAIN 1 AFT ON", "dref": "laminar/B747/button_switch/position[60]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_1" },
    { "do": "switch", "note": "X FEED 1 ON", "dref": "laminar/B747/button_switch/position[48]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "wait", "note": "FUEL PRESS ENG 1 が消える", "dref": "laminar/B747/CAS/caution_status[32]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "wait", "note": "X FEED 1 開", "dref": "laminar/B747/fuel/engine1/xfeed_vlv_pos", "op": "==", "value": 1, "timeout": 8 },
    { "do": "check", "note": "FUEL USED（4 発の流量の積算）が進む", "dref": "laminar/B747/fuel/totaliser[4]", "op": ">", "value": 0 },

    { "do": "mark", "note": "FUEL CONTROL 4 CUTOFF" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "spar valve 4 閉（ATA26_28 p.466）", "dref": "laminar/B747/fuel/spar_vlv4_pos", "op": "==", "value": 0, "timeout": 8 },
    { "do": "wait", "note": "エンジン 4 に燃料が行かない", "dref": "sim/flightmodel2/engines/has_fuel_flow_before_mixture[3]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "エンジン 4 停止", "dref": "sim/flightmodel/engine/ENGN_running[3]", "op": "==", "value": 0, "timeout": 40 },
    { "do": "check", "note": "エンジン 1 は回ったまま", "dref": "sim/flightmodel/engine/ENGN_running[0]", "op": "==", "value": 1 },
    { "do": "cas", "note": "エンジン 4 停止" }
  ]
}
