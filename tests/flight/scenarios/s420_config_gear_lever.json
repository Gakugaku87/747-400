{
  "name": "s420_config_gear_lever",
  "description": "段 4 のレビューの WARN-3（2026-11-24 の直し 31b0b859）と D の「レバーが原因の CONFIG GEAR」：推力レバーが原因の CONFIG GEAR の X-Plane での確かめ。成田 34L の南東の約 750 ft（RA 約 620 ft）で空中開始する（脚上げ、フラップ 10、A/P の ALT HOLD、A/T の SPD 180 kt、270 t）。次を見る。(1) A/T を外してレバー 1 を閉じると CONFIG GEAR と siren が出る（FCOM p.1557）。(2) master リセットで siren だけ止まる（FCOM p.1556）。(3) レバー 2 も閉じると新しい警報になり、siren と master WARNING がまた出る（ATA31 p.209、p.214）。(4) レバー 1 を閉じたまま V/S で RA 800 ft より上へ上がると消える（ATA31。前は残った）。(5) 脚を下ろすと出ない。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.52765, "longitude": 140.54647, "elevation_in_meters": 230, "heading_true": 329.6, "speed_in_meters_per_second": 92 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30, "stop": true },
    { "do": "wait", "note": "空中の初期化の ALT HOLD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 30 },
    { "do": "set", "note": "MCP 方位 337", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "set", "note": "MCP 速度 180 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 180 },
    { "do": "switch", "note": "A/T ARM（空中の初期化は A/T を入れない）", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/T の SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 150, "note": "フラップが 10 に着き、速さが落ち着く。空中開始から 150 秒より後に始める：警報のモデル（alert_model.lua）は空中開始を浮揚とみなし、浮揚後 140 秒（RA 800 ft 未満）は CONFIG GEAR を出さない（2026-11-24 の 1 回目は 40 秒で閉じて、メッセージも siren も出なかった。空中開始の直後だけの形なので直さない：2026-11-10 の利用者の決め）" },
    { "do": "record_start" },
    { "do": "snapshot", "note": "開始", "drefs": [ "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/gear/air_ground/all_gear_down", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/engine/throttle[0]", "laminar/B747/engine/throttle[1]", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "空中（PSEU）", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 0 },
    { "do": "check", "note": "脚上げ：ALL GR DN なし", "dref": "laminar/B747/gear/air_ground/all_gear_down", "op": "==", "value": 0 },
    { "do": "check", "note": "RA 800 ft 未満", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "between", "value": [400, 780] },
    { "do": "check", "note": "A/T の SPD でレバーは閉でない：CONFIG GEAR なし", "dref": "laminar/B747/CAS/warning_status[3]", "op": "==", "value": 0 },

    { "do": "mark", "note": "A/T を外してレバー 1 を閉じる" },
    { "do": "cmd", "note": "A/T を切る", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "cmd", "note": "もう一度押して AUTOTHROT DISC を消す", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "set", "note": "レバー 2〜4 は 0.6（手の推力）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[1]", "value": 0.6 },
    { "do": "set", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[2]", "value": 0.6 },
    { "do": "set", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[3]", "value": 0.6 },
    { "do": "set", "note": "レバー 1 を閉じる", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[0]", "value": 0 },
    { "do": "wait", "note": "CONFIG GEAR（FCOM p.1557：脚上げ、レバー閉、800 ft 未満）", "dref": "laminar/B747/CAS/warning_status[3]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "レバーだけが原因：1（N19-WARN-02）", "dref": "laminar/B747/flt_ctrls/config_gear_lever", "op": "==", "value": 1 },
    { "do": "check", "note": "siren", "dref": "laminar/B747/warning/warning_siren", "op": "==", "value": 1 },
    { "do": "cmd", "note": "master リセット", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },
    { "do": "wait", "note": "レバーが原因の siren はリセットで止まる（FCOM p.1556）", "dref": "laminar/B747/warning/warning_siren", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "メッセージは残る", "dref": "laminar/B747/CAS/warning_status[3]", "op": "==", "value": 1 },

    { "do": "mark", "note": "レバー 2 も閉じる" },
    { "do": "set", "note": "レバー 2 を閉じる", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[1]", "value": 0 },
    { "do": "wait", "note": "新しい警報：siren がまた鳴る（ATA31 p.209、p.214：WARN-3。前は鳴らなかった）", "dref": "laminar/B747/warning/warning_siren", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "master WARNING", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 1 },
    { "do": "check", "note": "レバーの数え：2", "dref": "laminar/B747/flt_ctrls/config_gear_lever", "op": "==", "value": 2 },
    { "do": "cas", "note": "CONFIG GEAR" },
    { "do": "view", "note": "主 EICAS", "the": -18, "psi": 29, "fov": 16 },
    { "do": "shot", "name": "eicas_config_gear_lever" },
    { "do": "view", "name": "forward" },
    { "do": "cmd", "note": "master リセット", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },

    { "do": "mark", "note": "レバー 1 を閉じたまま 800 ft より上へ" },
    { "do": "set", "note": "レバー 2〜4 を上昇推力（0.85）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[1]", "value": 0.85 },
    { "do": "set", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[2]", "value": 0.85 },
    { "do": "set", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[3]", "value": 0.85 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "レバー 1 だけ閉：CONFIG GEAR はまだ（800 ft 未満）", "dref": "laminar/B747/CAS/warning_status[3]", "op": "==", "value": 1 },
    { "do": "set", "note": "MCP 高度 1,500 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 1500 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 1500 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "set", "note": "V/S +800 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 800 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 800 },
    { "do": "wait", "note": "RA 800 ft を越える", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 830, "timeout": 90 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "レバー 1 は閉じたまま", "dref": "laminar/B747/engine/throttle[0]", "op": "<", "value": 0.05 },
    { "do": "check", "note": "800 ft より上：レバーが原因の CONFIG GEAR は消える（ATA31 p.209、p.214：WARN-3。前はレバーを進めるまで残った）", "dref": "laminar/B747/CAS/warning_status[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "数えも 0", "dref": "laminar/B747/flt_ctrls/config_gear_lever", "op": "==", "value": 0 },

    { "do": "mark", "note": "脚を下ろす" },
    { "do": "set", "note": "レバー 1 も上昇推力", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[0]", "value": 0.85 },
    { "do": "cmd", "note": "脚レバー DN", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "wait", "note": "全脚ダウンロック（PSEU の ALL GR DN）", "dref": "laminar/B747/gear/air_ground/all_gear_down", "op": "==", "value": 1, "timeout": 40 },
    { "do": "check", "note": "CONFIG GEAR は出ていない", "dref": "laminar/B747/CAS/warning_status[3]", "op": "==", "value": 0 },
    { "do": "record_stop" }
  ]
}
