{
  "name": "s254_nd_plan_circles",
  "description": "ND の PLAN の絵（2026-11-05、notes/ATA-31.md §46）の X-Plane での確認、PW（109：FCOM p.1028）。成田 34L でエンジン運転中（機体を読み直す）。RTE RJAA→RJBB を XAC・SPENS・BOKJO で ACTIVATE と EXEC。機長の ND を PLN の 80 NM、F/O を PLN の 160 NM：方位の目盛も枠も無く、画面の中央を中心に 2 つの距離の円（外が選んだ距離、内が半分）と数字、W・E・S と緑の N↑（上の中央）、中心の地点と経路は真北が上（CTR を入れていなくても）。LEGS の STEP で中心の地点を進める。CTR を入れても PLN は同じ。MAP に戻すと拡大のまま。両方の ND を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "PW（engines/type 0）", "dref": "laminar/B747/engines/type", "op": "==", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },
    { "do": "set", "note": "MAP CTR を外す（機長）", "dref": "laminar/B747/nd/map_center/capt", "value": 0 },
    { "do": "set", "note": "MAP CTR を外す（F/O）", "dref": "laminar/B747/nd/map_center/fo", "value": 0 },
    { "do": "set", "note": "機長の範囲 80 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 3 },
    { "do": "set", "note": "F/O の範囲 160 NM", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 4 },
    { "do": "set", "note": "機長の ND を PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3 },
    { "do": "set", "note": "F/O の ND を PLN", "dref": "laminar/B747/nd/mode/fo/sel_dial_pos", "value": 3 },
    { "do": "sleep", "seconds": 2 },

    { "do": "mark", "note": "PLN の距離の円（FCOM p.1028）" },
    { "do": "check", "note": "機長：円の絵", "dref": "laminar/B747/nd/capt/pln_style", "op": "==", "value": 1 },
    { "do": "check", "note": "CTR を入れていなくても中央", "dref": "laminar/B747/nd/capt/centred", "op": "==", "value": 1 },
    { "do": "check", "note": "枠なし", "dref": "laminar/B747/nd/capt/box", "op": "==", "value": 0 },
    { "do": "check", "note": "方位の目盛なし", "dref": "laminar/B747/nd/capt/rose", "op": "==", "value": 0 },
    { "do": "check", "note": "F/O も円の絵", "dref": "laminar/B747/nd/fo/pln_style", "op": "==", "value": 1 },
    { "do": "check", "note": "F/O も中央", "dref": "laminar/B747/nd/fo/centred", "op": "==", "value": 1 },
    { "do": "check", "note": "経路の線は PLAN（3）", "dref": "laminar/B747/nd/line/view[0]", "op": "==", "value": 3 },
    { "do": "snapshot", "note": "範囲と経路の線", "drefs": [ "laminar/B747/nd/range_display_capt", "laminar/B747/nd/range_display_fo", "laminar/B747/nd/line/view[4]", "laminar/B747/nd/line/view[9]", "laminar/B747/nd/map_center/capt" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -24, "psi": 9, "fov": 24 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "capt_nd_pln_80" },
    { "do": "view", "note": "機長席から F/O の ND", "the": -22, "psi": 42, "fov": 22 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "fo_nd_pln_160" },

    { "do": "mark", "note": "LEGS の STEP" },
    { "do": "cdu", "note": "LEGS（PLN では 6R が STEP>）", "keys": ["LEGS"] },
    { "do": "check", "note": "STEP>", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "STEP>" },
    { "do": "cdu", "note": "STEP を 2 回", "keys": ["R6", "R6"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "機長の ND", "the": -24, "psi": 9, "fov": 24 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "capt_nd_pln_step" },

    { "do": "mark", "note": "CTR と MAP" },
    { "do": "set", "note": "CTR を入れる", "dref": "laminar/B747/nd/map_center/capt", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PLN は同じ（円、中央）", "dref": "laminar/B747/nd/capt/pln_style", "op": "==", "value": 1 },
    { "do": "check", "note": "中央", "dref": "laminar/B747/nd/capt/centred", "op": "==", "value": 1 },
    { "do": "set", "note": "CTR を外す", "dref": "laminar/B747/nd/map_center/capt", "value": 0 },
    { "do": "set", "note": "機長の ND を MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAP は拡大", "dref": "laminar/B747/nd/capt/centred", "op": "==", "value": 0 },
    { "do": "check", "note": "PLN でない", "dref": "laminar/B747/nd/capt/pln_style", "op": "==", "value": 0 },
    { "do": "check", "note": "TRK の枠", "dref": "laminar/B747/nd/capt/box", "op": "==", "value": 2 },
    { "do": "shot", "name": "capt_nd_map_after" },
    { "do": "cmd", "note": "外から見る（周回のビュー：カスタム acf のパネルだけの変更で外観は変わらないことを確かめる）", "name": "sim/view/circle" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "exterior_circle" },
    { "do": "cmd", "note": "操縦席に戻る", "name": "sim/view/3d_cockpit_cmnd_look" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
