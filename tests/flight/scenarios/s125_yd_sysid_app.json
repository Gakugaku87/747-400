{
  "name": "s125_yd_sysid_app",
  "description": "6-3 段 6b（ヨーダンパーの則）の下調べと確認、進入の形。s115 と同じ所（RJAA 34L の 12 NM 手前、2,500 ft）から、脚下げ・フラップ 30・150 kt・A/P 1 台（CMD L）の ALT HOLD と HDG HOLD で、ヨーダンパーを両方 OFF にして方向舵のトリムで doublet（+0.15 を 2 秒、−0.15 を 2 秒、0。その後 20 秒）を左右 1 回ずつ、MCP の方位で右 30° の旋回と戻し、両方 ON にして同じ doublet と旋回（ON の旋回は横滑り角が 2.5° を超えないこと：ロールの間の逆ヨーは ON でも約 2°）。素の機体のダッチロールを `tests/tools/lat_sysid.lua` で当てはめ、ヨーダンパーの効きを比べる（記録器 v7 の `yd_upr`・`rud_upr`・`ny`・`tas`）。合否は A/P が入ったままで高度が大きく外れないことだけ。機体を読み直す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 87.5 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 2,500 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 2500 },
    { "do": "set", "note": "MCP 方位 337", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "150 kt に近づく", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 152, "timeout": 120 },
    { "do": "sleep", "seconds": 15, "note": "落ち着く" },
    { "do": "cmd", "note": "HDG HOLD", "name": "sim/autopilot/heading_hold" },
    { "do": "remember", "note": "ALT HOLD の高度", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },

    { "do": "mark", "note": "ヨーダンパー OFF" },
    { "do": "switch", "note": "YAW DAMPER UPPER OFF", "dref": "laminar/B747/button_switch/position[82]", "value": 0, "cmd": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "switch", "note": "YAW DAMPER LOWER OFF", "dref": "laminar/B747/button_switch/position[83]", "value": 0, "cmd": "laminar/B747/button_switch/yaw_damper_lwr" },
    { "do": "sleep", "seconds": 8 },
    { "do": "mark", "note": "doublet 右から（YD OFF）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "doublet 左から（YD OFF）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 20 },

    { "do": "mark", "note": "旋回 右 30°（YD OFF）" },
    { "do": "set", "note": "MCP 方位 +30°", "dref": "laminar/B747/autopilot/heading/degrees", "value": 367 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 30 },
    { "do": "mark", "note": "旋回 戻し（YD OFF）" },
    { "do": "set", "note": "MCP 方位 戻し", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "sleep", "seconds": 30 },
    { "do": "cmd", "note": "HDG HOLD", "name": "sim/autopilot/heading_hold" },
    { "do": "sleep", "seconds": 5 },
    { "do": "mark", "note": "ヨーダンパー ON" },
    { "do": "switch", "note": "YAW DAMPER UPPER ON", "dref": "laminar/B747/button_switch/position[82]", "value": 1, "cmd": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "switch", "note": "YAW DAMPER LOWER ON", "dref": "laminar/B747/button_switch/position[83]", "value": 1, "cmd": "laminar/B747/button_switch/yaw_damper_lwr" },
    { "do": "wait", "note": "flight mode（fade-in 5 秒）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 4, "timeout": 10 },
    { "do": "sleep", "seconds": 5 },
    { "do": "mark", "note": "doublet 右から（YD ON）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "doublet 左から（YD ON）" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 20 },
    { "do": "mark", "note": "旋回 右 30°（YD ON）" },
    { "do": "set", "note": "MCP 方位 +30°", "dref": "laminar/B747/autopilot/heading/degrees", "value": 367 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "watch", "note": "旋回の入りと定常で横滑り角が 2.5° を超えない（150 kt・フラップ 30 では A/P の 2.5°/s のロールの間に逆ヨーで約 2° 横滑りする：ヨーダンパー OFF でも同じ。定常の旋回は 0.3° 以下）", "dref": "sim/flightmodel/position/beta", "abs": true, "max": 2.5, "timeout": 30 },
    { "do": "mark", "note": "旋回 戻し（YD ON）" },
    { "do": "set", "note": "MCP 方位 戻し", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "watch", "note": "戻しでも 2.5° を超えない", "dref": "sim/flightmodel/position/beta", "abs": true, "max": 2.5, "timeout": 30 },
    { "do": "cmd", "note": "HDG HOLD", "name": "sim/autopilot/heading_hold" },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "A/P のまま", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "高度が大きく外れない（±300 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [-300, 300], "rel": "alt0" },
    { "do": "record_stop" }
  ]
}
