{
  "name": "s276_xplane_vs_flch_commands",
  "description": "本家の古いコードと作り直した系統の食い違いの直し（2026-11-09、監査）の X-Plane での確認、空中。X-Plane 標準の V/S と FLCH のコマンド（sim/autopilot/vertical_speed・level_change：ジョイスティックの割り当てやチェックリストの道具が送る）が、MCP の V/S と FLCH SPD のボタンを押す形で AFDS のモデルに届くこと（前は古いモードの印 vvi_status・speed_status などを直に書くだけで、FMA は変わらず、A/P を切っていると V/S の灯と窓だけが出た）。10,000 ft・約 290 kt の空中開始（機体を読み直す、s99 と同じ。重さは s206 と同じ燃料だけの 270 t：前の回の重さを引き継がない）、FMS の空中の初期化で A/P CMD L・ALT。V/S のコマンドで FMA が V/S、MCP を 12,000 ft にして FLCH のコマンドで FLCH SPD。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の空中の初期化を待つ" },
    { "do": "wait", "note": "空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 20 },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ALT（FMA のピッチ 9）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },

    { "do": "mark", "note": "X-Plane 標準の V/S のコマンド" },
    { "do": "cmd", "note": "sim/autopilot/vertical_speed", "name": "sim/autopilot/vertical_speed", "duration": 0.2 },
    { "do": "wait", "note": "FMA が V/S（7）：MCP の V/S のボタンを押したのと同じ（前は変わらなかった）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7, "timeout": 5 },
    { "do": "snapshot", "note": "V/S", "drefs": [ "laminar/B747/autopilot/vvi_status", "laminar/B747/autopilot/speed_status",
      "laminar/B747/autopilot/altitude_hold_status", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/servos_on" ] },
    { "do": "check", "note": "A/P はつながったまま", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1 },
    { "do": "view", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_fma_vs" },

    { "do": "mark", "note": "X-Plane 標準の FLCH のコマンド（MCP 12,000 ft）" },
    { "do": "set", "note": "MCP 12,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 12000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "sim/autopilot/level_change", "name": "sim/autopilot/level_change", "duration": 0.2 },
    { "do": "wait", "note": "FMA が FLCH SPD（8）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8, "timeout": 5 },
    { "do": "snapshot", "note": "FLCH", "drefs": [ "laminar/B747/autopilot/vvi_status", "laminar/B747/autopilot/speed_status",
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "上昇している（FLCH で 12,000 ft へ）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 300 },
    { "do": "shot", "name": "pfd_fma_flch" },
    { "do": "set", "note": "MCP を 10,000 ft に戻す", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
