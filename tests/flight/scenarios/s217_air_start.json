{
  "name": "s217_air_start",
  "description": "空中開始（シムの開始の扱い、2026-11-02：notes/ATA-22.md §45、ATA-27.md §18）の X-Plane での確認、空中。伊豆諸島の南の海上 FL250・指示約 334 kt（真 245 m/s）・西向きで開始（機体を読み直す、カスタム acf）、何も押さない。FMS の初期化（F/D・A/T・ALT HOLD・CMD L）の後、MCP の速さが今の速さ、安定板が速さからの値（約 5.2 units）で、機首が上がって高く上がらないこと。前は安定板 7.5 units と MCP 214 kt で、8 秒で +9,800 fpm、29,600 ft まで上がり 229 kt まで落ちた。記録を取る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 32.80, "longitude": 139.20, "elevation_in_meters": 7620.0, "heading_true": 270, "speed_in_meters_per_second": 245.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる（IRS の方位の後に F/D・A/T ARM・MCP の速さ、1 秒後に ALT HOLD と CMD L）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40 },
    { "do": "wait", "note": "MCP の速さの巻き取りが終わる", "dref": "laminar/B747/autopilot/speed/target", "op": "==", "value": -1, "timeout": 20 },
    { "do": "snapshot", "note": "初期化の後", "drefs": [ "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_dial_kts", "laminar/B747/flt_ctrls/stab_trim/units", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "MCP の速さは今の速さ（前は min（今の速さ、Vmc + 10）で約 214 kt に下がった：notes/ATA-22.md §45）", "dref": "laminar/B747/autopilot/ias_dial_value", "op": "between", "value": [295, 345] },
    { "do": "check", "note": "安定板は速さから（334 kt で約 5.2 units。前は 7.5 units：notes/ATA-27.md §18）", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [4.5, 6.5] },
    { "do": "check", "note": "A/P の ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "watch", "note": "60 秒：高度は 26,500 ft まで（前は 8 秒で 26,300 ft・+9,800 fpm、29,600 ft まで上がった）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 26500, "timeout": 60 },
    { "do": "watch", "note": "続く 30 秒：速さは 290 kt より上（前は 229 kt まで落ちた）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 290, "timeout": 30 },
    { "do": "record_stop" }
  ]
}
