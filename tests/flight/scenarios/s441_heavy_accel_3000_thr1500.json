{
  "name": "s441_heavy_accel_3000_thr1500",
  "description": "重い全発の離陸と加速高度 3,000 ft の加速（2026-11-26：利用者の試験飛行「CMD を入れた後に ACCEL HEIGHT の 3000 ft AGL に達したら上昇率がマイナスになった」、重い離陸、MCP は V2。notes/ATA-22.md §73）。RJAA 34L、約 390 t（10 月 22 日の朝：ほかの離陸と同じ日付。11 月 26 日では航法データの期限切れの表示が CDU の入力を止めた）、ISA、フラップ 20、TAKEOFF REF の ACCEL HT 3,000 ft、THR REDUCTION 1,500 ft（加速高度の前に CLB 推力：s440 との違い。騒音軽減の NADP 1 の順）。VNAV と A/T を arm し、300 ft で CMD。加速高度から FCTM p.113 の予定でフラップを上げる（10 を VREF30 + 20、5 を + 40、1 を + 60、UP を + 80）。速度の則は上昇中の加速を「ほぼ水平」より下げない（§62、FCTM p.118）：上昇率は 0 を大きく割らない。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "weight": {
      "payload_weight_in_kilograms": [9000, 10500, 12000, 14500, 3000, 22500, 20500, 0, 0],
      "fueltank_weight_in_kilograms": [25000, 13499.4, 38075.2, 38075.2, 13499.4, 3980.6, 3980.6, 0, 0]
    },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": {
        "latitude_in_degrees": 35.76,
        "longitude_in_degrees": 140.38,
        "elevation_in_meters": 0,
        "visibility_in_kilometers": 40,
        "temperature_in_degrees_celsius": 15,
        "altimeter_setting_in_hpa": 1013.25,
        "precipitation_ratio": 0,
        "clouds": [],
        "wind": [
          {"altitude_in_feet_msl": 0, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 10000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0}
        ]
      },
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "snapshot", "note": "重さと気温", "drefs": [ "sim/flightmodel/weight/m_total", "sim/weather/aircraft/temperature_ambient_deg_c" ] },
    { "do": "check", "note": "重さは 380 t より上（空虚 183.5 t、積み荷 92 t、燃料 136.1 t：初めの 2026-11-26 の回で 22.5 t 少なく入った分を見込んで約 390 t。入った重さを記録する）", "dref": "sim/flightmodel/weight/m_total", "op": ">", "value": 380000, "level": "warn" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s109・s326 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA のピッチは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },

    { "do": "mark", "note": "CDU：経路、PERF INIT、TAKEOFF REF" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 275.5（空虚 183.5 t と積み荷 92 t）、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "275.5", "L3", "170", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 17,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 17000 },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、FLAP/ACCEL HT 20/3000（1L：FCOM p.1318）、V1・VR・V2 を選ぶ（1R〜3R）", "keys": ["L6", "L5", "20/3000", "L1", "R1", "R2", "R3"] },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "V2 を選んだ（999 でない）", "dref": "laminar/B747/airspeed/V2", "op": "<", "value": 900 },
    { "do": "cdu", "note": "THR REDUCTION 1,500 ft（3L：FCOM p.1319）", "keys": ["1500", "L3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2", "as": "v2" },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vr", "as": "vr" },
    { "do": "snapshot", "note": "V speeds、FMC の VNAV、TAKEOFF REF の 1L〜3L", "drefs": [ "laminar/B747/airspeed/V1", "laminar/B747/airspeed/Vr", "laminar/B747/airspeed/V2", "laminar/B747/fms/vnav/valid", "laminar/B747/fms/vnav/cas", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L" ] },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2", "as": "v2_mcp" },
    { "do": "set", "note": "MCP の速さを V2 に（FCOM p.118 の MCP の準備：IAS/MACH selector – Set V2。AFDS の T/O の V2 は窓の値：FCOM p.664 の注）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "v2_mcp" },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VNAV の arm", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 4 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "離陸（s141 と同じ）" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "VR", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 0, "rel": "vr", "timeout": 120 },
    { "do": "cmd", "note": "毎秒 2.5° で 15° へ引き起こす（B747_rotate.lua、FCTM p.95–96）", "name": "FlyWithLua/B747_rotate/start" },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "wait", "note": "電波高度 35 ft（引き起こしの操縦の終わり）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 35, "timeout": 30 },
    { "do": "cmd", "note": "引き起こしの操縦を終える（操縦輪はそのまま、次の F/D を追う操縦へ）", "name": "FlyWithLua/B747_rotate/stop" },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "cmd", "note": "手の操縦を終える（操縦輪はそのまま）", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "wait", "note": "VNAV SPD が engage（400 ft の上：FCOM p.645、p.1255）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "check", "note": "A/T は THR REF", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5 },

    { "do": "mark", "note": "THR REDUCTION（標高 141 + 1,500 ft）と加速高度（+ 3,000 ft）まで" },
    { "do": "wait", "note": "THR REDUCTION の上（1,700 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 1700, "timeout": 120 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "推力制限は CLB（THR REDUCTION 1,500 ft：FCOM p.1319）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CLB" },
    { "do": "watch", "note": "加速高度まで上昇している（V2 + 10〜V2 + 25 で）", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": 300, "until": { "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 3141 }, "timeout": 240 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt_accel" },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf30", "as": "vref30" },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "加速高度", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/airspeed/Vmax", "laminar/B747/airspeed/Vf30", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/pitch_target" ] },

    { "do": "mark", "note": "加速とフラップ上げ（FCTM p.113）" },
    { "do": "watch", "note": "VREF30 + 20 kt まで、上昇率は −50 fpm を割らない（上昇中の加速はほぼ水平まで：FCTM p.118、§62。幅は推定）", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -50, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 20, "rel": "vref30" }, "timeout": 180 },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "watch", "note": "VREF30 + 40 kt まで、上昇率は −50 fpm を割らない", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -50, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 40, "rel": "vref30" }, "timeout": 180 },
    { "do": "set", "note": "フラップ 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.34 },
    { "do": "watch", "note": "VREF30 + 60 kt まで、上昇率は −50 fpm を割らない", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -50, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 60, "rel": "vref30" }, "timeout": 180 },
    { "do": "set", "note": "フラップ 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.168 },
    { "do": "watch", "note": "VREF30 + 80 kt まで、上昇率は −50 fpm を割らない", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -50, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 80, "rel": "vref30" }, "timeout": 180 },
    { "do": "set", "note": "フラップ UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "watch", "note": "フラップ UP の後 30 秒も、上昇率は −50 fpm を割らない", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -50, "timeout": 30 },
    { "do": "check", "note": "加速の始めより 20 ft より多く下がっていない（推定）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": -20, "rel": "alt_accel" },
    { "do": "snapshot", "note": "フラップ UP の後", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "ピッチは VNAV SPD のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4 },
    { "do": "record_stop" }
  ]
}
