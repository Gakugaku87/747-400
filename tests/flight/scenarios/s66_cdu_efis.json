{
  "name": "s66_cdu_efis",
  "description": "CDU の EFIS CONTROL・OPTIONS（5-2 段 5c-1）の X-Plane での確認、空中。機長の EFIS 操作パネルを故障させる（laminar/B747/efis/fail[0]）と、左の CDU の MENU に EFIS CP SELECT が出て（FCOM p.1060-1061）、パネルのボタンは効かず、CDU の EFIS CONTROL（範囲、STD）と EFIS OPTIONS（CDU-152：WXR、POS、MTRS、FPV、WPT、STA、ARPT、DATA、VOR、ADF、FCOM p.1065）が機長側に効く。右の CDU は副操縦士側（パネルの故障のときだけ）。CDU とその画面を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 360", "dref": "laminar/B747/autopilot/heading/degrees", "value": 360 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cmd", "note": "左の CDU の MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "パネルが動いている間は EFIS CP SELECT が無い（前はいつも出ていた）", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "<FMC    <ACT>           " },
    { "do": "cmd", "note": "EFIS CP（R1）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MENU のまま", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "          MENU          " },

    { "do": "set", "note": "機長の EFIS 操作パネルの故障", "dref": "laminar/B747/efis/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "左の CDU に EFIS CP SELECT（FCOM p.1061）", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "<FMC    <ACT>    SELECT>" },
    { "do": "check", "note": ">EFIS CONTROL L（FCOM p.1198）", "dref": "laminar/B747/CAS/advisory_status[88]", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_menu_select" },
    { "do": "set", "note": "FPV を消しておく", "dref": "laminar/B747/efis/fpv/capt/selected", "value": 0 },
    { "do": "set", "note": "範囲は両側 40 NM から", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range_copilot", "value": 2 },
    { "do": "set", "note": "機長の左の VOR/ADF スイッチは OFF", "dref": "sim/cockpit2/EFIS/EFIS_1_selection_pilot", "value": 1 },
    { "do": "set", "note": "機長の気圧 30.12", "dref": "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "value": 30.12 },
    { "do": "cmd", "note": "故障したパネルの FPV", "name": "laminar/B747/efis/fpv/capt/switch" },
    { "do": "cmd", "note": "故障したパネルの範囲", "name": "laminar/B747/nd/range/capt/sel_dial_up" },
    { "do": "cmd", "note": "故障したパネルの左の VOR/ADF スイッチ（X-Plane のコマンド）", "name": "sim/instruments/EFIS_1_pilot_sel_up" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FPV は変わらない", "dref": "laminar/B747/efis/fpv/capt/selected", "op": "==", "value": 0 },
    { "do": "check", "note": "範囲も変わらない", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "check", "note": "VOR/ADF スイッチも OFF のまま", "dref": "sim/cockpit2/EFIS/EFIS_1_selection_pilot", "op": "==", "value": 1 },

    { "do": "cmd", "note": "EFIS CP SELECT", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "EFIS CONTROL のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "      EFIS CONTROL      " },
    { "do": "cmd", "note": "RANGE INCR", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の範囲 80 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "op": "==", "value": 3 },
    { "do": "check", "note": "X-Plane の地図の範囲も", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 3 },
    { "do": "check", "note": "副操縦士の範囲は 40 NM のまま（前は両方）", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/T" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/D" },
    { "do": "cmd", "note": "STD を BARO SET へ", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長側が STD（パネルが故障していても）", "dref": "laminar/B747/efis/baro_std/capt/switch_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "29.92", "dref": "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "op": "between", "value": [29.915, 29.925] },
    { "do": "check", "note": "副操縦士側はそのまま", "dref": "laminar/B747/efis/baro_std/fo/switch_pos", "op": "==", "value": 0 },
    { "do": "cmd", "note": "PLN", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の ND は PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 3 },
    { "do": "check", "note": "X-Plane の地図も PLN（4。GAP の DSP-31：前は CDU のモードが X-Plane に届かなかった）", "dref": "sim/cockpit2/EFIS/map_mode", "op": "==", "value": 4 },
    { "do": "cmd", "note": "MAP", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X-Plane の地図も ND の MAP に合わせる（405 は方位が上で 0）", "dref": "sim/cockpit2/EFIS/map_mode", "op": "==", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_efis_control" },

    { "do": "cmd", "note": "OPTIONS", "name": "laminar/B747/fms1/ls_key/R6" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "EFIS OPTIONS のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "      EFIS OPTIONS      " },
    { "do": "check", "note": "MTRS と ARPT（前は TERR）", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": "<MTRS              ARPT>" },
    { "do": "set", "note": "WXR を消しておく", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "value": 0 },
    { "do": "cmd", "note": "FPV", "name": "laminar/B747/fms1/ls_key/L4" },
    { "do": "cmd", "note": "POS", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "cmd", "note": "DATA", "name": "laminar/B747/fms1/ls_key/R4" },
    { "do": "cmd", "note": "WXR", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の FPV", "dref": "laminar/B747/efis/fpv/capt/selected", "op": "==", "value": 1 },
    { "do": "check", "note": "PFD に FPV", "dref": "laminar/B747/pfd/capt/fpv_show", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の POS（前は効かなかった）", "dref": "laminar/B747/nd/data/capt/pos", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の DATA（前は効かなかった）", "dref": "laminar/B747/nd/data/capt/data", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の WXR", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の FPV はそのまま", "dref": "laminar/B747/efis/fpv/fo/selected", "op": "==", "value": 0 },
    { "do": "check", "note": "FPV と DATA に <SEL>", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "<FPV  <SEL>  <SEL> DATA>" },
    { "do": "shot", "name": "cdu_efis_options" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "cdu_efis_pfd_fpv" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "cdu_efis_nd_wxr" },

    { "do": "cmd", "note": "右の CDU の MENU", "name": "laminar/B747/fms2/func_key/fix" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士のパネルは動いている：SELECT 無し", "dref": "laminar/B747/fms2/Line03_L", "op": "==", "value": "<FMC    <ACT>           " },
    { "do": "set", "note": "副操縦士の EFIS 操作パネルの故障", "dref": "laminar/B747/efis/fail[1]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "右の CDU に SELECT", "dref": "laminar/B747/fms2/Line03_L", "op": "==", "value": "<FMC    <ACT>    SELECT>" },
    { "do": "cmd", "note": "EFIS CP SELECT", "name": "laminar/B747/fms2/ls_key/R1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "RANGE INCR", "name": "laminar/B747/fms2/ls_key/L5" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士の範囲 80 NM", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "op": "==", "value": 3 },
    { "do": "check", "note": "X-Plane の副操縦士の地図の範囲", "dref": "sim/cockpit2/EFIS/map_range_copilot", "op": "==", "value": 3 },
    { "do": "check", "note": "機長の範囲は 80 NM のまま", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "op": "==", "value": 3 },
    { "do": "set", "note": "副操縦士の WXR を消しておく", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "value": 0 },
    { "do": "cmd", "note": "OPTIONS", "name": "laminar/B747/fms2/ls_key/R6" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "WXR", "name": "laminar/B747/fms2/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士の WXR（前は機長の）", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の WXR はそのまま", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "op": "==", "value": 1 },
    { "do": "view", "note": "右の CDU", "the": -29, "psi": 39, "fov": 16 },
    { "do": "shot", "name": "cdu_efis_options_fo" },
    { "do": "cmd", "note": "副操縦士の WXR を戻す", "name": "laminar/B747/fms2/ls_key/L1" },

    { "do": "set", "note": "パネルの故障を戻す", "dref": "laminar/B747/efis/fail[0]", "value": 0 },
    { "do": "set", "dref": "laminar/B747/efis/fail[1]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "左の CDU の MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "SELECT が消える", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "<FMC    <ACT>           " },
    { "do": "cmd", "note": "パネルの FPV（効く）", "name": "laminar/B747/efis/fpv/capt/switch" },
    { "do": "cmd", "note": "パネルの POS", "name": "laminar/B747/nd/pos/capt/switch" },
    { "do": "cmd", "note": "パネルの DATA", "name": "laminar/B747/nd/data/capt/switch" },
    { "do": "cmd", "note": "パネルの WXR", "name": "laminar/B747/nd/wxr/capt/switch" },
    { "do": "cmd", "note": "パネルの左の VOR/ADF スイッチを上（VOR）", "name": "sim/instruments/EFIS_1_pilot_sel_up" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VOR", "dref": "sim/cockpit2/EFIS/EFIS_1_selection_pilot", "op": "==", "value": 2 },
    { "do": "cmd", "note": "下（OFF）", "name": "sim/instruments/EFIS_1_pilot_sel_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "OFF", "dref": "sim/cockpit2/EFIS/EFIS_1_selection_pilot", "op": "==", "value": 1 },
    { "do": "check", "note": "FPV が消える", "dref": "laminar/B747/efis/fpv/capt/selected", "op": "==", "value": 0 },
    { "do": "check", "note": "POS も", "dref": "laminar/B747/nd/data/capt/pos", "op": "==", "value": 0 },
    { "do": "check", "note": "DATA も", "dref": "laminar/B747/nd/data/capt/data", "op": "==", "value": 0 },
    { "do": "check", "note": "WXR も", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "op": "==", "value": 0 },
    { "do": "set", "note": "範囲を戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range_copilot", "value": 2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
