{
  "name": "s256_cdu_sim_values",
  "description": "シムの便利機能（2026-11-05 の利用者の依頼、実機に無い）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す）。Plugins → 747-400 の「CDU: GR WT, ZFW and CG from the sim」が入（初期値）なら、スクラッチパッドが空のまま PERF INIT の ZFW（L3）・GR WT（L1）、TAKEOFF REF の CG（R4）を押すとシムの今の値が入る（ZFW は X-Plane の総重量から燃料を引いた値、CG は X-Plane の % MAC を整数に）。切ると前どおり INVALID ENTRY。重量と CG の窓（Plugins → 747-400 → Weight and balance...）を開いて撮る。CDU を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "check", "note": "便利機能は入（初期値。FMS ブリッジの設定ファイルに無ければ入）", "dref": "laminar/B747/options/cdu_sim_values", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "シムの重量と CG（kg、% MAC）", "drefs": ["sim/flightmodel/weight/m_total", "sim/flightmodel/weight/m_fuel_total", "sim/flightmodel/weight/m_fixed", "sim/flightmodel2/misc/cg_offset_z_mac", "sim/flightmodel2/misc/cg_offset_z", "sim/flightmodel2/misc/zfw_cg_offset_z"] },

    { "do": "mark", "note": "PERF INIT（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "INIT REF", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "PERF INIT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF INIT" },
    { "do": "check", "note": "ZFW はボックス", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "***.*" },
    { "do": "cmd", "note": "空のスクラッチパッドで ZFW（L3）", "name": "laminar/B747/fms1/ls_key/L3" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "ZFW にシムの値（大きい字、千 kg の 0.1 まで。値は上の snapshot の総重量 - 燃料）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^ ?[0-9]{3}[.][0-9] " },
    { "do": "check", "note": "INVALID ENTRY は出ない", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^ *$" },
    { "do": "check", "note": "GR WT は ZFW と FUEL から（小さい字）", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^ ?[0-9]{3}[.][0-9] " },
    { "do": "snapshot", "note": "PERF INIT の行", "drefs": ["laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line07_S"] },
    { "do": "cmd", "note": "空のスクラッチパッドで GR WT（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "GR WT にシムの値（大きい字）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^ ?[0-9]{3}[.][0-9] " },
    { "do": "snapshot", "note": "GR WT を入れた後", "drefs": ["laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line07_S", "sim/flightmodel/weight/m_total"] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "note": "PERF INIT", "name": "perf_init_sim" },

    { "do": "mark", "note": "TAKEOFF REF の CG" },
    { "do": "cmd", "note": "PERF INIT の INDEX（L6）", "name": "laminar/B747/fms1/ls_key/L6" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "INIT/REF INDEX の TAKEOFF（地上で L5）", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF" },
    { "do": "cmd", "note": "空のスクラッチパッドで CG（R4）", "name": "laminar/B747/fms1/ls_key/R4" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "CG にシムの値（整数の %、大きい字）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "[0-9]{1,2}%$" },
    { "do": "snapshot", "note": "CG の行とシムの % MAC", "drefs": ["laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line09_S", "sim/flightmodel2/misc/cg_offset_z_mac"] },
    { "do": "shot", "note": "TAKEOFF REF", "name": "takeoff_sim_cg" },

    { "do": "mark", "note": "便利機能を切ると前どおり" },
    { "do": "cmd", "note": "スクラッチパッドのメッセージを消す（2026-11-05 の 1 回目：日付 309 で NAV DATA OUT OF DATE が出ていて INVALID ENTRY が隠れた）", "name": "laminar/B747/fms1/key/clear", "seconds": 1.5 },
    { "do": "cmd", "note": "切る（メニューと同じコマンド）", "name": "laminar/B747/options/cdu_sim_values_toggle" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "切れた", "dref": "laminar/B747/options/cdu_sim_values", "op": "==", "value": 0 },
    { "do": "cmd", "note": "空のスクラッチパッドで CG（R4）", "name": "laminar/B747/fms1/ls_key/R4" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "INVALID ENTRY", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear", "seconds": 1.5 },
    { "do": "cmd", "note": "入れ直す（初期値に戻す）", "name": "laminar/B747/options/cdu_sim_values_toggle" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "入", "dref": "laminar/B747/options/cdu_sim_values", "op": "==", "value": 1 },

    { "do": "mark", "note": "重量と CG の窓" },
    { "do": "cmd", "note": "窓を開く（Plugins → 747-400 → Weight and balance... と同じコマンド）", "name": "laminar/B747/wb/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "開いた", "dref": "laminar/B747/wb/window_open", "op": ">=", "value": 1 },
    { "do": "shot", "note": "重量と CG の窓", "name": "wb_window" },
    { "do": "cmd", "note": "閉じる", "name": "laminar/B747/wb/window_toggle" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "閉じた", "dref": "laminar/B747/wb/window_open", "op": "==", "value": 0 }
  ]
}
