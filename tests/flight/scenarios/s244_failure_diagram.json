{
  "name": "s244_failure_diagram",
  "description": "故障の窓の F3（notes/FAILURES.md §7）：系統図。成田 34L でエンジン運転中に窓を開き、test_click で DIAGRAM に切り替え、油圧・電源・燃料・空圧の図の箱を押して故障と修理、右クリックで arm の帯。図の無い章（21）では LIST のまま。図の写真を撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "cmd", "note": "窓を開く", "name": "laminar/B747/failures/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "章 29 HYDRAULICS", "dref": "laminar/B747/failures/test_click", "value": 1005 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "DIAGRAM", "dref": "laminar/B747/failures/test_click", "value": 8001 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "DIAGRAM のボタンがあって押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 8001 },

    { "do": "mark", "note": "油圧の図" },
    { "do": "set", "note": "箱 4：EDP 2", "dref": "laminar/B747/failures/test_click", "value": 7004 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 7004 },
    { "do": "check", "note": "EDP 2 が故障", "dref": "laminar/B747/hydraulics/fail/edp[1]", "op": "==", "value": 1 },
    { "do": "wait", "note": "HYD PRESS ENG 2", "dref": "laminar/B747/CAS/advisory_status[211]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "shot", "name": "diagram_hyd_edp2" },
    { "do": "set", "note": "もう一度押すと直る", "dref": "laminar/B747/failures/test_click", "value": 7004 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "EDP 2 は正常", "dref": "laminar/B747/hydraulics/fail/edp[1]", "op": "==", "value": 0 },
    { "do": "set", "note": "箱 0（RSVR 1）を右クリック：arm の帯", "dref": "laminar/B747/failures/test_click", "value": 9000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "帯が出た（IN TIME の 5 分）", "dref": "laminar/B747/failures/arm_value", "op": "==", "value": 5 },
    { "do": "shot", "name": "diagram_hyd_arm_bar" },
    { "do": "set", "note": "CANCEL", "dref": "laminar/B747/failures/test_click", "value": 6003 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "帯が閉じた", "dref": "laminar/B747/failures/arm_value", "op": "==", "value": -1 },

    { "do": "mark", "note": "電源の図" },
    { "do": "set", "note": "章 24 ELECTRICAL（図のまま）", "dref": "laminar/B747/failures/test_click", "value": 1001 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "箱 9：GEN 3", "dref": "laminar/B747/failures/test_click", "value": 7009 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "発電機 3 が故障", "dref": "laminar/B747/electrical/fail/gen[2]", "op": "==", "value": 1 },
    { "do": "set", "note": "箱 16：SSB", "dref": "laminar/B747/failures/test_click", "value": 7016 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "SSB が故障", "dref": "laminar/B747/electrical/fail/ssb", "op": "==", "value": 1 },
    { "do": "shot", "name": "diagram_elec" },
    { "do": "set", "note": "GEN 3 を直す", "dref": "laminar/B747/failures/test_click", "value": 7009 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "SSB を直す", "dref": "laminar/B747/failures/test_click", "value": 7016 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "発電機 3 は正常", "dref": "laminar/B747/electrical/fail/gen[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "SSB は正常", "dref": "laminar/B747/electrical/fail/ssb", "op": "==", "value": 0 },

    { "do": "mark", "note": "燃料の図" },
    { "do": "set", "note": "章 28 FUEL", "dref": "laminar/B747/failures/test_click", "value": 1004 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "箱 14：X FEED 2", "dref": "laminar/B747/failures/test_click", "value": 7014 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X FEED 2 の弁が固着", "dref": "laminar/B747/fuel/fail/valve[1]", "op": "==", "value": 1 },
    { "do": "shot", "name": "diagram_fuel" },
    { "do": "set", "note": "直す", "dref": "laminar/B747/failures/test_click", "value": 7014 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "正常", "dref": "laminar/B747/fuel/fail/valve[1]", "op": "==", "value": 0 },

    { "do": "mark", "note": "空圧の図" },
    { "do": "set", "note": "章 36 PNEUMATIC（11 番目：1010）", "dref": "laminar/B747/failures/test_click", "value": 1010 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "箱 13：LEAK C", "dref": "laminar/B747/failures/test_click", "value": 7013 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "中央ダクトの漏れ", "dref": "laminar/B747/fire/fail/duct_leak[1]", "op": "==", "value": 1 },
    { "do": "shot", "name": "diagram_bleed" },
    { "do": "set", "note": "直す", "dref": "laminar/B747/failures/test_click", "value": 7013 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "正常", "dref": "laminar/B747/fire/fail/duct_leak[1]", "op": "==", "value": 0 },

    { "do": "mark", "note": "図の無い章" },
    { "do": "set", "note": "章 21 AIR CONDITIONING", "dref": "laminar/B747/failures/test_click", "value": 1000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "LIST のボタンは無い", "dref": "laminar/B747/failures/test_click", "value": 8000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押す所が無い", "dref": "laminar/B747/failures/test_click", "op": "==", "value": -1 },
    { "do": "set", "note": "一覧の行 1：PACK 1 OVERHEAT", "dref": "laminar/B747/failures/test_click", "value": 2001 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "一覧が出ていて押せた", "dref": "laminar/B747/air/fail/pack_ovht[0]", "op": "==", "value": 1 },
    { "do": "set", "note": "REPAIR ALL", "dref": "laminar/B747/failures/test_click", "value": 3000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },
    { "do": "set", "note": "章 29 に戻って LIST", "dref": "laminar/B747/failures/test_click", "value": 1005 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "LIST", "dref": "laminar/B747/failures/test_click", "value": 8000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LIST のボタンを押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 8000 },
    { "do": "set", "note": "窓を閉じる", "dref": "laminar/B747/failures/window_open", "value": 0 },
    { "do": "record_stop" }
  ]
}
