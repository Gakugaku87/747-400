{
  "name": "s134_fmc_winds",
  "description": "6-1/6-2 段 8e1（WIND のページと点ごとの風）の X-Plane での確認、空中。FL350・M.84 で RJAA の東から西へ空中開始（機体を読み直す）。s131 と同じ経路（RJAA→RJBB、DIRECT AKAGI、STAR ATMUGA、ILS06LY・遷移 GATES）を ACTIVATE と EXEC。LEGS の 6R の RTE DATA から 1R で AKAGI の WIND のページ（FCOM p.1365 の形）、1L に FL350（4 行目に入り、DIR/SPD はダッシュ、OAT は標準大気の小さい字）、4R に 270/50（大きい字）、NEXT で次の点に小さい字で伝わる、5R に FL300/-40（FL350 の OAT は -50、大きい字）、6R の RTE DATA> で戻り AKAGI が W>。画面の写真で配置と字の大きさを確かめる。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.6, "elevation_in_meters": 10668, "heading_true": 255, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "check", "note": "<SEL>GATES", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<SEL>GATES" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS、RTE DATA>", "keys": ["LEGS", "R6"] },
    { "do": "check", "note": "RTE DATA の AKAGI は >（風の入力なし）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^      AKAGI +>$" },
    { "do": "cdu", "note": "1R：AKAGI の WIND のページ", "keys": ["R1"] },
    { "do": "check", "note": "AKAGI WINDS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "AKAGI WINDS" },
    { "do": "check", "note": "見出し", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "ALT    OAT      DIR/SPD" },
    { "do": "check", "note": "1L はダッシュ", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^-----" },
    { "do": "cdu", "note": "1L に FL350", "keys": ["FL350", "L1"] },
    { "do": "check", "note": "4 行目に FL350、DIR/SPD はダッシュ", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^FL350 +---`/---" },
    { "do": "check", "note": "OAT は標準大気（小さい字）", "dref": "laminar/B747/fms3/Line09_S", "op": "contains", "value": "-54`C" },
    { "do": "cdu", "note": "4R に 270/50", "keys": ["270/50", "R4"] },
    { "do": "check", "note": "270/50 は大きい字", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "270`/ 50" },
    { "do": "snapshot", "note": "AKAGI の WIND のページ", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line01_S", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line09_S", "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L", "laminar/B747/fms3/Line11_S", "laminar/B747/fms3/Line12_L", "laminar/B747/fms3/Line13_L" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_wind_akagi" },
    { "do": "cdu", "note": "NEXT：次の点", "keys": ["NEXT"] },
    { "do": "check", "note": "伝わった風は小さい字", "dref": "laminar/B747/fms3/Line09_S", "op": "contains", "value": "270`/ 50KT" },
    { "do": "cdu", "note": "5R に FL300/-40", "keys": ["FL300/-40", "R5"] },
    { "do": "check", "note": "5R の入力", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "FL300/-40`" },
    { "do": "check", "note": "FL350 の OAT は -50（大きい字）", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "-50`" },
    { "do": "shot", "name": "cdu_wind_next" },
    { "do": "cdu", "note": "6R：RTE DATA>", "keys": ["R6"] },
    { "do": "check", "note": "RTE DATA", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 DATA" },
    { "do": "check", "note": "AKAGI は W>", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "AKAGI +W>$" },
    { "do": "shot", "name": "cdu_rte_data_w" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
