{
  "name": "s237_oil_filter_ge",
  "description": "エンジンの scavenge のオイルフィルタの詰まり（2026-11-04、故障の窓のため：notes/ATA-70-80.md §11、ENG-28）の X-Plane での確認、GE（Saudia、CF6-80C2B1F）。RJAA 34L でエンジン運転中に、エンジン 3 のフィルタの故障で ENG 3 OIL FILT と STATUS ENG 3 OIL FILT（ATA70_80 p.522：差圧 33 psid でスイッチが閉じ、主 EICAS と STATUS。FCOM p.891 の 570 の図）。上の EICAS を撮る",
  "reload": true,
  "livery": "Saudia",
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "check", "note": "GE", "dref": "laminar/B747/engines/type", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "始まりの抽気（GE の表示の N2 が 0 から上がり、抽気が空で >CARGO DET AIR が一時出ていた件：2026-11-04 に直した）", "drefs": [
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_C", "laminar/B747/air/duct_pressure_R",
      "laminar/B747/air/engine1/bleed_air_psi", "laminar/B747/air/engine1/bleed_valve_pos", "laminar/B747/air/engine1/bleed_start_valve_pos",
      "laminar/B747/button_switch/position[77]", "laminar/B747/CAS/advisory_status[49]", "laminar/B747/engines/display_N2[0]",
      "laminar/B747/air/packs_operating" ] },
    { "do": "cas", "note": "始まり" },
    { "do": "check", "note": "始まりから表示の N2 はアイドル（50 % 超）", "dref": "laminar/B747/engines/display_N2[0]", "op": ">", "value": 55 },
    { "do": "check", "note": "始まりから中央のダクトに空気がある", "dref": "laminar/B747/air/duct_pressure_C", "op": ">", "value": 20 },
    { "do": "check", "note": ">CARGO DET AIR は出ない", "dref": "laminar/B747/CAS/advisory_status[49]", "op": "==", "value": 0 },
    { "do": "check", "note": "ENG 3 OIL FILT は出ていない", "dref": "laminar/B747/CAS/advisory_status[326]", "op": "==", "value": 0 },
    { "do": "set", "note": "エンジン 3 のオイルフィルタの詰まり", "dref": "laminar/B747/engines/fail/oil_filter[2]", "value": 1 },
    { "do": "wait", "note": "ENG 3 OIL FILT（ATA70_80 p.522）", "dref": "laminar/B747/CAS/advisory_status[326]", "op": "==", "value": 1, "timeout": 3, "cite": "ATA70_80 p.522" },
    { "do": "check", "note": "STATUS ENG 3 OIL FILT", "dref": "laminar/B747/CAS/status_status[144]", "op": "==", "value": 1 },
    { "do": "check", "note": "ほかのエンジンは出ない", "dref": "laminar/B747/CAS/advisory_status[324]", "op": "==", "value": 0 },
    { "do": "cas", "note": "ENG 3 OIL FILT" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_oil_filt" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/engines/fail/oil_filter[2]", "value": 0 },
    { "do": "wait", "note": "ENG 3 OIL FILT が消える", "dref": "laminar/B747/CAS/advisory_status[326]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "STATUS も消える", "dref": "laminar/B747/CAS/status_status[144]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
