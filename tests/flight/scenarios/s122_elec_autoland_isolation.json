{
  "name": "s122_elec_autoland_isolation",
  "description": "ELEC-18（autoland の母線の分離）の X-Plane での確認、空中。s120 と同じ所（RJAA 34L の進入路の 12 NM、2,500 ft）から CMD L で APP：C と R が arm して FCC が分離を求め（`autopilot/bus_isolate_req`：ATA22 p.192）、電源は構成 A（BTB と DCIR の 1〜3 を開く、AC 4 が同期母線：LH24 p.244–247）、BUS ISOLATED（`electrical/bus_isolated`）、ISLN 1〜3 の灯と ELEC BUS ISLN は出ない、下の EICAS の ELEC は「ELECTRICAL SYNOPTIC INHIBITED FOR AUTOLAND」だけ（FCOM p.789、p.802）。GEN CONT 2 を切ると構成 C（BTB 2 を閉じて AC 2 を同期母線から）、分離のまま。そのまま LAND 3、1,000 ft で GEN CONT 1 も切ると（2 つ目の GC が 200 ft より上）元の形に戻って BUS ISOLATED が消え、LAND 2、4 秒後に >NO LAND 3 の caution（ATA22 p.384）。発電機を戻しても要求が終わるまで分離しない。TO/GA の G/A で 100 ft より上なので要求が終わる（FCOM p.802）。下の EICAS、頭上パネル、上の EICAS を撮る。機体を読み直す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（s120 と同じ）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "set", "note": "下の EICAS を ELEC の synoptic に", "dref": "laminar/B747/dsp/synoptic_display", "value": 3 },

    { "do": "mark", "note": "APP の前：分離の要求なし、BTB は閉" },
    { "do": "check", "note": "分離の要求なし", "dref": "laminar/B747/autopilot/bus_isolate_req", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 1 閉", "dref": "laminar/B747/electrical/breaker/btb[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "DCIR 1 閉", "dref": "laminar/B747/electrical/breaker/dcir[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "BUS ISOLATED なし", "dref": "laminar/B747/electrical/bus_isolated", "op": "==", "value": 0 },
    { "do": "check", "note": "synoptic は抑止されていない", "dref": "laminar/B747/electrical/synoptic_inhibit", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため、s120 と同じ）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS（s75 と同じ）", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "elec_synoptic_before" },

    { "do": "mark", "note": "APP：C と R が arm、分離の要求、構成 A（LH24 p.246–247）" },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "sleep", "seconds": 2, "note": "分離は 4 秒以内（ATA22 p.192）" },
    { "do": "check", "note": "C が arm（multi-channel）", "dref": "laminar/B747/autopilot/cmd_armed[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "分離の要求", "dref": "laminar/B747/autopilot/bus_isolate_req", "op": "==", "value": 1 },
    { "do": "check", "note": "BTB 1 開", "dref": "laminar/B747/electrical/breaker/btb[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 2 開", "dref": "laminar/B747/electrical/breaker/btb[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 3 開", "dref": "laminar/B747/electrical/breaker/btb[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 4 閉（AC 4 が同期母線）", "dref": "laminar/B747/electrical/breaker/btb[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "DCIR 1 開", "dref": "laminar/B747/electrical/breaker/dcir[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "DCIR 3 開", "dref": "laminar/B747/electrical/breaker/dcir[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "DCIR 4 閉", "dref": "laminar/B747/electrical/breaker/dcir[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC 1 は自分の発電機", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "DC 2", "dref": "laminar/B747/electrical/bus/dc[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "BUS ISOLATED", "dref": "laminar/B747/electrical/bus_isolated", "op": "==", "value": 1 },
    { "do": "check", "note": "synoptic の抑止", "dref": "laminar/B747/electrical/synoptic_inhibit", "op": "==", "value": 1 },
    { "do": "check", "note": "ISLN 1 の灯は消えたまま（FCOM p.802）", "dref": "laminar/B747/electrical/light/isln[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "ISLN 3 も", "dref": "laminar/B747/electrical/light/isln[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "ELEC BUS ISLN 1 は出ない", "dref": "laminar/B747/CAS/advisory_status[92]", "op": "==", "value": 0 },
    { "do": "check", "note": "ELEC BUS ISLN 2 も", "dref": "laminar/B747/CAS/advisory_status[93]", "op": "==", "value": 0 },
    { "do": "check", "note": "NO LAND 3 は出ない", "dref": "laminar/B747/CAS/advisory_status[248]", "op": "==", "value": 0 },
    { "do": "shot", "name": "elec_synoptic_inhibited" },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_isln_off" },

    { "do": "mark", "note": "GEN CONT 2 OFF：構成 C（BTB 2 を閉じて AC 2 を同期母線から）" },
    { "do": "switch", "note": "GEN CONT 2 OFF", "dref": "laminar/B747/button_switch/position[23]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_2" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "BTB 2 閉", "dref": "laminar/B747/electrical/breaker/btb[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "BTB 1 開", "dref": "laminar/B747/electrical/breaker/btb[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 3 開", "dref": "laminar/B747/electrical/breaker/btb[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "DCIR 2 閉", "dref": "laminar/B747/electrical/breaker/dcir[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "DCIR 1 開", "dref": "laminar/B747/electrical/breaker/dcir[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "AC 2 は同期母線から", "dref": "laminar/B747/electrical/bus/ac[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "分離のまま", "dref": "laminar/B747/electrical/bus_isolated", "op": "==", "value": 1 },
    { "do": "check", "note": "R の FCC（AC 2・DC 2）の電源：R は arm のまま", "dref": "laminar/B747/autopilot/cmd_armed[2]", "op": "==", "value": 1 },

    { "do": "mark", "note": "G/S、LAND 3（構成 C のまま）" },
    { "do": "wait", "note": "G/S を捕まえる（FMA のピッチ 2）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "set", "note": "フラップ 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3（BUS ISOLATED が要る：ATA22 p.192）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 150 },
    { "do": "check", "note": "分離のまま", "dref": "laminar/B747/electrical/bus_isolated", "op": "==", "value": 1 },

    { "do": "mark", "note": "1,000 ft で GEN CONT 1 OFF：2 つ目の GC（200 ft より上）は元の形に戻す（LH24 p.244）" },
    { "do": "wait", "note": "1,000 ft の下", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 1000, "timeout": 60 },
    { "do": "switch", "note": "GEN CONT 1 OFF", "dref": "laminar/B747/button_switch/position[22]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "BUS ISOLATED が消える", "dref": "laminar/B747/electrical/bus_isolated", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 1 閉（元の形）", "dref": "laminar/B747/electrical/breaker/btb[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "BTB 3 閉", "dref": "laminar/B747/electrical/breaker/btb[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "DCIR 1 閉", "dref": "laminar/B747/electrical/breaker/dcir[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC 1 は同期母線から", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "synoptic が戻る", "dref": "laminar/B747/electrical/synoptic_inhibit", "op": "==", "value": 0 },
    { "do": "check", "note": "LAND 2（LAND 3 は BUS ISOLATED が要る）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 3 },
    { "do": "check", "note": "要求は続く", "dref": "laminar/B747/autopilot/bus_isolate_req", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 5, "note": "分離しないまま 4 秒" },
    { "do": "check", "note": ">NO LAND 3 の caution（ATA22 p.384：multi-channel のとき）", "dref": "laminar/B747/CAS/caution_status[50]", "op": "==", "value": 1 },
    { "do": "check", "note": "3 チャンネルとも入ったまま", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 1 },
    { "do": "view", "note": "下の EICAS：synoptic が戻る", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "elec_synoptic_back" },
    { "do": "cas", "note": ">NO LAND 3（caution）" },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_no_land3" },
    { "do": "switch", "note": "GEN CONT 1 ON", "dref": "laminar/B747/button_switch/position[22]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_1" },
    { "do": "switch", "note": "GEN CONT 2 ON", "dref": "laminar/B747/button_switch/position[23]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_2" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "発電機を戻しても、要求が終わるまで分離しない（LH24 p.245 の図）", "dref": "laminar/B747/electrical/bus_isolated", "op": "==", "value": 0 },
    { "do": "check", "note": "BTB 2 閉", "dref": "laminar/B747/electrical/breaker/btb[1]", "op": "==", "value": 1 },

    { "do": "mark", "note": "TO/GA：100 ft より上の G/A で要求が終わる（FCOM p.802）" },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "G/A（FMA のロールは TO/GA）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "要求が終わる", "dref": "laminar/B747/autopilot/bus_isolate_req", "op": "==", "value": 0 },
    { "do": "check", "note": "NO LAND 3 が消える", "dref": "laminar/B747/CAS/caution_status[50]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
