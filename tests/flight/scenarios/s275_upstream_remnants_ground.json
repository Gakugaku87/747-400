{
  "name": "s275_upstream_remnants_ground",
  "description": "本家の古いコードと作り直した系統の食い違いの直し（2026-11-09、利用者の依頼の監査：Fable のエージェント 3 つ）の X-Plane での確認、地上。成田 34L でエンジン運転中に開始（機体を読み直す）。(1) BATTERY を押しても両席のミニマム（RA・BARO）は消えない（前は押すたびに消えた）。(2) X-Plane 標準の発電機のコマンド（sim/electrical/generator_1_off・_on）が GEN CONT 1 を動かす（前は自分を呼び返すだけ）、GEN CONT 1 OFF で ELEC GEN OFF 1 と整備パネルの FIELD OFF 1（FCOM p.788：界磁が開）、ON で消える。(3) SSB が閉なら SSB OPEN は消灯。(4) 地上でも CDU で選んだ VREF の着陸のフラップが残る（FCOM p.973。前は電波高度 5 ft 未満で毎フレーム消えた）。(5) APU の燃料弁が閉で固着（故障の窓の燃料弁 apu）なら、APU の始動は弁が開く時間（4 秒）と余裕（2 秒）の後に止まり、APU の advisory（前は主タンク 2 の燃料だけ見て回り続けた）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]",
      "laminar/B747/electrical/gen_field_open[0]", "laminar/B747/electrical/breaker/ssb",
      "laminar/B747/airspeed/VrefFlap", "laminar/B747/fuel/main2_tank/apu_vlv_pos" ] },
    { "do": "cas", "note": "開始直後" },

    { "do": "mark", "note": "(1) BATTERY を押しても両席のミニマムは残る" },
    { "do": "set", "note": "機長の RA のミニマム 200 ft", "dref": "sim/cockpit2/gauges/actuators/radio_altimeter_bug_ft_pilot", "value": 200 },
    { "do": "set", "note": "副操縦士の RA のミニマム 210 ft", "dref": "sim/cockpit2/gauges/actuators/radio_altimeter_bug_ft_copilot", "value": 210 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "BATTERY を押す（OFF）", "name": "laminar/B747/button_switch/elec_battery", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "機長の RA のミニマムは残る（前は -1）", "dref": "sim/cockpit2/gauges/actuators/radio_altimeter_bug_ft_pilot", "op": "==", "value": 200 },
    { "do": "check", "note": "副操縦士の RA のミニマムも", "dref": "sim/cockpit2/gauges/actuators/radio_altimeter_bug_ft_copilot", "op": "==", "value": 210 },
    { "do": "cmd", "note": "BATTERY を押す（ON に戻す）", "name": "laminar/B747/button_switch/elec_battery", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "BATTERY は ON", "dref": "laminar/B747/button_switch/position[13]", "op": ">", "value": 0.9 },
    { "do": "check", "note": "ミニマムはまだ残る", "dref": "sim/cockpit2/gauges/actuators/radio_altimeter_bug_ft_pilot", "op": "==", "value": 200 },

    { "do": "mark", "note": "(2) X-Plane 標準の発電機のコマンドと FIELD OFF" },
    { "do": "check", "note": "GEN CONT 1 は ON", "dref": "laminar/B747/button_switch/position[22]", "op": ">", "value": 0.9 },
    { "do": "check", "note": "界磁 1 は閉", "dref": "laminar/B747/electrical/gen_field_open[0]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "sim/electrical/generator_1_off", "name": "sim/electrical/generator_1_off", "duration": 0.2 },
    { "do": "wait", "note": "GEN CONT 1 が OFF に動く（前は動かなかった）", "dref": "laminar/B747/button_switch/position[22]", "op": "<", "value": 0.1, "timeout": 5 },
    { "do": "wait", "note": "ELEC GEN OFF 1", "dref": "laminar/B747/CAS/advisory_status[100]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "界磁 1 が開（FCOM p.788）", "dref": "laminar/B747/electrical/gen_field_open[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "整備パネルの FIELD OFF 1 が点く（annunciator 88）", "dref": "laminar/B747/annunciator/brightness_ratio[88]", "op": ">", "value": 0.05 },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "maint_field_off_1" },
    { "do": "cmd", "note": "sim/electrical/generator_1_on", "name": "sim/electrical/generator_1_on", "duration": 0.2 },
    { "do": "wait", "note": "GEN CONT 1 が ON に動く", "dref": "laminar/B747/button_switch/position[22]", "op": ">", "value": 0.9, "timeout": 5 },
    { "do": "wait", "note": "界磁 1 が閉に戻る", "dref": "laminar/B747/electrical/gen_field_open[0]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "wait", "note": "ELEC GEN OFF 1 が消える", "dref": "laminar/B747/CAS/advisory_status[100]", "op": "==", "value": 0, "timeout": 10 },

    { "do": "mark", "note": "(3) SSB OPEN" },
    { "do": "check", "note": "SSB は閉（エンジンの発電機で）", "dref": "laminar/B747/electrical/breaker/ssb", "op": "==", "value": 1 },
    { "do": "check", "note": "SSB OPEN は消灯（annunciator 94）", "dref": "laminar/B747/annunciator/brightness_ratio[94]", "op": "<", "value": 0.05 },

    { "do": "mark", "note": "(4) 地上でも CDU で選んだ VREF の着陸のフラップが残る" },
    { "do": "set", "note": "VREF 150（APPROACH REF の入力と同じ dataref）", "dref": "laminar/B747/airspeed/Vref", "value": 150 },
    { "do": "set", "note": "着陸のフラップ 30（2）", "dref": "laminar/B747/airspeed/VrefFlap", "value": 2 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "地上（電波高度 5 ft 未満）でも残る（FCOM p.973。前は毎フレーム 0）", "dref": "laminar/B747/airspeed/VrefFlap", "op": "==", "value": 2 },
    { "do": "view", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_ref_bug_ground" },
    { "do": "set", "note": "着陸のフラップを戻す", "dref": "laminar/B747/airspeed/VrefFlap", "value": 0 },

    { "do": "mark", "note": "(5) APU の燃料弁が閉で固着：始動が止まる" },
    { "do": "set", "note": "APU の燃料弁の故障（燃料の弁の 21 番目：apu）", "dref": "laminar/B747/fuel/fail/valve[20]", "value": 1 },
    { "do": "cmd", "note": "APU の選択器を ON", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "START（離すと ON に戻る）", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "wait", "note": "X-Plane の APU の始動（扉が開いてから）", "dref": "sim/cockpit2/electrical/APU_starter_switch", "op": "==", "value": 2, "timeout": 30 },
    { "do": "check", "note": "APU の燃料弁は閉のまま", "dref": "laminar/B747/fuel/main2_tank/apu_vlv_pos", "op": "<", "value": 0.5 },
    { "do": "wait", "note": "弁の時間と余裕の後に止まる（推定の 6 秒）", "dref": "sim/cockpit2/electrical/APU_starter_switch", "op": "==", "value": 0, "timeout": 12 },
    { "do": "check", "note": "APU の advisory", "dref": "laminar/B747/CAS/advisory_status[13]", "op": "==", "value": 1 },
    { "do": "cas", "note": "APU の始動が止まった所" },
    { "do": "cmd", "note": "APU の選択器を OFF", "name": "laminar/B747/electrical/apu/sel_dial_dn", "duration": 0.2 },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/fuel/fail/valve[20]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "選択器 OFF で APU の advisory は消える", "dref": "laminar/B747/CAS/advisory_status[13]", "op": "==", "value": 0 },

    { "do": "cas", "note": "終わり" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
