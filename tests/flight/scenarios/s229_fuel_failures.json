{
  "name": "s229_fuel_failures",
  "description": "燃料の故障の入力（2026-11-04、故障の窓の F0：notes/ATA-28.md §11）の X-Plane での確認、空中。銚子沖の 10,000 ft で開始（主ポンプは空中開始で ON）。主 2 AFT のポンプの故障：FUEL PUMP 2 AFT と PRESS 灯。主 2 の 2 台とも故障で X FEED 2 を閉じると吸引供給で FUEL PRESS ENG 2（FUEL PUMP は抑止）、エンジン 2 は回り続ける（FCOM p.1477、p.1582）。X FEED 1 の弁の固着：スイッチ OFF でも開いたままで FUEL X FEED 1 と VALVE 灯（FCOM p.1479）。温度計：FUEL TEMP SYS（p.1478）。FJCC A：>FUEL JETT A、両方：FUEL JETT SYS（p.1474）。FUEL synoptic と頭上パネルを撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 148.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "drefs": [ "laminar/B747/button_switch/position[57]", "laminar/B747/button_switch/position[61]", "laminar/B747/button_switch/position[49]", "laminar/B747/fuel/light/pump_press[2]", "laminar/B747/fuel/light/pump_press[3]" ] },
    { "do": "check", "note": "主 2 AFT のポンプは動いている（PRESS 灯なし）", "dref": "laminar/B747/fuel/light/pump_press[3]", "op": "==", "value": 0 },
    { "do": "set", "note": "下の EICAS を FUEL の synoptic に", "dref": "laminar/B747/dsp/synoptic_display", "value": 4 },

    { "do": "mark", "note": "主 2 のポンプ" },
    { "do": "set", "note": "主 2 AFT のポンプの故障", "dref": "laminar/B747/fuel/fail/pump[3]", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "FUEL PUMP 2 AFT", "dref": "laminar/B747/CAS/advisory_status[162]", "op": "==", "value": 1, "cite": "FCOM p.1477" },
    { "do": "check", "note": "PRESS 灯", "dref": "laminar/B747/fuel/light/pump_press[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "1 台では FUEL PRESS ENG 2 は出ない", "dref": "laminar/B747/CAS/caution_status[33]", "op": "==", "value": 0 },
    { "do": "set", "note": "主 2 FWD のポンプの故障", "dref": "laminar/B747/fuel/fail/pump[2]", "value": 1 },
    { "do": "switch", "note": "X FEED 2 OFF", "dref": "laminar/B747/button_switch/position[49]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_2" },
    { "do": "wait", "note": "吸引供給：FUEL PRESS ENG 2", "dref": "laminar/B747/CAS/caution_status[33]", "op": "==", "value": 1, "timeout": 30, "cite": "FCOM p.1477" },
    { "do": "check", "note": "FUEL PUMP 2 AFT は抑止", "dref": "laminar/B747/CAS/advisory_status[162]", "op": "==", "value": 0, "cite": "FCOM p.1582" },
    { "do": "check", "note": "エンジン 2 は回っている（吸引供給）", "dref": "sim/flightmodel/engine/ENGN_running[1]", "op": "==", "value": 1 },
    { "do": "cas", "note": "主 2 の吸引供給" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "fuel_suction_main2" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/fuel/fail/pump[2]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/fuel/fail/pump[3]", "value": 0 },
    { "do": "switch", "note": "X FEED 2 ON", "dref": "laminar/B747/button_switch/position[49]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_2" },
    { "do": "wait", "note": "FUEL PRESS ENG 2 が消える", "dref": "laminar/B747/CAS/caution_status[33]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "mark", "note": "X FEED 1 の固着" },
    { "do": "set", "note": "X FEED 1 の弁の固着", "dref": "laminar/B747/fuel/fail/valve[0]", "value": 1 },
    { "do": "switch", "note": "X FEED 1 OFF", "dref": "laminar/B747/button_switch/position[48]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "wait", "note": "FUEL X FEED 1（弁が指令と不一致）", "dref": "laminar/B747/CAS/advisory_status[175]", "op": "==", "value": 1, "timeout": 40, "cite": "FCOM p.1479" },
    { "do": "check", "note": "X FEED 1 の VALVE 灯", "dref": "laminar/B747/fuel/light/xfeed_valve[0]", "op": "==", "value": 1 },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_xfeed1_stuck" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/fuel/fail/valve[0]", "value": 0 },
    { "do": "switch", "note": "X FEED 1 ON", "dref": "laminar/B747/button_switch/position[48]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "wait", "note": "FUEL X FEED 1 が消える", "dref": "laminar/B747/CAS/advisory_status[175]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "mark", "note": "温度計と FJCC" },
    { "do": "set", "note": "温度計の故障", "dref": "laminar/B747/fuel/fail/temp", "value": 1 },
    { "do": "set", "note": "FJCC A の故障", "dref": "laminar/B747/fuel/fail/fjcc[0]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FUEL TEMP SYS", "dref": "laminar/B747/CAS/advisory_status[173]", "op": "==", "value": 1, "cite": "FCOM p.1478" },
    { "do": "check", "note": ">FUEL JETT A", "dref": "laminar/B747/CAS/advisory_status[151]", "op": "==", "value": 1, "cite": "FCOM p.1474" },
    { "do": "set", "note": "FJCC B の故障", "dref": "laminar/B747/fuel/fail/fjcc[1]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "両方：FUEL JETT SYS", "dref": "laminar/B747/CAS/caution_status[31]", "op": "==", "value": 1, "cite": "FCOM p.1474" },
    { "do": "check", "note": ">FUEL JETT A は抑止", "dref": "laminar/B747/CAS/advisory_status[151]", "op": "==", "value": 0 },
    { "do": "cas", "note": "温度計と FJCC" },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_fuel_jett_sys" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/fuel/fail/temp", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/fuel/fail/fjcc[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/fuel/fail/fjcc[1]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FUEL JETT SYS が消える", "dref": "laminar/B747/CAS/caution_status[31]", "op": "==", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
