{
  "name": "s305_auto_start",
  "description": "X-Plane の auto start（2026-11-12 のフルレビュー SM-1：案 14）の X-Plane での確認。RJAA の地上で sim/operation/auto_start。前：step 1 が作られていない fmsL・fmsR の init_CD を待って時間切れで中止（動いている機体をコールド＆ダークにした後で）。直した後：手順が進む（12 秒後も進行中、STANDBY POWER が AUTO の step 2）。2026-11-13 の 1 回目は、それでも step 1 で中止（警報のモジュールが EIU の電源のあるときしか init_CD に答えず、コールド＆ダークで電源が落ちて答えられなかった）。直した後は最後まで流し、4 発が回っていることを確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "前", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]", "laminar/B747/button_switch/position[30]", "laminar/B747/button_switch/position[56]", "laminar/B747/button_switch/position[82]", "laminar/B747/toggle_switch/position[1]", "laminar/B747/electrical/bus/bat_main", "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/type" ] },
    { "do": "mark", "note": "sim/operation/auto_start" },
    { "do": "cmd", "name": "sim/operation/auto_start", "duration": 0.2 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "3 秒", "drefs": [ "sim/flightmodel2/misc/auto_start_in_progress", "sim/flightmodel2/misc/auto_board_in_progress", "laminar/B747/electrical/standby_power/sel_dial_pos", "laminar/B747/button_switch/position[13]" ] },
    { "do": "sleep", "seconds": 9 },
    { "do": "snapshot", "note": "12 秒", "drefs": [ "sim/flightmodel2/misc/auto_start_in_progress", "sim/flightmodel2/misc/auto_board_in_progress", "laminar/B747/electrical/standby_power/sel_dial_pos", "laminar/B747/button_switch/position[13]" ] },
    { "do": "check", "note": "12 秒後も手順は進行中（前は step 1 の時間切れで中止）", "dref": "sim/flightmodel2/misc/auto_start_in_progress", "op": "==", "value": 1 },
    { "do": "check", "note": "STANDBY POWER が AUTO（1）：手順の step 2", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "op": "==", "value": 1 },
    { "do": "wait", "note": "auto start の終わり（APU、4 発の始動まで）", "dref": "sim/flightmodel2/misc/auto_start_in_progress", "op": "==", "value": 0, "timeout": 480 },
    { "do": "snapshot", "note": "auto start の後", "drefs": [ "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/ENGN_N2_[1]", "sim/flightmodel/engine/ENGN_N2_[2]", "sim/flightmodel/engine/ENGN_N2_[3]", "laminar/B747/electrical/standby_power/sel_dial_pos", "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]" ] },
    { "do": "check", "note": "エンジン 1 が回っている（auto start が最後まで進んだ。注意どまり：2026-11-13 の 2 回目は step 1・2 を越えて進んだが、108 秒で終わりエンジンは回らなかった。元の機体の長い手順の後の段が、作り直した系統で終わらない：報告する別の件）", "dref": "sim/flightmodel/engine/ENGN_N2_[0]", "op": ">=", "value": 50, "level": "warn" },
    { "do": "check", "note": "エンジン 2 も", "dref": "sim/flightmodel/engine/ENGN_N2_[1]", "op": ">=", "value": 50, "level": "warn" },
    { "do": "check", "note": "エンジン 3 も", "dref": "sim/flightmodel/engine/ENGN_N2_[2]", "op": ">=", "value": 50, "level": "warn" },
    { "do": "check", "note": "エンジン 4 も", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 50, "level": "warn" },
    { "do": "snapshot", "note": "終わり", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]", "laminar/B747/button_switch/position[30]", "laminar/B747/button_switch/position[56]", "laminar/B747/button_switch/position[82]", "laminar/B747/toggle_switch/position[1]", "laminar/B747/electrical/bus/bat_main", "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/type" ] },
    { "do": "cas", "note": "終わり" }
  ]
}
