{
  "name": "s163_flight_complete",
  "description": "6-1/6-2 段 10d（flight complete）の X-Plane での確認。s114 と同じ RJAA 34L の進入路の 12 NM・2,500 ft から（機体を読み直す）、FMC に RJBB→RJAA の経路（FLT NO TEST123、ARRIVALS の ILS34L：ILS は FMC の A）、PERF INIT（ZFW 220、COST INDEX 100、CRZ ALT FL350）、REF NAV DATA の NAVAID INHIBIT NRE、POS REF の GPS NAV INHIBIT を入れて自動着陸。止まってから 4 発の FUEL CONTROL を CUTOFF、N2 が落ちて 30 秒の手前は経路が残り、30 秒を過ぎると有効な経路・FLT NO・PERF INIT・REF NAV DATA の抑止が消え、GPS NAV は INHIBIT> に戻り、ILS は PARK（FCOM p.1236、p.1290、p.1307、p.1356–1357、p.1369；FMSPG p.78、p.97）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "スピードブレーキを ARM", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "set", "note": "オートブレーキ 2", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 4 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },

    { "do": "mark", "note": "FMC のデータ" },
    { "do": "cdu", "note": "RTE：RJBB→RJAA、FLT NO TEST123", "keys": ["RTE", "RJBB", "L1", "RJAA", "R1", "TEST123", "R2"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>、NEXT、ILS34L（R3）", "keys": ["R2", "NEXT", "R3"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF（空中は APPROACH REF）、<INDEX、PERF：ZFW 220、COST INDEX 100、CRZ ALT FL350", "keys": ["INITREF", "L6", "L3", "220", "L3", "100", "L5", "350", "R1"] },
    { "do": "cdu", "note": "CLR を 3 回（進入中の CRZ ALT FL350 の UNABLE CRZ ALT を消す：出ている間は文字が入らない。初めの 2 回（2026-11-01 6:37、6:43）は NRE が入らなかった）、INIT REF、<INDEX、NAV DATA>、NAVAID INHIBIT に NRE（SELECT DESIRED WPT なら最初）", "keys": ["CLR", "CLR", "CLR", "INITREF", "L6", "R1", "NRE", "L4", "?SEL"] },
    { "do": "check", "note": "NAVAID INHIBIT は NRE", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^NRE" },
    { "do": "cdu", "note": "INIT REF、<INDEX、<POS（空中は POS REF 2/3）、GPS NAV INHIBIT>", "keys": ["INITREF", "L6", "L2", "R5"] },
    { "do": "check", "note": "ENABLE>", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "ENABLE>$" },
    { "do": "cdu", "note": "RTE", "keys": ["RTE"] },
    { "do": "check", "note": "RJBB と RJAA", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^RJBB +RJAA$" },
    { "do": "check", "note": "FLT NO TEST123", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "TEST123$" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ILS は FMC の A で 111.90", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },

    { "do": "mark", "note": "自動着陸" },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200 },
    { "do": "wait", "note": "FLARE", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 3, "timeout": 200 },
    { "do": "wait", "note": "ROLLOUT", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "wait", "note": "地上", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1, "timeout": 60 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる（対地 8 m/s の下）", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 8, "timeout": 90 },
    { "do": "cmd", "note": "操縦輪の解除スイッチで A/P を外す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "AUTOPILOT DISC を消す（2 回目）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },

    { "do": "mark", "note": "エンジン停止：30 秒の手前は残る" },
    { "do": "switch", "note": "FUEL CONTROL 1 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 3 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[2]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_3/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "エンジン 1 の N2 が ENG FAIL の速さの下", "dref": "laminar/B747/engines/inop[0]", "op": "==", "value": 1, "timeout": 90 },
    { "do": "wait", "note": "エンジン 2", "dref": "laminar/B747/engines/inop[1]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "wait", "note": "エンジン 3", "dref": "laminar/B747/engines/inop[2]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "wait", "note": "エンジン 4（4 発とも止まった）", "dref": "laminar/B747/engines/inop[3]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 22, "note": "停止から 30 秒の手前" },
    { "do": "check", "note": "まだ経路がある", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^RJBB +RJAA$" },

    { "do": "mark", "note": "30 秒を過ぎて flight complete" },
    { "do": "sleep", "seconds": 12 },
    { "do": "check", "note": "有効な経路が消える（FMSPG p.78）：ORIGIN と DEST は箱", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^[*]{4} +[*]{4}$" },
    { "do": "check", "note": "FLT NO はダッシュ（FCOM p.1290）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "-{8}$" },
    { "do": "check", "note": "PERF INIT の COST INDEX は箱（FCOM p.1307）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"costindex\":\"****\"" },
    { "do": "check", "note": "CRZ ALT も（FMSPG p.97）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"crzalt\":\"*****\"" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_rte_cleared" },
    { "do": "cdu", "note": "INIT REF（地上は PERF INIT）", "keys": ["INITREF"] },
    { "do": "shot", "name": "cdu_perf_init_cleared" },
    { "do": "cdu", "note": "<INDEX、NAV DATA>", "keys": ["L6", "R1"] },
    { "do": "check", "note": "NAVAID INHIBIT はダッシュ（FCOM p.1356）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^---- +----$" },
    { "do": "cdu", "note": "<INDEX、<POS（地上は POS INIT）、NEXT（POS REF 2/3）", "keys": ["L6", "L2", "NEXT"] },
    { "do": "check", "note": "GPS NAV は INHIBIT> に戻る（FCOM p.1369）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "INHIBIT>$" },
    { "do": "check", "note": "ILS は PARK、PFD の目盛なし", "dref": "laminar/B747/autopilot/ils_dots", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
