    { "do": "set", "note": "-", "dref": "laminar/B747/failures/test_click", "value": 6000 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "-", "dref": "laminar/B747/failures/test_click", "value": 6000 },
