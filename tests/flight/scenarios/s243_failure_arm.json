{
  "name": "s243_failure_arm",
  "description": "故障の窓の F2（notes/FAILURES.md）：故障を後で起こす arm。成田 34L でエンジン運転中に窓を開き、test_click で ARM と arm の帯を押す。IN TIME 1 分で ENGINE PUMP 1、RANDOM 1 分以内で ENGINE PUMP 2、AT ALTITUDE 1000 ft（気圧設定を 1 inHg 上げて指示高度を 1000 ft 上げる）で ENGINE PUMP 3、AT SPEED 40 kt（離陸滑走）で X-Plane の ICE DETECTORS。行を押すと arm が解け、REPAIR ALL で全部直り arm も解ける",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
