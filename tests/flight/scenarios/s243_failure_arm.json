    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "IN TIME 1 分" },
    { "do": "set", "note": "ENGINE PUMP 1 の ARM", "dref": "laminar/B747/failures/test_click", "value": 4001 },
    { "do": "sleep", "seconds": 1 },
