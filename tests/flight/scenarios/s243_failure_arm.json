    { "do": "check", "note": "arm は消えた", "dref": "laminar/B747/failures/armed", "op": "==", "value": 0 },

    { "do": "mark", "note": "RANDOM 1 分以内" },
    { "do": "set", "note": "ENGINE PUMP 2 の ARM", "dref": "laminar/B747/failures/test_click", "value": 4002 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "RANDOM", "dref": "laminar/B747/failures/test_click", "value": 5004 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "RANDOM の 30 分以内", "dref": "laminar/B747/failures/arm_value", "op": "==", "value": 30 },
