    { "do": "set", "note": "パーキングブレーキのレバーを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "set", "note": "推力 0.5", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.5 },
    { "do": "wait", "note": "40 kt で X-Plane の rel_ice_detect が 6", "dref": "sim/operation/failures/rel_ice_detect", "op": "==", "value": 6, "timeout": 60 },
