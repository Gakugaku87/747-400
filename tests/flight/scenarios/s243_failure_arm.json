    { "do": "shot", "name": "window_arm_bar" },
    { "do": "set", "note": "ARM（地上の約 140 ft から：1000 ft 以上で）", "dref": "laminar/B747/failures/test_click", "value": 6002 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "1 つ arm", "dref": "laminar/B747/failures/armed", "op": "==", "value": 1 },
    { "do": "check", "note": "地上ではまだ", "dref": "laminar/B747/hydraulics/fail/edp[2]", "op": "==", "value": 0 },
    { "do": "set", "note": "気圧設定 30.92 inHg：指示高度が約 1000 ft 上がる", "dref": "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "value": 30.92 },
