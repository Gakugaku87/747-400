    { "do": "snapshot", "note": "その時の指示高度", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "set", "note": "気圧設定を戻す", "dref": "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "value": 29.92 },

    { "do": "mark", "note": "行を押すと arm が解ける" },
