    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "5 → 3 → 2 → 1 分", "dref": "laminar/B747/failures/arm_value", "op": "==", "value": 1 },
    { "do": "set", "note": "ARM", "dref": "laminar/B747/failures/test_click", "value": 6002 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "1 つ arm", "dref": "laminar/B747/failures/armed", "op": "==", "value": 1 },
    { "do": "check", "note": "帯は閉じた", "dref": "laminar/B747/failures/arm_value", "op": "==", "value": -1 },
