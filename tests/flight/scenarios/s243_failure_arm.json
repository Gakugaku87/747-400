    { "do": "set", "note": "ARM", "dref": "laminar/B747/failures/test_click", "value": 6002 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "1 つ arm", "dref": "laminar/B747/failures/armed", "op": "==", "value": 1 },
    { "do": "wait", "note": "1 分以内のどこかで故障", "dref": "laminar/B747/hydraulics/fail/edp[1]", "op": "==", "value": 1, "timeout": 75 },
    { "do": "check", "note": "arm は消えた", "dref": "laminar/B747/failures/armed", "op": "==", "value": 0 },

    { "do": "mark", "note": "AT ALTITUDE 1000 ft" },
