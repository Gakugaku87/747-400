    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "AT SPEED", "dref": "laminar/B747/failures/test_click", "value": 5003 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "100 kt", "dref": "laminar/B747/failures/arm_value", "op": "==", "value": 100 },
