{
  "name": "s93_offset",
  "description": "FMC のオフセット（6-1・6-2 段 7d）の X-Plane での確認、空中。RJAA→XAC の脚の上、XAC の 15 nm 手前、10,000 ft、250 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DIRECT XAC・SPENS を入れ、ACTIVATE と EXEC、LNAV。空中の RTE ページの 6R に OFFSET（FCOM p.1298；FMSPG p.155）、R5 で EXEC：右に回ってオフセットのコースを捕まえる（FCOM p.1298）、CDU の OFST 灯（FCOM p.1210）、XAC の角を fly-by で回る。オフセットの終わり（経路の終わり SPENS の横）の 5 nm 手前で END OF OFFSET（FCOM p.1431；FMSPG p.155）。DIRECT TO SPENS でオフセットが消える（FCOM p.1299；FMSPG p.156）。CDU と ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.91121, "longitude": 139.59895, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（脚の向き：真 217）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DIRECT XAC・SPENS、ACTIVATE と EXEC、LNAV" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL"] },
    { "do": "cdu", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS、現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "脚の上なので LNAV がすぐ engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 30 },
    { "do": "check", "note": "OFST 灯は消えている", "dref": "laminar/B747/fms/ofst_light", "op": "==", "value": 0 },

    { "do": "mark", "note": "RTE の 6R に OFFSET（空中、SID・STAR の上でない：FCOM p.1298；FMSPG p.155）。R5 で EXEC" },
    { "do": "cdu", "keys": ["RTE"] },
    { "do": "check", "note": "1 ページ目の破線は 8 行目（FCOM p.1293 の図：段 7e4。6L の上の線は 2 ページ目から）", "dref": "laminar/B747/fms3/Line08_L", "op": "==", "value": "------------------------" },
    { "do": "check", "note": "OFFSET の見出し（小字）", "dref": "laminar/B747/fms3/Line12_S", "op": "contains", "value": "OFFSET" },
    { "do": "check", "note": "オフセットが無いのでダッシュ", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "---" },
    { "do": "cdu", "note": "R5 と打って 6R（= はキーの名前でない文字の印）", "keys": ["=R5", "R6"] },
    { "do": "check", "note": "MOD RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1" },
    { "do": "check", "note": "R5", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "R5" },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "check", "note": "LNAV の XTK はオフセットの線から：左に約 5 nm", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-5.6, -4.4] },
    { "do": "check", "note": "OFST 灯（LNAV がオフセットを誘導：FCOM p.1210）", "dref": "laminar/B747/fms/ofst_light", "op": "==", "value": 1 },
    { "do": "check", "note": "右へ回す（FCOM p.1298：捕捉の旋回）", "dref": "laminar/B747/fms/lnav/roll", "op": ">", "value": 5 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_rte_offset" },
    { "do": "view", "name": "forward" },
    { "do": "watch", "note": "オフセットのコースを捕まえる（6 nm を超えて離れない）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 6, "until": { "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.2, 0.2] }, "timeout": 240 },
    { "do": "switch", "note": "ND の表示範囲 20 nm（つまみのコマンドで）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/range/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/range/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND：経路の線はもとの経路（X-Plane の線は 1 本：オフセットの線は描かない）", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_on_offset" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "XAC の角を fly-by（右に約 53°）" },
    { "do": "cdu", "note": "LEGS（現用点を見る）", "keys": ["LEGS"] },
    { "do": "check", "note": "現用点はまだ XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "watch", "note": "XAC の角まで 0.5 nm 以内（旋回の前半を含む）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "until": { "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SPENS" }, "timeout": 300 },
    { "do": "watch", "note": "旋回の後半も 0.5 nm 以内", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "timeout": 30 },
    { "do": "check", "note": "まだオフセットの上（OFST 灯）", "dref": "laminar/B747/fms/ofst_light", "op": "==", "value": 1 },

    { "do": "mark", "note": "オフセットの終わり（経路の終わり SPENS の横）の 5 nm 手前で END OF OFFSET（FCOM p.1431；FMSPG p.155）" },
    { "do": "cdu", "keys": ["LEGS"] },
    { "do": "wait", "note": "END OF OFFSET", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "END OF OFFSET", "timeout": 420 },
    { "do": "check", "note": "SPENS の横まで 5 nm ほど（ND の距離は SPENS まで）", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "SPENS" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_end_of_offset" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "keys": ["CLR"] },

    { "do": "mark", "note": "DIRECT TO SPENS：オフセットが消える（FCOM p.1299；FMSPG p.156）" },
    { "do": "cdu", "keys": ["SPENS", "L1", "?SEL", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "OFST 灯が消える", "dref": "laminar/B747/fms/ofst_light", "op": "==", "value": 0 },
    { "do": "cdu", "keys": ["RTE"] },
    { "do": "check", "note": "RTE の OFFSET はダッシュ", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "---" },
    { "do": "watch", "note": "SPENS へ直行（0.5 nm 以内）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "timeout": 30 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
