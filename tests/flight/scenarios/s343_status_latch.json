{
  "name": "s343_status_latch",
  "description": "STATUS のラッチ（N19-WARN-03、notes/ATA-31-warning.md §13）の X-Plane での確認、地上。エンジン運転中で開始し、DRIVE DISC 4 を押す。STATUS ページの DRIVE DISC 4 は EIU の NVM にラッチし（laminar/B747/CAS/status_nvm[28] が 2）、IDG を戻しても（drive_disc_status[3] を 0：地上の整備のリセット）残る（LH24 p.64）。機長の CDU の MENU → <CMC → <PRESENT LEG FAULTS に「*STATUS:」と「DRIVE DISC 4  ERASE>」（LH24 p.65）、1R の ERASE> で STATUS ページから消える。EIU の電源断で残ることは X-Plane の外の試験（tests/warning/status_nvm_module_test.lua）で見る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "開始：DRIVE DISC 4 はラッチしていない", "dref": "laminar/B747/CAS/status_nvm[28]", "op": "==", "value": 0 },
    { "do": "cas", "note": "開始直後" },

    { "do": "mark", "note": "DRIVE DISC 4" },
    { "do": "cmd", "note": "DRIVE DISC 4 を押す", "name": "laminar/B747/button_switch/elec_drive_disc_4" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": ">DRIVE DISC 4（FCOM p.821）", "dref": "laminar/B747/CAS/advisory_status[86]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS の条件 DRIVE DISC 4", "dref": "laminar/B747/CAS/status_status[28]", "op": "==", "value": 1 },
    { "do": "wait", "note": "EIU の NVM にラッチ（LH24 p.64）", "dref": "laminar/B747/CAS/status_nvm[28]", "op": "==", "value": 2, "timeout": 5 },
    { "do": "check", "note": "STATUS ページの先頭に DRIVE DISC 4（新しいものが上：LH_MAN p.52）", "dref": "laminar/B747/CAS/gen_status_msg_000", "op": "==", "value": "DRIVE DISC 4" },

    { "do": "mark", "note": "IDG 4 を戻す" },
    { "do": "set", "note": "地上の整備のリセット（elec_model：DRIVE DISC の印を戻すと地上で再接続）", "dref": "laminar/B747/electrical/generator/drive_disc_status[3]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "IDG 4 が戻る", "dref": "laminar/B747/electrical/idg_connected[3]", "op": "==", "value": 1 },
    { "do": "check", "note": ">DRIVE DISC 4 が消える", "dref": "laminar/B747/CAS/advisory_status[86]", "op": "==", "value": 0 },
    { "do": "check", "note": "STATUS の条件は消える", "dref": "laminar/B747/CAS/status_status[28]", "op": "==", "value": 0 },
    { "do": "check", "note": "ラッチしたまま（LH24 p.64：IDG を戻しても出たまま）", "dref": "laminar/B747/CAS/status_nvm[28]", "op": "==", "value": 2 },
    { "do": "check", "note": "STATUS ページに DRIVE DISC 4 が残る", "dref": "laminar/B747/CAS/gen_status_msg_000", "op": "==", "value": "DRIVE DISC 4" },
    { "do": "cmd", "note": "STAT：STATUS ページ", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "status_page_drive_disc_4_latched" },

    { "do": "mark", "note": "CMC の ERASE" },
    { "do": "cdu", "note": "MENU、<CMC、<PRESENT LEG FAULTS", "keys": ["MENU", "L6", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PRESENT LEG FAULTS（LH24 p.65）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PRESENT LEG FAULTS" },
    { "do": "check", "note": "1L：DRIVE DISC 4 と ERASE>", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "DRIVE DISC 4      ERASE>" },
    { "do": "cdu", "note": "1R：ERASE>", "keys": ["R1"] },
    { "do": "wait", "note": "NVM から消える", "dref": "laminar/B747/CAS/status_nvm[28]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "STATUS ページから消える（LH24 p.64-65）", "dref": "laminar/B747/CAS/gen_status_msg_000", "op": "!=", "value": "DRIVE DISC 4" },
    { "do": "check", "note": "PRESENT LEG FAULTS からも消える", "dref": "laminar/B747/fms3/Line03_L", "op": "!=", "value": "DRIVE DISC 4      ERASE>" },
    { "do": "shot", "name": "status_page_after_erase" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
