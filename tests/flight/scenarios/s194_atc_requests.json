{
  "name": "s194_atc_requests",
  "description": "6-1・6-2 段 12g2a（ATC の要求のページ）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO に戻す、保存はしない）。AutoATC の無いこの PC では送れないので、ATC INDEX の <REQUEST から ATC REQUEST、高度の入力で ATC ALT REQUEST、DUE TO WEATHER の選択、NEXT で SPEED と ROUTE、VERIFY REQUEST の行（REQUEST CLIMB TO、/DUE TO、/REQUEST、/REQUEST HEADING、CONTINUED）と 2 ページ目の DATA LINK NO COMM、ERASE REQUEST、ATC INDEX の VOICE> を確かめる。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "ATC キー（LOGON/STATUS）、<INDEX、<REQUEST", "keys": ["ATC", "L6", "L2"] },
    { "do": "check", "note": "ATC REQUEST", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC REQUEST" },
    { "do": "check", "note": "ALTITUDE の dashes", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<-----" },
    { "do": "cdu", "note": "1L に FL350", "keys": ["FL350", "L1"] },
    { "do": "check", "note": "高度の入力で ATC ALT REQUEST（FCOM p.737）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC ALT REQUEST" },
    { "do": "check", "note": "FL350", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "FL350" },
    { "do": "check", "note": "REQUEST CRZ CLB の見出し", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "REQUEST" },
    { "do": "cdu", "note": "4R の DUE TO WEATHER", "keys": ["R4"] },
    { "do": "check", "note": "WEATHER が大きい字に", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "WEATHER" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_atc_alt_request" },
    { "do": "cdu", "note": "NEXT（SPEED）、1L に .86", "keys": ["NEXT", ".86", "L1"] },
    { "do": "check", "note": "ATC SPEED REQUEST の .86", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": ".86" },
    { "do": "cdu", "note": "NEXT 2 回（ROUTE）、1R に 270", "keys": ["NEXT", "NEXT", "270", "R1"] },
    { "do": "check", "note": "ATC ROUTE REQUEST の HEADING 270", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "270" },
    { "do": "cdu", "note": "VERIFY>", "keys": ["R6"] },
    { "do": "check", "note": "VERIFY REQUEST", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "VERIFY REQUEST" },
    { "do": "check", "note": "地上なので REQUEST CLIMB TO", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "REQUEST CLIMB TO" },
    { "do": "check", "note": "/DUE TO", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "/DUE TO" },
    { "do": "check", "note": "/REQUEST HEADING", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "/REQUEST HEADING" },
    { "do": "check", "note": "続きがあるので CONTINUED", "dref": "laminar/B747/fms3/Line12_S", "op": "contains", "value": "CONTINUED" },
    { "do": "shot", "name": "cdu_verify_request_1" },
    { "do": "cdu", "note": "NEXT（自由文と SEND の欄）", "keys": ["NEXT"] },
    { "do": "check", "note": "AutoATC が無いので NO COMM", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "NO COMM" },
    { "do": "check", "note": "DATA LINK の見出し", "dref": "laminar/B747/fms3/Line10_S", "op": "contains", "value": "DATA LINK" },
    { "do": "shot", "name": "cdu_verify_request_2" },
    { "do": "cdu", "note": "<REQUEST", "keys": ["L6"] },
    { "do": "check", "note": "<ERASE REQUEST", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "<ERASE REQUEST" },
    { "do": "cdu", "note": "<ERASE REQUEST", "keys": ["L5"] },
    { "do": "check", "note": "消えて dashes", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<-----" },
    { "do": "cdu", "note": "<INDEX、VOICE>", "keys": ["L6", "R5"] },
    { "do": "check", "note": "REQUEST VOICE CONTACT（FMSPG p.300）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "REQUEST VOICE CONTACT" },
    { "do": "check", "note": "ATC INDEX から来たので <INDEX", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<INDEX" },
    { "do": "shot", "name": "cdu_verify_voice" },
    { "do": "cdu", "note": "<INDEX", "keys": ["L6"] },
    { "do": "check", "note": "ATC INDEX", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC INDEX" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
