{
  "name": "s160_pos_ref",
  "description": "6-1/6-2 段 10a（FMC の位置の更新と航法性能、POS REF 2/3・3/3、ND の更新の表示、UNABLE RNP）の X-Plane での確認。空中、成田の北の FL350（機体を読み直す、経路なし）。ND の GPS と IRS (3)（FCOM p.1150）、INIT/REF INDEX の <POS で空中は POS REF 2/3（FCOM p.1367）、FMC POS (GPS L)、RNP/ACTUAL は国内の 2.00 小字と /0.05、DME-DME の局（FCOM p.1244、p.1368–1369）。GPS NAV INHIBIT> で ENABLE>・RADIO・ND の DD。RNP .01 で VERIFY RNP ENTRY と UNABLE RNP の advisory（FCOM p.1430、p.1436）、DELETE で 2.00 に戻り消える。BRG/DIST> で IRS の行が方位/距離、3/3 の IRS L・GPS L（抑止中は空白）。GPS を戻し、<PURGE・<CONFIRM で INERTIAL、10 秒で GPS L（FCOM p.1368）。CDU と EICAS を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため。初めの版（2026-11-01 5:34）の写真は CDU の左が隠れた）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "sleep", "seconds": 12, "note": "DME の局を探す（10 秒ごと）" },

    { "do": "mark", "note": "ND の更新の表示と POS REF 2/3" },
    { "do": "check", "note": "ND の FMC-GPS の更新は GPS（FCOM p.1150）", "dref": "laminar/B747/irs/gps_display_line", "op": "matches", "value": "^GPS$" },
    { "do": "check", "note": "ND の FMC-IRS は IRS (3)", "dref": "laminar/B747/irs/irs_display_line", "op": "matches", "value": "^IRS [(]3[)]$" },
    { "do": "cdu", "note": "INIT REF（空中は APPROACH REF）、<INDEX、<POS", "keys": ["INITREF", "L6", "L2"] },
    { "do": "check", "note": "空中で IRU が ATT でないので POS REF 2/3（FCOM p.1367）", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "2/3" },
    { "do": "check", "note": "1L FMC POS (GPS L) と GS", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ FMC POS [(]GPS L[)] +GS$" },
    { "do": "check", "note": "FMC の位置と GS（KT は小字）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^N3[56]`[0-9]{2}[.][0-9] E140`[0-9]{2}[.][0-9] +[0-9]{3}  $" },
    { "do": "check", "note": "2L IRS(3)", "dref": "laminar/B747/fms3/Line04_S", "op": "matches", "value": "^ IRS[(]3[)]" },
    { "do": "check", "note": "3R は DME-DME（成田の近く、FL350）", "dref": "laminar/B747/fms3/Line06_S", "op": "matches", "value": "^ RNP/ACTUAL +DME-DME$" },
    { "do": "check", "note": "3L は国内の 2.00 小字（経路なし、近くに局：推定の段階）", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "^2[.]00 +NM" },
    { "do": "check", "note": "ACTUAL は GPS の 0.05 大字、右に 2 局", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^ +/0[.]05 +[A-Z0-9]+ [A-Z0-9]+$" },
    { "do": "check", "note": "<PURGE と INHIBIT>", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<PURGE +INHIBIT>$" },
    { "do": "snapshot", "note": "POS REF 2/3", "drefs": [ "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line06_S", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line07_S", "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L", "laminar/B747/fms3/Line13_L" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_pos_ref_gps" },

    { "do": "mark", "note": "GPS NAV INHIBIT>：DME-DME" },
    { "do": "cdu", "note": "5R INHIBIT>", "keys": ["R5"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ENABLE>（FCOM p.1369）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "ENABLE>$" },
    { "do": "check", "note": "FMC POS (RADIO)", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ FMC POS [(]RADIO[)]" },
    { "do": "check", "note": "ND は DD（FCOM p.1150）", "dref": "laminar/B747/irs/gps_display_line", "op": "matches", "value": "^DD$" },
    { "do": "shot", "name": "cdu_pos_ref_radio" },

    { "do": "mark", "note": "RNP .01：VERIFY RNP ENTRY と UNABLE RNP" },
    { "do": "cdu", "note": ".01 を 3L", "keys": [".01", "L3"] },
    { "do": "check", "note": "ANP より小さい：VERIFY RNP ENTRY（FCOM p.1436）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "VERIFY RNP ENTRY" },
    { "do": "cdu", "note": "CLR", "keys": ["CLR"] },
    { "do": "check", "note": "RNP 0.01 の大字", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^0[.]01/0[.]0[5-9]" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "UNABLE RNP の advisory（FCOM p.1430：進入の外）", "dref": "laminar/B747/CAS/advisory_status[295]", "op": "==", "value": 1 },
    { "do": "check", "note": "caution ではない", "dref": "laminar/B747/CAS/caution_status[66]", "op": "==", "value": 0 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_unable_rnp" },
    { "do": "cdu", "note": "RNP の DELETE", "keys": ["DEL", "L3"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "2.00 の小字に戻る", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "^2[.]00" },
    { "do": "check", "note": "UNABLE RNP は消える", "dref": "laminar/B747/CAS/advisory_status[295]", "op": "==", "value": 0 },

    { "do": "mark", "note": "BRG/DIST> と 3/3" },
    { "do": "view", "note": "左の CDU に戻す（初めの版は EICAS のまま 3/3 と PURGE を撮った）", "the": -34, "psi": 24, "fov": 18 },
    { "do": "cdu", "note": "6R BRG/DIST>", "keys": ["R6"] },
    { "do": "check", "note": "LAT/LON>", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "LAT/LON>$" },
    { "do": "check", "note": "IRS の行は FMC の位置からの方位/距離（FCOM p.1244、p.1369）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^[0-9]{3}`/[0-9]+[.][0-9]" },
    { "do": "cdu", "note": "NEXT（3/3）", "keys": ["NEXT"] },
    { "do": "check", "note": "POS REF 3/3（FCOM p.1370）", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "3/3" },
    { "do": "check", "note": "IRS L と GS", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ IRS L +GS$" },
    { "do": "check", "note": "IRS L の方位/距離", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^[0-9]{3}`/[0-9]+[.][0-9]" },
    { "do": "check", "note": "GPS L は抑止中で空白", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^ *$" },
    { "do": "shot", "name": "cdu_pos_ref_3" },
    { "do": "cdu", "note": "PREV、LAT/LON>、ENABLE>", "keys": ["PREV", "R6", "R5"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "GPS L に戻る", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "[(]GPS L[)]" },
    { "do": "check", "note": "緯度経度に戻る", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^N3[56]`" },

    { "do": "mark", "note": "PURGE と CONFIRM" },
    { "do": "cdu", "note": "5L <PURGE", "keys": ["L5"] },
    { "do": "check", "note": "<CONFIRM（FCOM p.1368）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<CONFIRM" },
    { "do": "check", "note": "見出しは PURGE", "dref": "laminar/B747/fms3/Line10_S", "op": "matches", "value": "^PURGE +GPS NAV$" },
    { "do": "shot", "name": "cdu_pos_ref_purge" },
    { "do": "cdu", "note": "5L <CONFIRM", "keys": ["L5"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "混合 IRS の位置で INERTIAL（推定：10 秒は更新しない）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "[(]INERTIAL[)]" },
    { "do": "check", "note": "<PURGE に戻る", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<PURGE" },
    { "do": "sleep", "seconds": 11 },
    { "do": "check", "note": "GPS L で更新し直す", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "[(]GPS L[)]" },
    { "do": "check", "note": "ND は GPS", "dref": "laminar/B747/irs/gps_display_line", "op": "matches", "value": "^GPS$" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
