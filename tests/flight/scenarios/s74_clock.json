{
  "name": "s74_clock",
  "description": "時計（5-2 段 6a）の X-Plane での確認、地上。成田 34L に電源の無い状態で開始（機体を読み直す）。BATTERY OFF では main hot battery bus だけで表示は消え（FCOM p.1075）、BATTERY ON で X-Plane の UTC と日付、DATE で日・月、次に年（1 秒ずつ）、ET の RUN・HLD・RESET（ばねで HLD）、CHR の開始・保持・リセット（ET は裏で進む、グレアシールドのボタンも動く）、SET の HLD と MS（1 秒に 1 分）。副操縦士の時計は別。機長の時計を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": false } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/electrical/bus/hot_bat_main", "laminar/B747/electrical/bus/bat_apu",
      "sim/time/zulu_time_sec", "sim/cockpit2/clock_timer/zulu_day", "sim/cockpit2/clock_timer/zulu_month", "laminar/B747/fltInst/capt/clock_on", "laminar/B747/fltInst/capt/clock_utc_hours", "laminar/B747/fltInst/capt/clock_utc_minutes" ] },
    { "do": "switch", "note": "BATTERY OFF（開始では ON）", "dref": "laminar/B747/button_switch/position[13]", "value": 0, "cmd": "laminar/B747/button_switch/elec_battery" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "main hot battery bus：時計の時刻の元（ATA31 p.64）", "dref": "laminar/B747/electrical/bus/hot_bat_main", "op": "==", "value": 1 },
    { "do": "check", "note": "BATTERY OFF：APU battery bus は無い", "dref": "laminar/B747/electrical/bus/bat_apu", "op": "==", "value": 0 },
    { "do": "check", "note": "APU battery bus が無いと表示は消える（FCOM p.1075）", "cite": "FCOM p.1075", "dref": "laminar/B747/fltInst/capt/clock_on", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の時計も", "dref": "laminar/B747/fltInst/fo/clock_on", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の時計", "the": -22, "psi": -10, "fov": 16 },
    { "do": "shot", "name": "clock_battery_off" },
    { "do": "switch", "note": "BATTERY ON", "dref": "laminar/B747/button_switch/position[13]", "value": 1, "cmd": "laminar/B747/button_switch/elec_battery" },
    { "do": "wait", "note": "表示が出る", "dref": "laminar/B747/fltInst/capt/clock_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "remember", "dref": "sim/cockpit2/clock_timer/zulu_time_hours", "as": "zh" },
    { "do": "remember", "dref": "sim/cockpit2/clock_timer/zulu_time_minutes", "as": "zm" },
    { "do": "remember", "dref": "sim/cockpit2/clock_timer/zulu_day", "as": "zd" },
    { "do": "remember", "dref": "sim/cockpit2/clock_timer/zulu_month", "as": "zmo" },
    { "do": "check", "note": "UTC の時：X-Plane の UTC（ATA31 p.66）", "cite": "ATA31 p.66", "dref": "laminar/B747/fltInst/capt/clock_utc_hours", "op": "==", "value": 0, "rel": "zh" },
    { "do": "check", "note": "UTC の分", "dref": "laminar/B747/fltInst/capt/clock_utc_minutes", "op": "between", "value": [0, 1], "rel": "zm" },
    { "do": "check", "note": "日：UTC の日付（前はその地の日付）", "dref": "laminar/B747/fltInst/capt/clock_day", "op": "==", "value": 0, "rel": "zd" },
    { "do": "check", "note": "月", "dref": "laminar/B747/fltInst/capt/clock_month", "op": "==", "value": 0, "rel": "zmo" },
    { "do": "check", "note": "年（下 2 桁）", "dref": "laminar/B747/fltInst/capt/clock_year", "op": "==", "value": 26 },
    { "do": "check", "note": "ET は 0 で空白（ATA31 p.68）", "dref": "laminar/B747/fltInst/capt/clock_et_show", "op": "==", "value": 0 },
    { "do": "shot", "name": "clock_utc" },
    { "do": "cmd", "note": "DATE", "name": "laminar/B747/fltInst/capt/clock_date_switch" },
    { "do": "wait", "note": "日付：まず日と月（ATA31 p.66）", "cite": "ATA31 p.66", "dref": "laminar/B747/fltInst/capt/clock_utc_display", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "日と月", "dref": "laminar/B747/fltInst/capt/clock_date_display_mode", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "一度きりのコマンドでも DATE のボタンは戻る（0.2 秒）", "dref": "laminar/B747/fltInst/capt/clock_date_sw_pos", "op": "==", "value": 0 },
    { "do": "shot", "name": "clock_date" },
    { "do": "wait", "note": "1 秒で年", "dref": "laminar/B747/fltInst/capt/clock_date_display_mode", "op": "==", "value": 1, "timeout": 3 },
    { "do": "shot", "name": "clock_year" },
    { "do": "cmd", "note": "DATE をもう一度", "name": "laminar/B747/fltInst/capt/clock_date_switch" },
    { "do": "wait", "note": "UTC に戻る", "dref": "laminar/B747/fltInst/capt/clock_utc_display", "op": "==", "value": 0, "timeout": 3 },
    { "do": "cmd", "note": "ET を RUN に（HLD から上へ）", "name": "laminar/B747/fltInst/capt/clock_et_sel_up" },
    { "do": "check", "note": "ET の選択器 RUN", "dref": "laminar/B747/fltInst/capt/clock_et_sel_pos", "op": "==", "value": 1 },
    { "do": "wait", "note": "ET が進む（ATA31 p.68）", "cite": "ATA31 p.68", "dref": "laminar/B747/fltInst/capt/clock_et_seconds", "op": ">=", "value": 3, "timeout": 8 },
    { "do": "check", "note": "ET を表示（00:00）", "dref": "laminar/B747/fltInst/capt/clock_et_show", "op": "==", "value": 1 },
    { "do": "shot", "name": "clock_et" },
    { "do": "cmd", "note": "CHR を押す（1 秒）", "name": "laminar/B747/fltInst/capt/clock_chrono_switch", "duration": 1, "async": true },
    { "do": "sleep", "seconds": 0.4 },
    { "do": "check", "note": "時計の CHR ボタンが押し込まれる", "dref": "laminar/B747/fltInst/capt/clock_chr_sw_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "グレアシールドの CHR ボタンも（同じコマンド）", "dref": "laminar/B747/glareshiled/captain/chrono_switch_pos", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 1.2 },
    { "do": "check", "note": "離すと戻る", "dref": "laminar/B747/glareshiled/captain/chrono_switch_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "CHR の開始：ET に代わって出る（ATA31 p.68）", "cite": "ATA31 p.68", "dref": "laminar/B747/fltInst/capt/clock_et_chr_display", "op": "==", "value": 1 },
    { "do": "check", "note": "ET は隠れる", "dref": "laminar/B747/fltInst/capt/clock_et_show", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "秒針が進む", "dref": "laminar/B747/fltInst/capt/clock_chr_seconds", "op": "between", "value": [4, 9] },
    { "do": "shot", "name": "clock_chr" },
    { "do": "cmd", "note": "CHR 2 回目：保持（ATA31 p.70）", "cite": "ATA31 p.70", "name": "laminar/B747/fltInst/capt/clock_chrono_switch" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "remember", "dref": "laminar/B747/fltInst/capt/clock_chr_seconds", "as": "c1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "秒針は止まる", "dref": "laminar/B747/fltInst/capt/clock_chr_seconds", "op": "between", "value": [-0.01, 0.01], "rel": "c1" },
    { "do": "check", "note": "表示は CHR のまま", "dref": "laminar/B747/fltInst/capt/clock_et_chr_display", "op": "==", "value": 1 },
    { "do": "cmd", "note": "CHR 3 回目：リセット", "name": "laminar/B747/fltInst/capt/clock_chrono_switch" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "ET の表示に戻る（ATA31 p.68）", "dref": "laminar/B747/fltInst/capt/clock_et_chr_display", "op": "==", "value": 0 },
    { "do": "check", "note": "秒針は 60 に", "dref": "laminar/B747/fltInst/capt/clock_chr_seconds", "op": "==", "value": 0 },
    { "do": "check", "note": "ET は裏で進んでいた（FCOM p.1058）", "cite": "FCOM p.1058", "dref": "laminar/B747/fltInst/capt/clock_et_seconds", "op": ">=", "value": 10 },
    { "do": "check", "note": "ET を表示", "dref": "laminar/B747/fltInst/capt/clock_et_show", "op": "==", "value": 1 },
    { "do": "cmd", "note": "ET を HLD に（下へ）", "name": "laminar/B747/fltInst/capt/clock_et_sel_down" },
    { "do": "check", "note": "ET の選択器 HLD", "dref": "laminar/B747/fltInst/capt/clock_et_sel_pos", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "remember", "dref": "laminar/B747/fltInst/capt/clock_et_seconds", "as": "e1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "HLD：止まる", "dref": "laminar/B747/fltInst/capt/clock_et_seconds", "op": "between", "value": [-0.01, 0.01], "rel": "e1" },
    { "do": "cmd", "note": "ET を RESET に（HLD から下へ）", "name": "laminar/B747/fltInst/capt/clock_et_sel_down" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "ばねで HLD に戻る（FCOM p.1058）", "cite": "FCOM p.1058", "dref": "laminar/B747/fltInst/capt/clock_et_sel_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "RESET：0", "dref": "laminar/B747/fltInst/capt/clock_et_seconds", "op": "==", "value": 0 },
    { "do": "check", "note": "空白", "dref": "laminar/B747/fltInst/capt/clock_et_show", "op": "==", "value": 0 },
    { "do": "cmd", "note": "SET を HLD に", "name": "laminar/B747/fltInst/capt/clock_set_sel_up" },
    { "do": "check", "note": "SET HLD", "dref": "laminar/B747/fltInst/capt/clock_set_sel_pos", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "remember", "dref": "laminar/B747/fltInst/capt/clock_utc_minutes", "as": "m1" },
    { "do": "cmd", "note": "SET を MS に", "name": "laminar/B747/fltInst/capt/clock_set_sel_up" },
    { "do": "check", "note": "SET MS", "dref": "laminar/B747/fltInst/capt/clock_set_sel_pos", "op": "==", "value": 2 },
    { "do": "sleep", "seconds": 3.5 },
    { "do": "check", "note": "MS：1 秒に 1 分（ATA31 p.67）", "cite": "ATA31 p.67", "dref": "laminar/B747/fltInst/capt/clock_utc_minutes", "op": "between", "value": [2, 4], "rel": "m1" },
    { "do": "cmd", "note": "SET を HLD に戻す", "name": "laminar/B747/fltInst/capt/clock_set_sel_down" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "remember", "dref": "laminar/B747/fltInst/capt/clock_utc_minutes", "as": "m2" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "HLD：止まったまま（FCOM p.1059）", "cite": "FCOM p.1059", "dref": "laminar/B747/fltInst/capt/clock_utc_minutes", "op": "==", "value": 0, "rel": "m2" },
    { "do": "shot", "name": "clock_set" },
    { "do": "cmd", "note": "SET を RUN に", "name": "laminar/B747/fltInst/capt/clock_set_sel_down" },
    { "do": "check", "note": "SET RUN", "dref": "laminar/B747/fltInst/capt/clock_set_sel_pos", "op": "==", "value": 0 },
    { "do": "remember", "dref": "sim/cockpit2/clock_timer/zulu_time_minutes", "as": "zm2" },
    { "do": "check", "note": "副操縦士の時計は X-Plane の UTC のまま", "dref": "laminar/B747/fltInst/fo/clock_utc_minutes", "op": "between", "value": [0, 1], "rel": "zm2" },
    { "do": "check", "note": "副操縦士の ET は 0", "dref": "laminar/B747/fltInst/fo/clock_et_show", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
