{
  "name": "s199_atc_report",
  "description": "6-1・6-2 段 12g3c（ATC REPORT・VERIFY REPORT）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO に戻す、保存はしない）。RTE 1（RJAA、XAC、SPENS、RJBB）をアクティブにし、ATC INDEX の <REPORT で ATC REPORT（題、<RTE REPORT と FREE TEXT>、一覧は空）、FREE TEXT> の空の VERIFY REPORT（FREE TEXT の行、AutoATC の無いこの PC の DATA LINK NO COMM）、<REPORT で戻り、<RTE REPORT の VERIFY REPORT（ASSIGNED ROUTE、RTE 1、経路の文）を確かめる。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "RTE：RJAA から RJBB、XAC と SPENS", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL"] },
    { "do": "cdu", "note": "LEGS、ACTIVATE、EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "ATC キー（LOGON/STATUS）、<INDEX、<REPORT", "keys": ["ATC", "L6", "L3"] },
    { "do": "check", "note": "ATC REPORT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC REPORT" },
    { "do": "check", "note": "<RTE REPORT と FREE TEXT>（FMSPG p.338）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<RTE REPORT   FREE TEXT>" },
    { "do": "check", "note": "一覧は空", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^ *$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_atc_report" },
    { "do": "cdu", "note": "FREE TEXT>", "keys": ["R1"] },
    { "do": "check", "note": "VERIFY REPORT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "VERIFY REPORT" },
    { "do": "check", "note": "FREE TEXT の見出し", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "FREE TEXT" },
    { "do": "check", "note": "AutoATC が無いので NO COMM", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "NO COMM" },
    { "do": "check", "note": "DATA LINK の見出し", "dref": "laminar/B747/fms3/Line10_S", "op": "contains", "value": "DATA LINK" },
    { "do": "cdu", "note": "<REPORT、<RTE REPORT", "keys": ["L6", "L1"] },
    { "do": "check", "note": "ASSIGNED ROUTE（FMSPG p.338）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "ASSIGNED ROUTE" },
    { "do": "check", "note": "RTE 1", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RTE 1" },
    { "do": "check", "note": "経路の文", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "RJAA" },
    { "do": "shot", "name": "cdu_verify_rte_report" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
