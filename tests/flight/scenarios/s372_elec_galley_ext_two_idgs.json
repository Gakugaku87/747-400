{
  "name": "s372_elec_galley_ext_two_idgs",
  "description": "IDG 2 台と地上電源（か APU）のときに負荷制限をしない（2026-11-23 の段 4 のレビュー SYS-6）の X-Plane での確認。成田 34L でエンジン運転中に開始（IDG 4 台）、CDU の GROUND SERVICES から地上電源を呼び（s239 と同じ）、EXT PWR 1 だけを入れる。EXT 2 も AVAIL なので SSB が開き、EXT 1 が左側（AC 1・2）を、IDG 3・4 が右側を持つ（LH24 p.123、FCOM p.797）。それぞれの電源が自分の母線を持つので、需要は容量の中（FCOM p.795 (6.20.1)、LH24 p.240）：ギャレー 4 つ（laminar/B747/electrical/bus/galley[0..3]）は 1 のまま、load_shed は 0。直す前は、IDG の台数（2）だけで決めていたので、3 秒でギャレー 1・4・2 が落ちた（エンジン 4・3 だけを APU で始動したときと同じ形）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "IDG 4 台", "drefs": [
      "laminar/B747/electrical/bus/galley[0]", "laminar/B747/electrical/bus/galley[1]", "laminar/B747/electrical/bus/galley[2]", "laminar/B747/electrical/bus/galley[3]",
      "laminar/B747/electrical/load_shed", "laminar/B747/electrical/bus/ac[0]", "laminar/B747/electrical/bus/ac[3]" ] },
    { "do": "check", "note": "IDG 4 台：ギャレー 1 に電気", "dref": "laminar/B747/electrical/bus/galley[0]", "op": "==", "value": 1, "stop": true },
    { "do": "cdu", "note": "MENU → GND HANDLING → GROUND SERVICES", "keys": ["MENU", "R4", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "L2：地上電源を呼ぶ（先に輪止め）", "keys": ["L2"] },
    { "do": "wait", "note": "EXT PWR 1 AVAIL（X-Plane の電源車なら着いてから）", "dref": "laminar/B747/electrical/ext_pwr1_avail", "op": "==", "value": 1, "timeout": 240, "stop": true },
    { "do": "check", "note": "EXT PWR 2 AVAIL（SSB が開いて左側だけが替わる条件）", "dref": "laminar/B747/electrical/ext_pwr2_avail", "op": "==", "value": 1 },

    { "do": "mark", "note": "EXT PWR 1 だけを入れる" },
    { "do": "cmd", "note": "EXT PWR 1 を押す", "name": "laminar/B747/button_switch/elec_ext_pwr_1", "duration": 0.3 },
    { "do": "sleep", "seconds": 8, "note": "負荷制限は 1 秒に 1 つ（LH24 p.236）：落ちるなら 3 秒で 3 つ" },
    { "do": "snapshot", "note": "EXT 1 と IDG 3・4", "drefs": [
      "laminar/B747/electrical/ext_pwr1_on", "laminar/B747/electrical/ext_pwr2_on",
      "laminar/B747/electrical/bus/galley[0]", "laminar/B747/electrical/bus/galley[1]", "laminar/B747/electrical/bus/galley[2]", "laminar/B747/electrical/bus/galley[3]",
      "laminar/B747/electrical/load_shed", "laminar/B747/electrical/bus/ac[0]", "laminar/B747/electrical/bus/ac[1]", "laminar/B747/electrical/bus/ac[2]", "laminar/B747/electrical/bus/ac[3]" ] },
    { "do": "check", "note": "EXT PWR 1 がつながった", "dref": "laminar/B747/electrical/ext_pwr1_on", "op": "==", "value": 1 },
    { "do": "check", "note": "AC bus 1 に電気", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "SYS-6：負荷制限なし（前は 1）", "dref": "laminar/B747/electrical/load_shed", "op": "==", "value": 0 },
    { "do": "check", "note": "ギャレー 1 に電気（前は最初に落ちた）", "dref": "laminar/B747/electrical/bus/galley[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "ギャレー 2", "dref": "laminar/B747/electrical/bus/galley[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "ギャレー 3", "dref": "laminar/B747/electrical/bus/galley[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "ギャレー 4", "dref": "laminar/B747/electrical/bus/galley[3]", "op": "==", "value": 1 },
    { "do": "cas", "note": "EXT 1 と IDG 3・4" },
    { "do": "cmd", "note": "EXT PWR 1 を外す", "name": "laminar/B747/button_switch/elec_ext_pwr_1", "duration": 0.3 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "IDG 4 台に戻る：ギャレー 1", "dref": "laminar/B747/electrical/bus/galley[0]", "op": "==", "value": 1 }
  ]
}
