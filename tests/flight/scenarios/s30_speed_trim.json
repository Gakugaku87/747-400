{
  "name": "s30_speed_trim",
  "description": "speed trim（4-1 段 2c：ATA22 p.155–159、ATA27 p.486）の X-Plane での確認、空中。10,000 ft の空中で開始し、A/P（ALT HOLD）と A/T（SPD 200 kt）で落ち着かせる。A/P の間は speed trim は入らない。A/P を外すと（A/T はそのまま）すぐ入り（空中 20 秒後、220 kt 以下）、A/T の速度を 215 kt に上げると、速度の増えに合わせて安定板が機首上げへ動く（120〜220 kt で 2.55 units の制御則、0.0255 units/kt。A/P が無いので機体は上昇に転じ、速度は戻ろうとする）。A/P で 228 kt を超えてから外すと speed trim は入らない（220 kt 超で止まる）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 115 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 20, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "set", "note": "MCP 方位 347", "dref": "laminar/B747/autopilot/heading/degrees", "value": 347 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "200 kt 付近", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [196, 204], "timeout": 240 },
    { "do": "sleep", "seconds": 20, "note": "落ち着かせる" },
    { "do": "check", "note": "A/P の間は speed trim は入らない（ATA22 p.156）", "dref": "laminar/B747/flt_ctrls/stab_trim/speed_trim", "op": "==", "value": 0 },

    { "do": "mark", "note": "A/P を外す" },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "もう一度押して AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "A/P は外れた", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "speed trim が入る（空中 20 秒後、220 kt 以下）", "dref": "laminar/B747/flt_ctrls/stab_trim/speed_trim", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "speed trim", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/flt_ctrls/stab_trim/units",
      "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "remember", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "as": "u0" },
    { "do": "set", "note": "A/T の速度を 215 kt に（A/P が無いので、速度が上がると speed trim の機首上げで上昇に転じる）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 215 },
    { "do": "wait", "note": "安定板が機首上げへ 0.1 units 動く（約 +4 kt：ATA22 p.159 の 0.0255 units/kt）", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": ">", "value": 0.1, "rel": "u0", "timeout": 120 },
    { "do": "snapshot", "note": "加速の後（units の増えは IAS の増え × 0.0255 になる）", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/flt_ctrls/stab_trim/units",
      "laminar/B747/flt_ctrls/stab_trim/speed_trim", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot" ] },

    { "do": "mark", "note": "220 kt 超で A/P を外す" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "A/T の速度を 235 kt に", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 235 },
    { "do": "wait", "note": "228 kt を超える", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 228, "timeout": 240 },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "もう一度押して AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "A/P は外れた", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "220 kt を超えているので speed trim は入らない（ATA27 p.486）", "dref": "laminar/B747/flt_ctrls/stab_trim/speed_trim", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/P CMD L に戻す", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "sleep", "seconds": 3 }
  ]
}
