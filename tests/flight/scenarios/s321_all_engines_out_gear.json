{
  "name": "s321_all_engines_out_gear",
  "description": "全発停止（風車回転）での脚下げ（2026-11-12 のフルレビュー HA-1：REVIEW_2026-11-12.md 案 26）の X-Plane での確認。成田の東 FL200・約 235 kt の空中開始（270 t、脚上げ、APU なし）。FUEL CONTROL を 4 つとも CUTOFF（発電機が落ち、AC の母線・ACMP・ADP は無い：油圧は風車回転の EDP だけ）。90 秒後に脚下げ：脚とドアは EDP の流量の余りで動き、ふつうの約 14 秒より長くかかる（FCTM p.286 (8.8)：最大 2 分半。流量の値は推定。前は 12.9 秒で下りた）。その間も系統 1・4 の圧は 2,800 psi 以上（操縦系統が先：推定）。フラップは動かない（FCTM p.286：AC の母線が無い）",
  "reload": true,
  "flight": {
    "lle_air_start": { "elevation_in_meters": 6096, "heading_true": 90, "latitude": 35.4, "longitude": 141.3, "speed_in_meters_per_second": 175 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weight": {
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ],
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 15, "note": "落ち着く" },
    { "do": "record_start" },
    { "do": "check", "note": "脚は上がってロック（空中開始）", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "<", "value": 0.001, "stop": true },
    { "do": "mark", "note": "FUEL CONTROL 4 つとも CUTOFF" },
    { "do": "switch", "note": "FUEL CONTROL 1 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 3 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[2]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_3/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "sleep", "seconds": 90, "note": "風車回転に落ち着く（N2 が 15 % ほどまで下がる）" },
    { "do": "check", "note": "どのエンジンも燃えていない", "dref": "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "op": "==", "value": 0, "stop": true },
    { "do": "snapshot", "note": "風車回転（脚下げの前）", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/ENGN_N2_[3]", "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_4", "laminar/B747/hydraulics/spare_gpm[0]", "laminar/B747/hydraulics/spare_gpm[3]", "laminar/B747/electrical/bus/ac[0]" ] },
    { "do": "cas", "note": "風車回転" },
    { "do": "mark", "note": "脚下げ" },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "脚下げの 10 秒後（脚の流量・残りの流量・圧）", "drefs": [ "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/gear/hyd_gpm[0]", "laminar/B747/gear/hyd_gpm[3]", "laminar/B747/hydraulics/spare_gpm[0]", "laminar/B747/hydraulics/spare_gpm[3]", "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_4", "laminar/B747/gear/door[0]", "laminar/B747/gear/door[3]", "sim/flightmodel2/gear/deploy_ratio[0]", "sim/flightmodel2/gear/deploy_ratio[3]" ] },
    { "do": "check", "note": "系統 1 の圧は 2,800 psi 以上（操縦系統が先：推定）", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">=", "value": 2800 },
    { "do": "check", "note": "系統 4 の圧も", "dref": "laminar/B747/hydraulics/pressure_4", "op": ">=", "value": 2800 },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "25 秒：前脚はまだ下りきっていない（ふつうは 14 秒。前は 12.9 秒で下りた）", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "<", "value": 0.999 },
    { "do": "check", "note": "系統 1 の圧は 2,800 psi 以上のまま", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">=", "value": 2800 },
    { "do": "wait", "note": "全脚ダウンロック（FCTM p.286：最大 2 分半。2026-11-13 の 1 回目は X-Plane の風車回転の N2 が CUTOFF から 2 分ほどで 1.3 % まで落ち、エンジン駆動ポンプの流量が無くなって脚が途中で止まった：範囲の外の発見 2 で、止まったエンジンの N2 を速さで保つ（推定）ようにした）", "dref": "laminar/B747/gear/air_ground/all_gear_down", "op": "==", "value": 1, "timeout": 125 },
    { "do": "snapshot", "note": "2 分半の時の脚の位置と N2", "drefs": [ "sim/flightmodel2/gear/deploy_ratio[0]", "sim/flightmodel2/gear/deploy_ratio[1]", "sim/flightmodel2/gear/deploy_ratio[3]", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/ENGN_N2_[3]", "laminar/B747/gear/hyd_gpm[0]", "laminar/B747/gear/hyd_gpm[3]", "laminar/B747/hydraulics/spare_gpm[0]", "laminar/B747/hydraulics/spare_gpm[3]" ] },
    { "do": "snapshot", "note": "その時", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/ENGN_N2_[3]", "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_4", "laminar/B747/hydraulics/spare_gpm[0]", "laminar/B747/hydraulics/spare_gpm[3]" ] },
    { "do": "mark", "note": "フラップ 5" },
    { "do": "set", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "後縁フラップは動かない（FCTM p.286：AC の母線が無い）", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": "<", "value": 0.5 },
    { "do": "cas", "note": "脚が下りた後" },
    { "do": "record_stop" }
  ]
}
