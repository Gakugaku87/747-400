{
  "name": "s75_eicas_partial",
  "description": "EICAS の形式（5-2 段 6b-1）の X-Plane での確認、地上。成田 34L にエンジン運転中で開始（機体を読み直す）。開始で二次 EICAS に二次エンジンの全表示、ENG で消し、2 番の油ポンプの故障で油圧が赤線を割ると油の行だけの部分表示と主 EICAS の逸脱の印（VVVVVV）、ENG で全表示、もう一度で部分表示、FUEL を選ぶと部分表示は主 EICAS の compact へ（dataref）、故障を戻すと消える（FCOM p.839-840、p.852-854、p.874-875）。EICAS を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/dsp/synoptic_display", "laminar/B747/eicas/sec_eng", "laminar/B747/eicas/compact", "laminar/B747/eicas/exceed_cue",
      "laminar/B747/engines/sec_exceed", "laminar/B747/engines/oil_press_psi", "laminar/B747/engines/oil_temp_degC", "laminar/B747/engines/type" ] },
    { "do": "check", "note": "開始で二次エンジンの表示（FCOM p.872）", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 1 },
    { "do": "check", "note": "全表示：FF の行も", "dref": "laminar/B747/eicas/sec_rows[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "逸脱は無い", "dref": "laminar/B747/eicas/exceed_cue", "op": "==", "value": 0 },
    { "do": "view", "note": "EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_full" },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "lower_full" },
    { "do": "view", "note": "EICAS", "name": "eicas" },
    { "do": "cmd", "note": "ENG", "name": "laminar/B747/dsp/eng_switch", "duration": 0.2 },
    { "do": "wait", "note": "二次エンジンの表示が消える", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 0, "timeout": 3 },
    { "do": "set", "note": "2 番の油ポンプの故障", "dref": "sim/operation/failures/rel_oilpmp1", "value": 6 },
    { "do": "wait", "note": "油圧が赤線を割る：油の逸脱", "dref": "laminar/B747/engines/sec_exceed[1]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "部分表示：二次 EICAS に出る（FCOM p.852）", "cite": "FCOM p.852", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 1 },
    { "do": "check", "note": "N2 の行は出ない", "dref": "laminar/B747/eicas/sec_rows[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "FF の行は出ない", "dref": "laminar/B747/eicas/sec_rows[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "油の行（OIL P・T・Q）だけ（FCOM p.854）", "cite": "FCOM p.854", "dref": "laminar/B747/eicas/sec_rows[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "VIB の行は出ない", "dref": "laminar/B747/eicas/sec_rows[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "主 EICAS に逸脱の印（FCOM p.840）", "cite": "FCOM p.840", "dref": "laminar/B747/eicas/exceed_cue", "op": "==", "value": 1 },
    { "do": "check", "note": "2 番の油圧の赤", "dref": "laminar/B747/engines/EICAS2_oil_press_status[1]", "op": "==", "value": 1 },
    { "do": "shot", "name": "eicas_partial" },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "lower_partial" },
    { "do": "view", "note": "EICAS", "name": "eicas" },
    { "do": "cmd", "note": "ENG：全表示（FCOM p.874）", "name": "laminar/B747/dsp/eng_switch", "duration": 0.2 },
    { "do": "wait", "note": "全表示：FF の行も", "dref": "laminar/B747/eicas/sec_rows[1]", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "逸脱の印は残る", "dref": "laminar/B747/eicas/exceed_cue", "op": "==", "value": 1 },
    { "do": "shot", "name": "eicas_partial_eng" },
    { "do": "cmd", "note": "ENG をもう一度：部分表示に戻る", "name": "laminar/B747/dsp/eng_switch", "duration": 0.2 },
    { "do": "wait", "note": "FF の行が消える", "dref": "laminar/B747/eicas/sec_rows[1]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "油の行は残る", "dref": "laminar/B747/eicas/sec_rows[2]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "FUEL", "name": "laminar/B747/dsp/fuel_switch", "duration": 0.2 },
    { "do": "wait", "note": "二次 EICAS は FUEL のページ", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "部分表示は主 EICAS の compact へ（FCOM p.875）", "cite": "FCOM p.875", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 2 },
    { "do": "check", "note": "compact の油の行", "dref": "laminar/B747/eicas/cmp_rows[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "compact の FF の行は出ない", "dref": "laminar/B747/eicas/cmp_rows[1]", "op": "==", "value": 0 },
    { "do": "shot", "name": "eicas_fuel" },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "lower_fuel" },
    { "do": "view", "note": "EICAS", "name": "eicas" },
    { "do": "cmd", "note": "FUEL をもう一度", "name": "laminar/B747/dsp/fuel_switch", "duration": 0.2 },
    { "do": "wait", "note": "部分表示が二次 EICAS に戻る", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "compact は消える", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 0 },
    { "do": "set", "note": "油ポンプの故障を戻す", "dref": "sim/operation/failures/rel_oilpmp1", "value": 0 },
    { "do": "wait", "note": "油圧が戻る", "dref": "laminar/B747/engines/sec_exceed[1]", "op": "==", "value": 0, "timeout": 60, "level": "warn" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "正常域に戻ると部分表示は消える（FCOM p.875）", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 0, "level": "warn" },
    { "do": "check", "note": "逸脱の印も消える", "dref": "laminar/B747/eicas/exceed_cue", "op": "==", "value": 0, "level": "warn" },
    { "do": "shot", "name": "eicas_normal" },
    { "do": "view", "name": "forward" }
  ]
}
