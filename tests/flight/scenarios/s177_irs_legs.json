{
  "name": "s177_irs_legs",
  "description": "6-1/6-2 段 11e1（代替航法の IRS LEGS）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、XAC へ DIRECT。両方の FMC を故障させると、左の CDU は MENU で <FMC が無く、LEGS で ACT IRS LEGS（CDU の写しの経路：XAC・SPENS・BOKJO、現用の脚の針路は M、次からは T と距離、座標：FCOM p.1421–1424、FMSPG p.248–249）。2L に緯度経度を入れると MOD IRS LEGS と左の EXEC 灯、EXEC で ACT。右の CDU の写しはそのまま。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "LEGS で XAC へ DIRECT TO、EXEC", "keys": ["LEGS", "XAC", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 3, "note": "CDU が経路を写す（毎秒）" },

    { "do": "mark", "note": "両方の FMC の故障" },
    { "do": "set", "note": "左 FMC を故障させる", "dref": "laminar/B747/fms/fail[0]", "value": 1 },
    { "do": "set", "note": "右 FMC も", "dref": "laminar/B747/fms/fail[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "左の CDU は MENU", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "check", "note": "<FMC が無い（FCOM p.1275）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^ {17}" },
    { "do": "cdu", "note": "CLR、LEGS", "keys": ["CLR", "LEGS"] },
    { "do": "check", "note": "ACT IRS LEGS（FCOM p.1423）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT IRS LEGS" },
    { "do": "check", "note": "1 行目は XAC と座標", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^XAC +N3[0-9]`[0-9]{2}[.][0-9] E1[0-9]{2}`[0-9]{2}[.][0-9]$" },
    { "do": "check", "note": "現用の脚の針路は M（FMSPG p.249）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ [0-9]{3}`M" },
    { "do": "check", "note": "2 行目は SPENS", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^SPENS" },
    { "do": "check", "note": "その針路は T と距離", "dref": "laminar/B747/fms3/Line04_S", "op": "matches", "value": "^ [0-9]{3}`T +[0-9]+NM" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_irs_legs" },

    { "do": "mark", "note": "緯度経度の入力と EXEC" },
    { "do": "cdu", "note": "2L に N3610.0E14010.0", "keys": ["N3610.0E14010.0", "L2"] },
    { "do": "check", "note": "MOD IRS LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD IRS LEGS" },
    { "do": "check", "note": "2 行目は N36E140", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^N36E140" },
    { "do": "check", "note": "左の EXEC 灯", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 1 },
    { "do": "check", "note": "右の EXEC 灯は消えたまま", "dref": "laminar/B747/fms/exec_light_copilot", "op": "==", "value": 0 },
    { "do": "shot", "name": "cdu_irs_legs_mod" },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "check", "note": "ACT IRS LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT IRS LEGS" },
    { "do": "check", "note": "EXEC 灯が消える", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 0 },
    { "do": "cmd", "note": "右の CDU：CLR", "name": "laminar/B747/fms2/key/clear" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "右の CDU：LEGS", "name": "laminar/B747/fms2/func_key/legs" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "右の CDU も ACT IRS LEGS", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "ACT IRS LEGS" },
    { "do": "check", "note": "右の写しの 2 行目は SPENS のまま（FCOM p.1422）", "dref": "laminar/B747/fms2/Line05_L", "op": "matches", "value": "^SPENS" },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[0]", "value": 0 },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[1]", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
