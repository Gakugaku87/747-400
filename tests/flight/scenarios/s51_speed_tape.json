{
  "name": "s51_speed_tape",
  "description": "PFD の速度テープのフラップの機動速度のバグ（5-2 段 3a、パネルの変更、DSP-13）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・200 kt で開始（機体を読み直す）。フラップの機動速度は FCOM PI.10.3（UP VREF30+80、1 +60、5 +40、10 +20、20 +10、25 VREF25、30 VREF30）、バグは今のフラップと次の小さいフラップの 2 つ（FCOM p.972）。空中開始は最小機動速度の帯を出す（推定）。PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "速度テープの値", "drefs": [ "laminar/B747/airspeed/Vref30", "laminar/B747/airspeed/Vf0", "laminar/B747/airspeed/Vf1", "laminar/B747/airspeed/Vf5",
      "laminar/B747/airspeed/Vf10", "laminar/B747/airspeed/Vf20", "laminar/B747/airspeed/Vf25", "laminar/B747/airspeed/Vf30", "laminar/B747/airspeed/show_vf",
      "laminar/B747/pfd/show_mins", "laminar/B747/airspeed/Vmc", "laminar/B747/airspeed/Vs", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "空中開始：最小機動速度の帯を出す（推定）", "dref": "laminar/B747/pfd/show_mins", "op": "==", "value": 1 },
    { "do": "check", "note": "フラップ UP：UP のバグ", "dref": "laminar/B747/airspeed/show_vf[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "1 のバグは出さない", "dref": "laminar/B747/airspeed/show_vf[1]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "spd_up" },

    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.1667 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "フラップ 1：1 と UP（FCOM p.972）", "dref": "laminar/B747/airspeed/show_vf[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "UP も", "dref": "laminar/B747/airspeed/show_vf[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "spd_f1" },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "フラップ 5：5 と 1", "dref": "laminar/B747/airspeed/show_vf[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "UP は消える", "dref": "laminar/B747/airspeed/show_vf[0]", "op": "==", "value": 0 },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "フラップ 20：20 と 10", "dref": "laminar/B747/airspeed/show_vf[4]", "op": "==", "value": 1 },
    { "do": "check", "note": "10 も", "dref": "laminar/B747/airspeed/show_vf[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "5 は消える", "dref": "laminar/B747/airspeed/show_vf[2]", "op": "==", "value": 0 },
    { "do": "wait", "note": "フラップが 20 に近づく", "dref": "sim/flightmodel/controls/flaprat", "op": ">", "value": 0.6, "timeout": 90, "level": "warn" },
    { "do": "shot", "name": "spd_f20" },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "wait", "note": "減速", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 178, "timeout": 120, "level": "warn" },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "フラップ 30、着陸フラップ未選択：30 と 25", "dref": "laminar/B747/airspeed/show_vf[6]", "op": "==", "value": 1 },
    { "do": "check", "note": "25 も", "dref": "laminar/B747/airspeed/show_vf[5]", "op": "==", "value": 1 },
    { "do": "check", "note": "20 は消える（前は残った：DSP-13）", "dref": "laminar/B747/airspeed/show_vf[4]", "op": "==", "value": 0 },
    { "do": "shot", "name": "spd_f30" },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
