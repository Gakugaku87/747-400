{
  "name": "s132_nd_profile",
  "description": "6-1/6-2 段 8d3（ND の T/C・T/D・E/D と減速点）の X-Plane での確認、空中。FL250・約 300 kt で RJAA の東から西へ空中開始（機体を読み直す）。s131 と同じ経路（RJAA→RJBB、DIRECT AKAGI、STAR ATMUGA、ILS06LY・遷移 GATES）を ACTIVATE と EXEC、PERF INIT で COST INDEX 100 と CRZ ALT FL350。A/P CMD L・LNAV、MCP 高度 35,000 ft と FLCH で上昇（飛行の相が上昇になる）。予測の点（`laminar/B747/fms/profile/*`：1 T/C、2 S/C、3 T/D、4 E/D、5 減速点）が出て、機長の ND（MAP 160・320・640 NM）に緑の丸と T/C・T/D・E/D の字、減速点は字なしの丸で、経路の線の上に出ることを写真で確かめる。PLAN では出ない。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.6, "elevation_in_meters": 7620, "heading_true": 255, "speed_in_meters_per_second": 215 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "check", "note": "<SEL>GATES", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<SEL>GATES" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "PERF INIT：COST INDEX 100、CRZ ALT FL350", "keys": ["INITREF", "L6", "L3", "100", "L5", "350", "R1"] },
    { "do": "check", "note": "CRZ ALT FL350", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "FL350" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "set", "note": "MCP 速度 300 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 300 },
    { "do": "set", "note": "MCP 高度 35,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 35000 },
    { "do": "cmd", "note": "FLCH（MCP 高度が上なので飛行の相は上昇）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと）" },
    { "do": "check", "note": "飛行の相：上昇", "dref": "laminar/B747/autopilot/flightPhase", "op": "==", "value": 1 },
    { "do": "check", "note": "最初の点は T/C", "dref": "laminar/B747/fms/profile/kind[0]", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "予測の点と機体の位置", "drefs": [ "laminar/B747/fms/profile/kind[0]", "laminar/B747/fms/profile/lat[0]", "laminar/B747/fms/profile/lon[0]", "laminar/B747/fms/profile/kind[1]", "laminar/B747/fms/profile/lat[1]", "laminar/B747/fms/profile/lon[1]", "laminar/B747/fms/profile/kind[2]", "laminar/B747/fms/profile/lat[2]", "laminar/B747/fms/profile/lon[2]", "laminar/B747/fms/profile/kind[3]", "laminar/B747/fms/profile/lat[3]", "laminar/B747/fms/profile/lon[3]", "laminar/B747/fms/profile/kind[4]", "laminar/B747/fms/profile/lat[4]", "laminar/B747/fms/profile/lon[4]", "laminar/B747/fms/profile/kind[5]", "laminar/B747/fms/profile/kind[6]", "laminar/B747/fms/profile/kind[7]", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/dist/top_of_descent_lat", "laminar/B747/autopilot/dist/top_of_descent_long" ] },
    { "do": "cdu", "note": "PROG（TO T/C の距離と比べる）", "keys": ["PROG"] },
    { "do": "snapshot", "note": "PROGRESS の 5R", "drefs": [ "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "set", "note": "範囲 160 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 4 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_profile_160" },
    { "do": "set", "note": "範囲 320 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "nd_profile_320" },
    { "do": "set", "note": "範囲 640 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 6 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "nd_profile_640" },
    { "do": "switch", "note": "機長の ND を PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "nd_profile_pln" },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "set", "note": "範囲 40 NM に戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
