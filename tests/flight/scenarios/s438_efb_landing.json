    { "do": "shot", "name": "efb_window_takeoff" },
    { "do": "set", "note": "着陸：フラップ 30", "dref": "laminar/B747/efb/req_i[2]", "value": 30 },
    { "do": "set", "note": "乾いた滑走路", "dref": "laminar/B747/efb/req_i[7]", "value": 0 },
    { "do": "set", "note": "オートブレーキ 3（0 MAX MANUAL、1 MAX AUTO、2〜5 が 4〜1）", "dref": "laminar/B747/efb/req_i[8]", "value": 3 },
    { "do": "set", "note": "逆推力 4 発", "dref": "laminar/B747/efb/req_i[9]", "value": 4 },
    { "do": "set", "note": "250 t", "dref": "laminar/B747/efb/req_f[3]", "value": 250000 },
    { "do": "set", "note": "VREF + 5", "dref": "laminar/B747/efb/req_f[8]", "value": 5 },
    { "do": "set", "note": "着陸を計算", "dref": "laminar/B747/efb/req_kind", "value": 4 },
    { "do": "set", "dref": "laminar/B747/efb/req_id", "value": 8002 },
    { "do": "wait", "note": "FMC が答える", "dref": "laminar/B747/efb/ans_id", "op": "==", "value": 8002, "timeout": 10 },
    { "do": "check", "note": "着陸を計算できた", "dref": "laminar/B747/efb/out[1]", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "着陸：気圧高度、VREF、進入速度、着陸距離、LDA、余り、滑走路長と上昇の制限、通常の制限とその VREF、quick turnaround と時間、低視程、着氷、フラップ 25 の勧め、構造", "drefs": ["laminar/B747/efb/out[2]", "laminar/B747/efb/out[3]", "laminar/B747/efb/out[4]", "laminar/B747/efb/out[5]", "laminar/B747/efb/out[6]", "laminar/B747/efb/out[7]", "laminar/B747/efb/out[8]", "laminar/B747/efb/out[9]", "laminar/B747/efb/out[10]", "laminar/B747/efb/out[11]", "laminar/B747/efb/out[12]", "laminar/B747/efb/out[13]", "laminar/B747/efb/out[19]", "laminar/B747/efb/out[20]", "laminar/B747/efb/out[21]", "laminar/B747/efb/out[22]", "laminar/B747/efb/msg"] },
    { "do": "check", "note": "VREF 30（250 t：FCOM PI.10.2 の 240 t の 140 kt と 260 t の 146 kt のあいだ、143 kt。標高 135 ft の分は 0.03 kt）", "dref": "laminar/B747/efb/out[3]", "op": "between", "value": [142, 144] },
    { "do": "check", "note": "進入速度は VREF + 5", "dref": "laminar/B747/efb/out[4]", "op": "between", "value": [147, 149] },
    { "do": "check", "note": "着陸距離（FCOM PI.12：オートブレーキ 3、250 t、海面の基準 1,825 m に、速さ・標高などの補正）", "dref": "laminar/B747/efb/out[5]", "op": "between", "value": [1700, 2100] },
    { "do": "check", "note": "LDA は滑走路の端から（4,000 m、34L は移設なし）", "dref": "laminar/B747/efb/out[6]", "op": "between", "value": [3950, 4050] },
    { "do": "check", "note": "通常の制限は構造の 285,763 kg（4,000 m の乾いた滑走路では滑走路長も上昇も上）", "dref": "laminar/B747/efb/out[10]", "op": "between", "value": [285700, 285800] },
    { "do": "check", "note": "quick turnaround の制限重量がある", "dref": "laminar/B747/efb/out[12]", "op": ">", "value": 200000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "窓が着陸のページで答えを取り込んだ", "dref": "laminar/B747/efb/page", "op": "==", "value": 1 },
    { "do": "shot", "name": "efb_window_landing" },
    { "do": "set", "note": "窓を閉じる", "dref": "laminar/B747/efb/window_open", "value": 0 }
  ]
}
