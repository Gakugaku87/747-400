{
  "name": "s438_efb_landing",
  "description": "離着陸性能の窓（notes/ATA-34-61-FMC.md §191）の着陸のページと、窓の表示の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。窓を開いてから、窓と同じ要求（laminar/B747/efb/req_*）で FMC の側に離陸（300 t、15 ℃、フラップ 20、TO、assumed temperature あり）と着陸（250 t、フラップ 30、乾いた滑走路、オートブレーキ 3、逆推力 4 発、VREF + 5、15 ℃、1013 hPa、無風）を計算させる。着陸は VREF（FCOM PI.10.2）、FCOM PI.12 の着陸距離（オートブレーキ 3 の基準 1,825 m の近く）、滑走路の端からの長さ（4,000 m）、FPPM の制限重量（構造の 285,763 kg：FCOM p.78）と quick turnaround を確かめる。窓は自分で頼んでいない答えも入力ごと取り込むので、離陸と着陸のページを撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "新しい窓のプラグイン（ページの dataref がある）", "dref": "laminar/B747/efb/page", "op": "==", "value": 0, "stop": true },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "view", "note": "前", "the": -8, "psi": 0, "fov": 70 },
    { "do": "set", "note": "窓を開く", "dref": "laminar/B747/efb/window_open", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "note": "離陸：RJAA", "dref": "laminar/B747/efb/req_i[0]", "value": 925482 },
    { "do": "set", "note": "34L", "dref": "laminar/B747/efb/req_i[1]", "value": 1562473 },
    { "do": "set", "note": "フラップ 20", "dref": "laminar/B747/efb/req_i[2]", "value": 20 },
    { "do": "set", "note": "TO", "dref": "laminar/B747/efb/req_i[3]", "value": 0 },
    { "do": "set", "note": "assumed temperature あり", "dref": "laminar/B747/efb/req_i[4]", "value": 1 },
    { "do": "set", "note": "パック 3 台", "dref": "laminar/B747/efb/req_i[5]", "value": 3 },
    { "do": "set", "note": "防氷なし", "dref": "laminar/B747/efb/req_i[6]", "value": 0 },
    { "do": "set", "note": "乾いた滑走路", "dref": "laminar/B747/efb/req_i[7]", "value": 0 },
    { "do": "set", "note": "OAT 15 ℃", "dref": "laminar/B747/efb/req_f[0]", "value": 15 },
    { "do": "set", "note": "QNH 1013", "dref": "laminar/B747/efb/req_f[1]", "value": 1013 },
    { "do": "set", "note": "無風", "dref": "laminar/B747/efb/req_f[2]", "value": 0 },
    { "do": "set", "note": "300 t", "dref": "laminar/B747/efb/req_f[3]", "value": 300000 },
    { "do": "set", "note": "CG 22 %", "dref": "laminar/B747/efb/req_f[4]", "value": 22 },
    { "do": "set", "note": "端から", "dref": "laminar/B747/efb/req_f[5]", "value": 0 },
    { "do": "set", "note": "長さはデータの", "dref": "laminar/B747/efb/req_f[6]", "value": 0 },
