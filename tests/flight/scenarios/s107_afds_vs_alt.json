{
  "name": "s107_afds_vs_alt",
  "description": "AFDS の作り直し 6-3 段 3a（ピッチの則：V/S・ALT とその捕捉）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・指示 250 kt（真 290 kt）・北向きで開始（機体を読み直す）。A/P CMD L・HDG SEL・A/T SPD 250 kt。V/S +2,000 fpm で MCP 高度 12,000 ft：捕捉は約 680 ft 手前（0.05 g の水平への引き起こしと 10 秒分：ATA22 p.286）、行き過ぎは 50 ft まで。V/S −1,500 fpm で 10,500 ft：同じく下へ。V/S +1,000 から 000：その時の高度を保つ（ATA22 p.282）。V/S +2,000 の上昇中に ALT HOLD：押した時の高度へ行き過ぎて戻る（FCOM p.650）。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 149.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "ALT はピッチの則（6-3 段 3a）", "dref": "laminar/B747/autopilot/pitch_law", "op": "==", "value": 1 },

    { "do": "mark", "note": "V/S +2,000 で 12,000 ft を捕捉（ATA22 p.286：0.05 g）" },
    { "do": "set", "note": "MCP 高度 12,000 ft（前の則の目標にも）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 12000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 12000 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S +2,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 2000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 2000 },
    { "do": "wait", "note": "+2,000 fpm に乗る（±200）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [1800, 2200], "timeout": 40 },
    { "do": "wait", "note": "捕捉で ALT（FMA 9）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 120 },
    { "do": "snapshot", "note": "捕捉", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/autopilot/altitude_hold_ft" ] },
    { "do": "check", "note": "捕捉は 550〜800 ft 手前（0.05 g の引き起こし 345 ft と 10 秒分）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [11200, 11450] },
    { "do": "check", "note": "保つ高度は 12,000 ft", "dref": "laminar/B747/autopilot/altitude_hold_ft", "op": "between", "value": [11999, 12001] },
    { "do": "watch", "note": "行き過ぎは 50 ft まで（60 秒）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 12050, "timeout": 60 },
    { "do": "check", "note": "12,000 ft で水平（±30 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [11970, 12030] },
    { "do": "watch", "note": "その後 30 秒、12,000 ft の ±40 ft に留まる", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "min": 11960, "max": 12040, "timeout": 30 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_alt_captured" },

    { "do": "mark", "note": "V/S −1,500 で 10,500 ft を捕捉" },
    { "do": "set", "note": "MCP 高度 10,500 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10500 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 10500 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S −1,500 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -1500 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": -1500 },
    { "do": "wait", "note": "−1,500 fpm に乗る（±200）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-1700, -1300], "timeout": 40 },
    { "do": "wait", "note": "捕捉で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 120 },
    { "do": "check", "note": "捕捉は 350〜600 ft 手前（194 ft と 10 秒分）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [10850, 11100] },
    { "do": "watch", "note": "行き過ぎは 50 ft まで（60 秒）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "min": 10450, "timeout": 60 },
    { "do": "check", "note": "10,500 ft で水平（±30 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [10470, 10530] },

    { "do": "mark", "note": "V/S 000：その時の高度を保つ（ATA22 p.282）" },
    { "do": "set", "note": "MCP 高度 15,000 ft（捕捉しない）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 15000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 15000 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S +1,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "wait", "note": "+1,000 fpm に乗る", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [800, 1200], "timeout": 40 },
    { "do": "set", "note": "V/S 000", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 0 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 0 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt000" },
    { "do": "sleep", "seconds": 40 },
    { "do": "check", "note": "FMA は V/S のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "000 にした時の高度を保つ（行き過ぎの分を戻して ±60 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [-60, 60], "rel": "alt000" },

    { "do": "mark", "note": "上昇中の ALT HOLD：押した時の高度（FCOM p.650）" },
    { "do": "set", "note": "V/S +2,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 2000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 2000 },
    { "do": "wait", "note": "+2,000 fpm に乗る", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [1800, 2200], "timeout": 40 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "remember", "dref": "laminar/B747/autopilot/altitude_hold_ft", "as": "alt_push" },
    { "do": "watch", "note": "行き過ぎは 0.05 g の引き起こしの分（450 ft まで）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 99999, "timeout": 60 },
    { "do": "check", "note": "押した時の高度へ戻る（±60 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [-60, 60], "rel": "alt_push" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_alt_hold" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
