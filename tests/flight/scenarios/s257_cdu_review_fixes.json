{
  "name": "s257_cdu_review_fixes",
  "description": "2026-11-05 のレビューの 1-1・1-3 の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す：FMC のデータは空）。重量を入れる前に TAKEOFF REF の CG（R4）を空のスクラッチパッドで押す（前は Lua エラーで xtlua_keysystems の全モジュールが止まった）：CG はシムの値、TRIM は空欄、その後もページが動く。MENU → GROUND HANDLING → PAX/CARGO で、30.5 人と 3A は INVALID ENTRY（前は 30.5 で XTLua が回り続け、3A で止まった）、30 人は 5 区画に振り分け。ランナーは Output/B747_xtlua_errors.txt の新しい行で落とす。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "check", "note": "便利機能は入（初期値）", "dref": "laminar/B747/options/cdu_sim_values", "op": "==", "value": 1 },

    { "do": "mark", "note": "1-1：重量より先に CG" },
    { "do": "cdu", "keys": ["INITREF"] },
    { "do": "check", "note": "PERF INIT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF INIT" },
    { "do": "check", "note": "GR WT はまだボックス", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "***.*" },
    { "do": "cdu", "keys": ["L6", "L5"], "note": "INDEX → TAKEOFF" },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF" },
    { "do": "cdu", "keys": ["R4"], "note": "空のスクラッチパッドで CG（シムの値）" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "CG にシムの値（整数の %）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "[0-9]{1,2}%$" },
    { "do": "check", "note": "INVALID ENTRY は出ない", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^ *$" },
    { "do": "snapshot", "note": "CG と TRIM の行（TRIM は重量が無いので空欄）", "drefs": ["laminar/B747/fms3/Line08_S", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line09_S", "sim/flightmodel2/misc/cg_offset_z_mac"] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "note": "TAKEOFF REF：CG だけ", "name": "takeoff_cg_first" },
    { "do": "cdu", "keys": ["L6"], "note": "INDEX（プラグインが止まっていればページは変わらない）" },
    { "do": "check", "note": "ページが動く：INIT/REF INDEX", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "INDEX" },
    { "do": "cdu", "keys": ["L3"], "note": "PERF" },
    { "do": "cdu", "keys": ["L1"], "note": "空のスクラッチパッドで GR WT（シムの値）" },
    { "do": "check", "note": "GR WT にシムの値", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^ ?[0-9]{3}[.][0-9] " },
    { "do": "cdu", "keys": ["L6", "L5", "R4"], "note": "TAKEOFF REF で CG をもう一度" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "重量があれば TRIM が出る", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "[0-9][.][0-9]" },
    { "do": "snapshot", "note": "CG と TRIM", "drefs": ["laminar/B747/fms3/Line08_S", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line09_S"] },
    { "do": "shot", "note": "TAKEOFF REF：CG と TRIM", "name": "takeoff_cg_trim" },

    { "do": "mark", "note": "1-3：PAX/CARGO" },
    { "do": "cdu", "keys": ["MENU", "R4", "R3"], "note": "MENU → GROUND HANDLING → PAX/CARGO" },
    { "do": "check", "note": "PAX/CARGO", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PAX" },
    { "do": "cdu", "keys": ["30.5", "L1"], "note": "小数の人数" },
    { "do": "check", "note": "INVALID ENTRY（前は XTLua が回り続けた）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear", "duration": 1.5 },
    { "do": "cdu", "keys": ["3A", "L1"], "note": "数字と文字" },
    { "do": "check", "note": "INVALID ENTRY（前は Lua エラー）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear", "duration": 1.5 },
    { "do": "cdu", "keys": ["30", "L1"], "note": "30 人" },
    { "do": "check", "note": "メッセージなし", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^ *$" },
    { "do": "snapshot", "note": "PAX/CARGO の行", "drefs": ["laminar/B747/fms3/Line02_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line06_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L"] },
    { "do": "shot", "note": "PAX/CARGO：30 人", "name": "pax_30" },
    { "do": "cdu", "keys": ["INITREF"], "note": "FMC のページに戻れる" },
    { "do": "check", "note": "ページが動く", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "PERF INIT|INDEX|TAKEOFF" }
  ]
}
