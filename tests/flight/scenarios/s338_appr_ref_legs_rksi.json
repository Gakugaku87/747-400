{
  "name": "s338_appr_ref_legs_rksi",
  "description": "APPROACH REF の滑走路の行と、LEGS の速さだけの制限の点の予測の高度（2026-11-19、notes/ATA-34-61-FMC.md §170 の 1・2。利用者の RKSI 34R への飛行の写真と問い）の X-Plane での確認、空中。本物の航法データ（AIRAC 2611）。GUKDO の東約 25 NM の FL180 で空中開始（270 t）。RTE RJAA→RKSI、RUNWAY 34L、DIRECT GUKDO、ACTIVATE・EXEC。(1) 進入の無いうち APPROACH REF の 4L は出発の滑走路：見出し RJAA34L、長さ FT と M（FCOM p.1411：目的地の滑走路か進入が経路に入り、出発空港から 50 NM か半分を過ぎるまで出発の滑走路。p.1409 の図の形）。前は固定の伏せ字（□）。(2) ARRIVALS で STAR GUKD2E・ILS34R・遷移 ENPIL、PERF INIT（ZFW 200・FL180・CI 100）。LEGS の GE023・GE022（GUKD2E の速さだけの制限 210）は大きい字の「210/」の後に、予測の高度を小さい字で（FCOM p.1330 の図と p.1332：制限は大きい字、予測は小さい字）。前は「210/」が行の端で、高度が空白。(3) APPROACH REF の 4L は目的地の滑走路：RKSI34R。CDU を撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 37.00, "longitude": 128.15, "elevation_in_meters": 5486, "heading_true": 282, "speed_in_meters_per_second": 165 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "CLR、RTE：RJAA→RKSI、RUNWAY 34L、DIRECT GUKDO", "keys": ["CLR", "CLR", "CLR", "RTE", "RJAA", "L1", "RKSI", "R1", "34L", "L2", "NEXT", "GUKDO", "R1", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "経路が有効", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1", "stop": true },
    { "do": "cdu", "note": "INIT REF（空中：APPROACH REF）", "keys": ["INITREF"] },
    { "do": "check", "note": "APPROACH REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "APPROACH REF", "stop": true },
    { "do": "snapshot", "note": "APPROACH REF（進入の前）", "drefs": [ "laminar/B747/fms3/Line08_S", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line09_S" ] },
    { "do": "check", "note": "4L の見出しは出発の滑走路 RJAA34L（進入がまだ無い：FCOM p.1411）", "dref": "laminar/B747/fms3/Line08_S", "op": "matches", "value": "^ RJAA34L +FLAP/SPEED$" },
    { "do": "check", "note": "長さ：5 桁の FT と 4 桁の M（RJAA 34L は 4,000 m。CIFP の閾値からの見積もり）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^1[23][0-9]{3}  [34][0-9]{3} +--/---$" },
    { "do": "check", "note": "FT と M は小さい字（p.1409 の図）", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^ {5}FT {4}M" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_appr_ref_dep" },
    { "do": "cdu", "note": "DEP ARR（空中・有効な経路：ARRIVALS）", "keys": ["DEPARR"] },
    { "do": "wait", "note": "RKSI ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RKSI ARRIVALS", "timeout": 10, "stop": true },
    { "do": "check", "note": "1 ページ目の 5L が GUKD2E", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^GUKD2E ", "stop": true },
    { "do": "cdu", "note": "GUKD2E（5L）", "keys": ["L5"] },
    { "do": "wait", "note": "GUKD2E <SEL>", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^GUKD2E<SEL>", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "3 ページ目へ", "keys": ["NEXT", "NEXT"] },
    { "do": "check", "note": "3 ページ目の 2R が ILS34R", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "ILS34R$", "stop": true },
    { "do": "cdu", "note": "ILS34R（2R）", "keys": ["R2"] },
    { "do": "wait", "note": "GUKD2E と ILS34R", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^GUKD2E<SEL> +<SEL>ILS34R$", "timeout": 10, "stop": true },
    { "do": "check", "note": "遷移の 2R が ENPIL", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "ENPIL$", "stop": true },
    { "do": "cdu", "note": "ENPIL（2R）、EXEC", "keys": ["R2", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL180、COST INDEX 100、EXEC", "keys": ["INITREF", "L6", "L3", "200", "L3", "180", "R1", "100", "L5", "EXEC"] },
    { "do": "sleep", "seconds": 5, "note": "予測" },
    { "do": "cdu", "note": "LEGS の 2 ページ目（GE023 から）", "keys": ["LEGS", "NEXT"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "LEGS 2 ページ目", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line05_S", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line07_S" ] },
    { "do": "check", "note": "GE023 は大きい字の 210/ の後に高度の 5 桁の空き", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^GE023 +210/ {5}$" },
    { "do": "check", "note": "その空きに予測の高度が小さい字（FCOM p.1332）", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^ +(FL[0-9]{3}| ?[0-9]{4,5})$" },
    { "do": "check", "note": "GE022 も同じ", "dref": "laminar/B747/fms3/Line05_S", "op": "matches", "value": "^ +(FL[0-9]{3}| ?[0-9]{4,5})$" },
    { "do": "shot", "name": "cdu_legs_ge023" },
    { "do": "cdu", "note": "INIT REF（APPROACH REF）", "keys": ["INITREF"] },
    { "do": "snapshot", "note": "APPROACH REF（進入の後）", "drefs": [ "laminar/B747/fms3/Line08_S", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line09_S" ] },
    { "do": "check", "note": "4L の見出しは目的地の滑走路 RKSI34R（進入が入り、出発空港から 50 NM より遠い）", "dref": "laminar/B747/fms3/Line08_S", "op": "matches", "value": "^ RKSI34R +FLAP/SPEED$" },
    { "do": "check", "note": "長さ（RKSI 34R は 4,000 m）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^1[23][0-9]{3}  [34][0-9]{3} +--/---$" },
    { "do": "shot", "name": "cdu_appr_ref_dest" },
    { "do": "view", "name": "forward" }
  ]
}
