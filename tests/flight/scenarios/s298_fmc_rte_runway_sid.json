{
  "name": "s298_fmc_rte_runway_sid",
  "description": "SID を選んだ後の RTE の RUNWAY の変更（2026-11-12 のフルレビュー FMC-4：REVIEW_2026-11-12.md 案 8）の X-Plane での確認。本物の航法データの RJAA（AIRAC 2611）の地上（機体を読み直す、270 t）。RTE RJAA→RJBB、DEPARTURES で 16R と AKAGI4（16R と 34L の SID）、その後 RTE の RUNWAY（2L）に 34L。前：SID の脚は 16R のまま（D157N から）。直した後（FCOM p.1301、FMSPG p.79・p.90：RTE の RUNWAY は DEPARTURES と同じ欄。脚の入れ直しは同じ欄という記述からの読み）：LEGS の頭が DEPARTURES で 34L と AKAGI4 を選んだときと同じ（D337F・NRE001・NRE036）。CDU を撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "FMS の初期化" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "CLR、RTE：RJAA→RJBB", "keys": ["CLR", "CLR", "CLR", "RTE", "RJAA", "L1", "RJBB", "R1"] },
    { "do": "cdu", "note": "DEP ARR（経路が有効でない：DEP/ARR INDEX）、<DEP（L1）", "keys": ["DEPARR", "L1"] },
    { "do": "wait", "note": "RJAA DEPARTURES", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA DEPARTURES", "timeout": 10, "stop": true },
    { "do": "check", "note": "1L が AKAGI4、2R が 16R", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "16R$", "stop": true },
    { "do": "cdu", "note": "16R（2R）", "keys": ["R2"] },
    { "do": "wait", "note": "16R <SEL>、1L は AKAGI4", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^AKAGI4 +<SEL>16R$", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "AKAGI4（1L）", "keys": ["L1"] },
    { "do": "wait", "note": "AKAGI4 と 16R", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^AKAGI4<SEL> +<SEL>16R$", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "16R の LEGS", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L" ] },
    { "do": "check", "note": "16R の AKAGI4 は D157N から", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^D157N", "stop": true },
    { "do": "mark", "note": "RTE の RUNWAY に 34L" },
    { "do": "cdu", "note": "RTE、RUNWAY（2L）に 34L", "keys": ["RTE", "34L", "L2"] },
    { "do": "check", "note": "RUNWAY は RW34L", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^RW34L", "stop": true },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "34L の LEGS", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L" ] },
    { "do": "check", "note": "34L の AKAGI4：1 行目 D337F（前は 16R の D157N のまま）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^D337F" },
    { "do": "check", "note": "2 行目 NRE001", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^NRE001" },
    { "do": "check", "note": "3 行目 NRE036", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^NRE036" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_legs_34l" }
  ]
}
