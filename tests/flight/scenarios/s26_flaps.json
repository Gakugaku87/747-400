{
  "name": "s26_flaps",
  "description": "フラップ制御（4-1 段 1：FCU）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始め（X-Plane の滑走路からの開始のレバーは 0 のときと 10 のときがあった）、レバーを 10 にして後縁 10° と前縁が出ることを見る。外側フラップの wing 2 の部分も動くこと（前は 0° のままだった）。UP で後縁を格納し、group B は内側の後縁が 4.5° 未満、group A は外側の後縁が UP で格納（ATA27 p.381）、全部 UP から 10 秒で表示が消える（FCOM p.954）。レバー 1 で group A が約 9 秒で出て後縁は UP のまま。油圧系統 1 を落としてレバー 5：指令があって 1400 psi 未満が 4 秒で内側の後縁が副系統（電動、遅い）、FLAPS PRIMARY と拡大表示、圧が戻ると主系統（FCOM p.953）。外側の前縁の空気圧駆動の故障（laminar/B747/flt_ctrls/fail/le_primary）で 30 秒後に電動、LE SINGLE DRIVE。ALTN FLAPS ARM で FLAPS CONTROL、EXT で電動でゆっくり。地上の逆推力（1・4 と 2・3）で group A が格納され、やめると出る（ATA27 p.382）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "sim/cockpit2/controls/parking_brake_ratio", "value": 1 },
    { "do": "set", "note": "レバー 10（開始のレバーは 0 か 10）", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "レバー 10", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/cockpit2/controls/flap_ratio", "laminar/B747/cablecontrols/flap_ratio",
      "laminar/B747/flt_ctrls/fcu/te_deg[0]", "laminar/B747/flt_ctrls/fcu/te_deg[1]", "laminar/B747/flt_ctrls/fcu/slat[0]", "laminar/B747/flt_ctrls/fcu/slat[1]",
      "sim/flightmodel/controls/wing1l_fla1def", "sim/flightmodel/controls/wing2l_fla2def", "sim/flightmodel/controls/wing3l_fla2def",
      "sim/flightmodel/controls/wing2r_fla2def", "sim/flightmodel2/controls/slat1_deploy_ratio", "sim/flightmodel2/controls/slat2_deploy_ratio",
      "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "laminar/B747/flt_ctrls/flap/transition_status",
      "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_4", "laminar/B747/air/duct_pressure_L" ] },
    { "do": "check", "note": "レバー 10：後縁 10°（30° を 45 秒）", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "between", "value": [9.9, 10.1] },
    { "do": "check", "note": "X-Plane の左内側フラップ 10°", "dref": "sim/flightmodel/controls/wing1l_fla1def", "op": "between", "value": [9.9, 10.1] },
    { "do": "check", "note": "外側フラップの wing 2 の部分も 10°（前は 0° のまま）", "dref": "sim/flightmodel/controls/wing2l_fla2def", "op": "between", "value": [9.9, 10.1] },
    { "do": "check", "note": "右も", "dref": "sim/flightmodel/controls/wing2r_fla2def", "op": "between", "value": [9.9, 10.1] },
    { "do": "check", "note": "前縁 group A 展開（X-Plane のスラット比）", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "check", "note": "group B 展開", "dref": "sim/flightmodel2/controls/slat2_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "check", "note": "表示は通常（1）", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "check", "note": "レバーの位置にある：緑", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 0 },

    { "do": "mark", "note": "格納の順序" },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "8 秒：後縁は格納中（30° を 45 秒、主系統）", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "between", "value": [3, 6.5] },
    { "do": "check", "note": "group A はまだ出ている（外側の後縁が UP になるまで）", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "sleep", "seconds": 18 },
    { "do": "check", "note": "後縁 UP", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "group B 格納", "dref": "sim/flightmodel2/controls/slat2_deploy_ratio", "op": "<", "value": 0.01 },
    { "do": "check", "note": "group A 格納", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": "<", "value": 0.01 },
    { "do": "check", "note": "全部 UP でも 10 秒は表示", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 11 },
    { "do": "check", "note": "全部 UP から 10 秒で表示が消える（FCOM p.954）", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 0 },

    { "do": "mark", "note": "レバー 1：group A" },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.167 },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "4 秒：group A は途中（約 9 秒）", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": "between", "value": [0.3, 0.65] },
    { "do": "check", "note": "後縁は UP のまま", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "移動中：マゼンタ", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 1 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_flaps1_moving" },
    { "do": "sleep", "seconds": 6 },
    { "do": "check", "note": "group A 展開", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "check", "note": "緑", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 0 },
    { "do": "view", "the": -24, "psi": 32.6, "fov": 12 },
    { "do": "shot", "name": "flaps1" },

    { "do": "mark", "note": "油圧系統 1 を落とす：内側の後縁が副系統" },
    { "do": "switch", "note": "ENGINE pump 1 OFF", "dref": "laminar/B747/button_switch/position[30]", "value": 0, "cmd": "laminar/B747/button_switch/hyd_pump_1" },
    { "do": "switch", "note": "DEMAND 1 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_dn" },
    { "do": "sleep", "seconds": 6 },
    { "do": "check", "note": "系統 1 の圧が 1400 psi 未満", "dref": "laminar/B747/hydraulics/pressure_1", "op": "<", "value": 1400 },
    { "do": "check", "note": "指令が無いので主系統のまま（FLAPS PRIMARY は出ない）", "dref": "laminar/B747/CAS/caution_status[30]", "op": "==", "value": 0 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.333 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "指令があって 4 秒：内側は副系統（FCOM p.953）", "dref": "laminar/B747/flt_ctrls/fcu/te_mode[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "FLAPS PRIMARY（FCOM p.957）", "dref": "laminar/B747/CAS/caution_status[30]", "op": "==", "value": 1 },
    { "do": "check", "note": "拡大表示（2）", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 2 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "副系統", "drefs": [ "laminar/B747/flt_ctrls/fcu/te_deg[0]", "laminar/B747/flt_ctrls/fcu/te_deg[1]",
      "laminar/B747/gauges/indicators/flap_deployed_ratio1", "laminar/B747/gauges/indicators/flap_deployed_ratio2", "laminar/B747/hydraulics/pressure_1" ] },
    { "do": "check", "note": "外側は主系統で 5°", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[0]", "op": "between", "value": [4.9, 5.1] },
    { "do": "check", "note": "内側は電動でゆっくり（主系統の 1/10、推定）", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "between", "value": [0.1, 1.5] },
    { "do": "shot", "name": "flaps_expanded_secondary" },
    { "do": "cas", "note": "FLAPS PRIMARY" },
    { "do": "switch", "note": "DEMAND 1 AUTO", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 1, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_up" },
    { "do": "switch", "note": "ENGINE pump 1 ON", "dref": "laminar/B747/button_switch/position[30]", "value": 1, "cmd": "laminar/B747/button_switch/hyd_pump_1" },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "1600 psi 超が 4 秒で主系統に戻る", "dref": "laminar/B747/flt_ctrls/fcu/te_mode[0]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "内側も 5°", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "between", "value": [4.9, 5.1] },
    { "do": "check", "note": "FLAPS PRIMARY が消える", "dref": "laminar/B747/CAS/caution_status[30]", "op": "==", "value": 0 },
    { "do": "check", "note": "通常の表示", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 1 },

    { "do": "mark", "note": "外側の前縁の空気圧駆動の故障" },
    { "do": "set", "note": "外側の前縁の空気圧駆動の故障", "dref": "laminar/B747/flt_ctrls/fail/le_primary[2]", "value": 1 },
    { "do": "set", "note": "レバー 1（group B を格納する）", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.167 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "20 秒：group B は動かず、まだ空気圧のまま", "dref": "laminar/B747/flt_ctrls/fcu/le_mode[2]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 13 },
    { "do": "check", "note": "30 秒で電動（FCOM p.953）", "dref": "laminar/B747/flt_ctrls/fcu/le_mode[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "FLAPS PRIMARY", "dref": "laminar/B747/CAS/caution_status[30]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS LE SINGLE DRIVE（ATA27 p.411）", "dref": "laminar/B747/CAS/status_status[82]", "op": "==", "value": 1 },
    { "do": "set", "note": "故障を戻す（電動は指令の位置まで続く）", "dref": "laminar/B747/flt_ctrls/fail/le_primary[2]", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "電動でゆっくり格納中（約 90 秒）", "dref": "sim/flightmodel2/controls/slat2_deploy_ratio", "op": "between", "value": [0.8, 0.99] },

    { "do": "mark", "note": "ALTN FLAPS" },
    { "do": "switch", "note": "ALTN FLAPS ARM", "dref": "laminar/B747/button_switch/position[0]", "value": 1, "cmd": "laminar/B747/button_switch/altn_flap" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FLAPS CONTROL（FCOM p.957）", "dref": "laminar/B747/CAS/caution_status[28]", "op": "==", "value": 1 },
    { "do": "check", "note": "拡大表示", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 2 },
    { "do": "switch", "note": "ALTN FLAPS EXT", "dref": "laminar/B747/flt_ctrls/alt_flaps/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/flt_ctrls/flaps/alt_flaps/sel_dial_up", "cmd_down": "laminar/B747/flt_ctrls/flaps/alt_flaps/sel_dial_dn" },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "EXT：後縁が電動でゆっくり出る", "dref": "laminar/B747/flt_ctrls/fcu/te_deg[1]", "op": "between", "value": [0.5, 1.5] },
    { "do": "shot", "name": "flaps_alternate" },
    { "do": "switch", "note": "ALTN FLAPS OFF", "dref": "laminar/B747/flt_ctrls/alt_flaps/sel_dial_pos", "value": 0,
      "cmd": "laminar/B747/flt_ctrls/flaps/alt_flaps/sel_dial_up", "cmd_down": "laminar/B747/flt_ctrls/flaps/alt_flaps/sel_dial_dn" },
    { "do": "switch", "note": "ALTN FLAPS ARM を戻す", "dref": "laminar/B747/button_switch/position[0]", "value": 0, "cmd": "laminar/B747/button_switch/altn_flap" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FLAPS CONTROL が消える", "dref": "laminar/B747/CAS/caution_status[28]", "op": "==", "value": 0 },

    { "do": "mark", "note": "地上の逆推力で group A を格納" },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "group A 展開", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "check", "note": "group B 展開", "dref": "sim/flightmodel2/controls/slat2_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "cmd", "note": "逆推力を引く（全エンジン、8 秒）", "name": "sim/engines/thrust_reverse_hold", "duration": 8 },
    { "do": "sleep", "seconds": 7 },
    { "do": "check", "note": "1・4 と 2・3 が逆推力：group A が格納（ATA27 p.382）", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": "<", "value": 0.4 },
    { "do": "check", "note": "group B はそのまま", "dref": "sim/flightmodel2/controls/slat2_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "check", "note": "表示は移動中（FCOM p.955）", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 13 },
    { "do": "check", "note": "逆推力をやめると group A が出る", "dref": "sim/flightmodel2/controls/slat1_deploy_ratio", "op": ">", "value": 0.99 },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "name": "forward" }
  ]
}
