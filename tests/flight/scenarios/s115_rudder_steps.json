{
  "name": "s115_rudder_steps",
  "description": "AFDS の作り直し 6-3 段 4d（runway align）の下調べ：X-Plane の 747 の横・方向の動き（横滑り角・ロールとヨーの角速度・バンク）を、方向舵と補助翼の入力から最小二乗で当てはめるための記録（tests/tools/lat_sysid.lua）。s114 と同じ所（RJAA 34L の 12 NM 手前、2,500 ft）から、脚下げ・フラップ 30・150 kt・A/P 1 台（CMD L）の ALT HOLD と HDG HOLD で、方向舵のトリム（ペダルの 0.8 倍が方向舵の入力：hydraulics_override）を 0.125・0・−0.125・0・0.25・0 と段で入れ、その後に HDG SEL で 10° の左右の旋回。合否は無い（A/P が入ったままで、高度と方位が大きく外れないことだけ見る）。機体を読み直す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 87.5 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 2,500 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 2500 },
    { "do": "set", "note": "MCP 方位 337", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "150 kt に近づく", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 152, "timeout": 120 },
    { "do": "sleep", "seconds": 15, "note": "落ち着く" },
    { "do": "cmd", "note": "HDG HOLD（3D のボタンは X-Plane のコマンド）", "name": "sim/autopilot/heading_hold" },
    { "do": "remember", "note": "ALT HOLD の高度（空中開始の揺れで 2,000 ft 付近まで下がってから保つ）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "sleep", "seconds": 5 },
    { "do": "mark", "note": "方向舵のトリム +0.125" },
    { "do": "set", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.125 },
    { "do": "sleep", "seconds": 12 },
    { "do": "set", "note": "0", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 12 },
    { "do": "set", "note": "−0.125", "dref": "sim/cockpit2/controls/rudder_trim", "value": -0.125 },
    { "do": "sleep", "seconds": 12 },
    { "do": "set", "note": "0", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 12 },
    { "do": "set", "note": "+0.25", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0.25 },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "0", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 12 },
    { "do": "mark", "note": "HDG SEL 327 と 337" },
    { "do": "set", "note": "MCP 方位 327", "dref": "laminar/B747/autopilot/heading/degrees", "value": 327 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "MCP 方位 337", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "A/P のまま", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "高度が大きく外れない（方向舵の段の前から ±200 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [-200, 200], "rel": "alt0" },
    { "do": "record_stop" }
  ]
}
