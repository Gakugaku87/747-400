{
  "name": "s39_steering",
  "description": "ステアリング（4-2 段 3 の次、段 4）の X-Plane での確認。RJAA 34L でエンジン運転中に、X-Plane の wheel steering の上書き、tiller（laminar/B747/gear/steering/tiller）いっぱいで前輪 70°・胴体脚が逆向きに 13°、そのまま少し推力を出して左へ 30° 回る、tiller を戻すと前輪と胴体脚が中立でロック。tiller の軸が無いのでペダルを tiller として 70°（実機ではない）、切ると 7°（FCOM p.1513）。胴体脚が中立でないまま離陸推力で CONFIG GEAR CTR（FCOM p.1603）。故障で PEDAL STEERING と >BODY GEAR STRG。機体を読み直す。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 12, "note": "開始の 3 秒と、胴体脚の arm の地上 10 秒を待つ" },
    { "do": "check", "note": "X-Plane の wheel steering は常に上書き（前は 20 kt 未満で X-Plane 任せ）", "dref": "sim/operation/override/override_wheel_steer", "op": "==", "value": 1 },
    { "do": "check", "note": "tiller の軸が無い利用者向けのペダル tiller は、読み込みで入（実機ではない）", "dref": "laminar/B747/gear/steering/pedal_tiller", "op": "==", "value": 1 },
    { "do": "check", "note": "胴体脚はロック", "dref": "laminar/B747/gear/steering/body_unlocked", "op": "==", "value": 0 },

    { "do": "mark", "note": "tiller" },
    { "do": "set", "note": "tiller を左いっぱい", "dref": "laminar/B747/gear/steering/tiller", "value": -1 },
    { "do": "wait", "note": "前輪 70° 左（FCOM p.1513）", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[0]", "op": "<", "value": -69.9, "timeout": 8 },
    { "do": "wait", "note": "左の胴体脚が逆向きに 13°（ATA29_32 p.604）", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[2]", "op": ">", "value": 12.9, "timeout": 10 },
    { "do": "check", "note": "右の胴体脚も", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[1]", "op": ">", "value": 12.9 },
    { "do": "check", "note": "翼脚は動かない", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[4]", "op": "==", "value": 0 },
    { "do": "check", "note": "胴体脚のロックが外れている", "dref": "laminar/B747/gear/steering/body_unlocked", "op": "==", "value": 1 },
    { "do": "remember", "dref": "sim/flightmodel/position/psi", "as": "hdg" },
    { "do": "set", "note": "パーキングブレーキのレバーを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "set", "note": "推力を少し", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.3 },
    { "do": "wait", "note": "左へ 30° 回る", "dref": "sim/flightmodel/position/psi", "op": "<", "value": -30, "rel": "hdg", "timeout": 90 },
    { "do": "check", "note": "回っている間も胴体脚は 13°（15 kt 未満）", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[2]", "op": ">", "value": 12.9 },
    { "do": "set", "note": "推力レバーをアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "cmd", "note": "ブレーキ max（8 秒、押している間に次へ）", "name": "sim/flight_controls/brakes_max", "duration": 8, "async": true },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 0.3, "timeout": 30 },
    { "do": "set", "note": "tiller を戻す", "dref": "laminar/B747/gear/steering/tiller", "value": 0 },
    { "do": "wait", "note": "前輪が中立", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[0]", "op": "between", "value": [-0.1, 0.1], "timeout": 8 },
    { "do": "wait", "note": "胴体脚も中立でロック", "dref": "laminar/B747/gear/steering/body_unlocked", "op": "==", "value": 0, "timeout": 8 },

    { "do": "mark", "note": "pedals" },
    { "do": "set", "note": "パーキングブレーキのレバー", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "set", "note": "ラダーペダルを右いっぱい", "dref": "sim/cockpit2/controls/yoke_heading_ratio", "value": 1 },
    { "do": "wait", "note": "tiller の軸が無く止まっている：ペダルで 70°（実機ではない）", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[0]", "op": ">", "value": 69.9, "timeout": 8 },
    { "do": "set", "note": "ペダル tiller を切る", "dref": "laminar/B747/gear/steering/pedal_tiller", "value": 0 },
    { "do": "wait", "note": "ペダルだけ：7°（FCOM p.1513）", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[0]", "op": "<", "value": 7.1, "timeout": 8 },
    { "do": "check", "note": "7°", "dref": "sim/flightmodel2/gear/tire_steer_actual_deg[0]", "op": ">", "value": 6.9 },
    { "do": "set", "note": "ペダルを戻す", "dref": "sim/cockpit2/controls/yoke_heading_ratio", "value": 0 },
    { "do": "set", "note": "ペダル tiller を戻す", "dref": "laminar/B747/gear/steering/pedal_tiller", "value": 1 },

    { "do": "mark", "note": "CONFIG GEAR CTR" },
    { "do": "set", "note": "tiller を右いっぱい", "dref": "laminar/B747/gear/steering/tiller", "value": 1 },
    { "do": "wait", "note": "胴体脚のロックが外れる", "dref": "laminar/B747/gear/steering/body_unlocked", "op": "==", "value": 1, "timeout": 10 },
    { "do": "set", "note": "推力レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "CONFIG GEAR CTR（FCOM p.1603）", "dref": "laminar/B747/CAS/warning_status[4]", "op": "==", "value": 1, "timeout": 40 },
    { "do": "set", "note": "推力レバーをアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "set", "note": "tiller を戻す", "dref": "laminar/B747/gear/steering/tiller", "value": 0 },
    { "do": "wait", "note": "消える", "dref": "laminar/B747/CAS/warning_status[4]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "mark", "note": "failures" },
    { "do": "set", "note": "ペダル steering の interconnect actuator の故障", "dref": "laminar/B747/gear/fail/pedal_steering", "value": 1 },
    { "do": "wait", "note": "STATUS の PEDAL STEERING（ATA29_32 p.600）", "dref": "laminar/B747/CAS/status_status[96]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "dref": "laminar/B747/gear/fail/pedal_steering", "value": 0 },
    { "do": "set", "note": "胴体脚のアクチュエーターがロックしない故障", "dref": "laminar/B747/gear/fail/body_steering", "value": 1 },
    { "do": "wait", "note": ">BODY GEAR STRG（FCOM p.1521）", "dref": "laminar/B747/CAS/advisory_status[43]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "check", "note": "STATUS の BODY GR STRG SYS（ATA29_32 p.630）", "dref": "laminar/B747/CAS/status_status[95]", "op": "==", "value": 1 },
    { "do": "set", "dref": "laminar/B747/gear/fail/body_steering", "value": 0 },
    { "do": "wait", "note": "消える", "dref": "laminar/B747/CAS/advisory_status[43]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "cas", "note": "終わり" }
  ]
}
