{
  "name": "s101_afds_pitch",
  "description": "AFDS の作り直し 6-3 段 1c（ピッチのモード：V/S・ALT・FLCH・VNAV・SPD）の X-Plane での確認、空中。10,000 ft・約 290 kt で空中から始め（機体を読み直す）、FMS の空中の初期化が終わるのを待ち（A/P CMD L・ALT・HDG HOLD）、経路（RJAA→RJBB）と CRZ ALT（FL350）を CDU で入れてから（前の VNAV は経路が無いと外れる：FMC の段 9 まで）、V/S を押すと今の昇降率に合わせる（前は 0）、+1,500 fpm で上がって MCP の 11,000 ft を捕捉して ALT、ALT の後の V/S は 000（ATA22 p.282）、FLCH で 10,000 ft へ降りて捕捉、FLCH 中の SPD は効かない（FCOM p.642）、上昇中の ALT HOLD でその高度を保つ、VNAV は空中ではすぐ engage して MCP の 13,000 ft へ VNAV SPD（前の arm は ALT HOLD を立てた）、engage 中に押しても何もしない、V/S で終わる（FCOM p.645）。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "check", "note": "ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "mark", "note": "経路と PERF INIT（VNAV のため：FMC の VNAV は有効な経路・総重量・COST INDEX・CRZ ALT が要る。段 9c から）" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF", "keys": ["INITREF", "L6", "L3"] },
    { "do": "check", "note": "PERF INIT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF INIT" },
    { "do": "cdu", "note": "ZFW 200、CRZ ALT FL350、COST INDEX 100（段 9c から：VNAV は総重量と COST INDEX も要る、FCOM p.1433）", "keys": ["200", "L3", "350", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 35,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },
    { "do": "check", "note": "まだ ALT（経路を入れても）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "sleep", "seconds": 5, "note": "高度と速度を落ち着かせる" },

    { "do": "mark", "note": "V/S（FCOM p.648、ATA22 p.282）" },
    { "do": "set", "note": "MCP 高度 11,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 11000 },
    { "do": "sleep", "seconds": 4, "note": "MCP の高度が内部の目標に入る（3 秒）" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "as": "vs0" },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の V/S", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "ALT の後の V/S は 000", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "op": "==", "value": 0 },
    { "do": "set", "note": "V/S +1,500 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1500 },
    { "do": "set", "note": "MCP の V/S の表示も", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 1500 },
    { "do": "wait", "note": "上昇に入る（+800 fpm 以上）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": ">", "value": 800, "timeout": 30 },
    { "do": "sleep", "seconds": 8, "note": "昇降率を落ち着かせる" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "as": "vs1" },
    { "do": "cmd", "note": "上昇中にもう一度 V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "今の昇降率に合わせる（100 fpm に丸め：ATA22 p.282。前は 0）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "op": "between", "value": [-200, 200], "rel": "vs1" },
    { "do": "check", "note": "V/S のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：V/S", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_vs" },
    { "do": "wait", "note": "11,000 ft を捕捉して ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 120 },
    { "do": "check", "note": "保つ高度は MCP の 11,000 ft", "dref": "laminar/B747/autopilot/altitude_hold_ft", "op": "between", "value": [10990, 11010] },
    { "do": "wait", "note": "11,000 ft に収まる（±200 ft。前のピッチの則は捕捉の窓が広く収まりが遅い：段 3）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [10800, 11200], "timeout": 90 },
    { "do": "check", "note": "ALT のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "cmd", "note": "上昇なしで V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ALT の後の V/S は 000（ATA22 p.282）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "op": "==", "value": 0 },

    { "do": "mark", "note": "FLCH と SPD（FCOM p.646、p.642）" },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 4 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "cmd", "note": "FLCH 中の SPD（効かない）", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FLCH SPD のまま（前は V/S になった）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "view", "note": "機長の PFD：FLCH SPD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_flch" },
    { "do": "wait", "note": "降下に入る（-500 fpm 以下）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "<", "value": -500, "timeout": 30 },
    { "do": "wait", "note": "10,000 ft を捕捉して ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 150 },
    { "do": "check", "note": "保つ高度は MCP の 10,000 ft", "dref": "laminar/B747/autopilot/altitude_hold_ft", "op": "between", "value": [9990, 10010] },
    { "do": "wait", "note": "10,000 ft に収まる（±200 ft。段 3 まで前の則）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [9800, 10200], "timeout": 90 },
    { "do": "check", "note": "ALT のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },

    { "do": "mark", "note": "上昇中の ALT HOLD（FCOM p.650）" },
    { "do": "set", "note": "MCP 高度 13,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 13000 },
    { "do": "sleep", "seconds": 4 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "set", "note": "V/S +1,500 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1500 },
    { "do": "set", "note": "MCP の V/S の表示も", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 1500 },
    { "do": "wait", "note": "上昇に入る（+800 fpm 以上）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": ">", "value": 800, "timeout": 30 },
    { "do": "sleep", "seconds": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt_hold" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "check", "note": "保つ高度は押した時の高度（FCOM p.650）", "dref": "laminar/B747/autopilot/altitude_hold_ft", "op": "between", "value": [-60, 60], "rel": "alt_hold" },
    { "do": "sleep", "seconds": 30, "note": "行き過ぎを待つ（前の則は 10,000 ft より上で上昇を止めるのが遅い：段 3）" },
    { "do": "wait", "note": "押した時の高度に戻る（±300 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [-300, 300], "rel": "alt_hold", "timeout": 120 },

    { "do": "mark", "note": "VNAV（FCOM p.645、ATA22 p.340）" },
    { "do": "cmd", "note": "V/S（今のモード）", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "空中ではすぐ engage（段 9c から FMC の VNAV：上昇の VNAV SPD で MCP の 13,000 ft へ）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "between", "value": [4, 6], "timeout": 10 },
    { "do": "check", "note": "VNAV の状態は engage（2 以上）", "dref": "laminar/B747/autopilot/vnav_state", "op": ">=", "value": 2 },
    { "do": "view", "note": "機長の PFD：VNAV", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_vnav" },
    { "do": "cmd", "note": "engage 中に VNAV（何もしない）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "between", "value": [4, 6] },
    { "do": "cmd", "note": "V/S で VNAV が終わる", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の V/S", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "VNAV の状態は 0", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 0 },
    { "do": "cmd", "note": "ALT HOLD で終わる", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
