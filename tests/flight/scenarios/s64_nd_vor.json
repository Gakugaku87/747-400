      "sim/cockpit2/radios/actuators/nav_frequency_hz[2]", "sim/cockpit2/radios/actuators/nav_frequency_hz[3]", "laminar/B747/nd/capt/vor_dme" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
