    { "do": "shot", "name": "nd_vor_auto" },
    { "do": "cmd", "note": "機長の CDU の NAV RAD", "name": "laminar/B747/fms1/func_key/navrad" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "note": "117.9 を VOR L（L1）へ：手動", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "コース 330 を CRS L（L2）へ", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "note": "117.9 を VOR R（R1）へ", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "コース 330 を CRS R（R2）へ", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VOR L・R とも手動", "dref": "laminar/B747/radio/tuningmodes", "op": "==", "value": "AMMMM" },
    { "do": "wait", "note": "識別符号 NRE", "dref": "laminar/B747/nd/capt/vor_ref", "op": "==", "value": "NRE", "timeout": 20 },
    { "do": "wait", "note": "偏位のバーと目盛", "dref": "laminar/B747/nd/capt/vor_dev", "op": "==", "value": 1, "timeout": 20 },
    { "do": "check", "note": "コース", "dref": "laminar/B747/nd/capt/vor_crs", "op": "==", "value": 2 },
    { "do": "check", "note": "CDU のコース 330", "dref": "laminar/B747/nd/capt/vor_crs_deg", "op": "between", "value": [329.5, 330.5] },
    { "do": "check", "note": "TO", "dref": "laminar/B747/nd/capt/to_from", "op": "==", "value": 1 },
    { "do": "check", "note": "DME", "dref": "laminar/B747/nd/capt/vor_dme", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士も NRE", "dref": "laminar/B747/nd/fo/vor_ref", "op": "==", "value": "NRE" },
    { "do": "check", "note": "副操縦士も TO", "dref": "laminar/B747/nd/fo/to_from", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "手動の同調", "drefs": [
