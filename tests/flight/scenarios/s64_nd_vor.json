    { "do": "check", "note": "偏位は無い", "dref": "laminar/B747/nd/capt/vor_dev", "op": "==", "value": 0 },
    { "do": "check", "note": "TO/FROM も無い", "dref": "laminar/B747/nd/capt/to_from", "op": "==", "value": 0 },
    { "do": "check", "note": "旗は無い", "dref": "laminar/B747/nd/capt/vor_flag", "op": "==", "value": 0 },
