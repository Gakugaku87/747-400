    { "do": "wait", "note": "SWAMPN と LOC16R", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^SWAMPN<SEL> +<SEL>LOC16R$", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "RTE、ACTIVATE（6R）、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 8, "note": "予測" },
    { "do": "cdu", "note": "VNAV（巡航のページ）", "keys": ["VNAV"] },
    { "do": "check", "note": "ACT ... CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CRZ", "stop": true },
    { "do": "cdu", "note": "DES のページ", "keys": ["NEXT"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "DES のページ", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line02_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_S" ] },
    { "do": "check", "note": "DES のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "DES", "stop": true },
    { "do": "check", "note": "E/D は MAP の ML16R の 319 ft（前は進入復行の BINKS 6000）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^319 ML16R" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_des_ed" }
  ]
}
