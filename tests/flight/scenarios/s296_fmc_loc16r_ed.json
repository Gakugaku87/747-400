{
  "name": "s296_fmc_loc16r_ed",
  "description": "滑走路の点が無い進入の E/D（2026-11-12 のフルレビュー FMC-1：REVIEW_2026-11-12.md 案 5）の X-Plane での確認。本物の航法データの RJAA（AIRAC 2611）。RJAA の北の FL300 の空中開始（270 t）。PERF INIT（ZFW 200、CRZ ALT FL300、CI 100）、RTE RJCC→RJAA、DIRECT SWAMP、ARRIVALS で STAR SWAMPN と LOC16R（最終進入に RW の点が無く、MAP は ML16R）、ACTIVATE・EXEC。前：E/D が進入復行の待機の BINKS 6000 ft（T/D も約 50 NM 早い）。直した後（FCOM p.1258：E/D は RW の点の上、VOR 進入は MAP。LOC は MAP：推定）：VNAV の DES のページの E/D は ML16R（319 ft）。CDU を撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 36.90, "longitude": 140.60, "elevation_in_meters": 9144, "heading_true": 180, "speed_in_meters_per_second": 225 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
