    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "CLR、RTE：RJCC→RJAA、DIRECT SWAMP", "keys": ["CLR", "CLR", "CLR", "RTE", "RJCC", "L1", "RJAA", "R1", "NEXT", "SWAMP", "R1", "?SEL"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL300、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "300", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 30,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 30000 },
    { "do": "cdu", "note": "DEP ARR（経路が有効でない：DEP/ARR INDEX）、ARR>（R2）", "keys": ["DEPARR", "R2"] },
    { "do": "wait", "note": "RJAA ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA ARRIVALS", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "5 ページ目へ", "keys": ["NEXT", "NEXT", "NEXT", "NEXT"] },
    { "do": "check", "note": "5 ページ目の 2L が SWAMPN", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^SWAMPN", "stop": true },
    { "do": "cdu", "note": "SWAMPN（2L）", "keys": ["L2"] },
    { "do": "cdu", "note": "1 ページ戻る（STAR を選ぶとページの数が 4 に）", "keys": ["PREV"] },
    { "do": "check", "note": "3R が LOC16R", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "LOC16R$", "stop": true },
