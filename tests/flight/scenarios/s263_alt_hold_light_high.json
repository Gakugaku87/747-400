    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "FMA の A/T が SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3, "timeout": 10, "level": "warn" },
    { "do": "wait", "note": "Mach が .85 の近く（空中の初期化の目標が低いと、いったん減速する：§52）", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [0.844, 0.856], "timeout": 300, "level": "warn" },
    { "do": "sleep", "seconds": 120, "note": "落ち着かせる（性能計測のキットと同じ）" },
    { "do": "snapshot", "note": "設定のあと", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/misc/machno", "sim/flightmodel/weight/m_total", "sim/flightmodel/misc/Qstatic", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "record_start" },
    { "do": "sleep", "seconds": 120, "note": "さらに落ち着かせる（直す前は、ここで周期 10.5 秒の揺れが続いていた）" },
    { "do": "mark", "note": "見張り" },
    { "do": "watch", "note": "180 秒の昇降率 ±100 fpm（性能計測のキットの安定の条件。直す前は ±120 fpm・rms 76 fpm）", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -100, "max": 100, "timeout": 180 },
    { "do": "watch", "note": "続く 60 秒の昇降率 ±40 fpm（rms 20 fpm の目安）", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -40, "max": 40, "timeout": 60, "level": "warn" },
    { "do": "check", "note": "FL370 の ±100 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [36900, 37100] },
    { "do": "check", "note": "ピッチは ALT のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "check", "note": "Mach は .85 の近く", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [0.84, 0.86] },
    { "do": "snapshot", "note": "終わり", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/misc/machno", "sim/flightmodel/weight/m_total", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "record_stop" }
  ]
