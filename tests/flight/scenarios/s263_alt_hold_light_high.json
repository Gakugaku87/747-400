  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMC の空中の初期化" },
    { "do": "wait", "note": "FMC の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 8, "note": "空中の初期化の速さの巻き取り" },
    { "do": "set", "note": "MCP 高度 FL370", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 37000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 37000 },
    { "do": "set", "note": "MCP を Mach に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
