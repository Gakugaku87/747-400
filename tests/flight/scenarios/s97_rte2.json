{
  "name": "s97_rte2",
  "description": "RTE 2 と RTE COPY（6-1・6-2 段 7e4）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す）。RTE 1 に RJAA→RJBB、DIRECT XAC・SPENS を入れて ACTIVATE と EXEC。RTE 1 の 1 ページ目の 5L の <RTE COPY で COMPLETE（FCOM p.1289）、6L の <RTE 2 で RTE 2 のページ（写した経路）、RTE 2 にだけ SAGRA を足し、RTE 2 の ACTIVATE と EXEC で ACT RTE 2（RTE 1 は ACTIVATE> に戻る：FCOM p.1290）、RTE・LEGS キーはアクティブな RTE 2 へ。LEGS の DIRECT TO SPENS の 5R の RTE COPY> で COMPLETE（FCOM p.1334；FMSPG p.135-136）、RTE 1 に写る。DEP/ARR INDEX の RTE 2 の行（FCOM p.1299）。CDU を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },

    { "do": "mark", "note": "RTE 1：RJAA→RJBB、DIRECT XAC・SPENS、ACTIVATE と EXEC" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1"] },
    { "do": "check", "note": "1 ページ目の破線は 8 行目（FCOM p.1293 の図）", "dref": "laminar/B747/fms3/Line08_L", "op": "==", "value": "------------------------" },
    { "do": "check", "note": "<RTE 2 と ACTIVATE>（FCOM p.1289）", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<RTE 2         ACTIVATE>" },
    { "do": "cdu", "keys": ["NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["RTE"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "check", "note": "5L に <RTE COPY（アクティブな経路：FCOM p.1289）", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "<RTE COPY               " },

    { "do": "mark", "note": "RTE COPY と RTE 2（FCOM p.1289-1290）" },
    { "do": "cdu", "note": "<RTE COPY", "keys": ["L5"] },
    { "do": "check", "note": "COMPLETE", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "COMPLETE                " },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_rte_copy_complete" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "note": "<RTE 2", "keys": ["L6"] },
    { "do": "check", "note": "RTE 2（アクティブでない）", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "         RTE 2          " },
    { "do": "check", "note": "写した出発地と目的地", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "RJAA                RJBB" },
    { "do": "check", "note": "<RTE 1 と ACTIVATE>", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<RTE 1         ACTIVATE>" },
    { "do": "cdu", "note": "2 ページ目：XAC・SPENS の後に SAGRA", "keys": ["NEXT", "SAGRA", "R3", "?SEL"] },
    { "do": "check", "note": "DIRECT SAGRA（RTE 2 だけ）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^DIRECT +SAGRA$" },
    { "do": "check", "note": "題名は RTE 2 のまま（アクティブでない経路は MOD にならない）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RTE 2" },
    { "do": "cdu", "note": "ACTIVATE", "keys": ["R6"] },
    { "do": "check", "note": "EXEC 灯", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 1 },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 2（FCOM p.1290）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 2" },
    { "do": "check", "note": "EXEC 灯が消える", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 0 },
    { "do": "cdu", "note": "<RTE 1", "keys": ["L6"] },
    { "do": "check", "note": "RTE 1 はアクティブでない", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "         RTE 1          " },
    { "do": "check", "note": "ACTIVATE>", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "ACTIVATE>$" },
    { "do": "cdu", "note": "RTE キー", "keys": ["RTE"] },
    { "do": "check", "note": "アクティブな RTE 2 のページ（FCOM p.1287）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 2" },
    { "do": "cdu", "note": "LEGS キー", "keys": ["LEGS"] },
    { "do": "check", "note": "ACT RTE 2 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 2 LEGS" },
    { "do": "check", "note": "SAGRA は 3 番目", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^SAGRA " },
    { "do": "check", "note": "<RTE 1 LEGS（FCOM p.1330 の図）", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^<RTE 1 LEGS" },

    { "do": "mark", "note": "DIRECT TO の修正の RTE COPY>（FCOM p.1334；FMSPG p.135-136）" },
    { "do": "cdu", "keys": ["SPENS", "L1", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MOD RTE 2 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 2 LEGS" },
    { "do": "check", "note": "5R に RTE COPY>", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "RTE COPY>$" },
    { "do": "cdu", "note": "RTE COPY>", "keys": ["R5"] },
    { "do": "check", "note": "COMPLETE", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": " COMPLETE$" },
    { "do": "check", "note": "見出し RTE COPY", "dref": "laminar/B747/fms3/Line10_S", "op": "matches", "value": "RTE COPY$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_legs_rte_copy" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "note": "ERASE", "keys": ["L6"] },
    { "do": "cdu", "note": "<RTE 1 LEGS", "keys": ["L6"] },
    { "do": "check", "note": "RTE 1 LEGS（写された RTE 2：XAC・SPENS・SAGRA）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^SAGRA " },

    { "do": "mark", "note": "DEP/ARR INDEX の RTE 2 の行（FCOM p.1299-1300）" },
    { "do": "cdu", "note": "DEP ARR キー：アクティブな RTE 2 の DEPARTURES", "keys": ["DEPARR"] },
    { "do": "check", "note": "RJAA DEPARTURES", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA DEPARTURES" },
    { "do": "check", "note": "RTE 2 の SID", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "RTE 2" },
    { "do": "cdu", "note": "<INDEX", "keys": ["L6"] },
    { "do": "check", "note": "RTE 1", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "RTE 1" },
    { "do": "check", "note": "RTE 2 (ACT)", "dref": "laminar/B747/fms3/Line06_S", "op": "contains", "value": "RTE 2 (ACT)" },
    { "do": "check", "note": "RTE 2 の <DEP RJAA", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^<DEP    RJAA" },
    { "do": "check", "note": "RTE 2 の RJBB ARR>", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "RJBB +ARR>$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_deparr_index_rte2" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
