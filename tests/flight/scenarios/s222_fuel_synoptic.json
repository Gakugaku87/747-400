{
  "name": "s222_fuel_synoptic",
  "description": "FUEL-24（燃料 synoptic の色と FTR）の X-Plane での確認。成田 34L でエンジン運転中に開始。CWT に 20 t を入れて FUEL synoptic を出し、ポンプの記号（主・CTR は緑、O/J は cyan の待機、STAB OFF は白）、主タンクの amber（主 1 と 4 の不均衡で両方、主 1 が空で主 1 のポンプも amber）、吸引供給（主 1 のポンプ 2 台と X FEED 1 を OFF）のエンジン 1 と流れ線の amber、ジェティソン中の magenta と主 EICAS の FTR（magenta、完了で白）を dataref と画像で見る。期待値は FCOM p.1445-1449、ATA26_28 p.421-422（notes/ATA-28.md §10）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/flightmodel/weight/m_fuel[0]", "sim/flightmodel/weight/m_fuel[1]", "sim/flightmodel/weight/m_fuel[2]",
      "sim/flightmodel/weight/m_fuel[3]", "sim/flightmodel/weight/m_fuel[4]", "sim/flightmodel/weight/m_fuel[7]",
      "laminar/B747/button_switch/position[52]", "laminar/B747/button_switch/position[54]",
      "laminar/B747/button_switch/position[64]", "laminar/B747/fuel/synoptic/pump[0]", "laminar/B747/fuel/synoptic/pump[8]",
      "laminar/B747/fuel/synoptic/pump[12]", "laminar/B747/fuel/synoptic/pump[14]", "laminar/B747/fuel/fuel_display_units_eicas" ] },
    { "do": "cas", "note": "開始直後" },

    { "do": "mark", "note": "CWT に 20 t、主・O/J・CTR は ON、STAB は OFF" },
    { "do": "set", "note": "CWT に 20 t（重量の画面で入れたのと同じ）", "dref": "sim/flightmodel/weight/m_fuel[0]", "value": 20000 },
    { "do": "switch", "note": "CTR L ON", "dref": "laminar/B747/button_switch/position[52]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_ctr_wing_tnk_pump_L" },
    { "do": "switch", "note": "CTR R ON", "dref": "laminar/B747/button_switch/position[53]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_ctr_wing_tnk_pump_R" },
    { "do": "switch", "note": "OVRD 2 FWD ON", "dref": "laminar/B747/button_switch/position[64]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_overd_pump_fwd_2" },
    { "do": "switch", "note": "OVRD 3 FWD ON", "dref": "laminar/B747/button_switch/position[65]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_overd_pump_fwd_3" },
    { "do": "switch", "note": "OVRD 2 AFT ON", "dref": "laminar/B747/button_switch/position[66]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_overd_pump_aft_2" },
    { "do": "switch", "note": "OVRD 3 AFT ON", "dref": "laminar/B747/button_switch/position[67]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_overd_pump_aft_3" },
    { "do": "switch", "note": "STAB L OFF", "dref": "laminar/B747/button_switch/position[54]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_stab_tnk_pump_L" },
    { "do": "switch", "note": "STAB R OFF", "dref": "laminar/B747/button_switch/position[55]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_stab_tnk_pump_R" },
    { "do": "wait", "note": "CWT ポンプ 2 台の圧で、エンジン 1 はマニフォールドから（FCOM p.1454）", "dref": "laminar/B747/fuel/engine1_status", "op": "==", "value": 2, "timeout": 8 },
    { "do": "cmd", "note": "FUEL synoptic", "name": "laminar/B747/dsp/fuel_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FUEL synoptic が出る", "dref": "laminar/B747/dsp/synoptic_display", "op": "==", "value": 4 },
    { "do": "check", "note": "MAIN 1 FWD 緑（作動、圧力あり。FCOM p.1448）", "dref": "laminar/B747/fuel/synoptic/pump[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "MAIN 4 AFT 緑", "dref": "laminar/B747/fuel/synoptic/pump[7]", "op": "==", "value": 2 },
    { "do": "check", "note": "OVRD 2 FWD cyan（論理の待機。CWT ポンプ 2 台の圧で止まっている：FCOM p.1447、p.1467）", "dref": "laminar/B747/fuel/synoptic/pump[8]", "op": "==", "value": 1 },
    { "do": "check", "note": "OVRD 3 AFT cyan", "dref": "laminar/B747/fuel/synoptic/pump[11]", "op": "==", "value": 1 },
    { "do": "check", "note": "CTR L 緑（FCOM p.1447）", "dref": "laminar/B747/fuel/synoptic/pump[12]", "op": "==", "value": 2 },
    { "do": "check", "note": "STAB L 白（スイッチ OFF。FCOM p.1449）", "dref": "laminar/B747/fuel/synoptic/pump[14]", "op": "==", "value": 0 },
    { "do": "check", "note": "主タンク 1 は白", "dref": "laminar/B747/fuel/synoptic/main_amber[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "吸引供給なし", "dref": "laminar/B747/fuel/synoptic/suction[0]", "op": "==", "value": 0 },
    { "do": "view", "note": "下段 EICAS", "the": -32, "psi": 33, "fov": 14 },
    { "do": "shot", "name": "fuel_synoptic_cwt" },

    { "do": "mark", "note": "主 1 と 4 の不均衡（主タンクは CWT が送っているので動かない）" },
    { "do": "set", "note": "主 1 を 8,000 kg", "dref": "sim/flightmodel/weight/m_fuel[1]", "value": 8000 },
    { "do": "set", "note": "主 4 を 10,000 kg（差 2,000 kg：FUEL IMBAL 1-4 の 1,360 kg を超える）", "dref": "sim/flightmodel/weight/m_fuel[4]", "value": 10000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "燃料系が外からの量を引き継いだ", "dref": "sim/flightmodel/weight/m_fuel[1]", "op": "<", "value": 8100 },
    { "do": "check", "note": "主 1 amber（不均衡は両方。ATA26_28 p.421）", "dref": "laminar/B747/fuel/synoptic/main_amber[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "主 4 amber", "dref": "laminar/B747/fuel/synoptic/main_amber[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "主 2 は白", "dref": "laminar/B747/fuel/synoptic/main_amber[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "EICAS の FUEL IMBAL 1-4 と同じ判定", "dref": "laminar/B747/CAS/advisory_status[149]", "op": "==", "value": 1 },
    { "do": "shot", "name": "fuel_synoptic_imbalance" },
    { "do": "set", "note": "主 1 を空に（ポンプは低圧）", "dref": "sim/flightmodel/weight/m_fuel[1]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "MAIN 1 FWD amber（スイッチ ON で低圧。FCOM p.1448）", "dref": "laminar/B747/fuel/synoptic/pump[0]", "op": "==", "value": 3 },
    { "do": "check", "note": "MAIN 1 AFT amber", "dref": "laminar/B747/fuel/synoptic/pump[1]", "op": "==", "value": 3 },
    { "do": "check", "note": "主 1 amber（900 kg 未満）", "dref": "laminar/B747/fuel/synoptic/main_amber[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 1 は CWT から（止まらない）", "dref": "sim/flightmodel/engine/ENGN_running[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "fuel_synoptic_main1_empty" },
    { "do": "set", "note": "主 1 を 10,000 kg に戻す", "dref": "sim/flightmodel/weight/m_fuel[1]", "value": 10000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "主 1 白に戻る（差 0：450 kg 未満で解除）", "dref": "laminar/B747/fuel/synoptic/main_amber[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "MAIN 1 FWD 緑に戻る", "dref": "laminar/B747/fuel/synoptic/pump[0]", "op": "==", "value": 2 },

    { "do": "mark", "note": "吸引供給：X FEED 1 と主 1 のポンプ 2 台を OFF" },
    { "do": "switch", "note": "X FEED 1 OFF", "dref": "laminar/B747/button_switch/position[48]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "wait", "note": "X FEED 1 閉", "dref": "laminar/B747/fuel/engine1/xfeed_vlv_pos", "op": "==", "value": 0, "timeout": 8 },
    { "do": "switch", "note": "MAIN 1 FWD OFF", "dref": "laminar/B747/button_switch/position[56]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_1" },
    { "do": "switch", "note": "MAIN 1 AFT OFF", "dref": "laminar/B747/button_switch/position[60]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_1" },
    { "do": "wait", "note": "吸引供給：エンジン 1 と流れ線が amber（ATA26_28 p.422）", "dref": "laminar/B747/fuel/synoptic/suction[0]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "MAIN 1 FWD 白（スイッチ OFF）", "dref": "laminar/B747/fuel/synoptic/pump[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "エンジン 2 は吸引供給でない", "dref": "laminar/B747/fuel/synoptic/suction[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "FUEL PRESS ENG 1", "dref": "laminar/B747/CAS/caution_status[32]", "op": "==", "value": 1 },
    { "do": "shot", "name": "fuel_synoptic_suction" },
    { "do": "switch", "note": "MAIN 1 FWD ON", "dref": "laminar/B747/button_switch/position[56]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_fwd_1" },
    { "do": "switch", "note": "MAIN 1 AFT ON", "dref": "laminar/B747/button_switch/position[60]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_main_pump_aft_1" },
    { "do": "switch", "note": "X FEED 1 ON", "dref": "laminar/B747/button_switch/position[48]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "wait", "note": "吸引供給が終わる", "dref": "laminar/B747/fuel/synoptic/suction[0]", "op": "==", "value": 0, "timeout": 5 },

    { "do": "mark", "note": "ジェティソン：選択器 A、FTR 50 t、ノズル L・R ON" },
    { "do": "set", "note": "FUEL TO REMAIN 50 t", "dref": "laminar/B747/fuel/fuel_to_remain/rheostat", "value": 50 },
    { "do": "set", "note": "選択器 A", "dref": "laminar/B747/fuel/fuel_jettison/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FTR は magenta（FCOM p.1449）", "dref": "laminar/B747/fuel/fuel_to_remain/state", "op": "==", "value": 0 },
    { "do": "check", "note": "FTR を表示の単位で（kg なら 50.0、lb なら 110.2）", "dref": "laminar/B747/fuel/fuel_to_remain/display", "op": ">=", "value": 49.9 },
    { "do": "switch", "note": "NOZZLE L ON", "dref": "laminar/B747/button_switch/position[46]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_jet_nozzle_vlv_L" },
    { "do": "switch", "note": "NOZZLE R ON", "dref": "laminar/B747/button_switch/position[47]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_jet_nozzle_vlv_R" },
    { "do": "wait", "note": "ノズル弁が開く", "dref": "laminar/B747/fuel/jett_vlv_status", "op": "==", "value": 1, "timeout": 8 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CTR L magenta と流れ（ATA26_28 p.421）", "dref": "laminar/B747/fuel/synoptic/pump[12]", "op": "==", "value": 5 },
    { "do": "check", "note": "OVRD 2 FWD magenta と流れ", "dref": "laminar/B747/fuel/synoptic/pump[8]", "op": "==", "value": 5 },
    { "do": "check", "note": "MAIN 1 FWD は緑のまま", "dref": "laminar/B747/fuel/synoptic/pump[0]", "op": "==", "value": 2 },
    { "do": "shot", "name": "fuel_synoptic_jettison" },
    { "do": "view", "note": "主 EICAS", "the": -24.5, "psi": 29, "fov": 14 },
    { "do": "shot", "name": "eicas_ftr_magenta" },
    { "do": "set", "note": "FTR を総量より上へ（ジェティソン完了）", "dref": "laminar/B747/fuel/fuel_to_remain/rheostat", "value": 400 },
    { "do": "wait", "note": "完了で FTR は白（点滅の消灯側は 2）", "dref": "laminar/B747/fuel/fuel_to_remain/state", "op": ">=", "value": 1, "timeout": 3 },
    { "do": "sleep", "seconds": 6 },
    { "do": "check", "note": "5 秒の点滅の後は白のまま（FCOM p.1449）", "dref": "laminar/B747/fuel/fuel_to_remain/state", "op": "==", "value": 1 },
    { "do": "shot", "name": "eicas_ftr_white" },
    { "do": "check", "note": "OVRD 2 FWD は cyan に戻る", "dref": "laminar/B747/fuel/synoptic/pump[8]", "op": "==", "value": 1 },
    { "do": "view", "note": "下段 EICAS", "the": -32, "psi": 33, "fov": 14 },
    { "do": "shot", "name": "fuel_synoptic_jett_done" },
    { "do": "switch", "note": "NOZZLE L OFF", "dref": "laminar/B747/button_switch/position[46]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_jet_nozzle_vlv_L" },
    { "do": "switch", "note": "NOZZLE R OFF", "dref": "laminar/B747/button_switch/position[47]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_jet_nozzle_vlv_R" },
    { "do": "set", "note": "選択器 OFF", "dref": "laminar/B747/fuel/fuel_jettison/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "選択器 OFF で FTR の状態は戻る", "dref": "laminar/B747/fuel/fuel_to_remain/state", "op": "==", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
