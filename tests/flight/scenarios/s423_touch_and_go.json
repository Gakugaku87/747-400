{
  "name": "s423_touch_and_go",
  "description": "タッチアンドゴー（2026-11-24、段 4 のレビューの D：AFDS-2 と FMC-7 の X-Plane の場面）。s114 と同じ RJAA 34L の進入路の 12 NM・2,500 ft・フラップ 20・脚下げ・170 kt で開始（機体を読み直す、270 t）、スピードブレーキとオートブレーキは使わない。LAND 3 の自動着陸で降り、100 ft で A/T を切り、30 ft でレバーを手でアイドル。接地で A/P を外し、フラップ 20、レバーを 0.5（FCTM のタッチアンドゴー）。推力制限は GA のまま（FMC-7：飛んだ後の地上の 30 kt 以上）。150 kt で引き起こし（B747_rotate.lua）、電波高度 5 ft を越えて 4 秒の TO/GA で F/D の G/A と A/T の THR（FCOM p.673 (4.20.15)：1 回目の押しで THR。AFDS-2 の前は 400 ft まで A/T が入らなかった）。脚上げ、300 ft で A/P、その後 140 秒 CONFIG GEAR が出ない。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（タッチアンドゴーの後の上昇の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "A/P の捕捉の目標も（MCP のつまみなら 3 秒後に写る。窓の値だけ書くと G/A の後に捕捉しない：2026-11-24 の s425 の 1 回目は 2,000 ft を越えて約 9,300 ft まで上がった。s380 と同じ）", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "set", "note": "オートブレーキ OFF（タッチアンドゴー）", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 1 },
    { "do": "check", "note": "スピードブレーキのレバーは DN（ARM しない）", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（s114 と同じ）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200 },

    { "do": "mark", "note": "100 ft：A/T を切る" },
    { "do": "wait", "note": "電波高度 100 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 100, "timeout": 200 },
    { "do": "cmd", "note": "A/T の解除スイッチ", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "A/T DISC を消す（2 回目）", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "wait", "note": "A/T が外れる（FMA の A/T 空白）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "電波高度 30 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 30, "timeout": 30 },
    { "do": "set", "note": "レバーを手でアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "接地で FLARE が消える（s114 と同じく FMA で待つ）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 0, "timeout": 60 },
    { "do": "snapshot", "note": "接地", "drefs": [ "sim/flightmodel/failures/onground_any", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },

    { "do": "mark", "note": "タッチアンドゴー" },
    { "do": "cmd", "note": "操縦輪の解除スイッチで A/P を外す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "note": "AUTOPILOT DISC を消す（2 回目）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "レバーを 0.5（FCTM のタッチアンドゴー：ほぼ垂直まで進める）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMC-7：推力制限は GA のまま（飛んだ後の地上、30 kt 以上。前は接地で TO に戻った）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "contains", "value": "GA" },
    { "do": "wait", "note": "150 kt（引き起こし）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 40 },
    { "do": "cmd", "note": "毎秒 2.5° で 15° へ引き起こす（B747_rotate.lua、FCTM p.95-96）", "name": "FlyWithLua/B747_rotate/start" },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "wait", "note": "電波高度 5 ft を越える", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 5, "timeout": 10 },
    { "do": "sleep", "seconds": 4, "note": "TO/GA のスイッチは 5 ft を越えて 3 秒で使える（FCOM p.673）" },
    { "do": "cmd", "note": "TO/GA（1 回）", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "snapshot", "note": "TO/GA", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/engines/ref_thr_limit_mode" ] },
    { "do": "check", "note": "電波高度 400 ft の下（離陸の 400 ft の抑止はタッチアンドゴーには無い）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 400 },
    { "do": "check", "note": "AFDS-2：A/T の THR（FCOM p.673：1 回目の押しで THR。前は A/T が入らず空白）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "F/D の G/A（FMA のピッチ TO/GA）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "wait", "note": "電波高度 35 ft（引き起こしの操縦の終わり）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 35, "timeout": 30 },
    { "do": "cmd", "note": "引き起こしの操縦を終える", "name": "FlyWithLua/B747_rotate/stop" },
    { "do": "cmd", "note": "手で F/D のバーを追う（B747_fd_follow.lua）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 60 },
    { "do": "cmd", "note": "手の操縦を終える", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "watch", "note": "その後 140 秒 CONFIG GEAR が出ない（脚上げ、フラップ 20、レバーは前：WARN-3 のレバーの原因にならない）", "dref": "laminar/B747/CAS/warning_status[3]", "timeout": 140, "max": 0 },
    { "do": "check", "note": "警報なし（主警告灯）", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0 },
    { "do": "check", "note": "上昇して 3,000 ft の付近", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 2000 },
    { "do": "record_stop" },
    { "do": "cas", "note": "終わり" }
  ]
}
