{
  "name": "s44_tcas",
  "description": "トランスポンダと TCAS（5-1 段 5）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt で開始（機体を読み直す）。X-Plane の TCAS が advisory を出さなくなっていると RA の確認は通らない（X-Plane を起動し直してから流す：TESTING.md）。空中開始のトランスポンダは TA/RA（推定）。試験用の相手機（tests/flight/fwl/B747_traffic.lua）を当てて、TA（TRAFFIC, TRAFFIC、琥珀の丸、ND の TRAFFIC、両 ND に TFC が自動で出る：FCOM p.1534・p.1584）、上昇中に上の相手機で RA（赤の四角、赤の TRAFFIC、PFD の RA の値、Ver 7.0 の声）、CLEAR OF CONFLICT。TA ONLY で RA が出ないこと、XPDR で TCAS OFF（ND と EICAS）、TFC スイッチの入切、トランスポンダ L の故障（>TRANSPONDER L、>TCAS SYSTEM、ND の TCAS FAIL）と R への切替、10 nm で TA が範囲外の OFFSCALE、MAP CTR の表示。1,050 ft に降りて上の相手機（DESCEND 系の RA は 1,100 ft 未満で出さない）、900 ft で TA ONLY（RA は 1,000 ft 未満で出さない：FCOM p.1593・p.1600）。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007（磁方位で真北）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "機長の ND を 20 nm", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 1 },
    { "do": "set", "note": "副操縦士の ND を 20 nm", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 15, "note": "水平飛行に落ち着く" },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/electrical/bus/ac", "laminar/B747/electrical/bus/stby_main", "sim/cockpit2/gauges/indicators/altitude_ft_pilot",
      "laminar/B747/flt_mgmt/txpdr/mode_sel_pos", "sim/cockpit2/radios/actuators/transponder_mode", "laminar/B747/tcas/operating", "laminar/B747/tcas/ra_mode",
      "laminar/B747/nd/mode/capt/sel_dial_pos", "laminar/B747/nd/mode/fo/sel_dial_pos", "laminar/B747/nd/capt/tfc", "laminar/B747/nd/fo/tfc", "laminar/B747/electrical/display_has_power" ] },
    { "do": "check", "note": "空中開始はトランスポンダ TA/RA（推定：FCOM p.1570）", "dref": "laminar/B747/flt_mgmt/txpdr/mode_sel_pos", "op": "==", "value": 4 },
    { "do": "check", "note": "X-Plane の transponder_mode 7（TA/RA）", "dref": "sim/cockpit2/radios/actuators/transponder_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "TCAS が働く", "dref": "laminar/B747/tcas/operating", "op": "==", "value": 1 },
    { "do": "check", "note": "RA を出せる", "dref": "laminar/B747/tcas/ra_mode", "op": "==", "value": 1 },
    { "do": "check", "note": ">TCAS OFF なし", "dref": "laminar/B747/CAS/advisory_status[279]", "op": "==", "value": 0 },
    { "do": "check", "note": ">TCAS SYSTEM なし", "dref": "laminar/B747/CAS/advisory_status[282]", "op": "==", "value": 0 },
    { "do": "check", "note": "TFC はまだ出ていない", "dref": "laminar/B747/nd/capt/tfc", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_start" },

    { "do": "mark", "note": "TA" },
    { "do": "wait", "note": "水平飛行（相手機の経路は自機を水平として決める）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-300, 300], "timeout": 60 },
    { "do": "traffic", "note": "正面から 400 ft 下、300 kt、60 秒で最接近", "targets": [ "tcpa=60 brg=0 gs=300 dh=-400 vs=0 miss=0" ] },
    { "do": "wait", "note": "TA：TRAFFIC, TRAFFIC（FCOM p.1561）", "dref": "laminar/B747/tcas/last_voice", "op": "==", "value": 1, "timeout": 45 },
    { "do": "check", "note": "X-Plane の TCAS が advisory を出した（出さないときは下の RA が通らない：TESTING.md）", "dref": "sim/cockpit2/tcas/indicators/tcas_active_advisory", "op": "in", "value": [1, 2], "level": "warn" },
    { "do": "check", "note": "相手機は TA（琥珀の丸）", "dref": "laminar/B747/tcas/sym[1]", "op": "==", "value": 3 },
    { "do": "check", "note": "ND の TRAFFIC は琥珀", "dref": "laminar/B747/nd/capt/traffic", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の ND に TFC が自動で（FCOM p.1584）", "dref": "laminar/B747/nd/capt/tfc", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の ND にも", "dref": "laminar/B747/nd/fo/tfc", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の ND が機影を描く", "dref": "laminar/B747/nd/capt/tcas/show[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "絵は TA の丸（7〜9）", "dref": "laminar/B747/nd/capt/tcas/sym[0]", "op": "between", "value": [7, 9] },
    { "do": "check", "note": "データタグは琥珀", "dref": "laminar/B747/nd/capt/tcas/tag_color[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "相手機は下：データタグは記号の下（FCOM p.1152）", "dref": "laminar/B747/nd/capt/tcas/tag_dy[0]", "op": "<", "value": 0 },
    { "do": "shot", "name": "nd_ta" },
    { "do": "wait", "note": "相手機が離れる（RA は次の上昇中の相手で見る）", "dref": "laminar/B747/nd/capt/traffic", "op": "==", "value": 0, "timeout": 90 },
    { "do": "traffic_stop" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "TFC は残る（FCOM p.1584）", "dref": "laminar/B747/nd/capt/tfc", "op": "==", "value": 1 },

    { "do": "mark", "note": "RA" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt1" },
    { "do": "set", "note": "MCP 高度を 3,000 ft 上に", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000, "rel": "alt1", "round": 100 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S +1,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": 1000 },
    { "do": "wait", "note": "上昇", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 700, "timeout": 30 },
    { "do": "traffic", "note": "正面から、上昇の始めの高度の 300 ft 上、50 秒で最接近（自機はそこを上昇で通る）", "targets": [ "tcpa=50 brg=0 gs=300 dh=300 vs=0 miss=0" ] },
    { "do": "wait", "note": "X-Plane の TCAS の RA（出なければ下の確認は通らない：TESTING.md）", "dref": "sim/cockpit2/tcas/indicators/tcas_active_advisory", "op": "==", "value": 2, "timeout": 50, "level": "warn" },
    { "do": "wait", "note": "RA（PFD の RA の値）", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "相手機は RA（赤の四角）", "dref": "laminar/B747/tcas/sym[1]", "op": "==", "value": 4 },
    { "do": "check", "note": "ND の TRAFFIC は赤", "dref": "laminar/B747/nd/capt/traffic", "op": "==", "value": 2 },
    { "do": "check", "note": "絵は RA の四角（10〜12）", "dref": "laminar/B747/nd/capt/tcas/sym[0]", "op": "between", "value": [10, 12] },
    { "do": "check", "note": "データタグは赤", "dref": "laminar/B747/nd/capt/tcas/tag_color[0]", "op": "==", "value": 3 },
    { "do": "snapshot", "note": "RA の声と PFD の値", "drefs": [ "laminar/B747/tcas/last_voice", "sim/cockpit2/tcas/indicators/tcas_message", "sim/cockpit2/tcas/indicators/tcas_vs_bands",
      "laminar/B747/tcas/pfd/lo_on", "laminar/B747/tcas/pfd/hi_on", "laminar/B747/tcas/pfd/vs_lo", "laminar/B747/tcas/pfd/vs_hi", "laminar/B747/tcas/pfd/pitch_lo", "laminar/B747/tcas/pfd/pitch_hi",
      "laminar/B747/nd/capt/tcas/tag0", "laminar/B747/nd/capt/tcas/tag_dy[0]", "sim/flightmodel/position/theta", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "RA の声（2〜13。向きは X-Plane の TCAS が決める。CROSSING は相手の側で）", "dref": "laminar/B747/tcas/last_voice", "op": "between", "value": [2, 13] },
    { "do": "shot", "name": "nd_ra" },
    { "do": "wait", "note": "CLEAR OF CONFLICT", "dref": "laminar/B747/tcas/last_voice", "op": "==", "value": 14, "timeout": 45 },
    { "do": "check", "note": "RA の表示が消える", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 0 },
    { "do": "traffic_stop" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt2" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt2", "round": 100 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "相手機が消えると TRAFFIC も消える", "dref": "laminar/B747/nd/capt/traffic", "op": "==", "value": 0 },

    { "do": "mark", "note": "TA ONLY" },
    { "do": "switch", "note": "TA ONLY", "dref": "laminar/B747/flt_mgmt/txpdr/mode_sel_pos", "value": 3, "cmd": "laminar/B747/flt_mgmt/transponder/mode_sel_dial_up", "cmd_down": "laminar/B747/flt_mgmt/transponder/mode_sel_dial_dn" },
    { "do": "check", "note": "X-Plane のモード 6", "dref": "sim/cockpit2/radios/actuators/transponder_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "ND に TA ONLY", "dref": "laminar/B747/nd/capt/ta_only", "op": "==", "value": 1 },
    { "do": "traffic", "note": "同じ当て方", "targets": [ "tcpa=50 brg=0 gs=300 dh=200 vs=0 miss=0" ] },
    { "do": "wait", "note": "TA", "dref": "laminar/B747/tcas/sym[1]", "op": "==", "value": 3, "timeout": 40 },
    { "do": "shot", "name": "nd_ta_only" },
    { "do": "sleep", "seconds": 20, "note": "RA になるはずの時刻を過ぎる" },
    { "do": "check", "note": "TA ONLY では RA にならない（FCOM p.1533）", "dref": "laminar/B747/tcas/pfd/ra", "op": "==", "value": 0 },
    { "do": "check", "note": "相手機は TA のまま", "dref": "laminar/B747/tcas/sym[1]", "op": "in", "value": [2, 3] },
    { "do": "traffic_stop" },

    { "do": "mark", "note": "TCAS OFF" },
    { "do": "switch", "note": "XPDR", "dref": "laminar/B747/flt_mgmt/txpdr/mode_sel_pos", "value": 2, "cmd": "laminar/B747/flt_mgmt/transponder/mode_sel_dial_up", "cmd_down": "laminar/B747/flt_mgmt/transponder/mode_sel_dial_dn" },
    { "do": "check", "note": "X-Plane のモード 3（高度の報告）", "dref": "sim/cockpit2/radios/actuators/transponder_mode", "op": "==", "value": 3 },
    { "do": "check", "note": ">TCAS OFF（FCOM p.1605）", "dref": "laminar/B747/CAS/advisory_status[279]", "op": "==", "value": 1 },
    { "do": "check", "note": "ND に TCAS OFF（TFC 選択中：FCOM p.1153）", "dref": "laminar/B747/nd/capt/tcas_off", "op": "==", "value": 1 },
    { "do": "check", "note": "TFC は出ない", "dref": "laminar/B747/nd/capt/tfc", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_tcas_off" },
    { "do": "cas", "note": "EICAS" },
    { "do": "switch", "note": "TA/RA", "dref": "laminar/B747/flt_mgmt/txpdr/mode_sel_pos", "value": 4, "cmd": "laminar/B747/flt_mgmt/transponder/mode_sel_dial_up", "cmd_down": "laminar/B747/flt_mgmt/transponder/mode_sel_dial_dn" },
    { "do": "check", "note": "TCAS OFF が消える", "dref": "laminar/B747/CAS/advisory_status[279]", "op": "==", "value": 0 },

    { "do": "mark", "note": "TFC switch" },
    { "do": "cmd", "note": "機長の TFC を押す", "name": "laminar/B747/nd/traffic/capt/switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "機長の TFC が消える", "dref": "laminar/B747/nd/capt/tfc", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の TFC はそのまま", "dref": "laminar/B747/nd/fo/tfc", "op": "==", "value": 1 },
    { "do": "cmd", "note": "もう一度押す", "name": "laminar/B747/nd/traffic/capt/switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "機長の TFC が出る", "dref": "laminar/B747/nd/capt/tfc", "op": "==", "value": 1 },

    { "do": "mark", "note": "failures" },
    { "do": "set", "note": "トランスポンダ L の故障", "dref": "laminar/B747/xpdr/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X-Plane のトランスポンダなし", "dref": "sim/cockpit2/radios/actuators/transponder_mode", "op": "==", "value": 0 },
    { "do": "check", "note": ">TRANSPONDER L（FCOM p.1430）", "dref": "laminar/B747/CAS/advisory_status[292]", "op": "==", "value": 1 },
    { "do": "check", "note": ">TCAS SYSTEM（推定：TCAS は選んだトランスポンダからモードを受ける）", "dref": "laminar/B747/CAS/advisory_status[282]", "op": "==", "value": 1 },
    { "do": "check", "note": "ND に TCAS FAIL", "dref": "laminar/B747/nd/capt/tcas_fail", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_tcas_fail" },
    { "do": "cas", "note": "EICAS" },
    { "do": "cmd", "note": "XPDR を R に", "name": "laminar/B747/flt_mgmt/transponder/sel_dial" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "R で TA/RA", "dref": "sim/cockpit2/radios/actuators/transponder_mode", "op": "==", "value": 7 },
    { "do": "check", "note": ">TCAS SYSTEM が消える", "dref": "laminar/B747/CAS/advisory_status[282]", "op": "==", "value": 0 },
    { "do": "check", "note": ">TRANSPONDER L は残る", "dref": "laminar/B747/CAS/advisory_status[292]", "op": "==", "value": 1 },
    { "do": "set", "dref": "laminar/B747/xpdr/fail[0]", "value": 0 },
    { "do": "cmd", "note": "XPDR を L に", "name": "laminar/B747/flt_mgmt/transponder/sel_dial" },
    { "do": "set", "note": "TCAS の故障", "dref": "laminar/B747/tcas/fail", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": ">TCAS SYSTEM", "dref": "laminar/B747/CAS/advisory_status[282]", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane のモードは 3（トランスポンダだけが働く）", "dref": "sim/cockpit2/radios/actuators/transponder_mode", "op": "==", "value": 3 },
    { "do": "set", "dref": "laminar/B747/tcas/fail", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "元に戻る", "dref": "laminar/B747/CAS/advisory_status[282]", "op": "==", "value": 0 },

    { "do": "mark", "note": "OFFSCALE and MAP CTR" },
    { "do": "set", "note": "機長の ND を 10 nm", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 0 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 0 },
    { "do": "cmd", "note": "MAP CTR（見えるのはレンジの半分の 5 nm）", "name": "laminar/B747/nd/center/capt/switch", "duration": 0.2 },
    { "do": "wait", "note": "水平飛行", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-300, 300], "timeout": 60 },
    { "do": "traffic", "note": "正面から同じ高度：TA は 5 nm の外で出る", "targets": [ "tcpa=60 brg=0 gs=400 dh=0 vs=0 miss=0.3" ] },
    { "do": "wait", "note": "範囲外の TA：琥珀の OFFSCALE（FCOM p.1535）", "dref": "laminar/B747/nd/capt/offscale", "op": "==", "value": 1, "timeout": 45 },
    { "do": "check", "note": "副操縦士の ND（20 nm の MAP）には OFFSCALE なし", "dref": "laminar/B747/nd/fo/offscale", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_offscale_ctr" },
    { "do": "wait", "note": "5 nm の内に入ると機長の ND に機影", "dref": "laminar/B747/nd/capt/tcas/show[0]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "shot", "name": "nd_map_ctr" },
    { "do": "cmd", "note": "MAP に戻す", "name": "laminar/B747/nd/center/capt/switch", "duration": 0.2 },
    { "do": "set", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 1 },
    { "do": "wait", "note": "相手機が離れる", "dref": "laminar/B747/nd/capt/traffic", "op": "==", "value": 0, "timeout": 90, "level": "warn" },
    { "do": "traffic_stop" },

    { "do": "mark", "note": "low: 1,050 ft" },
    { "do": "set", "note": "MCP 高度 1,050 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 1050 },
