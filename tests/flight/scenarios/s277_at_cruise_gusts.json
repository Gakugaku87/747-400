    { "do": "sleep", "seconds": 180, "note": "落ち着かせる" },
    { "do": "record_start" },
    { "do": "mark", "note": "水平 300 秒" },
    { "do": "watch", "note": "水平の 300 秒、Mach が .86 の ±0.010", "dref": "sim/cockpit2/gauges/indicators/mach_pilot", "min": 0.85, "max": 0.87, "timeout": 300 },
    { "do": "check", "note": "A/T は SPD のまま", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "FL390 の ±100 ft", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [38900, 39100] },
    { "do": "mark", "note": "右へ 90° の旋回（風が右前から左前へ：対地速度が約 30 kt 減る）" },
    { "do": "set", "note": "MCP 方位を 90° 右へ", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90, "rel": "h0", "round": 1 },
    { "do": "watch", "note": "旋回とその後の 200 秒、Mach が .86 の ±0.010", "dref": "sim/cockpit2/gauges/indicators/mach_pilot", "min": 0.85, "max": 0.87, "timeout": 200 },
    { "do": "check", "note": "旋回を終えている（方位が 90° 右の ±3°）", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [87, 93], "rel": "h0", "level": "warn" },
    { "do": "mark", "note": "V/S −1,500 fpm で FL370 へ（A/T は SPD で Mach を保つ）" },
    { "do": "set", "note": "MCP 高度 FL370", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 37000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 37000 },
