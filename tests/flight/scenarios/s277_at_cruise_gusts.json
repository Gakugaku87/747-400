    { "do": "watch", "note": "降下の間、Mach が .86 の ±0.010（37,500 ft まで）。注意どまり：降下に入るときの行き過ぎ（2026-11-10、ガストの補いの前も後も .872〜.873）は別の残り", "dref": "sim/cockpit2/gauges/indicators/mach_pilot", "min": 0.85, "max": 0.87, "timeout": 150, "level": "warn", "until": { "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 37500 } },
    { "do": "wait", "note": "FL370 の捕捉で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 120 },
