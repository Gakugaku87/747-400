{
  "name": "s162_ils",
  "description": "6-1/6-2 段 10c（FMC の ILS の同調と PFD の ILS の目盛、LOC の位置の更新）の X-Plane での確認。s121 と同じ所（RJAA 34L の進入路の 12 NM、2,500 ft、機体を読み直す）。経路なしで NAV RADIO の ILS は PARK、PFD の目盛なし。RJBB→RJAA の経路に ARRIVALS の ILS34L を入れて ACTIVATE と EXEC：滑走路の 150 NM 内なので A の 111.90/337（FCOM p.1307）、NAV 1・2 と コース、PFD の目盛（FCOM p.987）、POS REF の LOC-GPS L と ND の LOCGPS（FCOM p.1241、p.1150）。手動の 110.30/120 で M と RW/ILS FREQ ERROR、/330 で RW/ILS CRS ERROR、DELETE で A（FCOM p.1305–1306、p.1434）。APP で LOC を捕まえると ILS TUNE INHIBIT、入力は ILS TUNE INHIBITED - MCP で同調はそのまま（FCOM p.1305、p.1432）。CDU・PFD・ND を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },

    { "do": "mark", "note": "経路なし：PARK" },
    { "do": "cdu", "note": "NAV RAD", "keys": ["NAVRAD"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ILS は PARK（FCOM p.1306）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^PARK" },
    { "do": "check", "note": "PFD の目盛なし", "dref": "laminar/B747/autopilot/ils_dots", "op": "==", "value": 0 },

    { "do": "mark", "note": "RJBB→RJAA の ILS34L：A" },
    { "do": "cdu", "note": "RTE：RJBB→RJAA", "keys": ["RTE", "RJBB", "L1", "RJAA", "R1"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJAA ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA ARRIVALS" },
    { "do": "cdu", "note": "NEXT（進入の 6〜10 番目）", "keys": ["NEXT"] },
    { "do": "check", "note": "3R が ILS34L", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "ILS34L" },
    { "do": "cdu", "note": "ILS34L（R3）", "keys": ["R3"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "NAV RAD", "keys": ["NAVRAD"] },
    { "do": "check", "note": "ILS 111.90/337（滑走路の 150 NM 内：FCOM p.1307）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^111[.]90/337" },
    { "do": "check", "note": "A の小字", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^ {10}A" },
    { "do": "check", "note": "NAV 1 は 111.90", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },
    { "do": "check", "note": "NAV 2 も", "dref": "sim/cockpit/radios/nav2_freq_hz", "op": "==", "value": 11190 },
    { "do": "check", "note": "コース 337", "dref": "sim/cockpit2/radios/actuators/nav_obs_deg_mag_pilot[0]", "op": "between", "value": [336.5, 337.5] },
    { "do": "check", "note": "PFD の目盛（FCOM p.987）", "dref": "laminar/B747/autopilot/ils_dots", "op": "==", "value": 1 },
    { "do": "check", "note": "同調の文字の ILS は A", "dref": "laminar/B747/radio/tuningmodes", "op": "matches", "value": "^A" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_navrad_ils_a" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_ils_scales" },

    { "do": "mark", "note": "LOC の位置の更新" },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF（空中は APPROACH REF）、<INDEX、<POS", "keys": ["INITREF", "L6", "L2"] },
    { "do": "check", "note": "FMC POS (LOC-GPS L)（FCOM p.1241、p.1368）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "[(]LOC-GPS L[)]" },
    { "do": "check", "note": "ND の更新の表示は LOCGPS（FCOM p.1150）", "dref": "laminar/B747/irs/gps_display_line", "op": "matches", "value": "^LOCGPS$" },
    { "do": "check", "note": "進入の RNP 0.50 か ターミナルの 1.00（小字）", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "^[01][.][05]0" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_pos_ref_loc" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_locgps" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },

    { "do": "mark", "note": "手動：RW/ILS FREQ ERROR と CRS ERROR" },
    { "do": "cdu", "note": "NAV RAD、110.30/120 を L4", "keys": ["NAVRAD", "110.30/120", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "M の 110.30/120", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^110[.]30/120" },
    { "do": "check", "note": "M の小字", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^ {10}M" },
    { "do": "check", "note": "RW/ILS FREQ ERROR（FCOM p.1434）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "RW/ILS FREQ ERROR" },
    { "do": "check", "note": "NAV 1 は 110.30", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11030 },
    { "do": "shot", "name": "cdu_navrad_ils_freq_error" },
    { "do": "cdu", "note": "CLR（通知を消す：出ている間の DEL は書き込み行に入らない。初めの版（2026-11-01 6:16）は CLR なしで DELETE が効かなかった）、DELETE を L4", "keys": ["CLR", "DEL", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "A に戻る", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^ {10}A" },
    { "do": "check", "note": "NAV 1 は 111.90 に戻る", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },
    { "do": "cdu", "note": "/330 を L4", "keys": ["/330", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "M の 111.90/330", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^111[.]90/330" },
    { "do": "check", "note": "RW/ILS CRS ERROR の旗", "dref": "laminar/B747/fms/notification[40]", "op": "==", "value": 1 },
    { "do": "cdu", "note": "CLR（通知を消す：出ている間の DEL は書き込み行に入らない。初めの版（2026-11-01 6:16）は CLR なしで DELETE が効かなかった）、DELETE を L4", "keys": ["CLR", "DEL", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CRS ERROR は消える", "dref": "laminar/B747/fms/notification[40]", "op": "==", "value": 0 },
    { "do": "check", "note": "コースは 337 に戻る", "dref": "sim/cockpit2/radios/actuators/nav_obs_deg_mag_pilot[0]", "op": "between", "value": [336.5, 337.5] },

    { "do": "mark", "note": "LOC の捕捉：ILS TUNE INHIBITED" },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "LOC を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 90 },
    { "do": "check", "note": "ILS TUNE INHIBIT", "dref": "laminar/B747/autopilot/ils_tune_inhibit", "op": "==", "value": 1 },
    { "do": "cdu", "note": "CLR を 3 回、110.30/120 を L4", "keys": ["CLR", "CLR", "CLR", "110.30/120", "L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ILS TUNE INHIBITED - MCP（FCOM p.1432）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "ILS TUNE INHIBITED" },
    { "do": "check", "note": "NAV 1 は 111.90 のまま", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },
    { "do": "check", "note": "A のまま", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^ {10}A" },
    { "do": "shot", "name": "cdu_navrad_ils_inhibited" },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "もう一度（AUTOPILOT DISC を消す）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
