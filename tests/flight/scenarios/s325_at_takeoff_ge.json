{
  "name": "s325_at_takeoff_ge",
  "description": "s142 の GE 版（2026-11-12 のフルレビュー T-3：REVIEW_2026-11-12.md 案 23 の P3。利用者のラインの飛行は GE）：リバリー Saudia（CF6-80C2）で A/T の離陸。手順は s142 のまま、EPR の確かめを N1 に（80 kt で N1 が TO の基準の ±1 %：幅は推定。PW の ±0.01 EPR の代わり）",
  "livery": "Saudia",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 9,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 9000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 9000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s109 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "CDU：経路、PERF INIT、TAKEOFF REF" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "170", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20（1L）、V1・VR・V2 を選ぶ（1R〜3R）", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "V2 を選んだ（999 でない）", "dref": "laminar/B747/airspeed/V2", "op": "<", "value": 900 },
    { "do": "check", "note": "推力の基準は TO", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "contains", "value": "TO" },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/T は空白（ARM だけ：FCOM p.641）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 0 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "TO/GA で A/T の THR REF、65 kt で HOLD" },
    { "do": "cmd", "note": "TO/GA（止まっている：50 kt 未満）", "name": "sim/engines/TOGA_power" },
    { "do": "wait", "note": "A/T の THR REF（5）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5, "timeout": 5 },
    { "do": "check", "note": "A/T は active", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 1 },
    { "do": "wait", "note": "65 kt で HOLD（1：FCOM p.667）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 1, "timeout": 90 },
    { "do": "snapshot", "note": "HOLD の時", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/engine/throttle[0]", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/ref_thr_limit_mode" ] },
    { "do": "check", "note": "HOLD は 65 kt から", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [64, 80] },
    { "do": "remember", "dref": "sim/cockpit2/engine/actuators/N1_target_bug[0]", "as": "n1_ref" },
    { "do": "wait", "note": "80 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 80, "timeout": 30 },
    { "do": "snapshot", "note": "80 kt の N1 と基準", "drefs": [ "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N1[3]", "sim/cockpit2/engine/actuators/N1_target_bug[0]", "laminar/B747/engine/throttle[0]" ] },
    { "do": "check", "note": "80 kt で N1 が TO の基準に届いている（FCOM p.667、FCTM p.93。±1 % は推定）", "dref": "laminar/B747/engines/display_N1[0]", "op": "between", "rel": "n1_ref", "value": [-1.0, 1.0] },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 90 },
    { "do": "set", "note": "操縦輪を引く（引き起こし）", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.35 },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "set", "note": "操縦輪を緩める", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "check", "note": "A/T は HOLD のまま（前は 50 ft で THR REF に戻った）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 1 },
    { "do": "cmd", "note": "手の操縦を終える（操縦輪はそのまま）", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },

    { "do": "mark", "note": "VNAV の engage で THR REF" },
    { "do": "wait", "note": "VNAV SPD（400 ft の上）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "wait", "note": "A/T は VNAV の THR REF（5）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5, "timeout": 5 },
    { "do": "check", "note": ">AUTOTHROT DISC なし", "dref": "laminar/B747/CAS/caution_status[5]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 10 },

    { "do": "mark", "note": "disconnect スイッチと >AUTOTHROT DISC、ARM の入れ直し" },
    { "do": "cmd", "note": "A/T の disconnect スイッチ（左）", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/T は外れる（空白）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 0 },
    { "do": "check", "note": ">AUTOTHROT DISC（caution）", "dref": "laminar/B747/CAS/caution_status[5]", "op": "==", "value": 1 },
    { "do": "check", "note": "ARM スイッチは ARM のまま", "dref": "laminar/B747/toggle_switch/position[29]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "もう一度（右）", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "メッセージが消える", "dref": "laminar/B747/CAS/caution_status[5]", "op": "==", "value": 0 },
    { "do": "check", "note": "A/T は外れたまま", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 0 },
    { "do": "switch", "note": "A/T ARM を OFF", "dref": "laminar/B747/toggle_switch/position[29]", "value": 0, "cmd": "laminar/B747/authrottle_arm", "cmd_down": "laminar/B747/authrottle_disarm" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "A/T ARM を ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "wait", "note": "VNAV の中なので A/T が engage（FCOM p.641）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "between", "value": [3, 5], "timeout": 5 },
    { "do": "check", "note": "メッセージは無いまま", "dref": "laminar/B747/CAS/caution_status[5]", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "終わり", "drefs": [ "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/engines/autothrottle_active", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "record_stop" }
  ]
}
