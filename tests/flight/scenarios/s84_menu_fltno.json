{
  "name": "s84_menu_fltno",
  "description": "MENU の <FMC と FLT NO（6-2 段 3c）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す）。左の CDU で、最初の <FMC は IDENT、INIT REF → PERF INIT → THRUST LIM の後の MENU → <FMC は THRUST LIM（FCOM p.1323）、MENU → ACMS を挟んでも THRUST LIM。右の CDU の最初の <FMC は IDENT。RTE ページの FLT NO：JL123 が FMC の便名になって右寄せで出る、9 文字は INVALID ENTRY、DELETE は INVALID DELETE（FMSPG p.79, p.278）、PROGRESS の題名に便名（FCOM p.1371）。CDU を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "mark", "note": "MENU の <FMC（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "MENU", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "cmd", "note": "<FMC（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "最初の <FMC は IDENT（FCOM p.1323）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "IDENT" },
    { "do": "cmd", "note": "INIT REF（地上：PERF INIT）", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "THRUST LIM>（R6）", "name": "laminar/B747/fms1/ls_key/R6" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<FMC", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "<FMC：最後の FMC のページ THRUST LIM（前は常に IDENT）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<ACMS（L5）", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<FMC", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "ACMS を挟んでも THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "cmd", "note": "右の CDU：MENU", "name": "laminar/B747/fms2/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "右の CDU：<FMC", "name": "laminar/B747/fms2/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "右の CDU の最初の <FMC は IDENT（CDU ごと）", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "IDENT" },

    { "do": "mark", "note": "RTE ページの FLT NO" },
    { "do": "cmd", "note": "RTE", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FLT NO はダッシュ", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "--------" },
    { "do": "cmd", "note": "J", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "note": "L", "name": "laminar/B747/fms1/alphanum_key/L" },
    { "do": "cmd", "note": "1", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "3", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "FLT NO へ（R2）", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "FLT NO JL123（右寄せ）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "   JL123" },
    { "do": "check", "note": "FMC の便名（ACARS・ATC・PROGRESS が使う）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"fltno\":\"JL123   \"" },
    { "do": "cmd", "note": "1", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "3", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "4", "name": "laminar/B747/fms1/alphanum_key/4" },
    { "do": "cmd", "note": "5", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "6", "name": "laminar/B747/fms1/alphanum_key/6" },
    { "do": "cmd", "note": "7", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "note": "8", "name": "laminar/B747/fms1/alphanum_key/8" },
    { "do": "cmd", "note": "9", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "note": "9 文字を FLT NO へ", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "9 文字は INVALID ENTRY（FMSPG p.79：1〜8 文字）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cmd", "note": "CLR（メッセージ）", "name": "laminar/B747/fms1/key/clear" },
    { "do": "cmd", "note": "CLR を押し続けて全部消す", "name": "laminar/B747/fms1/key/clear", "duration": 1.2 },
    { "do": "cmd", "note": "DEL", "name": "laminar/B747/fms1/key/del" },
    { "do": "cmd", "note": "DELETE を FLT NO へ", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "削除は INVALID DELETE（FMSPG p.278）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID DELETE" },
    { "do": "check", "note": "便名は残る", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "JL123" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_rte_fltno" },
    { "do": "cmd", "note": "PROG", "name": "laminar/B747/fms1/func_key/prog" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PROGRESS の題名に便名（FCOM p.1371）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "JL123 PROGRESS" },
    { "do": "shot", "name": "cdu_progress_fltno" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
