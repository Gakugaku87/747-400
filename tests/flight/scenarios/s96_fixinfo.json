{
  "name": "s96_fixinfo",
  "description": "FIX INFO（6-1・6-2 段 7e3b）の X-Plane での確認、空中。RJAA→XAC の脚の上、XAC の 15 nm 手前、10,000 ft、250 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DIRECT XAC・SPENS・SAGRA を入れ、ACTIVATE と EXEC、LNAV。FIX キーで FMC の FIX INFO（FCOM p.1358；前は X-Plane の FIX ページ）、FIX に KOUGA（XAC→SPENS の脚の南 22 nm ほど）：BRG/DIS FR、方位 360 の線と脚の交点（距離は小字、DTG）、距離 /30 の円の近い方の交点（方位は小字）、<ABEAM（脚に直角の点の方位と距離、DTG）、もう一度押して PBD の写し、LEGS の経路の終わりの後に入れて KOU01、ERASE。PRED ETA-ALT に 1234Z、<ERASE FIX、2 ページ目（FCOM p.1358-1359；FMSPG p.166-169）。CDU を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.91121, "longitude": 139.59895, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（脚の向き：真 217）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DIRECT XAC・SPENS・SAGRA、ACTIVATE と EXEC、LNAV" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "SAGRA", "R3", "?SEL"] },
    { "do": "cdu", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS、現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^XAC " },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "脚の上なので LNAV がすぐ engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 30 },

    { "do": "mark", "note": "FIX キーで FIX INFO（FCOM p.1358；FMSPG p.166）" },
    { "do": "cmd", "note": "FIX キー", "name": "laminar/B747/fms1/func_key/dir_intc" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FIX INFO", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "      FIX INFO          " },
    { "do": "check", "note": "1/2", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "1/2" },
    { "do": "check", "note": "FIX の箱", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "*****                   " },
    { "do": "check", "note": "PRED ETA-ALT のダッシュ", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "                   -----" },

    { "do": "mark", "note": "FIX に KOUGA：BRG/DIS FR、方位線・距離の円の交点、ABEAM（FCOM p.1358-1359；FMSPG p.167-168）" },
    { "do": "cdu", "keys": ["KOUGA", "L1", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "KOUGA と、飛行機の KOUGA からの方位と距離", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^KOUGA   0\\d\\d/\\d+ +$" },
    { "do": "check", "note": "BRG/DIS のダッシュ", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "---/---                 " },
    { "do": "check", "note": "<ABEAM", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "<ABEAM                  " },
    { "do": "cdu", "note": "方位 360", "keys": ["360", "L2"] },
    { "do": "check", "note": "360 と、XAC→SPENS の脚との交点までの DTG", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^360/ +\\d+ +$" },
    { "do": "check", "note": "交点までの距離（20 nm ほど）を小字で / の後に（FMSPG p.167）", "dref": "laminar/B747/fms3/Line05_S", "op": "matches", "value": "^    2\\d +$" },
    { "do": "cdu", "note": "距離 30", "keys": ["/30", "L3"] },
    { "do": "check", "note": "/30 と DTG", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^   /30 +\\d+ +$" },
    { "do": "check", "note": "近い方の交点の方位を小字で / の前に（FCOM p.1358 の図）", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "^\\d\\d\\d +$" },
    { "do": "cdu", "note": "<ABEAM", "keys": ["L5"] },
    { "do": "check", "note": "脚に直角の点：方位 007 ほど、距離 20 nm ほど、DTG（FMSPG p.168）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^0[01]\\d/2\\d +\\d+ +$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_fix_info" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "note": "もう一度 <ABEAM：PBD の写し（FCOM p.1359）", "keys": ["L5"] },
    { "do": "check", "note": "KOUGA0xx.x/02x.x", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^KOUGA0[01]\\d\\.\\d/02\\d\\.\\d *$" },

    { "do": "mark", "note": "写しを LEGS の経路の終わりの後に（段 7e3a）" },
    { "do": "cdu", "keys": ["LEGS", "L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "KOU01（KOUGA の頭 3 文字と 01）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^KOU01 " },
    { "do": "check", "note": "MOD RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 LEGS" },
    { "do": "cdu", "note": "ERASE", "keys": ["L6"] },

    { "do": "mark", "note": "PRED ETA-ALT、<ERASE FIX、2 ページ目（FMSPG p.168-169）" },
    { "do": "cmd", "note": "FIX キー", "name": "laminar/B747/fms1/func_key/dir_intc" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "keys": ["1234Z", "R6"] },
    { "do": "check", "note": "1234（z は小字）", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^<ERASE FIX +1234 $" },
    { "do": "check", "note": "z", "dref": "laminar/B747/fms3/Line13_S", "op": "matches", "value": "z$" },
    { "do": "cdu", "note": "<ERASE FIX", "keys": ["L6"] },
    { "do": "check", "note": "箱に戻る", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "*****                   " },
    { "do": "check", "note": "PRED ETA-ALT は残る", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "                   1234 " },
    { "do": "cdu", "keys": ["NEXT"] },
    { "do": "check", "note": "2/2", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "2/2" },
    { "do": "check", "note": "2 ページ目の箱", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "*****                   " },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
