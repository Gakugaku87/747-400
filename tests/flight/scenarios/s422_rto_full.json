{
  "name": "s422_rto_full",
  "description": "高速の RTO の通し（2026-11-24、段 4 のレビューの D の AFDS-7・WARN の X-Plane の場面）。RJAA 34L でエンジン運転中に始め（機体を読み直す、270 t）、フラップ 20、離陸トリム、オートブレーキ RTO。離陸推力で滑走し、60 kt で油圧系統 1 のエンジンポンプ、75 kt でデマンドポンプを切ると、HYD PRESS SYS 1（注意）が 80 kt を越えてから出る：主注意灯は離陸の抑止で点かない（FCOM p.1594：80 kt から、RTO なら 75 kt を切るまで）。120 kt で推力レバーをアイドルにして逆推力を 4 秒：スピードブレーキのレバーが自動で UP（FCOM p.951）、RTO の最大圧（ブレーキの比 1、ATA29_32 p.527）、警報なし。75 kt を切るまで主注意灯は点かず、切ると点く。止まってから元に戻す。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "check", "note": "機長側の IRS が整列（RTO の arm の条件）", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 2, "stop": true },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s109 と同じ。滑走路開始の 7.5 単位から約 4.9 単位）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "check", "note": "トリムは比 −0.28〜−0.42（約 4.4〜5.4 単位）", "dref": "sim/flightmodel2/controls/elevator_trim", "op": "between", "value": [-0.42, -0.28] },
    { "do": "sleep", "seconds": 2 },
    { "do": "wait", "note": "フラップ 20 に着く", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 0, "timeout": 60 },
    { "do": "check", "note": "スピードブレーキのレバーは DN", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": "==", "value": 0 },
    { "do": "cmd", "note": "RTO（X-Plane のコマンドでセレクターに）", "name": "sim/flight_controls/brakes_rto_auto" },
    { "do": "wait", "note": "セレクター RTO", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "op": "==", "value": 0, "timeout": 5 },
    { "do": "wait", "note": "AUTOBRAKES RTO（ATA29_32 p.530）", "dref": "laminar/B747/CAS/memo_status[7]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "パーキングブレーキのレバーを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "主注意灯を消す（始めからある注意のため）", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cas", "note": "滑走の前" },
    { "do": "check", "note": "滑走の前：主注意灯なし", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 0, "stop": true },
    { "do": "check", "note": "滑走の前：主警告灯なし", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0, "stop": true },

    { "do": "mark", "note": "離陸の滑走" },
    { "do": "set", "note": "推力レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "離陸の形態の警報なし（フラップ 20、トリム、スピードブレーキ DN、パーキングブレーキ OFF）", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0, "stop": true },
    { "do": "wait", "note": "60 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 60, "timeout": 60 },
    { "do": "switch", "note": "油圧系統 1 の ENGINE ポンプ OFF（デマンドポンプが引き継ぐ）", "dref": "laminar/B747/button_switch/position[30]", "value": 0, "cmd": "laminar/B747/button_switch/hyd_pump_1" },
    { "do": "wait", "note": "75 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 75, "timeout": 30 },
    { "do": "switch", "note": "DEMAND 1 OFF（系統 1 の圧が抜ける：s04 では 3.3 秒で 1,200 psi、その 2.2 秒後に HYD PRESS SYS 1）", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_dn" },
    { "do": "wait", "note": "HYD PRESS SYS 1（FCOM p.1495）", "dref": "laminar/B747/CAS/caution_status[40]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "check", "note": "注意は 80 kt を越えてから出た（離陸の抑止の中：この場面の前提）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 81, "stop": true },
    { "do": "check", "note": "主注意灯は点かない（FCOM p.1594：80 kt から抑止）", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 0 },
    { "do": "wait", "note": "120 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 120, "timeout": 30 },

    { "do": "mark", "note": "RTO at 120 kt" },
    { "do": "set", "note": "RTO：推力レバーをアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "cmd", "note": "逆推力を引く（全エンジン、4 秒：放すまで次へ進まない）", "name": "sim/engines/thrust_reverse_hold", "duration": 4 },
    { "do": "snapshot", "note": "逆推力の後", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/flt_ctrls/speedbrake_lever", "sim/cockpit2/controls/left_brake_ratio", "sim/cockpit2/controls/right_brake_ratio", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[0]", "laminar/B747/warning/master_caution", "laminar/B747/warning/master_warning" ] },
    { "do": "check", "note": "スピードブレーキのレバーが自動で UP（逆推力のレバー、FCOM p.951）", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": ">", "value": 0.9 },
    { "do": "check", "note": "RTO：最大圧（ブレーキの比 1、ATA29_32 p.527）", "dref": "sim/cockpit2/controls/left_brake_ratio", "op": ">", "value": 0.98 },
    { "do": "check", "note": "右も", "dref": "sim/cockpit2/controls/right_brake_ratio", "op": ">", "value": 0.98 },
    { "do": "check", "note": "警報なし（主警告灯）", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0 },
    { "do": "watch", "note": "75 kt を切るまで主注意灯は点かない（FCOM p.1594：80 kt より上で始めた RTO の抑止は 75 kt を切るまで）", "dref": "laminar/B747/warning/master_caution", "timeout": 40, "max": 0, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 75 } },
    { "do": "wait", "note": "75 kt を切ると、抑止の間に出た HYD PRESS SYS 1 で主注意灯が点く（FCOM p.1594）", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 1, "timeout": 4 },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 1, "timeout": 60 },
    { "do": "check", "note": "止まった：警報なし", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0 },
    { "do": "cas", "note": "止まった" },

    { "do": "set", "note": "推力レバーを前のアイドルへ（逆推力のレバーを下げきる）", "dref": "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "value": 0 },
    { "do": "set", "note": "パーキングブレーキのレバー", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "cmd", "note": "オートブレーキ OFF", "name": "sim/flight_controls/brakes_off_auto" },
    { "do": "switch", "note": "DEMAND 1 AUTO", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 1, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_up" },
    { "do": "switch", "note": "ENGINE ポンプ 1 ON", "dref": "laminar/B747/button_switch/position[30]", "value": 1, "cmd": "laminar/B747/button_switch/hyd_pump_1" },
    { "do": "wait", "note": "系統 1 の圧が戻る", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">", "value": 2800, "timeout": 20 },
    { "do": "record_stop" },
    { "do": "cas", "note": "終わり" }
  ]
}
