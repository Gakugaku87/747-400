{
  "name": "s33_lateral",
  "description": "横操縦（4-1 段 4：ATA27 p.59、p.76、p.88、p.143–150、p.165、p.188–190、p.206–207、FCOM p.947）の X-Plane での確認、地上。RJAA 34L でエンジン運転中、駐機ブレーキ。操縦輪（X-Plane の yoke_roll_ratio、1 が 90°）を半分（45°）にするとエルロンは全舵角（内側 20°、外側は上げ 24.65°・下げ 15°。前は比例で 10°）、上がる側の翼のスポイラーは動き始め（11°）からの比例。10° ではスポイラーは動かない。エルロントリムいっぱい（6 units）は操縦輪 47°（前は操縦輪いっぱい）。自動のアクチュエータを止めて（laminar/B747/flt_ctrls/fail/auto_speedbrake）レバーを flight detent にすると、スポイラー 6・7 が X-Plane のスピードブレーキ面（speedbrake1_deg：前は動かなかった）で 20°、主翼 2 のスポイラー（4・9：前は動かなかった）も動く。flight detent で右へ回すと左翼のスポイラーがスピードブレーキの位置から下がる（ミキサー）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "sim/cockpit2/controls/parking_brake_ratio", "value": 1 },
    { "do": "snapshot", "note": "開始", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_2",
      "laminar/B747/hydraulics/pressure_3", "laminar/B747/hydraulics/pressure_4", "laminar/B747/flt_ctrls/left_outer_aileron_lockout",
      "laminar/B747/flt_ctrls/right_outer_aileron_lockout", "laminar/B747/cablecontrols/wheel" ] },

    { "do": "mark", "note": "操縦輪 45°" },
    { "do": "set", "note": "操縦輪を右へ半分（45°）", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0.5 },
    { "do": "wait", "note": "操縦輪の角度", "dref": "laminar/B747/cablecontrols/wheel", "op": "between", "value": [44.9, 45.1], "timeout": 3 },
    { "do": "wait", "note": "左内側エルロンが全舵角の下げ 20°（ATA27 p.59：約 45° で全舵角。前は比例で 10°）", "dref": "laminar/B747/flt_ctrls/l_aileron_inner", "op": ">", "value": 19.9, "timeout": 3 },
    { "do": "check", "note": "右内側は上げ 20°", "dref": "laminar/B747/flt_ctrls/r_aileron_inner", "op": "between", "value": [-20.05, -19.9] },
    { "do": "check", "note": "左外側は下げ 15°", "dref": "laminar/B747/flt_ctrls/l_aileron_outer", "op": "between", "value": [14.9, 15.05] },
    { "do": "check", "note": "右外側は上げ 24.65°（47° で 25°）", "dref": "laminar/B747/flt_ctrls/r_aileron_outer", "op": "between", "value": [-24.75, -24.55] },
    { "do": "check", "note": "X-Plane の左内側エルロン", "dref": "sim/flightmodel/controls/wing2l_ail1def", "op": ">", "value": 19.9 },
    { "do": "check", "note": "右翼のスポイラー 12 は動き始め（11°）からの比例：45 × (45 − 11) / 79 = 19.4°（推定の作り）", "dref": "laminar/B747/flt_ctrls/spoilers[12]", "op": "between", "value": [18.9, 19.9] },
    { "do": "check", "note": "スポイラー 8 は 20° が最大：8.6°", "dref": "laminar/B747/flt_ctrls/spoilers[8]", "op": "between", "value": [8.1, 9.1] },
    { "do": "check", "note": "左翼のスポイラー 1 は下りたまま", "dref": "laminar/B747/flt_ctrls/spoilers[1]", "op": "<", "value": 0.1 },
    { "do": "check", "note": "X-Plane の主翼 2 のスポイラー（スポイラー 9。前は動かなかった）", "dref": "sim/flightmodel/controls/wing2r_spo1def", "op": "between", "value": [18.9, 19.9] },
    { "do": "cmd", "note": "下の EICAS に STATUS ページ（舵面の位置）", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "view", "the": -31, "psi": 32, "fov": 13 },
    { "do": "shot", "name": "status_wheel45" },
    { "do": "view", "name": "forward" },
    { "do": "cmd", "note": "STATUS ページを消す", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },

    { "do": "mark", "note": "操縦輪 10°" },
    { "do": "set", "note": "操縦輪を 10°", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0.1111 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "左内側エルロン 5.65°（p.59。前は 2.2°）", "dref": "laminar/B747/flt_ctrls/l_aileron_inner", "op": "between", "value": [5.5, 5.8] },
    { "do": "check", "note": "動き始めの手前：スポイラー 12 は動かない", "dref": "laminar/B747/flt_ctrls/spoilers[12]", "op": "<", "value": 0.2 },

    { "do": "mark", "note": "エルロントリム" },
    { "do": "set", "note": "操縦輪を中立", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0 },
    { "do": "set", "note": "エルロントリムいっぱい（6 units）", "dref": "sim/cockpit2/controls/aileron_trim", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "操縦輪の中立が 47°（ATA27 p.76。前は操縦輪いっぱい）", "dref": "laminar/B747/cablecontrols/wheel", "op": "between", "value": [46.9, 47.1] },
    { "do": "check", "note": "トリムいっぱいで内側エルロン 20°", "dref": "laminar/B747/flt_ctrls/l_aileron_inner", "op": ">", "value": 19.9 },
    { "do": "set", "note": "トリムを戻す", "dref": "sim/cockpit2/controls/aileron_trim", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "flight detent" },
    { "do": "set", "note": "自動のアクチュエータを止める（地上で ARM 以上だと UP まで動かすため）", "dref": "laminar/B747/flt_ctrls/fail/auto_speedbrake", "value": 1 },
    { "do": "cmd", "note": "レバーを 1 段（DN → ARM）", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "cmd", "note": "レバーをもう 1 段（ARM → flight detent）", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "flight detent", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": "between", "value": [0.52, 0.54] },
    { "do": "check", "note": "スポイラー 3 は 45°（p.165）", "dref": "laminar/B747/flt_ctrls/spoilers[3]", "op": ">", "value": 44.8 },
    { "do": "check", "note": "スポイラー 6 は 20°（ground spoiler valve の U1）", "dref": "laminar/B747/flt_ctrls/spoilers[6]", "op": "between", "value": [19.8, 20.1] },
    { "do": "check", "note": "スポイラー 1 は下りたまま", "dref": "laminar/B747/flt_ctrls/spoilers[1]", "op": "<", "value": 0.1 },
    { "do": "check", "note": "X-Plane のスピードブレーキ面の左（スポイラー 6。前は動かなかった）", "dref": "sim/flightmodel2/wing/speedbrake1_deg[0]", "op": "between", "value": [19.8, 20.1] },
    { "do": "check", "note": "X-Plane のスピードブレーキ面の右（スポイラー 7）", "dref": "sim/flightmodel2/wing/speedbrake1_deg[1]", "op": "between", "value": [19.8, 20.1] },
    { "do": "check", "note": "X-Plane の主翼 2 のスポイラーの左（スポイラー 4）", "dref": "sim/flightmodel/controls/wing2l_spo1def", "op": ">", "value": 44.8 },

    { "do": "mark", "note": "ミキサー" },
    { "do": "set", "note": "操縦輪を右へ半分", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "左翼のスポイラー 3 がスピードブレーキの位置から下がる：45 − 19.4 = 25.6°（FCOM p.947）", "dref": "laminar/B747/flt_ctrls/spoilers[3]", "op": "between", "value": [25.1, 26.1] },
    { "do": "check", "note": "右翼のスポイラー 10 は 45°", "dref": "laminar/B747/flt_ctrls/spoilers[10]", "op": ">", "value": 44.8 },
    { "do": "check", "note": "左翼のスポイラー 5 も 20° から下がる：11.4°", "dref": "laminar/B747/flt_ctrls/spoilers[5]", "op": "between", "value": [10.9, 11.9] },
    { "do": "check", "note": "スポイラー 6 は横操縦で動かない", "dref": "laminar/B747/flt_ctrls/spoilers[6]", "op": "between", "value": [19.8, 20.1] },
    { "do": "cmd", "note": "下の EICAS に STATUS ページ（舵面の位置）", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "view", "the": -31, "psi": 32, "fov": 13 },
    { "do": "shot", "name": "status_mixer" },
    { "do": "view", "name": "forward" },
    { "do": "cmd", "note": "STATUS ページを消す", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "set", "note": "操縦輪を中立", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0 },
    { "do": "cmd", "note": "レバーを UP", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "UP：スポイラー 1 も 45°（p.207）", "dref": "laminar/B747/flt_ctrls/spoilers[1]", "op": ">", "value": 44.8 },
    { "do": "check", "note": "UP：X-Plane のスピードブレーキ面（スポイラー 6）は 45°", "dref": "sim/flightmodel2/wing/speedbrake1_deg[0]", "op": ">", "value": 44.8 },
    { "do": "cmd", "note": "レバーを DN", "name": "sim/flight_controls/speed_brakes_up_all" },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/auto_speedbrake", "value": 0 },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "DN：スポイラー 3 は下りる", "dref": "laminar/B747/flt_ctrls/spoilers[3]", "op": "<", "value": 0.1 }
  ]
}
