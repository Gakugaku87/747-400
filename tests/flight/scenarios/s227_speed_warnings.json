{
  "name": "s227_speed_warnings",
  "description": "速度の警報（利用者の質問 2026-11-04「赤テープ速度域に入っても一切警報が鳴っていないのは正常？」「フラップ出してる状態で赤帯入っても鳴らないんや」）の X-Plane での確認、空中。銚子沖の 10,000 ft・約 377 KCAS（真 224 m/s）で開始し、Vmo（365 kt）を越えているので OVERSPEED（赤の EICAS とサイレン：FCOM p.1557、p.1550–1551）が出て、サイレンの音の条件（.snd の laminar/B747/warning/warning_siren）が立つこと、MCP の速さを下げて Vmo を切ると消えること。フラップ 20 で制限速度（230 kt）を越えて赤と黒の帯に入っても警報は出ないこと（OVERSPEED は Vmo/Mmo だけ：FCOM p.1557）。レバー 25 を制限速度の上で選ぶと、FCU のロードリリーフでフラップは 20 のままで >FLAP RELIEF（advisory）、制限を切ると 25 まで出て消えること（FCOM p.954、p.957）。A/T を切ってアイドルにし、AIRSPEED LOW（琥珀）の後、赤と黒の帯の上端でスティックシェーカーと、その音の条件（2026-11-04 から .snd は laminar/B747/warning/stick_shaker。前は X-Plane が acf の迎え角 15° で自分で計算する sim/cockpit2/annunciators/stall_warning で、プラグインの書き込みと取り合ってちらついた）が立ち続けること。PFD を撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 224.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40 },
    { "do": "snapshot", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airdata/mach_capt", "laminar/B747/airspeed/Vmax", "laminar/B747/CAS/warning_status[22]", "laminar/B747/warning/warning_siren", "laminar/B747/warning/master_warning" ] },
    { "do": "check", "note": "Vmo（365 kt）を越えている", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 366 },
    { "do": "wait", "note": "OVERSPEED（警告）", "dref": "laminar/B747/CAS/warning_status[22]", "op": "==", "value": 1, "timeout": 10, "cite": "FCOM p.1557" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "サイレン（.snd の音の条件 warning_siren > 0.5）", "dref": "laminar/B747/warning/warning_siren", "op": ">", "value": 0.5, "cite": "FCOM p.1550-1551" },
    { "do": "cas", "note": "OVERSPEED の表示" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_overspeed" },
    { "do": "set", "note": "MCP 速度 320 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 320 },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "Vmo を切る", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 360, "timeout": 120 },
    { "do": "wait", "note": "OVERSPEED が消える", "dref": "laminar/B747/CAS/warning_status[22]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "サイレンが止まる（条件が無くなるまで鳴る：FCOM p.1551）", "dref": "laminar/B747/warning/warning_siren", "op": "<", "value": 0.5 },

    { "do": "mark", "note": "フラップの制限速度" },
    { "do": "set", "note": "MCP 速度 235 kt（クリーンの最小機動速度の付近）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 235 },
    { "do": "wait", "note": "240 kt を切る", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 240, "timeout": 240 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.3333 },
    { "do": "set", "note": "MCP 速度 215 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 215 },
    { "do": "wait", "note": "220 kt を切る", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 220, "timeout": 180 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "wait", "note": "フラップ 20（FCU の detent の番号での位置）", "dref": "laminar/B747/flt_ctrls/fcu/flap_pos", "op": ">", "value": 19.5, "timeout": 120 },
    { "do": "cmd", "note": "A/T OFF（A/T の SPD は制限速度を越えない：FCOM p.673、p.675）", "name": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "推力を手で上げる", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.85 },
    { "do": "wait", "note": "赤と黒の帯（フラップ 20 の制限 230 kt）に入る", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 236, "timeout": 120 },
    { "do": "snapshot", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vmax", "laminar/B747/CAS/warning_status[22]", "laminar/B747/warning/warning_siren" ] },
    { "do": "check", "note": "フラップの制限では OVERSPEED は出ない（Vmo/Mmo だけ）", "dref": "laminar/B747/CAS/warning_status[22]", "op": "==", "value": 0, "cite": "FCOM p.1557" },
    { "do": "check", "note": "サイレンも鳴らない", "dref": "laminar/B747/warning/warning_siren", "op": "<", "value": 0.5 },
    { "do": "shot", "name": "pfd_flap_placard" },
    { "do": "set", "note": "MCP 速度 215 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 215 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "220 kt を切る（レバー 25 の制限 205 kt の上）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 220, "timeout": 120 },
    { "do": "set", "note": "レバー 25", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.8333 },
    { "do": "wait", "note": ">FLAP RELIEF（ロードリリーフ）", "dref": "laminar/B747/CAS/advisory_status[142]", "op": "==", "value": 1, "timeout": 10, "cite": "FCOM p.954, p.957" },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "フラップは 20 のまま", "dref": "laminar/B747/flt_ctrls/fcu/flap_pos", "op": "<", "value": 20.5 },
    { "do": "set", "note": "MCP 速度 190 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 190 },
    { "do": "wait", "note": "制限（戻りは 195 kt）を切ると 25 まで出る", "dref": "laminar/B747/flt_ctrls/fcu/flap_pos", "op": ">", "value": 24.5, "timeout": 120 },
    { "do": "wait", "note": ">FLAP RELIEF が消える", "dref": "laminar/B747/CAS/advisory_status[142]", "op": "==", "value": 0, "timeout": 10 },

    { "do": "mark", "note": "シェーカー" },
    { "do": "sleep", "seconds": 15, "note": "フラップの後の揺れ" },
    { "do": "check", "note": "シェーカーなし", "dref": "laminar/B747/warning/stick_shaker", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "最小機動速度を切る：AIRSPEED LOW（琥珀）", "dref": "laminar/B747/CAS/caution_status[0]", "op": "==", "value": 1, "timeout": 120, "cite": "FCOM p.1556" },
    { "do": "wait", "note": "帯の上端を切る：シェーカー（音の条件）", "dref": "laminar/B747/warning/stick_shaker", "op": "==", "value": 1, "timeout": 120 },
    { "do": "watch", "note": "シェーカーの音の条件が 3 秒ちらつかない（前は X-Plane の失速警報と取り合った）", "dref": "laminar/B747/warning/stick_shaker", "min": 1, "timeout": 3 },
    { "do": "snapshot", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vs", "laminar/B747/warning/stick_shaker", "sim/flightmodel/failures/stallwarning", "sim/cockpit2/annunciators/stall_warning", "sim/flightmodel/position/alpha" ] },
    { "do": "shot", "name": "pfd_shaker" },
    { "do": "set", "note": "回復：推力", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "シェーカーが止まる", "dref": "laminar/B747/warning/stick_shaker", "op": "==", "value": 0, "timeout": 30 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
