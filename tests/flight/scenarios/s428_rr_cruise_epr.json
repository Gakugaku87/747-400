  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMC の空中の初期化" },
    { "do": "check", "note": "RR（BA のリバリー：RB211-524H2）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 2 },
    { "do": "wait", "note": "FMC の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 8 },
    { "do": "set", "note": "MCP 高度 FL350", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 35000 },
    { "do": "set", "note": "MCP を Mach に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "note": "窓 M.85", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 85 },
    { "do": "set", "note": "MCP 方位 098（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 98 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "switch", "note": "ALT（違えば押す）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "value": 9, "cmd": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "FMA の A/T が SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3, "timeout": 10, "level": "warn" },
    { "do": "wait", "note": "Mach が .85 の近く", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [0.844, 0.856], "timeout": 300, "level": "warn" },
    { "do": "sleep", "seconds": 240, "note": "落ち着かせる（s280 と同じ）" },
    { "do": "record_start" },
    { "do": "snapshot", "note": "巡航の EPR・3 軸・推力・燃料", "drefs": [ "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[3]", "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]", "laminar/B747/engines/display_N3[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/flightmodel/engine/ENGN_thro_use[0]", "sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0]", "sim/flightmodel/weight/m_total", "sim/flightmodel/misc/machno", "laminar/B747/engines/EPR/red_on[0]" ] },
    { "do": "check", "note": "重さは 300 t 付近", "dref": "sim/flightmodel/weight/m_total", "op": "between", "value": [296000, 302000], "level": "warn" },
    { "do": "check", "note": "表示の EPR は PMDG の長距離巡航の表の 1.55 の ±0.04（PMDG_CRZ p.35：300 t・FL350・M.850。PMDG 由来、実機資料なし）", "dref": "laminar/B747/engines/display_EPR[0]", "op": "between", "value": [1.51, 1.59] },
    { "do": "check", "note": "エンジン 4 も", "dref": "laminar/B747/engines/display_EPR[3]", "op": "between", "value": [1.51, 1.59] },
    { "do": "check", "note": "1 発の燃料流量は PMDG の 2,514 kg/h（0.698 kg/s）の ±8 %（記録）", "dref": "sim/cockpit2/engine/indicators/fuel_flow_kg_sec[0]", "op": "between", "value": [0.642, 0.754], "level": "warn" },
    { "do": "check", "note": "最大の線は表示の EPR より上", "dref": "laminar/B747/engines/display_EPR_max[0]", "op": ">", "value": 1.6 },
    { "do": "check", "note": "EPR の数字は白", "dref": "laminar/B747/engines/EPR/red_on[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "N3（HP）は X-Plane の N2：巡航で 85〜100 %", "dref": "laminar/B747/engines/display_N3[0]", "op": "between", "value": [85, 100] },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 24 },
    { "do": "shot", "name": "eicas_rr_cruise" },
    { "do": "view", "name": "forward" },
    { "do": "sleep", "seconds": 30 },
    { "do": "record_stop" }
  ]
}
