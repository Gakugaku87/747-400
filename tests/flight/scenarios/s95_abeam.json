{
  "name": "s95_abeam",
  "description": "DIRECT TO の ABEAM PTS（6-1・6-2 段 7e2）の X-Plane での確認、空中。RJAA→XAC の脚の上、XAC の 15 nm 手前、10,000 ft、250 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DIRECT XAC・KOUGA・SPENS・SAGRA を入れ、ACTIVATE と EXEC、LNAV。LEGS で DIRECT TO SAGRA：MOD の 4R に破線と ABEAM PTS>（FCOM p.1333-1334；FMSPG p.138）、押すと飛ばした XAC・KOUGA・SPENS の真横の点 XAC01・KOU02・SPE03 が SAGRA の前に入り（FMSPG p.136：場所の頭 3 文字と番号、FCOM p.1250）、4R は ABEAM PTS SELECTED、INTC CRS は消える（FMSPG p.139 の図）。EXEC で LNAV が直行の線を飛び、XAC01 を順送り。CDU と ND を撮る。最後に LEGS で緯度経度（N3442.0E13800.0）と PBD（SPENS180/10）を経路の終わりの後に入れて ERASE（段 7e3a：FCOM p.1245、p.1249-1250）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.91121, "longitude": 139.59895, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（脚の向き：真 217）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DIRECT XAC・KOUGA・SPENS・SAGRA、ACTIVATE と EXEC、LNAV" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "KOUGA", "R2", "?SEL", "SPENS", "R3", "?SEL", "SAGRA", "R4", "?SEL"] },
    { "do": "cdu", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS、現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^XAC " },
    { "do": "check", "note": "4 番目の点 SAGRA", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^SAGRA " },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "脚の上なので LNAV がすぐ engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 30 },

    { "do": "mark", "note": "DIRECT TO SAGRA：4R に ABEAM PTS>（FCOM p.1333-1334；FMSPG p.138）" },
    { "do": "cdu", "keys": ["SAGRA", "L1", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MOD RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 LEGS" },
    { "do": "check", "note": "現用点 SAGRA（XAC・KOUGA・SPENS を飛ばす）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^SAGRA " },
    { "do": "check", "note": "4R の上の破線（FCOM p.1333 の図）", "dref": "laminar/B747/fms3/Line08_L", "op": "==", "value": "              ----------" },
    { "do": "check", "note": "4R に ABEAM PTS>", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "              ABEAM PTS>" },
    { "do": "check", "note": "INTC CRS もある", "dref": "laminar/B747/fms3/Line12_S", "op": "contains", "value": "INTC CRS" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_dto_abeam_prompt" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "note": "ABEAM PTS>", "keys": ["R4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "XAC の真横の点 XAC01 が現用点（FMSPG p.136）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^XAC01 " },
    { "do": "check", "note": "KOUGA の真横 KOU02", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^KOU02 " },
    { "do": "check", "note": "SPENS の真横 SPE03", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^SPE03 " },
    { "do": "check", "note": "SAGRA と SELECTED（FMSPG p.138）", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "SAGRA           SELECTED" },
    { "do": "check", "note": "見出し ABEAM PTS", "dref": "laminar/B747/fms3/Line08_S", "op": "matches", "value": " ABEAM PTS$" },
    { "do": "check", "note": "INTC CRS は消える（FMSPG p.139 の図）", "dref": "laminar/B747/fms3/Line12_S", "op": "==", "value": "                        " },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_abeam_selected" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "EXEC：LNAV が直行の線を飛び、XAC01 を順送り" },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2 },
    { "do": "check", "note": "ND の現用点 XAC01", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "XAC01" },
    { "do": "watch", "note": "直行の線を 1.5 nm 以内で飛んで XAC01 を順送り（左へ約 45° の旋回を含む）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 1.5, "until": { "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^KOU02 " }, "timeout": 300 },
    { "do": "check", "note": "ND の現用点 KOU02", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "KOU02" },
    { "do": "watch", "note": "線の上（0.3 nm 以内）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.3, "timeout": 20 },
    { "do": "switch", "note": "ND の表示範囲 20 nm（つまみのコマンドで）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/range/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/range/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 3 },
    { "do": "view", "note": "機長の ND：直行の線の上の KOU02・SPE03 と SAGRA", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_abeam_points" },
    { "do": "view", "name": "forward" },
    { "do": "mark", "note": "自分で作る点（段 7e3a：FCOM p.1245、p.1249-1250）：緯度経度と PBD を経路の終わりの後に" },
    { "do": "cdu", "keys": ["LEGS", "N3442.0E13800.0", "L4"] },
    { "do": "check", "note": "N34E138（7 文字の名前：FCOM p.1250）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^N34E138 " },
    { "do": "cdu", "keys": ["SPENS180/10", "L5", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "SPENS の 180 度 10 nm：SPE04（XAC01、KOU02、SPE03 の次の番号：FCOM p.1250）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^SPE04 " },
    { "do": "check", "note": "MOD RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 LEGS" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_pilot_waypoints" },
    { "do": "cdu", "note": "ERASE", "keys": ["L6"] },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
