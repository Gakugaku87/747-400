{
  "name": "s149_vnav_on_approach",
  "description": "6-1/6-2 段 9e2（on approach）の X-Plane での確認。RJBB の ILS06LY（遷移 GATES）の GATES の約 8 NM 手前（035°）から 10,000 ft・250 kt で空中開始（機体を読み直す。予測の経路の少し上：経路より下から始めると FMC は上昇の段階のままで、初めの版は 4,500 ft から FL300 へ上昇した）。フラップ 5、s140 と同じ経路（RJAA→RJBB、STAR ATMUGA、ILS06LY、遷移 GATES）を ACTIVATE と EXEC、LEGS で GATES へ DIRECT TO、LNAV、PERF INIT（ZFW 200・CI 100・CRZ ALT FL300）、MCP 2,000 ft で VNAV：降下（3）の VNAV PTH。GATES（進入の最初の点）を過ぎると on approach（FCOM p.1261：`laminar/B747/fms/vnav/on_app`）。そこで IAS/MACH のノブを押すと、速度介入でも VNAV PTH のまま（降下中の VNAV SPD にならない）、A/T は SPD でノブの速さ（p.643、p.1261）。210 kt にすると、経路を降りる間はアイドルでも減速できず DRAG REQUIRED（FCOM p.1260）、MCP の 2,000 ft の水平（VNAV ALT）で 210 kt へ。もう一度押すと窓が閉じて VNAV PTH のまま。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.0301, "longitude": 134.7248, "elevation_in_meters": 3048, "heading_true": 35, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 2,000 ft（機体より下）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 2000 },
    { "do": "cmd", "note": "フラップ 1", "name": "sim/flight_controls/flaps_down" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "フラップ 5", "name": "sim/flight_controls/flaps_down" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：GATES へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "GATES", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が GATES", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "GATES" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "まだ on approach でない（GATES の手前）", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 0 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV で engage", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2, "timeout": 10 },
    { "do": "check", "note": "FMC は降下（3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3 },
    { "do": "wait", "note": "GATES（進入の最初の点）を過ぎて on approach（FCOM p.1261）", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 1, "timeout": 180 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "on approach の時", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/vnav/mode", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/path_dev", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "cmd", "note": "IAS/MACH のノブを押す（0.2 秒）", "name": "laminar/B747/button_switch/press_airspeed", "duration": 0.2 },
    { "do": "wait", "note": "速度介入", "dref": "laminar/B747/autopilot/spd_intervention", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "窓が開く", "dref": "laminar/B747/autopilot/ias_mach/window_open", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "on approach なので VNAV PTH のまま（FCOM p.643、p.1261）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "FMC は VNAV PTH（2）", "dref": "laminar/B747/fms/vnav/mode", "op": "==", "value": 2 },
    { "do": "check", "note": "FMC の A/T は SPD（3）", "dref": "laminar/B747/fms/vnav/at", "op": "==", "value": 3 },
    { "do": "check", "note": "A/T は SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "MCP は IAS", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "op": "==", "value": 0 },
    { "do": "set", "note": "MCP の速さを 210 kt に", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 210 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC の目標は 210 kt", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [209.5, 210.5] },
    { "do": "wait", "note": "経路を降りる間はアイドルでも減速できず DRAG REQUIRED（目標 +10 を超える：FCOM p.1260。初めの版は、ここで 210 kt に減速するのを待って落ちた）", "dref": "laminar/B747/fms/vnav/msg", "op": "==", "value": 2, "timeout": 60 },
    { "do": "wait", "note": "MCP の 2,000 ft で VNAV ALT の水平（BERRY・BOLAL の 4,000 ft は「以上」で、経路はそこで水平にならない：二つ目の s149 は 4,000 ft の水平を待って落ちた）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 5, "timeout": 400 },
    { "do": "wait", "note": "水平で A/T が 210 kt に", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [205, 215], "timeout": 180 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "10 秒後も 210 kt の近く", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [203, 217] },
    { "do": "check", "note": "VNAV のまま（ALT）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "in", "value": [5, 6] },
    { "do": "snapshot", "note": "介入の終わりの前", "drefs": [ "laminar/B747/fms/vnav/path_dev", "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms3/Line03_L" ] },
    { "do": "cmd", "note": "もう一度押す（0.2 秒）", "name": "laminar/B747/button_switch/press_airspeed", "duration": 0.2 },
    { "do": "wait", "note": "介入の終わり", "dref": "laminar/B747/autopilot/spd_intervention", "op": "==", "value": 0, "timeout": 5 },
    { "do": "check", "note": "窓が閉じる", "dref": "laminar/B747/autopilot/ias_mach/window_open", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "VNAV のまま（ALT か PTH）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "in", "value": [5, 6] },
    { "do": "check", "note": "on approach のまま", "dref": "laminar/B747/fms/vnav/on_app", "op": "==", "value": 1 },
    { "do": "record_stop" }
  ]
}
