{
  "name": "s133_nd_profile_des",
  "description": "6-1/6-2 段 8d3（ND の T/D・E/D と減速点）の X-Plane での確認、空中。FL350・M.84 で、AKAGI から ATMUG への大円の上、ATMUG の約 120 NM 手前（北緯 35.31・東経 136.41）から西南西へ空中開始（機体を読み直す）。s131 と同じ経路（RJAA→RJBB、DIRECT AKAGI、STAR ATMUGA、ILS06LY・遷移 GATES）を ACTIVATE と EXEC し、LEGS で ATMUG へ DIRECT TO（AKAGI と discontinuity を消す）。PERF INIT で COST INDEX 100 と CRZ ALT FL350、A/P CMD L・LNAV・ALT HOLD（巡航の相）。予測の最初の点は T/D（巡航なので T/C は無い）。機長の ND（MAP 80・160 NM と MAP CTR）に T/D・E/D の緑の丸と名前、減速点（10,000 ft の 250 kt への減速、名前なし）が経路の線の上に出ることを写真で確かめる。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.31, "longitude": 136.41, "elevation_in_meters": 10668, "heading_true": 247, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "check", "note": "<SEL>GATES", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<SEL>GATES" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cdu", "note": "PERF INIT：COST INDEX 100、CRZ ALT FL350", "keys": ["INITREF", "L6", "L3", "100", "L5", "350", "R1"] },
    { "do": "check", "note": "CRZ ALT FL350", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "FL350" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "set", "note": "MCP 高度 35,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 35000 },
    { "do": "cmd", "note": "ALT HOLD（巡航の相）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと）" },
    { "do": "check", "note": "飛行の相：巡航", "dref": "laminar/B747/autopilot/flightPhase", "op": "==", "value": 2 },
    { "do": "check", "note": "最初の点は T/D（巡航なので T/C は無い）", "dref": "laminar/B747/fms/profile/kind[0]", "op": "==", "value": 3 },
    { "do": "check", "note": "次は E/D", "dref": "laminar/B747/fms/profile/kind[1]", "op": "==", "value": 4 },
    { "do": "check", "note": "その次は減速点", "dref": "laminar/B747/fms/profile/kind[2]", "op": "==", "value": 5 },
    { "do": "snapshot", "note": "予測の点と機体の位置", "drefs": [ "laminar/B747/fms/profile/kind[0]", "laminar/B747/fms/profile/lat[0]", "laminar/B747/fms/profile/lon[0]", "laminar/B747/fms/profile/kind[1]", "laminar/B747/fms/profile/lat[1]", "laminar/B747/fms/profile/lon[1]", "laminar/B747/fms/profile/kind[2]", "laminar/B747/fms/profile/lat[2]", "laminar/B747/fms/profile/lon[2]", "laminar/B747/fms/profile/kind[3]", "laminar/B747/fms/profile/kind[4]", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "cdu", "note": "PROG（TO T/D の距離と比べる）", "keys": ["PROG"] },
    { "do": "snapshot", "note": "PROGRESS の 5R", "drefs": [ "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "set", "note": "範囲 80 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_profile_des_80" },
    { "do": "set", "note": "範囲 160 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 4 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "nd_profile_des_160" },
    { "do": "cmd", "note": "MAP CTR（EFIS の CTR を押す）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "nd_profile_des_160_ctr" },
    { "do": "cmd", "note": "CTR をもう一度押して戻す", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "set", "note": "範囲 40 NM に戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
