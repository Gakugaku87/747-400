{
  "name": "s105_afds_roll_law",
  "description": "AFDS の作り直し 6-3 段 2a（ロールの則：HDG SEL・bank limit・HDG HOLD。X-Plane の HDG のモードを使わない）の X-Plane での確認、空中。10,000 ft・約 290 kt（真）・磁方位 約 097 で空中から始め（機体を読み直す）、FMS の空中の初期化が終わるのを待つ（A/P CMD L・ALT・HDG HOLD）。bank limit を 5 にして HDG SEL で 40° 右：バンクは 5° まで（FCOM p.647）。AUTO に戻す：約 290 kt（真）では 25°（推定の TAS の表）。方位に乗ってから、今の方位で HDG SEL を押し、そのあとつまみを右へ 200° 回す（20° ずつ）：近い左 160° ではなく、回した右へ（ATA22 p.274）。旋回中に HDG HOLD（3D のボタンの X-Plane のコマンド）：翼を水平にしてからその時の方位を保つ（ATA22 p.272、p.348）。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 90, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残り（ALT HOLD、目標の速度・方位）が終わるのを待つ" },
    { "do": "check", "note": "HDG HOLD はロールの則で（X-Plane の HDG SEL ではない）", "dref": "laminar/B747/autopilot/roll_law", "op": "==", "value": 1 },
    { "do": "set", "note": "MCP 速度 250 kt（フラップ UP の最小機動速度より上）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "mark", "note": "bank limit 5（FCOM p.647）" },
    { "do": "switch", "note": "bank limit を 5", "dref": "laminar/B747/autopilot/bank_limit/sel_dial_pos", "value": 1, "cmd": "sim/autopilot/bank_limit_up", "cmd_down": "sim/autopilot/bank_limit_down" },
    { "do": "remember", "dref": "sim/flightmodel/position/mag_psi", "as": "hdg0" },
    { "do": "set", "note": "MCP 方位を 40° 右", "dref": "laminar/B747/autopilot/heading/degrees", "value": 40, "rel": "hdg0", "round": 1 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "watch", "note": "バンクは 5° まで（20 秒）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "abs": true, "max": 6.5, "timeout": 20 },
    { "do": "check", "note": "右へ回っている", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [2, 20], "rel": "hdg0" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：バンク 5°", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_bank_5" },

    { "do": "mark", "note": "AUTO（TAS で 15〜25°：推定の表）" },
    { "do": "switch", "note": "bank limit を AUTO", "dref": "laminar/B747/autopilot/bank_limit/sel_dial_pos", "value": 0, "cmd": "sim/autopilot/bank_limit_up", "cmd_down": "sim/autopilot/bank_limit_down" },
    { "do": "wait", "note": "AUTO：約 290 kt（真）でバンク 20° を超える", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 20, "timeout": 20 },
    { "do": "view", "note": "機長の PFD：AUTO の旋回", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_bank_auto" },
    { "do": "watch", "note": "バンクは 25° 前後まで（方位に乗るまで）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "abs": true, "max": 27.5, "until": { "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [37, 43], "rel": "hdg0" }, "timeout": 60 },
    { "do": "wait", "note": "翼を水平に（±3°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3], "timeout": 20 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "方位に乗る（±3°）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [37, 43], "rel": "hdg0" },

    { "do": "mark", "note": "押してから回す：回した向き（ATA22 p.274）" },
    { "do": "remember", "dref": "sim/flightmodel/position/mag_psi", "as": "hdg1" },
    { "do": "set", "note": "MCP 方位を今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 0, "rel": "hdg1", "round": 1 },
    { "do": "cmd", "note": "HDG SEL（今の方位で）", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "note": "つまみを右へ 20°", "dref": "laminar/B747/autopilot/heading/degrees", "value": 20, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 40, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 60, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 80, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 100, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 120, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 140, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 160, "rel": "hdg1", "round": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 180, "rel": "hdg1", "round": 1 },
    { "do": "set", "note": "右へ 200° まで（近い側は左 160°）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 200, "rel": "hdg1", "round": 1 },
    { "do": "wait", "note": "右へ旋回（バンク 15° 以上）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 15, "timeout": 15 },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "右へ回り続ける（左へは戻らない）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [10, 90], "rel": "hdg1" },
    { "do": "check", "note": "まだ右のバンク", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 15 },

    { "do": "mark", "note": "旋回中の HDG HOLD（ATA22 p.272、p.348）" },
    { "do": "cmd", "note": "HDG HOLD（3D のボタンは X-Plane のコマンド）", "name": "sim/autopilot/heading_hold" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の HDG HOLD", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "wait", "note": "翼を水平に（3° 未満）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3], "timeout": 20 },
    { "do": "sleep", "seconds": 5, "note": "3° 未満で 2 秒の後、その時の方位を保つ" },
    { "do": "remember", "dref": "sim/flightmodel/position/mag_psi", "as": "hdg_hold" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "方位を保つ（20 秒で ±2°）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [-2, 2], "rel": "hdg_hold" },
    { "do": "check", "note": "翼は水平（±3°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3] },
    { "do": "view", "note": "機長の PFD：HDG HOLD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_hdg_hold" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
