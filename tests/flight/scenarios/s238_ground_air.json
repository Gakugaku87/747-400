{
  "name": "s238_ground_air",
  "description": "地上空気（2026-11-04、PNEU-07：notes/ATA-36.md §11）の X-Plane での確認。成田 34L でエンジン運転中に開始。CDU の MENU → GND HANDLING → GROUND SERVICES の R3（GROUND AIR CONNECT>）で空気車をつなぎ、ENGINE BLEED を 4 つとも切り、FCOM p.184 のとおりパックを 1 つにすると、空気車だけでダクトが始動に要る 30 psi を超える（40 psi の空気車：FCOM p.183 SP.7.1 の 30 psi 以上、ATA70_80 p.549–550 の 30〜45 psi の間の推定）。R3（REMOVE>）で外すとダクトが空になる。CDU を撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "check", "note": "空気車はつながっていない", "dref": "laminar/B747/air/ground_air/connected", "op": "==", "value": 0 },
    { "do": "cdu", "note": "MENU → GND HANDLING → GROUND SERVICES", "keys": ["MENU", "R4", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "R3 は CONNECT>", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "CONNECT>" },
    { "do": "check", "note": "R3 の見出しは GROUND AIR", "dref": "laminar/B747/fms3/Line06_S", "op": "contains", "value": "GROUND AIR" },
    { "do": "cdu", "note": "R3：空気車をつなぐ", "keys": ["R3"] },
    { "do": "wait", "note": "空気車がつながる", "dref": "laminar/B747/air/ground_air/connected", "op": "==", "value": 1, "timeout": 3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "R3 は REMOVE>", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "REMOVE>" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS と CDU", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "cdu_ground_air" },

    { "do": "mark", "note": "エンジンの抽気を切る" },
    { "do": "switch", "note": "ENGINE BLEED 1 OFF", "dref": "laminar/B747/button_switch/position[77]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_1" },
    { "do": "switch", "note": "ENGINE BLEED 2 OFF", "dref": "laminar/B747/button_switch/position[78]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_2" },
    { "do": "switch", "note": "ENGINE BLEED 3 OFF", "dref": "laminar/B747/button_switch/position[79]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_3" },
    { "do": "switch", "note": "ENGINE BLEED 4 OFF", "dref": "laminar/B747/button_switch/position[80]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_4" },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "空気車だけ", "drefs": [
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_C", "laminar/B747/air/duct_pressure_R",
      "laminar/B747/air/engine1/bleed_valve_pos", "laminar/B747/air/packs_operating" ] },
    { "do": "check", "note": "3 パックのままでは空気車の出せる量いっぱいで 30 psi を切る（推定のモデル）", "dref": "laminar/B747/air/duct_pressure_C", "op": "between", "value": [20, 30] },
    { "do": "set", "note": "パック 2 OFF（始動はパック全部 OFF か 1 つ：FCOM p.184）", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0 },
    { "do": "set", "note": "パック 3 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0 },
    { "do": "sleep", "seconds": 6 },
    { "do": "check", "note": "1 パックなら空気車だけで始動に要る 30 psi 以上（FCOM p.183）", "dref": "laminar/B747/air/duct_pressure_C", "op": ">", "value": 30, "cite": "FCOM p.183" },
    { "do": "check", "note": "左のダクトも（ISLN 開）", "dref": "laminar/B747/air/duct_pressure_L", "op": ">", "value": 30 },
    { "do": "cdu", "note": "R3：空気車を外す", "keys": ["R3"] },
    { "do": "wait", "note": "空気車が外れる", "dref": "laminar/B747/air/ground_air/connected", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "ダクトが空になる", "dref": "laminar/B747/air/duct_pressure_C", "op": "<", "value": 5, "timeout": 10 },
    { "do": "switch", "note": "ENGINE BLEED 1 ON", "dref": "laminar/B747/button_switch/position[77]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_1" },
    { "do": "switch", "note": "ENGINE BLEED 2 ON", "dref": "laminar/B747/button_switch/position[78]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_2" },
    { "do": "switch", "note": "ENGINE BLEED 3 ON", "dref": "laminar/B747/button_switch/position[79]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_3" },
    { "do": "switch", "note": "ENGINE BLEED 4 ON", "dref": "laminar/B747/button_switch/position[80]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_4" },
    { "do": "set", "note": "パック 2 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 1 },
    { "do": "set", "note": "パック 3 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 1 },
    { "do": "wait", "note": "エンジンの空気が戻る", "dref": "laminar/B747/air/duct_pressure_C", "op": ">", "value": 20, "timeout": 25 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
