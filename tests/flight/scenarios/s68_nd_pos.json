{
  "name": "s68_nd_pos",
  "description": "ND の POS（5-2 段 5c-2b）の X-Plane での確認、空中。フランクフルトの VOR FKS の 11 NM 南、4,000 ft・200 kt・北向きで開始。機長の CDU の NAV RAD で VOR L に FKS 117.50、VOR R に TAU 113.35。機長の POS を入れると、MAP で IRU の位置（星）と GPS の位置が飛行機の記号に、VOR L・R の radial（緑の線、R-xxx）が FKS へは DME の距離まで印つきで、範囲（20 NM）より遠い TAU へは画面の端まで出る（FCOM p.1040、p.1145、p.1150）。STA で局の記号も出して、線が局を通るかを写真で確かめる。MAP CTR、POS を切ると消える。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 49.600000, "longitude": 8.545000, "elevation_in_meters": 1219.2, "heading_true": 0.0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 360", "dref": "laminar/B747/autopilot/heading/degrees", "value": 360 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "範囲は 20 NM（TAU は範囲の外）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 1 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "cmd", "note": "機長の CDU の NAV RAD", "name": "laminar/B747/fms1/func_key/navrad" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "117.5（FKS）を VOR L へ", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "113.35（TAU）を VOR R へ", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "wait", "note": "VOR L の識別符号 FKS", "dref": "laminar/B747/nd/vor_l_ref", "op": "==", "value": "FKS", "timeout": 30 },
    { "do": "wait", "note": "VOR R の識別符号 TAU", "dref": "laminar/B747/nd/vor_r_ref", "op": "==", "value": "TAU", "timeout": 60 },
    { "do": "sleep", "seconds": 10, "note": "X-Plane の VOR R の方位の針が TAU へ回り終わるまで" },
    { "do": "check", "note": "POS を入れる前は radial 無し", "dref": "laminar/B747/nd/capt/pos_rad_l", "op": "==", "value": 0 },
    { "do": "cmd", "note": "機長の POS", "name": "laminar/B747/nd/pos/capt/switch" },
    { "do": "cmd", "note": "機長の STA（局の記号を出す）", "name": "laminar/B747/nd/sta/capt/switch" },
    { "do": "wait", "note": "VOR L（FKS）の radial", "dref": "laminar/B747/nd/capt/pos_rad_l", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "DME の距離まで（約 6〜9 NM：20 NM で 465 px の 0.3〜0.45）", "dref": "laminar/B747/nd/capt/pos_rad_l_len", "op": "between", "value": [120, 230] },
    { "do": "check", "note": "DME の印", "dref": "laminar/B747/nd/capt/pos_rad_l_tick", "op": "==", "value": 1 },
    { "do": "check", "note": "radial の文字（FKS の南：R-1xx か R-2xx）", "dref": "laminar/B747/nd/capt/pos_rad_l_text", "op": "contains", "value": "R-" },
    { "do": "wait", "note": "VOR R（TAU）の radial（信号を受けてから）", "dref": "laminar/B747/nd/capt/pos_rad_r", "op": "==", "value": 1, "timeout": 30 },
    { "do": "check", "note": "TAU は範囲（20 NM）より遠い：画面の端（範囲の弧 465 px）まで", "dref": "laminar/B747/nd/capt/pos_rad_r_len", "op": ">", "value": 460 },
    { "do": "check", "note": "TAU は DME の印が画面の外なので出さない", "dref": "laminar/B747/nd/capt/pos_rad_r_tick", "op": "==", "value": 0 },
    { "do": "check", "note": "IRU L の位置", "dref": "laminar/B747/nd/capt/pos_iru[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "IRU R の位置", "dref": "laminar/B747/nd/capt/pos_iru[2]", "op": "==", "value": 1 },
    { "do": "wait", "note": "GPS の位置（GPS の初回測位の後）", "dref": "laminar/B747/nd/capt/pos_gps", "op": "==", "value": 1, "timeout": 90 },
    { "do": "snapshot", "note": "radial", "drefs": ["laminar/B747/nd/capt/pos_rad_l_brg", "laminar/B747/nd/capt/pos_rad_l_len", "laminar/B747/nd/capt/pos_rad_l_text", "laminar/B747/nd/capt/pos_rad_l_tside", "laminar/B747/nd/capt/pos_rad_r_brg", "laminar/B747/nd/capt/pos_rad_r_len", "laminar/B747/nd/capt/pos_rad_r_text", "sim/cockpit2/radios/indicators/nav_dme_distance_nm[2]"] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_pos_map" },
    { "do": "cmd", "note": "機長の CTR（MAP CTR）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "MAP CTR でも radial", "dref": "laminar/B747/nd/capt/pos_rad_l", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_pos_map_ctr" },
    { "do": "cmd", "note": "CTR を戻す", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "cmd", "note": "機長の POS を切る", "name": "laminar/B747/nd/pos/capt/switch" },
    { "do": "cmd", "note": "STA を切る", "name": "laminar/B747/nd/sta/capt/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "radial が消える", "dref": "laminar/B747/nd/capt/pos_rad_l", "op": "==", "value": 0 },
    { "do": "check", "note": "GPS の記号も", "dref": "laminar/B747/nd/capt/pos_gps", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
