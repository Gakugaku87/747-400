{
  "name": "s102_afds_app",
  "description": "AFDS の作り直し 6-3 段 1d（進入のモード：LOC・G/S・APP）の X-Plane での確認、空中。RJAA 34L の進入路の G/S のアンテナから 20 NM、3,000 ft・210 kt で開始（機体を読み直す）。A/P CMD L・ALT HOLD・HDG SEL 330。ILS を同調する前に（信号が無いので捕まえない）APP で LOC と G/S の arm（ILS が無くても arm：前は RW/ILS CRS ERROR）、2 回目で disarm、LOC だけの arm と 2 回目、APP の arm を LNAV の arm が解き、APP が LNAV の arm を解く（ATA22 p.343、p.354、p.357；FCOM p.651）。CDU で ILS（111.90/337）を同調すると LOC を捕まえ（捕捉の判定は段 2 まで前の作り：両受信機の信号）、MCP の方位が進入のコース 337 になる（ATA22 p.290。前は APP を押した時）。G/S の前の HDG SEL で APP が外れる（FCOM p.652）。APP をもう一度押して LOC、G/S の下から水平に入って G/S を捕まえる。LOC と G/S の後は HDG SEL も V/S も受け付けない（表 p.351、p.335）。TO/GA で LOC と G/S が終わる。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.458372, "longitude": 140.596090, "elevation_in_meters": 914.4, "heading_true": 329.6, "speed_in_meters_per_second": 108.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 330（コース 337 の 7° 左）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 330 },
    { "do": "set", "note": "MCP 速度 210 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 210 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 2 },

    { "do": "mark", "note": "ILS を同調する前：APP と LOC の arm と disarm" },
    { "do": "set", "note": "NAV1 を局の無い 108.10 に（前のシナリオの ILS の同調が残る）", "dref": "sim/cockpit/radios/nav1_freq_hz", "value": 10810 },
    { "do": "set", "note": "NAV2 も", "dref": "sim/cockpit/radios/nav2_freq_hz", "value": 10810 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LOC の信号が無い（NAV1）", "dref": "sim/cockpit2/radios/indicators/nav1_display_horizontal", "op": "==", "value": 0 },
    { "do": "set", "note": "前の同調の印（使わなくなった）を 0 に", "dref": "laminar/B747/autopilot/ils_dots", "value": 0 },
    { "do": "set", "note": "RW/ILS CRS ERROR の旗を戻す", "dref": "laminar/B747/fms/notification[40]", "value": 0 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "APP（approach_mode 1）", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "LOC は arm（信号が無いので捕まえない）", "dref": "laminar/B747/autopilot/nav_status", "op": "==", "value": 1 },
    { "do": "check", "note": "G/S は arm", "dref": "laminar/B747/autopilot/glideslope_status", "op": "==", "value": 1 },
    { "do": "check", "note": "FMA のロールの arm は LOC", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "FMA のピッチの arm は G/S", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "ILS が無くても arm（前は RW/ILS CRS ERROR で arm しなかった）", "dref": "laminar/B747/fms/notification[40]", "op": "==", "value": 0 },
    { "do": "check", "note": "MCP の方位はまだ 330（前は APP でコースにした）", "dref": "laminar/B747/autopilot/heading/degrees", "op": "==", "value": 330 },
    { "do": "cmd", "note": "APP の 2 回目", "name": "laminar/B747/autopilot/approach" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "disarm", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "FMA の arm も消える", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 0 },
    { "do": "cmd", "note": "LOC", "name": "laminar/B747/autopilot/button_switch/loc_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LOC だけ（approach_mode -1）", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": -1 },
    { "do": "check", "note": "G/S は arm しない", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 0 },
    { "do": "cmd", "note": "LOC の 2 回目", "name": "laminar/B747/autopilot/button_switch/loc_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "disarm（前は 2 回目で外れなかった）", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": 0 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV の arm で APP が外れる", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "LNAV は arm", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 2 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "APP で LNAV の arm が外れる（ATA22 p.354）", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 0 },
    { "do": "check", "note": "APP（LOC の arm）", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 3 },

    { "do": "mark", "note": "ILS の同調で LOC を捕まえる、MCP の方位がコースに" },
    { "do": "set", "note": "MCP 方位 007（ビームの左から 30° で入る：6-3 段 2b の捕捉は対地速度・進入角・偏位で決まる）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "sleep", "seconds": 15, "note": "007 へ回る" },
    { "do": "cmd", "note": "APP の 2 回目（同調の間は arm しない：受信機が切り替わる一瞬の偏位を、前の簡単な検出が捕捉と取るので）", "name": "laminar/B747/autopilot/approach" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "snapshot", "note": "同調の後", "drefs": [ "sim/cockpit2/radios/indicators/nav1_display_horizontal", "sim/cockpit2/radios/indicators/nav1_display_vertical", "sim/cockpit2/radios/indicators/hsi_vdef_dots_pilot", "sim/cockpit2/radios/indicators/nav1_flag_glideslope" ] },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "LOC を捕まえる（FMA のロール 3）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 120 },
    { "do": "check", "note": "MCP の方位がコース 337 に（ATA22 p.290）", "dref": "laminar/B747/autopilot/heading/degrees", "op": "==", "value": 337 },
    { "do": "check", "note": "G/S はまだ arm（G/S のかなり下）", "dref": "laminar/B747/autopilot/glideslope_status", "op": "==", "value": 1 },
    { "do": "wait", "note": "LOC に乗る（0.3 ドット以内）", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "op": "between", "value": [-0.3, 0.3], "timeout": 120 },
    { "do": "check", "note": "G/S はまだ arm", "dref": "laminar/B747/autopilot/glideslope_status", "op": "==", "value": 1 },
    { "do": "cmd", "note": "G/S の前の HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "HDG SEL（表 p.351：G/S の前なら LOC から）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "APP が外れる（FCOM p.652）", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "G/S の arm も消える", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 0 },
    { "do": "cmd", "note": "APP をもう一度", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "LOC をまた捕まえる", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 10 },

    { "do": "mark", "note": "G/S の捕捉" },
    { "do": "wait", "note": "G/S を捕まえる（FMA のピッチ 2）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 240 },
    { "do": "check", "note": "G/S の状態 2", "dref": "laminar/B747/autopilot/glideslope_status", "op": "==", "value": 2 },
    { "do": "check", "note": "ピッチの arm は無し", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：LOC と G/S", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_loc_gs" },
    { "do": "cmd", "note": "LOC と G/S の後の HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LOC のまま（表 p.351）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3 },
    { "do": "cmd", "note": "LOC と G/S の後の V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "G/S のまま（表 p.335）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2 },

    { "do": "mark", "note": "TO/GA で LOC と G/S が終わる（FCOM p.651-652）" },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMA のロールは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "FMA のピッチは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "進入のモードは消える", "dref": "laminar/B747/autopilot/approach_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "LOC の状態 0", "dref": "laminar/B747/autopilot/nav_status", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の PFD：TO/GA", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_toga" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
