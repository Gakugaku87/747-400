{
  "name": "s10_overspeed",
  "description": "EEC のオーバースピード保護と >ENG RPM LIM（2-3 段 2）の X-Plane での確認。10,000 ft・250 kt で空中から始め、海面 50 ℃ の高温にして A/P の FLCH で 250 kt を保ちながら全推力にする。通常モードでは最大 EPR で止まり RPM LIM は出ない。EEC MODE を 4 発とも ALTN にすると角点の EPR まで上がり（オーバーブースト、FCOM p.877）、N1・N2 が赤線に近づけば EEC が抑える（FCOM p.878、p.901）。N1・N2 の表示が赤（P&W は 111.4 % 超え）にならないことを見る。機体を読み直す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 128 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 20, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "気温の変更をすぐに反映", "dref": "sim/weather/region/update_immediately", "value": 1 },
    { "do": "set", "note": "海面 50 ℃（高温）", "dref": "sim/weather/region/sealevel_temperature_c", "value": 50 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 30,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 30000 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "FLCH（ピッチで 250 kt を保つ）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/engines/type",
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/weather/aircraft/temperature_ambient_deg_c", "sim/cockpit2/temperature/outside_air_LE_temp_degc",
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode",
      "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/TRA[0]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]" ] },
    { "do": "check", "note": "高温になった（9,000 ft 付近で ISA+13 ℃ 超え）", "dref": "sim/weather/aircraft/temperature_ambient_deg_c", "op": ">", "value": 10 },

    { "do": "mark", "note": "通常モードで全推力" },
    { "do": "cmd", "note": "A/T を切る（FLCH で THR REF に入っている）", "name": "laminar/B747/autopilot/button_switch/autothrottle_disco_L" },
    { "do": "wait", "note": "A/T が切れた", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 0, "timeout": 5 },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "レバー 1 が最前方", "dref": "laminar/B747/engine/throttle[0]", "op": ">", "value": 0.98, "timeout": 10 },
    { "do": "sleep", "seconds": 25 },
    { "do": "snapshot", "note": "通常モード、全推力", "drefs": [
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/temperature/outside_air_LE_temp_degc", "laminar/B747/engine/throttle[0]",
      "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/TRA[0]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]",
      "laminar/B747/engines/display_N1[3]", "laminar/B747/engines/display_N2[3]" ] },
    { "do": "check", "note": "最大 EPR の近くで止まる（FCOM p.876）", "dref": "laminar/B747/engines/display_EPR[0]", "op": "between", "value": [1.4, 1.6] },
    { "do": "check", "note": "ENG 1 RPM LIM は出ない", "dref": "laminar/B747/CAS/advisory_status[134]", "op": "==", "value": 0 },
    { "do": "check", "note": "ENG 4 RPM LIM は出ない", "dref": "laminar/B747/CAS/advisory_status[137]", "op": "==", "value": 0 },
    { "do": "check", "note": "N2 は赤線（111.4 %）の下", "dref": "laminar/B747/engines/display_N2[0]", "op": "<", "value": 111.4 },

    { "do": "mark", "note": "EEC MODE 4 発 ALTN（オーバーブースト）" },
    { "do": "switch", "note": "EEC MODE 1 を ALTN", "dref": "laminar/B747/button_switch/position[7]", "value": 0, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_1" },
    { "do": "switch", "note": "EEC MODE 2 を ALTN", "dref": "laminar/B747/button_switch/position[8]", "value": 0, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_2" },
    { "do": "switch", "note": "EEC MODE 3 を ALTN", "dref": "laminar/B747/button_switch/position[9]", "value": 0, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_3" },
    { "do": "switch", "note": "EEC MODE 4 を ALTN", "dref": "laminar/B747/button_switch/position[10]", "value": 0, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_4" },
    { "do": "wait", "note": ">ENG 1 LIM PROT（P&W：最大 EPR に近い）", "dref": "laminar/B747/CAS/caution_status[75]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "ALTN 5 秒", "drefs": [
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/temperature/outside_air_LE_temp_degc",
      "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/TRA[0]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]", "laminar/B747/CAS/advisory_status[134]" ] },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "ALTN 15 秒", "drefs": [
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/temperature/outside_air_LE_temp_degc",
      "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/TRA[0]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]", "laminar/B747/CAS/advisory_status[134]" ] },
    { "do": "sleep", "seconds": 15 },
    { "do": "snapshot", "note": "ALTN 30 秒", "drefs": [
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/temperature/outside_air_LE_temp_degc",
      "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/TRA[0]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]",
      "laminar/B747/engines/display_N1[3]", "laminar/B747/engines/display_N2[3]",
      "laminar/B747/CAS/advisory_status[134]", "laminar/B747/CAS/advisory_status[137]" ] },
    { "do": "check", "note": "N1 は赤線（111.4 %）の下", "dref": "laminar/B747/engines/display_N1[0]", "op": "<", "value": 111.4 },
    { "do": "check", "note": "N2 は赤線の下（表示は整数、112 で赤）", "dref": "laminar/B747/engines/display_N2[0]", "op": "<", "value": 111.4 },
    { "do": "check", "note": "ENG 4 も N2 は赤線の下", "dref": "laminar/B747/engines/display_N2[3]", "op": "<", "value": 111.4 },
    { "do": "cas", "note": "ALTN・全推力" },

    { "do": "mark", "note": "戻す" },
    { "do": "set", "note": "スラスト・レバーを idle", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "switch", "note": "EEC MODE 1 を NORM", "dref": "laminar/B747/button_switch/position[7]", "value": 1, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_1" },
    { "do": "switch", "note": "EEC MODE 2 を NORM", "dref": "laminar/B747/button_switch/position[8]", "value": 1, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_2" },
    { "do": "switch", "note": "EEC MODE 3 を NORM", "dref": "laminar/B747/button_switch/position[9]", "value": 1, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_3" },
    { "do": "switch", "note": "EEC MODE 4 を NORM", "dref": "laminar/B747/button_switch/position[10]", "value": 1, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_4" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "RPM LIM は消えている", "dref": "laminar/B747/CAS/advisory_status[134]", "op": "==", "value": 0 },
    { "do": "check", "note": "LIM PROT は消えている", "dref": "laminar/B747/CAS/caution_status[75]", "op": "==", "value": 0 },
    { "do": "record_stop" }
  ]
}
