{
  "name": "s223_flap_expanded",
  "description": "FCTL-12（フラップの拡大表示と代替表示）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始め、レバー 5 で全部 5 にする。右内側の後縁の位置センサーを故障にすると拡大表示になり、その帯が琥珀の X、STATUS FLAP SYS MONITOR、前縁の箱は全部緑、レバーの線と数字は緑（全部がレバーの位置）。外側の前縁の空気圧駆動を故障にしてレバー 1：外側の前縁は 30 秒動かず電動になり、拡大表示で外側の箱が斜線（移動中）、線と数字はマゼンタ。電動も故障にすると 25 秒で止まり（FLAPS DRIVE）、外側の箱が琥珀。ALTN ARM で代替表示（線と数字を出さず、外側の帯の外に目盛り）。ALTN GEAR EXTEND で脚の拡大表示も出し、重ならないことを写真で見る。最後に内側の後縁群の左を固着（非対称）にしてレバー 10：内側の帯 2 本が琥珀。期待値は FCOM p.937-938、ATA27 p.320-322、p.398-400（notes/ATA-27.md §19）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "set", "note": "レバー 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.333333 },
    { "do": "wait", "note": "全部 5：線と数字が緑", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 0, "timeout": 40 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "通常の表示（1）", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 1 },

    { "do": "mark", "note": "右内側の後縁の位置センサーの故障" },
    { "do": "set", "note": "R IB の位置センサー", "dref": "laminar/B747/flt_ctrls/fail/te_sensor[2]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "拡大表示（2）：位置データが無い（ATA27 p.320）", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 2 },
    { "do": "check", "note": "R IB の帯は琥珀の X", "dref": "laminar/B747/flt_ctrls/flaps/te_tape[2]", "op": "==", "value": 2 },
    { "do": "check", "note": "L OB の帯は白", "dref": "laminar/B747/flt_ctrls/flaps/te_tape[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "STATUS FLAP SYS MONITOR", "dref": "laminar/B747/CAS/status_status[99]", "op": "==", "value": 1 },
    { "do": "check", "note": "前縁の箱：L OB は緑（展開）", "dref": "laminar/B747/flt_ctrls/flaps/le_box[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "R IB の箱も緑", "dref": "laminar/B747/flt_ctrls/flaps/le_box[3]", "op": "==", "value": 2 },
    { "do": "check", "note": "全部レバーの位置：線と数字は緑", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 0 },
    { "do": "view", "note": "主 EICAS のフラップ", "the": -24, "psi": 32.6, "fov": 12 },
    { "do": "shot", "name": "flaps_expanded_sensor_x" },
    { "do": "set", "note": "センサーを戻す", "dref": "laminar/B747/flt_ctrls/fail/te_sensor[2]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "通常の表示に戻る", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "check", "note": "FLAP SYS MONITOR は消える", "dref": "laminar/B747/CAS/status_status[99]", "op": "==", "value": 0 },

    { "do": "mark", "note": "外側の前縁の空気圧駆動の故障、レバー 1" },
    { "do": "set", "note": "外側の前縁の空気圧駆動", "dref": "laminar/B747/flt_ctrls/fail/le_primary[2]", "value": 1 },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.166667 },
    { "do": "wait", "note": "30 秒動かず電動へ：拡大表示（FCOM p.953）", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 2, "timeout": 45 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "外側の前縁は電動", "dref": "laminar/B747/flt_ctrls/fcu/le_mode[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "L OB の箱は斜線（移動中）", "dref": "laminar/B747/flt_ctrls/flaps/le_box[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "R OB の箱も斜線", "dref": "laminar/B747/flt_ctrls/flaps/le_box[5]", "op": "==", "value": 1 },
    { "do": "check", "note": "L IB の箱は緑（group A はレバー 1 で出たまま）", "dref": "laminar/B747/flt_ctrls/flaps/le_box[2]", "op": "==", "value": 2 },
    { "do": "check", "note": "移動中：線と数字はマゼンタ", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 1 },
    { "do": "shot", "name": "flaps_expanded_le_electric" },
    { "do": "set", "note": "外側の前縁の電動駆動も故障", "dref": "laminar/B747/flt_ctrls/fail/le_secondary[2]", "value": 1 },
    { "do": "wait", "note": "25 秒で止まる：外側の箱が琥珀の斜線（駆動不能：FCOM p.937）", "dref": "laminar/B747/flt_ctrls/flaps/le_box[0]", "op": "==", "value": 4, "timeout": 35 },
    { "do": "check", "note": "R OB も琥珀の斜線", "dref": "laminar/B747/flt_ctrls/flaps/le_box[5]", "op": "==", "value": 4 },
    { "do": "check", "note": "FLAPS DRIVE", "dref": "laminar/B747/CAS/caution_status[29]", "op": "==", "value": 1 },
    { "do": "shot", "name": "flaps_expanded_le_amber" },

    { "do": "mark", "note": "ALTN FLAPS ARM：代替表示" },
    { "do": "switch", "note": "ALTN FLAPS ARM", "dref": "laminar/B747/button_switch/position[0]", "value": 1, "cmd": "laminar/B747/button_switch/altn_flap" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "代替表示（レバーの線と数字なし、目盛り）", "dref": "laminar/B747/flt_ctrls/flaps/altn_display", "op": "==", "value": 1 },
    { "do": "check", "note": "拡大表示", "dref": "laminar/B747/flt_ctrls/flaps/EICAS1_display_status", "op": "==", "value": 2 },
    { "do": "shot", "name": "flaps_alternate" },
    { "do": "cmd", "note": "ALTN GEAR EXTEND WING（脚の拡大表示を出す）", "name": "laminar/B747/button_switch/altn_wing_gear_extend" },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "脚の表示", "drefs": [ "laminar/B747/gear/EICAS1_display_status" ] },
    { "do": "view", "note": "脚とフラップ", "the": -22.5, "psi": 32.6, "fov": 14 },
    { "do": "shot", "name": "flaps_and_gear_expanded" },
    { "do": "switch", "note": "ALTN FLAPS ARM を戻す", "dref": "laminar/B747/button_switch/position[0]", "value": 0, "cmd": "laminar/B747/button_switch/altn_flap" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "代替表示が終わる", "dref": "laminar/B747/flt_ctrls/flaps/altn_display", "op": "==", "value": 0 },

    { "do": "mark", "note": "内側の後縁群の左を固着（非対称）、レバー 10" },
    { "do": "set", "note": "前縁の故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/le_primary[2]", "value": 0 },
    { "do": "set", "note": "電動も", "dref": "laminar/B747/flt_ctrls/fail/le_secondary[2]", "value": 0 },
    { "do": "set", "note": "内側の後縁群の左の固着", "dref": "laminar/B747/flt_ctrls/fail/te_stuck[0]", "value": 1 },
    { "do": "set", "note": "レバー 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "wait", "note": "非対称で内側群が止まる：L IB の帯が琥珀", "dref": "laminar/B747/flt_ctrls/flaps/te_tape[1]", "op": "==", "value": 1, "timeout": 20 },
    { "do": "check", "note": "R IB の帯も琥珀", "dref": "laminar/B747/flt_ctrls/flaps/te_tape[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "外側の帯は白", "dref": "laminar/B747/flt_ctrls/flaps/te_tape[0]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "view", "note": "主 EICAS のフラップ", "the": -24, "psi": 32.6, "fov": 12 },
    { "do": "shot", "name": "flaps_expanded_te_amber" },
    { "do": "set", "note": "固着を戻す", "dref": "laminar/B747/flt_ctrls/fail/te_stuck[0]", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
