{
  "name": "s140_vnav_descent",
  "description": "6-1/6-2 段 9c（AFDS が FMC の VNAV で飛ぶ）の X-Plane での確認、降下。FL300・約 290 kt で、ATMUG の約 30 NM 西（STAR ATMUGA の入り口の側：T/D の手前）から東へ空中開始（機体を読み直す。前は s138 と同じ ATMUG の東から西へで、ATMUG の上で SAKVA へ 150° 折り返し、予測の点と点の大円に無い旋回の道のりで経路の 850 ft 下に出た）。s131 と同じ経路を ACTIVATE と EXEC、LEGS で ATMUG へ DIRECT TO、LNAV、PERF INIT で ZFW 200・COST INDEX 100・CRZ ALT FL300、MCP 10,000 ft で VNAV：巡航の VNAV PTH（6）、T/D で FMC の段階が降下（3）になったら、A/T は IDLE（2）か SPD（3）か HOLD（1）、降下率がつき、3 分後も経路からの偏差が ±400 ft の中（ND の経路の指針：FCOM p.1149 の目盛り）。ND の after_tod と flight_path_error、E/D までの距離（`laminar/B747/fms/vnav/dist`）と LEGS の有効な脚も見る。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 133.52, "elevation_in_meters": 9144, "heading_true": 97, "speed_in_meters_per_second": 225 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "性能のデータが揃う", "dref": "laminar/B747/fms/vnav/perf", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage（巡航か降下）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "check", "note": "vnav_state は 2", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "wait", "note": "降下（T/D：FMC の段階 3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 240 },
    { "do": "snapshot", "note": "降下の始め", "drefs": [ "laminar/B747/fms/vnav/mode", "laminar/B747/fms/vnav/at", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/fms/vnav/alt", "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/path_dev", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/vnav/after_tod", "laminar/B747/autopilot/dist/flight_path_error", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_is_mach", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "ND の経路の指針（after_tod）", "dref": "laminar/B747/autopilot/vnav/after_tod", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 60, "note": "1 分" },
    { "do": "snapshot", "note": "1 分後", "drefs": [ "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/at", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/engines/ref_thr_limit_mode" ] },
    { "do": "check", "note": "降りている", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -500 },
    { "do": "cdu", "note": "LEGS（有効な脚を見る）", "keys": ["LEGS"] },
    { "do": "snapshot", "note": "LEGS の最初の脚と E/D までの距離", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/vnav/dist", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude" ] },
    { "do": "sleep", "seconds": 120, "note": "さらに 2 分" },
    { "do": "snapshot", "note": "LEGS の最初の脚と E/D までの距離（2 分後）", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/vnav/dist", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude" ] },
    { "do": "snapshot", "note": "3 分後", "drefs": [ "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/at", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/dist/flight_path_error", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "check", "note": "VNAV PTH のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "経路からの偏差は ±400 ft の中", "dref": "laminar/B747/fms/vnav/path_dev", "op": "between", "value": [-400, 400] },
    { "do": "check", "note": "A/T は HOLD・IDLE・SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "between", "value": [1, 3] },
    { "do": "record_stop" }
  ]
}
