{
  "name": "s157_eo_driftdown",
  "description": "6-1/6-2 段 9h4b（E/O の driftdown、LEVEL AT、E/O の予測）の X-Plane での確認。空中、FL370 の巡航（機体を読み直す）、RJAA→RJBB の経路、PERF INIT で ZFW 200・CRZ ALT FL370・COST INDEX 100、VNAV PTH。FUEL CONTROL 2 を CUTOFF にしてエンジン 2 を止め、VNAV の CRZ のページの ENG OUT>（5R）で MOD E/O LRC D/D。MCP 高度を E/O の最大高度の下（FL300）にして EXEC（FCOM p.1268 の条件 1）：CRZ ALT は E/O の最大高度、推力制限は CON、題は ACT E/O LRC D/D、laminar/B747/fms/vnav/dd、VNAV SPD と A/T の THR（目標に達しても HOLD にならない）、降下率は最小 300 fpm、目標は CRZ ALT での E/O LRC の Mach。CRZ のページの 2R は AT（水平になる時刻と距離）、PROGRESS は E/O SPD と LEVEL AT（FCOM p.1353、p.1372–1373、FMSPG p.3.4-19）。E/O の最大高度で水平（VNAV PTH、A/T SPD、ACT E/O LRC CRZ、LEVEL AT なし）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 11278, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "snapshot", "note": "空中開始の後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/misc/machno", "sim/flightmodel/weight/m_total", "sim/flightmodel/weight/m_fuel_total", "sim/cockpit2/temperature/outside_air_temp_degc" ] },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL370、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "370", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 37,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 37000 },
    { "do": "set", "note": "MCP 高度 37,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 37000 },
    { "do": "sleep", "seconds": 5 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH（巡航）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 60 },
    { "do": "sleep", "seconds": 10 },

    { "do": "mark", "note": "エンジン 2 を止める" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "wait", "note": "エンジン 2 の inop", "dref": "laminar/B747/engines/inop[1]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "1 発停止で A/T は入ったまま（FCTM p.4.11）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "!=", "value": 0 },

    { "do": "mark", "note": "ENG OUT>（CRZ のページ）、MCP 高度 FL300、EXEC（FCOM p.1268 の条件 1）" },
    { "do": "cdu", "note": "VNAV（CRZ のページ）", "keys": ["VNAV"] },
    { "do": "check", "note": "ACT ... CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CRZ" },
    { "do": "cdu", "note": "ENG OUT>（5R）", "keys": ["R5"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "MOD の E/O CRZ のページ", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line09_L", "sim/flightmodel/weight/m_total", "sim/flightmodel/misc/machno" ] },
    { "do": "check", "note": "MOD E/O LRC D/D（FL370 は E/O の最大高度の上）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD E/O LRC D/D" },
    { "do": "set", "note": "MCP 高度 FL300（E/O の最大高度の下）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 30000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "wait", "note": "driftdown（laminar/B747/fms/vnav/dd）", "dref": "laminar/B747/fms/vnav/dd", "op": "==", "value": 1, "timeout": 5 },
    { "do": "remember", "dref": "laminar/B747/autopilot/dist/cruise_alt", "as": "crz" },
    { "do": "check", "note": "CRZ ALT は E/O の最大高度（FL370 の下）", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "<", "value": 36000 },
    { "do": "check", "note": "推力制限は CON（FCOM p.1268）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 40 },
    { "do": "check", "note": "ACT E/O LRC D/D", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT E/O LRC D/D" },
    { "do": "check", "note": "FMC の降下率の目標は 300 fpm", "dref": "laminar/B747/fms/vnav/vs", "op": "==", "value": -300 },
    { "do": "wait", "note": "VNAV SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 15 },
    { "do": "wait", "note": "A/T の THR（CON まで進める：FCOM p.1268）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "remember", "dref": "laminar/B747/fms/vnav/mach", "as": "ddmach" },
    { "do": "snapshot", "note": "driftdown の始め", "drefs": [ "laminar/B747/autopilot/dist/cruise_alt", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/at", "laminar/B747/fms/vnav/mode", "laminar/B747/fms/vnav/alt", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[2]", "sim/cockpit2/engine/actuators/throttle_ratio[0]", "laminar/B747/autopilot/FMA/autothrottle_mode", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/misc/machno" ] },
    { "do": "check", "note": "目標は Mach（CRZ ALT での E/O LRC：CRZ のページの LRC SPD）", "dref": "laminar/B747/fms/vnav/mach_mode", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "2R の見出しは AT（水平になる時刻と距離：FCOM p.1353）", "dref": "laminar/B747/fms3/Line04_S", "op": "matches", "value": "AT$" },
    { "do": "check", "note": "2R は時刻と距離", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "[0-9]{4}z/ *[0-9]+NM$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_dd_crz" },

    { "do": "mark", "note": "driftdown の降下" },
    { "do": "wait", "note": "降り始める", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -200, "timeout": 120 },
    { "do": "sleep", "seconds": 60 },
    { "do": "snapshot", "note": "driftdown の 1 分後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/misc/machno", "laminar/B747/fms/vnav/mach", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[2]", "sim/cockpit2/engine/actuators/throttle_ratio[0]" ] },
    { "do": "check", "note": "A/T は THR のまま（driftdown では目標の降下率で HOLD にならない）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "降りている（最小 300 fpm：揺れを見込んで 200）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -200 },
    { "do": "check", "note": "Mach は目標の近く", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [-0.02, 0.02], "rel": "ddmach" },
    { "do": "cdu", "note": "PROGRESS", "keys": ["PROG"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "PROGRESS", "drefs": [ "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L", "laminar/B747/fms3/Line09_L" ] },
    { "do": "check", "note": "5L E/O SPD、5R LEVEL AT（FCOM p.1372–1373、FMSPG p.3.4-19）", "dref": "laminar/B747/fms3/Line10_S", "op": "matches", "value": "^ E/O SPD +LEVEL AT$" },
    { "do": "check", "note": "LEVEL AT の時刻と距離", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "[0-9]{4}z/[0-9]+NM$" },
    { "do": "shot", "name": "cdu_progress_level_at" },
    { "do": "cdu", "note": "VNAV（CRZ のページ）", "keys": ["VNAV"] },
    { "do": "sleep", "seconds": 180, "note": "初めの版（2026-11-01 1:40）はここで −130 fpm まで浅くなった（A/T がレバーを全開の帯まで進め、戻るのに 8 分）" },
    { "do": "snapshot", "note": "driftdown の 5 分後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/misc/machno", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR_max[0]", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/TRA[0]" ] },
    { "do": "check", "note": "最小 300 fpm を保つ（揺れを見込んで 230）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-900, -230] },
    { "do": "check", "note": "A/T は THR のまま", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 4 },

    { "do": "mark", "note": "E/O の最大高度で水平" },
    { "do": "wait", "note": "VNAV PTH（CRZ ALT を捉える）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 1200 },
    { "do": "sleep", "seconds": 15 },
    { "do": "snapshot", "note": "水平の後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/misc/machno", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/dd", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/thrlim/code" ] },
    { "do": "check", "note": "CRZ ALT で水平", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [-150, 150], "rel": "crz" },
    { "do": "check", "note": "driftdown は終わる", "dref": "laminar/B747/fms/vnav/dd", "op": "==", "value": 0 },
    { "do": "check", "note": "ACT E/O LRC CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT E/O LRC CRZ" },
    { "do": "check", "note": "推力制限は CON のまま（FCOM p.1268：E/O の巡航）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 40 },
    { "do": "check", "note": "A/T は SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "shot", "name": "cdu_eo_lrc_crz" },
    { "do": "cdu", "note": "PROGRESS", "keys": ["PROG"] },
    { "do": "sleep", "seconds": 12, "note": "予測の更新（10 秒ごと）を待つ" },
    { "do": "check", "note": "LEVEL AT は消える", "dref": "laminar/B747/fms3/Line10_S", "op": "matches", "value": "^(?!.*LEVEL AT)" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
