{
  "name": "s20_oxygen",
  "description": "酸素（3-3）の X-Plane での確認、巡航。FL350 の空中で開始し、STATUS ページの乗員・乗客の酸素圧（満充填 1850 psi を前方貨物室の温度で補正）と X-Plane の酸素系統の上書きを見る。PASS OXYGEN を ON にすると PASS OXYGEN ON とサインの強制点灯（選択器 OFF でも：FCOM p.437、p.502）、60 秒後に STATUS（ATA30_32_35_36 p.376）、RESET で消えること。THERAPEUTIC OXYGEN の ON で THERAP OXYGEN ON、RESET で消えること。最後に X-Plane の急減圧の故障で客室が 14,000 ft を超えると乗客酸素と治療用酸素が自動で作動し（FCOM p.456、p.513）、12,000 ft より上では RESET が効かないこと、乗員マスクのコマンドで X-Plane の pilot_felt_altitude_ft が 10,000 ft になること（推定）を見る。期待値は notes/ATA-35.md。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 254 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "wait", "note": "水平になる（A/P の ALT HOLD）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 180 },
    { "do": "snapshot", "note": "水平になったところ", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/cockpit2/gauges/indicators/altitude_ft_pilot",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft",
      "laminar/B747/oxygen/crew_press_psi", "laminar/B747/oxygen/pass_press_psi", "laminar/B747/air/temp/cargo[0]",
      "sim/operation/override/override_oxygen_system", "sim/cockpit2/oxygen/indicators/o2_bottle_pressure_psi",
      "laminar/B747/oxygen/pass_oxy_on", "laminar/B747/oxygen/therap_oxy_on",
      "laminar/B747/safety/no_smoking/sel_dial_pos", "laminar/B747/safety/seat_belts/sel_dial_pos",
      "sim/cockpit2/switches/no_smoking", "sim/cockpit2/switches/fasten_seat_belts" ] },
    { "do": "cas", "note": "開始" },
    { "do": "check", "note": "乗員の酸素圧（満充填 1850 psi を前方貨物室の温度で補正：ATA30_32_35_36 p.316）", "dref": "laminar/B747/oxygen/crew_press_psi", "op": "between", "value": [1600, 1950] },
    { "do": "check", "note": "乗客の酸素圧", "dref": "laminar/B747/oxygen/pass_press_psi", "op": "between", "value": [1600, 1950] },
    { "do": "check", "note": "X-Plane の酸素系統を上書き", "dref": "sim/operation/override/override_oxygen_system", "op": "==", "value": 1 },
    { "do": "check", "note": "マスクなし：X-Plane の pilot_felt_altitude_ft は客室高度（巡航の客室は 8,000 ft 以下）", "dref": "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft", "op": "between", "value": [0, 8100] },
    { "do": "check", "note": "乗客酸素は止まっている", "dref": "laminar/B747/oxygen/pass_oxy_on", "op": "==", "value": 0 },
    { "do": "check", "note": "PASS OXYGEN ON なし", "dref": "laminar/B747/CAS/advisory_status[256]", "op": "==", "value": 0 },
    { "do": "check", "note": ">CREW OXY LOW なし", "dref": "laminar/B747/CAS/advisory_status[53]", "op": "==", "value": 0 },
    { "do": "check", "note": "THERAP OXYGEN ON なし", "dref": "laminar/B747/CAS/memo_status[36]", "op": "==", "value": 0 },
    { "do": "set", "note": "下の EICAS に STATUS ページ", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "view", "the": -32, "psi": 33, "fov": 14 },
    { "do": "shot", "name": "stat_page_oxygen" },

    { "do": "mark", "note": "SEAT BELTS・NO SMOKING を OFF にして PASS OXYGEN ON" },
    { "do": "set", "note": "NO SMOKING 選択器 OFF", "dref": "laminar/B747/safety/no_smoking/sel_dial_pos", "value": 0 },
    { "do": "set", "note": "SEAT BELTS 選択器 OFF", "dref": "laminar/B747/safety/seat_belts/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "選択器 OFF：NO SMOKING は消灯", "dref": "sim/cockpit2/switches/no_smoking", "op": "==", "value": 0 },
    { "do": "check", "note": "選択器 OFF：FASTEN SEAT BELTS は消灯", "dref": "sim/cockpit2/switches/fasten_seat_belts", "op": "==", "value": 0 },
    { "do": "cmd", "note": "PASS OXYGEN を ON（ばねで NORM に戻る）", "name": "laminar/B747/oxygen/pass_oxy_sw_on" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "乗客酸素が作動（FCOM p.456）", "dref": "laminar/B747/oxygen/pass_oxy_on", "op": "==", "value": 1 },
    { "do": "check", "note": "PASS OXYGEN ON（FCOM p.547）", "dref": "laminar/B747/CAS/advisory_status[256]", "op": "==", "value": 1 },
    { "do": "check", "note": "選択器 OFF でも NO SMOKING（FCOM p.437、p.502）", "dref": "sim/cockpit2/switches/no_smoking", "op": "==", "value": 1 },
    { "do": "check", "note": "選択器 OFF でも FASTEN SEAT BELTS", "dref": "sim/cockpit2/switches/fasten_seat_belts", "op": "==", "value": 1 },
    { "do": "check", "note": "手動の ON では治療用は作動しない（自動のときだけ：FCOM p.513）", "dref": "laminar/B747/CAS/memo_status[36]", "op": "==", "value": 0 },
    { "do": "check", "note": "スイッチは NORM に戻っている", "dref": "laminar/B747/oxygen/pass_oxy_sw_pos", "op": "==", "value": 0 },
    { "do": "cas", "note": "PASS OXYGEN ON" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_pass_oxygen_on" },
    { "do": "sleep", "seconds": 50 },
    { "do": "check", "note": "STATUS PASS OXYGEN ON は 60 秒まで出ない", "dref": "laminar/B747/CAS/status_status[39]", "op": "==", "value": 0 },
    { "do": "wait", "note": "STATUS PASS OXYGEN ON（60 秒：ATA30_32_35_36 p.376）", "dref": "laminar/B747/CAS/status_status[39]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "cmd", "note": "PASS OXYGEN を RESET（0.5 秒押す。客室は 12,000 ft 未満）", "name": "laminar/B747/oxygen/pass_oxy_sw_reset", "duration": 0.5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "RESET で止まる（FCOM p.456）", "dref": "laminar/B747/oxygen/pass_oxy_on", "op": "==", "value": 0 },
    { "do": "check", "note": "PASS OXYGEN ON が消える", "dref": "laminar/B747/CAS/advisory_status[256]", "op": "==", "value": 0 },
    { "do": "check", "note": "STATUS も消える", "dref": "laminar/B747/CAS/status_status[39]", "op": "==", "value": 0 },
    { "do": "check", "note": "サインは選択器どおりに戻る", "dref": "sim/cockpit2/switches/no_smoking", "op": "==", "value": 0 },

    { "do": "mark", "note": "THERAPEUTIC OXYGEN" },
    { "do": "cmd", "note": "THERAPEUTIC OXYGEN を ON", "name": "laminar/B747/oxygen/therap_oxy_sw_up" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "THERAP OXYGEN ON（memo、FCOM p.547）", "dref": "laminar/B747/CAS/memo_status[36]", "op": "==", "value": 1 },
    { "do": "check", "note": "乗客のマスクは落ちない", "dref": "laminar/B747/oxygen/pass_oxy_on", "op": "==", "value": 0 },
    { "do": "cas", "note": "THERAPEUTIC OXYGEN ON" },
    { "do": "cmd", "note": "THERAPEUTIC OXYGEN を NORM", "name": "laminar/B747/oxygen/therap_oxy_sw_dn" },
    { "do": "cmd", "note": "THERAPEUTIC OXYGEN を RESET（0.5 秒）", "name": "laminar/B747/oxygen/therap_oxy_sw_dn", "duration": 0.5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "RESET で THERAP OXYGEN ON が消える（FCOM p.457）", "dref": "laminar/B747/CAS/memo_status[36]", "op": "==", "value": 0 },
    { "do": "check", "note": "スイッチは NORM に戻っている", "dref": "laminar/B747/oxygen/therap_oxy_sw_pos", "op": "==", "value": 0 },

    { "do": "mark", "note": "急減圧" },
    { "do": "cmd", "note": "乗員マスクを着ける（低酸素で画面が暗くならないように先に）", "name": "laminar/B747/oxygen/crew_masks_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "乗員マスク", "dref": "laminar/B747/oxygen/crew_mask_on", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の乗員酸素の弁", "dref": "sim/cockpit2/oxygen/actuators/o2_valve_on", "op": "==", "value": 1 },
    { "do": "set", "note": "X-Plane の急減圧の故障", "dref": "sim/operation/failures/rel_depres_fast", "value": 6 },
    { "do": "wait", "note": "客室が 14,000 ft を超える", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": ">", "value": 14100, "timeout": 60 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "約 14,000 ft で乗客酸素が自動で作動（FCOM p.456）", "dref": "laminar/B747/oxygen/pass_oxy_on", "op": "==", "value": 1 },
    { "do": "check", "note": "治療用酸素も自動で作動（FCOM p.513）", "dref": "laminar/B747/oxygen/therap_oxy_on", "op": "==", "value": 1 },
    { "do": "check", "note": "PASS OXYGEN ON", "dref": "laminar/B747/CAS/advisory_status[256]", "op": "==", "value": 1 },
    { "do": "check", "note": "THERAP OXYGEN ON", "dref": "laminar/B747/CAS/memo_status[36]", "op": "==", "value": 1 },
    { "do": "check", "note": "マスクを着けている：X-Plane の pilot_felt_altitude_ft は 10,000 ft 以下（推定）", "dref": "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft", "op": "<=", "value": 10001 },
    { "do": "cmd", "note": "PASS OXYGEN を RESET（客室は 14,000 ft 超）", "name": "laminar/B747/oxygen/pass_oxy_sw_reset", "duration": 0.5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "12,000 ft より上では RESET が効かない（FCOM p.456）", "dref": "laminar/B747/oxygen/pass_oxy_on", "op": "==", "value": 1 },
    { "do": "cas", "note": "急減圧" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_decompression" },
    { "do": "cmd", "note": "乗員マスクを外す（短い間）", "name": "laminar/B747/oxygen/crew_masks_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "マスクなし", "drefs": [ "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft" ] },
    { "do": "check", "note": "マスクなし：pilot_felt_altitude_ft は客室高度", "dref": "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft", "op": ">", "value": 14000 },
    { "do": "cmd", "note": "乗員マスクを着ける", "name": "laminar/B747/oxygen/crew_masks_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "マスク：10,000 ft 以下に戻る", "dref": "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft", "op": "<=", "value": 10001 },
    { "do": "set", "note": "急減圧の故障を戻す", "dref": "sim/operation/failures/rel_depres_fast", "value": 0 },
    { "do": "set", "note": "下の EICAS に STATUS ページ", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "view", "the": -32, "psi": 33, "fov": 14 },
    { "do": "shot", "name": "stat_page_after" },
    { "do": "snapshot", "note": "終了", "drefs": [ "laminar/B747/oxygen/crew_press_psi", "laminar/B747/oxygen/pass_press_psi",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/oxygen/indicators/pilot_felt_altitude_ft" ] },
    { "do": "record_stop" }
  ]
}
