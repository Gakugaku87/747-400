{
  "name": "s46_displays",
  "description": "表示器と EIU（5-2 段 1）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt で開始（機体を読み直す）。表示器の故障と自動切替（機長の outboard の故障で PFD を inboard に、upper の故障で primary EICAS を lower に：FCOM p.1045・p.1072）、INBD・LWR の選択器（機長の INBD EICAS、副操縦士の INBD PFD・LWR ND は向きが逆）、EIU（L の故障で AUTO は C、L を選んでいれば機長の PFD・ND が消える、standby の電源では全部が消える：FCOM p.1044・p.1529）、表示器の電源。パネルを撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/flt_inst/capt_inbd_display/sel_dial_pos", "laminar/B747/flt_inst/capt_lwr_display/sel_dial_pos", "laminar/B747/flt_inst/fo_inbd_display/sel_dial_pos", "laminar/B747/flt_inst/fo_lwr_display/sel_dial_pos",
      "laminar/B747/flt_inst/eiu_src/capt/sel_dial_pos", "laminar/B747/flt_inst/eiu_src/fo/sel_dial_pos", "laminar/B747/flt_inst/eiu_src/ctr_pnl/sel_dial_pos", "laminar/B747/electrical/display_has_power", "laminar/B747/displays/content_unit", "laminar/B747/eiu/used" ] },
    { "do": "check", "note": "通常：機長の PFD は outboard", "dref": "laminar/B747/flt_inst/display/capt/pfd_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "secondary EICAS は lower", "dref": "laminar/B747/flt_inst/display/eicas_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "機長の PFD に電源", "dref": "laminar/B747/electrical/display_has_power[0]", "op": "==", "value": 6 },
    { "do": "check", "note": "secondary EICAS に電源", "dref": "laminar/B747/electrical/display_has_power[5]", "op": "==", "value": 6 },
    { "do": "check", "note": "機長の EIU は L（AUTO）", "dref": "laminar/B747/eiu/used[0]", "op": "==", "value": 1 },
    { "do": "view", "name": "panel" },
    { "do": "shot", "name": "panel_normal" },

    { "do": "mark", "note": "unit failures" },
    { "do": "set", "note": "機長の outboard の故障", "dref": "laminar/B747/displays/fail[0]", "value": 1 },
    { "do": "set", "note": "upper の故障", "dref": "laminar/B747/displays/fail[2]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の PFD は inboard へ（FCOM p.1045）", "dref": "laminar/B747/flt_inst/display/capt/pfd_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の ND は出ない", "dref": "laminar/B747/electrical/display_has_power[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "primary EICAS は lower へ（FCOM p.1072）", "dref": "laminar/B747/flt_inst/display/pri_eicas_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "secondary EICAS は出ない", "dref": "laminar/B747/electrical/display_has_power[5]", "op": "==", "value": 0 },
    { "do": "shot", "name": "panel_auto_switch" },
    { "do": "set", "dref": "laminar/B747/displays/fail[0]", "value": 0 },
    { "do": "set", "dref": "laminar/B747/displays/fail[2]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "元に戻る", "dref": "laminar/B747/flt_inst/display/pri_eicas_pos", "op": "==", "value": 0 },

    { "do": "mark", "note": "selectors" },
    { "do": "set", "note": "機長の INBD を EICAS", "dref": "laminar/B747/flt_inst/capt_inbd_display/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の inboard に secondary EICAS", "dref": "laminar/B747/flt_inst/display/eicas_pos", "op": "==", "value": 2 },
    { "do": "check", "note": "機長の ND は出ない", "dref": "laminar/B747/electrical/display_has_power[3]", "op": "==", "value": 0 },
    { "do": "shot", "name": "panel_capt_inbd_eicas" },
    { "do": "set", "note": "機長の INBD を NORM", "dref": "laminar/B747/flt_inst/capt_inbd_display/sel_dial_pos", "value": 1 },
    { "do": "set", "note": "副操縦士の LWR を ND（向きが逆：位置 0）", "dref": "laminar/B747/flt_inst/fo_lwr_display/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "lower に副操縦士の ND", "dref": "laminar/B747/flt_inst/display/fo/nd_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "secondary EICAS は出ない", "dref": "laminar/B747/electrical/display_has_power[5]", "op": "==", "value": 0 },
    { "do": "shot", "name": "panel_fo_lwr_nd" },
    { "do": "set", "dref": "laminar/B747/flt_inst/fo_lwr_display/sel_dial_pos", "value": 1 },
    { "do": "set", "note": "副操縦士の INBD を PFD（位置 0）", "dref": "laminar/B747/flt_inst/fo_inbd_display/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士の PFD は inboard", "dref": "laminar/B747/flt_inst/display/fo/pfd_pos", "op": "==", "value": 1 },
    { "do": "set", "dref": "laminar/B747/flt_inst/fo_inbd_display/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士の PFD は outboard に戻る", "dref": "laminar/B747/flt_inst/display/fo/pfd_pos", "op": "==", "value": 0 },

    { "do": "mark", "note": "EIU" },
    { "do": "set", "note": "L の EIU の故障", "dref": "laminar/B747/eiu/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の AUTO は C（FCOM p.1044）", "dref": "laminar/B747/eiu/used[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "EICAS の AUTO は C（FCOM p.1529）", "dref": "laminar/B747/eiu/used[2]", "op": "==", "value": 2 },
    { "do": "check", "note": "機長の PFD は出たまま", "dref": "laminar/B747/electrical/display_has_power[0]", "op": "==", "value": 6 },
    { "do": "check", "note": ">EIU LEFT は空中で出さない（FCOM p.1199）", "dref": "laminar/B747/CAS/advisory_status[91]", "op": "==", "value": 0 },
    { "do": "set", "note": "機長の EIU 選択を L", "dref": "laminar/B747/flt_inst/eiu_src/capt/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L を選んで L が故障：自動で切り替えず、機長の PFD は消える", "dref": "laminar/B747/electrical/display_has_power[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "機長の ND も消える", "dref": "laminar/B747/electrical/display_has_power[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の PFD は出たまま", "dref": "laminar/B747/electrical/display_has_power[1]", "op": "==", "value": 6 },
    { "do": "shot", "name": "panel_eiu_l_failed" },
    { "do": "set", "note": "機長の EIU 選択を AUTO", "dref": "laminar/B747/flt_inst/eiu_src/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "dref": "laminar/B747/eiu/fail[0]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の PFD が戻る", "dref": "laminar/B747/electrical/display_has_power[0]", "op": "==", "value": 6 },
    { "do": "check", "note": "機長の EIU は L", "dref": "laminar/B747/eiu/used[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "panel_restored" }
  ]
}
