    { "do": "set", "note": "MCP 方位 090", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90 },
    { "do": "set", "note": "MCP 高度 FL270", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 27000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 27000 },
    { "do": "set", "note": "MCP を Mach に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "note": "窓 M.84", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 84 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 25 },
    { "do": "wait", "note": "水平に戻る（±200 fpm：空中開始の揺れの後）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-200, 200], "timeout": 240 },
    { "do": "set", "note": "水平で Mach を入れ直す（揺れの降下で IAS に切り替わっていても）", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
