    { "do": "watch", "note": "上昇中の Mach は M.834〜.846（90 秒。前は M.851〜.854：推定の幅）", "dref": "sim/flightmodel/misc/machno", "min": 0.834, "max": 0.846, "timeout": 90, "cite": "FCOM p.646 (4.10.8)" },
    { "do": "check", "note": "まだ上昇している", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 500 },
    { "do": "wait", "note": "FL350 の捕捉で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 360 },
    { "do": "sleep", "seconds": 40, "note": "水平に落ち着く" },
    { "do": "set", "note": "Mach を入れ直す", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 84 },
    { "do": "sleep", "seconds": 20 },

    { "do": "mark", "note": "FLCH で FL290 へ降下、M.84" },
    { "do": "set", "note": "MCP 高度 FL290", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 29000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 29000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA は FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "wait", "note": "33,500 ft を下る（入りの揺れの後：1 回目は 34,500 ft で M.833 から戻る途中）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 33500, "timeout": 150 },
    { "do": "check", "note": "降下している（−1,000 fpm より下）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -1000 },
    { "do": "check", "note": "窓は Mach のまま（自動の切り替えの前）", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "op": "==", "value": 1 },
    { "do": "watch", "note": "降下中の Mach は M.834〜.846（25 秒、約 FL315 の切り替えの前：推定の幅）", "dref": "sim/flightmodel/misc/machno", "min": 0.834, "max": 0.846, "timeout": 25, "cite": "FCOM p.646 (4.10.8)" },
