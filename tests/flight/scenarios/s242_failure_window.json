{
  "name": "s242_failure_window",
  "description": "故障の窓（F1、notes/FAILURES.md）。b747_fms_bridge の窓をコマンド laminar/B747/failures/window_toggle で開き、一覧（failures.txt）の故障を入れて laminar/B747/failures/active の数を確かめ、REPAIR ALL（laminar/B747/failures/repair_all）で全部直す。この機体のモデルの故障（hydraulics/fail/edp[1]：1 で故障）と X-Plane の故障（rel_ice_detect：6 で故障）の両方。窓の写真を撮る。窓の中のクリックは computer-use で別に確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "窓は閉じている", "dref": "laminar/B747/failures/window_open", "op": "==", "value": 0 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },
    { "do": "cmd", "note": "窓を開く", "name": "laminar/B747/failures/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "窓が開いた", "dref": "laminar/B747/failures/window_open", "op": "==", "value": 1 },
    { "do": "shot", "name": "window_open" },

    { "do": "mark", "note": "窓の中のクリック（test_click：描いた物の真ん中を窓のクリックの処理へ）" },
    { "do": "set", "note": "章 29 HYDRAULICS（6 番目：1005）", "dref": "laminar/B747/failures/test_click", "value": 1005 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "章の行が描かれていて押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 1005 },
    { "do": "set", "note": "行 2：ENGINE PUMP 2 を押す", "dref": "laminar/B747/failures/test_click", "value": 2002 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 2002 },
    { "do": "check", "note": "EDP 2 が故障に", "dref": "laminar/B747/hydraulics/fail/edp[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "故障 1 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 1 },
    { "do": "wait", "note": "HYD PRESS ENG 2", "dref": "laminar/B747/CAS/advisory_status[211]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "shot", "name": "window_hyd_edp2" },
    { "do": "set", "note": "もう一度押すと直る", "dref": "laminar/B747/failures/test_click", "value": 2002 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "EDP 2 は正常", "dref": "laminar/B747/hydraulics/fail/edp[1]", "op": "==", "value": 0 },
    { "do": "set", "note": "行 0 は群の見出し（押せない）", "dref": "laminar/B747/failures/test_click", "value": 2000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "見出しは押す所が無い", "dref": "laminar/B747/failures/test_click", "op": "==", "value": -1 },
    { "do": "set", "note": "章 30 ICE AND RAIN（1006）", "dref": "laminar/B747/failures/test_click", "value": 1006 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "行 7：ICE DETECTORS（X-Plane の故障）", "dref": "laminar/B747/failures/test_click", "value": 2007 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X-Plane の rel_ice_detect が 6", "dref": "sim/operation/failures/rel_ice_detect", "op": "==", "value": 6 },
    { "do": "set", "note": "REPAIR ALL のボタン", "dref": "laminar/B747/failures/test_click", "value": 3000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 3000 },
    { "do": "check", "note": "氷検知器は直った", "dref": "sim/operation/failures/rel_ice_detect", "op": "==", "value": 0 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },

    { "do": "mark", "note": "故障を入れる" },
    { "do": "set", "note": "ENGINE PUMP 2（この機体のモデル：1 で故障）", "dref": "laminar/B747/hydraulics/fail/edp[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "1 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 1 },
    { "do": "set", "note": "ICE DETECTORS（X-Plane：6 で故障）", "dref": "sim/operation/failures/rel_ice_detect", "value": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 2 },
    { "do": "set", "note": "X-Plane の故障の arm（1：MTBF）は数えない", "dref": "sim/operation/failures/rel_ice_window_heat", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 つのまま", "dref": "laminar/B747/failures/active", "op": "==", "value": 2 },
    { "do": "wait", "note": "HYD PRESS ENG 2 が出る", "dref": "laminar/B747/CAS/advisory_status[211]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "shot", "name": "window_two_failed" },

    { "do": "mark", "note": "REPAIR ALL" },
    { "do": "cmd", "note": "REPAIR ALL", "name": "laminar/B747/failures/repair_all" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },
    { "do": "check", "note": "EDP 2 は直った", "dref": "laminar/B747/hydraulics/fail/edp[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "氷検知器も直った", "dref": "sim/operation/failures/rel_ice_detect", "op": "==", "value": 0 },
    { "do": "check", "note": "arm も解いた", "dref": "sim/operation/failures/rel_ice_window_heat", "op": "==", "value": 0 },
    { "do": "wait", "note": "HYD PRESS ENG 2 が消える", "dref": "laminar/B747/CAS/advisory_status[211]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "set", "note": "窓を閉じる（dataref から）", "dref": "laminar/B747/failures/window_open", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "窓が閉じた", "dref": "laminar/B747/failures/window_open", "op": "==", "value": 0 },
    { "do": "record_stop" }
  ]
}
