    { "do": "cmd", "note": "master リセットで灯を消しておく（2026-11-13 の 1 回目は、読み直しの後の始動で点いた灯が残っていた）", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },
