    { "do": "cmd", "note": "BUS TIE 2 を ISLN に", "name": "laminar/B747/button_switch/elec_bus_tie_2", "duration": 0.2 },
    { "do": "cmd", "note": "GEN CONT 2 を OFF", "name": "laminar/B747/button_switch/elec_gen_ctrl_2", "duration": 0.2 },
