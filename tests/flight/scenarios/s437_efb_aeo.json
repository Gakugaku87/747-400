{
  "name": "s437_efb_aeo",
  "description": "離着陸性能の窓（notes/ATA-34-61-FMC.md §191）の滑走路長の制限の X-Plane での裏づけ 2：全発の離陸距離。s436 と同じ約 352 t（積載 45 t・燃料 124.1 t）、RJAA 34L、フラップ 20、離陸トリム。FMC の側にこの重さで滑走路長 2,600 m の離陸を計算させ（FPPM の図で 352.6 t の制限）、推力レバー最前方で滑走し、その VR で毎秒 2.5° で 15° へ引き起こす（B747_rotate.lua、FCTM p.95–96）。ブレーキを外した所から電波高度 35 ft までの距離（X-Plane の local_x・local_z）の 1.15 倍が、計算に使った 2,600 m に収まるかを、記録から見る（FAA の全発の離陸距離の 115 %：滑走路長の制限は、これと加速停止・一発停止の離陸の長い方。判定はあとで：重さの実際の値で計算し直す）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    },
    "weight": {
      "payload_weight_in_kilograms": [4389, 4620, 5544, 7161, 1386, 11573, 10326, 0, 0],
      "fueltank_weight_in_kilograms": [12989.6, 13499.4, 38075.2, 38075.2, 13499.4, 3980.6, 3980.6, 0, 0]
    }
  },
  "steps": [
