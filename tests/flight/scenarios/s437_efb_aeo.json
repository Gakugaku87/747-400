    { "do": "set", "note": "FMC に計算させる：RJAA", "dref": "laminar/B747/efb/req_i[0]", "value": 925482 },
    { "do": "set", "note": "34L", "dref": "laminar/B747/efb/req_i[1]", "value": 1562473 },
