    { "do": "set", "note": "パーキングブレーキのレバーを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "set", "note": "推力レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "離陸の形態の警報なし", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0, "stop": true },
    { "do": "wait", "note": "VR（窓の計算）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 0, "rel": "vr", "timeout": 120 },
    { "do": "cmd", "note": "毎秒 2.5° で 15° へ引き起こす（B747_rotate.lua、FCTM p.95–96）", "name": "FlyWithLua/B747_rotate/start" },
    { "do": "snapshot", "note": "VR：位置", "drefs": ["sim/flightmodel/position/local_x", "sim/flightmodel/position/local_z", "laminar/B747/gauges/indicators/airspeed_kts_pilot"] },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "snapshot", "note": "浮いた所：位置・速さ・ピッチ", "drefs": ["sim/flightmodel/position/local_x", "sim/flightmodel/position/local_z", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/theta"] },
    { "do": "wait", "note": "電波高度 35 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 35, "timeout": 30 },
