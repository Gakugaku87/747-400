    { "do": "snapshot", "note": "距離の終わり：位置・速さ（V2 + 10 から V2 + 25 の範囲）", "drefs": ["sim/flightmodel/position/local_x", "sim/flightmodel/position/local_z", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/theta"] },
    { "do": "sleep", "seconds": 8 },
    { "do": "cmd", "note": "引き起こしの操縦を終える", "name": "FlyWithLua/B747_rotate/stop" },
