{
  "name": "s195_atc_route_request",
  "description": "6-1・6-2 段 12g2b（ATC の経路の要求：RTE 1・RTE 2・DEP/ARR）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO に戻す、保存はしない）。RTE 1 に RJAA から RJBB を入れ、ATC ROUTE REQUEST 4/4 の REQUEST <RTE 1・RTE 2> と REQUEST DEP/ARR の dashes、<RTE 1 の選択（大きい字、RTE 2 が消える）、VERIFY REQUEST の REQUEST ROUTE CLEARANCE と経路の文、ERASE REQUEST を確かめる。AutoATC の無いこの PC では送れない。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "RTE、ORIGIN に RJAA、DEST に RJBB", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1"] },
    { "do": "check", "note": "RTE 1 の DEST", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RJBB" },
    { "do": "cdu", "note": "ATC キー（LOGON/STATUS）、<INDEX、<REQUEST、<ROUTE REQUEST", "keys": ["ATC", "L6", "L2", "L4"] },
    { "do": "check", "note": "ATC ROUTE REQUEST", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC ROUTE REQUEST" },
    { "do": "check", "note": "REQUEST の見出し 2 つ（FMSPG p.316）", "dref": "laminar/B747/fms3/Line06_S", "op": "contains", "value": " REQUEST         REQUEST" },
    { "do": "check", "note": "<RTE 1 と RTE 2>", "dref": "laminar/B747/fms3/Line07_S", "op": "contains", "value": "<RTE 1            RTE 2>" },
    { "do": "check", "note": "REQUEST DEP/ARR", "dref": "laminar/B747/fms3/Line10_S", "op": "contains", "value": "REQUEST DEP/ARR" },
    { "do": "check", "note": "出発の手続きを選んでいないので dashes（FMSPG p.317）", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "-----" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_atc_route_request" },
    { "do": "cdu", "note": "<RTE 1", "keys": ["L3"] },
    { "do": "check", "note": "RTE 1 が大きい字に", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "RTE 1" },
    { "do": "check", "note": "RTE 2 の見出しが消える（FMSPG p.318）", "dref": "laminar/B747/fms3/Line06_S", "op": "matches", "value": "^ REQUEST +$" },
    { "do": "shot", "name": "cdu_atc_route_rte1" },
    { "do": "cdu", "note": "VERIFY>", "keys": ["R6"] },
    { "do": "check", "note": "REQUEST ROUTE CLEARANCE", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "REQUEST ROUTE CLEARANCE" },
    { "do": "check", "note": "経路の文（出発地と目的地）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RJAA RJBB" },
    { "do": "check", "note": "AutoATC が無いので NO COMM", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "NO COMM" },
    { "do": "shot", "name": "cdu_verify_route" },
    { "do": "cdu", "note": "<REQUEST、<ERASE REQUEST", "keys": ["L6", "L5"] },
    { "do": "check", "note": "消えて dashes", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<-----" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
