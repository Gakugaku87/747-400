{
  "name": "s57_pfd_vr",
  "description": "PFD の VR のバグの R（5-2 段 4c、パネルの変更）の X-Plane での確認。RJAA 34L でエンジン運転中に始める（機体を読み直す）。VR が V1 から 4 kt 以内なら VR のバグの文字は R だけ（FCOM p.972）。速度テープの見える所に来るよう V1・VR を低い値で直接書く（fltInst02 はフラップの選択が変わったときだけ書く）。機長の PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5 },
    { "do": "cmd", "note": "INIT REF（地上で位置あり：PERF INIT）", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<INDEX（L6）", "name": "laminar/B747/fms1/ls_key/L6" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<TAKEOFF（L5）", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "V1 130（R1。PFD の V speeds は TAKEOFF REF で選んだ値：6-2 段 3b-1 から。dataref に直接書いても FMC が次のフレームで戻す）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "VR 133（R2。V1 から 3 kt）", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PFD の V1 130", "dref": "laminar/B747/airspeed/V1", "op": "==", "value": 130 },
    { "do": "check", "note": "VR が V1 から 4 kt 以内：R", "dref": "laminar/B747/airspeed/vr_r", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD（V speeds は地上の速度テープの上の外：前は 70 kt で見える所に書いたが、TAKEOFF REF の入力は 100〜300 kt）", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_r" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/4" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "VR 142（R2。V1 から 12 kt）", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VR", "dref": "laminar/B747/airspeed/vr_r", "op": "==", "value": 0 },
    { "do": "shot", "name": "pfd_vr" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
