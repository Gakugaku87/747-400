{
  "name": "s246_failure_window_xp_more",
  "description": "故障の窓の一覧に足した X-Plane の故障（s245 で効き方を確かめたもの：notes/FAILURES.md §3）が窓に読まれること。成田 34L でエンジン運転中に窓を開き（一覧を読み直す）、新しい章 35 OXYGEN の行を test_click で押して rel_pass_o2_on が 6、PASS OXYGEN ON。エンジンの flameout・故障・燃料フィルタは X-Plane の dataref を入れて laminar/B747/failures/active が 1 になること（一覧の下の方で、窓の外からの確かめ）",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "cmd", "note": "窓を開く（一覧を読み直す）", "name": "laminar/B747/failures/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },

    { "do": "mark", "note": "章 35 OXYGEN" },
    { "do": "set", "note": "章 35 OXYGEN（11 番目：1010）", "dref": "laminar/B747/failures/test_click", "value": 1010 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "行 1：PASSENGER OXYGEN ON BY ITSELF", "dref": "laminar/B747/failures/test_click", "value": 2001 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 2001 },
    { "do": "check", "note": "X-Plane の rel_pass_o2_on が 6", "dref": "sim/operation/failures/rel_pass_o2_on", "op": "==", "value": 6 },
    { "do": "wait", "note": "PASS OXYGEN ON", "dref": "laminar/B747/CAS/advisory_status[256]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "shot", "name": "window_oxygen" },
    { "do": "set", "note": "もう一度押して直す", "dref": "laminar/B747/failures/test_click", "value": 2001 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X-Plane の故障は 0", "dref": "sim/operation/failures/rel_pass_o2_on", "op": "==", "value": 0 },
    { "do": "check", "note": "PASS OXYGEN ON は RESET まで残る（実機どおり：notes/ATA-35.md）", "dref": "laminar/B747/CAS/advisory_status[256]", "op": "==", "value": 1 },

    { "do": "mark", "note": "章 70-80 に足した故障が数えられる" },
    { "do": "set", "note": "ENGINE 2 FUEL FILTER CLOGGED", "dref": "sim/operation/failures/rel_fuel_block1", "value": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "1 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 1 },
    { "do": "check", "note": "ENG 2 FUEL FILT", "dref": "laminar/B747/CAS/advisory_status[115]", "op": "==", "value": 1 },
    { "do": "set", "note": "ENGINE 3 FLAMEOUT", "dref": "sim/operation/failures/rel_engfla2", "value": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 2 },
    { "do": "set", "note": "ENGINE 4 FAILURE", "dref": "sim/operation/failures/rel_engfai3", "value": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "3 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 3 },
    { "do": "set", "note": "章 70-80（14 番目：1013）", "dref": "laminar/B747/failures/test_click", "value": 1013 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "window_engines" },
    { "do": "set", "note": "REPAIR ALL", "dref": "laminar/B747/failures/test_click", "value": 3000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },
    { "do": "check", "note": "燃料フィルタは直った", "dref": "sim/operation/failures/rel_fuel_block1", "op": "==", "value": 0 },
    { "do": "check", "note": "flameout も", "dref": "sim/operation/failures/rel_engfla2", "op": "==", "value": 0 },
    { "do": "check", "note": "故障も", "dref": "sim/operation/failures/rel_engfai3", "op": "==", "value": 0 },
    { "do": "set", "note": "窓を閉じる", "dref": "laminar/B747/failures/window_open", "value": 0 },
    { "do": "record_stop" }
  ]
}
