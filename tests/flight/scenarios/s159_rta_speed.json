{
  "name": "s159_rta_speed",
  "description": "6-1/6-2 段 9h5b（RTA の速さ）の X-Plane での確認。s158 と同じ空中 FL350 の巡航（機体を読み直す）、RJAA→RJBB の経路、ZFW 200・CRZ ALT FL350・COST INDEX 100、VNAV PTH。s158 の予測では SPENS に 0114.5z（ECON）なので、RTA を SPENS 0115.5（1 分遅く）にして EXEC：RTA の Mach が ECON より遅くなり、VNAV の目標がそれ、CRZ のページは ACT RTA CRZ と 2L の RTA SPD、PROGRESS の 5L は RTA SPD、RTA PROGRESS の 2L に RTA SPD、数分で予測の時刻が RTA の 30 秒の内（FCOM p.1269、p.1354、p.1372、p.1383–1384）。次に 0110.0（早すぎる）で UNABLE RTA と上限の Mach（FCOM p.1434）。CRZ のページの <ECON で終わる。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "set", "note": "MCP 高度 35,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "sleep", "seconds": 5 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH（巡航）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 60 },
    { "do": "cdu", "note": "LEGS：XAC へ DIRECT TO（1L）、EXEC（初めの版（2026-11-01 4:07）は LNAV なしで機首 340° のまま経路から離れ、予測の時刻が遅れ続けて上限 .879 でも UNABLE RTA になった）", "keys": ["LEGS", "XAC", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと）" },
    { "do": "snapshot", "note": "ECON の目標", "drefs": [ "laminar/B747/fms/vnav/mach", "sim/flightmodel/misc/machno", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/clock_timer/zulu_time_hours", "sim/cockpit2/clock_timer/zulu_time_minutes" ] },
    { "do": "remember", "dref": "laminar/B747/fms/vnav/mach", "as": "econ" },

    { "do": "mark", "note": "RTA を SPENS 0115.5 に（ECON より 1 分遅い）" },
    { "do": "cdu", "note": "PROG、PREV（RTA PROGRESS）、SPENS を 1L、0115.5 を 1R、EXEC", "keys": ["PROG", "PREV", "SPENS", "L1", "0115.5", "R1", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTA PROGRESS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTA PROGRESS" },
    { "do": "sleep", "seconds": 12, "note": "予測と RTA の速さ" },
    { "do": "snapshot", "note": "RTA の始め", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/vnav/mach", "sim/flightmodel/misc/machno", "laminar/B747/fms/notification[48]" ] },
    { "do": "check", "note": "2L の RTA SPD は .7xx〜.83x（ECON より遅い）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^[.](7[0-9]{2}|8[0-3][0-9]) " },
    { "do": "check", "note": "VNAV の目標は ECON より 0.01 以上遅い", "dref": "laminar/B747/fms/vnav/mach", "op": "between", "value": [-0.15, -0.01], "rel": "econ" },
    { "do": "check", "note": "UNABLE RTA は出ない", "dref": "laminar/B747/fms/notification[48]", "op": "==", "value": 0 },
    { "do": "cdu", "note": "VNAV（CRZ のページ）", "keys": ["VNAV"] },
    { "do": "check", "note": "ACT RTA CRZ（FCOM p.1354）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTA CRZ" },
    { "do": "check", "note": "2L の見出しは RTA SPD", "dref": "laminar/B747/fms3/Line04_S", "op": "matches", "value": "^ RTA SPD" },
    { "do": "check", "note": "5L <ECON", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<ECON" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_rta_crz" },
    { "do": "cdu", "note": "PROG", "keys": ["PROG"] },
    { "do": "check", "note": "PROGRESS の 5L は RTA SPD（FCOM p.1372）", "dref": "laminar/B747/fms3/Line10_S", "op": "matches", "value": "^ RTA SPD" },

    { "do": "mark", "note": "減速して時刻に合う" },
    { "do": "sleep", "seconds": 150, "note": "A/T が RTA の Mach へ減速し、予測が追う" },
    { "do": "cdu", "note": "PREV（RTA PROGRESS）", "keys": ["PREV"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "RTA の 2.5 分後", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/vnav/mach", "sim/flightmodel/misc/machno", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/notification[48]" ] },
    { "do": "check", "note": "予測の SPENS の時刻は RTA の 30 秒の内（0115.0〜0116.0）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "/(0115[.][0-9]|0116[.]0)z$" },
    { "do": "remember", "note": "その時の RTA の Mach（LNAV の XAC への旋回（約 140°、2 分）は予測の距離に入らず、その遅れを RTA が速くして取り戻す：前の版（2026-11-01 4:16）は .820 から .866 に上がり、ECON より遅いはずという確認が落ちた）", "dref": "laminar/B747/fms/vnav/mach", "as": "rtamach" },
    { "do": "check", "note": "機体の Mach は RTA の Mach の近く", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [-0.02, 0.02], "rel": "rtamach" },
    { "do": "shot", "name": "cdu_rta_progress_met" },

    { "do": "mark", "note": "早すぎる RTA：UNABLE RTA" },
    { "do": "cdu", "note": "0110.0 を 1R、EXEC", "keys": ["0110.0", "R1", "EXEC"] },
    { "do": "sleep", "seconds": 25, "note": "予測 2 回" },
    { "do": "snapshot", "note": "UNABLE RTA", "drefs": [ "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line14_L", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/notification[48]" ] },
    { "do": "check", "note": "UNABLE RTA（FCOM p.1434：旗 48）", "dref": "laminar/B747/fms/notification[48]", "op": "==", "value": 1 },
    { "do": "check", "note": "書き込み行に UNABLE RTA", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "UNABLE RTA" },
    { "do": "check", "note": "VNAV の目標は上限（.880 か VMO/MMO−16 kt）", "dref": "laminar/B747/fms/vnav/mach", "op": "between", "value": [0.87, 0.881] },
    { "do": "cdu", "note": "CLR", "keys": ["CLR"] },

    { "do": "mark", "note": "<ECON で終わる" },
    { "do": "cdu", "note": "VNAV（CRZ のページ）、5L <ECON", "keys": ["VNAV", "L5"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ACT ECON CRZ（RTA は終わる：FCOM p.1354）", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "ACT ECON CRZ" },
    { "do": "sleep", "seconds": 12 },
    { "do": "check", "note": "UNABLE RTA は消える", "dref": "laminar/B747/fms/notification[48]", "op": "==", "value": 0 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
