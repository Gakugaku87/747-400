{
  "name": "s253_faor_exob1c_ge",
  "description": "s251 を GE（CF6-80C2）のリバリー（Qantas VH-OEJ）で：利用者の別の PC は South African Airways ZS-SBK（GE）だった。利用者の報告（2026-11-05、別の PC：FAOR 03L から EXOB1C で LNAV・VNAV が崩れた）の X-Plane での再現。FAOR（標高 5,559 ft）34L ではなく 03L でエンジン運転中に始め、CDU で FAOR→VHHH、滑走路 03L、DEPARTURES の EXOB1C（OR378 へ 036°M の CF で真上を通過・6,330 ft 以上、右旋回で OR390 へ DF・FL090 以下、OR414・EXOBI は FL110 以上）、PERF INIT（ZFW 200、FL350）、TAKEOFF REF（フラップ 20）。LNAV と VNAV を arm して s141 と同じ手順で離陸、300 ft RA で A/P。LNAV と VNAV の engage、OR378 の後の右旋回（真航跡 107°）、OR390 までは 9,300 ft 以下、OR414 で FL110 以上を確かめる",
  "reload": true,
  "livery": "PilotMathews - Qantas VH-OEJ (GE)",
  "flight": {
    "runway_start": { "airport_id": "FAOR", "runway": "03L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 15,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 15000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 15000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s141 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "CDU：FAOR→VHHH、03L、EXOB1C" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：FAOR→VHHH、RUNWAY 03L", "keys": ["RTE", "FAOR", "L1", "VHHH", "R1", "03L", "L2"] },
    { "do": "cdu", "note": "DEP ARR（INDEX）、<DEP、2 ページ目の EXOB1C", "keys": ["DEPARR", "L1", "NEXT", "L1"] },
    { "do": "snapshot", "note": "DEPARTURES", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L" ] },
    { "do": "check", "note": "EXOB1C を選んだ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "EXOB1C" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "snapshot", "note": "LEGS", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "最初の点は OR378", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "OR378" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20、V1・VR・V2 を選ぶ", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "V speeds と VNAV", "drefs": [ "laminar/B747/airspeed/V1", "laminar/B747/airspeed/Vr", "laminar/B747/airspeed/V2", "laminar/B747/fms/vnav/valid", "laminar/B747/fms/vnav/phase", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "LNAV（arm）", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV の arm", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "VNAV の arm", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 4 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "離陸" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 120 },
    { "do": "set", "note": "操縦輪を引く", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.35 },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "set", "note": "操縦輪を緩める", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 25 },
    { "do": "cmd", "note": "手で F/D のバーを追う", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "LNAV が engage（50 ft RA）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "cmd", "note": "手の操縦を終える", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "wait", "note": "VNAV SPD が engage（400 ft RA）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 40 },
    { "do": "snapshot", "note": "engage の後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/hpath", "sim/flightmodel/position/phi", "laminar/B747/fms/vnav/cas" ] },

    { "do": "mark", "note": "フラップを上げる" },
    { "do": "wait", "note": "200 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 200, "timeout": 90 },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "wait", "note": "220 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 220, "timeout": 90 },
    { "do": "set", "note": "フラップ 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.34 },
    { "do": "wait", "note": "235 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 235, "timeout": 90 },
    { "do": "set", "note": "フラップ 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.168 },
    { "do": "wait", "note": "243 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 243, "timeout": 90 },
    { "do": "set", "note": "フラップ UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },

    { "do": "mark", "note": "OR378 の後の右旋回" },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "wait", "note": "現用点が OR390（OR378 を通過）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "OR390", "timeout": 300 },
    { "do": "snapshot", "note": "OR378 通過", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/hpath", "sim/flightmodel/position/phi", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "wait", "note": "右旋回して真航跡 100〜115°（OR390 へ 107°）", "dref": "sim/flightmodel/position/hpath", "op": "between", "value": [100, 115], "timeout": 120 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "snapshot", "note": "旋回の後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/hpath", "sim/flightmodel/position/phi", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/fms/vnav/cas" ] },
    { "do": "view", "note": "機長の ND", "the": -24, "psi": 9, "fov": 24 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "capt_nd_after_or378" },

    { "do": "mark", "note": "OR390 まで FL090 以下" },
    { "do": "watch", "note": "OR390 の手前は 9,300 ft 以下（FL090 以下）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 9300, "timeout": 150 },
    { "do": "wait", "note": "現用点が OR414（OR390 を通過）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "OR414", "timeout": 300 },
    { "do": "snapshot", "note": "OR390 通過", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/hpath", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "OR390 で FL090 以下", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 9300 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "wait", "note": "現用点が EXOBI（OR414 を通過）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "EXOBI", "timeout": 420 },
    { "do": "snapshot", "note": "OR414 通過", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/hpath", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "OR414 で FL110 以上", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 10900 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "record_stop" }
  ]
}
