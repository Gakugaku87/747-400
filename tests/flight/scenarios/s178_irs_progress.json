{
  "name": "s178_irs_progress",
  "description": "6-1/6-2 段 11e2（代替航法の IRS PROGRESS）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、XAC へ DIRECT。両方の FMC を故障させると、左の CDU の PROG で IRS PROGRESS（TO XAC の DTG と TTG、NEXT SPENS、DEST RJBB、IRS L の位置と GS、XTK ERROR・DTK・TK：FCOM p.1425–1426、FMSPG p.250–251）。4L に SPENS を入れると ENROUTE WPT、LEGS へ行って戻ると DEST。右の CDU は IRS R。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "LEGS で XAC へ DIRECT TO、EXEC", "keys": ["LEGS", "XAC", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 3, "note": "CDU が経路を写す（毎秒）" },

    { "do": "mark", "note": "両方の FMC の故障と IRS PROGRESS" },
    { "do": "set", "note": "左 FMC を故障させる", "dref": "laminar/B747/fms/fail[0]", "value": 1 },
    { "do": "set", "note": "右 FMC も", "dref": "laminar/B747/fms/fail[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "CLR、PROG", "keys": ["CLR", "PROG"] },
    { "do": "check", "note": "IRS PROGRESS（FCOM p.1425）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "IRS PROGRESS" },
    { "do": "check", "note": "TO XAC の DTG と TTG（FMSPG p.250）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^XAC +[0-9]+NM +[0-9]{2}:[0-9]{2}$" },
    { "do": "check", "note": "NEXT SPENS", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^SPENS +[0-9]+NM +[0-9]{2}:[0-9]{2}$" },
    { "do": "check", "note": "DEST RJBB", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^RJBB +[0-9]+NM +[0-9]{2}:[0-9]{2}$" },
    { "do": "check", "note": "IRS L と GS", "dref": "laminar/B747/fms3/Line10_S", "op": "matches", "value": "^ IRS L +GS$" },
    { "do": "check", "note": "位置と GS", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^N3[0-9]`[0-9]{2}[.][0-9] E1[0-9]{2}`[0-9]{2}[.][0-9] +[0-9]+KT$" },
    { "do": "check", "note": "XTK ERROR・DTK・TK", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^[LR] [0-9]+[.][0-9]NM +[0-9]{3}`M +[0-9]{3}`M$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_irs_progress" },

    { "do": "mark", "note": "4L の代替" },
    { "do": "cdu", "note": "4L に SPENS", "keys": ["SPENS", "L4"] },
    { "do": "check", "note": "ENROUTE WPT（FMSPG p.251）", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "ENROUTE WPT" },
    { "do": "check", "note": "SPENS の距離と時間", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^SPENS +[0-9]+NM" },
    { "do": "shot", "name": "cdu_irs_progress_enroute" },
    { "do": "cdu", "note": "LEGS へ行って PROG に戻る", "keys": ["LEGS", "PROG"] },
    { "do": "check", "note": "DEST に戻る（ページを離れると消える）", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": "DEST" },
    { "do": "cmd", "note": "右の CDU：CLR", "name": "laminar/B747/fms2/key/clear" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "右の CDU：PROG", "name": "laminar/B747/fms2/func_key/prog" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "右の CDU は IRS R", "dref": "laminar/B747/fms2/Line10_S", "op": "matches", "value": "^ IRS R +GS$" },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[0]", "value": 0 },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[1]", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
