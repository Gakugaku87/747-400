{
  "name": "s221_offpath_des",
  "description": "OFFPATH DES とエネルギー管理の円（2026-11-04、notes/ATA-34-61-FMC.md §143）の X-Plane での確認、空中。s131 と同じ FL350・M.84 で RJAA の東から西へ空中開始（機体を読み直す）。A/P CMD L・ALT HOLD・HDG SEL。RTE で RJAA→RJBB、DIRECT AKAGI、STAR ATMUGA と ILS06LY（遷移 GATES）、ACTIVATE と EXEC、COST INDEX 100、CRZ ALT FL350 で予測。DES のページの <OFFPATH DES で OFFPATH DES（FCOM p.1398 の図）、DES TO は E/D、AKAGI を入れて SPD/ALT の箱に /5000、CLEAN CIRCLE（内側で負）と DRAG CIRCLE（clean の内側だけ）、SELECT ON> で ND に円（clean は青、drag は白の破線：FCOM p.1150；FMSPG p.193-194）。CDU と ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.6, "elevation_in_meters": 10668, "heading_true": 255, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "set", "note": "MCP 高度 FL350", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "set", "note": "MCP 方位 262（真 255）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 262 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "PERF INIT：COST INDEX 100", "keys": ["INITREF", "L6", "L3", "100", "L5"] },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "NEXT：CRZ、CRZ ALT FL350", "keys": ["NEXT", "350", "L1"] },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと、入力ですぐ）" },

    { "do": "mark", "note": "DES のページの <OFFPATH DES（FCOM p.1398 の図）" },
    { "do": "cdu", "note": "NEXT：DES", "keys": ["NEXT"] },
    { "do": "check", "note": "DES のページ 3/3", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "3/3" },
    { "do": "check", "note": "<OFFPATH DES（前は < の無い文字だけで、押しても何も起きなかった）", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^<OFFPATH DES" },
    { "do": "cdu", "note": "<OFFPATH DES", "keys": ["L6"] },
    { "do": "check", "note": "OFFPATH DES", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "       OFFPATH DES      " },
    { "do": "check", "note": "見出し DES TO・DTG・SPD/ALT", "dref": "laminar/B747/fms3/Line02_S", "op": "==", "value": " DES TO    DTG   SPD/ALT" },
    { "do": "check", "note": "DES TO は DES のページの E/D と DTG（FCOM p.1398）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^[A-Z0-9]+ +\\d+ " },
    { "do": "check", "note": "CLEAN CIRCLE の見出し", "dref": "laminar/B747/fms3/Line04_S", "op": "matches", "value": "CLEAN CIRCLE" },
    { "do": "check", "note": "DISPLAY SELECT ON>", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^<DES +SELECT ON>$" },

    { "do": "mark", "note": "DES TO AKAGI、SPD/ALT の箱に /5000、CLEAN と DRAG（FCOM p.1399；FMSPG p.193）" },
    { "do": "cdu", "note": "AKAGI を DES TO に", "keys": ["AKAGI", "L1", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "DES TO AKAGI と DTG、制限なしの点なので SPD/ALT の箱（FCOM p.1399）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^AKAGI +\\d+ +\\*\\*\\*/\\*\\*\\*\\*\\*$" },
    { "do": "cdu", "note": "/5000", "keys": ["/5000", "R1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "SPD/ALT ---/ 5000", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "---/ 5000$" },
    { "do": "check", "note": "CLEAN CIRCLE までの距離（符号つき、内側で負）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^[.]\\d{3}/\\d{3} +-?\\d+ +$" },
    { "do": "snapshot", "note": "OFFPATH DES の各行", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_offpath_des" },

    { "do": "mark", "note": "SELECT ON>：ND にエネルギー管理の円（FMSPG p.194；FCOM p.1150）" },
    { "do": "cdu", "note": "SELECT ON>", "keys": ["R6"] },
    { "do": "check", "note": "SELECT OFF> に変わる", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "SELECT OFF>$" },
    { "do": "set", "note": "機長の ND は MAP 160 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 4 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "円が 1 つ以上", "dref": "laminar/B747/nd/circle/n", "op": ">=", "value": 1 },
    { "do": "check", "note": "1 つ目は clean（形 7：青の破線）", "dref": "laminar/B747/nd/circle/pen[0]", "op": "==", "value": 7 },
    { "do": "snapshot", "note": "円の数・形・半径", "drefs": [ "laminar/B747/nd/circle/n", "laminar/B747/nd/circle/pen[0]", "laminar/B747/nd/circle/radius[0]", "laminar/B747/nd/circle/pen[1]", "laminar/B747/nd/circle/radius[1]" ] },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_offpath_circles" },
    { "do": "cdu", "note": "SELECT OFF>", "keys": ["R6"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "円は消える", "dref": "laminar/B747/nd/circle/n", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
