    { "do": "snapshot", "note": "LEGS", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line10_S", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "4 行目 D097V", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^D097V", "stop": true },
    { "do": "check", "note": "5 行目 DOYLE", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^DOYLE", "stop": true },
