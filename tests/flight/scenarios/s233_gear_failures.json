{
  "name": "s233_gear_failures",
  "description": "脚の故障の入力（2026-11-04、故障の窓の F0：notes/ATA-32.md §17、GEAR-22）の X-Plane での確認。成田 34L でエンジン運転中に開始。ノーズギアの位置の検知の片系統の故障で STATUS GEAR MONITOR（表示は DN のまま：ATA29_32 p.666）。alternate の subsystem が空中に固着すると alternate だけ空中、AIR/GND SYSTEM（FCOM p.1521）、10 秒で STATUS A/G DISAGREE（ATA29_32 p.338、p.341）。primary も固着すると両方が空中になり A/G DISAGREE は消える（地上で系統は空中として動く：QRH 14.1）。上の EICAS と STATUS ページを撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/gear/air_ground/alt_gnd",
      "laminar/B747/gear/air_ground/pri_air", "laminar/B747/gear/air_ground/alt_air",
      "laminar/B747/air/press/mode", "laminar/B747/electrical/bus/bat_main" ] },
    { "do": "check", "note": "primary は地上", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 1 },
    { "do": "check", "note": "alternate も地上", "dref": "laminar/B747/gear/air_ground/alt_gnd", "op": "==", "value": 1 },
    { "do": "check", "note": "AIR/GND SYSTEM は出ていない", "dref": "laminar/B747/CAS/advisory_status[5]", "op": "==", "value": 0 },

    { "do": "mark", "note": "位置の検知の片系統" },
    { "do": "set", "note": "ノーズギアの位置の検知の片系統の故障", "dref": "laminar/B747/gear/fail/position_sensor[0]", "value": 1 },
    { "do": "wait", "note": "STATUS GEAR MONITOR（ATA29_32 p.666）", "dref": "laminar/B747/CAS/status_status[140]", "op": "==", "value": 1, "timeout": 3, "cite": "ATA29_32 p.666" },
    { "do": "check", "note": "ノーズギアの表示は DN のまま（もう片方の系統）", "dref": "laminar/B747/gear/gear_position/annun_gear[0]", "op": "==", "value": 1 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/gear/fail/position_sensor[0]", "value": 0 },
    { "do": "wait", "note": "GEAR MONITOR が消える", "dref": "laminar/B747/CAS/status_status[140]", "op": "==", "value": 0, "timeout": 3 },

    { "do": "mark", "note": "alternate の subsystem が空中に固着" },
    { "do": "set", "note": "alternate の subsystem が空中に固着", "dref": "laminar/B747/gear/fail/air_gnd[1]", "value": 1 },
    { "do": "wait", "note": "AIR/GND SYSTEM（FCOM p.1521）", "dref": "laminar/B747/CAS/advisory_status[5]", "op": "==", "value": 1, "timeout": 3, "cite": "FCOM p.1521" },
    { "do": "check", "note": "alternate は空中", "dref": "laminar/B747/gear/air_ground/alt_air", "op": "==", "value": 1 },
    { "do": "check", "note": "primary は地上のまま", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 7 },
    { "do": "check", "note": "10 秒たつまで A/G DISAGREE は出ない", "dref": "laminar/B747/CAS/status_status[139]", "op": "==", "value": 0 },
    { "do": "wait", "note": "10 秒で STATUS A/G DISAGREE（ATA29_32 p.338）", "dref": "laminar/B747/CAS/status_status[139]", "op": "==", "value": 1, "timeout": 6, "cite": "ATA29_32 p.338" },
    { "do": "cas", "note": "AIR/GND SYSTEM" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_air_gnd_system" },
    { "do": "set", "note": "下の EICAS を STATUS に", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "status_ag_disagree" },

    { "do": "mark", "note": "primary も空中に固着" },
    { "do": "set", "note": "primary の subsystem も空中に固着", "dref": "laminar/B747/gear/fail/air_gnd[0]", "value": 1 },
    { "do": "wait", "note": "primary も空中（地上で系統は空中として動く：QRH 14.1）", "dref": "laminar/B747/gear/air_ground/pri_air", "op": "==", "value": 1, "timeout": 3, "cite": "QRH 14.1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "両方が空中で一致：A/G DISAGREE は消える", "dref": "laminar/B747/CAS/status_status[139]", "op": "==", "value": 0 },
    { "do": "check", "note": "AIR/GND SYSTEM は出たまま", "dref": "laminar/B747/CAS/advisory_status[5]", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "両方が空中のとき（地上）", "drefs": [
      "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/gear/air_ground/alt_gnd", "laminar/B747/air/press/mode" ] },
    { "do": "cas", "note": "両方が空中" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/gear/fail/air_gnd[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/gear/fail/air_gnd[1]", "value": 0 },
    { "do": "wait", "note": "primary が地上に戻る", "dref": "laminar/B747/gear/air_ground/pri_gnd", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "alternate も地上", "dref": "laminar/B747/gear/air_ground/alt_gnd", "op": "==", "value": 1 },
    { "do": "check", "note": "AIR/GND SYSTEM が消える", "dref": "laminar/B747/CAS/advisory_status[5]", "op": "==", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
