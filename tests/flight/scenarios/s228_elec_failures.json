    { "do": "set", "note": "IDG 4 の故障", "dref": "laminar/B747/electrical/fail/drive[3]", "value": 1 },
    { "do": "set", "note": "TRU 1 の故障", "dref": "laminar/B747/electrical/fail/tru[0]", "value": 1 },
    { "do": "set", "note": "SSB の故障", "dref": "laminar/B747/electrical/fail/ssb", "value": 1 },
    { "do": "set", "note": "main の充電器の故障", "dref": "laminar/B747/electrical/fail/charger[0]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "DRIVE 4 灯", "dref": "laminar/B747/electrical/light/drive[3]", "op": "==", "value": 1, "cite": "LH24 p.72-73" },
    { "do": "check", "note": "ELEC DRIVE 4（advisory）", "dref": "laminar/B747/CAS/advisory_status[99]", "op": "==", "value": 1, "cite": "FCOM p.821" },
    { "do": "check", "note": "発電機 4 は線上のまま（109、SB 前）", "dref": "laminar/B747/electrical/breaker/gcb[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS ELEC DRIVE 4", "dref": "laminar/B747/CAS/status_status[103]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS ELEC TR UNIT", "dref": "laminar/B747/CAS/status_status[106]", "op": "==", "value": 1, "cite": "LH24 p.184" },
    { "do": "check", "note": "DC bus 1 は tie から", "dref": "laminar/B747/electrical/bus/dc[0]", "op": "==", "value": 1 },
    { "do": "check", "note": ">ELEC SSB OPEN", "dref": "laminar/B747/CAS/advisory_status[104]", "op": "==", "value": 1, "cite": "FCOM p.822" },
    { "do": "check", "note": "SSB 開", "dref": "laminar/B747/electrical/breaker/ssb", "op": "==", "value": 0 },
    { "do": "wait", "note": "BAT CHARGER MAIN（EIU の遅れの後：推定 10 秒）", "dref": "laminar/B747/CAS/status_status[104]", "op": "==", "value": 1, "timeout": 15, "cite": "LH24 p.196" },
    { "do": "cas", "note": "IDG 4、TRU 1、SSB、充電器" },
    { "do": "set", "note": "下の EICAS に STATUS ページ", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "sleep", "seconds": 1 },
