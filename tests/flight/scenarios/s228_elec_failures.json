    { "do": "check", "note": "ELEC AC BUS 3（caution）", "dref": "laminar/B747/CAS/caution_status[17]", "op": "==", "value": 1, "cite": "FCOM p.821" },
    { "do": "check", "note": "ELEC GEN OFF 3 は出ない（AC BUS 3 の表示中）", "dref": "laminar/B747/CAS/advisory_status[102]", "op": "==", "value": 0 },
    { "do": "check", "note": "DC bus 3 は DC の tie から", "dref": "laminar/B747/electrical/bus/dc[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC bus 4 はある", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 1 },
    { "do": "cas", "note": "AC bus 3 の故障" },
    { "do": "shot", "name": "elec_bus3_fault" },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_bus3_fault" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/electrical/fail/bus[2]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "BTB 3 は開いたまま（auto reclose なし）", "dref": "laminar/B747/electrical/breaker/btb[2]", "op": "==", "value": 0, "cite": "LH24 p.102" },
    { "do": "switch", "note": "BUS TIE 3 OFF", "dref": "laminar/B747/button_switch/position[20]", "value": 0, "cmd": "laminar/B747/button_switch/elec_bus_tie_3" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "BUS TIE 3 AUTO", "dref": "laminar/B747/button_switch/position[20]", "value": 1, "cmd": "laminar/B747/button_switch/elec_bus_tie_3" },
    { "do": "wait", "note": "AC bus 3 が戻る（同期バスから）", "dref": "laminar/B747/electrical/bus/ac[2]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "switch", "note": "GEN CONT 3 OFF", "dref": "laminar/B747/button_switch/position[24]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_3" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "GEN CONT 3 ON", "dref": "laminar/B747/button_switch/position[24]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_3" },
    { "do": "wait", "note": "発電機 3 が戻る", "dref": "laminar/B747/electrical/breaker/gcb[2]", "op": "==", "value": 1, "timeout": 5 },

