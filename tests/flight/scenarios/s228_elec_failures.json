    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "GEN CONT 2 ON（故障のまま）", "dref": "laminar/B747/button_switch/position[23]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_2" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "故障のままでは戻らない", "dref": "laminar/B747/electrical/breaker/gcb[1]", "op": "==", "value": 0, "cite": "LH24 p.106" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/electrical/fail/gen[1]", "value": 0 },
    { "do": "switch", "note": "GEN CONT 2 OFF", "dref": "laminar/B747/button_switch/position[23]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_2" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "GEN CONT 2 ON", "dref": "laminar/B747/button_switch/position[23]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_2" },
    { "do": "wait", "note": "発電機 2 が戻る", "dref": "laminar/B747/electrical/breaker/gcb[1]", "op": "==", "value": 1, "timeout": 5 },

    { "do": "mark", "note": "AC bus 3 の故障" },
    { "do": "set", "note": "AC bus 3 の故障", "dref": "laminar/B747/electrical/fail/bus[2]", "value": 1 },
    { "do": "wait", "note": "AC bus 3 が死ぬ", "dref": "laminar/B747/electrical/bus/ac[2]", "op": "==", "value": 0, "timeout": 5 },
