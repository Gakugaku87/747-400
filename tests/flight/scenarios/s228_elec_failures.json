{
  "name": "s228_elec_failures",
  "description": "電源の故障の入力（2026-11-04、故障の窓の F0：notes/ATA-24.md §11）の X-Plane での確認、空中。銚子沖の 10,000 ft・約 250 kt で開始（A/P は空中開始の初期化）。発電機 2 の故障：GCB 2 が開き、BTB は閉じ直して AC bus 2 は同期バスから、ELEC GEN OFF 2 と GEN OFF 2 灯（LH24 p.102、p.106、FCOM p.798）。故障のまま GEN CONT 2 を入れ直しても戻らず、故障を消して入れ直すと戻る。AC bus 3 の故障：BTB 3 と GCB 3 が開き、AC bus 3 が死んで ELEC AC BUS 3、DC bus 3 は DC の tie から（LH24 p.102）。故障を消して BUS TIE 3 と GEN CONT 3 を入れ直すと戻る。IDG 4：DRIVE 4 灯、ELEC DRIVE 4 と STATUS（LH24 p.72-73）。TRU 1：STATUS ELEC TR UNIT、DC bus 1 は tie から（p.184）。SSB の故障：>ELEC SSB OPEN（FCOM p.822）。main の充電器：BAT CHARGER MAIN（p.196）。ELEC の synoptic、STATUS ページ、頭上パネルを撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 148.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
