    { "do": "wait", "note": "GCB 2 開", "dref": "laminar/B747/electrical/breaker/gcb[1]", "op": "==", "value": 0, "timeout": 5, "cite": "LH24 p.102, p.106" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "BTB 2 は閉（auto reclose）", "dref": "laminar/B747/electrical/breaker/btb[1]", "op": "==", "value": 1, "cite": "LH24 p.102" },
    { "do": "check", "note": "AC bus 2 は同期バスから", "dref": "laminar/B747/electrical/bus/ac[1]", "op": "==", "value": 1, "cite": "FCOM p.798" },
    { "do": "check", "note": "ELEC GEN OFF 2（advisory）", "dref": "laminar/B747/CAS/advisory_status[101]", "op": "==", "value": 1, "cite": "FCOM p.822" },
    { "do": "check", "note": "ELEC AC BUS 2 は出ない", "dref": "laminar/B747/CAS/caution_status[16]", "op": "==", "value": 0 },
    { "do": "check", "note": "GEN OFF 2 灯", "dref": "laminar/B747/electrical/light/gen_off[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の発電機 2 も切れる", "dref": "sim/cockpit2/electrical/generator_on[1]", "op": "==", "value": 0 },
