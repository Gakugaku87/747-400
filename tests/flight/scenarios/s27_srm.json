{
  "name": "s27_srm",
  "description": "SRM（4-1 段 2a：外側エルロンのロックアウトとラダー比変換器）の X-Plane での確認、空中。10,000 ft の空中で開始し（A/P は ALT HOLD）、A/P（ALT HOLD）と A/T（SPD 280 kt）を入れて IAS 255 kt を超えてから、クリーンで外側エルロンがロック（ATA27 p.106）、ラダー比は速度の表で上下とも同じ（ATA27 p.637 の図、推定で読んだ点）。ラダートリムいっぱいでも舵角は比で制限され、ペダルとトリムの和に比がかかる（前はそれぞれに比がかかり和は制限されず、空中では X-Plane の total_heading_ratio に入るトリムの 0.3 倍も足されていた）。フラップ 1 で前縁 group A が出るとロックが外れ、UP でまたロック。上のラダー比変換器のアクチュエータの故障（laminar/B747/flt_ctrls/fail/rrc）と X-Plane の ADC の故障で目標が変わり、RUD RATIO SNGL と STATUS RUDDER RATIO、下は 209 kt の位置（ATA27 p.640）。ロックアウトのアクチュエータの故障で、45 秒で SRM R、さらに 45 秒で AILERON LOCKOUT（ATA27 p.110）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 155 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 20, "note": "空中開始の揺れが収まるのを待つ（空中開始の速度は 0〜255 kt とまちまち）" },
    { "do": "set", "note": "MCP 速度 280 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 280 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "set", "note": "MCP 方位 347（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 347 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "IAS 255 kt 超", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 255, "timeout": 300 },
    { "do": "sleep", "seconds": 6, "note": "ロックとラダー比のアクチュエータが動き終わる" },
    { "do": "snapshot", "note": "クリーン・高速", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/cockpit2/gauges/indicators/altitude_ft_pilot",
      "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/mach_pilot",
      "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "laminar/B747/flt_ctrls/right_outer_aileron_lockout",
      "laminar/B747/flt_ctrls/rudder_ratio_upr", "laminar/B747/flt_ctrls/rudder_ratio_lwr", "laminar/B747/flt_ctrls/rudder_input",
      "laminar/B747/flt_ctrls/rudder_upr_pos", "laminar/B747/flt_ctrls/l_aileron_outer", "laminar/B747/flt_ctrls/l_aileron_inner",
      "laminar/B747/flt_ctrls/fcu/slat[0]" ] },
    { "do": "check", "note": "クリーンで 238 kt 超：左外側エルロンをロック", "dref": "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "op": "<", "value": 0.01 },
    { "do": "check", "note": "右も（向きが逆の比）", "dref": "laminar/B747/flt_ctrls/right_outer_aileron_lockout", "op": "between", "value": [-0.01, 0.01] },
    { "do": "check", "note": "ラダー比（上）：240〜300 kt の表の値", "dref": "laminar/B747/flt_ctrls/rudder_ratio_upr", "op": "between", "value": [0.3, 0.56] },
    { "do": "check", "note": "ラダー比（下）も同じ範囲", "dref": "laminar/B747/flt_ctrls/rudder_ratio_lwr", "op": "between", "value": [0.3, 0.56] },

    { "do": "mark", "note": "ラダートリムいっぱい" },
    { "do": "set", "note": "ラダートリム右いっぱい", "dref": "sim/cockpit2/controls/rudder_trim", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "トリムいっぱい", "drefs": [ "laminar/B747/flt_ctrls/rudder_input", "laminar/B747/flt_ctrls/rudder_ratio_upr",
      "laminar/B747/flt_ctrls/rudder_upr_pos", "laminar/B747/flt_ctrls/rudder_lwr_pos", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "check", "note": "ペダルとトリムの和（ペダル 0）：0.8", "dref": "laminar/B747/flt_ctrls/rudder_input", "op": "between", "value": [0.79, 0.81] },
    { "do": "check", "note": "上のラダーは 0.8 × 32° × 比（前はトリム 25.6° に古い比、16〜20°）", "dref": "laminar/B747/flt_ctrls/rudder_upr_pos", "op": "between", "value": [7, 14.5] },
    { "do": "set", "note": "ラダートリムを戻す", "dref": "sim/cockpit2/controls/rudder_trim", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "フラップ 1 でロックが外れる" },
    { "do": "set", "note": "レバー 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.167 },
    { "do": "sleep", "seconds": 12 },
    { "do": "check", "note": "group A 展開", "dref": "laminar/B747/flt_ctrls/fcu/slat[0]", "op": ">", "value": 0.99 },
    { "do": "check", "note": "group A が出ればロックが外れる（ATA27 p.106）", "dref": "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "op": ">", "value": 0.99 },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 13 },
    { "do": "check", "note": "group A が入るとまたロック", "dref": "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "op": "<", "value": 0.01 },

    { "do": "mark", "note": "上のラダー比変換器の故障" },
    { "do": "set", "note": "上の RRC のアクチュエータの故障", "dref": "laminar/B747/flt_ctrls/fail/rrc[0]", "value": 1 },
    { "do": "set", "note": "X-Plane の ADC の故障（エアデータを失う）", "dref": "sim/operation/failures/rel_adc_comp", "value": 6 },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "RRC の故障", "drefs": [ "laminar/B747/flt_ctrls/rudder_ratio_upr", "laminar/B747/flt_ctrls/rudder_ratio_lwr",
      "laminar/B747/CAS/advisory_status[262]", "laminar/B747/CAS/advisory_status[261]", "laminar/B747/CAS/status_status[89]" ] },
    { "do": "check", "note": "目標が 329 kt の位置に変わり、動かない：RUD RATIO SNGL（FCOM p.957）", "dref": "laminar/B747/CAS/advisory_status[262]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS RUDDER RATIO", "dref": "laminar/B747/CAS/status_status[89]", "op": "==", "value": 1 },
    { "do": "check", "note": "下は 209 kt の位置（ATA27 p.640）：(32 − 27 × 0.456) / 32", "dref": "laminar/B747/flt_ctrls/rudder_ratio_lwr", "op": "between", "value": [0.6, 0.63] },
    { "do": "cas", "note": "RUD RATIO SNGL" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_rud_ratio" },
    { "do": "set", "note": "ADC の故障を戻す", "dref": "sim/operation/failures/rel_adc_comp", "value": 0 },
    { "do": "set", "note": "RRC の故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/rrc[0]", "value": 0 },
    { "do": "sleep", "seconds": 5, "note": "エアデータを失う間はロックが外れる（空中の既定）。戻ってまたロックするのを待つ" },
    { "do": "check", "note": "エアデータが戻ってまたロック", "dref": "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "op": "<", "value": 0.01 },

    { "do": "mark", "note": "ロックアウトのアクチュエータの故障" },
    { "do": "set", "note": "ロックアウトのアクチュエータの故障（ロックのまま）", "dref": "laminar/B747/flt_ctrls/fail/lockout_actuator", "value": 1 },
    { "do": "set", "note": "レバー 1（ロックを外す指令）", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.167 },
    { "do": "sleep", "seconds": 50 },
    { "do": "check", "note": "動かない：まだロック", "dref": "laminar/B747/flt_ctrls/left_outer_aileron_lockout", "op": "<", "value": 0.01 },
    { "do": "check", "note": "45 秒では SRM R に移るだけで、AILERON LOCKOUT はまだ", "dref": "laminar/B747/CAS/advisory_status[3]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 45 },
    { "do": "check", "note": "SRM R でも動かない：AILERON LOCKOUT（FCOM p.957、ATA27 p.110）", "dref": "laminar/B747/CAS/advisory_status[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS AILERON LOCKOUT", "dref": "laminar/B747/CAS/status_status[88]", "op": "==", "value": 1 },
    { "do": "cas", "note": "AILERON LOCKOUT" },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/lockout_actuator", "value": 0 },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "name": "forward" }
  ]
}
