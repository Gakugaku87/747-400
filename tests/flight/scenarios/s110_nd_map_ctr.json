{
  "name": "s110_nd_map_ctr",
  "description": "ND の MAP CTR を実機どおりに（5-2 の残り、2026-10-28 の利用者の決定「NDのMAP CTRのレンジの件は実機通りの仕様で」）の X-Plane での確認、空中。ミュンヘン（EDDM）26R の進入路の上 14 NM・5,000 ft・160 kt・263° で開始（s70 と同じ）。CDU で EDDF の 25C から EDDM・ILS26R の経路を入れて EXEC。MAP 40 NM（X-Plane の地図の範囲 2、拡大の航跡線）から CTR：選んだ範囲が全周のローズの円まで（FCOM p.1009 の図：半分の範囲の目盛がローズの半径の半分）。X-Plane の地図は 1 段上の 3（縮尺が半分）、地図の記号も拡大の半分の縮尺（26R は 2.15 NM で 12 px の 3 コマ目）、MAP CTR の航跡線と範囲の目盛（半分の範囲 20 の数字が上と下に：FCOM p.1143）、方位の印 ▽ の先がローズの外縁に触れる（FCOM p.1142：前は 9 px 外に浮いていた）。範囲のつまみで 10 NM（X-Plane は 1）、つまみの dataref を直接書いて 320 NM（X-Plane は 6、全体の大きさ）と 640 NM（X-Plane は 6 のまま、パネルの半分の大きさの地図）。VOR CTR は選んだ範囲のまま。拡大の MAP に戻すと X-Plane の範囲も戻る。副操縦士の ND も MAP CTR で 1 段上。ND を撮る（経路の線が点の記号を通ること、ローズ、航跡線と数字、▽）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 48.393705, "longitude": 12.170053, "elevation_in_meters": 1524.0, "heading_true": 263.4, "speed_in_meters_per_second": 82.3 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位は今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 0, "rel": "hdg0", "round": 1 },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "範囲 40 NM（つまみの dataref だけ：X-Plane の範囲は表示のグルーが合わせる）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "check", "note": "記録：読み直した直後の X-Plane の FMS の scratchpad", "dref": "sim/cockpit2/radios/indicators/fms_cdu1_text_line13", "op": "!=", "value": "#" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<FMC（IDENT）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "経路（FMC）：EDDF の 25C から EDDM", "keys": ["RTE", "EDDF", "L1", "EDDM", "R1", "25C", "L2"] },
    { "do": "check", "note": "RUNWAY RW25C", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "RW25C" },
    { "do": "cdu", "note": "DEP ARR（DEP/ARR INDEX）から EDDM の ARRIVALS、4 番目の進入 ILS26R（遷移なし）", "keys": ["DEPARR", "R2", "R4"] },
    { "do": "check", "note": "<SEL>ILS26R（FCOM p.1401）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<SEL>ILS26R" },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "wait", "note": "40 NM：EDDM の 26R を縮尺どおりに", "dref": "laminar/B747/nd/capt/apt/rwy_show[1]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },

    { "do": "mark", "note": "MAP 40 NM" },
    { "do": "check", "note": "X-Plane の地図の範囲は選んだ 40 NM の 2", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 2 },
    { "do": "check", "note": "拡大の航跡線", "dref": "laminar/B747/nd/capt/trk_line", "op": "==", "value": 1 },
    { "do": "check", "note": "MAP CTR の航跡線は出さない", "dref": "laminar/B747/nd/capt/trk_line_ctr", "op": "==", "value": 0 },
    { "do": "check", "note": "26R は 2.15 NM で 25 px、6 コマ目", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "==", "value": 5 },
    { "do": "snapshot", "note": "MAP 40 NM", "drefs": [ "laminar/B747/nd/capt/apt/rwy_distance[1]", "laminar/B747/nd/capt/apt/rwy_heading[1]", "laminar/B747/nd/capt/text/distance[0]", "laminar/B747/nd/capt/text/heading[0]", "laminar/B747/nd/capt/hdg_ptr", "laminar/B747/pfd/capt/hdg_deg", "laminar/B747/pfd/capt/trk_deg" ] },
    { "do": "shot", "name": "nd_map_40" },

    { "do": "mark", "note": "MAP CTR 40 NM" },
    { "do": "cmd", "note": "CTR（MAP CTR）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "MAP CTR", "dref": "laminar/B747/nd/map_center/capt", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の地図は 1 段上の 80 NM の 3（縮尺が半分：選んだ 40 NM がローズの円まで）", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 3 },
    { "do": "check", "note": "X-Plane の地図は全体の大きさ", "dref": "laminar/B747/nd/capt/xp_map_half", "op": "==", "value": 0 },
    { "do": "check", "note": "MAP CTR の航跡線と範囲の目盛（FCOM p.1143）", "dref": "laminar/B747/nd/capt/trk_line_ctr", "op": "==", "value": 1 },
    { "do": "check", "note": "拡大の航跡線は出さない", "dref": "laminar/B747/nd/capt/trk_line", "op": "==", "value": 0 },
    { "do": "check", "note": "目盛の数字は半分の範囲 20", "dref": "laminar/B747/nd/range_display_capt", "op": "==", "value": 20 },
    { "do": "check", "note": "26R は拡大の半分の縮尺で 12 px、3 コマ目", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "==", "value": 2 },
    { "do": "check", "note": "26R の中点は 13 NM 前後：40 NM を 320 単位で 100 単位前後（拡大は 640 単位）", "dref": "laminar/B747/nd/capt/apt/rwy_distance[1]", "op": "between", "value": [80, 130] },
    { "do": "check", "note": "▽（方位の印）", "dref": "laminar/B747/nd/capt/hdg_ptr", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "MAP CTR 40 NM", "drefs": [ "laminar/B747/nd/capt/apt/rwy_distance[1]", "laminar/B747/nd/capt/apt/rwy_heading[1]", "laminar/B747/nd/capt/text/distance[0]", "laminar/B747/nd/capt/text/heading[0]", "sim/cockpit2/EFIS/map_range", "laminar/B747/pfd/capt/hdg_deg", "laminar/B747/pfd/capt/trk_deg" ] },
    { "do": "shot", "name": "nd_ctr_40" },

    { "do": "mark", "note": "MAP CTR 10, 320 and 640 NM" },
    { "do": "switch", "note": "つまみで 10 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 0, "cmd": "laminar/B747/nd/range/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/range/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "X-Plane の地図は 20 NM の 1", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 1 },
    { "do": "check", "note": "目盛の数字 5", "dref": "laminar/B747/nd/range_display_capt", "op": "==", "value": 5 },
    { "do": "check", "note": "26R（13 NM 前後）はローズの外：輪郭なし", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "==", "value": -1 },
    { "do": "shot", "name": "nd_ctr_10" },
    { "do": "set", "note": "つまみの dataref を直接 320 NM（X-Plane の範囲は表示のグルーが合わせる）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "X-Plane の地図は 640 NM の 6", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 6 },
    { "do": "check", "note": "全体の大きさ", "dref": "laminar/B747/nd/capt/xp_map_half", "op": "==", "value": 0 },
    { "do": "check", "note": "EDDF の空港記号（約 160 NM：ローズの半径の半分ほど）", "dref": "laminar/B747/nd/capt/apt/sym[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "EDDF は 320 単位で 320 NM の縮尺：160 単位前後", "dref": "laminar/B747/nd/capt/apt/distance[0]", "op": "between", "value": [130, 190] },
    { "do": "shot", "name": "nd_ctr_320" },
    { "do": "set", "note": "640 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 6 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "X-Plane の地図は 640 NM の 6 のまま（上の段が無い）", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 6 },
    { "do": "check", "note": "パネルの半分の大きさの X-Plane の地図", "dref": "laminar/B747/nd/capt/xp_map_half", "op": "==", "value": 1 },
    { "do": "check", "note": "目盛の数字 320", "dref": "laminar/B747/nd/range_display_capt", "op": "==", "value": 320 },
    { "do": "check", "note": "EDDF は 80 単位前後", "dref": "laminar/B747/nd/capt/apt/distance[0]", "op": "between", "value": [65, 95] },
    { "do": "shot", "name": "nd_ctr_640" },
    { "do": "set", "note": "40 NM に戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "半分の大きさの地図をやめる", "dref": "laminar/B747/nd/capt/xp_map_half", "op": "==", "value": 0 },

    { "do": "mark", "note": "VOR CTR, back to MAP, the F/O" },
    { "do": "switch", "note": "VOR CTR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "VOR CTR：X-Plane の範囲は選んだ 2 のまま", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 2 },
    { "do": "check", "note": "MAP CTR の航跡線は出さない", "dref": "laminar/B747/nd/capt/trk_line_ctr", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_vor_ctr" },
    { "do": "switch", "note": "MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAP CTR に戻る", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 3 },
    { "do": "cmd", "note": "CTR を戻す（拡大）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "拡大の MAP 40 NM：X-Plane の範囲も 2 に戻る", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 2 },
    { "do": "check", "note": "26R は拡大の縮尺に戻る", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "between", "value": [4, 6] },
    { "do": "set", "note": "副操縦士の ND を 40 NM", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "cmd", "note": "副操縦士の CTR", "name": "laminar/B747/nd/center/fo/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "副操縦士の MAP CTR：X-Plane の副操縦士の範囲は 3", "dref": "sim/cockpit2/EFIS/map_range_copilot", "op": "==", "value": 3 },
    { "do": "check", "note": "副操縦士の MAP CTR の航跡線", "dref": "laminar/B747/nd/fo/trk_line_ctr", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の X-Plane の範囲は 2 のまま", "dref": "sim/cockpit2/EFIS/map_range", "op": "==", "value": 2 },
    { "do": "cmd", "note": "副操縦士の CTR を戻す", "name": "laminar/B747/nd/center/fo/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士も 2 に戻る", "dref": "sim/cockpit2/EFIS/map_range_copilot", "op": "==", "value": 2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
