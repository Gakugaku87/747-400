{
  "name": "s161_navrad",
  "description": "6-1/6-2 段 10b（VOR・ADF の同調と NAV RADIO の VOR・ADF）の X-Plane での確認。空中、成田の北の FL350（機体を読み直す）。経路なしで VOR L・R は A（DME-DME の組の局：推定）。RJAA→RJBB の経路（XAC・SPENS・BOKJO）を ACTIVATE すると VOR L は R の XAC 113.10（下流の 250 NM 内の VOR：FCOM p.1303）、VOR R は A。VOR R に NRE で M 117.90、CRS はダッシュ、180 で受信機のコース、RADIAL、ND の VOR R のコースの線（MAP）、DELETE で A に戻る（FCOM p.1304、FMSPG p.207）。ADF L に 350、ADF R に 1304.5B で BFO、A で ANT（同調の文字 A）、DELETE で ADF。CDU と ND を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "sleep", "seconds": 12, "note": "DME の局を探す（10 秒ごと）と同調" },

    { "do": "mark", "note": "経路なし：A" },
    { "do": "cdu", "note": "NAV RAD", "keys": ["NAVRAD"] },
    { "do": "check", "note": "NAV RADIO", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "NAV RADIO" },
    { "do": "check", "note": "VOR L・R とも A の小字（FCOM p.1303）", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^      A {10}A" },
    { "do": "check", "note": "同調の文字の VOR L・R は A", "dref": "laminar/B747/radio/tuningmodes", "op": "matches", "value": "^.AA" },
    { "do": "snapshot", "note": "A の局", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "sim/cockpit2/radios/actuators/nav_frequency_hz[2]", "sim/cockpit2/radios/actuators/nav_frequency_hz[3]" ] },

    { "do": "mark", "note": "経路：VOR L は R の XAC" },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "NAV RAD", "keys": ["NAVRAD"] },
    { "do": "check", "note": "VOR L は XAC 113.10（下流の 250 NM 内の VOR）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^113[.]10 XAC" },
    { "do": "check", "note": "VOR L は R、VOR R は A", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^      R {10}A" },
    { "do": "check", "note": "受信機 NAV 3 は 113.10", "dref": "sim/cockpit2/radios/actuators/nav_frequency_hz[2]", "op": "==", "value": 11310 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_navrad_route" },

    { "do": "mark", "note": "手動：NRE と CRS" },
    { "do": "cdu", "note": "NRE を 1R", "keys": ["NRE", "R1"] },
    { "do": "check", "note": "VOR R は M の NRE 117.90", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "NRE 117[.]90$" },
    { "do": "check", "note": "M の小字", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^.{17}M" },
    { "do": "check", "note": "CRS R はダッシュ（FCOM p.1304）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "---$" },
    { "do": "cdu", "note": "180 を 2R", "keys": ["180", "R2"] },
    { "do": "check", "note": "CRS R 180", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "180$" },
    { "do": "check", "note": "受信機 NAV 4 のコース 180", "dref": "sim/cockpit2/radios/actuators/nav_obs_deg_mag_pilot[3]", "op": "between", "value": [179.5, 180.5] },
    { "do": "check", "note": "受信機 NAV 4 は 117.90", "dref": "sim/cockpit2/radios/actuators/nav_frequency_hz[3]", "op": "==", "value": 11790 },
    { "do": "check", "note": "同調の文字の VOR R は M", "dref": "laminar/B747/radio/tuningmodes", "op": "matches", "value": "^.RM" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "RADIAL R（NRE から：局への方位 + 180）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^.{14}[0-9]{3}" },
    { "do": "snapshot", "note": "手動", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "sim/cockpit2/radios/indicators/nav_bearing_deg_mag[3]" ] },
    { "do": "shot", "name": "cdu_navrad_manual" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_vor_r_course" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },

    { "do": "mark", "note": "ADF" },
    { "do": "cdu", "note": "350 を 3L", "keys": ["350", "L3"] },
    { "do": "check", "note": "ADF L 350.0", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^350[.]0" },
    { "do": "cdu", "note": "1304.5B を 3R", "keys": ["1304.5B", "R3"] },
    { "do": "check", "note": "ADF R 1304.5", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "1304[.]5   $" },
    { "do": "check", "note": "BFO の小字（FCOM p.1303）", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "BFO$" },
    { "do": "check", "note": "受信機 ADF 2 は 1304", "dref": "sim/cockpit2/radios/actuators/adf2_frequency_hz", "op": "==", "value": 1304 },
    { "do": "cdu", "note": "A を 3R（ANT）", "keys": ["A", "R3"] },
    { "do": "check", "note": "ANT の小字", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "ANT$" },
    { "do": "check", "note": "同調の文字の ADF R は A（ND の方位の針なし）", "dref": "laminar/B747/radio/tuningmodes", "op": "matches", "value": "^.{4}A" },
    { "do": "shot", "name": "cdu_navrad_adf" },
    { "do": "cdu", "note": "DELETE を 3R", "keys": ["DEL", "R3"] },
    { "do": "check", "note": "ADF に戻る", "dref": "laminar/B747/radio/tuningmodes", "op": "matches", "value": "^.{4}M" },

    { "do": "mark", "note": "VOR R の DELETE で A に戻る" },
    { "do": "cdu", "note": "DELETE を 1R", "keys": ["DEL", "R1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "VOR R は A（FMSPG p.207）", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^.{17}A" },
    { "do": "check", "note": "CRS R は空白", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "   $" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
