{
  "name": "s327_eo_flch_accel_heavy",
  "description": "空中の片発で FL CH の上昇と加速（2026-11-12 のフルレビュー T-2：REVIEW_2026-11-12.md 案 23 の P5）。成田の北 10,000 ft・270 kt、347.5 t（s285 と同じ）、ISA の静穏。ALT HOLD・SPD で 190 秒落ち着かせ（空中開始の後の上昇）、FUEL CONTROL 2 CUTOFF、60 秒後に MCP を今の高度 + 5,000 ft・300 kt にして FL CH。加速の間 昇降率は −50 fpm を割らない（FCTM p.118 (3.30)：加速は水平に近く。FL CH でも同じと見る：推定）、高度の損は 20 ft まで（推定。spd_step.lua と同じ幅）、300 kt の 5 kt 手前まで 150 秒以内（模型は 272→340 kt で 107 秒）、その後は上昇（+300 fpm 超）",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 161 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [3901.4, 4106.8, 4928.1, 6365.5, 1232, 10287.5, 9178.6, 0, 0],
      "fueltank_weight_in_kilograms": [12989.6, 13499.4, 38075.2, 38075.2, 13499.4, 3980.6, 3980.6, 0, 0]
    },
    "weather": {
      "definition": {
        "latitude_in_degrees": 35.95,
        "longitude_in_degrees": 140.25,
        "elevation_in_meters": 0,
        "visibility_in_kilometers": 40,
        "temperature_in_degrees_celsius": 15,
        "altimeter_setting_in_hpa": 1013.25,
        "precipitation_ratio": 0,
        "clouds": [],
        "wind": [
          {"altitude_in_feet_msl": 0, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 10000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 20000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 30000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 38000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 46000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0}
        ]
      },
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "note": "空中開始の揺れを待つ", "seconds": 10 },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "check", "note": "重さは約 347.5 t（s285 と同じ）", "dref": "sim/flightmodel/weight/m_total", "op": "between", "value": [345000, 350000], "stop": true },
    { "do": "set", "note": "MCP 方位 340", "dref": "laminar/B747/autopilot/heading/degrees", "value": 340 },
    { "do": "set", "note": "MCP 速度 270 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 270 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "note": "空中開始の後の上昇が収まるのを待つ（始めの印は 200 秒より後）", "seconds": 190 },
    { "do": "record_start" },
    { "do": "snapshot", "note": "落ち着いた後", "drefs": ["sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode"] },
    { "do": "check", "note": "ALT HOLD（9）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "stop": true },
    { "do": "mark", "note": "FUEL CONTROL 2 CUTOFF" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "wait", "note": "エンジン 2 が inop", "dref": "laminar/B747/engines/inop[1]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "note": "3 発で 270 kt に落ち着く", "seconds": 60 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt1" },
    { "do": "set", "note": "MCP 高度：今の高度 + 5,000 ft（100 ft に丸める：XTLua の dataref に Web API は小数を書けない。2026-11-13 の 1 回目は 400 で入らず、FL CH が古い高度へ向かった）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000, "rel": "alt1", "round": 100 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 5000, "rel": "alt1", "round": 100 },
    { "do": "set", "note": "MCP 速度 300 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 300 },
    { "do": "sleep", "seconds": 4 },
    { "do": "cmd", "note": "FL CH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FL CH（8）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8, "timeout": 10, "stop": true },
    { "do": "mark", "note": "FL CH：270 から 300 kt へ" },
    { "do": "watch", "note": "295 kt まで（150 秒以内）昇降率は −50 fpm を割らない（推定）", "dref": "sim/flightmodel/position/vh_ind_fpm", "min": -50, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 295 }, "timeout": 150, "cite": "FCTM p.118 (3.30)" },
    { "do": "check", "note": "FL CH を押した時より 20 ft より多く下がっていない（推定）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": -20, "rel": "alt1" },
    { "do": "snapshot", "note": "295 kt に届いた時", "drefs": ["sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode"] },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "その後は上昇（+300 fpm 超）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 300 },
    { "do": "check", "note": "300 kt の ±5 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [295, 305] },
    { "do": "record_stop" }
  ]
}
