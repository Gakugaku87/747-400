{
  "name": "s304_oneshot_springs",
  "description": "ばね戻りのスイッチを一度きりのコマンドで押す（2026-11-12 のフルレビュー SM-2：案 13）と、ACP の SAT R の受信灯（SM-4：案 27）の X-Plane での確認。RJAA の地上。IND LTS TEST、OUTFLOW OPEN・CLOSE、PTT C、PACK RST を一度きりのコマンド（Web API の長さ 0）で押す：どれも自分で戻る（前は押されたまま）。ACP L の SAT R の受信灯が点く（前は変数名の誤記で点かなかった）",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "始め", "drefs": [ "laminar/B747/toggle_switch/position[13]", "laminar/B747/toggle_switch/position[22]", "laminar/B747/ap/toggle_sw_pos[1]", "laminar/B747/button_switch/position[42]" ] },
    { "do": "mark", "note": "IND LTS TEST（一度きりの押し）" },
    { "do": "cmd", "name": "laminar/B747/toggle_switch/ind_light_up" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "一度きりの TEST の 3 秒後、IND LTS は BRT（0）に戻る（前は TEST のまま）", "dref": "laminar/B747/toggle_switch/position[13]", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "灯は TEST", "drefs": [ "laminar/B747/toggle_switch/position[13]", "laminar/B747/annunciator/brightness_ratio[168]", "laminar/B747/annunciator/brightness_ratio[169]", "sim/cockpit2/annunciators/master_warning", "sim/cockpit2/annunciators/master_caution" ] },
    { "do": "cmd", "note": "DIM 側（押して離す）", "name": "laminar/B747/toggle_switch/ind_light_down", "duration": 0.3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "DIM 側の後", "drefs": [ "laminar/B747/toggle_switch/position[13]" ] },
    { "do": "mark", "note": "OUTFLOW OPEN、次に CLOSE（どちらも一度きりの押し）" },
    { "do": "cmd", "name": "laminar/B747/toggle_switch/outflow_valve_open" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "一度きりの OPEN の後、OUTFLOW のスイッチは中央（0）に戻る", "dref": "laminar/B747/toggle_switch/position[22]", "op": "==", "value": 0 },
    { "do": "cmd", "name": "laminar/B747/toggle_switch/outflow_valve_close" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "続く CLOSE でスイッチは OPEN を離れる（1 でない）", "dref": "laminar/B747/toggle_switch/position[22]", "op": "<", "value": 1 },
    { "do": "cmd", "note": "OPEN を押して離す", "name": "laminar/B747/toggle_switch/outflow_valve_open", "duration": 0.3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "押して離した OPEN の後", "drefs": [ "laminar/B747/toggle_switch/position[22]" ] },
    { "do": "mark", "note": "PTT C の R/T（一度きりの押し）" },
    { "do": "cmd", "name": "laminar/B747/ap_C/ptt/sel_switch_up" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "PTT C は中央（0）に戻る（前は R/T のまま。2026-11-13 の 1 回目は動きの残りの 3.7e-32 で == 0 が落ちた）", "dref": "laminar/B747/ap/toggle_sw_pos[1]", "op": "<", "value": 0.01 },
    { "do": "cmd", "name": "laminar/B747/ap_L/ptt/sel_switch_up" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "PTT L は中央（0）に戻る（前からの自分のタイマー）", "dref": "laminar/B747/ap/toggle_sw_pos[0]", "op": "<", "value": 0.01 },
    { "do": "mark", "note": "PACK RST（一度きりの押しを 2 回）" },
    { "do": "cmd", "name": "laminar/B747/button_switch/temp_pack_rst" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "PACK RST は離れる（0。前は押されたまま）", "dref": "laminar/B747/button_switch/position[42]", "op": "==", "value": 0 },
    { "do": "mark", "note": "ACP L：SAT L と SAT R の受信灯" },
    { "do": "cmd", "name": "laminar/B747/ap_L/sat_L/audio_sel_switch", "duration": 0.2 },
    { "do": "cmd", "name": "laminar/B747/ap_L/sat_R/audio_sel_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "SAT L と SAT R", "drefs": [ "laminar/B747/ap_L/sat_L/audio_status", "laminar/B747/ap_L/sat_R/audio_status", "laminar/B747/annunciator/brightness_ratio[168]", "laminar/B747/annunciator/brightness_ratio[169]" ] },
    { "do": "check", "note": "SAT L の受信灯が点く（IND LTS は上で DIM にしたので 0.4：B747.90.ind_model.lua。消えていれば 0）", "dref": "laminar/B747/annunciator/brightness_ratio[168]", "op": ">", "value": 0.3 },
    { "do": "check", "note": "SAT R の受信灯が点く（前は点かなかった：変数名の誤記。DIM で 0.4）", "dref": "laminar/B747/annunciator/brightness_ratio[169]", "op": ">", "value": 0.3 }
  ]
}
