{
  "name": "s200_atc_emergency",
  "description": "6-1・6-2 段 12g4（EMERGENCY）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO に戻す、保存はしない）。RTE 1（RJAA、XAC、SPENS、RJBB）をアクティブにし、MCP 高度 10,000 ft。ATC INDEX の <EMERGENCY で EMERGENCY REPORT（題、<MAYDAY と PAN>、DIVERT TO の <RJBB、DESCEND TO の <10000）、SOB に 395 で FUEL REMAINING の時間、<MAYDAY で VERIFY EMERGENCY（MAYDAY MAYDAY MAYDAY、SOB と燃料の行、CONTINUED）、2 ページ目の DATA LINK NO COMM（AutoATC の無いこの PC）、<EMERGENCY で戻って ERASE EMERGENCY を確かめる。ATC COMM が無いので ATC キーの長押しは EMERGENCY REPORT にならない。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "RTE：RJAA から RJBB、XAC と SPENS", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL"] },
    { "do": "cdu", "note": "LEGS、ACTIVATE、EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "ATC キー（LOGON/STATUS）、<INDEX、<EMERGENCY", "keys": ["ATC", "L6", "L1"] },
    { "do": "check", "note": "EMERGENCY REPORT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "EMERGENCY REPORT" },
    { "do": "check", "note": "<MAYDAY と PAN>", "dref": "laminar/B747/fms3/Line03_S", "op": "contains", "value": "<MAYDAY             PAN>" },
    { "do": "check", "note": "DIVERT TO はアクティブな目的地（FMSPG p.348）", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "<RJBB" },
    { "do": "check", "note": "DESCEND TO は MCP の高度（FMSPG p.349）", "dref": "laminar/B747/fms3/Line09_S", "op": "contains", "value": "<10000" },
    { "do": "cdu", "note": "2R の SOB に 395", "keys": ["395", "R2"] },
    { "do": "check", "note": "SOB", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "395" },
    { "do": "check", "note": "FUEL REMAINING に時間（FCOM p.730）", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "[0-9][0-9][+][0-9][0-9]" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_emergency_report" },
    { "do": "cdu", "note": "<MAYDAY", "keys": ["L1"] },
    { "do": "check", "note": "VERIFY EMERGENCY（FCOM p.729）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "VERIFY EMERGENCY" },
    { "do": "check", "note": "MAYDAY MAYDAY MAYDAY", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "MAYDAY MAYDAY MAYDAY" },
    { "do": "check", "note": "SOULS ON BOARD の行", "dref": "laminar/B747/fms3/Line06_S", "op": "contains", "value": "OF FUEL REMAINING AND" },
    { "do": "shot", "name": "cdu_verify_emergency" },
    { "do": "cdu", "note": "NEXT（SEND の欄）", "keys": ["NEXT"] },
    { "do": "check", "note": "AutoATC が無いので NO COMM", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "NO COMM" },
    { "do": "cdu", "note": "<EMERGENCY、<ERASE EMERGENCY", "keys": ["L6", "L5"] },
    { "do": "check", "note": "消えて <MAYDAY と PAN> に戻る", "dref": "laminar/B747/fms3/Line03_S", "op": "contains", "value": "<MAYDAY             PAN>" },
    { "do": "check", "note": "SOB は dashes", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "---" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
