{
  "name": "s421_ge_derate_ground",
  "description": "段 4 のレビューの ENG-3（2026-11-24 の直し 0b6f9d18）と D の「GE の減格の離陸」の地上の部分。RJAA 34L でエンジン運転中に始め（リバリー Saudia の CF6-80C2、外気温 15 ℃）、THRUST LIM で TO・TO 1・TO 2 と仮定温度を選び、EICAS の基準 N1（`display_N1_ref`）と推力の減り（`to_reduction`）を模型の値と比べる。値は海面 15 ℃ の模型のもの：TO 103.8、TO 1 101.2（5 %）、TO 2 95.7（15 %）、SEL 45 100.9（5.5 %）、D-TO 2 SEL 45 93.1（19.7 %）。前は SEL の温度での表の N1 のままで、SEL 45 が 106.0（TO より上）、減りは負だった。上昇の減格の自動選択（FCOM p.1273）も見る。Lua の誤りも確かめる",
  "livery": "Saudia",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "GE（エンジン型式 1）", "dref": "laminar/B747/engines/type", "op": "==", "value": 1, "stop": true },
    { "do": "set", "note": "気温の変更をすぐに反映（s10・s400 と同じ）", "dref": "sim/weather/region/update_immediately", "value": 1 },
    { "do": "set", "note": "海面 15.3 ℃：空港（約 43 m）で約 15 ℃（X-Plane の地上の外気温は sealevel_temperature_c を書いた分だけ動く。15 ℃ の既定の天気では ISA の減り方どおり：s02 で 15 → 14.73。40 ℃ では海面より約 2.5 ℃ 低かった：s400）", "dref": "sim/weather/region/sealevel_temperature_c", "value": 15.3 },
    { "do": "wait", "note": "OAT が約 15 ℃", "dref": "sim/cockpit2/temperature/outside_air_temp_degc", "op": "between", "value": [14.5, 15.5], "timeout": 60 },
    { "do": "record_start" },
    { "do": "cdu", "note": "CLR（前の飛行の書き込み行の文）", "keys": ["CLR"] },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 183.5、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "183.5", "L3", "170", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、THRUST LIM", "keys": ["L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM", "stop": true },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "TO", "drefs": [ "laminar/B747/engines/display_N1_ref[0]", "laminar/B747/engines/to_reduction", "laminar/B747/engine/derate/CLB", "laminar/B747/fms/thrlim/eicas", "sim/cockpit2/temperature/outside_air_temp_degc" ] },
    { "do": "check", "note": "TO：基準 N1 103.8（復行推力の表の 15 ℃）", "dref": "laminar/B747/engines/display_N1_ref[0]", "op": "between", "value": [103.3, 104.3] },
    { "do": "check", "note": "TO：減り 0", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [-0.1, 0.1] },

    { "do": "mark", "note": "TO 1" },
    { "do": "cdu", "note": "<TO 1（3L）", "keys": ["L3"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "TO 1", "drefs": [ "laminar/B747/engines/display_N1_ref[0]", "laminar/B747/engines/to_reduction", "laminar/B747/engine/derate/CLB", "laminar/B747/fms/thrlim/eicas" ] },
    { "do": "check", "note": "TO 1：EICAS の行", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "TO 1" },
    { "do": "check", "note": "TO 1：基準 N1 101.2（5 % 少ない推力：N1 のモデル。前は 102.0）", "dref": "laminar/B747/engines/display_N1_ref[0]", "op": "between", "value": [100.7, 101.7] },
    { "do": "check", "note": "TO 1：減り 5 %", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [4.7, 5.3] },
    { "do": "check", "note": "TO 1 は CLB 1 を arm（FCOM p.1273：5〜15 %）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1 },

    { "do": "mark", "note": "TO 2" },
    { "do": "cdu", "note": "<TO 2（4L）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "TO 2：EICAS の行", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "TO 2" },
    { "do": "check", "note": "TO 2：基準 N1 95.7（15 %。前は 98.3）", "dref": "laminar/B747/engines/display_N1_ref[0]", "op": "between", "value": [95.2, 96.2] },
    { "do": "check", "note": "TO 2：減り 15 %", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [14.6, 15.4] },
    { "do": "check", "note": "TO 2 は CLB 2 を arm（15 % 以上）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 2 },

    { "do": "mark", "note": "D-TO SEL 45" },
    { "do": "cdu", "note": "<TO（2L）", "keys": ["L2"] },
    { "do": "cdu", "note": "SEL 45（L1）", "keys": ["45", "L1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "D-TO SEL 45", "drefs": [ "laminar/B747/engines/display_N1_ref[0]", "laminar/B747/engines/to_reduction", "laminar/B747/engine/derate/CLB", "laminar/B747/fms/thrlim/eicas" ] },
    { "do": "check", "note": "EICAS の行は D-TO +45C", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "D-TO +45C" },
    { "do": "check", "note": "D-TO SEL 45：基準 N1 100.9、TO の 103.8 より下（SEL の表の N1 を TAT に換算：推定。前は 106.0）", "dref": "laminar/B747/engines/display_N1_ref[0]", "op": "between", "value": [100.4, 101.4] },
    { "do": "check", "note": "D-TO SEL 45：減り 5.5 %（正の値。前は −6.5）", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [5.0, 6.0] },
    { "do": "check", "note": "減り 5.5 %：CLB 1 を arm（FCOM p.1273）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1 },

    { "do": "mark", "note": "D-TO 2 SEL 45" },
    { "do": "cdu", "note": "<TO 2（4L）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "EICAS の行は D-TO 2 +45C", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "D-TO 2 +45C" },
    { "do": "check", "note": "D-TO 2 SEL 45：基準 N1 93.1、TO 2 の 95.7 より下（前は 100.4：TO 2 より上）", "dref": "laminar/B747/engines/display_N1_ref[0]", "op": "between", "value": [92.5, 93.7] },
    { "do": "check", "note": "D-TO 2 SEL 45：減り 19.7 %", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [19.1, 20.3] },

    { "do": "mark", "note": "SEL 30（定格が保たれる温度の内側）" },
    { "do": "cdu", "note": "<TO（2L）", "keys": ["L2"] },
    { "do": "cdu", "note": "SEL 30（L1）", "keys": ["30", "L1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "D-TO SEL 30：基準 N1 は TO を越えない（前は 106.4）", "dref": "laminar/B747/engines/display_N1_ref[0]", "op": "between", "value": [103.2, 104.3] },
    { "do": "view", "note": "主 EICAS", "the": -18, "psi": 29, "fov": 16 },
    { "do": "shot", "name": "eicas_ge_dto_sel30" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
