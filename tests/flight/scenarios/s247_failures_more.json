{
  "name": "s247_failures_more",
  "description": "故障の窓に足した、原因を作っていなかった故障（notes/FAILURES.md §5）の X-Plane での確認。成田 34L でエンジン運転中に窓を開き（一覧を読み直す）、章 35 と 49 の新しい行を test_click で押す（乗員酸素ボンベの漏れ、APU の吸気ドアの固着）。APU を START にしてもドアが開かず始動しない、APU DOOR。ほかは dataref で入れる：油圧系統 2 の過熱（HYD OVHT SYS 2）、エンジン 2 の油の過熱（ENG 2 OIL TEMP）、消火ボトル R ENG B の漏れ（BTL DISCH R B、>BTL LO R ENG B）、outflow valve R の自動駆動（OUTFLOW VLV R）、加湿器（>HUMID FLT DK、P&W）、離陸警報カード（>CONFIG WARN SY）、エンジン 1 が approach idle のまま（>IDLE DISAGREE）、start valve 3 の開固着（STARTER CUTOUT 3）。窓が 10 件を数え、REPAIR ALL で 0。そのあと greenband の前脚圧スイッチ（>STAB GREENBAND）と relief valve の開固着（PRESS RELIEF）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始", "drefs": [ "laminar/B747/engines/type", "laminar/B747/gear/air_ground/pri_gnd", "sim/cockpit2/electrical/APU_N1_percent", "laminar/B747/electrical/apu/sel_dial_pos" ] },
    { "do": "cmd", "note": "窓を開く（一覧を読み直す）", "name": "laminar/B747/failures/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },

    { "do": "mark", "note": "窓の新しい行：章 35 CYLINDERS" },
    { "do": "set", "note": "章 35 OXYGEN（1010）", "dref": "laminar/B747/failures/test_click", "value": 1010 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "行 3：CREW OXYGEN CYLINDER LEAK", "dref": "laminar/B747/failures/test_click", "value": 2003 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押せた", "dref": "laminar/B747/failures/test_click", "op": "==", "value": 2003 },
    { "do": "check", "note": "乗員ボンベの漏れ", "dref": "laminar/B747/oxygen/fail/crew_leak", "op": "==", "value": 1 },
    { "do": "shot", "name": "window_oxygen_cylinders" },

    { "do": "mark", "note": "章 49 APU INLET DOOR JAMMED" },
    { "do": "set", "note": "章 49 APU（1012）", "dref": "laminar/B747/failures/test_click", "value": 1012 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "行 3：APU INLET DOOR JAMMED", "dref": "laminar/B747/failures/test_click", "value": 2003 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ドアの固着", "dref": "laminar/B747/apu/fail/door", "op": "==", "value": 1 },
    { "do": "check", "note": "2 つ", "dref": "laminar/B747/failures/active", "op": "==", "value": 2 },
    { "do": "cmd", "note": "APU selector ON", "name": "laminar/B747/electrical/apu/sel_dial_up" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "APU selector START", "name": "laminar/B747/electrical/apu/sel_dial_up" },
    { "do": "wait", "note": "ドアが動かない：20 s で APU DOOR（FCOM p.902）", "dref": "laminar/B747/CAS/advisory_status[14]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "check", "note": "starter は入らない（FCOM p.896）", "dref": "sim/cockpit2/electrical/APU_N1_percent", "op": "<", "value": 1 },

    { "do": "mark", "note": "ほかの故障を dataref で" },
    { "do": "set", "note": "油圧系統 2 の過熱", "dref": "laminar/B747/hydraulics/fail/overheat[1]", "value": 1 },
    { "do": "set", "note": "エンジン 2 の油の過熱", "dref": "laminar/B747/engines/fail/oil_temp[1]", "value": 1 },
    { "do": "set", "note": "消火ボトル R ENG B の漏れ", "dref": "laminar/B747/fire/fail/bottle_leak[3]", "value": 1 },
    { "do": "set", "note": "outflow valve R の自動駆動", "dref": "laminar/B747/air/fail/outflow_auto[1]", "value": 1 },
    { "do": "set", "note": "操縦室の加湿器", "dref": "laminar/B747/air/fail/humidifier", "value": 1 },
    { "do": "set", "note": "離陸警報カード", "dref": "laminar/B747/flt_ctrls/fail/config_warn", "value": 1 },
    { "do": "set", "note": "エンジン 1 が approach idle のまま", "dref": "laminar/B747/engines/fail/idle_approach[0]", "value": 1 },
    { "do": "set", "note": "start valve 3 の開固着", "dref": "laminar/B747/air/fail/start_valve_open[2]", "value": 1 },
    { "do": "wait", "note": "OUTFLOW VLV R", "dref": "laminar/B747/CAS/advisory_status[250]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "STATUS OUTFLOW VLV R", "dref": "laminar/B747/CAS/status_status[32]", "op": "==", "value": 1 },
    { "do": "check", "note": ">HUMID FLT DK（P&W：109）", "dref": "laminar/B747/CAS/advisory_status[197]", "op": "==", "value": 1 },
    { "do": "check", "note": ">CONFIG WARN SY（FCOM p.1604）", "dref": "laminar/B747/CAS/advisory_status[52]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS CONFIG WARN SY（ATA31 p.270）", "dref": "laminar/B747/CAS/status_status[146]", "op": "==", "value": 1 },
    { "do": "check", "note": ">IDLE DISAGREE（FCOM p.902）", "dref": "laminar/B747/CAS/advisory_status[223]", "op": "==", "value": 1 },
    { "do": "wait", "note": "STARTER CUTOUT 3", "dref": "laminar/B747/CAS/caution_status[63]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "snapshot", "note": "start valve 3", "drefs": [ "laminar/B747/air/engine3/bleed_start_valve_pos", "laminar/B747/CAS/advisory_status[140]" ] },
    { "do": "wait", "note": "HYD OVHT SYS 2", "dref": "laminar/B747/CAS/advisory_status[203]", "op": "==", "value": 1, "timeout": 150 },
    { "do": "wait", "note": ">BTL LO R ENG B", "dref": "laminar/B747/CAS/advisory_status[322]", "op": "==", "value": 1, "timeout": 150 },
    { "do": "check", "note": "BTL DISCH R B の灯", "dref": "laminar/B747/fire/light/btl_disch[3]", "op": "==", "value": 1 },
    { "do": "wait", "note": ">CREW OXY LOW（500 psi）", "dref": "laminar/B747/CAS/advisory_status[53]", "op": "==", "value": 1, "timeout": 200 },
    { "do": "wait", "note": "ENG 2 OIL TEMP", "dref": "laminar/B747/CAS/advisory_status[119]", "op": "==", "value": 1, "timeout": 240 },
    { "do": "snapshot", "note": "温度と圧", "drefs": [ "laminar/B747/hydraulics/temp_2", "laminar/B747/engines/oil_temp_degC[1]", "laminar/B747/oxygen/crew_press_psi", "laminar/B747/fire/engine03_04B/ext_bottle/psi" ] },
    { "do": "cas", "note": "故障 10 件" },
    { "do": "set", "note": "窓を閉じる（EICAS を隠さない）", "dref": "laminar/B747/failures/window_open", "value": 0 },
    { "do": "view", "note": "主 EICAS", "the": -18, "psi": 29, "fov": 16 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "eicas_failures_more" },
    { "do": "cmd", "note": "窓をまた開く", "name": "laminar/B747/failures/window_toggle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "窓が 10 件を数える", "dref": "laminar/B747/failures/active", "op": "==", "value": 10 },
    { "do": "set", "note": "章 29 HYDRAULICS（1005）", "dref": "laminar/B747/failures/test_click", "value": 1005 },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "一覧（LIST）", "dref": "laminar/B747/failures/test_click", "value": 8000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "window_hyd_overheat" },
    { "do": "set", "note": "REPAIR ALL", "dref": "laminar/B747/failures/test_click", "value": 3000 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/failures/active", "op": "==", "value": 0 },
    { "do": "check", "note": "ドアは直った", "dref": "laminar/B747/apu/fail/door", "op": "==", "value": 0 },
    { "do": "check", "note": "start valve も", "dref": "laminar/B747/air/fail/start_valve_open[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "OUTFLOW VLV R は消えた", "dref": "laminar/B747/CAS/advisory_status[250]", "op": "==", "value": 0 },
    { "do": "check", "note": ">CONFIG WARN SY も", "dref": "laminar/B747/CAS/advisory_status[52]", "op": "==", "value": 0 },
    { "do": "check", "note": ">HUMID FLT DK も", "dref": "laminar/B747/CAS/advisory_status[197]", "op": "==", "value": 0 },
    { "do": "check", "note": ">IDLE DISAGREE も", "dref": "laminar/B747/CAS/advisory_status[223]", "op": "==", "value": 0 },
    { "do": "wait", "note": "ボトルは満タンに戻る", "dref": "laminar/B747/CAS/advisory_status[322]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "乗員ボンベも", "dref": "laminar/B747/CAS/advisory_status[53]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "APU のドアが開いて始動（START の latch が残る）", "dref": "sim/cockpit2/electrical/APU_N1_percent", "op": ">", "value": 10, "timeout": 40 },
    { "do": "check", "note": "APU DOOR は消えた", "dref": "laminar/B747/CAS/advisory_status[14]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "APU selector OFF", "name": "laminar/B747/electrical/apu/sel_dial_dn" },

    { "do": "mark", "note": "greenband の前脚圧スイッチ" },
    { "do": "set", "note": "FMC の離陸トリム 9（nose up 帯。Web API は XTLua の dataref に小数を書けない）", "dref": "laminar/B747/fmc/elevator_trim", "value": 9 },
    { "do": "set", "note": "スイッチが AFT CG を読む", "dref": "laminar/B747/flt_ctrls/fail/greenband_switch", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "greenband", "drefs": [ "laminar/B747/fmc/elevator_trim", "laminar/B747/flt_ctrls/elevator_trim/mid/indicator" ] },
    { "do": "wait", "note": ">STAB GREENBAND（FCOM p.958）", "dref": "laminar/B747/CAS/advisory_status[273]", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "STATUS STAB GREENBAND", "dref": "laminar/B747/CAS/status_status[147]", "op": "==", "value": 1 },
    { "do": "set", "note": "直す", "dref": "laminar/B747/flt_ctrls/fail/greenband_switch", "value": 0 },
    { "do": "wait", "note": "消える", "dref": "laminar/B747/CAS/advisory_status[273]", "op": "==", "value": 0, "timeout": 3 },

    { "do": "mark", "note": "relief valve の開固着" },
    { "do": "set", "note": "LWR relief valve の開固着", "dref": "laminar/B747/air/fail/relief_open[1]", "value": 1 },
    { "do": "wait", "note": "PRESS RELIEF（FCOM p.620）", "dref": "laminar/B747/CAS/advisory_status[258]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "STATUS LWR PRESS RELIEF", "dref": "laminar/B747/CAS/status_status[34]", "op": "==", "value": 1 },
    { "do": "check", "note": "UPR ではない", "dref": "laminar/B747/CAS/status_status[33]", "op": "==", "value": 0 },
    { "do": "set", "note": "直す", "dref": "laminar/B747/air/fail/relief_open[1]", "value": 0 },
    { "do": "wait", "note": "消える", "dref": "laminar/B747/CAS/advisory_status[258]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "set", "note": "窓を閉じる", "dref": "laminar/B747/failures/window_open", "value": 0 },
    { "do": "record_stop" }
  ]
}
