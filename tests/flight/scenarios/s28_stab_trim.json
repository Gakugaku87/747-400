{
  "name": "s28_stab_trim",
  "description": "安定板トリム（4-1 段 2b：SRM の手動・ALTN・オートトリム・cutout・自動遮断）の X-Plane での確認、空中。10,000 ft の空中で開始し、A/P（ALT HOLD）と A/T（SPD 250 kt）を入れる。オートトリムが A/P の昇降舵の指令を中立近くに保つ（前は狙いの約 1/60 の速さで、指令が残った）。230 kt を超えた速さでは ALTN で 0.2 units/s（ATA27 p.452、1 unit = 1°：ATA22 p.132）、A/P は外れず STAB TRIM UNSCHD（FCOM p.958）。A/P 1 台で操縦輪のスイッチを使うと A/P が外れ（AUTOPILOT DISC）、トリムする（FCOM p.945）。cutout 2 を CUTOUT で >STAB TRIM 2 と半分の速さ、AUTO に戻して 5 秒で消える（ATA27 p.450・456）。系統 3 の STCM の暴走（laminar/B747/flt_ctrls/fail/stab_runaway）は監視が 0.1 units で見つけて弁を閉じ、>STAB TRIM 3（ATA27 p.450、0.1 units は推定）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 130 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 20, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "snapshot", "note": "開始", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/gauges/indicators/airspeed_kts_pilot",
      "laminar/B747/flt_ctrls/stab_trim/units", "sim/flightmodel2/controls/elevator_trim",
      "laminar/B747/hydraulics/pressure_2", "laminar/B747/hydraulics/pressure_3" ] },
    { "do": "check", "note": "X-Plane のトリム（-1..1）と units（0〜15）が対応", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [0.25, 14.75] },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "set", "note": "MCP 方位 347", "dref": "laminar/B747/autopilot/heading/degrees", "value": 347 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "IAS 240 kt 超（230 kt を超えるとトリムは遅い速さ）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 240, "timeout": 300 },
    { "do": "wait", "note": "オートトリムが A/P の昇降舵の指令を中立近くに保つ（ATA22 p.147）", "dref": "laminar/B747/flt_ctrls/sim_pitch_ratio", "op": "between", "value": [-0.05, 0.05], "timeout": 90 },
    { "do": "snapshot", "note": "A/P とオートトリム", "drefs": [
      "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/flt_ctrls/stab_trim/units",
      "laminar/B747/flt_ctrls/sim_pitch_ratio", "laminar/B747/flt_ctrls/custom_pitch_ratio",
      "laminar/B747/flt_ctrls/stab_trim/autotrim_cmd", "laminar/B747/autopilot/servos_on" ] },

    { "do": "mark", "note": "ALTN（A/P はそのまま）" },
    { "do": "remember", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "as": "u_altn" },
    { "do": "cmd", "note": "ALTN STAB TRIM 機首下げ 2 秒", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 2 },
    { "do": "check", "note": "230 kt 超、両方の STCM で 0.2 units/s：約 0.4 units", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [-0.55, -0.25], "rel": "u_altn" },
    { "do": "check", "note": "ALTN は A/P を外さない（FCOM p.945）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1 },
    { "do": "check", "note": "A/P engage 中の ALTN：STAB TRIM UNSCHD（FCOM p.958）", "dref": "laminar/B747/CAS/caution_status[60]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS STAB TRIM UNSCHD", "dref": "laminar/B747/CAS/status_status[91]", "op": "==", "value": 1 },
    { "do": "cas", "note": "STAB TRIM UNSCHD" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_unschd" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "A/P 1 台で操縦輪のスイッチ" },
    { "do": "remember", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "as": "u_wheel" },
    { "do": "cmd", "note": "機長の STAB TRIM 機首上げ 1 秒", "name": "laminar/B747/flt_ctrls/stab_trim_up_capt", "duration": 1 },
    { "do": "check", "note": "A/P が外れる（FCOM p.945）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC（FCOM 4.20）", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "そしてトリムする：0.2 units/s で約 0.2 units", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [0.1, 0.35], "rel": "u_wheel" },
    { "do": "sleep", "seconds": 2, "note": "A/P の昇降舵の指令が中立に戻る（1/s、推定）" },
    { "do": "check", "note": "A/P が外れた後、A/P の昇降舵の指令は 0（前は残った）", "dref": "laminar/B747/flt_ctrls/sim_pitch_ratio", "op": "==", "value": 0 },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタンで警報を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "sleep", "seconds": 10 },

    { "do": "mark", "note": "cutout 2" },
    { "do": "cmd", "note": "STAB TRIM cutout 2 を CUTOUT へ", "name": "laminar/B747/flt_ctrls/stab_trim/cutout_2_dn" },
    { "do": "check", "note": "cutout 2：CUTOUT", "dref": "laminar/B747/flt_ctrls/stab_trim/cutout_sw[0]", "op": "==", "value": -1 },
    { "do": "check", "note": ">STAB TRIM 2（FCOM p.958）", "dref": "laminar/B747/CAS/advisory_status[274]", "op": "==", "value": 1 },
    { "do": "check", "note": "STATUS STAB TRIM", "dref": "laminar/B747/CAS/status_status[90]", "op": "==", "value": 1 },
    { "do": "remember", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "as": "u_half" },
    { "do": "cmd", "note": "ALTN STAB TRIM 機首上げ 2 秒", "name": "laminar/B747/flt_ctrls/altn_stab_trim_up", "duration": 2 },
    { "do": "check", "note": "系統 3 の STCM だけ：半分の 0.1 units/s で約 0.2 units", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [0.12, 0.3], "rel": "u_half" },
    { "do": "cas", "note": ">STAB TRIM 2" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_stab_trim_2" },
    { "do": "view", "name": "forward" },
    { "do": "cmd", "note": "cutout 2 を AUTO へ", "name": "laminar/B747/flt_ctrls/stab_trim/cutout_2_up" },
    { "do": "check", "note": "AUTO、すぐはまだ >STAB TRIM 2（弁が閉じたまま）", "dref": "laminar/B747/CAS/advisory_status[274]", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 6, "note": "AUTO に 5 秒で弁を開く指令（ATA27 p.450）" },
    { "do": "check", "note": ">STAB TRIM 2 が消える（ATA27 p.456）", "dref": "laminar/B747/CAS/advisory_status[274]", "op": "==", "value": 0 },

    { "do": "mark", "note": "系統 3 の STCM の暴走" },
    { "do": "remember", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "as": "u_run" },
    { "do": "set", "note": "系統 3 の STCM が機首上げへ暴走", "dref": "laminar/B747/flt_ctrls/fail/stab_runaway[1]", "value": 1 },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "監視が 0.1 units で見つけて止まる（0.1 は推定）", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [0.05, 0.25], "rel": "u_run" },
    { "do": "check", "note": "自動遮断：>STAB TRIM 3（ATA27 p.450）", "dref": "laminar/B747/CAS/advisory_status[275]", "op": "==", "value": 1 },
    { "do": "cas", "note": ">STAB TRIM 3" },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/stab_runaway[1]", "value": 0 },
    { "do": "sleep", "seconds": 6 },
    { "do": "check", "note": "AUTO のままでは閉じたまま（ATA27 p.450）", "dref": "laminar/B747/CAS/advisory_status[275]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "cutout 3 を ON へ", "name": "laminar/B747/flt_ctrls/stab_trim/cutout_3_up" },
    { "do": "check", "note": "ON で開く（FCOM p.945）", "dref": "laminar/B747/CAS/advisory_status[275]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "cutout 3 を AUTO へ戻す", "name": "laminar/B747/flt_ctrls/stab_trim/cutout_3_dn" },
    { "do": "check", "note": "cutout 3：AUTO", "dref": "laminar/B747/flt_ctrls/stab_trim/cutout_sw[1]", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "終わり", "drefs": [
      "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot",
      "laminar/B747/flt_ctrls/stab_trim/units", "laminar/B747/flt_ctrls/sim_pitch_ratio", "laminar/B747/autopilot/servos_on" ] }
  ]
}
