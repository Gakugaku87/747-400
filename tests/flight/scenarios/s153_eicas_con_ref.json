{
  "name": "s153_eicas_con_ref",
  "description": "6-1/6-2 段 9h1（推力制限の CON の値：最大連続の表）の X-Plane での確認。空中、17,000 ft・約 250 kt（機体を読み直す）。RJAA→RJBB の経路、PERF INIT で ZFW 200・COST INDEX 100・CRZ ALT FL230、MCP 23,000 ft で VNAV（VNAV SPD・A/T THR REF・推力制限 CLB）、速度介入で 250 kt。18,500 ft を過ぎたら THRUST LIM の <CON：FMS の符号 40、EICAS の行は CON、reference は最大連続の表（FCOM PI.13.1-13.2 p.283-284：19,000 ft・250 KIAS で約 1.55）で CLB の約 1.42 より高い。A/T THR REF で EPR が CON の reference まで出る（EEC の全開の最大連続の帯：ATA70_80 p.208-209）。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 5182, "heading_true": 340, "speed_in_meters_per_second": 130 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL230、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "230", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 23,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 23000 },
    { "do": "set", "note": "MCP 高度 23,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 23000 },
    { "do": "sleep", "seconds": 5, "note": "MCP の高度が中へ写るのを待つと FMC の VNAV" },
    { "do": "check", "note": "FMC は上昇（1）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "A/T は THR REF（FMC の上昇）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5 },
    { "do": "check", "note": "推力制限は CLB（符号 20）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 20 },
    { "do": "cmd", "note": "速度のノブを押す（速度介入）", "name": "laminar/B747/button_switch/press_airspeed" },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "MCP の速さを 250 kt に", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cdu", "note": "INIT REF、<INDEX、THRUST LIM", "keys": ["INITREF", "L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "wait", "note": "18,500 ft まで上がる（最大連続の帯）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">=", "value": 18500, "timeout": 300 },
    { "do": "sleep", "seconds": 5 },
    { "do": "remember", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "as": "clb_ref" },
    { "do": "snapshot", "note": "CLB", "drefs": [ "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR_max[0]", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/fms/thrlim/eicas", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "cdu", "note": "<CON（L3）", "keys": ["L3"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMS の符号は CON（40）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 40 },
    { "do": "check", "note": "EEC のモードも CON", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CON" },
    { "do": "check", "note": "EICAS の行は CON", "dref": "laminar/B747/fms/thrlim/eicas", "op": "==", "value": "CON" },
    { "do": "check", "note": "reference は最大連続の表（19,000 ft・250 KIAS で約 1.55）", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "op": "between", "value": [1.50, 1.60] },
    { "do": "check", "note": "CON は CLB より高い（約 +0.13）", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "op": "between", "value": [0.05, 0.20], "rel": "clb_ref" },
    { "do": "remember", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "as": "con_ref" },
    { "do": "wait", "note": "A/T THR REF で EPR が CON の reference まで出る（EEC の最大連続の帯）", "dref": "laminar/B747/engines/display_EPR[0]", "op": ">=", "value": -0.02, "rel": "con_ref", "timeout": 30 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "CON", "drefs": [ "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[0]", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/fms/thrlim/eicas", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "EPR は CON の reference の ±0.02", "dref": "laminar/B747/engines/display_EPR[0]", "op": "between", "value": [-0.02, 0.02], "rel": "con_ref" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_con" },
    { "do": "view", "name": "forward" },
    { "do": "cdu", "note": "CLB>（R2）に戻す", "keys": ["R2"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CLB に戻る（符号 20）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 20 },
    { "do": "record_stop" }
  ]
}
