{
  "name": "s268_flch_climb_accel",
  "description": "FLCH の上昇で速さを上げる（性能計測のフェーズ2の上昇 250/340/.84 の 10,000 ft の加速。notes/ATA-34-61-FMC.md §152）の X-Plane での確認、空中。s108 と同じ銚子沖 10,000 ft・250 kt・北向き・270 t（ペイロード 0、燃料 86.5 t）で開始（機体を読み直す、カスタム acf）。A/P CMD L・HDG SEL・ALT HOLD・A/T SPD で落ち着かせ、MCP 高度 FL350・速さ 340 kt で FLCH：A/T は THR で CLB の制限まで進める（速さが目標より下なら前と同じ）、速さは 340 kt へ行き過ぎ 5 kt 以内（目標の 5 kt 手前からエネルギーの率が効く：§152）、その後 60 秒 340 kt の ±5 kt で上昇を続ける。記録を取る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 149.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "record_start" },
    { "do": "check", "note": "重さは約 270 t", "dref": "sim/flightmodel/weight/m_total", "op": "between", "value": [268000, 272000] },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 25 },
    { "do": "wait", "note": "水平に戻る（±200 fpm）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-200, 200], "timeout": 120 },
    { "do": "wait", "note": "250 kt（±2 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [248, 252], "timeout": 120 },
    { "do": "check", "note": "まだ水平（±300 fpm）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300] },
    { "do": "snapshot", "note": "FLCH の前", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total", "laminar/B747/engines/ref_thr_limit_mode", "sim/cockpit2/engine/actuators/EPR_target_bug[0]" ] },

    { "do": "mark", "note": "FLCH で FL350 へ、MCP 340 kt（10,000 ft の加速）" },
    { "do": "set", "note": "MCP 高度 FL350", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 35000 },
    { "do": "set", "note": "MCP 速度 340 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 340 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA は FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "check", "note": "A/T は THR", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 4 },
    { "do": "watch", "note": "加速の間、速さは 245 kt より下がらない（ピッチの則は 1.5 kt/s までの加速）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 245, "max": 345, "until": { "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 335 }, "timeout": 120 },
    { "do": "snapshot", "note": "335 kt に届いた時", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/engine/ENGN_EPR[0]", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/autothrottle/lever_cmd", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "remember", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "as": "epr_bug" },
    { "do": "check", "note": "推力は制限の近く（EPR はバグの −0.08 以上：推定。速さが目標より下の間は前と同じく制限まで進める）", "dref": "sim/flightmodel/engine/ENGN_EPR[0]", "op": ">", "value": -0.08, "rel": "epr_bug", "level": "warn" },
    { "do": "watch", "note": "340 kt に着く所で行き過ぎ 5 kt 以内（60 秒）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "max": 345, "timeout": 60 },
    { "do": "watch", "note": "続く 60 秒、340 kt の ±5 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "min": 335, "max": 345, "timeout": 60 },
    { "do": "check", "note": "上昇を続けている（1,000 fpm 超）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": ">", "value": 1000 },
    { "do": "check", "note": "FMA は FLCH SPD のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "snapshot", "note": "340 kt の上昇", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/engine/ENGN_EPR[0]", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "record_stop" }
  ]
}
