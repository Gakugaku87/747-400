{
  "name": "s300_fmc_ils_appr_navaid",
  "description": "ILS の自動同調は選んだ進入の推奨の施設から（2026-11-12 のフルレビュー FMC-6：REVIEW_2026-11-12.md 案 9）の X-Plane での確認。本物の航法データの EDDF（AIRAC 2611）：07L には LOC が 2 つあり（110.30 と 111.75）、ILS07L Z の推奨の施設は IFNE（111.75）。EDDF の西 70 NM の 12,000 ft の空中開始（270 t）。PERF INIT、RTE EDDK→EDDF、DIRECT KOMIB、ARRIVALS で ILS07LZ、ACTIVATE・EXEC。空中でしきい値から 150 NM の内なので、すぐ自動同調する（FCOM p.1306–1307。空中開始には離陸の後の 10 分の禁止が無い）。前：滑走路で引いた別の LOC の 110.30。直した後（FCOM p.1306：選んだ進入の ILS を同調）：111.75。CDU の NAV RADIO を撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 50.10, "longitude": 7.00, "elevation_in_meters": 3658, "heading_true": 90, "speed_in_meters_per_second": 144 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "CLR、RTE：EDDK→EDDF、DIRECT KOMIB", "keys": ["CLR", "CLR", "CLR", "RTE", "EDDK", "L1", "EDDF", "R1", "NEXT", "KOMIB", "R1", "?SEL"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "cdu", "note": "DEP ARR（経路が有効でない：DEP/ARR INDEX）、ARR>（R2）", "keys": ["DEPARR", "R2"] },
    { "do": "wait", "note": "EDDF ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "EDDF ARRIVALS", "timeout": 10, "stop": true },
    { "do": "check", "note": "1 ページ目の 4R が ILS07LZ", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "ILS07LZ$", "stop": true },
    { "do": "cdu", "note": "ILS07LZ（4R）", "keys": ["R4"] },
    { "do": "wait", "note": "<SEL>ILS07LZ", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "<SEL>ILS07LZ$", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "RTE、ACTIVATE（6R）、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "mark", "note": "ILS の自動同調を待つ" },
    { "do": "wait", "note": "NAV 1 は ILS07L Z の IFNE の 111.75（前は 07L のもう 1 つの LOC の 110.30）", "dref": "sim/cockpit2/radios/actuators/nav1_frequency_hz", "op": "==", "value": 11175, "timeout": 120 },
    { "do": "snapshot", "note": "同調", "drefs": [ "sim/cockpit2/radios/actuators/nav1_frequency_hz", "sim/cockpit2/radios/actuators/nav2_frequency_hz", "laminar/B747/radio/tuningmodes" ] },
    { "do": "cdu", "note": "NAV RADIO", "keys": ["NAVRAD"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "NAV RADIO", "drefs": [ "laminar/B747/fms3/Line08_S", "laminar/B747/fms3/Line09_L" ] },
    { "do": "check", "note": "NAV RADIO の ILS の行は 111.75", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "111.75" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_navrad_ils" }
  ]
}
