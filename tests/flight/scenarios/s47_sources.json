{
  "name": "s47_sources",
  "description": "ソース選択の比較（5-2 段 2）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt で開始（機体を読み直す）。>SOURCE SEL F/D・NAV・EIU・IRS（両席が同じ FCC・FMC・EIU・IRU）、>SNGL SOURCE RA（両 PFD が同じ電波高度計）、>EFIS CONTROL L・>EFIS/EICAS C/P（操作パネルの故障）、X-Plane の副操縦士側の姿勢計と方位の故障と旋回で >ATTITUDE・>HEADING（FCOM p.1197–1199）。EICAS を記録する。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/flt_inst/flt_dir_src/capt/sel_dial_pos", "laminar/B747/flt_inst/flt_dir_src/fo/sel_dial_pos", "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "laminar/B747/flt_inst/nav_src/fo/sel_dial_pos",
      "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos", "laminar/B747/flt_inst/irs_src/fo/sel_dial_pos", "laminar/B747/eiu/used", "laminar/B747/irs/att_valid" ] },
    { "do": "check", "note": "通常：>SOURCE SEL F/D なし", "dref": "laminar/B747/CAS/advisory_status[269]", "op": "==", "value": 0 },
    { "do": "check", "note": ">SOURCE SEL NAV なし", "dref": "laminar/B747/CAS/advisory_status[271]", "op": "==", "value": 0 },
    { "do": "check", "note": ">SOURCE SEL EIU なし", "dref": "laminar/B747/CAS/advisory_status[268]", "op": "==", "value": 0 },
    { "do": "check", "note": ">SNGL SOURCE RA なし", "dref": "laminar/B747/CAS/advisory_status[266]", "op": "==", "value": 0 },
    { "do": "check", "note": ">EFIS CONTROL R なし", "dref": "laminar/B747/CAS/advisory_status[89]", "op": "==", "value": 0 },
    { "do": "check", "note": ">ATTITUDE なし", "dref": "laminar/B747/CAS/caution_status[3]", "op": "==", "value": 0 },
    { "do": "check", "note": ">HEADING なし", "dref": "laminar/B747/CAS/advisory_status[185]", "op": "==", "value": 0 },

    { "do": "mark", "note": "source select" },
    { "do": "set", "note": "副操縦士の FLT DIR を L", "dref": "laminar/B747/flt_inst/flt_dir_src/fo/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両席が FCC L：>SOURCE SEL F/D（FCOM p.1197）", "dref": "laminar/B747/CAS/advisory_status[269]", "op": "==", "value": 1 },
    { "do": "set", "dref": "laminar/B747/flt_inst/flt_dir_src/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "機長の NAV を FMC R", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両席が FMC R：>SOURCE SEL NAV", "dref": "laminar/B747/CAS/advisory_status[271]", "op": "==", "value": 1 },
    { "do": "check", "note": ">SOURCE SEL F/D は消える", "dref": "laminar/B747/CAS/advisory_status[269]", "op": "==", "value": 0 },
    { "do": "set", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 0 },
    { "do": "set", "note": "副操縦士の EIU を L", "dref": "laminar/B747/flt_inst/eiu_src/fo/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両席が EIU L：>SOURCE SEL EIU", "dref": "laminar/B747/CAS/advisory_status[268]", "op": "==", "value": 1 },
    { "do": "cas", "note": "EICAS" },
    { "do": "set", "dref": "laminar/B747/flt_inst/eiu_src/fo/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "消える", "dref": "laminar/B747/CAS/advisory_status[268]", "op": "==", "value": 0 },

    { "do": "mark", "note": "SNGL SOURCE RA" },
    { "do": "set", "note": "電波高度計 R の故障", "dref": "laminar/B747/ra/fail[2]", "value": 1 },
    { "do": "set", "note": "電波高度計 C の故障", "dref": "laminar/B747/ra/fail[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両 PFD が L：>SNGL SOURCE RA", "dref": "laminar/B747/CAS/advisory_status[266]", "op": "==", "value": 1 },
    { "do": "set", "dref": "laminar/B747/ra/fail[2]", "value": 0 },
    { "do": "set", "dref": "laminar/B747/ra/fail[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "消える", "dref": "laminar/B747/CAS/advisory_status[266]", "op": "==", "value": 0 },

    { "do": "mark", "note": "control panels" },
    { "do": "set", "note": "左 EFIS 操作パネルの故障", "dref": "laminar/B747/efis/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": ">EFIS CONTROL L（FCOM p.1198）", "dref": "laminar/B747/CAS/advisory_status[88]", "op": "==", "value": 1 },
    { "do": "set", "note": "右のパネルと表示選択パネルも", "dref": "laminar/B747/efis/fail[1]", "value": 1 },
    { "do": "set", "dref": "laminar/B747/dsp/fail", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": ">EFIS/EICAS C/P（FCOM p.1199）", "dref": "laminar/B747/CAS/advisory_status[90]", "op": "==", "value": 1 },
    { "do": "cas", "note": "EICAS" },
    { "do": "set", "dref": "laminar/B747/efis/fail[0]", "value": 0 },
    { "do": "set", "dref": "laminar/B747/efis/fail[1]", "value": 0 },
    { "do": "set", "dref": "laminar/B747/dsp/fail", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "消える", "dref": "laminar/B747/CAS/advisory_status[90]", "op": "==", "value": 0 },

    { "do": "mark", "note": "ATTITUDE and HEADING" },
    { "do": "set", "note": "X-Plane の副操縦士側の姿勢計の故障", "dref": "sim/operation/failures/rel_cop_ahz", "value": 6 },
    { "do": "set", "note": "X-Plane の副操縦士側の方位の故障", "dref": "sim/operation/failures/rel_cop_dgy", "value": 6 },
    { "do": "set", "note": "MCP 方位 090（右旋回）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90 },
    { "do": "wait", "note": "副操縦士の PFD の姿勢が離れて >ATTITUDE（FCOM p.1197）", "dref": "laminar/B747/CAS/caution_status[3]", "op": "==", "value": 1, "timeout": 40, "level": "warn" },
    { "do": "wait", "note": "方位が離れて >HEADING（FCOM p.1198）", "dref": "laminar/B747/CAS/advisory_status[185]", "op": "==", "value": 1, "timeout": 40, "level": "warn" },
    { "do": "snapshot", "note": "両側の姿勢と方位", "drefs": [ "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_copilot", "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "sim/cockpit2/gauges/indicators/roll_AHARS_deg_copilot",
      "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_copilot" ] },
    { "do": "cas", "note": "EICAS" },
    { "do": "set", "dref": "sim/operation/failures/rel_cop_ahz", "value": 0 },
    { "do": "set", "dref": "sim/operation/failures/rel_cop_dgy", "value": 0 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "wait", "note": "故障を戻すと消える", "dref": "laminar/B747/CAS/caution_status[3]", "op": "==", "value": 0, "timeout": 60, "level": "warn" }
  ]
}
