{
  "name": "s141_vnav_takeoff",
  "description": "6-1/6-2 段 9c（AFDS が FMC の VNAV で飛ぶ）の X-Plane での確認、離陸の VNAV（FCOM p.1255）。RJAA 34L でエンジン運転中に始め（機体を読み直す）、s109 と同じフラップ 20・離陸トリム・F/D の T/O。CDU で経路（RJAA→RJBB）を ACTIVATE と EXEC、PERF INIT で ZFW 200・CRZ ALT FL170・COST INDEX 100、TAKEOFF REF でフラップ 20 と V1・VR・V2 を選ぶ。MCP 高度 9,000 ft、A/T ARM、VNAV を arm（FMA の arm は VNAV）。手で推力を最大にして s109 と同じに離陸し、電波高度 300 ft で A/P CMD L。400 ft の上で VNAV SPD が engage、FMC の目標速度は V2 + 10〜V2 + 25（engage の時の速さ）、A/T は THR REF（推力の基準は 1,000 ft までは TO）。加速高度（ACCEL HT 1,000 ft：標高 141 ft に足して 1,141 ft）でフラップ 20 の placard の 5 kt 下へ。フラップを 10・5・1・UP と上げるとその placard の 5 kt 下、上がれば 250 kt（SPD TRANS）。9,000 ft で VNAV ALT・A/T SPD。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 9,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 9000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 9000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s109 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA のピッチは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },

    { "do": "mark", "note": "CDU：経路、PERF INIT、TAKEOFF REF" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "170", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 17,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 17000 },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20（1L）、V1・VR・V2 を選ぶ（1R〜3R）", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "V2 を選んだ（999 でない）", "dref": "laminar/B747/airspeed/V2", "op": "<", "value": 900 },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2", "as": "v2" },
    { "do": "snapshot", "note": "V speeds と FMC の VNAV", "drefs": [ "laminar/B747/airspeed/V1", "laminar/B747/airspeed/Vr", "laminar/B747/airspeed/V2", "laminar/B747/fms/vnav/valid", "laminar/B747/fms/vnav/perf", "laminar/B747/fms/vnav/phase", "laminar/B747/fms/vnav/cas" ] },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "地上の目標速度は V2 + 10（止まっている：FCOM p.1255）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [9.5, 10.5], "rel": "v2" },
    { "do": "cdu", "note": "INIT REF、<INDEX、THRUST LIM（段 9g2）", "keys": ["INITREF", "L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "snapshot", "note": "地上の THRUST LIM", "drefs": [ "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line06_S", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L" ] },
    { "do": "check", "note": "見出しの右に TO EPR（FCOM p.1314）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "TO EPR" },
    { "do": "check", "note": "<TO に <SEL>、CLB に <ARM>", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<TO   <SEL> <ARM>   CLB>" },
    { "do": "check", "note": "TO 1 の行は <-8 %（FCOM p.1314 の例）", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "<-8 %" },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VNAV の arm（FMA の arm は VNAV：4）", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "vnav_state は 1", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 1 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "離陸（s109 と同じ）" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 90 },
    { "do": "set", "note": "操縦輪を引く（引き起こし）", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.35 },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "set", "note": "操縦輪を緩める", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "cmd", "note": "手の操縦を終える（操縦輪はそのまま）", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },

    { "do": "mark", "note": "VNAV の engage（400 ft）と離陸の目標速度" },
    { "do": "wait", "note": "VNAV SPD が engage（400 ft の上：FCOM p.645、p.1255）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "engage の後", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_dial_kts", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/engines/autothrottle_active", "laminar/B747/autopilot/flightPhase", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/airspeed/Vmax" ] },
    { "do": "check", "note": "vnav_state は 2", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2 },
    { "do": "check", "note": "FMC の目標速度は V2 + 10〜V2 + 25（FCOM p.1255）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [10, 25], "rel": "v2" },
    { "do": "check", "note": "A/T は THR REF（engage で A/T ARM から active）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5 },
    { "do": "check", "note": "VNAV の上昇：EICAS のカーソルは紫（ATA34_2 p.652：段 9g4）", "dref": "laminar/B747/engines/display_ref_line_magenta", "op": "==", "value": 1 },
    { "do": "check", "note": "推力制限は TO のまま（THR REDUCTION のフラップ 5 の前：段 9g1）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "TO" },
    { "do": "remember", "dref": "laminar/B747/fms/vnav/cas", "as": "tocas" },
    { "do": "wait", "note": "加速高度（1,141 ft）の少し下", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 1050, "timeout": 60 },
    { "do": "check", "note": "加速高度の前は、engage の時の目標速度のまま", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [-0.5, 0.5], "rel": "tocas" },

    { "do": "mark", "note": "加速高度とフラップ" },
    { "do": "wait", "note": "加速高度の上（1,200 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 1200, "timeout": 60 },
    { "do": "sleep", "seconds": 1 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vmax", "as": "vmax20" },
    { "do": "snapshot", "note": "加速高度の後", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/airspeed/Vmax", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/flightPhase", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "フラップ 20 の placard の 5 kt 下", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [-5.5, -4.5], "rel": "vmax20" },
    { "do": "wait", "note": "200 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 200, "timeout": 60 },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "wait", "note": "220 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 220, "timeout": 60 },
    { "do": "set", "note": "フラップ 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.34 },
    { "do": "wait", "note": "THR REDUCTION（既定はフラップ 5）で VNAV のとき、待機中の CLB（FCOM p.667：段 9g1）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CLB", "timeout": 5 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "THRUST LIM は空中の形：CLB EPR（FCOM p.1339：段 9g2）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "CLB EPR" },
    { "do": "check", "note": "<SEL> は CLB に", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<SEL>   CLB>" },
    { "do": "snapshot", "note": "推力の reference（段 9g3：CLB は最大上昇の表）", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_EPR[0]", "sim/flightmodel2/position/pressure_altitude", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "wait", "note": "235 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 235, "timeout": 60 },
    { "do": "set", "note": "フラップ 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.168 },
    { "do": "wait", "note": "243 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 243, "timeout": 60 },
    { "do": "set", "note": "フラップ UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "フラップ UP", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/autopilot/ias_dial_value", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/flightPhase", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "フラップ UP：250 kt（10,000 ft の下の SPD TRANS）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [249.5, 250.5] },
    { "do": "check", "note": "推力の基準は CLB（1,000 ft の上）", "dref": "laminar/B747/autopilot/flightPhase", "op": "==", "value": 1 },
    { "do": "check", "note": "推力制限は CLB（フラップ UP で GA にならない）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CLB" },

    { "do": "mark", "note": "9,000 ft の捕捉" },
    { "do": "wait", "note": "9,000 ft で VNAV ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 5, "timeout": 240 },
    { "do": "watch", "note": "行き過ぎは 300 ft まで（60 秒）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 9300, "timeout": 60 },
    { "do": "check", "note": "A/T は SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "snapshot", "note": "9,000 ft", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms/vnav/cas", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "record_stop" }
  ]
}
