{
  "name": "s120_afds_mode_fail",
  "description": "AFDS の作り直し 6-3 段 5c（モード故障と AUTOPILOT caution）の X-Plane での確認、空中。s112 と同じ所（RJAA 34L の進入路の 12 NM、2,500 ft）から CMD L で APP、LOC と G/S を 1,500 ft より上で捕まえたら（単一チャンネル）、X-Plane の NAV 1 の受信機を故障にする（ILS L と C：位置と G/S の 2 台目の喪失）。LOC と G/S が故障：FMA に琥珀の線（`FMA/roll_fail`・`pitch_fail`）、A/P は入ったまま姿勢を保つ、>AUTOPILOT の caution、F/D の両方のバーが消える（109 は故障した軸のバー）。NAV 1 を戻しても故障のまま（新しいモードまで：ATA22 p.254）、TO/GA の G/A で消える（ATA22 p.382；FCOM p.660）。PFD と EICAS を撮る。機体を読み直す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（純正の ils_dots は目的地の 50 NM 以内でしか 1 にならない：DSP-14、5-1 段 3 で作り直すまで）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "check", "note": "NAV2 も G/S の信号", "dref": "sim/cockpit2/radios/indicators/nav2_display_vertical", "op": "==", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "LOC を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 60 },
    { "do": "check", "note": "G/S は arm（ビームの下）", "dref": "laminar/B747/autopilot/glideslope_status", "op": "==", "value": 1 },
    { "do": "check", "note": "ビームの下（負のドット）", "dref": "sim/cockpit2/radios/indicators/nav1_vdef_dots_pilot", "op": "<", "value": -0.5 },

    { "do": "mark", "note": "G/S の捕捉（1,500 ft より上：単一チャンネル）" },
    { "do": "wait", "note": "G/S を捕まえる（FMA のピッチ 2）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "check", "note": "まだ 1,500 ft より上", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 1600 },
    { "do": "check", "note": "LOC は故障していない", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "G/S も", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT は無い", "dref": "laminar/B747/CAS/caution_status[4]", "op": "==", "value": 0 },
    { "do": "check", "note": "F/D のロールのバー", "dref": "laminar/B747/autopilot/fd/roll_bar", "op": "==", "value": 1 },
    { "do": "check", "note": "F/D のピッチのバー", "dref": "laminar/B747/autopilot/fd/pitch_bar", "op": "==", "value": 1 },

    { "do": "mark", "note": "NAV 1 の故障：ILS L と C を失う（位置と G/S の 2 台目：ATA22 p.382）" },
    { "do": "set", "note": "X-Plane の故障：NAV 1（6 = 故障中）", "dref": "sim/operation/failures/rel_nav1", "value": 6 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LOC の故障（琥珀の線）", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "G/S の故障", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "FMA は LOC のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "FMA は G/S のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2 },
    { "do": "check", "note": ">AUTOPILOT の caution（FCOM p.660）", "dref": "laminar/B747/CAS/caution_status[4]", "op": "==", "value": 1 },
    { "do": "check", "note": "A/P は入ったまま（姿勢を保つ）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1 },
    { "do": "check", "note": "F/D のロールのバーが消える", "dref": "laminar/B747/autopilot/fd/roll_bar", "op": "==", "value": 0 },
    { "do": "check", "note": "ピッチのバーも消える（両方の軸が故障）", "dref": "laminar/B747/autopilot/fd/pitch_bar", "op": "==", "value": 0 },
    { "do": "watch", "note": "姿勢を保つ：バンクが 5° を超えない", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "abs": true, "max": 5, "timeout": 8 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：LOC と G/S に琥珀の線", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_mode_fail" },
    { "do": "cas", "note": ">AUTOPILOT" },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_autopilot" },

    { "do": "mark", "note": "NAV 1 を戻しても故障のまま、TO/GA で消える（ATA22 p.254）" },
    { "do": "set", "note": "NAV 1 を戻す", "dref": "sim/operation/failures/rel_nav1", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "LOC はまだ故障", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "AUTOPILOT もまだ", "dref": "laminar/B747/CAS/caution_status[4]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "G/A（FMA のロールは TO/GA）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "ロールの故障が消える", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "ピッチの故障も", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT が消える", "dref": "laminar/B747/CAS/caution_status[4]", "op": "==", "value": 0 },
    { "do": "check", "note": "F/D のバーが戻る", "dref": "laminar/B747/autopilot/fd/roll_bar", "op": "==", "value": 1 },
    { "do": "view", "note": "機長の PFD：G/A", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_ga_after_fail" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
