{
  "name": "s155_eo_takeoff_speeds",
  "description": "6-1/6-2 段 9h3b（離陸の E/O の速さ）の X-Plane での確認。s141 と同じ RJAA 34L のフラップ 20 の離陸（機体を読み直す）で、TAKEOFF REF の E/O ACCEL HT を 1,500 ft、VNAV は arm しない（AFDS は T/O のまま）。約 550 ft で FUEL CONTROL 2 を CUTOFF：AFDS の T/O の目標はそのときの速さを V2〜V2 + 10 に（ATA22 p.264）。VNAV を押すと FMC の目標は V2 + 10（FCOM p.1266）。E/O の加速高度（1,641 ft）で VREF 30 + 100 をフラップ 20 の placard の 5 kt 下で頭打ち、CLB のページの題は LIM SPD CLB。フラップ UP で VREF 30 + 100、題は ACT VREF + 100 CLB（FCOM p.1265）、VREF + 98 で CON。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 9,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 9000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 9000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s109 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA のピッチは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },

    { "do": "mark", "note": "CDU：経路、PERF INIT、TAKEOFF REF" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "170", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 17,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 17000 },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20（1L）、V1・VR・V2 を選ぶ（1R〜3R）", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "V2 を選んだ（999 でない）", "dref": "laminar/B747/airspeed/V2", "op": "<", "value": 900 },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2", "as": "v2" },
    { "do": "snapshot", "note": "V speeds と FMC の VNAV", "drefs": [ "laminar/B747/airspeed/V1", "laminar/B747/airspeed/Vr", "laminar/B747/airspeed/V2", "laminar/B747/fms/vnav/valid", "laminar/B747/fms/vnav/perf", "laminar/B747/fms/vnav/phase", "laminar/B747/fms/vnav/cas" ] },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "地上の目標速度は V2 + 10（止まっている：FCOM p.1255）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [9.5, 10.5], "rel": "v2" },
    { "do": "cdu", "note": "E/O ACCEL HT 1,500 ft（2L：FCOM p.1319）", "keys": ["1500", "L2"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "MCP の速さを V2 に（離陸の前：AFDS の T/O の V2 は窓の値、FCOM p.664）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "v2" },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "mark", "note": "離陸（VNAV は arm しない：AFDS は T/O のまま）" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 90 },
    { "do": "set", "note": "操縦輪を引く（引き起こし）", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.35 },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "set", "note": "操縦輪を緩める", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0.15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "cmd", "note": "手の操縦を終える（操縦輪はそのまま）", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },

    { "do": "check", "note": "FMA のピッチは TO/GA（VNAV は arm していない）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },

    { "do": "mark", "note": "エンジン 2 を止める（AFDS の T/O）" },
    { "do": "wait", "note": "電波高度 550 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 550, "timeout": 40 },
    { "do": "snapshot", "note": "T/O の目標", "drefs": [ "laminar/B747/autopilot/pitch_target", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/V2", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "T/O の目標は V2 + 10〜V2 + 25（FCOM p.666）", "dref": "laminar/B747/autopilot/pitch_target", "op": "between", "value": [9.5, 25.5], "rel": "v2" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "wait", "note": "エンジン 2 の inop", "dref": "laminar/B747/engines/inop[1]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "故障の後の T/O の目標", "drefs": [ "laminar/B747/autopilot/pitch_target", "laminar/B747/airspeed/Vminm", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "T/O の目標は V2〜V2 + 10（ATA22 p.264。速度の保護の最小機動速度 + 5 kt で上がることがある：FCOM p.675）。前の V2 + 25 からは下がる", "dref": "laminar/B747/autopilot/pitch_target", "op": "between", "value": [-0.5, 15], "rel": "v2" },
    { "do": "check", "note": "まだ E/O の加速高度（1,641 ft）の下", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 1550 },

    { "do": "mark", "note": "VNAV を押す" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC の目標は V2 + 10（FCOM p.1266）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [9.5, 10.5], "rel": "v2" },
    { "do": "cdu", "note": "VNAV（CLB のページ）", "keys": ["VNAV"] },
    { "do": "wait", "note": "E/O の加速高度（標高 141 + 1,500 ft）の上", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 1700, "timeout": 120 },
    { "do": "sleep", "seconds": 2 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vmax", "as": "vmax20" },
    { "do": "snapshot", "note": "E/O の加速高度の後", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/airspeed/Vmax", "laminar/B747/airspeed/Vf30", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms3/Line01_L", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "VREF + 100 はフラップ 20 の placard の 5 kt 下で頭打ち（FCOM p.1266）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [-5.5, -4.5], "rel": "vmax20" },
    { "do": "check", "note": "題は LIM SPD CLB（FCOM p.1265 の注）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT LIM SPD CLB" },

    { "do": "mark", "note": "フラップを上げる" },
    { "do": "wait", "note": "200 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 200, "timeout": 90 },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "wait", "note": "215 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 215, "timeout": 90 },
    { "do": "set", "note": "フラップ 5", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.34 },
    { "do": "wait", "note": "230 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 230, "timeout": 90 },
    { "do": "set", "note": "フラップ 1", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.168 },
    { "do": "wait", "note": "238 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 238, "timeout": 90 },
    { "do": "set", "note": "フラップ UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "remember", "dref": "laminar/B747/airspeed/Vf30", "as": "vref" },
    { "do": "snapshot", "note": "フラップ UP", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/airspeed/Vf30", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms3/Line01_L", "laminar/B747/engines/ref_thr_limit_mode" ] },
    { "do": "check", "note": "フラップ UP：VREF 30 + 100（FCOM p.1266）", "dref": "laminar/B747/fms/vnav/cas", "op": "between", "value": [99.5, 100.5], "rel": "vref" },
    { "do": "check", "note": "題は ACT VREF + 100 CLB（FCOM p.1265）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT VREF + 100 CLB" },
    { "do": "wait", "note": "VREF + 98 で CON（段 9h3a）", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CON", "timeout": 120 },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "VREF + 100 の上昇", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/fms3/Line01_L" ] },
    { "do": "check", "note": "速さは VREF + 100 の近く", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [90, 110], "rel": "vref" },
    { "do": "record_stop" }
  ]
}
