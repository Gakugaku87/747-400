{
  "name": "s94_refnavdata",
  "description": "REF NAV DATA（6-1・6-2 段 7e）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す）。航法データを読み終えた後、INIT/REF INDEX の NAV DATA>（FCOM p.1281）で FMC の REF NAV DATA ページ（FCOM p.1355。前は X-Plane の DATABASE ページ）。IDENT に NRE（VOR/DME：FREQ・位置・MAG VAR・ELEVATION：FCOM p.1356）、AKAGI（2 か所：SELECT DESIRED WPT、FCOM p.1335）、目的地が無いときの RW06R（NOT IN DATA BASE）、RTE で RJAA→RJBB を入れて選び直し（IDENT はダッシュ）、RW06R（目的地の滑走路：LENGTH と ELEVATION、FMSPG p.171）。NAVAID INHIBIT に NRE、VOR ONLY INHIBIT に XAC、VOR/DME NAV の INHIBIT> で ALL（FCOM p.1356-1357；FMSPG p.172-174）。右の CDU にも同じ抑止、そこで ENABLE>。CDU を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },

    { "do": "mark", "note": "INIT/REF INDEX の NAV DATA>（FCOM p.1281）" },
    { "do": "cdu", "note": "INIT REF、<INDEX", "keys": ["INITREF", "L6"] },
    { "do": "check", "note": "1R に NAV DATA>", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "NAV DATA>" },
    { "do": "cdu", "keys": ["R1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMC の REF NAV DATA（FCOM p.1355）", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "      REF NAV DATA      " },
    { "do": "check", "note": "IDENT はダッシュ", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "-----                   " },
    { "do": "check", "note": "NAVAID INHIBIT のダッシュ", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "----                ----" },
    { "do": "check", "note": "VOR/DME NAV（小字）", "dref": "laminar/B747/fms3/Line12_S", "op": "==", "value": "             VOR/DME NAV" },
    { "do": "check", "note": "<INDEX と INHIBIT>", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX          INHIBIT>" },

    { "do": "mark", "note": "IDENT に NRE（成田の VOR/DME）" },
    { "do": "cdu", "keys": ["NRE", "L1", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "NRE と FREQ 117.90", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^NRE +117\\.90$" },
    { "do": "check", "note": "FREQ の見出し", "dref": "laminar/B747/fms3/Line02_S", "op": "==", "value": " IDENT              FREQ" },
    { "do": "check", "note": "緯度と経度（N35`46.9、E140`21.8 ほど）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^N35`46\\.\\d +E140`21\\.\\d$" },
    { "do": "check", "note": "MAG VAR W7、ELEVATION 154 ほど（FT は小字）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^W7 +1\\d\\d  $" },
    { "do": "check", "note": "MAG VAR と ELEVATION の見出し", "dref": "laminar/B747/fms3/Line06_S", "op": "==", "value": " MAG VAR       ELEVATION" },
    { "do": "check", "note": "FT（小字）", "dref": "laminar/B747/fms3/Line07_S", "op": "==", "value": "                      FT" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_refnav_nre" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "AKAGI：2 か所あるので SELECT DESIRED WPT（FCOM p.1335：飛行機に近い順）" },
    { "do": "cdu", "keys": ["AKAGI", "L1"] },
    { "do": "check", "note": "SELECT DESIRED WPT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "SELECT DESIRED WPT" },
    { "do": "cdu", "note": "近い方を選ぶ", "keys": ["?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "REF NAV DATA に戻る", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "      REF NAV DATA      " },
    { "do": "check", "note": "近い方（RJ：N36`23.5、E139`41.9 ほど）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^N36`23\\.\\d +E139`41\\.\\d$" },
    { "do": "check", "note": "ウェイポイント：FREQ なし", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "AKAGI                   " },
    { "do": "check", "note": "MAG VAR・ELEVATION なし（FMSPG p.172）", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": "                        " },

    { "do": "mark", "note": "目的地の滑走路（FMSPG p.171）" },
    { "do": "cdu", "keys": ["RW06R", "L1"] },
    { "do": "check", "note": "目的地が無い：NOT IN DATA BASE", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "NOT IN DATA BASE" },
    { "do": "cdu", "note": "メッセージと入力を消す", "keys": ["CLR", "CLR", "CLR", "CLR", "CLR", "CLR"] },
    { "do": "cdu", "note": "RTE：RJAA→RJBB", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1"] },
    { "do": "cdu", "note": "選び直す", "keys": ["INITREF", "L6", "R1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "選び直したので IDENT はダッシュ（FCOM p.1355）", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "-----                   " },
    { "do": "cdu", "keys": ["RW06R", "L1"] },
    { "do": "check", "note": "RW06R", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "RW06R                   " },
    { "do": "check", "note": "閾値の緯度と経度（N34`25.0、E135`13.8 ほど）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^N34`2[45]\\.\\d +E135`13\\.\\d$" },
    { "do": "check", "note": "LENGTH（両端の閾値から 11,470 ft ほど：3,500 m。推定）と ELEVATION", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^11[45]\\d\\d   +-?\\d+  $" },
    { "do": "check", "note": "LENGTH と ELEVATION の見出し", "dref": "laminar/B747/fms3/Line06_S", "op": "==", "value": " LENGTH        ELEVATION" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_refnav_runway" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "NAVAID INHIBIT に NRE、VOR ONLY INHIBIT に XAC、VOR/DME NAV（FCOM p.1356-1357；FMSPG p.172-174）" },
    { "do": "cdu", "keys": ["NRE", "L4", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "4L に NRE", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "NRE                 ----" },
    { "do": "cdu", "keys": ["XAC", "L5", "?SEL"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "5L に XAC（VORTAC）", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "XAC                 ----" },
    { "do": "cdu", "note": "INHIBIT>", "keys": ["R6"] },
    { "do": "check", "note": "ENABLE> に変わる", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX           ENABLE>" },
    { "do": "check", "note": "VOR ONLY の行に ALL（小字：FMSPG p.173）", "dref": "laminar/B747/fms3/Line11_S", "op": "==", "value": "ALL                  ALL" },
    { "do": "check", "note": "XAC は消える（FCOM p.1357）", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "                        " },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_refnav_inhibit" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "右の CDU（キーも画面も fms2）にも同じ抑止（両方の FMC のもの）" },
    { "do": "cdu", "cdu": "fms2", "keys": ["INITREF", "L6", "R1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "右の REF NAV DATA", "dref": "laminar/B747/fms2/Line01_L", "op": "==", "value": "      REF NAV DATA      " },
    { "do": "check", "note": "右の IDENT はダッシュ（CDU ごと）", "dref": "laminar/B747/fms2/Line03_L", "op": "==", "value": "-----                   " },
    { "do": "check", "note": "NAVAID INHIBIT の NRE", "dref": "laminar/B747/fms2/Line09_L", "op": "==", "value": "NRE                 ----" },
    { "do": "check", "note": "ENABLE>", "dref": "laminar/B747/fms2/Line13_L", "op": "==", "value": "<INDEX           ENABLE>" },
    { "do": "cdu", "cdu": "fms2", "note": "ENABLE>", "keys": ["R6"] },
    { "do": "check", "note": "INHIBIT> に戻る", "dref": "laminar/B747/fms2/Line13_L", "op": "==", "value": "<INDEX          INHIBIT>" },
    { "do": "check", "note": "VOR ONLY はダッシュ（FMSPG p.174）", "dref": "laminar/B747/fms2/Line11_L", "op": "==", "value": "----                ----" },
    { "do": "cdu", "note": "左で DELETE を 4L", "keys": ["DEL", "L4"] },
    { "do": "check", "note": "NRE の抑止が消える（FCOM p.1356）", "dref": "laminar/B747/fms3/Line09_L", "op": "==", "value": "----                ----" },
    { "do": "check", "note": "左の IDENT はそのまま", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "RW06R                   " },
    { "do": "cdu", "note": "<INDEX", "keys": ["L6"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "INIT/REF INDEX", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "INIT/REF INDEX" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 }
  ]
}
