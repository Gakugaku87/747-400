{
  "name": "s175_nd_fmc_fail",
  "description": "6-1/6-2 段 11d2b（FMC の故障の ND の旗）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、XAC へ DIRECT。機長の NAV ソース選択は FMC L、副操縦士は FMC R。左 FMC を故障させると、機長の ND に VTK 旗がすぐ出て現用点の ETA と距離が消え、30 秒で MAP 旗（ATA34_2 p.630、p.633、LH3460 p.114）。副操縦士の ND（右 FMC）はそのまま。機長の NAV ソース選択を FMC R にすると戻り、左の CDU も右 FMC につながる（FCOM p.1422）。機長の ND を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "check", "note": "機長の NAV ソース選択は FMC L", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士は FMC R", "dref": "laminar/B747/flt_inst/nav_src/fo/sel_dial_pos", "op": "==", "value": 3 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "LEGS で XAC へ DIRECT TO、EXEC", "keys": ["LEGS", "XAC", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "機長の ND を MAP に", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の ND に旗なし", "dref": "laminar/B747/nd/capt/vtk_flag", "op": "==", "value": 0 },
    { "do": "check", "note": "MAP 旗なし", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 0 },
    { "do": "check", "note": "現用点の ETA と距離を出す", "dref": "laminar/B747/nd/capt/wpt_data", "op": "==", "value": 1 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_normal" },

    { "do": "mark", "note": "左 FMC の故障" },
    { "do": "set", "note": "左 FMC を故障させる", "dref": "laminar/B747/fms/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の ND に VTK 旗（ATA34_2 p.630）", "dref": "laminar/B747/nd/capt/vtk_flag", "op": "==", "value": 1 },
    { "do": "check", "note": "現用点の ETA と距離が消える（ATA34_2 p.633）", "dref": "laminar/B747/nd/capt/wpt_data", "op": "==", "value": 0 },
    { "do": "check", "note": "MAP 旗はまだ", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の ND（右 FMC）はそのまま", "dref": "laminar/B747/nd/fo/wpt_data", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士に VTK 旗なし", "dref": "laminar/B747/nd/fo/vtk_flag", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_fmc_fail_vtk" },
    { "do": "wait", "note": "30 秒で MAP 旗（LH3460 p.114）", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 1, "timeout": 40 },
    { "do": "shot", "name": "nd_fmc_fail_map" },

    { "do": "mark", "note": "機長の NAV ソース選択を FMC R に" },
    { "do": "set", "note": "機長の NAV ソース選択を FMC R に", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "VTK 旗が消える（FCOM p.1422）", "dref": "laminar/B747/nd/capt/vtk_flag", "op": "==", "value": 0 },
    { "do": "check", "note": "MAP 旗も", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 0 },
    { "do": "check", "note": "ETA と距離が戻る", "dref": "laminar/B747/nd/capt/wpt_data", "op": "==", "value": 1 },
    { "do": "check", "note": "左の CDU も右 FMC につながる（FCOM p.1422）", "dref": "laminar/B747/fms/cdu_link[0]", "op": "==", "value": 2 },
    { "do": "shot", "name": "nd_fmc_r" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
