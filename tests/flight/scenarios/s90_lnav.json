{
  "name": "s90_lnav",
  "description": "FMC の LNAV（6-1・6-2 段 6c）の X-Plane での確認、空中。RJAA→XAC の脚の右 6 nm、XAC の 15 nm 手前、10,000 ft、脚と平行に 250 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DIRECT XAC・SPENS・BOKJO を入れ、空中で ACTIVATE と EXEC。HDG SEL のまま LNAV を arm：捕捉の外で平行なので engage せず、CDU に NOT ON INTERCEPT HEADING（FCOM p.1435）、ロールモードは HDG SEL のまま（FCOM p.644）。HDG SEL で 30° 脚へ向けると、2.5 nm 以内で LNAV が engage（ATA34_2 p.618）、脚に乗る。XAC の fly-by の旋回（右 54°）を経路から 0.5 nm 以内で飛び、SPENS へ（推定：25° のバンク）。DIRECT TO XAC（通過した点：後ろに ROUTE DISCONTINUITY）：機体のいる所から引き返して（大回りしない）XAC を過ぎると今のヘディングを保持し、CDU に DISCONTINUITY（FCOM p.644、p.1431）。CDU と ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.97139, "longitude": 139.50152, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（脚と平行：真 217）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO、空中で ACTIVATE と EXEC" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "check", "note": "DIRECT BOKJO", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "BOKJO" },
    { "do": "cdu", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },
    { "do": "check", "note": "現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "check", "note": "FMC がアクティブな経路を自分で順送りする", "dref": "laminar/B747/fms/lnav/route", "op": "==", "value": 1 },

    { "do": "mark", "note": "脚と平行に 6 nm 離れて LNAV を arm" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "LNAV は arm のまま（捕捉の外：ATA34_2 p.618）", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 1 },
    { "do": "check", "note": "FMA：LNAV（白）", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "ロールモードは HDG SEL のまま（FCOM p.644）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "FMC の steering は無効", "dref": "laminar/B747/fms/lnav/valid", "op": "==", "value": 0 },
    { "do": "check", "note": "CDU に NOT ON INTERCEPT HEADING（FCOM p.1435）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "NOT ON INTERCEPT HEADING" },
    { "do": "check", "note": "XTK は右に約 6 nm", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [5, 7] },

    { "do": "mark", "note": "HDG SEL で脚へ 30°：2.5 nm 以内で LNAV が engage" },
    { "do": "set", "note": "MCP 方位 194（真 187）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 194 },
    { "do": "wait", "note": "脚へ向かうと NOT ON INTERCEPT HEADING が消える", "dref": "laminar/B747/fms3/Line14_L", "op": "!=", "value": "NOT ON INTERCEPT HEADING", "timeout": 60 },
    { "do": "wait", "note": "LNAV engage（ATA34_2 p.618–619）", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 300 },
    { "do": "check", "note": "engage は脚から 2.5 nm 以内で", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-2.6, 2.6] },
    { "do": "check", "note": "FMA：LNAV（緑）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "watch", "note": "脚に乗る（2.6 nm を超えて離れない）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 2.6, "until": { "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.1, 0.1] }, "timeout": 240 },

    { "do": "mark", "note": "XAC の fly-by の旋回" },
    { "do": "watch", "note": "XAC まで脚から 0.5 nm 以内（旋回の前半を含む）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "until": { "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SPENS" }, "timeout": 300 },
    { "do": "watch", "note": "旋回の後半も 0.5 nm 以内", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "timeout": 30 },
    { "do": "watch", "note": "バンクは 25° 前後まで（ATA34_2 p.618。サーボの行き過ぎを 3° 見る）", "dref": "sim/flightmodel/position/phi", "abs": true, "max": 28, "timeout": 20 },
    { "do": "check", "note": "SPENS への脚の上", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.2, 0.2] },
    { "do": "check", "note": "AFDS の現用点：SPENS（RJAA・XAC・SPENS・BOKJO・RJBB の 3 番目）", "dref": "laminar/B747/autopilot/ap_monitor/fmscurrentIndex", "op": "==", "value": 3 },
    { "do": "check", "note": "ND の現用点 SPENS", "dref": "laminar/B747/nd/current_waypoint", "op": "==", "value": "SPENS" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_after_xac" },

    { "do": "mark", "note": "DIRECT TO XAC（通過した点）：後ろに ROUTE DISCONTINUITY" },
    { "do": "cdu", "keys": ["LEGS", "XAC", "L1", "?SEL", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC" },
    { "do": "check", "note": "その後に discontinuity の箱", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "*****" },
    { "do": "watch", "note": "機体のいる所から XAC へ（旋回の後はそこからの大円：FCOM p.1237）、大回りせず 0.5 nm 以内。XAC を過ぎて discontinuity が先頭に（XAC は LEGS から消える）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "until": { "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "*****" }, "timeout": 300 },
    { "do": "check", "note": "今のヘディングを保持（mode 3：FCOM p.644）", "dref": "laminar/B747/fms/lnav/mode", "op": "==", "value": 3 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2 },
    { "do": "check", "note": "CDU に DISCONTINUITY（FCOM p.1431）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "DISCONTINUITY" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "ヘディングが変わらない", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [-2, 2], "rel": "hdg" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_discontinuity" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_discontinuity" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
