{
  "name": "s35_gear",
  "description": "脚の作動（4-2 段 1）の X-Plane での確認。10,000 ft の空中開始（X-Plane は脚を上げて置く）で、3 秒後にレバーが UP になり表示が出ないこと（前は空中開始でレバーを UP へ動かして脚を上げていた）。DN でドアが先に開き、脚が下りて DOWN（前脚が最後で 2 + 12 秒）。UP で UP、10 秒後に表示が消える。ENGINE pump 4 と DEMAND 4 を OFF にして系統 4 を抜き DN にすると、前脚・胴体脚だけが下りて翼脚は上のまま、30 秒で GEAR DISAGREE と展開形の表示（写真）。ALTN WING で翼脚のドアが開き約 20 秒で下りてダウンロック、ドアは開いたまま、GEAR DISAGREE は消え、GEAR DOOR は出ない（写真）。",
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 110 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 15, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "note": "MCP 速度 220 kt（脚の操作の制限 270 kt の下）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 220 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "check", "note": "空中開始：レバーは脚に合わせて UP", "dref": "laminar/B747/actuator/gear_handle", "op": "==", "value": 2 },
    { "do": "check", "note": "脚は上のまま", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "全脚 UP でロック：表示なし", "dref": "laminar/B747/gear/EICAS1_display_status", "op": "==", "value": 0 },
    { "do": "check", "note": "トラックが傾き DC bus 2 あり：レバーのロックは外れている", "dref": "laminar/B747/gear/lever_lock", "op": "==", "value": 0 },

    { "do": "mark", "note": "DN" },
    { "do": "cmd", "note": "レバー DN", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "wait", "note": "レバーが DN", "dref": "laminar/B747/actuator/gear_handle", "op": "==", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 1.2 },
    { "do": "check", "note": "ドアが先に開く（約 2 秒：ATA29_32 p.242, p.256）", "dref": "laminar/B747/gear/door[0]", "op": "between", "value": [0.3, 0.99] },
    { "do": "check", "note": "前脚はまだ上", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "==", "value": 0 },
    { "do": "wait", "note": "DOWN（前脚が最後：2 + 12 秒、推定）", "dref": "laminar/B747/gear/gear_position/annun_status", "op": "==", "value": 1, "timeout": 25 },
    { "do": "check", "note": "通常の表示", "dref": "laminar/B747/gear/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "wait", "note": "ドアが閉じる（約 5 秒：p.248）", "dref": "laminar/B747/gear/door[0]", "op": "==", "value": 0, "timeout": 10 },

    { "do": "mark", "note": "UP" },
    { "do": "cmd", "note": "レバー UP", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "UP", "dref": "laminar/B747/gear/gear_position/annun_status", "op": "==", "value": 0, "timeout": 25 },
    { "do": "check", "note": "UP の表示は 10 秒出る（FCOM p.1505）", "dref": "laminar/B747/gear/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "wait", "note": "10 秒で消える", "dref": "laminar/B747/gear/EICAS1_display_status", "op": "==", "value": 0, "timeout": 15 },

    { "do": "mark", "note": "system 4 off" },
    { "do": "switch", "note": "ENGINE pump 4 OFF", "dref": "laminar/B747/button_switch/position[33]", "value": 0, "cmd": "laminar/B747/button_switch/hyd_pump_4" },
    { "do": "switch", "note": "DEMAND 4 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[3]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_04_dn" },
    { "do": "wait", "note": "系統 4 の圧が抜ける", "dref": "laminar/B747/hydraulics/pressure_4", "op": "<", "value": 500, "timeout": 30 },
    { "do": "cmd", "note": "レバー DN", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "系統 1 の前脚・胴体脚は下りる（右胴体 = X-Plane 1）", "dref": "sim/flightmodel2/gear/deploy_ratio[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "系統 4 の翼脚は上のまま（右翼 = X-Plane 3）", "dref": "sim/flightmodel2/gear/deploy_ratio[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "20 秒：GEAR DISAGREE はまだ（30 秒：ATA29_32 p.662）", "dref": "laminar/B747/CAS/caution_status[38]", "op": "==", "value": 0 },
    { "do": "wait", "note": "GEAR DISAGREE", "dref": "laminar/B747/CAS/caution_status[38]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "check", "note": "展開形の表示（p.660）", "dref": "laminar/B747/gear/EICAS1_display_status", "op": "==", "value": 2 },
    { "do": "check", "note": "左翼脚の箱 UP", "dref": "laminar/B747/gear/gear_position/annun_gear[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "左胴体脚の箱 DN", "dref": "laminar/B747/gear/gear_position/annun_gear[1]", "op": "==", "value": 1 },
    { "do": "cas", "note": "系統 4 なしで DN" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "gear_expanded_disagree" },

    { "do": "mark", "note": "ALTN WING" },
    { "do": "cmd", "note": "ALTN GEAR EXTEND WING", "name": "laminar/B747/button_switch/altn_wing_gear_extend" },
    { "do": "wait", "note": "翼脚がダウンロック（約 20 秒：p.250）", "dref": "sim/flightmodel2/gear/deploy_ratio[4]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "check", "note": "翼脚のドアは開いたまま（FCOM p.1513）", "dref": "laminar/B747/gear/door[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "全脚ダウン：GEAR DISAGREE は消える", "dref": "laminar/B747/CAS/caution_status[38]", "op": "==", "value": 0 },
    { "do": "check", "note": "代替下げの後：展開形のまま", "dref": "laminar/B747/gear/EICAS1_display_status", "op": "==", "value": 2 },
    { "do": "sleep", "seconds": 32 },
    { "do": "check", "note": "ドアが開いたまま 30 秒を超えても GEAR DOOR は出ない（p.673）", "dref": "laminar/B747/CAS/advisory_status[180]", "op": "==", "value": 0 },
    { "do": "cas", "note": "ALTN WING の後" },
    { "do": "shot", "name": "gear_expanded_altn" }
  ]
}
