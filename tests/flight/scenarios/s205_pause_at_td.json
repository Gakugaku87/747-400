{
  "name": "s205_pause_at_td",
  "description": "シムの便利機能（notes/ATA-34-61-FMC.md §126）の T/D 前の一時停止の X-Plane での確認、空中。s202 と同じ所（FL250・約 330 kt、ATMUG の約 68 NM 西から東へ空中開始。機体を読み直す）。RTE RJAA→RJBB、STAR ATMUGA、ILS06LZ の遷移 ATVID、ACTIVATE と EXEC、ATMUG へ DIRECT TO、LNAV、PERF INIT（ZFW 200、COST INDEX 100、CRZ ALT FL250）、MCP 3,000 ft で VNAV。CRZ のページを出し、Plugins → 747-400 の Pause 2 min before T/D を dataref で ON（保存しない）。T/D の約 2 分前（FMC の RESET MCP ALT と同じ：FCOM p.1433）に X-Plane が一時停止し、CRZ のページの TO T/D は約 2 分の距離。撮影、一時停止を解いて、もう一度止まらないこと、T/D で降下に入ることを確かめる。最後に dataref を OFF。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 132.75, "elevation_in_meters": 7620, "heading_true": 97, "speed_in_meters_per_second": 230 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "check", "note": "プラグインのオプションの dataref がある（新しい b747_fms_bridge）", "dref": "laminar/B747/options/pause_at_td", "op": "between", "value": [0, 1] },
    { "do": "set", "note": "Pause at T/D を OFF から始める（保存しない）", "dref": "laminar/B747/options/pause_at_td", "value": 0 },
    { "do": "set", "dref": "laminar/B747/options/auto_step_climb", "value": 0 },
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "MCP 高度 25,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 25000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 25000 },
    { "do": "cmd", "note": "FLCH で FL250 へ", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FL250 に着く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [24900, 25150], "timeout": 300 },
    { "do": "sleep", "seconds": 15, "note": "FL250 で落ち着く" },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LZ（R4）", "keys": ["L1", "R4"] },
    { "do": "check", "note": "ILS06LZ を選んだ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ILS06LZ" },
    { "do": "cdu", "note": "遷移 ATVID（R2）", "keys": ["R2"] },
    { "do": "check", "note": "遷移 ATVID", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "ATVID" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL250", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "250", "R1"] },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "cmd", "note": "VNAV のページ（CRZ）", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CRZ のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CRZ" },
    { "do": "check", "note": "まだ一時停止していない", "dref": "sim/time/paused", "op": "==", "value": 0 },
    { "do": "set", "note": "Pause 2 min before T/D を ON（Plugins → 747-400 の項目の dataref。保存しない）", "dref": "laminar/B747/options/pause_at_td", "value": 1 },
    { "do": "mark" },
    { "do": "wait", "note": "T/D の約 2 分前に一時停止", "dref": "sim/time/paused", "op": "==", "value": 1, "timeout": 600 },
    { "do": "snapshot", "note": "一時停止したところ（CRZ のページの TO T/D）", "drefs": [ "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/vnav/phase", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel2/position/groundspeed", "laminar/B747/fms/vnav/dist" ] },
    { "do": "check", "note": "CRZ のページは TO T/D", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "TO T/D" },
    { "do": "check", "note": "T/D まで約 2 分（9〜19 NM：対地速度 300〜560 kt）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "z/ +(9|1[0-9])NM$" },
    { "do": "check", "note": "FMC の段階はまだ巡航（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_crz_paused" },
    { "do": "view", "note": "機長の PFD と ND", "the": -24, "psi": 4, "fov": 34 },
    { "do": "shot", "name": "pfd_nd_paused" },
    { "do": "sleep", "seconds": 5, "note": "一時停止のまま" },
    { "do": "check", "note": "まだ一時停止", "dref": "sim/time/paused", "op": "==", "value": 1 },
    { "do": "cmd", "note": "一時停止を解く", "name": "sim/operation/pause_off" },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "もう一度は止まらない", "dref": "sim/time/paused", "op": "==", "value": 0 },
    { "do": "wait", "note": "T/D で降下（FMC の段階 3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 240 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "降下でも止まらない", "dref": "sim/time/paused", "op": "==", "value": 0 },
    { "do": "record_stop" },
    { "do": "set", "note": "Pause at T/D を OFF に戻す", "dref": "laminar/B747/options/pause_at_td", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
