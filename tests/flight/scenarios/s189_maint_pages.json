{
  "name": "s189_maint_pages",
  "description": "6-1・6-2 段 12c2（保守のページの残り：IRS MONITOR、BITE REPORT、NAV DATA CROSSLOAD）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。左の CDU の IRS MONITOR は IRS L・C・R の見出しで、飛行の前なので率は空白（FMSPG p.269）。BITE REPORT は左の CDU で FMC L、右の CDU で FMC R、DATA LOADER にキャレットなし（data loader が無い：ATA34_2 p.684）。NAV DATA CROSSLOAD は 2L に航法データの識別、両方の CDU で 6R に ARM、左の 3L の TRANSMIT と右の 3R の RECEIVE で TRANSFER IN PROGRESS、30 秒（推定）で TRANSFER COMPLETE（ATA34_2 p.676）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "左の CDU：MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "右の CDU：MENU、<FMC（IDENT）", "cdu": "fms2", "keys": ["MENU", "L1"] },
    { "do": "check", "note": "右の CDU は IDENT", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "IDENT" },
    { "do": "cdu", "note": "左：<INDEX、MAINT>、<IRS MONITOR", "keys": ["L6", "R6", "L3"] },
    { "do": "check", "note": "IRS MONITOR", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "      IRS MONITOR       " },
    { "do": "check", "note": "IRS L の見出し", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": " IRS L" },
    { "do": "check", "note": "IRS R の見出し", "dref": "laminar/B747/fms3/Line08_S", "op": "contains", "value": " IRS R" },
    { "do": "check", "note": "飛行の前は率なし", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "                        " },
    { "do": "check", "note": "<INDEX の上の線", "dref": "laminar/B747/fms3/Line12_L", "op": "==", "value": "------------------------" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_irs_monitor" },
    { "do": "cdu", "note": "左：<INDEX（MAINTENANCE INDEX）、BITE>", "keys": ["L6", "R1"] },
    { "do": "check", "note": "FMC L BITE REPORT", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "   FMC L BITE REPORT    " },
    { "do": "check", "note": "DATA LOADER にキャレットなし", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": " DATA LOADER            " },
    { "do": "shot", "name": "cdu_bite_l" },
    { "do": "cdu", "note": "右：<INDEX、MAINT>、BITE>", "cdu": "fms2", "keys": ["L6", "R6", "R1"] },
    { "do": "check", "note": "右の CDU は FMC R BITE REPORT", "dref": "laminar/B747/fms2/Line01_L", "op": "==", "value": "   FMC R BITE REPORT    " },
    { "do": "cdu", "note": "左：<INDEX、<CROSS LOAD", "keys": ["L6", "L1"] },
    { "do": "check", "note": "NAV DATA CROSSLOAD", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "   NAV DATA CROSSLOAD   " },
    { "do": "check", "note": "2L は航法データの識別（IDENT と同じ）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC" },
    { "do": "check", "note": "<TRANSMIT と RECEIVE>", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": "<TRANSMIT       RECEIVE>" },
    { "do": "check", "note": "6R は ---", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX               ---" },
    { "do": "cdu", "note": "左：6R に ARM、3L の TRANSMIT", "keys": ["ARM", "R6", "L3"] },
    { "do": "check", "note": "左は ARM", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX               ARM" },
    { "do": "cdu", "note": "右：<INDEX、<CROSS LOAD、6R に ARM、3R の RECEIVE", "cdu": "fms2", "keys": ["L6", "L1", "ARM", "R6", "R3"] },
    { "do": "check", "note": "右に TRANSFER IN PROGRESS", "dref": "laminar/B747/fms2/Line09_L", "op": "contains", "value": "TRANSFER IN PROGRESS" },
    { "do": "check", "note": "左にも", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "TRANSFER IN PROGRESS" },
    { "do": "shot", "name": "cdu_crossload_progress" },
    { "do": "sleep", "seconds": 31 },
    { "do": "check", "note": "30 秒で TRANSFER COMPLETE（推定）", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "TRANSFER COMPLETE" },
    { "do": "shot", "name": "cdu_crossload_complete" },
    { "do": "cdu", "note": "左右とも <INDEX 2 回で INIT/REF INDEX へ", "keys": ["L6", "L6"] },
    { "do": "cdu", "cdu": "fms2", "keys": ["L6", "L6"] },
    { "do": "check", "note": "左は INIT/REF INDEX", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "INIT/REF INDEX" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
