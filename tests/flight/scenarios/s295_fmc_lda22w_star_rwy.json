    { "do": "snapshot", "note": "LEGS 1 ページ目", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line06_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "STAR の始め AKSEL", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^AKSEL " },
    { "do": "check", "note": "AKSEL の次は SALLY（前は不連続）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^SALLY " },
    { "do": "check", "note": "その次は TT253（前は BEAST）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^TT253" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_legs_1" },
    { "do": "cdu", "note": "LEGS 2 ページ目", "keys": ["NEXT"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "LEGS 2 ページ目", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "STAR の 22 向けの部分の終わり BACON", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^BACON" },
    { "do": "shot", "name": "cdu_legs_2" }
  ]
