    { "do": "wait", "note": "AKSE1B <SEL>", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^AKSE1B<SEL>", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "6 ページ目へ", "keys": ["NEXT", "NEXT", "NEXT", "NEXT", "NEXT"] },
    { "do": "check", "note": "6 ページ目の 1R が LDA22-W", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "LDA22-W$", "stop": true },
    { "do": "cdu", "note": "LDA22-W（1R）", "keys": ["R1"] },
    { "do": "wait", "note": "AKSE1B と LDA22-W", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^AKSE1B<SEL> +<SEL>LDA22-W$", "timeout": 10, "stop": true },
    { "do": "snapshot", "note": "ARRIVALS", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L" ] },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
