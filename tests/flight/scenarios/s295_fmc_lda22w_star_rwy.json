    { "do": "wait", "note": "RJTT ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJTT ARRIVALS", "timeout": 10, "stop": true },
    { "do": "check", "note": "1 ページ目の 2L が AKSE1B", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^AKSE1B ", "stop": true },
