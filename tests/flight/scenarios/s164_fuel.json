{
  "name": "s164_fuel",
  "description": "6-1/6-2 段 11a（FMC の燃料の監視と PROGRESS 2）の X-Plane での確認。空中、成田の北の FL350（機体を読み直す、経路なし）。PROGRESS 2/3（FCOM p.1380）の風・TAS・SAT・FUEL USED（空中開始から）・TOTALIZER と CALCULATED が同じ、PERF INIT の FUEL は CALC。予備タンク 2・3 の燃料を外から空にして漏れを模すと、FUEL DISAGREE - PROG 2（FCOM p.1432）と <USE・USE>、<USE（TOTALIZER）で CALCULATED と FUEL USED が空白、PERF INIT は SENSED（FCOM p.1381）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "sleep", "seconds": 20, "note": "FUEL USED を少し積む" },

    { "do": "mark", "note": "PROGRESS 2/3" },
    { "do": "cdu", "note": "PROG、NEXT", "keys": ["PROG", "NEXT"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "PROGRESS 2/3", "dref": "laminar/B747/fms3/Line01_S", "op": "contains", "value": "2/3" },
    { "do": "check", "note": "H/WIND か T/WIND、WIND、X/WIND", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ [HT]/WIND   WIND    X/WIND$" },
    { "do": "check", "note": "KT は小字（FCOM p.1380）", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^   KT.*KT$" },
    { "do": "check", "note": "FUEL USED の TOT は小字", "dref": "laminar/B747/fms3/Line07_S", "op": "matches", "value": "TOT +[0-9]+[.][0-9]" },
    { "do": "check", "note": "TOTALIZER と CALCULATED", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^ *[0-9]+[.][0-9] +[0-9]+[.][0-9]$" },
    { "do": "check", "note": "<USE は出ない", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^ *$" },
    { "do": "snapshot", "note": "PROGRESS 2", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line07_S", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line13_L", "laminar/B747/fuel/totaliser[4]", "sim/flightmodel/weight/m_fuel_total" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_progress2" },
    { "do": "cdu", "note": "INIT REF、<INDEX、<PERF", "keys": ["INITREF", "L6", "L3"] },
    { "do": "check", "note": "PERF INIT の FUEL は CALC", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "CALC" },

    { "do": "mark", "note": "漏れ：FUEL DISAGREE" },
    { "do": "snapshot", "note": "タンク", "drefs": [ "sim/flightmodel/weight/m_fuel[0]", "sim/flightmodel/weight/m_fuel[1]", "sim/flightmodel/weight/m_fuel[2]", "sim/flightmodel/weight/m_fuel[3]", "sim/flightmodel/weight/m_fuel[4]", "sim/flightmodel/weight/m_fuel[5]", "sim/flightmodel/weight/m_fuel[6]", "sim/flightmodel/weight/m_fuel[7]" ] },
    { "do": "set", "note": "予備タンク 2（X-Plane の 5 番）を空に（外からの変更。エンジンに送っている主タンクは燃料系の部が毎フレーム書くので、外から書いても同じフレームで上書きされる。予備タンクは移送の前なので書かれず、燃料系の部が取り込む）", "dref": "sim/flightmodel/weight/m_fuel[5]", "value": 0 },
    { "do": "set", "note": "予備タンク 3（6 番）も空に（合わせて約 6 t：FUEL DISAGREE の 4,080 kg を超える）", "dref": "sim/flightmodel/weight/m_fuel[6]", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "燃料系の部が取り込んだ", "dref": "sim/flightmodel/weight/m_fuel[5]", "op": "<", "value": 1 },
    { "do": "check", "note": "FUEL DISAGREE - PROG 2 の旗（FCOM p.1432）", "dref": "laminar/B747/fms/notification[15]", "op": "==", "value": 1 },
    { "do": "check", "note": "書き込み行に FUEL DISAGREE - PROG 2", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "FUEL DISAGREE" },
    { "do": "cdu", "note": "CLR、PROG、NEXT", "keys": ["CLR", "PROG", "NEXT"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "<USE と USE>（FCOM p.1380）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<USE +USE>$" },
    { "do": "shot", "name": "cdu_progress2_disagree" },
    { "do": "cdu", "note": "<USE（TOTALIZER）", "keys": ["L5"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CALCULATED は空白（FCOM p.1381）", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^ *[0-9]+[.][0-9] *$" },
    { "do": "check", "note": "FUEL USED も空白", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^ *$" },
    { "do": "check", "note": "<USE は消える", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^ *$" },
    { "do": "cdu", "note": "INIT REF、<INDEX、<PERF", "keys": ["INITREF", "L6", "L3"] },
    { "do": "check", "note": "PERF INIT の FUEL は SENSED", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "SENSED" },
    { "do": "shot", "name": "cdu_perf_init_sensed" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
