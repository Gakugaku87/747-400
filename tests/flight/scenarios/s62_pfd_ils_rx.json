{
  "name": "s62_pfd_ils_rx",
  "description": "PFD の ILS の受信機（5-2 段 5b、パネルの変更）の X-Plane での確認、空中。RJAA 34L の進入路の 12 NM 手前、4,000 ft・200 kt で開始（機体を読み直す）。機長の CDU の NAV RAD で ILS に 111.90/337 を入れて手動の同調にし、ils_dots を 1 にする（s59 と同じ）。各 PFD は使用中の EIU の受信機（FCOM p.1044：L は ILS L = X-Plane の NAV1、C は ILS C = NAV1 のデータ（推定）、R は ILS R = NAV2）。機長の EIU 選択を R・C に回して、偏位の出どころ、識別符号か周波数（識別を受けるまでは周波数：ATA34_1 p.466）、>SNGL SOURCE ILS（FCOM p.1430）を確かめる。NAV2 を局の無い 108.15 にして、機長の PFD に周波数が出て指針が消えることを撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.570791, "longitude": 140.515078, "elevation_in_meters": 1219.2, "heading_true": 329.6, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 337（34L の LOC）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "機長の EIU は L：ILS L", "dref": "laminar/B747/pfd/capt/ils_rx", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の EIU は R：ILS R", "dref": "laminar/B747/pfd/fo/ils_rx", "op": "==", "value": 3 },
    { "do": "check", "note": ">SNGL SOURCE ILS は無い", "dref": "laminar/B747/CAS/caution_status[57]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "機長の CDU の NAV RAD", "name": "laminar/B747/fms1/func_key/navrad" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/slash" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "note": "111.90/337 を ILS の行（L4）へ：手動の同調", "name": "laminar/B747/fms1/ls_key/L4" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "NAV1（ILS L）は 111.90", "dref": "sim/cockpit2/radios/actuators/nav1_frequency_hz", "op": "==", "value": 11190 },
    { "do": "check", "note": "NAV2（ILS R）も 111.90", "dref": "sim/cockpit2/radios/actuators/nav2_frequency_hz", "op": "==", "value": 11190 },
    { "do": "set", "note": "同調の印（s59 と同じ）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "wait", "note": "LOC を受けてポインター", "dref": "laminar/B747/pfd/capt/loc_ptr", "op": ">", "value": 0, "timeout": 20 },
    { "do": "wait", "note": "G/S を受けてポインター", "dref": "laminar/B747/pfd/capt/gs_ptr", "op": ">", "value": 0, "timeout": 20 },
    { "do": "wait", "note": "識別符号 IYQ", "dref": "laminar/B747/pfd/capt/ils_ref", "op": "==", "value": "IYQ", "timeout": 20 },
    { "do": "snapshot", "note": "EIU L・R：偏位は NAV1 と NAV2 から", "drefs": [
      "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "laminar/B747/pfd/capt/loc_dots",
      "sim/cockpit2/radios/indicators/nav1_vdef_dots_pilot", "laminar/B747/pfd/capt/gs_dots",
      "sim/cockpit2/radios/indicators/nav2_hdef_dots_pilot", "laminar/B747/pfd/fo/loc_dots",
      "sim/cockpit2/radios/indicators/nav2_vdef_dots_pilot", "laminar/B747/pfd/fo/gs_dots",
      "laminar/B747/pfd/capt/ils_ref", "laminar/B747/pfd/fo/ils_ref", "laminar/B747/pfd/capt/loc_ptr", "laminar/B747/pfd/fo/loc_ptr" ] },
    { "do": "check", "note": "副操縦士の識別符号も IYQ", "dref": "laminar/B747/pfd/fo/ils_ref", "op": "==", "value": "IYQ" },
    { "do": "check", "note": "副操縦士の LOC ポインター", "dref": "laminar/B747/pfd/fo/loc_ptr", "op": ">", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_ils_rx_capt_L" },
    { "do": "set", "note": "機長の EIU 選択を R", "dref": "laminar/B747/flt_inst/eiu_src/capt/sel_dial_pos", "value": 3 },
    { "do": "wait", "note": "機長の PFD は ILS R", "dref": "laminar/B747/pfd/capt/ils_rx", "op": "==", "value": 3, "timeout": 5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": ">SNGL SOURCE ILS（FCOM p.1430）", "dref": "laminar/B747/CAS/caution_status[57]", "op": "==", "value": 1 },
    { "do": "check", "note": ">SOURCE SEL EIU も", "dref": "laminar/B747/CAS/advisory_status[268]", "op": "==", "value": 1 },
    { "do": "check", "note": "LOC のポインターは残る（NAV2 も IYQ）", "dref": "laminar/B747/pfd/capt/loc_ptr", "op": ">", "value": 0 },
    { "do": "snapshot", "note": "機長の EIU R：偏位は NAV2 から", "drefs": [
      "sim/cockpit2/radios/indicators/nav2_hdef_dots_pilot", "laminar/B747/pfd/capt/loc_dots",
      "sim/cockpit2/radios/indicators/nav2_vdef_dots_pilot", "laminar/B747/pfd/capt/gs_dots", "laminar/B747/pfd/capt/ils_ref" ] },
    { "do": "set", "note": "NAV2 を局の無い 108.15 に", "dref": "sim/cockpit2/radios/actuators/nav2_frequency_hz", "value": 10815 },
    { "do": "wait", "note": "識別を受けないので周波数（ATA34_1 p.466）", "dref": "laminar/B747/pfd/capt/ils_ref", "op": "==", "value": "108.15", "timeout": 10 },
    { "do": "wait", "note": "LOC のポインターが消える", "dref": "laminar/B747/pfd/capt/loc_ptr", "op": "==", "value": 0, "timeout": 10 },
    { "do": "check", "note": "G/S のポインターも", "dref": "laminar/B747/pfd/capt/gs_ptr", "op": "==", "value": 0 },
    { "do": "check", "note": "周波数・コースは出る", "dref": "laminar/B747/pfd/capt/ils_show", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士も周波数", "dref": "laminar/B747/pfd/fo/ils_ref", "op": "==", "value": "108.15" },
    { "do": "shot", "name": "pfd_ils_rx_capt_R_freq" },
    { "do": "set", "note": "機長の EIU 選択を C", "dref": "laminar/B747/flt_inst/eiu_src/capt/sel_dial_pos", "value": 2 },
    { "do": "wait", "note": "機長の PFD は ILS C", "dref": "laminar/B747/pfd/capt/ils_rx", "op": "==", "value": 2, "timeout": 5 },
    { "do": "wait", "note": "NAV1 のデータで LOC のポインター", "dref": "laminar/B747/pfd/capt/loc_ptr", "op": ">", "value": 0, "timeout": 5 },
    { "do": "check", "note": "識別符号 IYQ", "dref": "laminar/B747/pfd/capt/ils_ref", "op": "==", "value": "IYQ" },
    { "do": "check", "note": ">SNGL SOURCE ILS は消える", "dref": "laminar/B747/CAS/caution_status[57]", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "機長の EIU C：偏位は NAV1 から", "drefs": [
      "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "laminar/B747/pfd/capt/loc_dots", "laminar/B747/pfd/capt/ils_ref",
      "laminar/B747/pfd/fo/loc_ptr", "laminar/B747/pfd/fo/ils_ref" ] },
    { "do": "shot", "name": "pfd_ils_rx_capt_C" },
    { "do": "view", "note": "副操縦士の PFD", "the": -19, "psi": 47, "fov": 20 },
    { "do": "shot", "name": "pfd_ils_rx_fo_R_freq" },
    { "do": "set", "note": "副操縦士の EIU 選択を L", "dref": "laminar/B747/flt_inst/eiu_src/fo/sel_dial_pos", "value": 0 },
    { "do": "wait", "note": "副操縦士の PFD は ILS L", "dref": "laminar/B747/pfd/fo/ils_rx", "op": "==", "value": 1, "timeout": 5 },
    { "do": "wait", "note": "NAV1 で LOC のポインター", "dref": "laminar/B747/pfd/fo/loc_ptr", "op": ">", "value": 0, "timeout": 5 },
    { "do": "check", "note": "識別符号 IYQ", "dref": "laminar/B747/pfd/fo/ils_ref", "op": "==", "value": "IYQ" },
    { "do": "shot", "name": "pfd_ils_rx_fo_L" },
    { "do": "set", "note": "副操縦士の EIU 選択を AUTO", "dref": "laminar/B747/flt_inst/eiu_src/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "機長の EIU 選択を AUTO", "dref": "laminar/B747/flt_inst/eiu_src/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "note": "NAV2 を 111.90 に戻す", "dref": "sim/cockpit2/radios/actuators/nav2_frequency_hz", "value": 11190 },
    { "do": "wait", "note": "副操縦士は ILS R に戻る", "dref": "laminar/B747/pfd/fo/ils_rx", "op": "==", "value": 3, "timeout": 5 },
    { "do": "wait", "note": "NAV2 の LOC ポインター", "dref": "laminar/B747/pfd/fo/loc_ptr", "op": ">", "value": 0, "timeout": 10 },
    { "do": "check", "note": "機長は ILS L", "dref": "laminar/B747/pfd/capt/ils_rx", "op": "==", "value": 1 },
    { "do": "check", "note": ">SNGL SOURCE ILS は無い", "dref": "laminar/B747/CAS/caution_status[57]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
