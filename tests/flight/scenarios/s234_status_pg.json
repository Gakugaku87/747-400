{
  "name": "s234_status_pg",
  "description": "STATUS ページの PG 番号（カスタム acf のパネル、2026-11-04 利用者の質問「Lower EICAS の PG 1 は常に出る仕様なの？」）。FCOM p.1545（15.10.19）：PG 番号はステータスメッセージの次のページがあるときだけ出る。前のパネルの条件 `SHOW_GREATER 1.000000 laminar/B747/STAT/num_msg_pages` は 1 も含むので 1 ページでも出ていた。成田 34L でエンジン運転中に開始し、STATUS が 1 ページ（E/E CLNG CARD だけ）のときと、故障を入れて 12 行を超えたとき（2 ページ）の下の EICAS を撮る。外から見た機体も撮る（acf の変更の手順）",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "下の EICAS を STATUS に", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "set", "note": "STATUS を 1 行（E/E CLNG CARD）", "dref": "laminar/B747/air/fail/eq_card", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "STATUS は 1 ページ", "dref": "laminar/B747/STAT/num_msg_pages", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "status_one_page_no_pg" },

    { "do": "mark", "note": "12 行を超える STATUS" },
    { "do": "set", "note": "EQUIPMENT SMOKE", "dref": "laminar/B747/air/fail/eq_smoke", "value": 1 },
    { "do": "set", "note": "GEAR MONITOR", "dref": "laminar/B747/gear/fail/position_sensor[0]", "value": 1 },
    { "do": "set", "note": "BLEED OVPRESS 1", "dref": "laminar/B747/air/fail/bleed_ovpress[0]", "value": 1 },
    { "do": "set", "note": "BLEED OVPRESS 2", "dref": "laminar/B747/air/fail/bleed_ovpress[1]", "value": 1 },
    { "do": "set", "note": "BLEED OVPRESS 3", "dref": "laminar/B747/air/fail/bleed_ovpress[2]", "value": 1 },
    { "do": "set", "note": "BLEED OVPRESS 4", "dref": "laminar/B747/air/fail/bleed_ovpress[3]", "value": 1 },
    { "do": "set", "note": "PACK CONTROL A", "dref": "laminar/B747/air/fail/ptc[0]", "value": 1 },
    { "do": "set", "note": "PACK CONTROL B", "dref": "laminar/B747/air/fail/ptc[1]", "value": 1 },
    { "do": "set", "note": "RECIRC FAN UPR R", "dref": "laminar/B747/air/fail/recirc_fan[0]", "value": 1 },
    { "do": "set", "note": "RECIRC FAN UPR L", "dref": "laminar/B747/air/fail/recirc_fan[1]", "value": 1 },
    { "do": "set", "note": "A/G DISAGREE（ほかに SPEEDBRAKE AUTO と CPCS AIR/GND）", "dref": "laminar/B747/gear/fail/air_gnd[1]", "value": 1 },
    { "do": "wait", "note": "STATUS が 2 ページ", "dref": "laminar/B747/STAT/num_msg_pages", "op": "==", "value": 2, "timeout": 20 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "status_two_pages_pg1" },
    { "do": "set", "note": "（2026-11-13、フルレビューの DSP-4）STAT のスイッチで送る：まず閉じる", "dref": "laminar/B747/dsp/synoptic_display", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "STAT", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "wait", "note": "STATUS の 1 ページ目", "dref": "laminar/B747/dsp/synoptic_display", "op": "==", "value": 2, "timeout": 3 },
    { "do": "check", "note": "1 ページ目", "dref": "laminar/B747/STAT/msg_page", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "STAT をもう一度", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 ページ目（前は、ページ数を押したときにしか読まず、閉じることがあった：DSP-4）", "dref": "laminar/B747/STAT/msg_page", "op": "==", "value": 2 },
    { "do": "check", "note": "STATUS のまま", "dref": "laminar/B747/dsp/synoptic_display", "op": "==", "value": 2 },
    { "do": "shot", "name": "status_two_pages_pg2" },
    { "do": "cmd", "note": "STAT を最後のページで", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "wait", "note": "閉じる（FCOM p.1047、p.1530）", "dref": "laminar/B747/dsp/synoptic_display", "op": "==", "value": 0, "timeout": 3 },
    { "do": "set", "note": "STATUS を出し直す（この後の確かめのため）", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/eq_smoke", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/gear/fail/position_sensor[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/bleed_ovpress[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/bleed_ovpress[1]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/bleed_ovpress[2]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/bleed_ovpress[3]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/ptc[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/ptc[1]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/recirc_fan[0]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/recirc_fan[1]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/gear/fail/air_gnd[1]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/eq_card", "value": 0 },
    { "do": "wait", "note": "STATUS が 1 ページ以下に戻る", "dref": "laminar/B747/STAT/num_msg_pages", "op": "<=", "value": 1, "timeout": 10 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "cmd", "note": "外から見る（周回のビュー）", "name": "sim/view/circle" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "exterior_circle" },
    { "do": "cmd", "note": "操縦席に戻る", "name": "sim/view/3d_cockpit_cmnd_look" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
