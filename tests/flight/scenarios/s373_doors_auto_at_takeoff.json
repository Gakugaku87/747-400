{
  "name": "s373_doors_auto_at_takeoff",
  "description": "A/T の離陸で手元のスロットルを閉じたままのとき、DOORS AUTO の memo と CALL のチャイムが離陸推力で抑止される（2026-11-23 の段 4 のレビュー NAV-1）の X-Plane での確認。s142 と同じ RJAA 34L・エンジン運転中（ドアは AUTOMATIC：s210）、フラップ 20、経路・PERF INIT（ZFW 193）・TAKEOFF REF、A/T ARM、VNAV arm。X-Plane のスロットル（手元）は 0 のまま、TO/GA で A/T が 747 のレバーを離陸推力へ。離陸推力（エンジンごとに N1 の表示が離陸の値より上・747 のレバーが閉でない・逆推力が格納：離陸形態警報と同じ、laminar/B747/flt_ctrls/takeoff_thrust_range）の間は DOORS AUTO（memo_status[9]）が消え（ATA38_51_52_56 p.304）、客室の CALL でチャイム（comm/call_chime）が鳴らない（FCOM p.1593：any engine in takeoff thrust range）。直す前は X-Plane のスロットル 0.6 以上で見ていたので、滑走中も DOORS AUTO が出たまま、チャイムも鳴った。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 2000, 2000, 2000, 2000, 0, 1000, 1000, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 5500, 5500, 5500, 5500, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "手元のスロットル（X-Plane の比）を閉じておく（A/T の離陸で手元を動かさない形）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "check", "note": "ドアは AUTOMATIC（L1）", "dref": "laminar/B747/door/mode[0]", "op": "==", "value": 1, "stop": true },
    { "do": "check", "note": "DOORS AUTO の memo（地上・アイドル）", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 1, "stop": true },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 9,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 9000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 9000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s142 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "CDU：経路、PERF INIT、TAKEOFF REF" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 193、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "193", "L3", "170", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20（1L）、V1・VR・V2 を選ぶ（1R〜3R）", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力の基準は TO", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "contains", "value": "TO" },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2", "as": "v2_mcp" },
    { "do": "set", "note": "MCP の速さを V2 に（FCOM p.118 の MCP の準備：IAS/MACH selector – Set V2。AFDS の T/O の V2 は窓の値：FCOM p.664 の注。2026-11-26 から。前は電源投入の 200 kt（FCOM p.643）のままで、T/O の目標が 210 kt だった）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "v2_mcp" },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "TO/GA：A/T が 747 のレバーを離陸推力へ（手元のスロットルは 0）" },
    { "do": "cmd", "note": "TO/GA（止まっている：50 kt 未満）", "name": "sim/engines/TOGA_power" },
    { "do": "wait", "note": "A/T の THR REF（5）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5, "timeout": 5, "stop": true },
    { "do": "wait", "note": "747 のレバー 2 が 0.6 を超える", "dref": "laminar/B747/engine/throttle[1]", "op": ">", "value": 0.6, "timeout": 15, "stop": true },
    { "do": "wait", "note": "エンジン 2 の N1 の表示が 76 を超える（離陸の値 P&W 66.5、RR 66.7、GE 75.0 の上：ATA27 p.730）", "dref": "laminar/B747/engines/display_N1[1]", "op": ">", "value": 76, "timeout": 20, "stop": true },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "離陸推力", "drefs": [ "laminar/B747/engine/throttle[1]", "sim/cockpit2/engine/actuators/throttle_ratio[1]", "laminar/B747/engines/display_N1[1]", "laminar/B747/flt_ctrls/takeoff_thrust_range[0]", "laminar/B747/flt_ctrls/takeoff_thrust_range[1]", "laminar/B747/flt_ctrls/takeoff_thrust_range[2]", "laminar/B747/flt_ctrls/takeoff_thrust_range[3]", "laminar/B747/CAS/memo_status[9]", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "check", "note": "手元のスロットルは閉じたまま（この確かめの条件）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[1]", "op": "<", "value": 0.6, "level": "warn" },
    { "do": "check", "note": "エンジン 2 は離陸推力の範囲", "dref": "laminar/B747/flt_ctrls/takeoff_thrust_range[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "NAV-1：DOORS AUTO は消える（前は出たまま）", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 0 },
    { "do": "check", "note": "まだ 75 kt より下（チャイムの抑止が速さでなく推力から来ることの確かめ）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 75, "level": "warn" },
    { "do": "cmd", "note": "客室からの CALL", "name": "laminar/B747/comm/call/cab" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "NAV-1：チャイムは鳴らない（FCOM p.1593。前は鳴った）", "dref": "laminar/B747/comm/call_chime", "op": "==", "value": 0 },

    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 90, "stop": true },
    { "do": "cmd", "note": "毎秒 2.5° で 15° へ引き起こす（B747_rotate.lua：s142 と同じ）", "name": "FlyWithLua/B747_rotate/start" },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "wait", "note": "電波高度 35 ft（引き起こしの操縦の終わり）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 35, "timeout": 30 },
    { "do": "cmd", "note": "引き起こしの操縦を終える", "name": "FlyWithLua/B747_rotate/stop" },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "cmd", "note": "手の操縦を終える（操縦輪はそのまま）", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "空中：DOORS AUTO は消えたまま", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 0 },
    { "do": "cas", "note": "離陸の後" },
    { "do": "record_stop" }
  ]
}
