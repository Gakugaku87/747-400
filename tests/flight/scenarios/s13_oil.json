{
  "name": "s13_oil",
  "description": "エンジンのオイルと振動（2-3 段 3）の X-Plane での確認。RJAA 34L でエンジン運転中（P&W、109）に、アイドルのオイル（油圧・油温・油量）と振動の値を記録し、油圧が白、ENG OIL PRESS が無いことを見る。次に X-Plane の故障でオイルポンプ 1 を止め、油圧 1 が赤線（70 psi、前の値）を切って赤になり ENG 1 OIL PRESS が出ること（FCOM p.846、p.901）、故障を戻すと消えることを見る。最後に FUEL CONTROL 1 を CUTOFF にし、油圧が下がっても白のままなこと（FCOM p.846）と、回転が下がると油量がエンジンからタンクに戻ることを見る。機体を読み直す。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "snapshot", "note": "アイドルのオイルと振動", "drefs": [
      "laminar/B747/engines/type", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]",
      "sim/cockpit2/engine/indicators/oil_pressure_psi[0]", "sim/cockpit2/engine/indicators/oil_temperature_deg_C[0]",
      "sim/cockpit2/engine/indicators/oil_quantity_ratio[0]",
      "laminar/B747/engines/oil_press_psi[0]", "laminar/B747/engines/oil_press_psi[1]",
      "laminar/B747/engines/oil_press_psi[2]", "laminar/B747/engines/oil_press_psi[3]",
      "laminar/B747/engines/oil_temp_degC[0]", "laminar/B747/engines/oil_temp_degC[1]",
      "laminar/B747/engines/oil_temp_degC[2]", "laminar/B747/engines/oil_temp_degC[3]",
      "laminar/B747/engines/oil_qty_liters[0]", "laminar/B747/engines/oil_qty_liters[1]",
      "laminar/B747/engines/oil_qty_liters[2]", "laminar/B747/engines/oil_qty_liters[3]",
      "laminar/B747/engines/vibration[0]", "laminar/B747/engines/vibration[1]",
      "laminar/B747/engines/vibration[2]", "laminar/B747/engines/vibration[3]" ] },
    { "do": "check", "note": "アイドルの油圧は X-Plane の値の近く", "dref": "laminar/B747/engines/oil_press_psi[0]", "op": ">", "value": 100 },
    { "do": "check", "note": "油圧は白", "dref": "laminar/B747/engines/EICAS2_oil_press_status[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "ENG 1 OIL PRESS なし", "dref": "laminar/B747/CAS/advisory_status[317]", "op": "==", "value": 0 },
    { "do": "check", "note": "ENG 1 OIL TEMP なし", "dref": "laminar/B747/CAS/advisory_status[118]", "op": "==", "value": 0 },
    { "do": "check", "note": "油量（運転中、L）：タンクの 33〜37 L から 7〜11 L がエンジンへ、X-Plane の比を掛ける（推定）", "dref": "laminar/B747/engines/oil_qty_liters[0]", "op": "<", "value": 30.1 },
    { "do": "check", "note": "油量は 0 でない", "dref": "laminar/B747/engines/oil_qty_liters[0]", "op": ">", "value": 10 },
    { "do": "check", "note": "振動が出る", "dref": "laminar/B747/engines/vibration[0]", "op": ">", "value": 0 },
    { "do": "check", "note": "振動はアイドルで小さい（100 % で 0.2〜1.2、回転の 2 乗。推定）", "dref": "laminar/B747/engines/vibration[0]", "op": "<", "value": 1.2 },
    { "do": "check", "note": "振動の音源の文字は N1 か N2（1 N1、2 N2。FCOM p.850）", "dref": "laminar/B747/engines/vib_source[0]", "op": "between", "value": [1, 2] },
    { "do": "view", "the": -31.5, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "lower_eicas_idle" },

    { "do": "mark", "note": "オイルポンプ 1 の故障" },
    { "do": "set", "note": "X-Plane の故障：oil pump 1（6 = 故障中）", "dref": "sim/operation/failures/rel_oilpmp0", "value": 6 },
    { "do": "wait", "note": "油圧 1 が赤線 70 psi を切る", "dref": "laminar/B747/engines/oil_press_psi[0]", "op": "<", "value": 70, "timeout": 10 },
    { "do": "wait", "note": "油圧 1 が赤（FCOM p.846）", "dref": "laminar/B747/engines/EICAS2_oil_press_status[0]", "op": "==", "value": 1, "timeout": 2 },
    { "do": "wait", "note": "ENG 1 OIL PRESS（FCOM p.901）", "dref": "laminar/B747/CAS/advisory_status[317]", "op": "==", "value": 1, "timeout": 2 },
    { "do": "check", "note": "ENG 2 OIL PRESS なし", "dref": "laminar/B747/CAS/advisory_status[318]", "op": "==", "value": 0 },
    { "do": "check", "note": "油圧 2 は白", "dref": "laminar/B747/engines/EICAS2_oil_press_status[1]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cas", "note": "oil pump 1 の故障" },
    { "do": "shot", "name": "lower_eicas_oil_pump_1_failed" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_oil_pump_1_failed" },
    { "do": "set", "note": "故障を戻す", "dref": "sim/operation/failures/rel_oilpmp0", "value": 0 },
    { "do": "wait", "note": "油圧 1 が戻る", "dref": "laminar/B747/engines/oil_press_psi[0]", "op": ">", "value": 100, "timeout": 15 },
    { "do": "wait", "note": "ENG 1 OIL PRESS が消える", "dref": "laminar/B747/CAS/advisory_status[317]", "op": "==", "value": 0, "timeout": 2 },
    { "do": "check", "note": "油圧 1 は白に戻る", "dref": "laminar/B747/engines/EICAS2_oil_press_status[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "エンジン 1 を止める" },
    { "do": "switch", "note": "FUEL CONTROL 1 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "wait", "note": "油圧 1 が 70 psi を切る", "dref": "laminar/B747/engines/oil_press_psi[0]", "op": "<", "value": 70, "timeout": 120 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CUTOFF では油圧が低くても白（FCOM p.846）", "dref": "laminar/B747/engines/EICAS2_oil_press_status[0]", "op": "==", "value": 0 },
    { "do": "cas", "note": "CUTOFF（ENG 1 OIL PRESS は地上の CUTOFF では出さない、FCOM p.1586）" },
    { "do": "wait", "note": "回転が下がると油がタンクに戻る（33〜37 L × X-Plane の比）", "dref": "laminar/B747/engines/oil_qty_liters[0]", "op": ">", "value": 27, "timeout": 120 },
    { "do": "view", "the": -31.5, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "lower_eicas_eng1_cutoff" },
    { "do": "record_stop" }
  ]
}
