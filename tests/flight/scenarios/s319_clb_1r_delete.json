{
  "name": "s319_clb_1r_delete",
  "description": "2026-11-12 のフルレビューの FMC-10（案 10 の残り）の X-Plane での確認。本物の航法データの RJAA（AIRAC 2611）の 34L の地上（機体を読み直す、270 t）。RTE RJAA→RJBB、DEPARTURES で AKAGI4 と 16R、RTE の RUNWAY を 34L（s298 と同じ）、ACTIVATE と EXEC、PERF INIT（ZFW 200、CRZ ALT FL170、CI 100）。CLB のページの 1R（次の上昇の制限 AT XXXXX）に DELETE：その点の高度の制限が経路から消え（FMSPG p.114）、MOD を EXEC すると 1R は次の制限か空白に変わる（前は KEY/FUNCTION INOP で何も起きなかった）。4L の SPD RESTR に 250/1500 は INVALID ENTRY（前は 250/----- になった）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "FMS の初期化" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "CLR、RTE：RJAA→RJBB", "keys": ["CLR", "CLR", "CLR", "RTE", "RJAA", "L1", "RJBB", "R1"] },
    { "do": "cdu", "note": "DEP ARR（経路が有効でない：DEP/ARR INDEX）、<DEP（L1）", "keys": ["DEPARR", "L1"] },
    { "do": "wait", "note": "RJAA DEPARTURES", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA DEPARTURES", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "16R（2R）、AKAGI4（1L）", "keys": ["R2", "L1"] },
    { "do": "wait", "note": "AKAGI4 と 16R", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^AKAGI4<SEL> +<SEL>16R$", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "RTE、RUNWAY（2L）に 34L", "keys": ["RTE", "34L", "L2"] },
    { "do": "cdu", "note": "ACTIVATE（6R）と EXEC", "keys": ["R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "170", "R1", "100", "L5"] },
    { "do": "sleep", "seconds": 3, "note": "予測" },
    { "do": "cdu", "note": "VNAV（CLB のページ）", "keys": ["VNAV"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "CLB のページ（1R の前）", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line08_L", "laminar/B747/fms3/Line09_L" ] },
    { "do": "check", "note": "1R の見出しに次の上昇の制限（AT XXXXX：小さい文字の行。2026-11-13 の 1 回目は大きい文字の行を読んで落ちた）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "AT [A-Z0-9]+ *$", "stop": true },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_clb_1r_before" },
    { "do": "cdu", "note": "4L に 250/1500：INVALID ENTRY（FMSPG p.114。前は 250/----- になった）", "keys": ["250/1500", "L4"] },
    { "do": "check", "note": "INVALID ENTRY", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "INVALID ENTRY" },
    { "do": "cdu", "note": "CLR、1R に DELETE", "keys": ["CLR", "CLR", "CLR", "DEL", "R1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "DELETE の後（MOD）", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line14_L", "laminar/B747/fms/exec_light_pilot" ] },
    { "do": "check", "note": "KEY/FUNCTION INOP でない（前は何も起きなかった）", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^((?!INOP).)*$" },
    { "do": "check", "note": "経路の変更：EXEC の灯", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 1 },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "VNAV（CLB のページ）", "keys": ["VNAV"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "EXEC の後の CLB のページ", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_L" ] },
    { "do": "shot", "name": "cdu_clb_1r_after" },
    { "do": "view", "name": "forward" }
  ]
}
