{
  "name": "s307_livery_reload",
  "description": "その場でのリバリーの読み込み（2026-11-12 のフルレビュー SM-5：案 15）の X-Plane での確認。RJAA の地上、エンジン運転中、着陸灯 ON。利用者のコールド＆ダークの設定（startup_running 0）で sim/operation/next_livery。前：リバリーの読み込みでスイッチが開始位置に戻り、BATTERY まで OFF になった。直した後：スイッチはそのまま",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8 },
    { "do": "cmd", "note": "着陸灯 OBL ON", "name": "laminar/B747/toggle_switch/landing_light_OBL" },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "前", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]", "laminar/B747/button_switch/position[30]", "laminar/B747/button_switch/position[56]", "laminar/B747/button_switch/position[82]", "laminar/B747/toggle_switch/position[1]", "laminar/B747/electrical/bus/bat_main", "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/type" ] },
    { "do": "set", "note": "利用者のコールド＆ダークの設定（startup_running 0）", "dref": "sim/operation/prefs/startup_running", "value": 0 },
    { "do": "mark", "note": "sim/operation/next_livery（次のリバリー）" },
    { "do": "cmd", "name": "sim/operation/next_livery", "duration": 0.2 },
    { "do": "sleep", "seconds": 6 },
    { "do": "snapshot", "note": "next_livery の 6 秒後", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]", "laminar/B747/button_switch/position[30]", "laminar/B747/button_switch/position[56]", "laminar/B747/button_switch/position[82]", "laminar/B747/toggle_switch/position[1]", "laminar/B747/electrical/bus/bat_main", "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/type" ] },
    { "do": "check", "note": "BATTERY は ON（1）のまま（前は開始位置へ戻り OFF）", "dref": "laminar/B747/button_switch/position[13]", "op": "==", "value": 1 },
    { "do": "check", "note": "GEN CONT 1 は ON のまま", "dref": "laminar/B747/button_switch/position[22]", "op": "==", "value": 1 },
    { "do": "check", "note": "FUEL MAIN FWD 1 は ON のまま", "dref": "laminar/B747/button_switch/position[56]", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "next_livery の 26 秒後", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]", "laminar/B747/button_switch/position[30]", "laminar/B747/button_switch/position[56]", "laminar/B747/button_switch/position[82]", "laminar/B747/toggle_switch/position[1]", "laminar/B747/electrical/bus/bat_main", "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/type" ] },
    { "do": "cas", "note": "26 秒後" },
    { "do": "cmd", "note": "リバリーを戻す", "name": "sim/operation/prev_livery", "duration": 0.2 },
    { "do": "sleep", "seconds": 5 },
    { "do": "set", "note": "設定をキットの 1 に戻す", "dref": "sim/operation/prefs/startup_running", "value": 1 }
  ]
}
