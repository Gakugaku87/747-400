{
  "name": "s129_fmc_econ",
  "description": "6-1/6-2 段 8b1（ECON の速さ）の X-Plane での確認、空中。FL350・M.84 で空中から始め（機体を読み直す）、CRZ のページで CRZ ALT を FL350 に、PERF INIT（INIT REF → <INDEX → <PERF）で COST INDEX 100 を入れる。CRZ・CLB・DES のページの ECON SPD（性能 DB の巡航の模型：重量・巡航高度・CI・巡航の風・ISA 偏差から。推定）を記録し、期待値はその時の重量・外気温・風から求めて比べる。SEL SPD（.840、320/.840）で表題と <ECON、<ECON で ECON に戻ること、LRC> で LRC CRZ（表の LRC）、CLB の MAX ANGLE（最小抗力の速さ）。FMC のデータ（laminar/B747/fms/data）の速さも記録する。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 90, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える（機長の CDU の表示は fms3 の行）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cmd", "note": "VNAV のページ（CDU の DES のキー）", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "NEXT：CRZ。CI の前は ECON の既定値", "keys": ["NEXT"] },
    { "do": "check", "note": "CRZ のページ、ECON CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON CRZ" },
    { "do": "cdu", "note": "CRZ ALT を FL350 に", "keys": ["350", "L1"] },
    { "do": "cdu", "note": "PERF INIT：空中では INIT REF が APPROACH REF、<INDEX、<PERF", "keys": ["INITREF", "L6", "L3"] },
    { "do": "check", "note": "PERF INIT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF INIT" },
    { "do": "cdu", "note": "COST INDEX 100（FMSPG p.261：時間の費用を燃料 100 lb/h 単位で）", "keys": ["100", "L5"] },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "keys": ["NEXT"] },
    { "do": "sleep", "seconds": 6, "note": "ECON の計算（5 秒ごと、CI の入力ですぐ）" },
    { "do": "check", "note": "ECON CRZ（巡航中：ACT）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON CRZ" },
    { "do": "check", "note": "ECON SPD は Mach（.8xx）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^\\.8[0-9]{2}" },
    { "do": "snapshot", "note": "ECON の巡航の速さと、期待値を求める重量・外気温・気圧高度・風・磁方位・型式、FMC のデータ", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line04_S", "sim/flightmodel/weight/m_total", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag", "sim/cockpit2/gauges/indicators/wind_speed_kts", "sim/flightmodel/position/mag_psi", "laminar/B747/engines/type", "laminar/B747/fms/data" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_econ_crz" },
    { "do": "cdu", "note": "SEL SPD .840", "keys": [".840", "L2"] },
    { "do": "check", "note": "M.840 CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "M.840 CRZ" },
    { "do": "check", "note": "SEL SPD の見出し", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "SEL SPD" },
    { "do": "check", "note": "<ECON（5L）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<ECON" },
    { "do": "shot", "name": "cdu_sel_crz" },
    { "do": "cdu", "note": "LRC>（6R）：LRC CRZ", "keys": ["R6"] },
    { "do": "check", "note": "LRC CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "LRC CRZ" },
    { "do": "check", "note": "LRC SPD の見出し", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "LRC SPD" },
    { "do": "snapshot", "note": "LRC の Mach（表）と重量", "drefs": [ "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total" ] },
    { "do": "cdu", "note": "<ECON", "keys": ["L5"] },
    { "do": "check", "note": "ECON CRZ に戻る", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON CRZ" },
    { "do": "cdu", "note": "PREV：CLB", "keys": ["PREV"] },
    { "do": "check", "note": "ECON CLB", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON CLB" },
    { "do": "check", "note": "ECON SPD は CAS/Mach（FMSPG p.113：358/.853）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^[0-9]{3}/\\.[0-9]{3}" },
    { "do": "snapshot", "note": "上昇の ECON と MAX ANGLE（最小抗力の速さ）、重量と高度", "drefs": [ "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line09_L", "sim/flightmodel/weight/m_total", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "cdu", "note": "SEL SPD 320/.840", "keys": ["320/.840", "L2"] },
    { "do": "check", "note": "320KT か M.840 の CLB（今の Mach による）", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "(320KT|M\\.840) CLB" },
    { "do": "check", "note": "<ECON", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<ECON" },
    { "do": "cdu", "note": "<ECON", "keys": ["L5"] },
    { "do": "check", "note": "ECON CLB に戻る", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON CLB" },
    { "do": "cdu", "note": "NEXT NEXT：DES", "keys": ["NEXT", "NEXT"] },
    { "do": "check", "note": "ECON DES", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON DES" },
    { "do": "check", "note": "ECON SPD は Mach/CAS", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^\\.[0-9]{3}/[0-9]{3}" },
    { "do": "snapshot", "note": "降下の ECON", "drefs": [ "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total" ] },
    { "do": "shot", "name": "cdu_econ_des" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
