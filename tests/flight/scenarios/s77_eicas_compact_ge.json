{
  "name": "s77_eicas_compact_ge",
  "description": "EICAS の compact の形（5-2 段 6b-2）を CF6（Saudia のリバリー：エンジンの型式は GE）で確認、地上。成田 34L にエンジン運転中で開始（機体を読み直す）。下の表示器の故障で、ENG の選択で主 EICAS に compact の全表示（N1 の数字とテープ、EGT の数字、その下に二次の行）、2 番の油ポンプの故障で compact の部分表示（FCOM p.855、p.857）。主 EICAS を撮る。",
  "reload": true,
  "livery": "Saudia",
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "CF6（型式 1）", "dref": "laminar/B747/engines/type", "op": "==", "value": 1 },
    { "do": "switch", "note": "STANDBY POWER AUTO（リバリーを変えた読み直しでは OFF のことがある）", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "wait", "note": "主 EICAS は上の表示器", "dref": "laminar/B747/flt_inst/display/pri_eicas_pos", "op": "==", "value": 0, "timeout": 5 },
    { "do": "view", "note": "主 EICAS", "the": -22, "psi": 29, "fov": 22 },
    { "do": "shot", "name": "ge_normal" },
    { "do": "set", "note": "下の表示器の故障", "dref": "laminar/B747/displays/fail[3]", "value": 1 },
    { "do": "wait", "note": "表示器 1 台、ENG：compact の全表示（FCOM p.855）", "cite": "FCOM p.855", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 1, "timeout": 3 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "shot", "name": "ge_compact_full" },
    { "do": "cmd", "note": "ENG", "name": "laminar/B747/dsp/eng_switch", "duration": 0.2 },
    { "do": "set", "note": "2 番の油ポンプの故障", "dref": "sim/operation/failures/rel_oilpmp1", "value": 6 },
    { "do": "wait", "note": "compact の部分表示（FCOM p.857）", "cite": "FCOM p.857", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 2, "timeout": 30 },
    { "do": "check", "note": "油の行", "dref": "laminar/B747/eicas/cmp_rows[2]", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "shot", "name": "ge_compact_partial" },
    { "do": "set", "note": "油ポンプの故障を戻す", "dref": "sim/operation/failures/rel_oilpmp1", "value": 0 },
    { "do": "set", "note": "下の表示器を戻す", "dref": "laminar/B747/displays/fail[3]", "value": 0 },
    { "do": "wait", "note": "compact が消える", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 0, "timeout": 60, "level": "warn" },
    { "do": "view", "name": "forward" }
  ]
}
