{
  "name": "s143_vnav_reset_mcp_alt",
  "description": "6-1/6-2 段 9d1（MCP の操作：RESET MCP ALT を FMC で）の X-Plane での確認。s140 と同じ FL300 の T/D の手前（ATMUG の約 30 NM 西）から東へ空中開始（機体を読み直す）、同じ経路と LNAV、ZFW 200・CI 100・FL300。MCP 高度は FL300（巡航高度）のまま VNAV：T/D の 2 分の内（と過ぎても）巡航のまま RESET MCP ALT（FCOM p.665、p.1433：FMC のメッセージの旗 33）。MCP を 10,000 ft に下げるとメッセージが消え、FMC は降下（3）に。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 133.52, "elevation_in_meters": 9144, "heading_true": 97, "speed_in_meters_per_second": 225 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 FL300（巡航高度のまま。空中開始の MCP は既定の 10,000 ft なので経路と CRZ ALT の前に入れる。段 9d1 から FMC の降下は MCP が CRZ ALT より下のときだけで、空中開始の揺れで機体が MCP より上がっても降下に入らない）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 30000 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL300", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "300", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "性能のデータが揃う", "dref": "laminar/B747/fms/vnav/perf", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage（巡航か降下）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "check", "note": "vnav_state は 2", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "wait", "note": "RESET MCP ALT（T/D の 2 分の内、MCP が巡航高度）", "dref": "laminar/B747/fms/notification[33]", "op": "==", "value": 1, "timeout": 120 },
    { "do": "check", "note": "FMC は巡航（2）のまま", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "snapshot", "note": "RESET MCP ALT の時", "drefs": [ "laminar/B747/fms3/Line14_L", "laminar/B747/fms/vnav/dist", "laminar/B747/fms/vnav/path_dev", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "sleep", "seconds": 30, "note": "30 秒（T/D を過ぎても）" },
    { "do": "check", "note": "まだ RESET MCP ALT", "dref": "laminar/B747/fms/notification[33]", "op": "==", "value": 1 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "wait", "note": "メッセージが消える", "dref": "laminar/B747/fms/notification[33]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "wait", "note": "FMC は降下（3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 10 },
    { "do": "snapshot", "note": "降下の始め", "drefs": [ "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/fms/vnav/path_dev", "sim/flightmodel/position/vh_ind_fpm" ] },
    { "do": "record_stop" }
  ]
}
