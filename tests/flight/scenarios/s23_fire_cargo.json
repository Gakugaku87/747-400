{
  "name": "s23_fire_cargo",
  "description": "火災防護（3-4 段 2）の X-Plane での確認、巡航。FL350 の空中で開始し、貨物のボトルが 360 psi。FIRE/OVHT TEST で貨物の FWD・AFT の灯と PASS（FCOM p.919）。失敗の dataref で後方貨物室 zone 3 の煙：FIRE CARGO AFT と AFT の灯（FCOM p.908、p.921）。ARM AFT で pack 3 が止まり（FCOM p.908、空調 AIR-17）、DISCH で A・B が即時に放出、DISCH の灯、空中なので >CGO BTL DISCH、C・D は 30 分待つ（ATA26_28 p.184-187、FCOM p.921）。車輪格納部の火災（FIRE WHEEL WELL）、左のダクトリーク（BLD DUCT LEAK L）、化粧室とクルーレストの煙（>SMOKE LAVATORY、SMOKE DR 5 REST）。期待値は notes/ATA-26.md。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 254 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "wait", "note": "水平になる（A/P の ALT HOLD）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 180 },
    { "do": "snapshot", "note": "水平", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/fire/cargo/ext_bottle/psi[0]", "laminar/B747/fire/cargo/ext_bottle/psi[2]",
      "laminar/B747/air/duct_pressure_C", "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/electrical/bus/ac[1]",
      "laminar/B747/electrical/bus/dc[1]", "laminar/B747/air/pack/valve_pos[2]" ] },
    { "do": "cas", "note": "開始" },
    { "do": "check", "note": "貨物のボトル A は 360 psi（ATA26_28 p.170）", "dref": "laminar/B747/fire/cargo/ext_bottle/psi[0]", "op": "==", "value": 360 },
    { "do": "check", "note": "FIRE CARGO AFT なし", "dref": "laminar/B747/CAS/warning_status[9]", "op": "==", "value": 0 },
    { "do": "check", "note": ">CARGO DET AIR なし（中央ダクトに圧）", "dref": "laminar/B747/CAS/advisory_status[49]", "op": "==", "value": 0 },

    { "do": "mark", "note": "FIRE/OVHT TEST" },
    { "do": "set", "note": "FIRE/OVHT TEST を押し続ける", "dref": "laminar/B747/fire/fire_ovht/button_pos", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "試験：CARGO FIRE FWD の灯（FCOM p.919）", "dref": "laminar/B747/annunciator/brightness_ratio[35]", "op": ">", "value": 0 },
    { "do": "check", "note": "試験：CARGO FIRE AFT の灯", "dref": "laminar/B747/annunciator/brightness_ratio[36]", "op": ">", "value": 0 },
    { "do": "check", "note": "試験では FIRE CARGO のメッセージは出ない", "dref": "laminar/B747/CAS/warning_status[9]", "op": "==", "value": 0 },
    { "do": "check", "note": "試験では FIRE WHEEL WELL は出ない", "dref": "laminar/B747/CAS/warning_status[21]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "車輪格納部とダクトの電源も揃って >FIRE TEST PASS", "dref": "laminar/B747/CAS/warning_status[20]", "op": "==", "value": 1 },
    { "do": "set", "note": "FIRE/OVHT TEST を離す", "dref": "laminar/B747/fire/fire_ovht/button_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "貨物の灯が消える", "dref": "laminar/B747/annunciator/brightness_ratio[36]", "op": "==", "value": 0 },

    { "do": "mark", "note": "後方貨物室の煙" },
    { "do": "set", "note": "後方貨物室 zone 3 の煙", "dref": "laminar/B747/fire/fail/cargo_smoke[2]", "value": 1 },
    { "do": "wait", "note": "FIRE CARGO AFT（FCOM p.921）", "dref": "laminar/B747/CAS/warning_status[9]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "CARGO FIRE AFT の灯（FCOM p.908）", "dref": "laminar/B747/annunciator/brightness_ratio[36]", "op": ">", "value": 0 },
    { "do": "check", "note": "火災ベルの要求", "dref": "laminar/B747/warning/warning_bell", "op": "==", "value": 1, "level": "warn" },
    { "do": "cas", "note": "FIRE CARGO AFT" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_fire_cargo_aft" },
    { "do": "switch", "note": "CARGO FIRE ARM AFT", "dref": "laminar/B747/button_switch/position[85]", "value": 1, "cmd": "laminar/B747/button_switch/cargo_fire_arm_aft" },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "ARM：pack 3 が止まる（FCOM p.908、空調 AIR-17）", "dref": "laminar/B747/air/pack/valve_pos[2]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "CARGO FIRE DISCH を押す", "name": "laminar/B747/button_switch/cargo_fire_disch", "duration": 0.5 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ボトル A が即時に放出（ATA26_28 p.184）", "dref": "laminar/B747/fire/cargo/ext_bottle/psi[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "ボトル B も", "dref": "laminar/B747/fire/cargo/ext_bottle/psi[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "空中ではボトル C は 30 分待つ", "dref": "laminar/B747/fire/cargo/ext_bottle/psi[2]", "op": "==", "value": 360 },
    { "do": "check", "note": "CARGO FIRE DISCH の灯（FCOM p.908）", "dref": "laminar/B747/annunciator/brightness_ratio[37]", "op": ">", "value": 0 },
    { "do": "check", "note": "空中で A・B が放出：>CGO BTL DISCH（FCOM p.921）", "dref": "laminar/B747/CAS/advisory_status[51]", "op": "==", "value": 1 },
    { "do": "check", "note": "剤で煙が消える（推定）", "dref": "laminar/B747/fire/fail/cargo_smoke[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "FIRE CARGO AFT が消える", "dref": "laminar/B747/CAS/warning_status[9]", "op": "==", "value": 0 },
    { "do": "cas", "note": "貨物の放出の後" },
    { "do": "view", "the": 33, "psi": 80, "fov": 30 },
    { "do": "shot", "name": "cargo_fire_panel" },

    { "do": "mark", "note": "車輪格納部・ダクト・煙" },
    { "do": "set", "note": "車輪格納部の火災", "dref": "laminar/B747/fire/fail/wheel_well", "value": 1 },
    { "do": "set", "note": "左のダクトリーク", "dref": "laminar/B747/fire/fail/duct_leak[0]", "value": 1 },
    { "do": "set", "note": "化粧室の煙", "dref": "laminar/B747/fire/fail/lav_smoke", "value": 1 },
    { "do": "set", "note": "クルーレストの煙", "dref": "laminar/B747/fire/fail/rest_smoke", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FIRE WHEEL WELL（FCOM p.922）", "dref": "laminar/B747/CAS/warning_status[21]", "op": "==", "value": 1 },
    { "do": "check", "note": "BLD DUCT LEAK L（ATA26_28 p.286）", "dref": "laminar/B747/CAS/caution_status[7]", "op": "==", "value": 1 },
    { "do": "check", "note": ">SMOKE LAVATORY（FCOM p.923）", "dref": "laminar/B747/CAS/advisory_status[264]", "op": "==", "value": 1 },
    { "do": "check", "note": "SMOKE DR 5 REST", "dref": "laminar/B747/CAS/caution_status[52]", "op": "==", "value": 1 },
    { "do": "cas", "note": "車輪格納部・ダクト・煙" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_wheel_well_duct_smoke" },
    { "do": "set", "note": "戻す", "dref": "laminar/B747/fire/fail/wheel_well", "value": 0 },
    { "do": "set", "note": "戻す", "dref": "laminar/B747/fire/fail/duct_leak[0]", "value": 0 },
    { "do": "set", "note": "戻す", "dref": "laminar/B747/fire/fail/lav_smoke", "value": 0 },
    { "do": "set", "note": "戻す", "dref": "laminar/B747/fire/fail/rest_smoke", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FIRE WHEEL WELL が消える", "dref": "laminar/B747/CAS/warning_status[21]", "op": "==", "value": 0 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
