{
  "name": "s433_reverse_rr",
  "description": "RR（RB211-524H2：BA のリバリー、エンジン型式 2）の逆推力の X-Plane での確認、地上（2026-11-25：RR の N1 の目盛りを TCDS に、GAP_ANALYSIS.md N19-ENG-23、notes/ATA-70-80.md §41）。RJAA 34L でエンジン運転中、パーキング・ブレーキをかけて始め（機体を読み直す）、逆推力のコマンド（全エンジン）を 10 秒引く。RR の逆推力は資料が無くレバーのまま（X-Plane の逆推力の上限 0.75）で、表示の N1 が TCDS_RB211 p.18 の逆推力の LP の限界 91 %（40 秒）を超えると、EEC.RR が X-Plane の最大推力を下げる。2026-11-25 から 91 % は TCDS の 3,900 rpm の目盛り（前は本家の 3,600 rpm の目盛りの 91 %。ただしこの処理は効いていなかった：RR() の「最大推力を元の値より下げない」処理が毎フレーム戻していた。2026-11-25 の 1 回目は全開の逆推力で表示の N1 が 103 %、X-Plane の最大推力は 270 → 269 kN で止まった。地上で逆推力を使っている間は戻さないようにした）。確かめ：全開の逆推力で表示の N1 が 91 % 付近（92 % 未満）、格納の後に X-Plane の最大推力が元の 270 kN に戻る。EICAS を撮る。s187（GE）から作った",
  "reload": true,
  "livery": "British Airways",
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "RR（BA のリバリー：RB211-524H2）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 2 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "snapshot", "note": "始める前", "drefs": [ "sim/aircraft/engine/acf_tmax", "sim/aircraft/engine/acf_throtmax_REV", "laminar/B747/engines/display_N1[0]" ] },
    { "do": "check", "note": "X-Plane の逆推力の上限は 0.75（RR：前のまま）", "dref": "sim/aircraft/engine/acf_throtmax_REV", "op": "==", "value": 0.75 },
    { "do": "cmd", "note": "逆推力を引く（全エンジン、10 秒：Web API の上限。押している間に次へ）", "name": "sim/engines/thrust_reverse_hold", "duration": 10, "async": true },
    { "do": "wait", "note": "逆推力 1 が展開", "dref": "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[0]", "op": ">", "value": 0.98, "timeout": 8 },
    { "do": "sleep", "seconds": 6, "note": "N1 が上がり、91 % で抑えられるのを待つ（放す前に）" },
    { "do": "snapshot", "note": "全開の逆推力", "drefs": [
      "sim/flightmodel/engine/ENGN_thro_use[0]", "sim/flightmodel/engine/ENGN_N1_[0]", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N1[3]",
      "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/flightmodel/engine/POINT_thrust[0]", "laminar/B747/engine/throttle_reversor[0]", "sim/aircraft/engine/acf_tmax" ] },
    { "do": "check", "note": "全開の逆推力で表示の N1 は 70 % を超える（逆推力の出力が上がっている）", "dref": "laminar/B747/engines/display_N1[0]", "op": ">", "value": 70 },
    { "do": "check", "note": "表示の N1 は TCDS の逆推力の限界 91 %（3,900 rpm の目盛り）の付近まで：92 % 未満（EEC.RR が X-Plane の最大推力を下げる：推定）", "dref": "laminar/B747/engines/display_N1[0]", "op": "<", "value": 92 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_reverse_rr" },
    { "do": "sleep", "seconds": 6, "note": "放す（reverse idle）" },
    { "do": "set", "note": "推力レバーを前のアイドルへ（逆推力のレバーを下げきる）", "dref": "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "value": 0 },
    { "do": "wait", "note": "格納", "dref": "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[0]", "op": "<", "value": 0.01, "timeout": 20 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "格納の後", "drefs": [ "sim/aircraft/engine/acf_tmax", "laminar/B747/engines/display_N1[0]" ] },
    { "do": "check", "note": "X-Plane の最大推力は元の 270 kN（-524H2）に戻る", "dref": "sim/aircraft/engine/acf_tmax", "op": "between", "value": [269000, 271000] },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
