{
  "name": "s121_afds_ils_inhibit",
  "description": "AFDS の作り直し 6-3 段 5d（ILS TUNE INHIBIT と RA TEST INHIBIT）の X-Plane での確認、空中。s112 と同じ所（RJAA 34L の進入路の 12 NM、2,500 ft）から CMD L、NAV RADIO で 111.90/337 を同調して APP。LOC を捕まえると ILS TUNE INHIBIT と RA TEST INHIBIT（ATA22 p.212；FCOM p.1305）、NAV RADIO で 110.30 を入れても ILS TUNE INHIBITED - MCP（FCOM p.1432：6-1・6-2 段 10c から。前は INVALID ENTRY）で周波数は 111.90 のまま。A/P を外すと（F/D だけ、500 ft より上）両方とも消え、同じ入力が通る。機体を読み直す。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "check", "note": "PFD の ILS の目盛の印（6-1・6-2 段 10c から FMC が手動の同調で 1 にする：FCOM p.987。前は目的地の 50 NM 以内だけで、ここで 1 を書いていた）", "dref": "laminar/B747/autopilot/ils_dots", "op": "==", "value": 1 },
    { "do": "check", "note": "NAV2 も G/S の信号", "dref": "sim/cockpit2/radios/indicators/nav2_display_vertical", "op": "==", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "LOC を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 60 },
    { "do": "mark", "note": "LOC の捕捉の後（A/P）：ILS TUNE INHIBIT と RA TEST INHIBIT" },
    { "do": "check", "note": "ILS TUNE INHIBIT（ATA22 p.212）", "dref": "laminar/B747/autopilot/ils_tune_inhibit", "op": "==", "value": 1 },
    { "do": "check", "note": "RA TEST INHIBIT", "dref": "laminar/B747/autopilot/ra_test_inhibit", "op": "==", "value": 1 },
    { "do": "check", "note": "NAV 1 は 111.90", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },
    { "do": "cdu", "note": "NAV RADIO、110.30 を ILS の行（L4）へ", "keys": ["NAVRAD", "110.30", "L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "手動の同調も止める：ILS TUNE INHIBITED - MCP（FCOM p.1305、p.1432。段 10c の前は INVALID ENTRY）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "ILS TUNE INHIBITED" },
    { "do": "check", "note": "NAV 1 は 111.90 のまま", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },
    { "do": "check", "note": "NAV 2 も", "dref": "sim/cockpit/radios/nav2_freq_hz", "op": "==", "value": 11190 },
    { "do": "cmd", "note": "CLR（通知を消す）", "name": "laminar/B747/fms1/key/clear" },
    { "do": "sleep", "seconds": 2, "note": "AFDS は LOC のまま（周波数が変わっていないのでモード故障も無い）" },
    { "do": "check", "note": "LOC は故障していない", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 0 },

    { "do": "mark", "note": "A/P を外す：F/D だけで 500 ft より上は止めない" },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "もう一度（AUTOPILOT DISC を消す）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/P は外れた", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "ILS TUNE INHIBIT が消える（F/D だけ、500 ft より上）", "dref": "laminar/B747/autopilot/ils_tune_inhibit", "op": "==", "value": 0 },
    { "do": "check", "note": "RA TEST INHIBIT も", "dref": "laminar/B747/autopilot/ra_test_inhibit", "op": "==", "value": 0 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
