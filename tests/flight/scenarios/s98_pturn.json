{
  "name": "s98_pturn",
  "description": "procedure turn（6-1・6-2 段 7f：形は推定。利用者の依頼）の X-Plane での確認、空中。三沢（RJSM）の西、GABII の 6 nm 手前、4,000 ft、200 kt、方位 100（真）で開始（機体を読み直す）。RTE で RJSS→RJSM、ARRIVALS で ILS28-Z と遷移 GABII（GABII で PI：058°、右、15 nm）、ACTIVATE と EXEC、LEGS で DIRECT TO GABII、LNAV。GABII の上を通って出航（103°）、45° の脚（058°）、右へ 180° の旋回、戻り（238°）、入航コース（283°）に乗って GABII へ。LEGS の PROC TURN、ND の形を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 40.6960, "longitude": 141.4100, "elevation_in_meters": 1219, "heading_true": 100, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "set", "note": "MCP 高度 4,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 4000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 108（真 100）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 108 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "mark", "note": "経路：RJSS→RJSM、ILS28-Z の GABII 遷移、ACTIVATE と EXEC、DIRECT TO GABII、LNAV" },
    { "do": "cdu", "keys": ["RTE", "RJSS", "L1", "RJSM", "R1", "DEPARR", "R2"] },
    { "do": "check", "note": "RJSM ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJSM ARRIVALS" },
    { "do": "check", "note": "4 番目の進入 ILS28-Z", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "ILS28-Z" },
    { "do": "cdu", "keys": ["R4"] },
    { "do": "check", "note": "遷移 GABII", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "GABII" },
    { "do": "cdu", "keys": ["R2", "RTE", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["LEGS", "GABII", "L1", "?SEL", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ACT RTE 1 LEGS、現用点 GABII", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^GABII " },
    { "do": "check", "note": "次の行の上に PROC TURN（FCOM p.1331）", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "PROC TURN" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV が engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 60 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_legs_proc_turn" },
    { "do": "view", "name": "forward" },
    { "do": "switch", "note": "ND の表示範囲 20 nm（つまみのコマンドで）", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/range/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/range/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 3 },
    { "do": "view", "note": "機長の ND：GABII の後の procedure turn の形", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_proc_turn_ahead" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "GABII を通って出航、45° の脚、右へ 180°、戻り（推定の形）" },
    { "do": "wait", "note": "出航（段階 1）", "dref": "laminar/B747/fms/lnav/pturn_phase", "op": "==", "value": 1, "timeout": 240 },
    { "do": "watch", "note": "出航、45° の脚への角（fly-by の弧）と 45° の脚を 0.3 nm 以内で", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.3, "until": { "dref": "laminar/B747/fms/lnav/pturn_phase", "op": "==", "value": 3 }, "timeout": 300 },
    { "do": "wait", "note": "180° の旋回で右へのバンク", "dref": "laminar/B747/fms/lnav/roll", "op": ">", "value": 10, "timeout": 30 },
    { "do": "view", "note": "機長の ND：旋回の中", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_proc_turn_turning" },
    { "do": "view", "name": "forward" },
    { "do": "watch", "note": "旋回を 0.3 nm 以内で", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.3, "until": { "dref": "laminar/B747/fms/lnav/pturn_phase", "op": "==", "value": 4 }, "timeout": 180 },
    { "do": "watch", "note": "戻りの脚から入航コースへ（procedure turn の終わりで段階 0）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "until": { "dref": "laminar/B747/fms/lnav/pturn_phase", "op": "==", "value": 0 }, "timeout": 240 },
    { "do": "sleep", "seconds": 40 },
    { "do": "watch", "note": "入航コースの上（0.3 nm 以内）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.3, "timeout": 20 },
    { "do": "check", "note": "入航コース 283（磁）＝真 274 ほど", "dref": "laminar/B747/fms/lnav/dtk", "op": "between", "value": [270, 279] },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
