{
  "name": "s168_vnav_msgs",
  "description": "6-1/6-2 段 11c2a（予測からの VNAV の警告）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、ZFW 200 t、CRZ ALT FL350、CI 100。XAC（85 NM 先）に FL330A を入れて VNAV を engage すると、上昇が間に合わないので UNABLE NEXT ALT（FCOM p.1434、FMSPG p.117）。CLB のページで CRZ ALT を FL450（MAX ALT より上）にすると LIMIT ALT FLXXX（FCOM p.1433）、FL350 に戻すと消える。XAC の制限を消し、BOKJO に 10000 を入れて降下の経路を作り（進入なしなので BOKJO が E/D）、それを消すと DESCENT PATH DELETED（FCOM p.1431）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 35,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },
    { "do": "set", "note": "MCP 高度 36,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 36000 },

    { "do": "mark", "note": "UNABLE NEXT ALT" },
    { "do": "cdu", "note": "CLR、LEGS、XAC に FL330A、EXEC", "keys": ["CLR", "CLR", "CLR", "LEGS", "/FL330A", "R1", "EXEC"] },
    { "do": "sleep", "seconds": 5, "note": "MCP の高度が中へ写るのと予測を待つ" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "wait", "note": "UNABLE NEXT ALT の旗（予測は 10 秒ごと）", "dref": "laminar/B747/fms/notification[47]", "op": "==", "value": 1, "timeout": 25 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "書き込み行に UNABLE NEXT ALT（FCOM p.1434）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "UNABLE NEXT ALT" },
    { "do": "check", "note": "FMC MESSAGE", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 1 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_unable_next_alt" },

    { "do": "mark", "note": "LIMIT ALT FLXXX" },
    { "do": "cdu", "note": "VNAV（CLB のページ）、CLR、CRZ ALT FL450", "keys": ["VNAV", "CLR", "450", "L1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "書き込み行に LIMIT ALT FLXXX（FCOM p.1433）", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^LIMIT ALT FL[0-9]{3}$" },
    { "do": "shot", "name": "cdu_limit_alt" },
    { "do": "cdu", "note": "CLR、CRZ ALT FL350 に戻す", "keys": ["CLR", "CLR", "CLR", "350", "L1"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LIMIT ALT は消える", "dref": "laminar/B747/fms3/Line14_L", "op": "matches", "value": "^(?!LIMIT ALT)" },

    { "do": "mark", "note": "DESCENT PATH DELETED" },
    { "do": "cdu", "note": "CLR、LEGS、XAC の制限を消す、BOKJO に 10000、EXEC", "keys": ["CLR", "CLR", "CLR", "LEGS", "DEL", "R1", "/10000", "R3", "EXEC"] },
    { "do": "sleep", "seconds": 12, "note": "予測（BOKJO が E/D の降下の経路）" },
    { "do": "check", "note": "UNABLE NEXT ALT の旗は消える", "dref": "laminar/B747/fms/notification[47]", "op": "==", "value": 0 },
    { "do": "check", "note": "VNAV は engage のまま", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2 },
    { "do": "cdu", "note": "CLR、BOKJO の 10000 を消す、EXEC", "keys": ["CLR", "CLR", "CLR", "DEL", "R3", "EXEC"] },
    { "do": "wait", "note": "書き込み行に DESCENT PATH DELETED（FCOM p.1431）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "DESCENT PATH DELETED", "timeout": 15 },
    { "do": "shot", "name": "cdu_descent_path_deleted" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
