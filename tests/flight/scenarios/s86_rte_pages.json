{
  "name": "s86_rte_pages",
  "description": "RTE ページ（6-1・6-2 段 5b：FMC の経路）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す）。航法データ（Custom Data）を読み終えた後、RTE 1 ページ目で ORIGIN RJAA・DEST RJBB・RUNWAY 34L（FCOM p.1288-1289）、2 ページ目で TO SPENS（DIRECT）、VIA Y71（箱）、TO XAC（Y71 の点）、TO AKAGI（2 か所あるので SELECT DESIRED WPT：FCOM p.1335）。ACTIVATE と EXEC で ACT RTE 1、X-Plane の FMS（その RTE ページ）に出発地と目的地が流し込まれる。CDU と ND を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<FMC（IDENT）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },

    { "do": "mark", "note": "RTE 1 ページ目（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "RTE", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "非アクティブの経路：題名 RTE 1（FCOM p.1287）", "dref": "laminar/B747/fms3/Line01_L", "op": "==", "value": "         RTE 1          " },
    { "do": "check", "note": "ORIGIN と DEST の箱", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "****                ****" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "note": "ORIGIN RJAA（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/B" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/B" },
    { "do": "cmd", "note": "DEST RJBB（R1）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "ORIGIN RJAA、DEST RJBB", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "RJAA                RJBB" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/4" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/L" },
    { "do": "cmd", "note": "RUNWAY 34L（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "RUNWAY RW34L", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "RW34L" },
    { "do": "check", "note": "FMC のデータ（ほかのモジュールが読む）：fltdep", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"fltdep\":\"RJAA\"" },
    { "do": "check", "note": "fltdst", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"fltdst\":\"RJBB\"" },
    { "do": "check", "note": "TRANS ALT は RJAA の 14000", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"transalt\":\"14000\"" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_rte_page1" },

    { "do": "mark", "note": "RTE 2 ページ目：VIA と TO" },
    { "do": "cmd", "note": "NEXT PAGE", "name": "laminar/B747/fms1/func_key/next_pg" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "終わりのダッシュ（FCOM p.1297-1298）", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "-----              -----" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/P" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/E" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/N" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "note": "TO SPENS（R1）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "DIRECT SPENS（FCOM p.1297）", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "DIRECT             SPENS" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/Y" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "VIA Y71（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "Y71 と TO の箱", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "Y71                *****" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/X" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/C" },
    { "do": "cmd", "note": "TO XAC（R2）", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "Y71 で XAC へ", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "Y71                  XAC" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/K" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/G" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/I" },
    { "do": "cmd", "note": "TO AKAGI（R3）", "name": "laminar/B747/fms1/ls_key/R3" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "AKAGI は 2 か所：SELECT DESIRED WPT（FCOM p.1335）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "SELECT DESIRED WPT" },
    { "do": "shot", "name": "cdu_select_desired_wpt" },
    { "do": "cmd", "note": "近い方（日本の AKAGI）を選ぶ（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "RTE のページに戻り DIRECT AKAGI", "dref": "laminar/B747/fms3/Line07_L", "op": "==", "value": "DIRECT             AKAGI" },
    { "do": "shot", "name": "cdu_rte_page2" },

    { "do": "mark", "note": "ACTIVATE と EXEC、X-Plane の FMS への流し込み" },
    { "do": "cmd", "note": "ACTIVATE>（R6）", "name": "laminar/B747/fms1/ls_key/R6" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "EXEC", "name": "laminar/B747/fms1/key/execute", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ACT RTE 1（FCOM p.1290）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cmd", "note": "X-Plane の CDU の RTE ページ（標準のコマンド）", "name": "sim/FMS/fpln" },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "X-Plane の CDU", "drefs": ["sim/cockpit2/radios/indicators/fms_cdu1_text_line0", "sim/cockpit2/radios/indicators/fms_cdu1_text_line2", "sim/cockpit2/radios/indicators/fms_cdu1_text_line3"] },
    { "do": "check", "note": "X-Plane の FMS に流し込まれた目的地", "dref": "sim/cockpit2/radios/indicators/fms_cdu1_text_line2", "op": "contains", "value": "RJBB" },
    { "do": "check", "note": "出発地", "dref": "sim/cockpit2/radios/indicators/fms_cdu1_text_line2", "op": "contains", "value": "RJAA" },
    { "do": "wait", "note": "ND の出発滑走路：X-Plane の FMS の出発地の次の点 RW34L（X-Plane の DEP ARR と同じ、名前のついた位置）を ND が見つける", "dref": "laminar/B747/nd/capt/apt/rwy0", "op": "contains", "value": "34L", "timeout": 10 },
    { "do": "set", "note": "ND の表示範囲を広く", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_route" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
