{
  "name": "s50_wxr_faults",
  "description": "ND の気象レーダーの注記の色と故障（5-1 段 5d、パネルの変更、NAV-80・81）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt、対流性の天気で開始（機体を読み直す）。WX のモードとチルトは青、MAP のゲインは 3 行目に CAL・VAR（推定）。新しい故障：アンテナで WXR FAIL（琥珀、反射は出さない）、TEST でチルトの欄に故障の源 ANT（FCOM p.1224）、操作盤で WXR FAIL、ゲイン制御で 3 行目に WEAK（反射は残る）、安定化の IRU の故障で ATT（ATA34_1 p.246）。X-Plane のレーダーの故障（R/T）でも WXR FAIL。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "convective",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "set", "note": "機長の ND を MAP 40 nm", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "note": "副操縦士の ND を MAP 40 nm", "dref": "laminar/B747/nd/mode/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "両 EFIS の WXR", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "value": 1 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "value": 1 },
    { "do": "cmd", "note": "機長の WX", "name": "sim/instruments/EFIS_wxr_radar_wx" },
    { "do": "cmd", "note": "副操縦士の WX", "name": "sim/instruments/EFIS_wxr_radar_wx_copilot" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ND の注記 WXR（FCOM p.1155）", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WXR" },
    { "do": "check", "note": "青", "dref": "laminar/B747/nd/capt/text/wxr_color[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "チルトも青", "dref": "laminar/B747/nd/capt/text/wxr_color[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "WX は自動のゲイン：3 行目なし", "dref": "laminar/B747/nd/capt/text/wxr_color[2]", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_wx" },

    { "do": "mark", "note": "MAP のゲイン" },
    { "do": "cmd", "note": "機長の MAP", "name": "sim/instruments/EFIS_wxr_radar_map" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAP GAIN が較正の止まり：CAL（推定）", "dref": "laminar/B747/nd/capt/text/wxr3", "op": "==", "value": "CAL" },
    { "do": "check", "note": "青", "dref": "laminar/B747/nd/capt/text/wxr_color[2]", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_map_cal" },
    { "do": "cmd", "note": "MAP GAIN を 3 つ下げる", "name": "sim/instruments/EFIS_wxr_gain_down" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_gain_down" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_gain_down" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "較正の止まりより下：VAR（ATA34_1 p.244）", "dref": "laminar/B747/nd/capt/text/wxr3", "op": "==", "value": "VAR" },
    { "do": "shot", "name": "nd_map_var" },
    { "do": "cmd", "note": "機長の WX に戻す", "name": "sim/instruments/EFIS_wxr_radar_wx" },

    { "do": "mark", "note": "アンテナの故障" },
    { "do": "set", "note": "アンテナの故障（wxr/fail[0]）", "dref": "laminar/B747/wxr/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WXR FAIL（ATA34_1 p.246）", "dref": "laminar/B747/wxr/nd_fail[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "1 行目 WXR", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WXR" },
    { "do": "check", "note": "2 行目 FAIL", "dref": "laminar/B747/nd/capt/text/tilt", "op": "==", "value": "FAIL" },
    { "do": "check", "note": "琥珀", "dref": "laminar/B747/nd/capt/text/wxr_color[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "琥珀", "dref": "laminar/B747/nd/capt/text/wxr_color[1]", "op": "==", "value": 2 },
    { "do": "check", "note": "反射は出さない", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の ND も", "dref": "laminar/B747/nd/fo/text/tilt", "op": "==", "value": "FAIL" },
    { "do": "shot", "name": "nd_wxr_fail" },
    { "do": "cmd", "note": "TEST", "name": "laminar/B747/wxr/buttons/test" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TEST", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "TEST" },
    { "do": "check", "note": "チルトの欄に故障の源 ANT（FCOM p.1224）", "dref": "laminar/B747/nd/capt/text/tilt", "op": "==", "value": "ANT" },
    { "do": "check", "note": "琥珀", "dref": "laminar/B747/nd/capt/text/wxr_color[1]", "op": "==", "value": 2 },
    { "do": "shot", "name": "nd_test_ant" },
    { "do": "cmd", "note": "機長の WX（TEST を終える）", "name": "sim/instruments/EFIS_wxr_radar_wx" },
    { "do": "cmd", "note": "副操縦士の WX", "name": "sim/instruments/EFIS_wxr_radar_wx_copilot" },
    { "do": "set", "dref": "laminar/B747/wxr/fail[0]", "value": 0 },

    { "do": "mark", "note": "操作盤とゲイン制御の故障" },
    { "do": "set", "note": "操作盤の故障（wxr/fail[1]）", "dref": "laminar/B747/wxr/fail[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WXR FAIL", "dref": "laminar/B747/nd/capt/text/tilt", "op": "==", "value": "FAIL" },
    { "do": "set", "dref": "laminar/B747/wxr/fail[1]", "value": 0 },
    { "do": "set", "note": "ゲイン制御（校正）の故障（wxr/fail[2]）", "dref": "laminar/B747/wxr/fail[2]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "モードは残る", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WXR" },
    { "do": "check", "note": "3 行目 WEAK（ATA34_1 p.246）", "dref": "laminar/B747/nd/capt/text/wxr3", "op": "==", "value": "WEAK" },
    { "do": "check", "note": "琥珀", "dref": "laminar/B747/nd/capt/text/wxr_color[2]", "op": "==", "value": 2 },
    { "do": "check", "note": "反射は残る", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 2 },
    { "do": "shot", "name": "nd_weak" },
    { "do": "set", "note": "IRU L の故障も（WEAK が先）", "dref": "laminar/B747/irs/fail/iru[0]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "WEAK が ATT より先（ATA34_1 p.246）", "dref": "laminar/B747/nd/capt/text/wxr3", "op": "==", "value": "WEAK" },
    { "do": "set", "dref": "laminar/B747/wxr/fail[2]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L の R/T の安定化は IRU L：ATT", "dref": "laminar/B747/nd/capt/text/wxr3", "op": "==", "value": "ATT" },
    { "do": "check", "note": "X-Plane の安定化なし", "dref": "sim/cockpit2/EFIS/EFIS_weather_stab", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_att" },
    { "do": "set", "dref": "laminar/B747/irs/fail/iru[0]", "value": 0 },

    { "do": "mark", "note": "R/T の故障" },
    { "do": "set", "note": "X-Plane のレーダーの故障（R/T）", "dref": "sim/operation/failures/rel_wxr_radar", "value": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WXR FAIL", "dref": "laminar/B747/nd/capt/text/tilt", "op": "==", "value": "FAIL" },
    { "do": "check", "note": "パネルの灯は消える（R/T が電源：ATA34_1 p.210）", "dref": "laminar/B747/wxr/lamp/rt", "op": "==", "value": 0 },
    { "do": "set", "dref": "sim/operation/failures/rel_wxr_radar", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "戻る", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WXR" },
    { "do": "check", "note": "青", "dref": "laminar/B747/nd/capt/text/wxr_color[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_end" },
    { "do": "view", "name": "forward" }
  ]
}
