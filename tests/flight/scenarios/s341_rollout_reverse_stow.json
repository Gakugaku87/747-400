{
  "name": "s341_rollout_reverse_stow",
  "description": "着陸の滑走の逆推力を、逆推力いっぱいから直接格納する（2026-11-19、利用者の RKSI 34R の「リバースでもEPR計が赤表示になっていた」「なぞのMASTER WARNING音が鳴ってた」の再現：notes/ATA-70-80.md §23 の候補 1、ATA-31-warning.md §11 の候補 1）、P&W。s340 と同じ RJAA 34L の自動着陸。接地の後、推力レバーをアイドル（利用者のハードのスロットルをアイドルに戻した状態）にして逆推力いっぱい（hold 10 秒）、hold が終わったらすぐ逆推力のレバーを下げきる（格納）。エンジンが回ったまま扉が閉じる間の、表示の EPR・N1、EPR の赤、離陸形態警報（CONFIG FLAPS・SPOILERS）と master WARNING を見る。2026-11-20 の直しの前は、逆推力いっぱいで表示の EPR 1.45・N1 99 %、格納の 1 秒後に CONFIG FLAPS・SPOILERS と master WARNING（直した後は N1 約 86 %・EPR 1.28、警報なし：notes/ATA-70-80.md §23、ATA-31-warning.md §11）",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 9000.0, 22000.0, 22000.0, 9000.0, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "MCP 高度 3,000 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "スピードブレーキを ARM", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "set", "note": "オートブレーキ 2", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 4 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },
    { "do": "set", "note": "PFD の ILS の表示の同調の印（s114 と同じ）", "dref": "laminar/B747/autopilot/ils_dots", "value": 1 },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300, "stop": true },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200, "stop": true },
    { "do": "wait", "note": "FLARE（FMA のピッチ 3）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 3, "timeout": 200, "stop": true },
    { "do": "wait", "note": "接地で FLARE が消える（FCOM p.671）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 0, "timeout": 40, "stop": true },
    { "do": "mark", "note": "接地" },
    { "do": "wait", "note": "スピードブレーキが自動で UP", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": ">", "value": 0.9, "timeout": 5 },
    { "do": "check", "note": "接地の時点で master WARNING なし", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0, "level": "warn" },
    { "do": "set", "note": "スロットルをアイドル（利用者のハードのスロットル：X-Plane のレバー。747 のレバーは A/T の IDLE で 0）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "mark", "note": "逆推力いっぱい" },
    { "do": "cmd", "note": "逆推力を引く（全エンジン、10 秒）", "name": "sim/engines/thrust_reverse_hold", "duration": 10, "async": true },
    { "do": "wait", "note": "逆推力 2 が展開", "dref": "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "op": ">", "value": 0.98, "timeout": 8 },
    { "do": "watch", "note": "逆推力いっぱいの間、エンジン 2 の表示の EPR は 1.40 以下（max EPR 約 1.51 の赤から遠い：P&W の逆推力は 87 % N1 まで、PW_PPM p.250。前は 1.45・N1 99 %）", "dref": "laminar/B747/engines/display_EPR[1]", "max": 1.40, "until": { "dref": "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio[1]", "op": ">", "value": -0.05 }, "timeout": 14 },
    { "do": "snapshot", "note": "hold の終わり（reverse idle）", "drefs": [ "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/display_N1[1]", "sim/cockpit2/engine/indicators/thrust_dry_n[1]", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "sim/flightmodel/engine/ENGN_thro_use[1]", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/CAS/warning_status[2]", "laminar/B747/CAS/warning_status[6]", "laminar/B747/warning/master_warning", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "check", "note": "hold の終わりの表示の N1 は 87 % の付近（78〜89：Tt2 の補正、reverse idle へ下がり始め）", "dref": "laminar/B747/engines/display_N1[1]", "op": "between", "value": [78, 89] },
    { "do": "check", "note": "EPR は赤くない", "dref": "laminar/B747/engines/EPR/red_on[1]", "op": "==", "value": 0 },
    { "do": "mark", "note": "格納" },
    { "do": "set", "note": "逆推力のレバーを下げきる（格納。逆推力いっぱいから直接）", "dref": "sim/cockpit2/engine/actuators/throttle_jet_rev_ratio_all", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "格納の 1 秒後", "drefs": [ "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/display_N1[1]", "sim/cockpit2/engine/indicators/thrust_dry_n[1]", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "sim/flightmodel/engine/ENGN_thro_use[1]", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/CAS/warning_status[2]", "laminar/B747/CAS/warning_status[6]", "laminar/B747/warning/master_warning", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "格納の 2 秒後", "drefs": [ "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/display_N1[1]", "sim/cockpit2/engine/indicators/thrust_dry_n[1]", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "sim/flightmodel/engine/ENGN_thro_use[1]", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/CAS/warning_status[2]", "laminar/B747/CAS/warning_status[6]", "laminar/B747/warning/master_warning", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "格納の 3 秒後", "drefs": [ "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/display_N1[1]", "sim/cockpit2/engine/indicators/thrust_dry_n[1]", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "sim/flightmodel/engine/ENGN_thro_use[1]", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/CAS/warning_status[2]", "laminar/B747/CAS/warning_status[6]", "laminar/B747/warning/master_warning", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "view", "note": "上の EICAS に寄せる", "the": -22, "psi": 29, "fov": 14 },
    { "do": "shot", "name": "eicas_after_stow_close" },
    { "do": "watch", "note": "格納の後 15 秒、master WARNING が鳴らない", "dref": "laminar/B747/warning/master_warning", "max": 0, "timeout": 12 },
    { "do": "watch", "note": "格納の後、エンジン 2 の EPR は赤くならない", "dref": "laminar/B747/engines/EPR/red_on[1]", "max": 0, "timeout": 3 },
    { "do": "snapshot", "note": "格納の 18 秒後", "drefs": [ "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/display_N1[1]", "sim/cockpit2/engine/indicators/thrust_dry_n[1]", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1]", "sim/flightmodel/engine/ENGN_thro_use[1]", "sim/cockpit2/engine/actuators/prop_mode[1]", "laminar/B747/CAS/warning_status[2]", "laminar/B747/CAS/warning_status[6]", "laminar/B747/warning/master_warning", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "cas", "note": "EICAS のメッセージ（格納の後）" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_after_stow" },
    { "do": "record_stop" }
  ]
}
