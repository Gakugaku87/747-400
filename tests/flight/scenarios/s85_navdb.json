{
  "name": "s85_navdb",
  "description": "FMC の航法データベース（6-1・6-2 段 4）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す）。航法データ（Custom Data、AIRAC 2610）を読み終えると IDENT に NAV DATA AIRAC 2610 と ACTIVE OCT01OCT29/26（FCOM p.1283）。日付を周期の後（11 月）にすると NAV DATA OUT OF DATE と >FMC MESSAGE（FCOM p.1433）、CLR で消え、日付を戻すと条件が消える。RTE の ORIGIN RJAA で TRANS ALT が RJAA の 14000（前は 18000 固定：FCOM p.1329）。IRS を入れ直してアライン中に POS INIT の REF AIRPORT RJAA で位置が出て、ZZZZ は NOT IN DATA BASE（FCOM p.1285）。CDU を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "mark", "note": "IDENT（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<FMC（最初は IDENT）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "航法データを読み終える（1 フレームに 32 KB）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "check", "note": "NAV DATA と ACTIVE（FCOM p.1283：周期の初日と次の周期の初日）", "dref": "laminar/B747/fms3/Line05_L", "op": "==", "value": "AIRAC 2610 OCT01OCT29/26" },
    { "do": "check", "note": "10 月 26 日：期限内でメッセージなし", "dref": "laminar/B747/fms/notification[55]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_ident" },

    { "do": "mark", "note": "NAV DATA OUT OF DATE" },
    { "do": "snapshot", "note": "日付", "drefs": ["sim/time/local_date_days", "laminar/B747/fltInst/capt/clock_day", "laminar/B747/fltInst/capt/clock_month", "laminar/B747/fltInst/capt/clock_year"] },
    { "do": "set", "note": "日付を 11 月 7 日ごろに（周期 2610 は 10 月 28 日まで）", "dref": "sim/time/local_date_days", "value": 310 },
    { "do": "wait", "note": "時計の日付が 11 月に", "dref": "laminar/B747/fltInst/capt/clock_month", "op": "==", "value": 11, "timeout": 10 },
    { "do": "wait", "note": "NAV DATA OUT OF DATE（FCOM p.1433）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "NAV DATA OUT OF DATE", "timeout": 10 },
    { "do": "check", "note": "FMC の alert：>FMC MESSAGE（FCOM p.1429）", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 1 },
    { "do": "check", "note": "右の CDU にも", "dref": "laminar/B747/fms2/Line14_L", "op": "contains", "value": "NAV DATA OUT OF DATE" },
    { "do": "shot", "name": "cdu_nav_data_out_of_date" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CLR で消える", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "" },
    { "do": "check", "note": "全 CDU から", "dref": "laminar/B747/fms2/Line14_L", "op": "==", "value": "" },
    { "do": "set", "note": "日付を戻す", "dref": "sim/time/local_date_days", "value": 298 },
    { "do": "wait", "note": "時計の日付が 10 月に", "dref": "laminar/B747/fltInst/capt/clock_month", "op": "==", "value": 10, "timeout": 10 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "期限内：条件が消える", "dref": "laminar/B747/fms/notification[55]", "op": "==", "value": 0 },

    { "do": "mark", "note": "TRANS ALT（RTE の ORIGIN）" },
    { "do": "cmd", "note": "RTE", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "出発地なし：18000（FCOM p.1329）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"transalt\":\"18000\"" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "note": "ORIGIN RJAA（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TRANS ALT：RJAA の 14000（航法データの earth_aptmeta.dat。前は 18000 固定）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"transalt\":\"14000\"" },
    { "do": "cmd", "note": "VNAV（CLB）", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CLB ページの TRANS ALT", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "14000" },
    { "do": "shot", "name": "cdu_clb_trans_alt" },

    { "do": "mark", "note": "REF AIRPORT（IRS を入れ直してアライン中）" },
    { "do": "switch", "note": "L IRS OFF", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "wait", "note": "L IRS は OFF", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "switch", "note": "L IRS NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 2,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "wait", "note": "アライン中（status 4）", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 4, "timeout": 5 },
    { "do": "cmd", "note": "INIT REF（アライン中：POS INIT）", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "POS INIT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "POS INIT" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/Z" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/Z" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/Z" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/Z" },
    { "do": "cmd", "note": "REF AIRPORT ZZZZ（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "航法データに無い：NOT IN DATA BASE（前は受け付けた）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "NOT IN DATA BASE" },
    { "do": "cmd", "note": "CLR（メッセージ）", "name": "laminar/B747/fms1/key/clear" },
    { "do": "cmd", "note": "CLR を押し続けて全部消す", "name": "laminar/B747/fms1/key/clear", "duration": 1.2 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "note": "REF AIRPORT RJAA（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "RJAA と位置（FCOM p.1285：N35°45.9 E140°23.1）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "RJAA N35" },
    { "do": "check", "note": "東経 140°", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "E140" },
    { "do": "shot", "name": "cdu_pos_init_ref_airport" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
