{
  "name": "s206_vnav_turn_descent",
  "description": "LF2（試験ラインフライト 2 回目の見つけたこと：notes/LINE_FLIGHTS.md §2）の X-Plane での確認、空中。ATMUG の約 60 NM 東の FL250・約 330 kt から西へ空中開始（機体を読み直す）。RTE RJAA→RJBB、DIRECT XAC・DIRECT ATMUG、STAR ATMUGA、ILS06LZ の遷移 ATVID（s198 と同じ）、ACTIVATE と EXEC、ATMUG へ DIRECT TO、LNAV、PERF INIT（ZFW 200、COST INDEX 100、CRZ ALT FL250）、MCP 4,000 ft で VNAV。（1）旋回の道のり（§127）：ATMUG の左 157° の旋回（点の上を通る）の道のりが予測に入り、T/D は前より遅く、旋回の間も VNAV の経路のずれが ±500 ft 以内（2 回目は経路の下 2,012 ft）、10,000 ft を 250 kt より遅く通る（2 回目は 253.5 kt）。（2）VNAV ALT（ATA-22 §42、FCOM p.665）：MCP 4,000 ft で VNAV ALT になり、経路の上 300 ft より上に離れてから MCP を 1,300 ft にしても押さなければ VNAV ALT のまま、高度セレクターを押すと降下を続ける。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 135.30, "elevation_in_meters": 7620, "heading_true": 268, "speed_in_meters_per_second": 230 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "sleep", "seconds": 10 },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "MCP 高度 25,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 25000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 25000 },
    { "do": "set", "note": "MCP 速度 300 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 300 },
    { "do": "cmd", "note": "FLCH で FL250 へ", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FL250 に着く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [24900, 25150], "timeout": 300 },
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT XAC、DIRECT ATMUG（s198 と同じ）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "ATMUG", "R2", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LZ（R4）、遷移 ATVID（R2）", "keys": ["L1", "R4", "R2"] },
    { "do": "check", "note": "遷移 ATVID", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "ATVID" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS：ATMUG へ DIRECT TO（1L）、EXEC（西向きから ATMUG で STAR の 111° へ左 157°）", "keys": ["LEGS", "ATMUG", "L1", "EXEC"] },
    { "do": "check", "note": "1 行目が ATMUG", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "ATMUG" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、COST INDEX 100、CRZ ALT FL250", "keys": ["INITREF", "L6", "L3", "200", "L3", "100", "L5", "250", "R1"] },
    { "do": "set", "note": "MCP 高度 4,000 ft（2 回目と同じ。STAR の ATVID の 4,000 ft 以上）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 4000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 4000 },
    { "do": "sleep", "seconds": 12, "note": "予測と VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "wait", "note": "LNAV（ロールの FMA 2）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30 },
    { "do": "snapshot", "note": "T/D までの距離（ATMUG の旋回の道のりが入る）", "drefs": [ "laminar/B747/fms/vnav/dist", "laminar/B747/fms3/Line01_L", "sim/flightmodel/position/longitude" ] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -24, "psi": 9, "fov": 24 },
    { "do": "shot", "name": "nd_before_td" },
    { "do": "view", "name": "forward" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "wait", "note": "降下（T/D：FMC の段階 3）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 3, "timeout": 600 },
    { "do": "mark" },
    { "do": "snapshot", "note": "T/D", "drefs": [ "laminar/B747/fms/vnav/dist", "sim/flightmodel/position/longitude", "sim/flightmodel/position/latitude" ] },
    { "do": "watch", "note": "（1）T/D から 10,000 ft まで、ATMUG の旋回を通して VNAV の経路のずれ ±500 ft（2 回目は旋回で -2,012 ft）", "dref": "laminar/B747/fms/vnav/path_dev", "abs": true, "max": 500, "timeout": 900, "until": { "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 10000 } },
    { "do": "check", "note": "（1）10,000 ft を 250 kt より遅く（2 回目は 253.5 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 250 },
    { "do": "mark" },
    { "do": "wait", "note": "（2）MCP 4,000 ft で VNAV ALT（FMA 5）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 5, "timeout": 600 },
    { "do": "wait", "note": "経路の上 300 ft より上（経路が先に降りる）", "dref": "laminar/B747/fms/vnav/path_dev", "op": ">", "value": 300, "timeout": 300 },
    { "do": "set", "note": "MCP 高度 1,300 ft（押さない）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 1300 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 1300 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "（2）経路の上で MCP を下げただけ：VNAV ALT のまま（FCOM p.665。2 回目は押さずに降下を続けた）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 5 },
    { "do": "cmd", "note": "高度セレクターを押す", "name": "laminar/B747/button_switch/press_altitude" },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "（2）押して VNAV の降下を続ける（VNAV PTH か SPD）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "in", "value": [4, 6] },
    { "do": "record_stop" }
  ]
}
