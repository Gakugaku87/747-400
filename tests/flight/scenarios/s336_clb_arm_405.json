    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 1", "dref": "laminar/B747/engine/derate/TO", "op": "==", "value": 1 },
    { "do": "check", "note": "TO 1（8 %）で CLB 1 が待機", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1, "cite": "FCOM p.1273, p.1315" },
    { "do": "check", "note": "TO 1 の行に <SEL> と CLB 1 の <ARM>", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "<SEL> <ARM> CLB 1>" },
    { "do": "cdu", "note": "<TO 2（L4）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 2（20 %）で CLB 2 が待機", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 2, "cite": "FCOM p.1273, p.1315" },
    { "do": "cdu", "note": "<TO（L2）、SEL 50（L1）", "keys": ["L2", "50", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は D-TO", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "D-TO" },
