{
  "name": "s336_clb_arm_405",
  "description": "上昇の減格の待機を FCOM の有効番号で分けた（2026-11-19、notes/ATA-34-61-FMC.md §170）の X-Plane での確認、地上。P&W の貨物機のリバリー（ICL 4X-ICB：simconfig の FREIGHTER、laminar/B747/freighter 1）で RJAA 34L でエンジン運転中に始め（機体を読み直す）、THRUST LIM で選ぶ。405（と 570）は離陸の rating で待機：TO 1 で CLB 1、TO 2 で CLB 2（FCOM p.1315）。assumed temperature では変えない（推定）：TO と SEL 50（推力は約 17 % 減）で CLB のまま、TO 1 と SEL 50（全部で約 23 % 減）で CLB 1。109（P&W の旅客機）ならどちらも CLB 2（減らし方 15 % 以上：FCOM p.1273。s152 と回帰試験）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "livery": "ICL 4X-ICB",
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "P&W（EPR）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 0, "stop": true },
    { "do": "check", "note": "貨物機（リバリーの simconfig の FREIGHTER）：FCOM の 405", "dref": "laminar/B747/freighter", "op": "==", "value": 1, "stop": true },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "INIT REF、<INDEX、THRUST LIM", "keys": ["INITREF", "L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "check", "note": "TO で CLB が待機", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 0 },
    { "do": "cdu", "note": "<TO 1（L3）", "keys": ["L3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 1", "dref": "laminar/B747/engine/derate/TO", "op": "==", "value": 1 },
    { "do": "check", "note": "TO 1 で CLB 1 が待機（405）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1, "cite": "FCOM p.1315" },
    { "do": "check", "note": "TO 1 の行に <SEL> と CLB 1 の <ARM>", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "<SEL> <ARM> CLB 1>" },
    { "do": "cdu", "note": "<TO 2（L4）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 2 で CLB 2 が待機（405）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 2, "cite": "FCOM p.1315" },
    { "do": "cdu", "note": "<TO（L2）、SEL 50（L1）", "keys": ["L2", "50", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は D-TO", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "D-TO" },
    { "do": "snapshot", "note": "D-TO（SEL 50）", "drefs": [ "laminar/B747/engines/to_reduction", "laminar/B747/engine/derate/CLB", "laminar/B747/fms/thrlim/eicas", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "sim/cockpit2/temperature/outside_air_temp_degc" ] },
    { "do": "check", "note": "EEC の減らし方は 15 % 以上（109 なら CLB 2 になる量）", "dref": "laminar/B747/engines/to_reduction", "op": ">=", "value": 15, "level": "warn" },
    { "do": "check", "note": "405 は TO の CLB のまま（assumed temperature では変えない：推定）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 0, "cite": "FCOM p.1315" },
    { "do": "check", "note": "TO の行に CLB の <ARM>", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<ARM>   CLB>" },
    { "do": "cdu", "note": "<TO 1（L3）：SEL はそのまま（s152）", "keys": ["L3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は D-TO 1", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "D-TO 1" },
    { "do": "check", "note": "EEC の減らし方は全部で 20 % 以上（109 なら CLB 2 になる量）", "dref": "laminar/B747/engines/to_reduction", "op": ">=", "value": 20, "level": "warn" },
    { "do": "check", "note": "405 は TO 1 の CLB 1", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1, "cite": "FCOM p.1315" },
    { "do": "check", "note": "TO 1 の行に CLB 1 の <ARM>", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "<ARM> CLB 1>" },
    { "do": "shot", "name": "cdu_thrust_lim_405_dto1" },
    { "do": "cdu", "note": "SEL を消す（DEL、L1）", "keys": ["DEL", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 1", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "TO 1" },
    { "do": "check", "note": "CLB 1 のまま", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1 }
  ]
}
