    { "do": "check", "note": "EEC の減らし方は 15 % 以上（下の CLB 2 の前提。11-21 は 16.6 %）", "dref": "laminar/B747/engines/to_reduction", "op": ">=", "value": 15 },
    { "do": "check", "note": "D-TO で 15 % 以上：CLB 2 が待機（貨物機も。11-24 の前は CLB のまま）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 2, "cite": "FCOM p.1273" },
    { "do": "check", "note": "CLB 2 の行に <ARM>", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "<ARM> CLB 2>" },
    { "do": "cdu", "note": "<TO 1（L3）：SEL はそのまま（s152）", "keys": ["L3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は D-TO 1", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "D-TO 1" },
    { "do": "check", "note": "EEC の減らし方は全部で 15 % 以上（11-21 は 23.3 %）", "dref": "laminar/B747/engines/to_reduction", "op": ">=", "value": 15 },
    { "do": "check", "note": "D-TO 1 で全部 15 % 以上：CLB 2（11-24 の前は TO 1 の CLB 1）", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 2, "cite": "FCOM p.1273" },
    { "do": "check", "note": "TO 1 の行に <SEL>、CLB 2 の行に <ARM>", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "<ARM> CLB 2>" },
    { "do": "shot", "name": "cdu_thrust_lim_405_dto1" },
    { "do": "cdu", "note": "SEL を消す（DEL、L1）", "keys": ["DEL", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 1", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "TO 1" },
    { "do": "check", "note": "TO 1 の 8 % だけ：CLB 1 に戻る", "dref": "laminar/B747/engine/derate/CLB", "op": "==", "value": 1, "cite": "FCOM p.1273" },
    { "do": "check", "note": "TO 1 の行に <SEL> と CLB 1 の <ARM>", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "<SEL> <ARM> CLB 1>" }
  ]
}
