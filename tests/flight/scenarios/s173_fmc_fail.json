{
  "name": "s173_fmc_fail",
  "description": "6-1/6-2 段 11d1（FMC 2 台の故障と CDU の接続）の X-Plane での確認。RJAA 34L の地上（機体を読み直す）。左 FMC を故障させる（laminar/B747/fms/fail[0]）と、左と中央の CDU は MENU と TIMEOUT - RESELECT、右の CDU は SINGLE FMC OPERATION（FCOM p.1275, p.1434）、30 秒で EICAS に FMC LEFT（p.1429、LH3460 p.116）。左の CDU の <FMC で右 FMC につながる。左 FMC を戻すと FMC LEFT が消え、機長の NAV ソース選択を FMC R から FMC L に回すと左 FMC につながる（p.1422）。CDU と EICAS を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "check", "note": "2 台とも動いている", "dref": "laminar/B747/fms/fmc_ok[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "右 FMC も", "dref": "laminar/B747/fms/fmc_ok[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "左の CDU は左 FMC（ATA34_2 p.456）", "dref": "laminar/B747/fms/cdu_link[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "右の CDU は右 FMC", "dref": "laminar/B747/fms/cdu_link[2]", "op": "==", "value": 2 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cmd", "note": "右の CDU も <FMC", "name": "laminar/B747/fms2/func_key/fix" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "L1", "name": "laminar/B747/fms2/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "右の CDU は IDENT", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "IDENT" },

    { "do": "mark", "note": "左 FMC の故障" },
    { "do": "set", "note": "左 FMC を故障させる", "dref": "laminar/B747/fms/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "fmc_ok[0] は 0", "dref": "laminar/B747/fms/fmc_ok[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "左の CDU は MENU（FCOM p.1275）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "check", "note": "左の CDU に TIMEOUT - RESELECT", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "TIMEOUT - RESELECT" },
    { "do": "check", "note": "MENU の <FMC に <ACT> がない", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^<FMC {13}" },
    { "do": "check", "note": "中央の CDU も TIMEOUT - RESELECT", "dref": "laminar/B747/fms1/Line14_L", "op": "contains", "value": "TIMEOUT - RESELECT" },
    { "do": "check", "note": "右の CDU は IDENT のまま", "dref": "laminar/B747/fms2/Line01_L", "op": "contains", "value": "IDENT" },
    { "do": "check", "note": "右の CDU に SINGLE FMC OPERATION（FCOM p.1434）", "dref": "laminar/B747/fms2/Line14_L", "op": "contains", "value": "SINGLE FMC OPERATION" },
    { "do": "check", "note": ">FMC MESSAGE（警報）", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 1 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_timeout_reselect" },
    { "do": "cdu", "note": "INIT REF（FMC がつながっていないので MENU のまま）", "keys": ["INITREF"] },
    { "do": "check", "note": "MENU のまま", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "wait", "note": "EICAS に FMC LEFT（故障から 30 秒：FCOM p.1275、LH3460 p.116）", "dref": "laminar/B747/CAS/advisory_status[144]", "op": "==", "value": 1, "timeout": 45 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_fmc_left" },

    { "do": "mark", "note": "<FMC で右 FMC へ" },
    { "do": "cdu", "note": "CLR、<FMC", "keys": ["CLR", "L1"] },
    { "do": "check", "note": "左の CDU は右 FMC", "dref": "laminar/B747/fms/cdu_link[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "FMC の頁（IDENT）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "IDENT" },
    { "do": "check", "note": "SINGLE FMC OPERATION", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "SINGLE FMC OPERATION" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_single_fmc" },

    { "do": "mark", "note": "左 FMC を戻す" },
    { "do": "set", "note": "左 FMC を戻す", "dref": "laminar/B747/fms/fail[0]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "fmc_ok[0] は 1", "dref": "laminar/B747/fms/fmc_ok[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC LEFT が消える", "dref": "laminar/B747/CAS/advisory_status[144]", "op": "==", "value": 0 },
    { "do": "check", "note": "左の CDU は右 FMC のまま", "dref": "laminar/B747/fms/cdu_link[0]", "op": "==", "value": 2 },
    { "do": "set", "note": "機長の NAV ソース選択を FMC R に", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "FMC L に戻す", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "左の CDU は左 FMC（FCOM p.1422）", "dref": "laminar/B747/fms/cdu_link[0]", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
