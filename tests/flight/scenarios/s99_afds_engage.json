{
  "name": "s99_afds_engage",
  "description": "AFDS の作り直し 6-3 段 1a（モデルの枠組みと engage）の X-Plane での確認、空中。10,000 ft・約 290 kt で空中から始め（機体を読み直す）、FMS の空中の初期化（F/D L ON、A/T、1 秒後に ALT HOLD と CMD L）が F/D の既定のモードの後に ALT になることを見る。操縦輪のスイッチの 1 回目で解除と AUTOPILOT DISC、2 回目で警報を消す（FCOM p.655）、F/D を両方 OFF で全モードを消す（FCOM p.660）、F/D OFF で CMD C の既定のモード（V/S と HDG HOLD：FCOM p.640）、解除バーを下げて解除と警報・下げたままでは engage しない・上げても警報は消えない・CMD で engage して警報が消える（FCOM p.640、ATA22 p.380）、AFDS の状態（CMD は両側、FD は ON の側だけ：FCOM p.654）。PFD と EICAS を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の空中の初期化を待つ" },
    { "do": "wait", "note": "空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 20 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CMD L", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "F/D の既定の V/S の後の ALT HOLD で ALT", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "check", "note": "F/D の既定の HDG HOLD", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "AFDS の状態 CMD（機長）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 2 },
    { "do": "check", "note": "AFDS の状態 CMD（副操縦士：CMD は両側）", "dref": "laminar/B747/autopilot/AFDS/status_annun_copilot", "op": "==", "value": 2 },
    { "do": "check", "note": "AUTOPILOT DISC は無い", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：CMD、HDG HOLD・ALT", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_cmd" },

    { "do": "mark", "note": "操縦輪のスイッチ（FCOM p.655）" },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "解除", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "AFDS の状態 FD（F/D L が ON の機長側）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士側は空白（F/D R は OFF）", "dref": "laminar/B747/autopilot/AFDS/status_annun_copilot", "op": "==", "value": 0 },
    { "do": "check", "note": "F/D のモードは残る（ALT）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9 },
    { "do": "cas", "note": "AUTOPILOT DISC" },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_autopilot_disc" },
    { "do": "view", "note": "機長の PFD：FD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_fd" },
    { "do": "cmd", "note": "もう一度押して AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "AUTOPILOT DISC が消える", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "F/D を両方 OFF：全モードを消す（FCOM p.660）" },
    { "do": "cmd", "note": "F/D L OFF", "name": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ピッチのモード無し", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "ロールのモード無し", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "ALT HOLD の状態も消える", "dref": "laminar/B747/autopilot/altitude_hold_status", "op": "==", "value": 0 },
    { "do": "check", "note": "AFDS の状態は空白", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 0 },

    { "do": "mark", "note": "F/D OFF で CMD C：V/S と HDG HOLD（FCOM p.640）" },
    { "do": "set", "note": "MCP 高度 15,000 ft（V/S が捕捉にならないように）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 15000 },
    { "do": "sleep", "seconds": 4 },
    { "do": "cmd", "note": "A/P CMD C", "name": "laminar/B747/autopilot/button_switch/cmd_C" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CMD C で engage", "dref": "laminar/B747/autopilot/cmd_C_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "サーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1 },
    { "do": "check", "note": "既定の V/S", "dref": "laminar/B747/autopilot/vvi_status", "op": "==", "value": 2 },
    { "do": "check", "note": "FMA の V/S", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "FMA の HDG HOLD", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "check", "note": "V/S は今の昇降率に合わせる（3,000 fpm を超える古い値ではない）", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "op": "between", "value": [-3000, 3000] },
    { "do": "check", "note": "AFDS の状態 CMD（F/D は両方 OFF でも両側）", "dref": "laminar/B747/autopilot/AFDS/status_annun_copilot", "op": "==", "value": 2 },
    { "do": "cmd", "note": "A/P CMD L（2 台目は engage しない）", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CMD L は入らない", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の PFD：CMD、HDG HOLD・V/S", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_cmd_vs" },

    { "do": "mark", "note": "解除バー（FCOM p.640、ATA22 p.380）" },
    { "do": "cmd", "note": "解除バーを下げる", "name": "laminar/B747/autopilot/slide_switch/disengage_bar" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "解除", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "check", "note": "AUTOPILOT DISC", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "下げたまま CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "下げている間は engage しない", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 0 },
    { "do": "cmd", "note": "解除バーを上げる", "name": "laminar/B747/autopilot/slide_switch/disengage_bar" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "上げても AUTOPILOT DISC は消えない", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "engage", "dref": "laminar/B747/autopilot/cmd_L_mode/status", "op": "==", "value": 1 },
    { "do": "check", "note": "engage で AUTOPILOT DISC が消える", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "AFDS の状態（FCOM p.654）" },
    { "do": "cmd", "note": "F/D R ON（A/P は engage 中）", "name": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/P 中は CMD のまま", "dref": "laminar/B747/autopilot/AFDS/status_annun_copilot", "op": "==", "value": 2 },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_fo" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士側は FD（F/D R が ON）", "dref": "laminar/B747/autopilot/AFDS/status_annun_copilot", "op": "==", "value": 1 },
    { "do": "check", "note": "機長側は空白（F/D L は OFF）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 0 },
    { "do": "check", "note": "F/D R にモードが残る（V/S）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "view", "note": "副操縦士の PFD：FD", "the": -19, "psi": 47, "fov": 20 },
    { "do": "shot", "name": "fo_pfd_fd" },
    { "do": "cmd", "note": "もう一度押して AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_fo" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "AUTOPILOT DISC が消える", "dref": "laminar/B747/CAS/warning_status[0]", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
