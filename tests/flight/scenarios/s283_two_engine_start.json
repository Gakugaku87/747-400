    { "do": "switch", "note": "FUEL CONTROL 2 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 1 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "wait", "note": "N2 60 % 以上（エンジン 2）", "dref": "sim/flightmodel/engine/ENGN_N2_[1]", "op": ">=", "value": 60, "timeout": 150 },
    { "do": "wait", "note": "N2 60 % 以上（エンジン 1）", "dref": "sim/flightmodel/engine/ENGN_N2_[0]", "op": ">=", "value": 60, "timeout": 150 },
    { "do": "wait", "note": "START 2 が戻る", "level": "warn", "dref": "laminar/B747/toggle_switch/position[17]", "op": "==", "value": 0, "timeout": 30 },
    { "do": "wait", "note": "START 1 が戻る", "level": "warn", "dref": "laminar/B747/toggle_switch/position[16]", "op": "==", "value": 0, "timeout": 30 },

    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "4 発 idle", "drefs": [
      "sim/flightmodel/engine/ENGN_N2_[0]", "sim/flightmodel/engine/ENGN_N2_[1]", "sim/flightmodel/engine/ENGN_N2_[2]", "sim/flightmodel/engine/ENGN_N2_[3]",
      "sim/flightmodel/engine/ENGN_EGT_c[0]", "sim/flightmodel/engine/ENGN_EGT_c[1]", "sim/flightmodel/engine/ENGN_EGT_c[2]", "sim/flightmodel/engine/ENGN_EGT_c[3]" ] },
    { "do": "cas", "note": "4 発始動後" },
    { "do": "check", "note": "エンジン 1 運転", "dref": "sim/flightmodel/engine/ENGN_running[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 2 運転", "dref": "sim/flightmodel/engine/ENGN_running[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 3 運転", "dref": "sim/flightmodel/engine/ENGN_running[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 4 運転", "dref": "sim/flightmodel/engine/ENGN_running[3]", "op": "==", "value": 1 },
    { "do": "record_stop" }
  ]
}
