    { "do": "check", "note": "AC BUS 2 通電", "dref": "laminar/B747/electrical/bus2hot", "op": "==", "value": 1 },
    { "do": "check", "note": "AC BUS 3 通電", "dref": "laminar/B747/electrical/bus3hot", "op": "==", "value": 1 },
    { "do": "check", "note": "AC BUS 4 通電", "dref": "laminar/B747/electrical/bus4hot", "op": "==", "value": 1 },
    { "do": "check", "note": "APU GEN を左右に入れると SSB は開（FCOM p.796）", "dref": "laminar/B747/electrical/breaker/ssb", "op": "==", "value": 0 },
    { "do": "check", "note": "standby bus（AC 3 から、FCOM p.804）", "dref": "laminar/B747/electrical/bus/stby_main", "op": "==", "value": 1 },
    { "do": "cas", "note": "APU GEN 投入後" },
    { "do": "shot", "name": "panel_apu_gen" },

    { "do": "switch", "note": "APU BLEED ON", "cite": "FCOM p.109 (NP.21.15)",
