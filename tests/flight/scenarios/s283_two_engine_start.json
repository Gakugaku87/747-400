      "laminar/B747/electrical/apu/sel_dial_pos", "sim/cockpit2/electrical/bus_volts[0]",
      "laminar/B747/electrical/bus1hot", "laminar/B747/electrical/bus2hot",
      "laminar/B747/electrical/bus3hot", "laminar/B747/electrical/bus4hot",
      "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]",
