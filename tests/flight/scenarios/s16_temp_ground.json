{
  "name": "s16_temp_ground",
  "description": "温度制御（3-1 段 2）の X-Plane での確認、地上。エンジン運転中の RJAA 34L で開始し、客室が target で始まり（推定）、TRIM AIR ON でトリム空気の弁が開き target が出ること（FCOM p.577）、TRIM AIR を切ると >TRIM AIR OFF と ZONE SYS FAULT 灯、target が消えて backup（FCOM p.555、p.621）、戻すと消えること、PASS TEMP を W にすると MASTER と target が 85°F（29.4 ℃）になり客室が暖まること、C で 65°F（18.3 ℃）、FLT DECK の target は動かないこと（FCOM p.554）、AFT CARGO HT を入れても貨物室が 40°F より暖かければ暖房しないこと（推定の設定）を見る。期待値は notes/ATA-21.md §4.3・§4.4。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/weather/aircraft/temperature_leadingedge_deg_c",
      "laminar/B747/air/temp/zone_actual[0]", "laminar/B747/air/temp/zone_actual[1]", "laminar/B747/air/temp/zone_actual[2]",
      "laminar/B747/air/temp/zone_actual[3]", "laminar/B747/air/temp/zone_actual[4]", "laminar/B747/air/temp/zone_actual[5]",
      "laminar/B747/air/temp/zone_actual[6]", "laminar/B747/air/temp/zone_target[0]", "laminar/B747/air/temp/zone_target[2]",
      "laminar/B747/air/temp/target_shown", "laminar/B747/air/temp/master", "laminar/B747/air/temp/cargo[0]",
      "laminar/B747/air/temp/cargo[1]", "laminar/B747/air/temp/pack_outlet", "laminar/B747/air/temp/trim_air_valve",
      "laminar/B747/air/light/zone_sys_fault", "laminar/B747/air/light/aft_cargo_temp", "laminar/B747/button_switch/position[37]",
      "laminar/B747/button_switch/position[40]", "laminar/B747/air/pass_temp_ctrl/rheostat", "laminar/B747/air/flt_deck_temp_ctrl/rheostat",
      "laminar/B747/air/packs_operating", "laminar/B747/air/pack/high_flow[0]", "laminar/B747/air/duct_pressure_C",
      "laminar/B747/annunciator/brightness_ratio[69]", "laminar/B747/annunciator/brightness_ratio[70]" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "エンジン運転中の開始：TRIM AIR ON（AIR-19）", "dref": "laminar/B747/button_switch/position[37]", "op": "==", "value": 1 },
    { "do": "check", "note": "トリム空気の master 弁が開（パック運転中、ATA21 p.346）", "dref": "laminar/B747/air/temp/trim_air_valve", "op": "==", "value": 1 },
    { "do": "check", "note": "target を出す（パック運転、AUTO、backup でない：FCOM p.577）", "dref": "laminar/B747/air/temp/target_shown", "op": "==", "value": 1 },
    { "do": "check", "note": "PASS TEMP は中央：MASTER 75°F（23.9 ℃、FCOM p.554）", "dref": "laminar/B747/air/temp/master", "op": "between", "value": [23.8, 24.0] },
    { "do": "check", "note": "zone A の target は MASTER", "dref": "laminar/B747/air/temp/zone_target[2]", "op": "between", "value": [23.8, 24.0] },
    { "do": "check", "note": "エンジン運転中の開始：客室は target 付近（推定）", "dref": "laminar/B747/air/temp/zone_actual[2]", "op": "between", "value": [22.9, 24.9] },
    { "do": "check", "note": "パックの出口は 35〜135°F（1.7〜57.2 ℃、ATA21 p.38）", "dref": "laminar/B747/air/temp/pack_outlet", "op": "between", "value": [1.6, 57.3] },
    { "do": "check", "note": "前方貨物室の温度（推定の熱のつり合い）", "dref": "laminar/B747/air/temp/cargo[0]", "op": "between", "value": [0, 40] },
    { "do": "check", "note": "後方貨物室の温度", "dref": "laminar/B747/air/temp/cargo[1]", "op": "between", "value": [0, 40] },
    { "do": "check", "note": ">TRIM AIR OFF なし", "dref": "laminar/B747/CAS/advisory_status[294]", "op": "==", "value": 0 },
    { "do": "check", "note": "TEMP ZONE なし", "dref": "laminar/B747/CAS/advisory_status[287]", "op": "==", "value": 0 },
    { "do": "check", "note": "ZONE SYS FAULT 灯なし", "dref": "laminar/B747/air/light/zone_sys_fault", "op": "==", "value": 0 },

    { "do": "mark", "note": "TRIM AIR OFF" },
    { "do": "switch", "note": "TRIM AIR を切る", "dref": "laminar/B747/button_switch/position[37]", "value": 0, "cmd": "laminar/B747/button_switch/temp_trim_air" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "master 弁が閉（FCOM p.555）", "dref": "laminar/B747/air/temp/trim_air_valve", "op": "==", "value": 0 },
    { "do": "check", "note": ">TRIM AIR OFF（FCOM p.621）", "dref": "laminar/B747/CAS/advisory_status[294]", "op": "==", "value": 1 },
    { "do": "check", "note": "ZONE SYS FAULT 灯（FCOM p.555）", "dref": "laminar/B747/air/light/zone_sys_fault", "op": "==", "value": 1 },
    { "do": "check", "note": "灯の明るさ（照明のモジュール、annunciator 69）", "dref": "laminar/B747/annunciator/brightness_ratio[69]", "op": ">", "value": 0 },
    { "do": "check", "note": "backup：target は出さない（FCOM p.577）", "dref": "laminar/B747/air/temp/target_shown", "op": "==", "value": 0 },
    { "do": "check", "note": "TEMP ZONE は出ない（故障でない）", "dref": "laminar/B747/CAS/advisory_status[287]", "op": "==", "value": 0 },
    { "do": "cas", "note": "TRIM AIR OFF" },
    { "do": "view", "name": "bleed" },
    { "do": "shot", "name": "ecs_panel_trim_air_off" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_trim_air_off" },
    { "do": "switch", "note": "TRIM AIR を戻す", "dref": "laminar/B747/button_switch/position[37]", "value": 1, "cmd": "laminar/B747/button_switch/temp_trim_air" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "master 弁が開", "dref": "laminar/B747/air/temp/trim_air_valve", "op": "==", "value": 1 },
    { "do": "check", "note": ">TRIM AIR OFF は消える", "dref": "laminar/B747/CAS/advisory_status[294]", "op": "==", "value": 0 },
    { "do": "check", "note": "ZONE SYS FAULT 灯は消える", "dref": "laminar/B747/annunciator/brightness_ratio[69]", "op": "==", "value": 0 },
    { "do": "check", "note": "target が出る", "dref": "laminar/B747/air/temp/target_shown", "op": "==", "value": 1 },

    { "do": "mark", "note": "PASS TEMP W" },
    { "do": "set", "note": "PASS TEMP を W", "dref": "laminar/B747/air/pass_temp_ctrl/rheostat", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MASTER 85°F（29.4 ℃、FCOM p.554）", "dref": "laminar/B747/air/temp/master", "op": "between", "value": [29.3, 29.5] },
    { "do": "check", "note": "zone E の target 85°F", "dref": "laminar/B747/air/temp/zone_target[6]", "op": "between", "value": [29.3, 29.5] },
    { "do": "check", "note": "FLT DECK の target は動かない（FLT DECK TEMP は中央）", "dref": "laminar/B747/air/temp/zone_target[0]", "op": "between", "value": [23.8, 24.0] },
    { "do": "sleep", "seconds": 120 },
    { "do": "snapshot", "note": "PASS TEMP W から 2 分", "drefs": [
      "laminar/B747/air/temp/zone_actual[0]", "laminar/B747/air/temp/zone_actual[2]", "laminar/B747/air/temp/zone_actual[6]",
      "laminar/B747/air/temp/pack_outlet" ] },
    { "do": "check", "note": "客室が暖まる（2 分で 25 ℃ を超える：推定の熱のつり合い）", "dref": "laminar/B747/air/temp/zone_actual[2]", "op": ">", "value": 25 },
    { "do": "check", "note": "FLT DECK は target 付近のまま", "dref": "laminar/B747/air/temp/zone_actual[0]", "op": "between", "value": [22.9, 25.0] },
    { "do": "set", "note": "PASS TEMP を C（Web API は XTLua の double の dataref に小数を書けないので、中央には戻さない：TESTING.md）", "dref": "laminar/B747/air/pass_temp_ctrl/rheostat", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MASTER 65°F（18.3 ℃、FCOM p.554）", "dref": "laminar/B747/air/temp/master", "op": "between", "value": [18.2, 18.4] },
    { "do": "check", "note": "zone A の target 65°F", "dref": "laminar/B747/air/temp/zone_target[2]", "op": "between", "value": [18.2, 18.4] },
    { "do": "check", "note": "FLT DECK の target は動かない", "dref": "laminar/B747/air/temp/zone_target[0]", "op": "between", "value": [23.8, 24.0] },

    { "do": "mark", "note": "AFT CARGO HT" },
    { "do": "switch", "note": "AFT CARGO HT ON", "dref": "laminar/B747/button_switch/position[40]", "value": 1, "cmd": "laminar/B747/button_switch/temp_aft_cargo_ht" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "貨物室は 40°F より暖かい：TEMP CARGO HEAT なし", "dref": "laminar/B747/CAS/advisory_status[284]", "op": "==", "value": 0 },
    { "do": "check", "note": "TEMP 灯なし", "dref": "laminar/B747/annunciator/brightness_ratio[70]", "op": "==", "value": 0 },
    { "do": "switch", "note": "AFT CARGO HT OFF", "dref": "laminar/B747/button_switch/position[40]", "value": 0, "cmd": "laminar/B747/button_switch/temp_aft_cargo_ht" },
    { "do": "snapshot", "note": "終わり", "drefs": [
      "laminar/B747/air/temp/zone_actual[2]", "laminar/B747/air/temp/cargo[0]", "laminar/B747/air/temp/cargo[1]",
      "laminar/B747/air/temp/pack_outlet", "laminar/B747/air/pack/high_flow[0]" ] },
    { "do": "record_stop" }
  ]
}
