{
  "name": "s360_pfd_eicas_ge_takeoff",
  "description": "段 4 のフルレビューのパネルの直し（2026-11-24、担当 panel）の X-Plane の確かめ：GE（570：Saudia、CF6-80C2）の離陸。s325 の手順で RJAA 34L から。(1) 地上アイドルで 60 秒おき、EICAS の指令 N1（`TRA`）が表示の N1 と同じ（PNL-5：前は EEC の 25 % のままで、印はバーの端から離れていた）、主 EICAS を寄せて撮る（白い指令の印がバーの端、EGT・N1 の限界の線：PNL-3）。(2) V1・VR・V2 を選んだ地上で V2 のバグ（DSP-4：570 だけ）、PFD を寄せて撮る。(3) 浮いて 300 ft（フラップ 20）でも V2 のバグ、(4) フラップを 10 に上げ始めると消える（FCOM p.972）。(5) A/P の VNAV の上昇で F/D のピッチのバーが飛行機の記号の上（PNL-1）、PFD を寄せて撮る",
  "livery": "Saudia",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "check", "note": "GE（engines/type 1）", "dref": "laminar/B747/engines/type", "op": "==", "value": 1 },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 9,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 9000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 9000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s325 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（地上で最初の F/D：T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },

    { "do": "mark", "note": "(1) 地上アイドルの指令 N1（PNL-5）と限界の線（PNL-3）" },
    { "do": "sleep", "note": "表示の N1 が地上アイドルの 25.9 % に落ち着く（読み直しの後 0 から、遅れ約 10〜17 秒）", "seconds": 60 },
    { "do": "snapshot", "note": "地上アイドル", "drefs": [ "laminar/B747/engines/TRA[0]", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/TRA[3]", "laminar/B747/engines/display_N1[3]", "laminar/B747/engines/display_GE_EGT[0]" ] },
    { "do": "remember", "dref": "laminar/B747/engines/display_N1[0]", "as": "n1_idle_1" },
    { "do": "check", "note": "エンジン 1 の指令 N1 は表示の N1 と同じ（±0.5 %：FCOM p.873。前は EEC の 25 %）", "dref": "laminar/B747/engines/TRA[0]", "op": "between", "rel": "n1_idle_1", "value": [-0.5, 0.5] },
    { "do": "remember", "dref": "laminar/B747/engines/display_N1[3]", "as": "n1_idle_4" },
    { "do": "check", "note": "エンジン 4 も", "dref": "laminar/B747/engines/TRA[3]", "op": "between", "rel": "n1_idle_4", "value": [-0.5, 0.5] },
    { "do": "view", "name": "eicas" },
    { "do": "view", "note": "上の EICAS に寄せる", "the": -22, "psi": 29, "fov": 14 },
    { "do": "shot", "name": "eicas_ge_idle_close" },

    { "do": "mark", "note": "CDU：経路、PERF INIT、TAKEOFF REF" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 184（荷物なし：重さは約 270 t）、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "184", "L3", "170", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20（1L）、V1・VR・V2 を選ぶ（1R〜3R）", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "V2 を選んだ（999 でない）", "dref": "laminar/B747/airspeed/V2", "op": "<", "value": 900 },

    { "do": "mark", "note": "(2) 地上の V2 のバグ（DSP-4、FCOM p.972：570 は V1・VR・V2）" },
    { "do": "check", "note": "V2 のバグを出す", "dref": "laminar/B747/airspeed/v2_show", "op": "==", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_v2_ground" },
    { "do": "view", "name": "forward" },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2", "as": "v2_mcp" },
    { "do": "set", "note": "MCP の速さを V2 に（FCOM p.118 の MCP の準備：IAS/MACH selector – Set V2。AFDS の T/O の V2 は窓の値：FCOM p.664 の注。2026-11-26 から。前は電源投入の 200 kt（FCOM p.643）のままで、T/O の目標が 210 kt だった）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 0, "rel": "v2_mcp" },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "離陸（s325 と同じ）" },
    { "do": "cmd", "note": "TO/GA（止まっている：50 kt 未満）", "name": "sim/engines/TOGA_power" },
    { "do": "wait", "note": "A/T の THR REF（5）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5, "timeout": 5 },
    { "do": "wait", "note": "150 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 150, "timeout": 120 },
    { "do": "cmd", "note": "毎秒 2.5° で 15° へ引き起こす（B747_rotate.lua）", "name": "FlyWithLua/B747_rotate/start" },
    { "do": "wait", "note": "ピッチ 7°", "dref": "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "op": ">", "value": 7, "timeout": 15 },
    { "do": "wait", "note": "浮く", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 0, "timeout": 20 },
    { "do": "wait", "note": "電波高度 35 ft（引き起こしの操縦の終わり）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 35, "timeout": 30 },
    { "do": "cmd", "note": "引き起こしの操縦を終える", "name": "FlyWithLua/B747_rotate/stop" },
    { "do": "cmd", "note": "手で F/D のバーを追う（`B747_fd_follow.lua`）", "name": "FlyWithLua/B747_fd_follow/start" },
    { "do": "cmd", "note": "脚上げ", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "電波高度 300 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 300, "timeout": 40 },
    { "do": "cmd", "note": "手の操縦を終える（操縦輪はそのまま）", "name": "FlyWithLua/B747_fd_follow/stop" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 5 },
    { "do": "set", "note": "操縦輪を放す", "dref": "sim/cockpit2/controls/yoke_pitch_ratio", "value": 0 },

    { "do": "mark", "note": "(3) 浮いた後、フラップ 20 のまま：V2 のバグは残る（V1・VR は浮くと消える）" },
    { "do": "check", "note": "V2 のバグ", "dref": "laminar/B747/airspeed/v2_show", "op": "==", "value": 1 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_v2_after_liftoff" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "(5) A/P の上昇の F/D のピッチのバー（PNL-1）" },
    { "do": "wait", "note": "VNAV SPD（400 ft の上）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "wait", "note": "電波高度 1,000 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 1000, "timeout": 60 },
    { "do": "snapshot", "note": "ピッチと F/D のピッチの指令（差が 0.1° 以内のときの写真がよい）", "drefs": [ "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "laminar/B747/autopilot/flight_director_pitch_deg", "laminar/B747/autopilot/fd/pitch_bar" ] },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_fd_bar_climb" },
    { "do": "snapshot", "note": "写真の直後", "drefs": [ "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "laminar/B747/autopilot/flight_director_pitch_deg" ] },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "(4) フラップを上げ始めると V2 のバグが消える（FCOM p.972）" },
    { "do": "set", "note": "フラップ 10", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.5 },
    { "do": "wait", "note": "V2 のバグが消える", "dref": "laminar/B747/airspeed/v2_show", "op": "==", "value": 0, "timeout": 5 },
    { "do": "check", "note": "最小機動速度の帯が出る（同じ「最初のフラップ上げ」：FCOM p.973）", "dref": "laminar/B747/pfd/show_mins", "op": "==", "value": 1 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_v2_removed" },
    { "do": "view", "name": "forward" },
    { "do": "sleep", "seconds": 5 },
    { "do": "record_stop" }
  ]
}
