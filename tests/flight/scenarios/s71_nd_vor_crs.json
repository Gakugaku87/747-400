{
  "name": "s71_nd_vor_crs",
  "description": "ND の手動同調の VOR のコースの線（5-2 段 5c-3c）の X-Plane での確認、空中。フランクフルトの南 4,000 ft・200 kt・北向きで開始。自動同調のうちは線なし。機長の CDU の NAV RAD で VOR L に FKS 117.50（手動）、CRS 070。MAP で FKS を通る緑の破線と 070・250（FCOM p.1145）、MAP CTR、VOR モードでは出さない、副操縦士の ND、VOR R（自動同調）は出さない、VOR L を DEL で自動同調に戻すと消える。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 49.600000, "longitude": 8.545000, "elevation_in_meters": 1219.2, "heading_true": 0.0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 360", "dref": "laminar/B747/autopilot/heading/degrees", "value": 360 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "範囲 40 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "note": "副操縦士の ND も 40 NM", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range_copilot", "value": 2 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "自動同調のうちはコースの線なし", "dref": "laminar/B747/nd/capt/crs/show[0]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "機長の CDU の NAV RAD", "name": "laminar/B747/fms1/func_key/navrad" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "117.5（FKS）を VOR L へ（手動）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "VOR L の識別符号 FKS", "dref": "laminar/B747/nd/vor_l_ref", "op": "==", "value": "FKS", "timeout": 30 },
    { "do": "check", "note": "VOR L は手動（M）", "dref": "laminar/B747/radio/tuningmodes", "op": "contains", "value": "M" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/7" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "CRS 070", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "wait", "note": "FKS を通るコースの線（FCOM p.1145）", "dref": "laminar/B747/nd/capt/crs/show[0]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "コース 070", "dref": "laminar/B747/nd/capt/crs/text0", "op": "==", "value": "070" },
    { "do": "check", "note": "反対 250", "dref": "laminar/B747/nd/capt/crs/text1", "op": "==", "value": "250" },
    { "do": "check", "note": "表示の上で 070 の向き（北向きの航跡、磁気偏差 3° 東）", "dref": "laminar/B747/nd/capt/crs/dir[0]", "op": "between", "value": [62, 82] },
    { "do": "check", "note": "機体に一番近い点の破線", "dref": "laminar/B747/nd/capt/crs/dash[42]", "op": "==", "value": 1 },
    { "do": "check", "note": "070 の数字は表示の内", "dref": "laminar/B747/nd/capt/crs/lbl_show[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "250 の数字も", "dref": "laminar/B747/nd/capt/crs/lbl_show[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "070 は線の右に", "dref": "laminar/B747/nd/capt/crs/tside[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "250 は線の左に（どちらも左から右に読める）", "dref": "laminar/B747/nd/capt/crs/tside[1]", "op": "==", "value": 2 },
    { "do": "check", "note": "VOR R は自動同調：線なし", "dref": "laminar/B747/nd/capt/crs/show[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の ND も FKS の線", "dref": "laminar/B747/nd/fo/crs/show[0]", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_crs_map" },
    { "do": "cmd", "note": "CTR（MAP CTR）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "MAP CTR でも出る", "dref": "laminar/B747/nd/capt/crs/show[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_crs_ctr" },
    { "do": "cmd", "note": "CTR を戻す", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "switch", "note": "機長の ND を VOR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "VOR モードでは出さない（MAP、MAP CTR だけ）", "dref": "laminar/B747/nd/capt/crs/show[0]", "op": "==", "value": 0 },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "cmd", "note": "DEL", "name": "laminar/B747/fms1/key/del" },
    { "do": "cmd", "note": "VOR L を自動同調に戻す", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "自動同調に戻ると消える", "dref": "laminar/B747/nd/capt/crs/show[0]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
