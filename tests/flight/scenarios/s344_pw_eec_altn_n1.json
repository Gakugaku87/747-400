{
  "name": "s344_pw_eec_altn_n1",
  "description": "P&W の EEC の ALTN は N1 モード（2026-11-20、GAP_ANALYSIS.md N19-ENG-05、notes/ATA-70-80.md §25）の X-Plane での確認、空中、P&W。銚子沖の 10,000 ft（270 t）で開始し、A/T を外してレバーを 0.55 に固定。EEC 2 が自分で N1 モードに移る（lockup：その時の推力のまま、N1 は 20 秒変わらない。PW_PPM p.197-198、FCOM p.877）、ENG 2 EEC MODE、A/T は使えない、ALTN 灯（N2 > 50 %：PW_PPM p.199）。レバーを進めると推力が従い、戻すと元の N1 へ（delta N1 を保つ）。故障が消えてもスイッチを使うまで N1 モードのまま（p.198）。EEC MODE 2 を ALTN にすると lockup が外れ、約 100 rpm/秒（2.8 % N1/秒）で予定の N1 へ上がる（手動で選ぶと推力が増える：FCOM p.877）。NORM に戻すと EPR モード、A/T をまた使える。機体を読み直す",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 148.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40, "stop": true },
    { "do": "check", "note": "P&W（既定のリバリー）", "dref": "laminar/B747/engines/type", "op": "==", "value": 0, "stop": true },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "switch", "note": "A/T ARM OFF", "dref": "laminar/B747/toggle_switch/position[29]", "value": 0, "cmd": "laminar/B747/authrottle_arm", "cmd_down": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "スラスト・レバー 4 本を 0.55（TLA 27.5°）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.55 },
    { "do": "wait", "note": "レバー 2 が 0.55", "dref": "laminar/B747/engine/throttle[1]", "op": "between", "value": [0.54, 0.56], "timeout": 10, "stop": true },
    { "do": "sleep", "seconds": 20, "note": "エンジンがレバーの EPR に落ち着く" },
    { "do": "snapshot", "note": "開始", "drefs": [
      "laminar/B747/engines/type", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/temperature/outside_air_LE_temp_degc", "laminar/B747/autopilot/FMA/active_pitch_mode",
      "laminar/B747/engine/throttle[1]", "laminar/B747/engines/TRA[0]", "laminar/B747/engines/TRA[1]",
      "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[1]", "laminar/B747/engines/display_EPR_max[1]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N1[1]", "laminar/B747/engines/display_N2[1]" ] },
    { "do": "check", "note": "ENG 2 EEC MODE は出ていない", "dref": "laminar/B747/CAS/advisory_status[314]", "op": "==", "value": 0 },

    { "do": "mark", "note": "EEC 2 の自動の移行（lockup）" },
    { "do": "remember", "dref": "laminar/B747/engines/display_N1[1]", "as": "n1_2" },
    { "do": "remember", "dref": "laminar/B747/engines/display_EPR[1]", "as": "epr_2" },
    { "do": "set", "note": "EEC 2 が自分で N1 モードに移る", "dref": "laminar/B747/engines/fail/eec_altn[1]", "value": 1 },
    { "do": "wait", "note": "ENG 2 EEC MODE", "dref": "laminar/B747/CAS/advisory_status[314]", "op": "==", "value": 1, "timeout": 3, "cite": "FCOM p.899" },
    { "do": "check", "note": "A/T は使えない（どれかの EEC が alternate）", "dref": "laminar/B747/engines/autothrottle_fail", "op": "==", "value": 1, "cite": "FCOM p.877" },
    { "do": "check", "note": "ALTN 灯（EPR MODE FAIL が N2 > 50 % の接点を通る）", "dref": "laminar/B747/engines/eec/altn_light[1]", "op": "==", "value": 1, "cite": "PW_PPM p.199" },
    { "do": "check", "note": "EICAS の指令の EPR（TRA）は N1 の指令の EPR：その時の EPR", "dref": "laminar/B747/engines/TRA[1]", "op": "between", "value": [-0.02, 0.02], "rel": "epr_2" },
    { "do": "watch", "note": "lockup：推力（N1）は 20 秒変わらない（delta N1 を保ち、ramp しない）", "dref": "laminar/B747/engines/display_N1[1]", "rel": "n1_2", "min": -1.0, "max": 1.0, "timeout": 20, "cite": "PW_PPM p.197-198, FCOM p.877" },
    { "do": "cas", "note": "ENG 2 EEC MODE（自動）" },

    { "do": "mark", "note": "レバーを進める（推力がレバーに従う）" },
    { "do": "set", "note": "スラスト・レバー 4 本を 0.65", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.65 },
    { "do": "wait", "note": "エンジン 2 の N1 が上がる（lockup の後も推力はレバーに従う）", "dref": "laminar/B747/engines/display_N1[1]", "op": ">", "value": 2, "rel": "n1_2", "timeout": 15, "cite": "PW_PPM p.198" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "レバー 0.65", "drefs": [
      "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/temperature/outside_air_LE_temp_degc",
      "laminar/B747/engines/TRA[0]", "laminar/B747/engines/TRA[1]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[1]",
      "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N1[1]" ] },
    { "do": "set", "note": "スラスト・レバー 4 本を 0.55 に戻す", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.55 },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "同じレバーで元の N1（delta N1 を保つ。予定の Tt2 の補正の分は動く）", "dref": "laminar/B747/engines/display_N1[1]", "op": "between", "value": [-1.5, 1.5], "rel": "n1_2", "cite": "PW_PPM p.197" },

    { "do": "mark", "note": "故障が消えても N1 モード（ラッチ）" },
    { "do": "set", "note": "故障を消す（スイッチは NORM のまま）", "dref": "laminar/B747/engines/fail/eec_altn[1]", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ENG 2 EEC MODE は残る（EPR モードへはスイッチで戻す）", "dref": "laminar/B747/CAS/advisory_status[314]", "op": "==", "value": 1, "cite": "PW_PPM p.198" },
    { "do": "check", "note": "ALTN 灯も残る", "dref": "laminar/B747/engines/eec/altn_light[1]", "op": "==", "value": 1 },

    { "do": "mark", "note": "EEC MODE 2 を ALTN（lockup を外す）" },
    { "do": "remember", "dref": "laminar/B747/engines/display_N1[1]", "as": "n1_lock" },
    { "do": "switch", "note": "EEC MODE 2 を ALTN", "dref": "laminar/B747/button_switch/position[8]", "value": 0, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_2" },
    { "do": "watch", "note": "1 秒では 2.8 % N1 ほど（約 100 rpm/秒の ramp：跳ねない）", "dref": "laminar/B747/engines/display_N1[1]", "rel": "n1_lock", "max": 3.5, "timeout": 1, "cite": "PW_PPM p.198" },
    { "do": "wait", "note": "予定の N1 へ上がる（手動で選ぶと推力が増える）", "dref": "laminar/B747/engines/display_N1[1]", "op": ">", "value": 3, "rel": "n1_lock", "timeout": 15, "cite": "FCOM p.877" },
    { "do": "sleep", "seconds": 6 },
    { "do": "snapshot", "note": "ALTN（予定の N1）", "drefs": [
      "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/temperature/outside_air_LE_temp_degc",
      "laminar/B747/engines/TRA[0]", "laminar/B747/engines/TRA[1]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR[1]",
      "laminar/B747/engines/display_EPR_max[1]", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N1[1]",
      "laminar/B747/CAS/caution_status[76]" ] },
    { "do": "check", "note": "同じレバーで lockup（EPR モードの推力）の N1 より 3 % 以上高いまま（ALTN は normal 以上の推力）", "dref": "laminar/B747/engines/display_N1[1]", "op": ">", "value": 3, "rel": "n1_lock", "cite": "FCOM p.877" },
    { "do": "check", "note": ">ENG 2 LIM PROT は出ない（EPR は最大から遠い）", "dref": "laminar/B747/CAS/caution_status[76]", "op": "==", "value": 0 },
    { "do": "cas", "note": "ENG 2 EEC MODE（手動）" },

    { "do": "mark", "note": "NORM に戻す（EPR モード）" },
    { "do": "switch", "note": "EEC MODE 2 を NORM", "dref": "laminar/B747/button_switch/position[8]", "value": 1, "cmd": "laminar/B747/button_switch/elec_eng_ctrl_2" },
    { "do": "wait", "note": "ENG 2 EEC MODE が消える", "dref": "laminar/B747/CAS/advisory_status[314]", "op": "==", "value": 0, "timeout": 3, "cite": "PW_PPM p.198" },
    { "do": "check", "note": "ALTN 灯が消える", "dref": "laminar/B747/engines/eec/altn_light[1]", "op": "==", "value": 0 },
    { "do": "wait", "note": "EPR モードで同じレバーの EPR に戻る", "dref": "laminar/B747/engines/display_EPR[1]", "op": "between", "value": [-0.03, 0.03], "rel": "epr_2", "timeout": 20 },
    { "do": "switch", "note": "A/T ARM ON", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm", "cmd_down": "laminar/B747/authrottle_disarm" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "4 発とも EPR モードなら A/T をまた使える", "dref": "laminar/B747/engines/autothrottle_fail", "op": "==", "value": 0, "cite": "FCOM p.877" },
    { "do": "cas", "note": "終わり" },
    { "do": "record_stop" }
  ]
}
