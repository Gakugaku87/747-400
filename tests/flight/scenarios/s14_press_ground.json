    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "PACK 1 OFF の memo（FCOM p.622）", "dref": "laminar/B747/CAS/memo_status[18]", "op": "==", "value": 1 },
    { "do": "check", "note": "パック 2 基", "dref": "laminar/B747/air/packs_operating", "op": "==", "value": 2 },
    { "do": "switch", "note": "PACK 2 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "PACKS 1 + 2 OFF", "dref": "laminar/B747/CAS/memo_status[21]", "op": "==", "value": 1 },
    { "do": "check", "note": "PACK 1 OFF は出さない", "dref": "laminar/B747/CAS/memo_status[18]", "op": "==", "value": 0 },
    { "do": "cas", "note": "パック 1・2 OFF" },
    { "do": "switch", "note": "PACK 1 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "パック 3 基に戻る", "dref": "laminar/B747/air/packs_operating", "op": "==", "value": 3 },

    { "do": "mark", "note": "離陸滑走" },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "sim/cockpit2/controls/parking_brake_ratio", "value": 0 },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "対地速度 65 kt（33.4 m/s）", "dref": "sim/flightmodel/position/groundspeed", "op": ">", "value": 33.5, "timeout": 60 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "65 kt で takeoff モード（ATA21 p.412）", "dref": "laminar/B747/air/press/mode", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 6 },
    { "do": "snapshot", "note": "takeoff モード", "drefs": [
      "sim/flightmodel/position/groundspeed", "laminar/B747/air/press/mode",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm",
      "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "laminar/B747/air/outflow_valve_left/pos" ] },
    { "do": "check", "note": "客室は場の高度の 50 ft 下（ΔP 約 0.027 psi、ATA21 p.428）", "dref": "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "op": "between", "value": [0.02, 0.04] },
    { "do": "check", "note": "弁は少し閉（ATA21 p.429 図）", "dref": "laminar/B747/air/outflow_valve_left/pos", "op": "between", "value": [0.0, 0.99] },
    { "do": "set", "note": "スラスト・レバーを idle", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "set", "note": "ブレーキ", "dref": "sim/cockpit2/controls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "65 kt 未満", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 33, "timeout": 60 },
