{
  "name": "s14_press_ground",
  "description": "与圧とパック（3-1 段 1）の X-Plane での確認、地上。エンジン運転中の RJAA 34L で開始し、X-Plane の与圧が上書きされ（override_pressurization）、地上モードで外流弁が全開（計器は OP）、客室高度が場の高度、パック 3 基が high flow、FMC の経路が無いと着陸高度 2000 AUTO と LANDING ALT、data block が出ることを見る。FMC の経路（RJAA→RJTT、KSFO→RJTT）を CDU の RTE ページで入れて、X-Plane の空港の一覧から出発地・目的地の標高を引くこと（FCOM p.1400）、LDG ALT の MAN とノブの 50 ft 刻み（FCOM p.573）、MAN L と CLOSE で左の弁だけが閉じ OUTFLOW VLV L（FCOM p.574、p.620）、パックの memo（FCOM p.622）、離陸滑走の 65 kt で takeoff モード（場の高度 −50 ft、ATA21 p.412）と中止で地上モードを見る。期待値は notes/ATA-21.md §4.5。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/engines/type",
      "sim/operation/override/override_pressurization", "laminar/B747/air/press/mode", "laminar/B747/air/press/cpc",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm",
      "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "sim/flightmodel2/position/pressure_altitude",
      "sim/cockpit/pressure/outflow_valve", "laminar/B747/air/outflow_valve_left/pos", "laminar/B747/air/outflow_valve_right/pos",
      "laminar/B747/air/pack/valve_pos[0]", "laminar/B747/air/pack/valve_pos[1]", "laminar/B747/air/pack/valve_pos[2]",
      "laminar/B747/air/pack/high_flow[0]", "laminar/B747/air/packs_operating", "laminar/B747/air/recirc_fan[0]",
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_C", "laminar/B747/air/duct_pressure_R",
      "sim/cockpit2/bleedair/indicators/bleed_available_left", "sim/cockpit2/bleedair/indicators/bleed_available_center",
      "sim/cockpit2/bleedair/indicators/engine_loss_from_bleed_air_ratio[0]", "sim/cockpit2/bleedair/indicators/APU_loss_from_bleed_air_ratio",
      "laminar/B747/air/landing_altitude", "laminar/B747/air/landing_alt/button_pos", "laminar/B747/air/land_alt_sel/rheostat",
      "laminar/B747/air/pressurization/EICAS1_display_status" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "X-Plane の与圧は上書き（notes/ATA-21.md §6）", "dref": "sim/operation/override/override_pressurization", "op": "==", "value": 1 },
    { "do": "check", "note": "地上モード（ATA21 p.412）", "dref": "laminar/B747/air/press/mode", "op": "==", "value": 0 },
    { "do": "check", "note": "電源投入は controller A（ATA21 p.426）", "dref": "laminar/B747/air/press/cpc", "op": "==", "value": 1 },
    { "do": "check", "note": "外流弁は全開（ATA21 p.412）：左の計器 +1", "dref": "laminar/B747/air/outflow_valve_left/pos", "op": "==", "value": 1 },
    { "do": "check", "note": "右の計器 +1", "dref": "laminar/B747/air/outflow_valve_right/pos", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の外流弁 1", "dref": "sim/cockpit/pressure/outflow_valve", "op": "==", "value": 1 },
    { "do": "check", "note": "ΔP はパックの空気の分だけ（0.05 psi 未満）", "dref": "sim/cockpit2/pressurization/indicators/pressure_diffential_psi", "op": "between", "value": [0, 0.05] },
    { "do": "check", "note": "客室高度は場の高度付近", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": "between", "value": [-300, 500] },
