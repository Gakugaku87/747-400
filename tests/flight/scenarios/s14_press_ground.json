    { "do": "check", "note": "地上は high flow（ATA21 p.86）", "dref": "laminar/B747/air/pack/high_flow[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の中央ダクトの空気（ダクト圧 / 27.5、推定）", "dref": "sim/cockpit2/bleedair/indicators/bleed_available_center", "op": "between", "value": [0.8, 1.5] },
    { "do": "check", "note": "FMC の経路なし：着陸高度 2000（FCOM p.608）", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 2000 },
    { "do": "check", "note": "FMC の経路なし：LANDING ALT（FCOM p.620）", "dref": "laminar/B747/CAS/advisory_status[240]", "op": "==", "value": 1 },
    { "do": "check", "note": "LANDING ALT で data block（ATA21 p.451）", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "view", "the": 26, "psi": 84, "fov": 16 },
    { "do": "shot", "name": "outflow_gauges_ground" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_ground_2000" },

    { "do": "cmd", "note": "CDU の FPLN（RTE 1 ページ）", "name": "laminar/B747/fms1/func_key/fpln" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "note": "ORIGIN RJAA（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/T" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/T" },
    { "do": "cmd", "note": "DEST RJTT（R1）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "出発地にいる：出発地 RJAA の標高 135 ft（FCOM p.1400、X-Plane の earth_aptmeta.dat）", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 135 },
    { "do": "check", "note": "FMC の着陸高度：LANDING ALT なし", "dref": "laminar/B747/CAS/advisory_status[240]", "op": "==", "value": 0 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/K" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/F" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/O" },
    { "do": "cmd", "note": "ORIGIN KSFO（L1。出発地から 400 NM 超）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/T" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/T" },
    { "do": "cmd", "note": "DEST RJTT（R1。出発地を変えると FMC が目的地を消す）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "出発地から 400 NM 超：目的地 RJTT の標高 21 ft（FCOM p.1400）", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 21 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/R" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/J" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "note": "ORIGIN RJAA に戻す（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "下の EICAS に ENG ページ：data block（FCOM p.585）", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "set", "note": "下の EICAS の synoptic を消す", "dref": "laminar/B747/dsp/synoptic_display", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "data block は出ない（MAN でなく、警報も synoptic もない）", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 0 },

    { "do": "switch", "note": "LDG ALT を押して MAN", "dref": "laminar/B747/air/landing_alt/button_pos", "value": 0, "cmd": "laminar/B747/air/landing_alt/button" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAN は AUTO の値の 50 ft 刻みから（推定）", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 150 },
    { "do": "check", "note": "MAN：LANDING ALT（FCOM p.620）", "dref": "laminar/B747/CAS/advisory_status[240]", "op": "==", "value": 1 },
    { "do": "check", "note": "MAN：data block（FCOM p.585）", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "check", "note": "ノブの dataref は端から離してある（1 周 360 の倍数で戻す）", "dref": "laminar/B747/air/land_alt_sel/rheostat", "op": "==", "value": 1800 },
    { "do": "set", "note": "ノブを 4 段回す", "dref": "laminar/B747/air/land_alt_sel/rheostat", "value": 1804 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "4 段で 200 ft（50 ft 刻み、FCOM p.573）", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 350 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_ldg_alt_man" },
    { "do": "switch", "note": "LDG ALT を押して AUTO", "dref": "laminar/B747/air/landing_alt/button_pos", "value": 1, "cmd": "laminar/B747/air/landing_alt/button" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "AUTO：FMC の値に戻る", "dref": "laminar/B747/air/landing_altitude", "op": "==", "value": 135 },

    { "do": "switch", "note": "MAN L", "dref": "laminar/B747/button_switch/position[34]", "value": 1, "cmd": "laminar/B747/button_switch/press_outflow_vlv_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAN L：OUTFLOW VLV L（FCOM p.620）", "dref": "laminar/B747/CAS/advisory_status[249]", "op": "==", "value": 1 },
    { "do": "check", "note": "MAN L だけでは CABIN ALT AUTO は出ない（FCOM p.619）", "dref": "laminar/B747/CAS/caution_status[10]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "CLOSE を 4 秒押す", "name": "laminar/B747/toggle_switch/outflow_valve_close", "duration": 4 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "左の弁だけが閉じる方へ（DC モーター、全行程 20 秒：推定）", "dref": "laminar/B747/air/outflow_valve_left/pos", "op": "between", "value": [-0.2, 0.8] },
