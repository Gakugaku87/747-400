    { "do": "shot", "name": "outflow_gauges_man_l" },
    { "do": "switch", "note": "MAN R も", "dref": "laminar/B747/button_switch/position[35]", "value": 1, "cmd": "laminar/B747/button_switch/press_outflow_vlv_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両方 MAN：CABIN ALT AUTO（FCOM p.619）", "dref": "laminar/B747/CAS/caution_status[10]", "op": "==", "value": 1 },
    { "do": "cas", "note": "両方 MAN" },
    { "do": "switch", "note": "MAN R を戻す", "dref": "laminar/B747/button_switch/position[35]", "value": 0, "cmd": "laminar/B747/button_switch/press_outflow_vlv_R" },
    { "do": "switch", "note": "MAN L を戻す", "dref": "laminar/B747/button_switch/position[34]", "value": 0, "cmd": "laminar/B747/button_switch/press_outflow_vlv_L" },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "自動に戻ると全開（地上）", "dref": "laminar/B747/air/outflow_valve_left/pos", "op": "==", "value": 1 },
    { "do": "check", "note": "OUTFLOW VLV L は消える", "dref": "laminar/B747/CAS/advisory_status[249]", "op": "==", "value": 0 },

    { "do": "switch", "note": "PACK 1 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
