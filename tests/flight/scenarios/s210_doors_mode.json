{
  "name": "s210_doors_mode",
  "description": "ドアの 7-3（notes/ATA-52.md §11、軽く）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。entry と上階のドアが AUTOMATIC（ARMED）で始まり DOORS AUTO の memo が出ること。CDU の MENU → GND HANDLING（R4）→ DOORS（L4）の L4 で全部 DISARM にすると DOORS MANUAL、もう一度 L4 で ARM にすると DOORS AUTO、1 枚だけ MANUAL にすると DOORS AUTO/MAN（ATA38_51_52_56 p.304。E&M の構成）。DOORS ページを撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "エンジン運転中の開始：ドアは AUTOMATIC（L1）", "dref": "laminar/B747/door/mode[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "上階 R も AUTOMATIC", "dref": "laminar/B747/door/mode[11]", "op": "==", "value": 1 },
    { "do": "check", "note": "DOORS AUTO の memo", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 1, "cite": "ATA38_51_52_56 p.304" },
    { "do": "cas", "note": "EICAS の表示（DOORS AUTO）" },
    { "do": "cdu", "note": "MENU → GND HANDLING → DOORS", "keys": ["MENU", "R4", "L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "DOORS ページの L4 は <DISARM", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "<DISARM" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_doors_armed" },
    { "do": "cdu", "note": "L4：全部 DISARM", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "L1 は MANUAL", "dref": "laminar/B747/door/mode[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "DOORS MANUAL の memo（地上）", "dref": "laminar/B747/CAS/memo_status[11]", "op": "==", "value": 1, "cite": "ATA38_51_52_56 p.304" },
    { "do": "check", "note": "DOORS AUTO は消える", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 0 },
    { "do": "check", "note": "DOORS ページの L4 は <ARM", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "<ARM" },
    { "do": "shot", "name": "cdu_doors_disarmed" },
    { "do": "cas", "note": "EICAS の表示（DOORS MANUAL）" },
    { "do": "cdu", "note": "L4：全部 ARM", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "DOORS AUTO に戻る", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 1 },
    { "do": "set", "note": "L3 だけ MANUAL（3D にレバーが無いので dataref で）", "dref": "laminar/B747/door/mode[2]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "DOORS AUTO/MAN の memo", "dref": "laminar/B747/CAS/memo_status[10]", "op": "==", "value": 1, "cite": "ATA38_51_52_56 p.304" },
    { "do": "check", "note": "DOORS AUTO は消える", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 0 },
    { "do": "cas", "note": "EICAS の表示（DOORS AUTO/MAN）" },
    { "do": "cdu", "note": "L4：全部 ARM に戻す", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "DOORS AUTO", "dref": "laminar/B747/CAS/memo_status[9]", "op": "==", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
