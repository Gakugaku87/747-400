{
  "name": "s91_lnav_sid",
  "description": "SID の条件の脚を LNAV で（6-1・6-2 段 6c）の X-Plane での確認、空中。RJAA 34L の SAKUR5 の最初の脚（CF 337 で D337F へ）の上、D337F の 3 nm 手前、3,000 ft、240 kt で開始（機体を読み直す）。RTE で RJAA→RJBB、DEPARTURES で SAKUR5 と 34L、空中で ACTIVATE と EXEC、LNAV。D337F を真上で過ぎ（fly-over）、右回りでヘディング 100 へ（手続きの旋回の向き）、NRE の radial 001 と 036 を越えて順送り（FCOM p.1249）、ヘディング 160 で NRE への 283 のコースに切込み（123° の旋回）、NRE、TETRA。経路の終わりを過ぎるとヘディングを保持し END OF ROUTE（FCOM p.1431）。ND と CDU を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.82578, "longitude": 140.33183, "elevation_in_meters": 914, "heading_true": 330, "speed_in_meters_per_second": 123.5 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 速度 240 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 240 },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 337（CF の方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "mark", "note": "経路：RJAA→RJBB、DEPARTURES で SAKUR5 と 34L" },
    { "do": "cdu", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "DEPARR", "L1", "NEXT"] },
    { "do": "check", "note": "SID の 2 ページ目の 3 行目 SAKUR5", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "SAKUR5" },
    { "do": "cdu", "keys": ["L3"] },
    { "do": "check", "note": "SAKUR5<SEL>", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SAKUR5<SEL>" },
    { "do": "check", "note": "34L が 2 行目", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "34L" },
    { "do": "cdu", "keys": ["R2"] },
    { "do": "check", "note": "<SEL>34L", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<SEL>34L" },
    { "do": "cdu", "keys": ["LEGS"] },
    { "do": "check", "note": "最初の点 D337F", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "D337F" },
    { "do": "check", "note": "次は NRE001（radial 001 まで）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "NRE001" },
    { "do": "cdu", "keys": ["R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 LEGS" },

    { "do": "mark", "note": "LNAV：CF で D337F へ" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "脚の上：すぐ engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 20 },
    { "do": "wait", "note": "D337F を真上で過ぎて（fly-over）NRE001 へ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "NRE001", "timeout": 120 },
    { "do": "check", "note": "ヘディングの脚（mode 2）", "dref": "laminar/B747/fms/lnav/mode", "op": "==", "value": 2 },
    { "do": "wait", "note": "右へ回り始める（手続きの R）", "dref": "sim/flightmodel/position/phi", "op": ">", "value": 10, "timeout": 15 },
    { "do": "wait", "note": "ヘディング 100（磁）", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [97, 103], "timeout": 120 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 8, "fov": 20 },
    { "do": "shot", "name": "nd_heading_100" },
    { "do": "wait", "note": "NRE の radial 001 と 036 を越えて (INTC) へ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "(INTC)", "timeout": 300 },
    { "do": "wait", "note": "ヘディング 160（磁）", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [157, 163], "timeout": 90 },
    { "do": "wait", "note": "NRE への 283 のコースへの旋回を始める所で順送り", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "NRE                     ", "timeout": 300 },
    { "do": "watch", "note": "123° の旋回でコースに乗る：旋回はコースの右（北）約 3.2 nm で始まり（その角の旋回の始まり：推定）、左への行き過ぎ 1 nm 未満。NRE を経て TETRA へ", "dref": "laminar/B747/fms/lnav/xtk", "min": -1.0, "max": 3.5, "until": { "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "TETRA" }, "timeout": 300 },
    { "do": "check", "note": "TETRA への脚の上", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.3, 0.3] },

    { "do": "mark", "note": "TETRA（経路の最後の点）を過ぎる" },
    { "do": "wait", "note": "経路の終わり：ヘディングを保持（mode 3：FCOM p.644）", "dref": "laminar/B747/fms/lnav/mode", "op": "==", "value": 3, "timeout": 200 },
    { "do": "check", "note": "CDU に END OF ROUTE（FCOM p.1431）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "END OF ROUTE" },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg" },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "ヘディングが変わらない", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [-2, 2], "rel": "hdg" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_end_of_route" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
