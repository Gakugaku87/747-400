{
  "name": "s56_pfd_pli",
  "description": "PFD のピッチ制限表示（PLI、5-2 段 4c、パネルの変更）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・200 kt で開始（機体を読み直す）。フラップ 20 で A/P の ALT HOLD のまま、PLI はシェーカーまでの迎角の余裕だけ飛行機の記号の上に出る（FCOM p.975：シェーカーの点、109 はフラップが上がっていないとき）。A/T を切ってアイドルで減速すると下りてきて、シェーカーで飛行機の記号に重なる。フラップを上げると消える。機長の PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "check", "note": "フラップ上げ：PLI なし（109）", "dref": "laminar/B747/pfd/pli_show", "op": "==", "value": 0 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "wait", "note": "フラップ 20", "dref": "sim/flightmodel2/wing/flap1_deg[0]", "op": ">", "value": 19.5, "timeout": 90 },
    { "do": "wait", "note": "水平飛行", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 60 },
    { "do": "sleep", "seconds": 20, "note": "フラップを出した後の揺れが収まるのを待つ" },
    { "do": "snapshot", "note": "フラップ 20・約 200 kt", "drefs": [ "laminar/B747/pfd/pli", "laminar/B747/pfd/pli_show", "laminar/B747/airspeed/Vs", "laminar/B747/gauges/indicators/airspeed_kts_pilot",
      "sim/flightmodel/position/alpha", "sim/flightmodel/position/theta", "sim/flightmodel/forces/g_nrml", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "PLI が出る", "dref": "laminar/B747/pfd/pli_show", "op": "==", "value": 1 },
    { "do": "check", "note": "シェーカー（約 138 kt）まで約 1.45 倍：飛行機の記号の 8〜14° 上", "dref": "laminar/B747/pfd/pli", "op": "between", "value": [8, 14] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_pli_200kt" },
    { "do": "cmd", "note": "A/T OFF", "name": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "アイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "減速：PLI が 4° まで下りる", "dref": "laminar/B747/pfd/pli", "op": "<", "value": 4, "timeout": 90 },
    { "do": "shot", "name": "pfd_pli_4deg" },
    { "do": "wait", "note": "シェーカー", "dref": "sim/flightmodel/failures/stallwarning", "op": "==", "value": 1, "timeout": 90 },
    { "do": "snapshot", "note": "シェーカーのとき", "drefs": [ "laminar/B747/pfd/pli", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/airspeed/Vs", "sim/flightmodel/position/alpha", "sim/flightmodel/forces/g_nrml" ] },
    { "do": "check", "note": "シェーカーで PLI は飛行機の記号に重なる（±1.5°：PLI は 3 秒でならした荷重倍数、シェーカーは 0.2 秒）", "dref": "laminar/B747/pfd/pli", "op": "between", "value": [-1.5, 1.5] },
    { "do": "shot", "name": "pfd_pli_shaker" },
    { "do": "set", "note": "回復：推力", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "シェーカーが止まる", "dref": "sim/flightmodel/failures/stallwarning", "op": "==", "value": 0, "timeout": 30 },
    { "do": "set", "note": "レバー UP", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0 },
    { "do": "wait", "note": "フラップ上げで PLI が消える（109）", "dref": "laminar/B747/pfd/pli_show", "op": "==", "value": 0, "timeout": 120 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
