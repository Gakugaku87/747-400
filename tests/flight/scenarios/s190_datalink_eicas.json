{
  "name": "s190_datalink_eicas",
  "description": "6-1・6-2 段 12d1（データリンクの EICAS の表示）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。この PC の X-Plane には AutoATC が無いので、ACARS はつながらない側だけ：中央の RTP が ON でも、FCOM に無い ACARS NO COMM のメモは出ない（前は出ていた）、一度もつながっていないので >DATALINK LOST も出ない、未読のメッセージが無いので ACARS MESSAGE も ATC MESSAGE（新しい memo_status[46]）も出ない。上の EICAS を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "中央の RTP は ON（前のコードなら ACARS NO COMM が出た条件）", "dref": "laminar/B747/comm/rtp_C/off_status", "op": "==", "value": 0 },
    { "do": "check", "note": "ACARS NO COMM のメモは出ない（FCOM p.776 に無い）", "dref": "laminar/B747/CAS/memo_status[40]", "op": "==", "value": 0 },
    { "do": "check", "note": ">DATALINK LOST は出ない（一度もつながっていない）", "dref": "laminar/B747/CAS/advisory_status[56]", "op": "==", "value": 0 },
    { "do": "check", "note": ">DATALINK AVAIL も出ない", "dref": "laminar/B747/CAS/advisory_status[55]", "op": "==", "value": 0 },
    { "do": "check", "note": "ACARS MESSAGE は出ない（未読なし）", "dref": "laminar/B747/CAS/memo_status[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "ATC MESSAGE（新しい 46）は出ない", "dref": "laminar/B747/CAS/memo_status[46]", "op": "==", "value": 0 },
    { "do": "check", "note": "ATC のチャイムは 0", "dref": "laminar/B747/fms/atc_chime", "op": "==", "value": 0 },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_no_acars_no_comm" },
    { "do": "view", "name": "forward" }
  ]
}
