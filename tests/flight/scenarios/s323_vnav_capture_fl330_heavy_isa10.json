    { "do": "watch", "note": "VNAV PTH の後 120 秒、33,100 ft を超えない（行き過ぎ 100 ft まで：推定。下限は見ない：捕捉は高度の手前から始まる。2026-11-13 の s322 は捕捉の瞬間からの下限で落ちた）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 33100, "timeout": 120 },
    { "do": "check", "note": "120 秒後に 33,000 ft の −50〜+100 ft（下がり 50 ft まで：推定）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [32950, 33100] },
