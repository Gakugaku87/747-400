{
  "name": "s301_start_messages",
  "description": "地上の >ENG n SHUTDOWN と始動中の EICAS（2026-11-12 のフルレビュー SF-3・SF-4：REVIEW_2026-11-12.md 案 17）の X-Plane での確認。RJAA 34L の地上（機体を読み直す、270 t、4 発運転中）。PACK を切り、AUTOSTART ON。FUEL CONTROL 4 を CUTOFF にしてエンジン 4 を止める：>ENG 4 SHUTDOWN が出る（caution、master CAUTION なし：FCOM p.902・p.1586、ATA70_80 p.230。前は地上では出さなかった）。START 4 を引き、FUEL CONTROL 4 を RUN：3 秒後・15 秒後に ELEC GEN OFF 4 が出ない（FCOM p.1587：START からアイドルまで新しい caution・advisory は出さない。前は始動前に隠れていたものが RUN で約 30 秒出た）。アイドルの後、>ENG 4 SHUTDOWN も ELEC GEN OFF 4 も消える",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "読み込みの後" },
    { "do": "switch", "note": "PACK 1 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0, "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0, "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0, "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "switch", "note": "AUTOSTART ON", "dref": "laminar/B747/button_switch/position[45]", "value": 1, "cmd": "laminar/B747/button_switch/start_autostart" },
    { "do": "cas", "note": "4 発運転中", "lacks": [ "SHUTDOWN" ] },
    { "do": "snapshot", "note": "読み込みの後の電源（2026-11-13 の 1 回目は >STBY BUS MAIN・APU などの advisory が出ていた）", "drefs": [ "laminar/B747/electrical/standby_power/sel_dial_pos", "laminar/B747/electrical/bus/stby_main", "laminar/B747/electrical/bus/stby_apu", "sim/operation/prefs/startup_running", "laminar/B747/warning/master_caution" ] },
    { "do": "cmd", "note": "master リセット（始めからある FUEL PRESS CTR L・R の caution で点いた灯を消す。2026-11-13 の 1 回目は、この灯で下の検査が落ちた）", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "master CAUTION が消えた", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 0, "stop": true },
    { "do": "mark", "note": "FUEL CONTROL 4 CUTOFF" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "N2 4 が 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180, "stop": true },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": ">ENG 4 SHUTDOWN が立つ（地上・CUTOFF：FCOM p.1586、ATA70_80 p.230。前は地上では立たない）", "dref": "laminar/B747/CAS/caution_status[26]", "op": "==", "value": 1 },
    { "do": "cas", "note": "エンジン 4 が止まった地上：>ENG 4 SHUTDOWN が出る", "has": [ ">ENG 4 SHUTDOWN" ] },
    { "do": "check", "note": "master CAUTION は点かない（FCOM p.902）", "dref": "laminar/B747/warning/master_caution", "op": "==", "value": 0 },
    { "do": "mark", "note": "エンジン 4 の始動" },
    { "do": "switch", "note": "START 4", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "sleep", "seconds": 2 },
    { "do": "cas", "note": "START 4 を引いた" },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "sleep", "seconds": 3 },
    { "do": "cas", "note": "RUN の 3 秒後：ELEC GEN OFF 4 は出ない（FCOM p.1587。前は RUN から約 30 秒出た）", "lacks": [ "ELEC GEN OFF 4" ] },
    { "do": "snapshot", "note": "RUN の 3 秒後", "drefs": [ "sim/flightmodel/engine/ENGN_N2_[3]", "laminar/B747/CAS/caution_status[26]", "laminar/B747/warning/master_caution" ] },
    { "do": "sleep", "seconds": 12 },
    { "do": "cas", "note": "RUN の 15 秒後：ELEC GEN OFF 4 は出ない", "lacks": [ "ELEC GEN OFF 4" ] },
    { "do": "wait", "note": "アイドル（N2 60 %）", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 60, "timeout": 120, "stop": true },
    { "do": "sleep", "seconds": 15 },
    { "do": "cas", "note": "アイドルの 15 秒後：>ENG 4 SHUTDOWN も ELEC GEN OFF 4 も無い", "lacks": [ ">ENG 4 SHUTDOWN", "ELEC GEN OFF 4" ] }
  ]
}
