{
  "name": "s426_cold_panel_signs",
  "description": "負の温度の負号（2026-11-24、段 4 のレビューの PNL-8・SYS-5：カスタム acf のパネルの LED は絶対値を出すので、STAT と HYD synoptic の作動油の温度、ECS synoptic のゾーンと貨物室の温度に、燃料温度と同じ TAT_negSign の負号を足した）の X-Plane での確認。RJAA 34L の寒い朝（天気の定義の海面 -25 ℃）にエンジン停止で始め（機体を読み直す、270 t）、電池・STANDBY POWER・地上電源（GPU）で電気を入れ、デマンドポンプを OFF（作動油は温まらない）。作動油の基準は燃料の温度（PNL-8 の直し：始めの TAT）、客室と貨物室は駐機中は外の温度から始まる（B747.55.temp_model.lua）ので、どれも負。STAT・HYD・ECS の画面を撮り、数字の左に負号が出て、数字と重ならないかを写真で見る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": false } },
    "local_time": { "day_of_year": 15, "time_in_24_hours": 6.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0]
    },
    "weather": {
      "definition": {
        "latitude_in_degrees": 35.76,
        "longitude_in_degrees": 140.39,
        "elevation_in_meters": 0,
        "visibility_in_kilometers": 40,
        "temperature_in_degrees_celsius": -25,
        "altimeter_setting_in_hpa": 1013.25,
        "precipitation_ratio": 0,
        "clouds": [],
        "wind": [
          {"altitude_in_feet_msl": 0, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 10000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0}
        ]
      },
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "外は氷点下", "dref": "sim/cockpit2/temperature/outside_air_temp_degc", "op": "<", "value": -10, "stop": true },
    { "do": "switch", "note": "BATTERY ON", "dref": "laminar/B747/button_switch/position[13]", "value": 1, "cmd": "laminar/B747/button_switch/elec_battery" },
    { "do": "switch", "note": "STANDBY POWER AUTO",
      "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "sleep", "seconds": 3 },
    { "do": "switch", "note": "DEMAND 1 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[0]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_up", "cmd_down": "laminar/B747/hydraulics/sel_dial/dmd_pump_01_dn" },
    { "do": "switch", "note": "DEMAND 2 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[1]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_02_up", "cmd_down": "laminar/B747/hydraulics/sel_dial/dmd_pump_02_dn" },
    { "do": "switch", "note": "DEMAND 3 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[2]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_03_up", "cmd_down": "laminar/B747/hydraulics/sel_dial/dmd_pump_03_dn" },
    { "do": "switch", "note": "DEMAND 4 OFF", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[3]", "value": 0, "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_04_up", "cmd_down": "laminar/B747/hydraulics/sel_dial/dmd_pump_04_dn" },
    { "do": "cmd", "note": "地上電源（GPU）", "name": "laminar/B747/electrical/connect_power" },
    { "do": "wait", "note": "EXT PWR 1 AVAIL", "dref": "laminar/B747/electrical/ext_pwr1_avail", "op": "==", "value": 1, "timeout": 240 },
    { "do": "cmd", "note": "EXT PWR 1 を押す", "name": "laminar/B747/button_switch/elec_ext_pwr_1", "duration": 0.3 },
    { "do": "cmd", "note": "EXT PWR 2 を押す", "name": "laminar/B747/button_switch/elec_ext_pwr_2", "duration": 0.3 },
    { "do": "wait", "note": "AC bus 1 に電気", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "sleep", "seconds": 15, "note": "EIU と表示が立ち上がる" },
    { "do": "snapshot", "note": "温度", "drefs": [ "sim/cockpit2/temperature/outside_air_temp_degc", "laminar/B747/fuel/temperature", "laminar/B747/hydraulics/temp_1", "laminar/B747/hydraulics/temp_2", "laminar/B747/hydraulics/temp_3", "laminar/B747/hydraulics/temp_4", "laminar/B747/air/temp/zone_actual[0]", "laminar/B747/air/temp/zone_actual[2]", "laminar/B747/air/temp/zone_actual[6]", "laminar/B747/air/temp/cargo[0]", "laminar/B747/air/temp/cargo[1]", "sim/cockpit2/electrical/APU_EGT_c" ] },
    { "do": "check", "note": "作動油は負（写真の前提。基準へ 600 秒の遅れで下がる途中で、まだ 1 桁）", "dref": "laminar/B747/hydraulics/temp_1", "op": "<", "value": -0.5 },
    { "do": "check", "note": "ゾーンも負", "dref": "laminar/B747/air/temp/zone_actual[2]", "op": "<", "value": -5 },
    { "do": "check", "note": "貨物室も負", "dref": "laminar/B747/air/temp/cargo[1]", "op": "<", "value": -5 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "STAT", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "下段 EICAS", "the": -32, "psi": 33, "fov": 14 },
    { "do": "shot", "name": "stat_cold" },
    { "do": "cmd", "note": "HYD の synoptic", "name": "laminar/B747/dsp/hyd_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "hyd_cold" },
    { "do": "cmd", "note": "ECS の synoptic", "name": "laminar/B747/dsp/ecs_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "ecs_cold" },
    { "do": "cmd", "note": "STAT（作動油は 1 桁の負。APU の EGT の負号は 2026-11-24 に試して出ず、外した）", "name": "laminar/B747/dsp/stat_switch", "duration": 0.2 },
    { "do": "wait", "note": "作動油が 2 桁の負になる（-10 ℃ の下。600 秒の遅れで約 6 分）", "dref": "laminar/B747/hydraulics/temp_1", "op": "<", "value": -10, "timeout": 600 },
    { "do": "snapshot", "note": "2 桁の負", "drefs": [ "laminar/B747/hydraulics/temp_1", "laminar/B747/hydraulics/temp_2", "laminar/B747/hydraulics/temp_3", "laminar/B747/hydraulics/temp_4", "sim/cockpit2/electrical/APU_EGT_c" ] },
    { "do": "shot", "name": "stat_cold_2digits" },
    { "do": "cmd", "note": "HYD の synoptic", "name": "laminar/B747/dsp/hyd_switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "hyd_cold_2digits" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "cas", "note": "終わり" }
  ]
}
