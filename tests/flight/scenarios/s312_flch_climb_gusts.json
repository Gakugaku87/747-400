    { "do": "snapshot", "note": "上昇の途中", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/weather/aircraft/shear_speed_kts[0]", "sim/weather/aircraft/turbulence[0]", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
