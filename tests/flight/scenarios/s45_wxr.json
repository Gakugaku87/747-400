{
  "name": "s45_wxr",
  "description": "気象レーダー（5-1 段 5c）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt、対流性の天気で開始（機体を読み直す）。EFIS の WXR で R/T が入り、570 型のパネル：WX・WX+T（40 nm より大きいと WX）・MAP（MAP GAIN）とゲインの自動、チルト、GCS、TFR（反対側の表示、両側で TEST）、TEST、LR/T・RR/T。R/T の電源（推定）と X-Plane の故障、安定化の IRU。ND の注記（WXR・WX+T・MAP・TEST、チルトは整数、PLN では出さない）。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "convective",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007（磁方位で真北）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "機長の ND を MAP 40 nm", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "note": "副操縦士の ND を MAP 40 nm", "dref": "laminar/B747/nd/mode/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "sim/cockpit2/EFIS/EFIS_weather_on", "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "sim/cockpit2/EFIS/EFIS_weather_mode", "sim/cockpit2/EFIS/EFIS_weather_mode_copilot",
      "sim/cockpit2/EFIS/EFIS_weather_tilt", "sim/cockpit2/EFIS/EFIS_weather_gain", "sim/cockpit2/EFIS/EFIS_weather_sector_width", "laminar/B747/irs/att_valid", "laminar/B747/electrical/bus/ac" ] },
    { "do": "check", "note": "アンテナの走査は左右 90°（ATA34_1 p.231）", "dref": "sim/cockpit2/EFIS/EFIS_weather_sector_width", "op": "==", "value": 90 },

    { "do": "mark", "note": "R/T off and on" },
    { "do": "set", "note": "両 EFIS の WXR を切る（X-Plane の weather on）", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "value": 0 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WXR なし：R/T は切れ、X-Plane のレーダーなし（FCOM p.1040）", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "パネルの灯なし（パネルは R/T から給電：ATA34_1 p.210）", "dref": "laminar/B747/wxr/lamp/rt", "op": "==", "value": 0 },
    { "do": "cmd", "note": "機長の EFIS の WXR", "name": "laminar/B747/nd/wxr/capt/switch", "duration": 0.2 },
    { "do": "cmd", "note": "副操縦士の EFIS の WXR", "name": "laminar/B747/nd/wxr/fo/switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の WXR が入る", "dref": "sim/cockpit2/EFIS/EFIS_weather_on", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の WXR が入る", "dref": "sim/cockpit2/EFIS/EFIS_weather_on_copilot", "op": "==", "value": 1 },
    { "do": "check", "note": "LR/T の灯（L の R/T）", "dref": "laminar/B747/wxr/lamp/rt", "op": "==", "value": 1 },
    { "do": "cmd", "note": "機長の WX", "name": "sim/instruments/EFIS_wxr_radar_wx" },
    { "do": "cmd", "note": "副操縦士の WX", "name": "sim/instruments/EFIS_wxr_radar_wx_copilot" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X-Plane のレーダー WX（機長）", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "副操縦士も WX", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode_copilot", "op": "==", "value": 2 },
    { "do": "check", "note": "WX の灯", "dref": "laminar/B747/wxr/lamp/sel[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "ゲインは較正値（WX は自動：FCOM p.1223）", "dref": "sim/cockpit2/EFIS/EFIS_weather_gain", "op": "between", "value": [0.999, 1.001] },
    { "do": "check", "note": "安定化（IRU L）", "dref": "sim/cockpit2/EFIS/EFIS_weather_stab", "op": "==", "value": 1 },
    { "do": "check", "note": "ND の注記 WXR（FCOM p.1155）", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WXR" },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_wx" },

    { "do": "mark", "note": "tilt" },
    { "do": "remember", "dref": "sim/cockpit2/EFIS/EFIS_weather_tilt", "as": "tilt0" },
    { "do": "cmd", "note": "チルトを上げる（10 回）", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_tilt_up" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "1° 上がる（0.1° ずつ）", "dref": "sim/cockpit2/EFIS/EFIS_weather_tilt", "op": "between", "value": [0.99, 1.01], "rel": "tilt0" },
    { "do": "snapshot", "note": "ND のチルトの注記（整数、+ 付き）", "drefs": [ "laminar/B747/nd/capt/text/tilt", "sim/cockpit2/EFIS/EFIS_weather_tilt", "laminar/B747/nd/fo/text/tilt", "sim/cockpit2/EFIS/EFIS_weather_tilt_copilot" ] },

    { "do": "mark", "note": "WX+T and 40 nm" },
    { "do": "cmd", "note": "機長の WX+T", "name": "sim/instruments/EFIS_wxr_radar_wxt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WX+T（40 nm）", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "ND の注記 WX+T", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WX+T" },
    { "do": "set", "note": "機長の ND を 80 nm", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 3 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "40 nm より大きいと WX（FCOM p.1224）", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "WX の灯に変わる", "dref": "laminar/B747/wxr/lamp/sel[0]", "op": "==", "value": 1 },
    { "do": "set", "note": "40 nm に戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WX のまま", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 2 },

    { "do": "mark", "note": "MAP and gain" },
    { "do": "cmd", "note": "機長の MAP", "name": "sim/instruments/EFIS_wxr_radar_map" },
    { "do": "cmd", "note": "MAP GAIN を 3 つ下げる", "name": "sim/instruments/EFIS_wxr_gain_down" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_gain_down" },
    { "do": "cmd", "name": "sim/instruments/EFIS_wxr_gain_down" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAP", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "MAP は MAP GAIN のつまみ（0.7）", "dref": "sim/cockpit2/EFIS/EFIS_weather_gain", "op": "between", "value": [0.69, 0.71] },
    { "do": "check", "note": "ND の注記 MAP", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "MAP" },
    { "do": "shot", "name": "nd_map" },
    { "do": "cmd", "note": "WX に戻す", "name": "sim/instruments/EFIS_wxr_radar_wx" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "WX はゲインが自動（較正値）", "dref": "sim/cockpit2/EFIS/EFIS_weather_gain", "op": "between", "value": [0.999, 1.001] },
    { "do": "cmd", "note": "GCS（機長）", "name": "sim/instruments/EFIS_wxr_gcs_tog" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "GCS が入る", "dref": "sim/cockpit2/EFIS/EFIS_weather_gcs", "op": "==", "value": 1 },
    { "do": "check", "note": "GCS の灯", "dref": "laminar/B747/wxr/lamp/gcs[0]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "GCS を戻す", "name": "sim/instruments/EFIS_wxr_gcs_tog" },

    { "do": "mark", "note": "TFR" },
    { "do": "cmd", "note": "副操縦士の MAP", "name": "sim/instruments/EFIS_wxr_radar_map_copilot" },
    { "do": "cmd", "note": "機長の TFR", "name": "laminar/B747/wxr/buttons/cpt_ftr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の ND に副操縦士の表示（MAP：FCOM p.1223）", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "TFR の灯", "dref": "laminar/B747/wxr/lamp/sel[0]", "op": "==", "value": 4 },
    { "do": "check", "note": "ND の注記は副操縦士の表示の MAP", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "MAP" },
    { "do": "cmd", "note": "副操縦士の TFR（両側で TFR）", "name": "laminar/B747/wxr/buttons/fo_ftr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両側の TFR は TEST", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の ND も TEST", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode_copilot", "op": "==", "value": 1 },
    { "do": "check", "note": "TEST の灯", "dref": "laminar/B747/wxr/lamp/test", "op": "==", "value": 1 },
    { "do": "check", "note": "ND の注記 TEST", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "TEST" },
    { "do": "check", "note": "TEST ではチルトの欄を空ける（故障の原因の欄：FCOM p.1224）", "dref": "laminar/B747/nd/capt/text/tilt", "op": "==", "value": " " },
    { "do": "shot", "name": "nd_test" },
    { "do": "cmd", "note": "機長の WX", "name": "sim/instruments/EFIS_wxr_radar_wx" },
    { "do": "cmd", "note": "副操縦士の WX", "name": "sim/instruments/EFIS_wxr_radar_wx_copilot" },

    { "do": "mark", "note": "TEST switch" },
    { "do": "cmd", "note": "TEST", "name": "laminar/B747/wxr/buttons/test" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両 ND を TEST に（FCOM p.1224）", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士も TEST", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode_copilot", "op": "==", "value": 1 },
    { "do": "cmd", "note": "機長の WX+T", "name": "sim/instruments/EFIS_wxr_radar_wxt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "モードを選ぶとその側の TEST が終わる", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 3 },
    { "do": "check", "note": "副操縦士の ND は TEST のまま", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode_copilot", "op": "==", "value": 1 },
    { "do": "cmd", "note": "副操縦士の WX", "name": "sim/instruments/EFIS_wxr_radar_wx_copilot" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "副操縦士の ND も戻る", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode_copilot", "op": "==", "value": 2 },

    { "do": "mark", "note": "R/T and stabilization" },
    { "do": "cmd", "note": "RR/T", "name": "laminar/B747/wxr/buttons/rr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "RR/T の灯", "dref": "laminar/B747/wxr/lamp/rt", "op": "==", "value": 2 },
    { "do": "check", "note": "R の R/T で動く", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 3 },
    { "do": "set", "note": "副操縦士の IRS 選択を C に", "dref": "laminar/B747/flt_inst/irs_src/fo/sel_dial_pos", "value": 1 },
    { "do": "set", "note": "IRU C の故障", "dref": "laminar/B747/irs/fail/iru[1]", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "R の R/T の姿勢は IRU C（ATA34_1 p.242）：故障で安定化なし", "dref": "sim/cockpit2/EFIS/EFIS_weather_stab", "op": "==", "value": 0 },
    { "do": "set", "note": "副操縦士の IRS 選択を R に戻す", "dref": "laminar/B747/flt_inst/irs_src/fo/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "IRU R で安定化", "dref": "sim/cockpit2/EFIS/EFIS_weather_stab", "op": "==", "value": 1 },
    { "do": "set", "dref": "laminar/B747/irs/fail/iru[1]", "value": 0 },
    { "do": "set", "note": "X-Plane のレーダーの故障", "dref": "sim/operation/failures/rel_wxr_radar", "value": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障でレーダーなし", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "ND の注記なし（前は RT）", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": " " },
    { "do": "set", "dref": "sim/operation/failures/rel_wxr_radar", "value": 0 },
    { "do": "cmd", "note": "LR/T", "name": "laminar/B747/wxr/buttons/lr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "レーダーが戻る", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 3 },

    { "do": "mark", "note": "ND modes" },
    { "do": "set", "note": "機長の ND を PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PLN では注記を出さない（FCOM p.1155）", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": " " },
    { "do": "set", "note": "MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "MAP で WX+T", "dref": "laminar/B747/nd/capt/text/wxr", "op": "==", "value": "WX+T" },
    { "do": "cmd", "note": "両 EFIS の WXR を切る", "name": "laminar/B747/nd/wxr/capt/switch", "duration": 0.2 },
    { "do": "cmd", "name": "laminar/B747/nd/wxr/fo/switch", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "R/T が切れる", "dref": "sim/cockpit2/EFIS/EFIS_weather_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "パネルの灯が消える", "dref": "laminar/B747/wxr/lamp/rt", "op": "==", "value": 0 }
  ]
}
