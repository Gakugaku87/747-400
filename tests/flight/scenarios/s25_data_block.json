{
  "name": "s25_data_block",
  "description": "主 EICAS の ECS data block（AIR-18。カスタム acf のパネルの変更、2026-10-24 利用者の承認）の X-Plane での確認、巡航。FL350 の空中で開始し、下の EICAS に ECS synoptic を出して data block を表示させる（FCOM p.585）。LDG ALT の数字は、外流弁を両方 MAN にしたときと、両 CPC が故障したとき（air/fail/cpc）に消え、AUTO の字は残る（FCOM p.586）。客室高度の赤（10,000 ft 以上）は 5 桁で、先頭の桁が欠けない（前は 4 桁で、28,575 ft が 8575 と出た）。白と琥珀は 4 桁のまま。赤の 5 桁の字の下に、次の行の字の上端がにじんで線にならないこと（1 回目の試験で白と琥珀を純正の 5 桁のフォントにしたら出た）も写真で見る。パックを全部 OFF にして客室を上げ（漏れ、推定）、8,500 ft 超で琥珀、10,000 ft 超で赤を撮り、最後に X-Plane の急減圧の故障で 2 万 ft 台の赤を撮る。色の範囲は ATA21 p.451。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 254 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "wait", "note": "水平になる", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 180 },
    { "do": "sleep", "seconds": 60, "note": "与圧が落ち着くのを待つ（s15 と同じ）" },
    { "do": "set", "note": "下の EICAS に ECS synoptic（data block が出る：FCOM p.585）", "dref": "laminar/B747/dsp/synoptic_display", "value": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "巡航", "drefs": [
      "sim/aircraft/view/acf_relative_path", "sim/cockpit2/gauges/indicators/altitude_ft_pilot",
      "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/pressure_diffential_psi",
      "laminar/B747/air/landing_altitude", "laminar/B747/air/press/ldg_alt_shown", "laminar/B747/air/press/cpc",
      "laminar/B747/air/pressurization/EICAS1_display_status" ] },
    { "do": "check", "note": "data block を出す", "dref": "laminar/B747/air/pressurization/EICAS1_display_status", "op": "==", "value": 1 },
    { "do": "check", "note": "LDG ALT を出す", "dref": "laminar/B747/air/press/ldg_alt_shown", "op": "==", "value": 1 },
    { "do": "check", "note": "巡航の客室高度は白の範囲", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": "between", "value": [4300, 6500] },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_cruise" },
    { "do": "view", "the": -25.6, "psi": 28.1, "fov": 8 },
    { "do": "shot", "name": "data_block_white" },

    { "do": "mark", "note": "外流弁を両方 MAN" },
    { "do": "switch", "note": "MAN L", "dref": "laminar/B747/button_switch/position[34]", "value": 1, "cmd": "laminar/B747/button_switch/press_outflow_vlv_L" },
    { "do": "switch", "note": "MAN R", "dref": "laminar/B747/button_switch/position[35]", "value": 1, "cmd": "laminar/B747/button_switch/press_outflow_vlv_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "両方 MAN：LDG ALT を消す（FCOM p.586）", "dref": "laminar/B747/air/press/ldg_alt_shown", "op": "==", "value": 0 },
    { "do": "check", "note": "CABIN ALT AUTO（FCOM p.619）", "dref": "laminar/B747/CAS/caution_status[10]", "op": "==", "value": 1 },
    { "do": "shot", "name": "data_block_both_man" },
    { "do": "switch", "note": "MAN L を戻す", "dref": "laminar/B747/button_switch/position[34]", "value": 0, "cmd": "laminar/B747/button_switch/press_outflow_vlv_L" },
    { "do": "check", "note": "片方だけ MAN：LDG ALT が戻る", "dref": "laminar/B747/air/press/ldg_alt_shown", "op": "==", "value": 1 },
    { "do": "switch", "note": "MAN R を戻す", "dref": "laminar/B747/button_switch/position[35]", "value": 0, "cmd": "laminar/B747/button_switch/press_outflow_vlv_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "AUTO：CABIN ALT AUTO が消える", "dref": "laminar/B747/CAS/caution_status[10]", "op": "==", "value": 0 },

    { "do": "mark", "note": "両 CPC の故障" },
    { "do": "set", "note": "CPC A の故障（X-Plane に無いので air/fail/cpc）", "dref": "laminar/B747/air/fail/cpc[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "B が引き継ぐ（ATA21 p.436）", "dref": "laminar/B747/air/press/cpc", "op": "==", "value": 2 },
    { "do": "check", "note": "STATUS CABIN ALT AUTO A（ATA21 p.454）", "dref": "laminar/B747/CAS/status_status[29]", "op": "==", "value": 1 },
    { "do": "check", "note": "片方の故障では LDG ALT を出す", "dref": "laminar/B747/air/press/ldg_alt_shown", "op": "==", "value": 1 },
    { "do": "set", "note": "CPC B の故障", "dref": "laminar/B747/air/fail/cpc[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "controller なし", "dref": "laminar/B747/air/press/cpc", "op": "==", "value": 0 },
    { "do": "check", "note": "両 CPC 故障：LDG ALT を消す（FCOM p.586）", "dref": "laminar/B747/air/press/ldg_alt_shown", "op": "==", "value": 0 },
    { "do": "check", "note": "CABIN ALT AUTO（FCOM p.619）", "dref": "laminar/B747/CAS/caution_status[10]", "op": "==", "value": 1 },
    { "do": "shot", "name": "data_block_both_cpc_failed" },
    { "do": "set", "note": "CPC A の故障を戻す", "dref": "laminar/B747/air/fail/cpc[0]", "value": 0 },
    { "do": "set", "note": "CPC B の故障を戻す", "dref": "laminar/B747/air/fail/cpc[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "故障を戻すと LDG ALT が戻る", "dref": "laminar/B747/air/press/ldg_alt_shown", "op": "==", "value": 1 },
    { "do": "check", "note": "controller が戻る", "dref": "laminar/B747/air/press/cpc", "op": ">", "value": 0 },

    { "do": "mark", "note": "客室高度の色と桁" },
    { "do": "switch", "note": "PACK 1 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "wait", "note": "客室高度 8,600 ft 超（琥珀：8,500〜9,999 ft）", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": ">", "value": 8600, "timeout": 420 },
    { "do": "shot", "name": "data_block_amber" },
    { "do": "snapshot", "note": "琥珀", "drefs": [ "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm" ] },
    { "do": "wait", "note": "客室高度 10,050 ft 超（赤：10,000 ft 以上）", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": ">", "value": 10050, "timeout": 300 },
    { "do": "shot", "name": "data_block_red_10000" },
    { "do": "snapshot", "note": "赤", "drefs": [ "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "laminar/B747/CAS/warning_status[1]" ] },
    { "do": "check", "note": "CABIN ALTITUDE（FCOM p.619）", "dref": "laminar/B747/CAS/warning_status[1]", "op": "==", "value": 1 },
    { "do": "set", "note": "X-Plane の急減圧の故障", "dref": "sim/operation/failures/rel_depres_fast", "value": 6 },
    { "do": "wait", "note": "客室高度 20,000 ft 超", "dref": "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "op": ">", "value": 20000, "timeout": 120 },
    { "do": "shot", "name": "data_block_red_high" },
    { "do": "snapshot", "note": "急減圧", "drefs": [ "sim/cockpit2/pressurization/indicators/cabin_altitude_ft", "sim/cockpit2/pressurization/indicators/cabin_vvi_fpm" ] },
    { "do": "set", "note": "故障を戻す", "dref": "sim/operation/failures/rel_depres_fast", "value": 0 },
    { "do": "switch", "note": "PACK 1 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "view", "name": "forward" }
  ]
}
