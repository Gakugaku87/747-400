{
  "name": "s211_rtp",
  "description": "通信の 7-1a（notes/ATA-23.md §11）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。RTP の窓：L が VHF L（COM1）、C が ACARS（VHF C のデータ）、R が VHF R（COM2）。L で HF L を選び AM を押すと HF L の選択のまま AM 灯が点き（前は選択が外れた：COM-04）、MHz のノブで STANDBY が 1 MHz 上がり、transfer で入れ替わる。L で VHF R を選ぶと L と R の offside 灯、VHF L に戻すと消える。C で transfer すると VHF C が音声になり STANDBY に ACARS、もう一度でデータに戻る。R の OFF で窓が消え OFF 灯。COM1・COM2 は電源で通電（前は RTP の表示で：COM-01）。RTP を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "L は VHF L（COM1）", "dref": "laminar/B747/comm/rtp_L/lcd_to_display", "op": "==", "value": 0 },
    { "do": "check", "note": "C は ACARS（VHF C のデータ、109）", "dref": "laminar/B747/comm/rtp_C/lcd_to_display", "op": "==", "value": 98, "cite": "FCOM p.686" },
    { "do": "check", "note": "R は VHF R（COM2）", "dref": "laminar/B747/comm/rtp_R/lcd_to_display", "op": "==", "value": 1 },
    { "do": "check", "note": "COM1 は通電（VHF L は main battery bus）", "dref": "sim/cockpit2/radios/actuators/com1_power", "op": "==", "value": 1 },
    { "do": "check", "note": "COM2 は通電", "dref": "sim/cockpit2/radios/actuators/com2_power", "op": "==", "value": 1 },
    { "do": "view", "note": "RTP（aisle stand）", "the": -52, "psi": 24, "fov": 40 },
    { "do": "shot", "name": "rtp_start" },
    { "do": "cmd", "note": "L：HF L を選ぶ", "name": "laminar/B747/rtp_L/hf_L/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L は HF L の窓", "dref": "laminar/B747/comm/rtp_L/lcd_to_display", "op": "==", "value": 3 },
    { "do": "check", "note": "COM1 は通電のまま（RTP が表示していなくても）", "dref": "sim/cockpit2/radios/actuators/com1_power", "op": "==", "value": 1 },
    { "do": "cmd", "note": "L：AM を押す", "name": "laminar/B747/rtp_L/am/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "AM 灯", "dref": "laminar/B747/comm/rtp_L/am_status", "op": "==", "value": 1, "cite": "FCOM p.686" },
    { "do": "check", "note": "HF L の選択のまま（前は外れた：COM-04）", "dref": "laminar/B747/comm/rtp_L/hf_L_status", "op": "==", "value": 1 },
    { "do": "remember", "dref": "laminar/B747/comm/hf_L/standby_khz", "as": "hfs" },
    { "do": "cmd", "note": "L：MHz のノブを上へ", "name": "laminar/B747/rtp_L/freq_MHz/sel_dial_up" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "HF L の STANDBY が 1 MHz 上がる", "dref": "laminar/B747/comm/hf_L/standby_khz", "op": "==", "value": 1000, "rel": "hfs" },
    { "do": "remember", "dref": "laminar/B747/comm/hf_L/standby_khz", "as": "hfs2" },
    { "do": "cmd", "note": "L：transfer", "name": "laminar/B747/rtp_L/freq_txfr/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "HF L の ACTIVE に入れ替わる", "dref": "laminar/B747/comm/hf_L/active_khz", "op": "==", "value": 0, "rel": "hfs2", "cite": "FCOM p.687" },
    { "do": "shot", "name": "rtp_L_hf" },
    { "do": "cmd", "note": "L：VHF R を選ぶ", "name": "laminar/B747/rtp_L/vhf_R/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L の offside 灯（他の RTP の無線機）", "dref": "laminar/B747/comm/rtp_L/offside_tuning_status", "op": "==", "value": 1, "cite": "FCOM p.686" },
    { "do": "check", "note": "R の offside 灯（自分の無線機を他の RTP が）", "dref": "laminar/B747/comm/rtp_R/offside_tuning_status", "op": "==", "value": 1 },
    { "do": "cmd", "note": "L：VHF L に戻す", "name": "laminar/B747/rtp_L/vhf_L/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L の offside 灯が消える", "dref": "laminar/B747/comm/rtp_L/offside_tuning_status", "op": "==", "value": 0 },
    { "do": "check", "note": "R の offside 灯が消える", "dref": "laminar/B747/comm/rtp_R/offside_tuning_status", "op": "==", "value": 0 },
    { "do": "cmd", "note": "C：transfer（VHF C を音声へ）", "name": "laminar/B747/rtp_C/freq_txfr/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "C は VHF C の周波数", "dref": "laminar/B747/comm/rtp_C/lcd_to_display", "op": "==", "value": 2 },
    { "do": "check", "note": "C の STANDBY に ACARS", "dref": "laminar/B747/comm/rtp_C/stby_show", "op": "==", "value": 98, "cite": "FCOM p.687" },
    { "do": "shot", "name": "rtp_C_voice" },
    { "do": "cmd", "note": "C：transfer（データへ戻す）", "name": "laminar/B747/rtp_C/freq_txfr/sel_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "C は ACARS に戻る", "dref": "laminar/B747/comm/rtp_C/lcd_to_display", "op": "==", "value": 98 },
    { "do": "cmd", "note": "R：OFF", "name": "laminar/B747/rtp_R/off_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "R の OFF 灯", "dref": "laminar/B747/comm/rtp_R/off_status", "op": "==", "value": 1, "cite": "FCOM p.686" },
    { "do": "check", "note": "R の窓が消える", "dref": "laminar/B747/comm/rtp_R/lcd_to_display", "op": "==", "value": 90 },
    { "do": "check", "note": "COM2 は通電のまま（OFF は RTP を切り離すだけ）", "dref": "sim/cockpit2/radios/actuators/com2_power", "op": "==", "value": 1 },
    { "do": "shot", "name": "rtp_R_off" },
    { "do": "cmd", "note": "R：OFF を戻す", "name": "laminar/B747/rtp_R/off_switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "R は VHF R に戻る", "dref": "laminar/B747/comm/rtp_R/lcd_to_display", "op": "==", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
