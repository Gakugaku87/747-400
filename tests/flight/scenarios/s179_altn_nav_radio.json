{
  "name": "s179_altn_nav_radio",
  "description": "6-1/6-2 段 11e3（代替航法の ALTN NAV RADIO）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。両方の FMC を故障させると、左の CDU の NAV RAD で ALTN NAV RADIO（VOR・CRS・ADF・ILS-MLS・PRESELECT：FCOM p.1427–1428、FMSPG p.252–254）。1L の 114.50/270 で VOR L（NAV3）がすぐ同調し、4L の 109.50/157 で ILS L（NAV1）と PFD の ILS の目盛、3L の 1304.5B で ADF L と BFO（FCOM p.1422：左の CDU は左の無線）。6L の PRESELECT を 4L へ下ろす。右の VOR R は変わらない。CDU と PFD を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "sleep", "seconds": 3, "note": "CDU が同調を写す（毎秒）" },

    { "do": "mark", "note": "両方の FMC の故障と ALTN NAV RADIO" },
    { "do": "set", "note": "左 FMC を故障させる", "dref": "laminar/B747/fms/fail[0]", "value": 1 },
    { "do": "set", "note": "右 FMC も", "dref": "laminar/B747/fms/fail[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "CLR、NAV RAD", "keys": ["CLR", "NAVRAD"] },
    { "do": "check", "note": "ALTN NAV RADIO（FCOM p.1427）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ALTN NAV RADIO" },
    { "do": "check", "note": "VOR の見出し", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ VOR" },
    { "do": "check", "note": "PRESELECT の見出し", "dref": "laminar/B747/fms3/Line12_S", "op": "contains", "value": "PRESELECT" },
    { "do": "cdu", "note": "1L に 114.50/270", "keys": ["114.50/270", "L1"] },
    { "do": "check", "note": "VOR L（NAV3）が同調（FCOM p.1422）", "dref": "sim/cockpit2/radios/actuators/nav_frequency_hz[2]", "op": "==", "value": 11450 },
    { "do": "check", "note": "1L は 114.50", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^114[.]50" },
    { "do": "check", "note": "2L は 270", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^270" },
    { "do": "cdu", "note": "4L に 109.50/157", "keys": ["109.50/157", "L4"] },
    { "do": "check", "note": "ILS L（NAV1）が同調", "dref": "sim/cockpit2/radios/actuators/nav_frequency_hz[0]", "op": "==", "value": 10950 },
    { "do": "check", "note": "PFD の ILS の目盛", "dref": "laminar/B747/autopilot/ils_dots", "op": "==", "value": 1 },
    { "do": "cdu", "note": "3L に 1304.5B", "keys": ["1304.5B", "L3"] },
    { "do": "check", "note": "ADF L 1304", "dref": "sim/cockpit2/radios/actuators/adf1_frequency_hz", "op": "==", "value": 1304 },
    { "do": "check", "note": "3L の BFO", "dref": "laminar/B747/fms3/Line07_S", "op": "contains", "value": "BFO" },
    { "do": "cdu", "note": "6L に 110.90/128（PRESELECT）", "keys": ["110.90/128", "L6"] },
    { "do": "check", "note": "6L に入る（FMSPG p.254）", "dref": "laminar/B747/fms3/Line13_L", "op": "matches", "value": "^110[.]90/128" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_altn_nav_radio" },
    { "do": "cdu", "note": "6L を書き込み行へ、4L へ", "keys": ["L6", "L4"] },
    { "do": "check", "note": "ILS L が 110.90 に", "dref": "sim/cockpit2/radios/actuators/nav_frequency_hz[0]", "op": "==", "value": 11090 },
    { "do": "check", "note": "4L は 110.90/128", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^110[.]90/128" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_altn_ils" },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[0]", "value": 0 },
    { "do": "set", "note": "注入を戻す", "dref": "laminar/B747/fms/fail[1]", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
