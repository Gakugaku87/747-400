{
  "name": "s320_altn_gear_retract",
  "description": "ALTN GEAR EXTEND の後の脚上げ（2026-11-12 のフルレビュー FG-7。REVIEW_2026-11-12.md の 4 の推奨どおり、2026-11-13 利用者）の X-Plane での確認。成田の東 10,000 ft・約 230 kt の空中開始（270 t、脚上げ）、A/P の ALT HOLD・HDG SEL・SPD。ALTN GEAR EXTEND の NOSE/BODY と WING を押す：全脚が下りてロックし、ドアは開いたまま（FCOM p.1513）。スイッチを戻し、脚レバーを DN にしてから UP：代替下げの 1 サイクルの後は、通常の系統で脚が上がりドアが閉じる（推定：ATA29_32 p.276-278 は代替下げの後に recycling が要らないと書くだけ。前は、その飛行の間は脚が上がらなかった）。GEAR DOOR・GEAR DISAGREE は出ない",
  "reload": true,
  "flight": {
    "lle_air_start": { "elevation_in_meters": 3048, "heading_true": 90, "latitude": 35.75, "longitude": 140.9, "speed_in_meters_per_second": 140 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weight": {
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ],
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 5 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "set", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90 },
    { "do": "set", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 230 },
    { "do": "cmd", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 20, "note": "落ち着く" },
    { "do": "check", "note": "脚は上がってロック（空中開始）", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "<", "value": 0.001, "stop": true },
    { "do": "check", "note": "脚レバー UP", "dref": "laminar/B747/actuator/gear_handle", "op": "==", "value": 2, "stop": true },
    { "do": "mark", "note": "ALTN GEAR EXTEND" },
    { "do": "switch", "note": "ALTN GEAR EXTEND NOSE/BODY", "dref": "laminar/B747/button_switch/position[1]", "value": 1, "cmd": "laminar/B747/button_switch/altn_nose_gear_extend" },
    { "do": "switch", "note": "ALTN GEAR EXTEND WING", "dref": "laminar/B747/button_switch/position[2]", "value": 1, "cmd": "laminar/B747/button_switch/altn_wing_gear_extend" },
    { "do": "wait", "note": "全脚ダウンロック（WING は約 20 秒：ATA29_32 p.250）", "dref": "laminar/B747/gear/air_ground/all_gear_down", "op": "==", "value": 1, "timeout": 40, "stop": true },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "前脚のドアは開いたまま（FCOM p.1513）", "dref": "laminar/B747/gear/door[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "左翼脚のドアも開いたまま", "dref": "laminar/B747/gear/door[3]", "op": "==", "value": 1 },
    { "do": "switch", "note": "ALTN GEAR EXTEND NOSE/BODY を戻す", "dref": "laminar/B747/button_switch/position[1]", "value": 0, "cmd": "laminar/B747/button_switch/altn_nose_gear_extend" },
    { "do": "switch", "note": "ALTN GEAR EXTEND WING を戻す", "dref": "laminar/B747/button_switch/position[2]", "value": 0, "cmd": "laminar/B747/button_switch/altn_wing_gear_extend" },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "代替下げの後", "drefs": [ "sim/flightmodel2/gear/deploy_ratio[0]", "sim/flightmodel2/gear/deploy_ratio[3]", "laminar/B747/gear/door[0]", "laminar/B747/gear/door[3]", "laminar/B747/actuator/gear_handle", "laminar/B747/gear/EICAS1_display_status", "laminar/B747/hydraulics/pressure_1", "laminar/B747/hydraulics/pressure_4" ] },
    { "do": "mark", "note": "脚レバー DN、UP" },
    { "do": "cmd", "note": "脚レバー DN", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "レバー DN：脚は下りたまま", "dref": "laminar/B747/gear/air_ground/all_gear_down", "op": "==", "value": 1 },
    { "do": "cmd", "note": "脚レバー UP", "name": "sim/flight_controls/landing_gear_up" },
    { "do": "wait", "note": "前脚が上がってロック（通常の系統で約 12 秒。ドアは開いている。前は上がらなかった）", "dref": "sim/flightmodel2/gear/deploy_ratio[0]", "op": "<", "value": 0.001, "timeout": 30, "stop": true },
    { "do": "wait", "note": "左翼脚も上がる", "dref": "sim/flightmodel2/gear/deploy_ratio[3]", "op": "<", "value": 0.001, "timeout": 10 },
    { "do": "sleep", "seconds": 7, "note": "ドアが閉じる（約 5 秒：ATA29_32 p.248）" },
    { "do": "check", "note": "前脚のドアが閉じた", "dref": "laminar/B747/gear/door[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "左翼脚のドアが閉じた", "dref": "laminar/B747/gear/door[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "GEAR DISAGREE は出ない", "dref": "laminar/B747/CAS/caution_status[38]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 25, "note": "GEAR DOOR は 30 秒" },
    { "do": "check", "note": "GEAR DOOR は出ない", "dref": "laminar/B747/CAS/advisory_status[180]", "op": "==", "value": 0 },
    { "do": "cas", "note": "脚上げの後" },
    { "do": "record_stop" }
  ]
}
