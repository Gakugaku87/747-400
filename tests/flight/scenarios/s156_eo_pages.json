{
  "name": "s156_eo_pages",
  "description": "6-1/6-2 段 9h4a（E/O のモードと E/O の CLB・CRZ のページ）の X-Plane での確認。空中、FL350 の巡航（機体を読み直す）、RJAA→RJBB の経路、PERF INIT で ZFW 200・CRZ ALT FL350・COST INDEX 100、VNAV PTH。VNAV の CRZ のページの ENG OUT>（5R）で MOD E/O LRC D/D（重さで E/O の最大高度が FL350 の下）：CRZ ALT は E/O の最大高度、LRC SPD は E/O LRC、OPT・MAX は E/O、ALL ENG>、<ERASE、EXEC の灯（FCOM p.1350–1353、FMSPG p.3.4-5）。EXEC で CRZ ALT が下がり、推力制限は CON（符号 40）、題は ACT E/O LRC D/D、VNAV の目標は E/O LRC。MCP 高度を FL300 にして押すと降下（段 9h4b から driftdown：最小 300 fpm）、CON のまま。CLB のページは E/O CLB。ALL ENG> と EXEC で全発に戻る。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 340, "speed_in_meters_per_second": 245 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "snapshot", "note": "空中開始の後（N1 の超過の記憶も）", "drefs": [ "laminar/B747/engines/N1/box_red[0]", "laminar/B747/engines/display_N1[0]", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/misc/machno" ] },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 35,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },
    { "do": "set", "note": "MCP 高度 35,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 35000 },
    { "do": "sleep", "seconds": 5 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV PTH（巡航）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 60 },
    { "do": "sleep", "seconds": 5 },

    { "do": "mark", "note": "ENG OUT>（CRZ のページ）" },
    { "do": "cdu", "note": "VNAV（CRZ のページ）", "keys": ["VNAV"] },
    { "do": "check", "note": "ACT ... CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CRZ" },
    { "do": "cdu", "note": "ENG OUT>（5R）", "keys": ["R5"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "MOD の E/O CRZ のページ", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L", "laminar/B747/fms3/Line13_L", "laminar/B747/fms/exec_light_pilot", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "MOD E/O LRC D/D（FCOM p.1268：E/O の最大高度の上）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD E/O LRC D/D" },
    { "do": "check", "note": "2L は LRC SPD", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "LRC SPD" },
    { "do": "check", "note": "5L <E/O SPD、5R ALL ENG>", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "^<E/O SPD +ALL ENG>$" },
    { "do": "check", "note": "6L <ERASE", "dref": "laminar/B747/fms3/Line13_L", "op": "contains", "value": "<ERASE" },
    { "do": "check", "note": "EXEC の灯", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 1 },
    { "do": "check", "note": "まだ CRZ ALT は FL350", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_eo_mod" },

    { "do": "mark", "note": "EXEC" },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "wait", "note": "CRZ ALT が E/O の最大高度に下がる（FMSPG p.3.4-5）", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "<", "value": 35000, "timeout": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "推力制限は CON（FCOM p.1350）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 40 },
    { "do": "check", "note": "ACT E/O LRC D/D", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT E/O LRC D/D" },
    { "do": "check", "note": "EXEC の灯は消える", "dref": "laminar/B747/fms/exec_light_pilot", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "E/O の実行の後", "drefs": [ "laminar/B747/autopilot/dist/cruise_alt", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/phase", "laminar/B747/fms/vnav/mode", "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "VNAV の目標は E/O LRC（全発の ECON より遅い）", "dref": "laminar/B747/fms/vnav/mach", "op": "between", "value": [0.70, 0.845] },
    { "do": "shot", "name": "cdu_eo_dd" },

    { "do": "mark", "note": "MCP の高度を下げて押す" },
    { "do": "set", "note": "MCP 高度 FL300", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 30000 },
    { "do": "sleep", "seconds": 4 },
    { "do": "cmd", "note": "高度のノブを押す", "name": "laminar/B747/button_switch/press_altitude" },
    { "do": "wait", "note": "VNAV SPD で降下", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 20 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "降下", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "sim/flightmodel/misc/machno", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/dd", "laminar/B747/autopilot/FMA/autothrottle_mode", "laminar/B747/engines/ref_thr_limit_mode", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/fms3/Line01_L" ] },
    { "do": "check", "note": "推力制限は CON のまま", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 40 },
    { "do": "check", "note": "段 9h4b：E/O の最大高度の上なので driftdown（FCOM p.1268 の条件 2）", "dref": "laminar/B747/fms/vnav/dd", "op": "==", "value": 1 },
    { "do": "wait", "note": "降りている（driftdown は最小 300 fpm。全発運転なので A/T の THR が推力を下げて 300 fpm にする。初めの版（2026-11-01 2:01）は空中開始の揺れで上昇中に押し、120 秒で −183 fpm）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -200, "timeout": 240 },

    { "do": "mark", "note": "E/O CLB のページ" },
    { "do": "cdu", "note": "PREV（CLB のページ）", "keys": ["PREV"] },
    { "do": "snapshot", "note": "E/O CLB", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "E/O CLB（FCOM p.1341）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "E/O CLB" },
    { "do": "check", "note": "4R は MAX ALT の FL", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "FL[0-9]{3}$" },
    { "do": "shot", "name": "cdu_eo_clb" },

    { "do": "mark", "note": "ALL ENG> と EXEC" },
    { "do": "cdu", "note": "NEXT（CRZ）、ALL ENG>（5R）", "keys": ["NEXT", "R5"] },
    { "do": "check", "note": "MOD の全発の CRZ のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "^(?!.*E/O).*MOD.*CRZ" },
    { "do": "cdu", "note": "EXEC", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "全発の CRZ のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "^(?!.*E/O)(?!.*MOD).*CRZ" },
    { "do": "check", "note": "5R は ENG OUT> に戻る", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "ENG OUT>$" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
