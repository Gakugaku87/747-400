  "steps": [
    { "do": "sleep", "note": "空中開始の揺れを待つ", "seconds": 10 },
    { "do": "check", "note": "P&W（EPR）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 0, "stop": true },
    { "do": "check", "note": "重さは約 300 t", "dref": "sim/flightmodel/weight/m_total", "op": "between", "value": [298000, 302000], "stop": true },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "set", "note": "MCP 方位 090", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "set", "note": "MCP を Mach に（s262 と同じ）", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "note": "窓 M.85", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 85 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "check", "note": "M.85 が窓の目標", "dref": "sim/cockpit2/autopilot/airspeed_dial_kts_mach", "op": "between", "value": [0.849, 0.851], "level": "warn" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "sleep", "note": "空中開始の後の上昇が収まるのを待つ", "seconds": 180 },
    { "do": "cdu", "note": "INIT REF、<INDEX、THRUST LIM", "keys": ["INITREF", "L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "cdu", "note": "<CRZ（L4）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMS の符号は CRZ（30）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 30 },
    { "do": "check", "note": "EEC のモードも CRZ", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "CRZ" },
    { "do": "snapshot", "note": "CRZ：条件と reference", "drefs": [ "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR_max[0]", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/flightmodel2/position/pressure_altitude", "sim/flightmodel/misc/machno", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "TAT は FPPM の表の MAX TAT（FL350 -4 ℃、FL370 -7 ℃）より冷たい", "dref": "sim/cockpit2/temperature/outside_air_LE_temp_degc", "op": "<", "value": -8 },
    { "do": "check", "note": "気圧高度は 34,500〜38,000 ft（空中開始の上昇の後）", "dref": "sim/flightmodel2/position/pressure_altitude", "op": "between", "value": [34500, 38000] },
    { "do": "check", "note": "reference は FPPM の Max Cruise EPR（FL350 1.53〜FL370 1.54・FL360 1.55）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [1.525, 1.555], "cite": "FPPM p.122 (3.2.14)" },
    { "do": "remember", "dref": "laminar/B747/engines/display_EPR_ref[0]", "as": "crz_ref" },
    { "do": "check", "note": "EICAS の緑のカーソルも同じ値", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "op": "between", "value": [-0.005, 0.005], "rel": "crz_ref" },
    { "do": "check", "note": "巡航の EPR は CRZ の reference より下（A/T SPD、M.85）", "dref": "laminar/B747/engines/display_EPR[0]", "op": "<", "value": 0, "rel": "crz_ref" },
    { "do": "view", "note": "上の EICAS（寄せて）", "the": -22, "psi": 29, "fov": 22 },
    { "do": "shot", "name": "eicas_crz_fppm" },
    { "do": "mark", "note": "エンジンの防氷" },
    { "do": "switch", "note": "NAI 1 ON", "dref": "laminar/B747/button_switch/position[68]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_1" },
    { "do": "switch", "note": "NAI 2 ON", "dref": "laminar/B747/button_switch/position[69]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_2" },
    { "do": "switch", "note": "NAI 3 ON", "dref": "laminar/B747/button_switch/position[70]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_3" },
    { "do": "switch", "note": "NAI 4 ON", "dref": "laminar/B747/button_switch/position[71]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_4" },
    { "do": "wait", "note": "ナセル防氷弁 1 が開く", "dref": "laminar/B747/antiice/nacelle/valve_pos[0]", "op": ">", "value": 0.9, "timeout": 15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "note": "CRZ、エンジンの防氷", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/flightmodel2/position/pressure_altitude" ] },
    { "do": "check", "note": "エンジンの防氷で -0.04（FL300〜370 のページ。FL380 から上は -0.03 で、あいだは直線）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [-0.046, -0.028], "rel": "crz_ref", "cite": "FPPM p.122 (3.2.14), p.120 (3.2.12)" },
    { "do": "switch", "note": "WING ANTI-ICE ON", "dref": "laminar/B747/button_switch/position[72]", "value": 1, "cmd": "laminar/B747/button_switch/anti_ice_wing" },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "CRZ、エンジンと翼の防氷", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/antiice/wing/valve_pos[0]", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/flightmodel2/position/pressure_altitude" ] },
    { "do": "check", "note": "エンジンと翼の防氷で -0.08", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [-0.086, -0.074], "rel": "crz_ref", "cite": "FPPM p.122 (3.2.14)" },
    { "do": "switch", "note": "WING ANTI-ICE OFF", "dref": "laminar/B747/button_switch/position[72]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_wing" },
    { "do": "switch", "note": "NAI 1 OFF", "dref": "laminar/B747/button_switch/position[68]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_1" },
    { "do": "switch", "note": "NAI 2 OFF", "dref": "laminar/B747/button_switch/position[69]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_2" },
    { "do": "switch", "note": "NAI 3 OFF", "dref": "laminar/B747/button_switch/position[70]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_3" },
    { "do": "switch", "note": "NAI 4 OFF", "dref": "laminar/B747/button_switch/position[71]", "value": 0, "cmd": "laminar/B747/button_switch/anti_ice_nacelle_4" },
    { "do": "wait", "note": "防氷を切ると CRZ の値に戻る", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [-0.006, 0.006], "rel": "crz_ref", "timeout": 20 },
    { "do": "mark", "note": "CLB に戻す" },
    { "do": "cdu", "note": "CLB>（R2）", "keys": ["R2"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMS の符号は CLB（20）", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 20 },
    { "do": "snapshot", "note": "CLB", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "sim/cockpit2/temperature/outside_air_LE_temp_degc", "sim/flightmodel2/position/pressure_altitude" ] },
    { "do": "check", "note": "CLB は最大上昇（FCOM PI.10.36：35,000 ft・TAT -10 ℃以下で 1.64）で、CRZ より 0.06〜0.12 高い", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [0.06, 0.12], "rel": "crz_ref", "cite": "FCOM p.262 (PI.10.36)" },
    { "do": "shot", "name": "eicas_clb" },
    { "do": "view", "name": "forward" }
