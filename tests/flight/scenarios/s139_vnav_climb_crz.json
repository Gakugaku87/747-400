{
  "name": "s139_vnav_climb_crz",
  "description": "6-1/6-2 段 9c（AFDS が FMC の VNAV で飛ぶ）の X-Plane での確認、上昇から巡航。空中、10,000 ft・約 290 kt（s137 と同じ始め方、機体を読み直す）。RJAA→RJBB の経路、PERF INIT で ZFW 200・COST INDEX 100・CRZ ALT FL170、MCP 20,000 ft で VNAV：VNAV SPD（4）・A/T THR REF（5）・FMC の上昇の速度で上がり（FCOM p.645）、CRZ ALT で VNAV PTH（6）に水平になって A/T は SPD（3）、FMC の段階は巡航（2）、行き過ぎ 300 ft まで。そのあと 60 秒、高度を保つ。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL170、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "170", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 17,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 17000 },
    { "do": "set", "note": "MCP 高度 20,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 20000 },
    { "do": "sleep", "seconds": 5, "note": "MCP の高度が中へ写るのを待つ（3 秒）と FMC の VNAV" },
    { "do": "check", "note": "性能のデータが揃う（PERF/VNAV UNAVAILABLE にならない）", "dref": "laminar/B747/fms/vnav/perf", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC は上昇（1）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "vnav_state は 2", "dref": "laminar/B747/autopilot/vnav_state", "op": "==", "value": 2 },
    { "do": "check", "note": "A/T は THR REF（FMC の上昇）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 5 },
    { "do": "check", "note": "IAS/MACH の窓は閉じる（FCOM p.645）", "dref": "laminar/B747/autopilot/ias_mach/window_open", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "VNAV SPD の始め", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/fms/vnav/alt", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_dial_kts", "sim/cockpit2/autopilot/airspeed_is_mach", "laminar/B747/autopilot/flightPhase", "laminar/B747/engines/ref_thr_limit_mode", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "wait", "note": "16,000 ft まで上がる", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">=", "value": 16000, "timeout": 480 },
    { "do": "snapshot", "note": "16,000 ft：上昇の速度", "drefs": [ "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_dial_kts", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "watch", "note": "90 秒：CRZ ALT 17,000 ft を 300 ft より行き過ぎない", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 17300, "timeout": 90 },
    { "do": "check", "note": "17,000 ft の近く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [16800, 17300] },
    { "do": "check", "note": "VNAV PTH（6）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "FMC は巡航（2）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "check", "note": "A/T は SPD（3）", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "watch", "note": "60 秒：17,000 ft を ±150 ft で保つ", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 17150, "timeout": 60 },
    { "do": "snapshot", "note": "巡航", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/flightmodel/position/vh_ind_fpm", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/mach", "laminar/B747/fms/vnav/mach_mode", "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_is_mach", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/misc/machno", "laminar/B747/autopilot/flightPhase", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "下にも 150 ft まで", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">=", "value": 16850 },
    { "do": "mark", "note": "cruise climb（段 9d1：FCOM p.649、p.1257）" },
    { "do": "set", "note": "MCP 高度 FL190", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 19000 },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "押す前は巡航（2）のまま", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 2 },
    { "do": "cmd", "note": "高度のノブを押す", "name": "laminar/B747/button_switch/press_altitude" },
    { "do": "wait", "note": "CRZ ALT は MCP の FL190", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 19000, "timeout": 5 },
    { "do": "wait", "note": "FMC は上昇（1）、VNAV SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 15 },
    { "do": "check", "note": "FMC の上昇", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 1 },
    { "do": "wait", "note": "FL190 で VNAV PTH（MCP と同じ高度なので VNAV ALT でない：段 9d1）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6, "timeout": 240 },
    { "do": "watch", "note": "60 秒：捕捉の後に FL190 を 300 ft より行き過ぎない（捕捉は 600 ft ほど手前から）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "max": 19300, "timeout": 60 },
    { "do": "check", "note": "19,000 ft の近く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [18850, 19150] },
    { "do": "check", "note": "VNAV PTH のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "A/T は SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3 },
    { "do": "record_stop" }
  ]
}
