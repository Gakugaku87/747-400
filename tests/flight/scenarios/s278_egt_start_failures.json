{
  "name": "s278_egt_start_failures",
  "description": "EGT の作り直し（2026-11-10、ENG-33：表示の EPR と入口の気温から作る）と、故障の窓の HOT START・点火器の故障の X-Plane での確認。地上（RJAA 34L、エンジン運転中、静穏）。パックを OFF、AUTOSTART ON。(1) アイドルの EGT（15 °C で約 390 °C：推定）。(2) エンジン 4 を止めて普通の autostart：EGT の山はホットスタートの判定（510 °C）の下、アイドルに戻る。(3) HOT START：点火の数秒後に EGT が 510 °C に届き、EEC が燃料を切って 30 秒空回し、やり直しでまた届いて中止、ENG 4 AUTOSTART（FCOM p.880–881、p.899）。CUTOFF で消える。(4) 点火器 1・2 の両方の故障：着火せず、EGT は上がらず、2 回で中止、ENG 4 AUTOSTART。(5) 点火器 1 だけの故障：始動は終わる（点火器 2 か、やり直しの両方で）。記録を取る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [ "sim/aircraft/view/acf_relative_path", "laminar/B747/engines/type", "sim/weather/aircraft/temperature_ambient_deg_c", "laminar/B747/engines/display_EGT[0]", "laminar/B747/engines/display_EGT[3]", "laminar/B747/engines/display_EPR[3]", "sim/flightmodel/engine/ENGN_EGT_c[3]" ] },
    { "do": "check", "note": "P&W（この試験は P&W の数字）", "dref": "laminar/B747/engines/type", "op": "==", "value": 0, "level": "warn" },
    { "do": "check", "note": "アイドルの EGT（15 °C で約 390 °C：推定。前は約 193 °C）", "dref": "laminar/B747/engines/display_EGT[3]", "op": "between", "value": [330, 460] },
    { "do": "switch", "note": "PACK 1 OFF（始動の空気のため。FCOM p.123）", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "switch", "note": "AUTOSTART ON", "dref": "laminar/B747/button_switch/position[45]", "value": 1, "cmd": "laminar/B747/button_switch/start_autostart" },

    { "do": "mark", "note": "普通の autostart" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "エンジン 4 の N2 が 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180 },
    { "do": "check", "note": "止めた後の EGT は下がっている（60 秒の遅れ：推定）", "dref": "laminar/B747/engines/display_EGT[3]", "op": "<", "value": 330 },
    { "do": "switch", "note": "START 4", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "light-off", "dref": "sim/flightmodel2/engines/engine_is_burning_fuel[3]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "watch", "note": "始動の間の EGT の山はホットスタートの判定（510 °C）の下（N2 55 % まで）", "dref": "laminar/B747/engines/display_EGT[3]", "max": 505, "timeout": 120, "until": { "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 55 } },
    { "do": "wait", "note": "idle（N2 60 % 以上）", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 60, "timeout": 120 },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "アイドルの EGT に戻る", "dref": "laminar/B747/engines/display_EGT[3]", "op": "between", "value": [330, 460] },
    { "do": "check", "note": "ENG 4 AUTOSTART なし", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 0 },

    { "do": "mark", "note": "HOT START" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "N2 が 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180 },
    { "do": "set", "note": "故障：ENGINE 4 HOT START", "dref": "laminar/B747/engines/fail/hot_start[3]", "value": 1 },
    { "do": "switch", "note": "START 4", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "light-off", "dref": "sim/flightmodel2/engines/engine_is_burning_fuel[3]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "wait", "note": "EGT が判定の 510 °C 近くへ急に上がる", "dref": "laminar/B747/engines/display_EGT[3]", "op": ">=", "value": 505, "timeout": 15 },
    { "do": "wait", "note": "EEC が燃料を切る（ホットスタート：FCOM p.880）", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "wait", "note": "火が消える", "dref": "sim/flightmodel2/engines/engine_is_burning_fuel[3]", "op": "==", "value": 0, "timeout": 15 },
    { "do": "check", "note": "まだ ENG 4 AUTOSTART は出ない（1 回目）", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 0 },
    { "do": "wait", "note": "30 秒の空回しの後、やり直しで燃料", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "wait", "note": "やり直しでもまた 510 °C 近く", "dref": "laminar/B747/engines/display_EGT[3]", "op": ">=", "value": 505, "timeout": 40 },
    { "do": "wait", "note": "2 回で中止：ENG 4 AUTOSTART（caution：FCOM p.899）", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 1, "timeout": 20 },
    { "do": "check", "note": "燃料は切れている", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "START 4 が戻っている", "dref": "laminar/B747/toggle_switch/position[19]", "op": "==", "value": 0 },
    { "do": "check", "note": "EEC が始動の制限（535 °C）の前で止めた", "dref": "laminar/B747/engines/EGT/red_on[3]", "op": "==", "value": 0 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_eng4_hot_start_abort" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF（メッセージが消える）", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "ENG 4 AUTOSTART が消える", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/engines/fail/hot_start[3]", "value": 0 },

    { "do": "mark", "note": "点火器 1・2 の両方の故障" },
    { "do": "wait", "note": "N2 が 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180 },
    { "do": "set", "note": "故障：ENGINE 4 IGNITER 1", "dref": "laminar/B747/engines/fail/igniter[3]", "value": 1 },
    { "do": "set", "note": "故障：ENGINE 4 IGNITER 2", "dref": "laminar/B747/engines/fail/igniter[7]", "value": 1 },
    { "do": "remember", "dref": "laminar/B747/engines/display_EGT[3]", "as": "egt_cold" },
    { "do": "switch", "note": "START 4", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "所定の N2 で燃料", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "check", "note": "X-Plane の点火は無い（どちらも故障）", "dref": "sim/cockpit2/engine/actuators/igniter_on[3]", "op": "==", "value": 0 },
    { "do": "wait", "note": "2 回で中止：ENG 4 AUTOSTART", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 1, "timeout": 120 },
    { "do": "check", "note": "一度も着火していない", "dref": "sim/flightmodel2/engines/engine_is_burning_fuel[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "EGT は上がっていない（止めた後の冷えのまま）", "dref": "laminar/B747/engines/display_EGT[3]", "op": "<=", "value": 5, "rel": "egt_cold" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "set", "note": "点火器 2 は戻す（1 だけの故障へ）", "dref": "laminar/B747/engines/fail/igniter[7]", "value": 0 },

    { "do": "mark", "note": "点火器 1 だけの故障" },
    { "do": "wait", "note": "N2 が 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180 },
    { "do": "switch", "note": "START 4", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "始動が終わる（点火器 2 で、か、やり直しの両方で）", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 60, "timeout": 240 },
    { "do": "check", "note": "ENG 4 AUTOSTART なし", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 0 },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/engines/fail/igniter[3]", "value": 0 },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "アイドルの EGT", "dref": "laminar/B747/engines/display_EGT[3]", "op": "between", "value": [330, 460] },
    { "do": "record_stop" }
  ]
}
