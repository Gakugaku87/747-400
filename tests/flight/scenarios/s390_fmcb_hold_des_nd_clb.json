{
  "name": "s390_fmcb_hold_des_nd_clb",
  "description": "段 4 のレビューの直し（担当 fmcb、2026-11-24、notes/ATA-34-61-FMC.md §177）の X-Plane での確かめ、P&W、空中。s92 と同じ XAC の 15 NM 手前、10,000 ft、250 kt で開始（機体を読み直す、238 t）。RTE RJAA→RJBB を XAC・SPENS・BOKJO で ACTIVATE と EXEC、PERF INIT（ZFW 200、RESERVES 10、CI 100、CRZ ALT FL200）。(1) FMC-6：ND の現用点の ETA が予測から出る（PROGRESS の TO の ETA と同じ：写しを見比べる）。(2) CDU-3：P&W（109）の DES のページに FPA V/B V/S と WPT/ALT が無い（FCOM p.1390）。(3) CDU-4：SPENS に HOLD AT と EXEC、RTE HOLD の FIX ETA・HOLD AVAIL・BEST SPEED が数（FCOM p.1415、p.1419）。(4) FMC-5：CLB の 4L に 240/11000、FLCH で 12,000 ft へ上がり、11,000 ft を過ぎると 4L がダッシュ（ATA34_2 p.553）。CDU と ND を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.91121, "longitude": 139.59895, "elevation_in_meters": 3048, "heading_true": 217, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 3901.4, 4106.8, 4928.1, 6365.5, 1232, 10287.5, 9178.6, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 3750, 3750, 3750, 3750, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "check", "note": "PW（engines/type 0）", "dref": "laminar/B747/engines/type", "op": "==", "value": 0, "stop": true },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 224（脚の向き：真 217）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 224 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACT RTE 1 LEGS、現用点 XAC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "XAC", "stop": true },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "脚の上なので LNAV がすぐ engage", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 2, "timeout": 30 },
    { "do": "cdu", "note": "PERF INIT：ZFW 200、RESERVES 10、COST INDEX 100、CRZ ALT FL200", "keys": ["INITREF", "L6", "L3", "200", "L3", "10", "L4", "100", "L5", "FL200", "R1"] },
    { "do": "sleep", "seconds": 12, "note": "予測" },

    { "do": "mark", "note": "(1) FMC-6：ND の現用点の ETA を予測から（PROGRESS の TO と同じ）" },
    { "do": "check", "note": "ND の現用点 XAC", "dref": "laminar/B747/nd/current_waypoint", "op": "contains", "value": "XAC" },
    { "do": "check", "note": "ND の ETA は時刻（HHMM.Tz）", "dref": "laminar/B747/nd/waypoint_eta", "op": "matches", "value": "^[0-9]{4}[.][0-9]z$", "cite": "FCOM p.1147" },
    { "do": "cdu", "note": "PROGRESS", "keys": ["PROG"] },
    { "do": "snapshot", "note": "ND の ETA の 4 桁が PROGRESS の TO の行（5 行目）の ETA と同じこと（直す前は 275 kt 以上の GS で割った時刻）", "drefs": ["laminar/B747/nd/waypoint_eta", "laminar/B747/fms3/Line05_L", "laminar/B747/nd/waypoint_distance", "laminar/B747/fms/route_eta", "sim/flightmodel/position/groundspeed", "sim/cockpit2/clock_timer/zulu_time_minutes"] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_progress" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "(2) CDU-3：P&W（109）の DES に FPA V/B V/S・WPT/ALT が無い" },
    { "do": "cdu", "note": "VNAV、NEXT、NEXT（DES）", "keys": ["VNAV", "NEXT", "NEXT"] },
    { "do": "check", "note": "DES のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "DES" },
    { "do": "check", "note": "FPA V/B V/S の見出しが無い（FCOM p.1390。直す前は全型式で出ていた）", "dref": "laminar/B747/fms3/Line08_S", "op": "matches", "value": "^(?!.*FPA)", "cite": "FCOM p.1390" },
    { "do": "check", "note": "その値（箱）も無い", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^(?!.*[*][.][*])" },
    { "do": "check", "note": "WPT/ALT の見出しも無い", "dref": "laminar/B747/fms3/Line06_S", "op": "matches", "value": "^(?!.*WPT/ALT)" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_des_pw" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "(3) CDU-4：SPENS に HOLD AT、EXEC、RTE HOLD の 3 つ" },
    { "do": "cdu", "note": "HOLD（RTE LEGS HOLD AT）、SPENS を 6L", "keys": ["HOLD", "SPENS", "L6", "?SEL"] },
    { "do": "check", "note": "MOD RTE 1 HOLD", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MOD RTE 1 HOLD", "stop": true },
    { "do": "cdu", "keys": ["EXEC"] },
    { "do": "sleep", "seconds": 12, "note": "予測の作り直し" },
    { "do": "check", "note": "ACT RTE 1 HOLD", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1 HOLD" },
    { "do": "check", "note": "FIX ETA が時刻（直す前は ----.-）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "[0-9]{4}[.][0-9] $", "cite": "FCOM p.1419 (8)" },
    { "do": "check", "note": "HOLD AVAIL が H+MM（直す前は -+--）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "[0-9]+[+][0-9]{2}$", "cite": "FCOM p.1419 (10)" },
    { "do": "check", "note": "BEST SPEED が数（直す前は ---）", "dref": "laminar/B747/fms3/Line11_L", "op": "matches", "value": "[0-9]{3}  $", "cite": "FCOM p.1419 (11)" },
    { "do": "snapshot", "note": "RTE HOLD の行と、LEGS の SPENS の ETA と比べるための予測", "drefs": ["laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L", "laminar/B747/fms/data"] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_rte_hold" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "(4) FMC-5：CLB の 4L に 240/11000、11,000 ft を過ぎるとダッシュ" },
    { "do": "cdu", "note": "VNAV（CLB）、240/11000 を 4L", "keys": ["VNAV", "240/11000", "L4"] },
    { "do": "check", "note": "CLB のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CLB" },
    { "do": "check", "note": "4L 240/11000", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "240/11000" },
    { "do": "set", "note": "MCP 高度 12,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 12000 },
    { "do": "cmd", "note": "FLCH", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "11,000 ft を過ぎる", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">=", "value": 11300, "timeout": 180 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "過ぎた SPD RESTR はダッシュ（直す前は 240/11000 のまま）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"clbrestspd\":\"---\"", "cite": "ATA34_2 p.553" },
    { "do": "check", "note": "4L のダッシュ", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^---/-----" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_clb_restr_passed" },
    { "do": "view", "name": "forward" }
  ]
}
