{
  "name": "s82_takeoff_speeds",
  "description": "TAKEOFF REF の V speeds（6-2 段 3b-1）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す。IRS は整列済み）。PERF INIT に ZFW を入れ、TAKEOFF REF でフラップ 10 を入れると、FMC の計算した V1・VR・V2 が小さい字（REF と >）で出るが、選ぶまで PFD には出ない（NO V SPD。前はフラップを入れるとすぐ PFD に出た：FCOM p.1319-1320）。R1〜R3 で選ぶと大きい字になり PFD に出る。フラップを 20 に替えると選んだ速度は消えて TAKEOFF SPEEDS DELETED（FCOM p.1319）。CDU と PFD を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "check", "note": "IRS は整列済み", "dref": "laminar/B747/irs/mode[0]", "op": "==", "value": 2 },
    { "do": "mark", "note": "PERF INIT の ZFW（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "INIT REF（地上で位置あり：PERF INIT）", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "ZFW へ（L3）", "name": "laminar/B747/fms1/ls_key/L3" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<INDEX", "name": "laminar/B747/fms1/ls_key/L6" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cmd", "note": "<TAKEOFF（L5）", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "check", "note": "フラップが無いと計算値は無い（ダッシュ）", "dref": "laminar/B747/airspeed/V1_ref", "op": "==", "value": 999 },
    { "do": "check", "note": "PFD に V1 は無い", "dref": "laminar/B747/airspeed/V1", "op": "==", "value": 999 },

    { "do": "mark", "note": "フラップ 10：計算値" },
    { "do": "cmd", "note": "1", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "FLAP へ（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "wait", "note": "FMC の計算した V1", "dref": "laminar/B747/airspeed/V1_ref", "op": "<", "value": 999, "timeout": 3 },
    { "do": "snapshot", "note": "計算値と TAKEOFF REF の行", "drefs": ["laminar/B747/airspeed/V1_ref", "laminar/B747/airspeed/Vr_ref", "laminar/B747/airspeed/V2_ref", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_S", "laminar/B747/fms3/Line07_S"] },
    { "do": "check", "note": "選ぶまで PFD には出ない（前はすぐ出た）", "dref": "laminar/B747/airspeed/V1", "op": "==", "value": 999 },
    { "do": "check", "note": "V1 の見出しは REF V1", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "REF V1" },
    { "do": "check", "note": "計算値は小さい字で > つき", "dref": "laminar/B747/fms3/Line03_S", "op": "contains", "value": ">" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_takeoff_ref" },
    { "do": "view", "note": "機長の PFD", "the": -21, "psi": -2, "fov": 28 },
    { "do": "shot", "name": "pfd_no_vspd" },

    { "do": "mark", "note": "選ぶ" },
    { "do": "cmd", "note": "R1（V1 を選ぶ）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "cmd", "note": "R2（VR）", "name": "laminar/B747/fms1/ls_key/R2" },
    { "do": "cmd", "note": "R3（V2）", "name": "laminar/B747/fms1/ls_key/R3" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "remember", "dref": "laminar/B747/airspeed/V1_ref", "as": "v1ref" },
    { "do": "check", "note": "PFD の V1 は FMC の値", "dref": "laminar/B747/airspeed/V1", "op": "==", "value": 0, "rel": "v1ref" },
    { "do": "remember", "dref": "laminar/B747/airspeed/V2_ref", "as": "v2ref" },
    { "do": "check", "note": "PFD の V2 も", "dref": "laminar/B747/airspeed/V2", "op": "==", "value": 0, "rel": "v2ref" },
    { "do": "check", "note": "選んだ V1 の見出しに REF が無い", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": " V1" },
    { "do": "shot", "name": "pfd_vspd" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_takeoff_selected" },

    { "do": "mark", "note": "フラップを替えると消える" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "FLAP 20 へ", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "TAKEOFF SPEEDS DELETED（FCOM p.1319）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "TAKEOFF SPEEDS DELETED" },
    { "do": "check", "note": "PFD の V1 は消える", "dref": "laminar/B747/airspeed/V1", "op": "==", "value": 999 },
    { "do": "check", "note": "フラップは 20", "dref": "laminar/B747/airspeed/flapsRef", "op": "==", "value": 20 },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
