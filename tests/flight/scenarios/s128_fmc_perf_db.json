{
  "name": "s128_fmc_perf_db",
  "description": "6-1・6-2 段 8a（性能 DB）の X-Plane での確認、空中。10,000 ft・約 290 kt で空中から始め（機体を読み直す）、VNAV（CDU の DES のキー）の CRZ のページと LRC のページで、OPT・MAX（FCOM PI.11.1 の表：重量・ISA 偏差・buffet の余裕 1.3 g）と LRC の Mach（PI.11.2 の表：重量と巡航高度）を記録する。期待値はその時の重量（`m_total`）と外気温から `B747.68.perf_db.lua` で求めて比べる（前は重量の一次式）。LRC のページの T/D の時刻は X-Plane の UTC から（前は PC の時計）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える（機長の CDU の表示は fms3 の行：s101 と同じ）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cmd", "note": "VNAV のページ（CDU の DES のキー）", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "NEXT PAGE：CRZ", "name": "laminar/B747/fms1/func_key/next_pg" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CRZ のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CRZ" },
    { "do": "check", "note": "OPT・MAX が出る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FL" },
    { "do": "snapshot", "note": "OPT・MAX と、比べる重量・外気温・気圧高度", "drefs": [ "laminar/B747/fms3/Line09_L", "sim/flightmodel/weight/m_total", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/engines/type" ] },
    { "do": "cdu", "note": "CRZ ALT を FL350 に", "keys": ["350", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "LRC のページ（R6）", "keys": ["R6"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LRC のページ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "LRC" },
    { "do": "check", "note": "LRC の Mach が出る（先頭の 0 なし）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^\\.[0-9]{3}" },
    { "do": "snapshot", "note": "CRZ ALT と OPT・MAX、LRC の Mach と T/D の時刻、比べる重量と UTC", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/time/zulu_time_sec" ] },
    { "do": "view", "note": "左の CDU", "the": -36, "psi": -20, "fov": 30 },
    { "do": "shot", "name": "cdu_lrc" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
