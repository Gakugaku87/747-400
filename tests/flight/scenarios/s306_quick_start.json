{
  "name": "s306_quick_start",
  "description": "X-Plane の quick start（2026-11-12 のフルレビュー SM-3：案 14）の X-Plane での確認。RJAA の地上で NO SMOKING を OFF にし、sim/operation/quick_start。前：自動操縦のコマンドの名前の誤り（nil）で Lua の誤りになり、安全・警報・照明の quick start に届かなかった。直した後：NO SMOKING が AUTO、XTLua のコマンドも動く",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10 },
    "weather": {
      "definition": "vfr_few_clouds",
      "evolution_over_time_enum": "static",
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_direction_in_degrees": 0,
      "wave_height_in_meters": 0.5
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8 },
    { "do": "set", "note": "NO SMOKING を OFF", "dref": "laminar/B747/safety/no_smoking/sel_dial_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "前", "drefs": [ "laminar/B747/safety/no_smoking/sel_dial_pos", "laminar/B747/button_switch/position[11]", "laminar/B747/button_switch/position[13]" ] },
    { "do": "remember", "dref": "laminar/B747/button_switch/position[11]", "as": "util" },
    { "do": "mark", "note": "sim/operation/quick_start" },
    { "do": "cmd", "name": "sim/operation/quick_start", "duration": 0.2 },
    { "do": "sleep", "seconds": 4 },
    { "do": "snapshot", "note": "quick_start の 4 秒後", "drefs": [ "laminar/B747/safety/no_smoking/sel_dial_pos", "laminar/B747/button_switch/position[11]", "laminar/B747/button_switch/position[13]" ] },
    { "do": "check", "note": "安全のモジュールの quick start で NO SMOKING は AUTO（1）（前は自動操縦の所の Lua の誤りで止まり届かなかった）", "dref": "laminar/B747/safety/no_smoking/sel_dial_pos", "op": "==", "value": 1 },
    { "do": "cmd", "note": "UTILITY L を押す：XTLua が動いているか", "name": "laminar/B747/button_switch/elec_util_L", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "UTILITY L の後", "drefs": [ "laminar/B747/button_switch/position[11]" ] },
    { "do": "check", "note": "UTILITY L が動く（XTLua のコマンドが動いている）", "dref": "laminar/B747/button_switch/position[11]", "op": "!=", "value": 0, "rel": "util" },
    { "do": "cmd", "note": "UTILITY L を戻す", "name": "laminar/B747/button_switch/elec_util_L", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "終わり", "drefs": [ "laminar/B747/button_switch/position[13]", "laminar/B747/button_switch/position[22]", "laminar/B747/button_switch/position[30]", "laminar/B747/button_switch/position[56]", "laminar/B747/button_switch/position[82]", "laminar/B747/toggle_switch/position[1]", "laminar/B747/electrical/bus/bat_main", "sim/flightmodel2/engines/engine_is_burning_fuel[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/type" ] }
  ]
}
