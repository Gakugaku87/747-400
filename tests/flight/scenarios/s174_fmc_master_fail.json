{
  "name": "s174_fmc_master_fail",
  "description": "6-1/6-2 段 11d2a（master FMC の故障）の X-Plane での確認。空中、成田の北の 3,000 ft、250 kt（機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、XAC へ DIRECT、LNAV と VNAV（MCP 36,000 ft の上昇）と A/T。FMC の選択が L のまま左 FMC を故障させると、LNAV と VNAV はモード故障（FMA の線、AUTOPILOT）、A/T は切れて AUTOTHROT DISC、3 台の CDU に TIMEOUT - RESELECT で <FMC なし（ATA22 p.382、ATA34_2 p.633、FCOM p.1275）、30 秒で FMC LEFT。FMC の選択を R にすると LNAV と VNAV がそのまま戻り（ATA34_2 p.633）、A/T は切れたまま、ARM スイッチを切って入れると戻る。右の CDU の <FMC で右 FMC。PFD と EICAS を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 914, "heading_true": 340, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "check", "note": "FMC の選択は L", "dref": "laminar/B747/flt_inst/fmc_master_src/ctr_pnl/sel_dial_pos", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "LEGS で XAC へ DIRECT TO、EXEC", "keys": ["LEGS", "XAC", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "set", "note": "MCP 高度 36,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 36000 },
    { "do": "sleep", "seconds": 3 },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "LNAV で engage", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 20 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "A/T は engage", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 1 },

    { "do": "mark", "note": "master FMC（左）の故障" },
    { "do": "set", "note": "左 FMC を故障させる", "dref": "laminar/B747/fms/fail[0]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV のモード故障（ATA22 p.382）", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "VNAV のモード故障", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 1 },
    { "do": "check", "note": "FMA は LNAV のまま（線つき）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "FMA は VNAV SPD のまま（線つき）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4 },
    { "do": "check", "note": ">AUTOPILOT", "dref": "laminar/B747/CAS/caution_status[4]", "op": "==", "value": 1 },
    { "do": "check", "note": "A/T は切れる（ATA34_2 p.633）", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 0 },
    { "do": "check", "note": ">AUTOTHROT DISC", "dref": "laminar/B747/CAS/caution_status[5]", "op": "==", "value": 1 },
    { "do": "check", "note": "左の CDU に TIMEOUT - RESELECT", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "TIMEOUT - RESELECT" },
    { "do": "check", "note": "右の CDU にも（飛行中に master を失う：FCOM p.1275）", "dref": "laminar/B747/fms2/Line14_L", "op": "contains", "value": "TIMEOUT - RESELECT" },
    { "do": "check", "note": "右の MENU に <FMC がない（選択が故障した FMC）", "dref": "laminar/B747/fms2/Line03_L", "op": "matches", "value": "^ {17}" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_master_fmc_fail" },
    { "do": "wait", "note": "EICAS に FMC LEFT（30 秒：LH3460 p.116）", "dref": "laminar/B747/CAS/advisory_status[144]", "op": "==", "value": 1, "timeout": 45 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_master_fmc_fail" },

    { "do": "mark", "note": "FMC の選択を R に" },
    { "do": "set", "note": "FMC の選択を R に", "dref": "laminar/B747/flt_inst/fmc_master_src/ctr_pnl/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV は戻る（ATA34_2 p.633）", "dref": "laminar/B747/autopilot/FMA/roll_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "VNAV も", "dref": "laminar/B747/autopilot/FMA/pitch_fail", "op": "==", "value": 0 },
    { "do": "check", "note": "LNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "VNAV のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "matches", "value": "^[456]" },
    { "do": "check", "note": "A/T は切れたまま（ATA34_2 p.633）", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/T の ARM スイッチを切る", "name": "laminar/B747/toggle_switch/autothrottle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "入れる（VNAV の間に入れると A/T が engage：FCOM p.641）", "name": "laminar/B747/toggle_switch/autothrottle" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "A/T が戻る", "dref": "laminar/B747/engines/autothrottle_active", "op": "==", "value": 1 },
    { "do": "cmd", "note": "右の CDU：CLR", "name": "laminar/B747/fms2/key/clear" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "右の MENU に <FMC", "dref": "laminar/B747/fms2/Line03_L", "op": "contains", "value": "<FMC" },
    { "do": "cmd", "note": "右の CDU：<FMC", "name": "laminar/B747/fms2/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "右の CDU は右 FMC", "dref": "laminar/B747/fms/cdu_link[2]", "op": "==", "value": 2 },
    { "do": "check", "note": "SINGLE FMC OPERATION（FCOM p.1275）", "dref": "laminar/B747/fms2/Line14_L", "op": "contains", "value": "SINGLE FMC OPERATION" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_master_fmc_r" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
