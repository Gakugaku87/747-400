{
  "name": "s136_fmc_pred_winds",
  "description": "6-1/6-2 段 8e3（予測が点ごとの風と降下予報を使う）の X-Plane での確認、空中。FL350・M.84 で RJAA の東から西へ空中開始（機体を読み直す）。s131 と同じ経路（RJAA→RJBB、DIRECT AKAGI、STAR ATMUGA、ILS06LY・遷移 GATES）を ACTIVATE と EXEC、PERF INIT で COST INDEX 100 と CRZ ALT FL350。CRZ のページの目的地の ETA/FUEL と T/D を記録し、WIND のページで AKAGI に FL350 の 250/100（ほぼ向かい風、すべての点に伝わる）を入れた後と、DESCENT FORECAST に FL200 250/080 を入れた後とで記録する。向かい風で目的地の ETA が遅れ燃料が減ることを、ログの記録で比べる（測った風が近くでは混ざるので、遅れは向かい風 100 kt だけの計算より小さい）。Lua の誤りも確かめる。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.6, "elevation_in_meters": 10668, "heading_true": 255, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、NEXT、DIRECT AKAGI（SELECT DESIRED WPT の最初）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "AKAGI", "R1", "?SEL"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>（R2：目的地）", "keys": ["R2"] },
    { "do": "check", "note": "RJBB ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJBB ARRIVALS" },
    { "do": "cdu", "note": "STAR ATMUGA（L1）、ILS06LY（R3）、遷移 GATES（R2）", "keys": ["L1", "R3", "R2"] },
    { "do": "check", "note": "<SEL>GATES", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<SEL>GATES" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "PERF INIT：COST INDEX 100、CRZ ALT FL350", "keys": ["INITREF", "L6", "L3", "100", "L5", "350", "R1"] },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "NEXT：CRZ", "keys": ["NEXT"] },
    { "do": "sleep", "seconds": 12, "note": "ECON と予測" },
    { "do": "check", "note": "ACT ECON CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ECON CRZ" },
    { "do": "check", "note": "目的地の ETA/FUEL（風なし）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "[0-9]{4}z/[0-9]+[.][0-9]$" },
    { "do": "snapshot", "note": "風なし：CRZ のページ（目的地の ETA/FUEL、T/D）と測った風", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "sim/cockpit2/gauges/indicators/wind_speed_kts", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag", "sim/cockpit2/clock_timer/zulu_time_hours", "sim/cockpit2/clock_timer/zulu_time_minutes" ] },
    { "do": "cdu", "note": "LEGS、RTE DATA>、1R：AKAGI の WIND", "keys": ["LEGS", "R6", "R1"] },
    { "do": "check", "note": "AKAGI WINDS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "AKAGI WINDS" },
    { "do": "cdu", "note": "FL350、250/100（ほぼ向かい風）", "keys": ["FL350", "L1", "250/100", "R4"] },
    { "do": "check", "note": "250/100", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "250`/100" },
    { "do": "sleep", "seconds": 12, "note": "予測（入力ですぐと 10 秒ごと）" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "NEXT：CRZ", "keys": ["NEXT"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "目的地の ETA/FUEL（向かい風）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "[0-9]{4}z/[0-9]+[.][0-9]$" },
    { "do": "snapshot", "note": "巡航の向かい風：CRZ のページ", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "sim/cockpit2/clock_timer/zulu_time_hours", "sim/cockpit2/clock_timer/zulu_time_minutes" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_crz_headwind" },
    { "do": "cdu", "note": "NEXT：DES、5R：DESCENT FORECAST、FL200 250/080", "keys": ["NEXT", "R5", "FL200", "L2", "250/080", "R2"] },
    { "do": "check", "note": "FL200 250/ 80", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "^FL200 +250`/ 80" },
    { "do": "sleep", "seconds": 12, "note": "予測" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "NEXT：CRZ", "keys": ["NEXT"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "降下予報も：CRZ のページ", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms/profile/kind[0]", "laminar/B747/fms/profile/lat[0]", "laminar/B747/fms/profile/lon[0]", "sim/cockpit2/clock_timer/zulu_time_hours", "sim/cockpit2/clock_timer/zulu_time_minutes" ] },
    { "do": "cdu", "note": "PROG", "keys": ["PROG"] },
    { "do": "snapshot", "note": "PROGRESS", "drefs": [ "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "shot", "name": "cdu_progress_winds" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
