{
  "name": "s350_flight_complete_cg",
  "description": "段 4 のレビュー CDU-2 = PERF-3（2026-11-24、notes/ATA-34-61-FMC.md §177.2）の X-Plane での確認。乗員が CG と CRZ CG を入れた便の flight complete の後、TAKEOFF REF が空白にならず CG はダッシュ（FCOM p.1320 (11.40.44)、ATA34_2 p.540）、PERF INIT の CRZ CG は既定の 20.0 が小さい字（FCOM p.1311 (11.40.35)）、FMC のトリム（laminar/B747/fmc/elevator_trim：緑の帯の選択）は 0。直す前は TAKEOFF REF の 13 行が全部空白で、次の便の ZFW でも戻らなかった。s163 と同じ RJAA 34L の進入路の 12 NM・2,500 ft から（機体を読み直す。重さは 243.5 t：OEW と燃料 60 t）、FMC に RJBB→RJAA の経路（ARRIVALS の ILS34L）と PERF INIT（ZFW 220、COST INDEX 100、CRZ ALT FL350）を入れて自動着陸。止まってから PERF INIT の CRZ CG 25.5 と TAKEOFF REF の CG 22（空中では TAKEOFF REF に行けない）、4 発の FUEL CONTROL を CUTOFF して 30 秒。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.572774, "longitude": 140.512164, "elevation_in_meters": 762.0, "heading_true": 329.6, "speed_in_meters_per_second": 92.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [0, 0, 0, 0, 0, 0, 0, 0, 0],
      "fueltank_weight_in_kilograms": [0, 7500, 22500, 22500, 7500, 0, 0, 0, 0]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 337（コース）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },
    { "do": "set", "note": "MCP 速度 170 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 170 },
    { "do": "set", "note": "レバー 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.6667 },
    { "do": "cmd", "note": "脚下げ", "name": "sim/flight_controls/landing_gear_down" },
    { "do": "cmd", "note": "スピードブレーキを ARM", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "set", "note": "オートブレーキ 2", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "value": 4 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD（G/S の下から水平に入る）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },

    { "do": "mark", "note": "FMC のデータ" },
    { "do": "cdu", "note": "RTE：RJBB→RJAA、FLT NO TEST123", "keys": ["RTE", "RJBB", "L1", "RJAA", "R1", "TEST123", "R2"] },
    { "do": "cmd", "note": "DEP ARR", "name": "laminar/B747/fms1/func_key/clb" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "cdu", "note": "ARR>、NEXT、ILS34L（R3）", "keys": ["R2", "NEXT", "R3"] },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "INIT REF（空中は APPROACH REF）、<INDEX、PERF：ZFW 220、COST INDEX 100、CRZ ALT FL350", "keys": ["INITREF", "L6", "L3", "220", "L3", "100", "L5", "350", "R1"] },
    { "do": "cdu", "note": "CLR を 3 回（進入中の CRZ ALT FL350 の UNABLE CRZ ALT：s163 と同じ）、RTE", "keys": ["CLR", "CLR", "CLR", "RTE"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ILS は FMC の A で 111.90", "dref": "sim/cockpit/radios/nav1_freq_hz", "op": "==", "value": 11190 },

    { "do": "mark", "note": "自動着陸" },
    { "do": "cmd", "note": "APP", "name": "laminar/B747/autopilot/approach" },
    { "do": "wait", "note": "G/S を捕まえる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 2, "timeout": 300 },
    { "do": "set", "note": "レバー 30", "dref": "sim/cockpit2/controls/flap_ratio", "value": 1.0 },
    { "do": "set", "note": "MCP 速度 150 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 150 },
    { "do": "wait", "note": "LAND 3", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 4, "timeout": 200 },
    { "do": "wait", "note": "FLARE", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 3, "timeout": 200 },
    { "do": "wait", "note": "ROLLOUT", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 4, "timeout": 30 },
    { "do": "wait", "note": "地上", "dref": "sim/flightmodel/failures/onground_any", "op": "==", "value": 1, "timeout": 60 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる（対地 8 m/s の下）", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 8, "timeout": 90 },
    { "do": "cmd", "note": "操縦輪の解除スイッチで A/P を外す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "AUTOPILOT DISC を消す（2 回目）", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },

    { "do": "mark", "note": "地上で乗員の CRZ CG と CG" },
    { "do": "cdu", "note": "CLR を 3 回、INIT REF、<INDEX、PERF", "keys": ["CLR", "CLR", "CLR", "INITREF", "L6", "L3"] },
    { "do": "check", "note": "PERF INIT", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF INIT" },
    { "do": "cdu", "note": "CRZ CG 25.5（R4）", "keys": ["25.5", "R4"] },
    { "do": "check", "note": "CRZ CG 25.5 は大きい字", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "25.5%" },
    { "do": "cdu", "note": "INIT REF、<INDEX、<TAKEOFF（地上）", "keys": ["INITREF", "L6", "L5"] },
    { "do": "check", "note": "TAKEOFF REF", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "cdu", "note": "CG 22（R4）", "keys": ["22", "R4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "CG 22 % は大きい字", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "22%" },
    { "do": "check", "note": "トリムは小さい字の数（FCOM p.1320）", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^.{16}[0-9]{1,2}[.][0-9]" },
    { "do": "check", "note": "FMC のトリムが緑の帯へ", "dref": "laminar/B747/fmc/elevator_trim", "op": ">", "value": 0 },

    { "do": "mark", "note": "エンジン停止" },
    { "do": "switch", "note": "FUEL CONTROL 1 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[0]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_1/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 2 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[1]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_2/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 3 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[2]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_3/toggle_switch" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "エンジン 1 の N2 が ENG FAIL の速さの下", "dref": "laminar/B747/engines/inop[0]", "op": "==", "value": 1, "timeout": 90 },
    { "do": "wait", "note": "エンジン 2", "dref": "laminar/B747/engines/inop[1]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "wait", "note": "エンジン 3", "dref": "laminar/B747/engines/inop[2]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "wait", "note": "エンジン 4（4 発とも止まった）", "dref": "laminar/B747/engines/inop[3]", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 34, "note": "停止から 30 秒を過ぎて flight complete" },
    { "do": "check", "note": "flight complete（FLT NO はダッシュ）", "dref": "laminar/B747/fms/data", "op": "contains", "value": "\"fltno\":\"--------\"" },

    { "do": "mark", "note": "flight complete の後" },
    { "do": "check", "note": "FMC のトリムは 0（緑の帯の選択は前の便のトリムでない）", "dref": "laminar/B747/fmc/elevator_trim", "op": "==", "value": 0 },
    { "do": "cdu", "note": "INIT REF、<INDEX、<TAKEOFF", "keys": ["INITREF", "L6", "L5"] },
    { "do": "check", "note": "TAKEOFF REF が出る（直す前は 13 行が空白）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF", "cite": "FCOM p.1320" },
    { "do": "check", "note": "CG はダッシュ（Initially displays dashes）", "dref": "laminar/B747/fms3/Line09_S", "op": "contains", "value": "--%", "cite": "FCOM p.1320" },
    { "do": "check", "note": "大きい字の CG は無い", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^[^%]*$" },
    { "do": "check", "note": "トリムは無い（17〜20 桁が空白）", "dref": "laminar/B747/fms3/Line09_S", "op": "matches", "value": "^.{16} {4}" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_takeoff_ref_after_fc" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF", "keys": ["INITREF", "L6", "L3"] },
    { "do": "check", "note": "CRZ CG は既定の 20.0 が小さい字", "dref": "laminar/B747/fms3/Line09_S", "op": "contains", "value": "20.0%", "cite": "FCOM p.1311" },
    { "do": "check", "note": "大きい字の CRZ CG は無い（RESERVES の箱だけ）", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^[*]{3}[.][*] *$" },
    { "do": "shot", "name": "cdu_perf_init_after_fc" },
    { "do": "cdu", "note": "次の便：ZFW 230（L3）、INIT REF、<INDEX、<TAKEOFF", "keys": ["230", "L3", "INITREF", "L6", "L5"] },
    { "do": "check", "note": "TAKEOFF REF が出る（直す前は ZFW でも戻らなかった）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "TAKEOFF REF" },
    { "do": "check", "note": "CG はダッシュのまま", "dref": "laminar/B747/fms3/Line09_S", "op": "contains", "value": "--%" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
