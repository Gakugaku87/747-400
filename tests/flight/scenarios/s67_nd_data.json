{
  "name": "s67_nd_data",
  "description": "ND の DATA（5-2 段 5c-2a）の X-Plane での確認、空中。フランクフルトの南 4,000 ft・200 kt・北向きで開始。FlyWithLua の B747_route.lua で X-Plane の FMS に NDB FR（現用点、5000 ft）、TAU（20000 ft）、EDDF（高度なし）を入れる。機長の DATA を入れると、ND の経路の点の下に高度と FMC の ETA（現用点はマゼンタ、ほかは白。高度の無い点は ETA を 1 行目に）が出る（FCOM p.1040、p.1148、FMSPG p.50）。副操縦士は DATA を入れない。PLN でも出る。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 49.900000, "longitude": 8.683488, "elevation_in_meters": 1219.2, "heading_true": 0.0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 360", "dref": "laminar/B747/autopilot/heading/degrees", "value": 360 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "set", "note": "範囲は両側 40 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "set", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range_copilot", "value": 2 },

    { "do": "route", "note": "経路：NDB FR（現用点、5000 ft、出発点の 10 NM 北）、TAU（20000 ft）、EDDF（高度なし）",
      "entries": ["FR 50.07 8.68 5000 ACTIVE", "TAU 50.25 8.16 20000", "EDDF 50.04 8.56 0"] },
    { "do": "wait", "note": "FMC が各点の ETA を出す", "dref": "laminar/B747/fms/route_eta", "op": "contains", "value": ",", "timeout": 20 },
    { "do": "wait", "note": "ND の 1 枠目に現用点 FR（マゼンタの文字）", "dref": "laminar/B747/nd/capt/text/redtext0", "op": "==", "value": "FR", "timeout": 20 },
    { "do": "check", "note": "DATA を入れる前は経路のデータ無し", "dref": "laminar/B747/nd/capt/text/rdata_color[0]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "機長の DATA", "name": "laminar/B747/nd/data/capt/switch" },
    { "do": "wait", "note": "FR のデータはマゼンタ", "dref": "laminar/B747/nd/capt/text/rdata_color[0]", "op": "==", "value": 2, "timeout": 5 },
    { "do": "check", "note": "FR の高度 5000", "dref": "laminar/B747/nd/capt/text/rdata1_0", "op": "==", "value": "5000" },
    { "do": "wait", "note": "FR の ETA（HHMMZ。ND は FMC の ETA を 2 秒ごとに読む）", "dref": "laminar/B747/nd/capt/text/rdata2_0", "op": "contains", "value": "Z", "timeout": 10 },
    { "do": "check", "note": "2 枠目は TAU（白）", "dref": "laminar/B747/nd/capt/text/whitetext1", "op": "==", "value": "TAU" },
    { "do": "check", "note": "TAU のデータは白", "dref": "laminar/B747/nd/capt/text/rdata_color[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "TAU の高度は遷移高度より上なので FL200", "dref": "laminar/B747/nd/capt/text/rdata1_1", "op": "==", "value": "FL200" },
    { "do": "check", "note": "TAU の ETA", "dref": "laminar/B747/nd/capt/text/rdata2_1", "op": "contains", "value": "Z" },
    { "do": "check", "note": "3 枠目は EDDF", "dref": "laminar/B747/nd/capt/text/whitetext2", "op": "==", "value": "EDDF" },
    { "do": "check", "note": "EDDF は高度が無いので 1 行目に ETA", "dref": "laminar/B747/nd/capt/text/rdata1_2", "op": "contains", "value": "Z" },
    { "do": "check", "note": "2 行目は空", "dref": "laminar/B747/nd/capt/text/rdata2_2", "op": "==", "value": " " },
    { "do": "check", "note": "副操縦士の ND は DATA を入れていないので無し", "dref": "laminar/B747/nd/fo/text/rdata_color[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の ND にも経路（FR）", "dref": "laminar/B747/nd/fo/text/redtext0", "op": "==", "value": "FR" },
    { "do": "snapshot", "note": "経路のデータ", "drefs": ["laminar/B747/fms/route_eta", "laminar/B747/nd/capt/text/rdata2_0", "laminar/B747/nd/capt/text/rdata2_1", "laminar/B747/nd/capt/text/rdata1_2", "laminar/B747/nd/waypoint_eta"] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_data_map" },
    { "do": "view", "note": "副操縦士の ND", "the": -19, "psi": 47, "fov": 20 },
    { "do": "shot", "name": "nd_data_fo_off" },

    { "do": "switch", "note": "機長の ND を PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "PLN でも FR のデータ（FCOM p.1040）", "dref": "laminar/B747/nd/capt/text/rdata_color[0]", "op": "==", "value": 2 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_data_pln" },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "cmd", "note": "機長の DATA を切る", "name": "laminar/B747/nd/data/capt/switch" },
    { "do": "wait", "note": "データが消える", "dref": "laminar/B747/nd/capt/text/rdata_color[0]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "route_clear", "note": "経路を消す" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
