{
  "name": "s100_afds_roll",
  "description": "AFDS の作り直し 6-3 段 1b（ロールのモード：HDG SEL・HDG HOLD・ATT・LNAV）の X-Plane での確認、空中。10,000 ft・約 290 kt で空中から始め（機体を読み直す）、FMS の空中の初期化が終わるのを待ってから（A/P CMD L・ALT・HDG HOLD）、HDG SEL で 30° 右へ旋回して方位に乗る、LNAV を arm しても HDG SEL のまま・もう一度 HDG SEL を押しても arm のまま・2 回目の LNAV で disarm（FCOM p.644、ATA22 p.354）、旋回中に HDG HOLD（3D のボタンの X-Plane のコマンド）で翼を水平にしてからその時の方位を保つ（ATA22 図 p.353）、旋回中に A/P を外して F/D を両方 OFF、バンクのまま F/D L ON で ATT（5° を超えるバンク：FCOM p.640、p.663）、CMD C で A/P が ATT のバンクを保つ、HDG SEL で ATT が終わる。PFD を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残り（ALT HOLD、目標の速度・方位）が終わるのを待つ" },
    { "do": "check", "note": "F/D の既定の HDG HOLD", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },

    { "do": "mark", "note": "HDG SEL（FCOM p.647）" },
    { "do": "set", "note": "MCP 方位を 30° 右（空中開始の磁方位 347 から 017）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 17 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "wait", "note": "右へ旋回（バンク 10° 以上）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 10, "timeout": 15 },
    { "do": "wait", "note": "方位 017 付近（±3°）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [14, 20], "timeout": 90 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "翼を水平に戻す（±5°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-5, 5] },

    { "do": "mark", "note": "LNAV の arm と disarm（FCOM p.644、ATA22 p.354）" },
    { "do": "cmd", "note": "LNAV（経路は無いので arm のまま）", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV arm", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 1 },
    { "do": "check", "note": "FMA の LNAV（arm）", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "HDG SEL のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：HDG SEL、LNAV の arm", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_hdg_sel_lnav_armed" },
    { "do": "cmd", "note": "もう一度 HDG SEL（LNAV の arm は消えない）", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV は arm のまま（前は消えた）", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 1 },
    { "do": "cmd", "note": "2 回目の LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "disarm", "dref": "laminar/B747/autopilot/lnav_state", "op": "==", "value": 0 },
    { "do": "check", "note": "FMA の arm も消える", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 0 },

    { "do": "mark", "note": "旋回中の HDG HOLD（ATA22 図 p.353）" },
    { "do": "set", "note": "MCP 方位 060（右へ）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 60 },
    { "do": "wait", "note": "方位 060 付近（±3°）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [57, 63], "timeout": 90 },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "MCP 方位 330（左へ）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 330 },
    { "do": "wait", "note": "左へ旋回（バンク 15° 以上）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "<", "value": -15, "timeout": 20 },
    { "do": "cmd", "note": "HDG HOLD（3D のボタンは X-Plane のコマンド）", "name": "sim/autopilot/heading_hold" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の HDG HOLD はすぐ", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7 },
    { "do": "wait", "note": "翼を水平に戻す（3° 未満）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3], "timeout": 20 },
    { "do": "sleep", "seconds": 5, "note": "3° 未満で 2 秒の後、その時の方位を保つ" },
    { "do": "remember", "dref": "sim/flightmodel/position/mag_psi", "as": "hdg_hold" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "方位を保つ（20 秒で ±2°）", "dref": "sim/flightmodel/position/mag_psi", "op": "between", "value": [-2, 2], "rel": "hdg_hold" },
    { "do": "view", "note": "機長の PFD：HDG HOLD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_hdg_hold" },

    { "do": "mark", "note": "ATT（FCOM p.640、p.663）" },
    { "do": "set", "note": "MCP 方位 150（右へ）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 150 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "wait", "note": "右へ旋回（バンク 15° 以上）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 15, "timeout": 20 },
    { "do": "cmd", "note": "操縦輪の A/P 解除ボタン", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "もう一度押して AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "F/D L OFF（両方 OFF：全モードを消す）", "name": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ロールのモード無し", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "まだ 5° を超えるバンク", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 6 },
    { "do": "cmd", "note": "F/D L ON：ATT", "name": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の ATT", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 5 },
    { "do": "cmd", "note": "A/P CMD C（F/D のモードの ATT で engage）", "name": "laminar/B747/autopilot/button_switch/cmd_C" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "A/P も ATT", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 5 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "as": "bank_att" },
    { "do": "check", "note": "バンクは 5〜30°", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [5, 30] },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "A/P がそのバンクを保つ（10 秒で ±3°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-3, 3], "rel": "bank_att" },
    { "do": "view", "note": "機長の PFD：ATT", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_att" },
    { "do": "cmd", "note": "HDG SEL で ATT が終わる", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMA の HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
