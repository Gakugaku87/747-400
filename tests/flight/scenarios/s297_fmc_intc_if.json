{
  "name": "s297_fmc_intc_if",
  "description": "(INTC) の次が IF の進入のトランジション（2026-11-12 のフルレビュー FMC-3：REVIEW_2026-11-12.md 案 7）の X-Plane での確認。本物の航法データの RJAA（AIRAC 2611）の ILS16R Y、トランジション LAKES：LAKES（IF）→ D346M（DME の弧 AF）→ (INTC)（VI）→ KONAN（IF）→ TENAG（CF）。LAKES の 8 NM 東の 6,000 ft・250 kt の空中開始（270 t）。RTE RJCC→RJAA、ARRIVALS で ILS16RY と TRANS LAKES、ACTIVATE・EXEC、LNAV だけで飛ぶ（高度は ALT HOLD）。前：(INTC) の会合の相手が IF の KONAN（コースが無い）で、(INTC) が順送りされず方位のまま飛び続けた（模型で 600 秒、最終進入コースから 17 NM）。直した後（FCOM p.1249：(INTC) は次の点へのコースへの会合。IF の次の CF のコースへ）：(INTC) が順送りされて KONAN・TENAG へ進み、KONAN→TENAG の上で XTK 0.5 NM 以内。弧は最終進入コースの近くで終わるので、(INTC) と KONAN が現用なのは一瞬（2026-11-13 の 1 回目は読み取りが拾えず、TENAG・RW16R まで進んでいた）：TENAG か滑走路が現用になるのを待つ",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.9514, "longitude": 140.6642, "elevation_in_meters": 1829, "heading_true": 275, "speed_in_meters_per_second": 136 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 0, 0, 0, 0, 0, 0, 0, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 0, 13499.4, 29767.9, 29767.9, 13499.4, 0, 0, 0, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120, "stop": true },
    { "do": "cdu", "note": "CLR、RTE：RJCC→RJAA", "keys": ["CLR", "CLR", "CLR", "RTE", "RJCC", "L1", "RJAA", "R1"] },
    { "do": "cdu", "note": "DEP ARR（経路が有効でない：DEP/ARR INDEX）、ARR>（R2）", "keys": ["DEPARR", "R2"] },
    { "do": "wait", "note": "RJAA ARRIVALS", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "RJAA ARRIVALS", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "2 ページ目", "keys": ["NEXT"] },
    { "do": "check", "note": "2 ページ目の 1R が ILS16RY", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "ILS16RY$", "stop": true },
    { "do": "cdu", "note": "ILS16RY（1R）、1 ページ目へ", "keys": ["R1", "PREV"] },
    { "do": "check", "note": "TRANS の 3R が LAKES", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "LAKES$", "stop": true },
    { "do": "cdu", "note": "TRANS LAKES（3R）", "keys": ["R3"] },
    { "do": "wait", "note": "<SEL>LAKES", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "<SEL>LAKES$", "timeout": 10, "stop": true },
    { "do": "cdu", "note": "RTE、ACTIVATE（6R）、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "cdu", "note": "LAKES へ DIRECT TO（1L）、EXEC：現在位置から LAKES への脚にする（2026-11-13 の 1 回目は、ACTIVATE のままの出発地からの脚 DTK 187° の 5.9 NM 横で LNAV が入らなかった）", "keys": ["LAKES", "L1", "EXEC"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "LEGS 1 ページ目", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "現用の点は LAKES（現在位置から直行）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^LAKES", "stop": true },
    { "do": "check", "note": "LAKES の後に D346M・(INTC)・KONAN", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^\\(INTC\\)", "stop": true },
    { "do": "record_start" },
    { "do": "cmd", "note": "LNAV", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "wait", "note": "FMA：LNAV", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 2, "timeout": 30, "stop": true },
    { "do": "mark", "note": "LAKES、DME の弧、(INTC)" },
    { "do": "wait", "note": "LAKES を過ぎて D346M（DME の弧）が現用", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^D346M", "timeout": 240, "stop": true },
    { "do": "wait", "note": "(INTC) と KONAN が順送りされて TENAG か RW16R が現用（前は (INTC) のまま方位で飛び続け、順送りされない。(INTC)・KONAN が現用なのは一瞬）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^(TENAG|RW16R)", "timeout": 300, "stop": true },
    { "do": "snapshot", "note": "その時の脚", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/lnav/mode", "laminar/B747/fms/lnav/xtk", "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot" ] },
    { "do": "mark", "note": "TENAG（か RW16R）" },
    { "do": "sleep", "seconds": 30, "note": "最終進入コースへの旋回に入る" },
    { "do": "wait", "note": "最終進入コースに乗る：XTK ±0.3 NM（1 回目は旋回で 1.67 NM 行き過ぎ、100 秒で 0.12 NM）", "dref": "laminar/B747/fms/lnav/xtk", "op": "between", "value": [-0.3, 0.3], "timeout": 150, "stop": true },
    { "do": "watch", "note": "最終進入コースの上：XTK 0.5 NM 以内（20 秒）", "dref": "laminar/B747/fms/lnav/xtk", "abs": true, "max": 0.5, "timeout": 20 },
    { "do": "check", "note": "LNAV は経路の上（mode 1）", "dref": "laminar/B747/fms/lnav/mode", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "最終進入コースの脚", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms/lnav/mode", "laminar/B747/fms/lnav/xtk", "laminar/B747/fms/lnav/dtk", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "record_stop" }
  ]
}
