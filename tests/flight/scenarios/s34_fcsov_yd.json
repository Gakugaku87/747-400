    { "do": "mark", "note": "WING 1 SHUT OFF" },
    { "do": "cmd", "note": "WING 1 を SHUT OFF", "name": "laminar/B747/flt_ctrls/hyd_power/wing_1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "弁が動いている間から VALVE CLOSED（全開でない：FCOM p.940）", "dref": "laminar/B747/annunciator/brightness_ratio[80]", "op": ">", "value": 0 },
    { "do": "check", "note": ">FLT CONT VLVS（FCOM p.957）", "dref": "laminar/B747/CAS/advisory_status[143]", "op": "==", "value": 1 },
    { "do": "wait", "note": "弁が閉じる（2 秒：推定）", "dref": "laminar/B747/flt_ctrls/hyd_power/wing_valve_shut[0]", "op": "==", "value": 1, "timeout": 4 },
    { "do": "cas", "note": ">FLT CONT VLVS" },
    { "do": "cmd", "note": "WING 3 も SHUT OFF", "name": "laminar/B747/flt_ctrls/hyd_power/wing_3" },
    { "do": "wait", "note": "WING 3 の弁が閉じる", "dref": "laminar/B747/flt_ctrls/hyd_power/wing_valve_shut[2]", "op": "==", "value": 1, "timeout": 4 },
    { "do": "set", "note": "操縦輪を右へ半分", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0.5 },
    { "do": "sleep", "seconds": 3 },
