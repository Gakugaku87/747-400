{
  "name": "s34_fcsov_yd",
  "description": "FLT CONTROL HYD POWER とヨーダンパー（4-1 段 4 の後半：FCOM p.931、p.940、p.949、p.957–958、ATA27 p.10–14、p.20–24、p.40）の X-Plane での確認、地上。RJAA 34L でエンジン運転中、駐機ブレーキ。遮断スイッチ（3D に無いのでコマンド laminar/B747/flt_ctrls/hyd_power/wing_1 など）で弁が 2 秒（推定）で閉じ、VALVE CLOSED 灯と >FLT CONT VLVS。WING 1 と 3 を閉じると左内側エルロン（系統 1・3）は動かず、右内側（2・4）は動く。TAIL 3 を閉じても上のヨーダンパーの INOP は出ない（油圧の喪失による故障の表示は抑止：ATA27 p.40）。ヨーダンパーのスイッチ OFF と故障（laminar/B747/flt_ctrls/fail/yaw_damper）で INOP と >YAW DAMPER UPR、LWR。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
