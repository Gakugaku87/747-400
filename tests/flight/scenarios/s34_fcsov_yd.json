    { "do": "check", "note": "右内側エルロン（系統 2・4）は上げ 20°", "dref": "laminar/B747/flt_ctrls/r_aileron_inner", "op": "<", "value": -19.9 },
    { "do": "check", "note": "左外側エルロン（系統 1・2）は系統 2 で動く", "dref": "laminar/B747/flt_ctrls/l_aileron_outer", "op": ">", "value": 14.9 },
    { "do": "set", "note": "操縦輪を中立", "dref": "sim/cockpit2/controls/yoke_roll_ratio", "value": 0 },
    { "do": "cmd", "note": "WING 1 を NORM", "name": "laminar/B747/flt_ctrls/hyd_power/wing_1" },
    { "do": "cmd", "note": "WING 3 を NORM", "name": "laminar/B747/flt_ctrls/hyd_power/wing_3" },
    { "do": "wait", "note": "全部開いて >FLT CONT VLVS が消える", "dref": "laminar/B747/CAS/advisory_status[143]", "op": "==", "value": 0, "timeout": 4 },
    { "do": "check", "note": "VALVE CLOSED（WING 1）が消える", "dref": "laminar/B747/annunciator/brightness_ratio[80]", "op": "==", "value": 0 },

    { "do": "mark", "note": "TAIL 3" },
    { "do": "cmd", "note": "TAIL 3 を SHUT OFF", "name": "laminar/B747/flt_ctrls/hyd_power/tail_3" },
    { "do": "wait", "note": "TAIL 3 の弁が閉じる", "dref": "laminar/B747/flt_ctrls/hyd_power/tail_valve_shut[2]", "op": "==", "value": 1, "timeout": 4 },
    { "do": "check", "note": "VALVE CLOSED（TAIL 3）", "dref": "laminar/B747/annunciator/brightness_ratio[86]", "op": ">", "value": 0 },
    { "do": "check", "note": "上のヨーダンパーは油圧を失っても INOP にならない（ATA27 p.40）", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 1 },
    { "do": "check", "note": ">YAW DAMPER UPR なし", "dref": "laminar/B747/CAS/advisory_status[301]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "TAIL 3 を NORM", "name": "laminar/B747/flt_ctrls/hyd_power/tail_3" },
    { "do": "wait", "note": "開く", "dref": "laminar/B747/CAS/advisory_status[143]", "op": "==", "value": 0, "timeout": 4 },

    { "do": "mark", "note": "ヨーダンパー" },
    { "do": "cmd", "note": "YAW DAMPER UPPER スイッチ OFF", "name": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "スイッチ OFF：上のヨーダンパーは働かない", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 0 },
    { "do": "check", "note": "INOP 灯（FCOM p.931）", "dref": "laminar/B747/annunciator/brightness_ratio[67]", "op": ">", "value": 0 },
    { "do": "check", "note": ">YAW DAMPER UPR（FCOM p.958）", "dref": "laminar/B747/CAS/advisory_status[301]", "op": "==", "value": 1 },
    { "do": "cmd", "note": "YAW DAMPER UPPER スイッチ ON", "name": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "戻る", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 1 },
    { "do": "set", "note": "下のヨーダンパーのモジュールの故障", "dref": "laminar/B747/flt_ctrls/fail/yaw_damper[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "下のヨーダンパーは INOP", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 0 },
    { "do": "check", "note": "YAW DAMPER LOWER INOP 灯", "dref": "laminar/B747/annunciator/brightness_ratio[68]", "op": ">", "value": 0 },
    { "do": "check", "note": ">YAW DAMPER LWR", "dref": "laminar/B747/CAS/advisory_status[300]", "op": "==", "value": 1 },
    { "do": "cas", "note": ">YAW DAMPER LWR" },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/yaw_damper[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "戻る", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 1 }
