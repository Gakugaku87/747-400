      "laminar/B747/flt_mgmt/iru/status", "laminar/B747/electrical/bus/stby_main", "laminar/B747/flt_ctrls/hyd_power/wing_valve_shut" ] },
    { "do": "check", "note": "上のヨーダンパーは働く（エンジン運転中の開始で IRU は整列済み）", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 1 },
    { "do": "check", "note": "下のヨーダンパーも", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 1 },
    { "do": "check", "note": "YAW DAMPER UPPER INOP 灯は消えている", "dref": "laminar/B747/annunciator/brightness_ratio[67]", "op": "==", "value": 0 },
    { "do": "check", "note": "弁は全部開：>FLT CONT VLVS なし", "dref": "laminar/B747/CAS/advisory_status[143]", "op": "==", "value": 0 },
