{
  "name": "s209_ind_lights",
  "description": "照明の 7-2c・7-2d（notes/ATA-33.md §13・§14）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す。夜なので IND LTS は DIM で始まる）。STORM が OFF で始まること（前は ON の position 0 のまま）。DIM で無線パネルのガラス（[253]）が 0.4、STORM ON で 0.8、BRT で 0.8 のこと（FCOM p.501）。TEST を 8 秒押して、表示灯（GND PROX、[2]）が BRT（0.8。前は 1.0）で点き、離すと消えること。10 秒での減光は、Web API がコマンドを 10 秒までしか押し続けられないので回帰試験（tests/lighting）だけで見る。TEST 中の頭上パネルを撮る。7-2d：EMER LIGHTS が ARMED で始まり、コマンドで OFF にすると >EMER LIGHTS が出て、ARMED に戻すと消え、客室側のスイッチで点いて >EMER LIGHTS が出ること。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 22.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "STORM は OFF（position 1）で始まる（前は ON の 0 のまま）", "dref": "laminar/B747/toggle_switch/position[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "夜なので IND LTS は DIM（-1）で始まる", "dref": "laminar/B747/toggle_switch/position[13]", "op": "==", "value": -1 },
    { "do": "check", "note": "DC bus 1 が通電", "dref": "laminar/B747/electrical/bus/dc[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "GND PROX は消えている（TEST の確認に使う）", "dref": "laminar/B747/annunciator/brightness_ratio[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "DIM：無線パネルのガラスは 0.4", "dref": "laminar/B747/annunciator/brightness_ratio[253]", "op": "between", "value": [0.39, 0.41] },
    { "do": "switch", "note": "STORM を ON（position 0）", "dref": "laminar/B747/toggle_switch/position[0]", "value": 0, "cmd": "laminar/B747/toggle_switch/storm_light" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "STORM ON：DIM でも BRT（0.8）", "dref": "laminar/B747/annunciator/brightness_ratio[253]", "op": "between", "value": [0.79, 0.81], "cite": "FCOM p.501" },
    { "do": "switch", "note": "STORM を OFF", "dref": "laminar/B747/toggle_switch/position[0]", "value": 1, "cmd": "laminar/B747/toggle_switch/storm_light" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "STORM OFF：DIM に戻る", "dref": "laminar/B747/annunciator/brightness_ratio[253]", "op": "between", "value": [0.39, 0.41] },
    { "do": "switch", "note": "IND LTS を BRT（0）", "dref": "laminar/B747/toggle_switch/position[13]", "value": 0, "cmd": "laminar/B747/toggle_switch/ind_light_up", "cmd_down": "laminar/B747/toggle_switch/ind_light_down" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "BRT：無線パネルのガラスは 0.8", "dref": "laminar/B747/annunciator/brightness_ratio[253]", "op": "between", "value": [0.79, 0.81] },
    { "do": "view", "note": "頭上パネル", "name": "overhead" },
    { "do": "cmd", "note": "TEST を 8 秒押す", "name": "laminar/B747/toggle_switch/ind_light_up", "duration": 8, "async": true },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "TEST：GND PROX が BRT（0.8。前は 1.0）", "dref": "laminar/B747/annunciator/brightness_ratio[2]", "op": "between", "value": [0.79, 0.81], "cite": "ATA33 p.67" },
    { "do": "shot", "name": "overhead_ind_test" },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "TEST を 6 秒押しても BRT のまま", "dref": "laminar/B747/annunciator/brightness_ratio[2]", "op": "between", "value": [0.79, 0.81] },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "TEST を離すと BRT に戻る", "dref": "laminar/B747/toggle_switch/position[13]", "op": "==", "value": 0 },
    { "do": "check", "note": "TEST を離すと GND PROX は消える", "dref": "laminar/B747/annunciator/brightness_ratio[2]", "op": "==", "value": 0 },
    { "do": "view", "name": "forward" },
    { "do": "check", "note": "7-2d：EMER LIGHTS は ARMED（1）で始まる", "dref": "laminar/B747/light/emer/switch", "op": "==", "value": 1 },
    { "do": "check", "note": "ARMED で DC bus 4 があるので非常灯は消えている", "dref": "laminar/B747/light/emer/lit", "op": "==", "value": 0 },
    { "do": "check", "note": ">EMER LIGHTS は出ていない", "dref": "laminar/B747/CAS/advisory_status[108]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "EMER LIGHTS を OFF へ（コマンド。3D にスイッチは無い）", "name": "laminar/B747/light/emer/switch_off" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "OFF：>EMER LIGHTS が出る", "dref": "laminar/B747/CAS/advisory_status[108]", "op": "==", "value": 1, "cite": "FCOM p.547" },
    { "do": "cas", "note": "EICAS の表示" },
    { "do": "cmd", "note": "EMER LIGHTS を ARMED へ戻す", "name": "laminar/B747/light/emer/switch_on" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ARMED：>EMER LIGHTS が消える", "dref": "laminar/B747/CAS/advisory_status[108]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "客室側のスイッチを押す", "name": "laminar/B747/light/emer/cabin" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "客室側で点灯", "dref": "laminar/B747/light/emer/lit", "op": "==", "value": 1, "cite": "FCOM p.453" },
    { "do": "check", "note": "客室側で点けると >EMER LIGHTS", "dref": "laminar/B747/CAS/advisory_status[108]", "op": "==", "value": 1, "cite": "FCOM p.547" },
    { "do": "cmd", "note": "客室側のスイッチをもう一度押して消す", "name": "laminar/B747/light/emer/cabin" },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "消える", "dref": "laminar/B747/light/emer/lit", "op": "==", "value": 0 }
  ]
}
