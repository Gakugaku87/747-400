  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMC の空中の初期化" },
    { "do": "wait", "note": "FMC の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 90, "level": "warn" },
    { "do": "switch", "note": "CMD L（初期化が入れていなければ）", "dref": "laminar/B747/autopilot/servos_on", "value": 1, "cmd": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "sleep", "seconds": 8 },
    { "do": "set", "note": "MCP 高度 FL370", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 37000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 37000 },
    { "do": "set", "note": "MCP を Mach に", "dref": "sim/cockpit2/autopilot/airspeed_is_mach", "value": 1 },
    { "do": "set", "note": "窓 M.85", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 85 },
    { "do": "set", "note": "MCP 方位 098（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 98 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "switch", "note": "ALT（違えば押す）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "value": 9, "cmd": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "FMA の A/T が SPD", "dref": "laminar/B747/autopilot/FMA/autothrottle_mode", "op": "==", "value": 3, "timeout": 10, "level": "warn" },
    { "do": "wait", "note": "Mach が .85 の近く", "dref": "sim/flightmodel/misc/machno", "op": "between", "value": [0.844, 0.856], "timeout": 300, "level": "warn" },
    { "do": "sleep", "seconds": 240, "note": "落ち着かせる（1 回目は 90 秒で、A/T がまだ EPR を 1.26 から 1.15 へ下げていた）" },
    { "do": "record_start" },
    { "do": "check", "note": "GE", "dref": "laminar/B747/engines/type", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "巡航の N1・EGT・推力", "drefs": [ "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N1[3]", "sim/flightmodel/engine/ENGN_N1_[0]", "laminar/B747/engines/display_GE_EGT[0]", "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/flightmodel/engine/ENGN_thro_use[0]", "laminar/B747/engines/display_N1_max[0]", "laminar/B747/engines/display_N1_ref[0]", "sim/weather/aircraft/temperature_leadingedge_deg_c", "sim/flightmodel/misc/machno", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "表示の N1 は本当の Mach の式（約 92 %。Mach 0 なら約 83 %）", "dref": "laminar/B747/engines/display_N1[0]", "op": "between", "value": [88, 97] },
    { "do": "check", "note": "EGT は約 620 °C（推定）", "dref": "laminar/B747/engines/display_GE_EGT[0]", "op": "between", "value": [560, 680] },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 24 },
    { "do": "shot", "name": "eicas_ge_cruise" },
    { "do": "view", "name": "forward" },
    { "do": "sleep", "seconds": 30 },
    { "do": "record_stop" }
  ]
}
