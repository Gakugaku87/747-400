{
  "name": "s213_vspeeds",
  "description": "V 速度の作り直し（notes/ATA-34-61-FMC.md §128）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。ZFW 130 t（総重量は 130 t と積んである燃料：約 200〜240 t）・フラップ 20 で TAKEOFF REF の V1・VR・V2 が FCOM の VMCG・VRMIN で下限を取ること（約 121/124/144〜146。前は表のまま 90/104/131 ほど）、THRUST LIM の TO 2（PW 20 %）で TO 2 の最小値（108/111）以上になること（2026-11-14 から FPPM の表）、SEL 45℃ で D-TO 2 になり最小値は実際の外気温のままのこと、APPROACH REF が FMC の総重量と FCOM PI.10.2 の VREF を出し、PFD の VREF 30 も FMC の dataref と同じになることを確かめる。CDU と PFD を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "新しいコードを読んだ（FMC の VREF の dataref がある）", "dref": "laminar/B747/fms/vref30", "op": ">", "value": 100 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 130", "keys": ["INITREF", "L6", "L3", "130", "L3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "FMC の総重量（GR WT、計算値の小さい字）が出た：130 t と燃料", "dref": "laminar/B747/fms3/Line03_S", "op": "matches", "value": "^ *2[0-4][0-9][.][0-9]" },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20", "keys": ["L6", "L5", "20", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "条件と計算した V 速度", "drefs": [ "laminar/B747/airspeed/V1_ref", "laminar/B747/airspeed/Vr_ref", "laminar/B747/airspeed/V2_ref", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/flightmodel2/position/pressure_altitude", "sim/flightmodel/weight/m_total", "sim/flightmodel/weight/m_fuel_total", "laminar/B747/engines/type", "laminar/B747/fms/thrlim/code", "laminar/B747/fms/thrlim/to_pct", "laminar/B747/fms/thrlim/sel" ] },
    { "do": "check", "note": "V1 は VMCG（海面・15℃ 前後で 121）で下限（前は表の 90 ほど）", "dref": "laminar/B747/airspeed/V1_ref", "op": "between", "value": [119, 123], "cite": "FCOM PI.10.10, PI.18.11" },
    { "do": "check", "note": "VR は VRMIN（124）で下限（前は 104 ほど）", "dref": "laminar/B747/airspeed/Vr_ref", "op": "between", "value": [122, 126], "cite": "FCOM PI.10.10" },
    { "do": "check", "note": "V2 は VRMIN のときの V2（144〜146）（前は 131 ほど）", "dref": "laminar/B747/airspeed/V2_ref", "op": "between", "value": [142, 148], "cite": "FCOM PI.10.10" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_takeoff_ref" },
    { "do": "cdu", "note": "<INDEX、<THRUST LIM、<-20 % TO 2", "keys": ["L6", "L4", "L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "TO 2（20 %）", "dref": "laminar/B747/fms/thrlim/to_pct", "op": "==", "value": 20 },
    { "do": "check", "note": "TO 2 の V1 は VMCG（108）以上（2026-11-14 から FPPM の表：220 t より重いと表の値の方が上）", "dref": "laminar/B747/airspeed/V1_ref", "op": ">=", "value": 108, "cite": "FCOM PI.10.33, FPPM p.67" },
    { "do": "check", "note": "TO 2 の VR は VRMIN（111）以上（FPPM の表：200〜240 t で 111〜126）", "dref": "laminar/B747/airspeed/Vr_ref", "op": ">=", "value": 111, "cite": "FCOM PI.10.33, FPPM p.67" },
    { "do": "cdu", "note": "SEL 45℃（D-TO 2）", "keys": ["45", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "D-TO 2", "dref": "laminar/B747/fms/thrlim/code", "op": "==", "value": 112 },
    { "do": "snapshot", "note": "D-TO 2 の V 速度", "drefs": [ "laminar/B747/airspeed/V1_ref", "laminar/B747/airspeed/Vr_ref", "laminar/B747/airspeed/V2_ref", "laminar/B747/fms/thrlim/eicas" ] },
    { "do": "check", "note": "最小値は実際の外気温のまま：V1 は TO 2 の VMCG（108）以上（45℃ の区分 E の表は 200 t で 104）", "dref": "laminar/B747/airspeed/V1_ref", "op": ">=", "value": 108, "cite": "FAA AC 25-13 5.b, FPPM p.67" },
    { "do": "shot", "name": "cdu_thrust_lim_dto2" },
    { "do": "cdu", "note": "<TO、SEL を消す", "keys": ["L2", "DEL", "L1"] },
    { "do": "cdu", "note": "<INDEX、<APPROACH", "keys": ["L6", "L6"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "GROSS WT は FMC の総重量（前は X-Plane の重量）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^2[0-4][0-9][.][0-9]" },
    { "do": "check", "note": "VREF 25（FCOM PI.10.2：200〜250 t で 132〜149）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "1[34][0-9] *$" },
    { "do": "check", "note": "VREF 30（127〜143）", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "1[234][0-9] *$" },
    { "do": "check", "note": "PFD の VREF 30 も FMC の重量から（127〜143）", "dref": "laminar/B747/airspeed/Vref30", "op": "between", "value": [126, 144] },
    { "do": "snapshot", "note": "FMC と PFD の VREF、FMC の総重量", "drefs": [ "laminar/B747/fms/vref25", "laminar/B747/fms/vref30", "laminar/B747/airspeed/Vref30", "laminar/B747/airspeed/Vf25", "laminar/B747/airspeed/Vf30", "laminar/B747/fms/landing_alt_valid", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total" ] },
    { "do": "shot", "name": "cdu_approach_ref" },
    { "do": "cdu", "note": "GROSS WT 240.8 を入れる", "keys": ["240.8", "L1"] },
    { "do": "check", "note": "入れた 240.8 t で 146/140（FCOM p.1409 の図）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^240[.]8 +146 *$" },
    { "do": "check", "note": "VREF 30 は 140", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "140 *$" },
    { "do": "shot", "name": "cdu_approach_ref_240" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_speeds" },
    { "do": "set", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
