{
  "name": "s230_bleed_failures",
  "description": "空圧の故障の入力（2026-11-04、故障の窓の F0：notes/ATA-36.md §10）の X-Plane での確認。成田 34L でエンジン運転中（アイドル）に開始。HPSOV 1 の閉じたままの故障：5 秒で BLEED HP ENG 1 と beeper、SYS FAULT なし、圧は IP 段だけ（推定）（FCOM p.619）。エンジン 2 の過圧：BLEED 2、SYS FAULT、STATUS BLEED OVPRESS 2、ENGINE BLEED 2 OFF で消えて >BLEED 2 OFF（FCOM p.575、p.619、LH36 p.96）。PRV 3 の閉じたままの故障：BLD 3 OVHT/PRV（SYS FAULT なし）、125 秒で STATUS BLEED PRV ENG 3（ATA30_32_35_36 p.72）。エンジン 4 の過熱：BLD 4 OVHT/PRV と SYS FAULT、弁が閉じ、60 秒で STATUS BLEED 4 OVHT（p.90）、故障が消えてもラッチ、スイッチの OFF・ON で戻る。上の EICAS、STATUS ページ、頭上パネルを撮る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/flightmodel/engine/ENGN_N2_[0]", "laminar/B747/engines/display_N2[0]",
      "laminar/B747/air/engine1/bleed_air_psi", "laminar/B747/air/engine2/bleed_air_psi",
      "laminar/B747/air/engine3/bleed_air_psi", "laminar/B747/air/engine4/bleed_air_psi",
      "laminar/B747/air/duct_pressure_L", "laminar/B747/air/duct_pressure_C", "laminar/B747/air/duct_pressure_R",
      "laminar/B747/button_switch/position[77]", "laminar/B747/button_switch/position[80]" ] },
    { "do": "check", "note": "アイドルの N2 は 50〜85 %（HP 段を使う範囲。推定）", "dref": "laminar/B747/engines/display_N2[0]", "op": "between", "value": [50, 85] },
    { "do": "check", "note": "エンジン 1 の抽気（アイドルで全圧。推定）", "dref": "laminar/B747/air/engine1/bleed_air_psi", "op": ">", "value": 50 },
    { "do": "check", "note": "BLEED HP ENG 1 は出ていない", "dref": "laminar/B747/CAS/advisory_status[30]", "op": "==", "value": 0 },
    { "do": "check", "note": "SYS FAULT 1 は消えている", "dref": "laminar/B747/air/light/sys_fault[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "HPSOV 1 の閉じたままの故障" },
    { "do": "set", "note": "HPSOV 1 の閉じたままの故障", "dref": "laminar/B747/air/fail/hpsov_closed[0]", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "5 秒たつまで BLEED HP ENG 1 は出ない", "dref": "laminar/B747/CAS/advisory_status[30]", "op": "==", "value": 0 },
    { "do": "wait", "note": "BLEED HP ENG 1（FCOM p.619）", "dref": "laminar/B747/CAS/advisory_status[30]", "op": "==", "value": 1, "timeout": 6, "cite": "FCOM p.619" },
    { "do": "wait", "note": "beeper の合図（FCOM p.619：advisory で beeper あり）", "dref": "laminar/B747/warning/master_caution_audio", "op": "==", "value": 1, "timeout": 1 },
    { "do": "check", "note": "SYS FAULT 1 は点かない（FCOM p.575）", "dref": "laminar/B747/air/light/sys_fault[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "IP 段だけの圧（推定）", "dref": "laminar/B747/air/engine1/bleed_air_psi", "op": "between", "value": [20, 45] },
    { "do": "cas", "note": "BLEED HP ENG 1" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_bleed_hp_eng1" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/hpsov_closed[0]", "value": 0 },
    { "do": "wait", "note": "BLEED HP ENG 1 が消える", "dref": "laminar/B747/CAS/advisory_status[30]", "op": "==", "value": 0, "timeout": 3 },

    { "do": "mark", "note": "エンジン 2 の過圧" },
    { "do": "set", "note": "エンジン 2 の過圧（PRV の調圧の故障）", "dref": "laminar/B747/air/fail/bleed_ovpress[1]", "value": 1 },
    { "do": "wait", "note": "BLEED 2（FCOM p.619）", "dref": "laminar/B747/CAS/advisory_status[27]", "op": "==", "value": 1, "timeout": 8, "cite": "FCOM p.619" },
    { "do": "check", "note": "SYS FAULT 2（FCOM p.575）", "dref": "laminar/B747/air/light/sys_fault[1]", "op": "==", "value": 1, "cite": "FCOM p.575" },
    { "do": "check", "note": "STATUS BLEED OVPRESS 2（ATA30_32_35_36 p.72）", "dref": "laminar/B747/CAS/status_status[112]", "op": "==", "value": 1 },
    { "do": "check", "note": "弁は開いたまま（LH36 p.96）", "dref": "laminar/B747/air/engine2/bleed_valve_pos", "op": "==", "value": 1 },
    { "do": "view", "name": "bleed" },
    { "do": "shot", "name": "overhead_sys_fault2" },
    { "do": "switch", "note": "ENGINE BLEED 2 OFF", "dref": "laminar/B747/button_switch/position[78]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_2" },
    { "do": "wait", "note": "PRV が閉じて過圧が止む：BLEED 2 が消える", "dref": "laminar/B747/CAS/advisory_status[27]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "check", "note": "SYS FAULT 2 が消える", "dref": "laminar/B747/air/light/sys_fault[1]", "op": "==", "value": 0 },
    { "do": "wait", "note": ">BLEED 2 OFF（FCOM p.619）", "dref": "laminar/B747/CAS/advisory_status[40]", "op": "==", "value": 1, "timeout": 3 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/bleed_ovpress[1]", "value": 0 },
    { "do": "switch", "note": "ENGINE BLEED 2 ON", "dref": "laminar/B747/button_switch/position[78]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_2" },
    { "do": "wait", "note": ">BLEED 2 OFF が消える", "dref": "laminar/B747/CAS/advisory_status[40]", "op": "==", "value": 0, "timeout": 5 },

    { "do": "mark", "note": "PRV 3 の閉じたままの故障" },
    { "do": "set", "note": "PRV 3 の閉じたままの故障", "dref": "laminar/B747/air/fail/prv_closed[2]", "value": 1 },
    { "do": "wait", "note": "BLD 3 OVHT/PRV（FCOM p.619）", "dref": "laminar/B747/CAS/advisory_status[24]", "op": "==", "value": 1, "timeout": 8, "cite": "FCOM p.619" },
    { "do": "check", "note": "SYS FAULT 3 は点かない（FCOM p.575）", "dref": "laminar/B747/air/light/sys_fault[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "エンジン 3 の空気は来ない", "dref": "laminar/B747/air/engine3/bleed_air_psi", "op": "<", "value": 1 },
    { "do": "check", "note": "右のダクトはエンジン 4 が保つ", "dref": "laminar/B747/air/duct_pressure_R", "op": ">", "value": 20 },

    { "do": "mark", "note": "エンジン 4 の過熱" },
    { "do": "set", "note": "エンジン 4 の過熱", "dref": "laminar/B747/air/fail/bleed_ovht[3]", "value": 1 },
    { "do": "wait", "note": "BLD 4 OVHT/PRV（FCOM p.619、LH36 p.100）", "dref": "laminar/B747/CAS/advisory_status[25]", "op": "==", "value": 1, "timeout": 8, "cite": "FCOM p.619" },
    { "do": "check", "note": "SYS FAULT 4（FCOM p.575）", "dref": "laminar/B747/air/light/sys_fault[3]", "op": "==", "value": 1 },
    { "do": "wait", "note": "弁が閉じる（FCOM p.612）", "dref": "laminar/B747/air/engine4/bleed_valve_pos", "op": "==", "value": 0, "timeout": 3 },
    { "do": "cas", "note": "BLD 3 OVHT/PRV、BLD 4 OVHT/PRV" },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_bld_ovht_prv" },
    { "do": "wait", "note": "60 秒で STATUS BLEED 4 OVHT（ATA30_32_35_36 p.90）", "dref": "laminar/B747/CAS/status_status[122]", "op": "==", "value": 1, "timeout": 70 },
    { "do": "wait", "note": "125 秒で STATUS BLEED PRV ENG 3（ATA30_32_35_36 p.72）", "dref": "laminar/B747/CAS/status_status[117]", "op": "==", "value": 1, "timeout": 75 },
    { "do": "set", "note": "下の EICAS を STATUS に", "dref": "laminar/B747/dsp/synoptic_display", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "status_bleed" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/prv_closed[2]", "value": 0 },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/air/fail/bleed_ovht[3]", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "BLD 3 OVHT/PRV が消える", "dref": "laminar/B747/CAS/advisory_status[24]", "op": "==", "value": 0 },
    { "do": "check", "note": "過熱はラッチ：SYS FAULT 4 は点いたまま（LH36 p.100）", "dref": "laminar/B747/air/light/sys_fault[3]", "op": "==", "value": 1 },
    { "do": "switch", "note": "ENGINE BLEED 4 OFF", "dref": "laminar/B747/button_switch/position[80]", "value": 0, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_4" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "ENGINE BLEED 4 ON（ラッチを戻す：FCOM p.612）", "dref": "laminar/B747/button_switch/position[80]", "value": 1, "cmd": "laminar/B747/button_switch/bleed_air_vlv_engine_4" },
    { "do": "wait", "note": "SYS FAULT 4 が消える", "dref": "laminar/B747/air/light/sys_fault[3]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "BLD 4 OVHT/PRV が消える", "dref": "laminar/B747/CAS/advisory_status[25]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "wait", "note": "弁が開く", "dref": "laminar/B747/air/engine4/bleed_valve_pos", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "STATUS BLEED 4 OVHT が消える", "dref": "laminar/B747/CAS/status_status[122]", "op": "==", "value": 0 },
    { "do": "check", "note": "STATUS BLEED PRV ENG 3 が消える", "dref": "laminar/B747/CAS/status_status[117]", "op": "==", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
