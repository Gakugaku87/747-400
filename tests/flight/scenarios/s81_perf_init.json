{
  "name": "s81_perf_init",
  "description": "PERF INIT と INIT REF のキー（6-1 段 3a）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に開始（機体を読み直す。IRS は整列済み）。INIT REF のキーは地上で IRS の位置が入っていれば PERF INIT（前は INIT/REF INDEX：FCOM p.1308）。ZFW を入れると GR WT が FUEL から出る（小さい字）、GR WT を入れると ZFW が出る、FUEL の入力で MANUAL、削除で CALC（FCOM p.1309-1310）、RESERVES、COST INDEX（0-9999）、CRZ ALT は FMC が持ち（前は X-Plane の FMS の VNAV ページに打ち込んで読み戻した）45,100 ft を超えると INVALID ENTRY（FCOM p.1311）。空中の INIT REF の APPROACH REF は s79 で見る。CDU を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "システムの準備" },
    { "do": "snapshot", "note": "開始の状態", "drefs": ["laminar/B747/irs/set_pos", "sim/flightmodel/weight/m_fuel_total", "sim/flightmodel/weight/m_total", "laminar/B747/autopilot/dist/cruise_alt"] },
    { "do": "check", "note": "IRS の位置は入っている（整列済み）", "dref": "laminar/B747/irs/set_pos", "op": "==", "value": 0 },

    { "do": "mark", "note": "INIT REF のキー（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "INIT REF", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "地上で位置が入っていれば PERF INIT（前は INIT/REF INDEX）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "PERF INIT" },
    { "do": "check", "note": "GR WT はボックス", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "***.*" },
    { "do": "check", "note": "FUEL の源は CALC", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "CALC" },

    { "do": "mark", "note": "ZFW と GR WT" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "ZFW へ（L3）", "name": "laminar/B747/fms1/ls_key/L3" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "ZFW 220.0（大きい字）", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "220.0" },
    { "do": "snapshot", "note": "GR WT は ZFW＋FUEL（小さい字）", "drefs": ["laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms/data"] },
    { "do": "check", "note": "GR WT は小さい字で出る", "dref": "laminar/B747/fms3/Line03_S", "op": "contains", "value": "." },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_perf_zfw" },
    { "do": "cmd", "note": "3", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "3", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "GR WT へ（L1）", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "GR WT 330.0（大きい字）", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "330.0" },
    { "do": "check", "note": "ZFW は GR WT−FUEL（小さい字）", "dref": "laminar/B747/fms3/Line07_S", "op": "contains", "value": "." },

    { "do": "mark", "note": "FUEL・RESERVES・COST INDEX" },
    { "do": "cmd", "note": "9", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "note": "5", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "FUEL へ（L2）", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "FUEL 95.0 MANUAL", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "MANUAL" },
    { "do": "cmd", "note": "DEL", "name": "laminar/B747/fms1/key/del" },
    { "do": "cmd", "note": "DELETE を FUEL へ", "name": "laminar/B747/fms1/ls_key/L2" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "削除で CALC に戻る", "dref": "laminar/B747/fms3/Line05_S", "op": "contains", "value": "CALC" },
    { "do": "cmd", "note": "1", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": ".", "name": "laminar/B747/fms1/key/period" },
    { "do": "cmd", "note": "5", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "RESERVES へ（L4）", "name": "laminar/B747/fms1/ls_key/L4" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "RESERVES 12.5", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "12.5" },
    { "do": "cmd", "note": "1", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "2", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "COST INDEX へ（L5）", "name": "laminar/B747/fms1/ls_key/L5" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "COST INDEX 120", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "120" },

    { "do": "mark", "note": "CRZ ALT" },
    { "do": "cmd", "note": "4", "name": "laminar/B747/fms1/alphanum_key/4" },
    { "do": "cmd", "note": "6", "name": "laminar/B747/fms1/alphanum_key/6" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "CRZ ALT へ（R1）", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "46,000 ft は 45,100 ft を超えるので INVALID ENTRY", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "INVALID ENTRY" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },
    { "do": "cmd", "note": "CLR を押し続ける", "name": "laminar/B747/fms1/key/clear", "duration": 1.2 },
    { "do": "cmd", "note": "3", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "5", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "cmd", "note": "0", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "note": "CRZ ALT へ", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "CRZ ALT FL350", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "FL350" },
    { "do": "check", "note": "FMC の巡航高度 35,000 ft（すぐ。前は X-Plane の FMS から 0.5 秒後に読み戻し）", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },
    { "do": "shot", "name": "cdu_perf_done" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "CLB ページの CRZ ALT も FL350", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "FL350" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
