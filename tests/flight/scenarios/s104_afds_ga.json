{
  "name": "s104_afds_ga",
  "description": "AFDS の作り直し 6-3 段 1e（TO/GA）の着陸復行の確認、空中。銚子沖の海上 1,500 ft・160 kt で開始（機体を読み直す）、FMS の空中の初期化で A/P CMD L・ALT HOLD、フラップ 20。V/S で降りて MCP 高度 300 ft で捕まえ（空中開始の浮き沈みに頼らない）、MCP 高度を 1,500 ft にして、TO/GA で G/A（ロール・ピッチとも TO/GA、TO/GA の旗、前の autoland の着陸復行 -2：ATA22 p.337、FCOM p.657）、400 ft 未満では HDG SEL と V/S が効かない（表 p.351、p.335）、400 ft を超えると HDG SEL が効く、MCP 高度は 800 ft より上で捕まえる（ALT：表 p.335）。A/P と F/D を切って全部切、F/D のスイッチ OFF のまま TO/GA で G/A と両席の F/D の表示・両 PFD の FD（FCOM p.657、p.661）、機長の PFD を撮る。F/D L を ON・OFF すると全部切。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 457.2, "heading_true": 0, "speed_in_meters_per_second": 82.3 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "set", "note": "フラップ 20（すぐ）", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 8, "note": "空中の初期化の ALT HOLD（CMD L の後）を待つ" },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "set", "note": "MCP 方位 360", "dref": "laminar/B747/autopilot/heading/degrees", "value": 360 },
    { "do": "set", "note": "MCP 高度 300 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 300 },
    { "do": "set", "note": "前の則の目標も（つまみなら 3 秒後に写る）", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 300 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "set", "note": "V/S -1,000 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -1000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "V/S で降りる", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 7 },
    { "do": "wait", "note": "MCP 高度 300 ft の捕捉（ALT）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 120 },
    { "do": "wait", "note": "400 ft 未満まで降りる", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 380, "timeout": 90 },
    { "do": "sleep", "seconds": 5 },
    { "do": "set", "note": "MCP 高度 1,500 ft（着陸復行の先）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 1500 },
    { "do": "set", "note": "前の則の目標も（つまみなら 3 秒後に写る）", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 1500 },
    { "do": "snapshot", "note": "TO/GA の前", "drefs": [ "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/autopilot/FMA/active_roll_mode", "laminar/B747/autopilot/FMA/active_pitch_mode" ] },
    { "do": "check", "note": "400 ft 未満", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "between", "value": [150, 399] },
    { "do": "cmd", "note": "TO/GA", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "G/A：FMA のロールは TO/GA", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "ピッチも TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "前のコードの TO/GA の旗", "dref": "laminar/B747/autopilot/TOGA_status", "op": "==", "value": 1 },
    { "do": "check", "note": "前の autoland の着陸復行（1,500 ft 未満）", "dref": "laminar/B747/autopilot/autoland", "op": "==", "value": -2 },
    { "do": "cmd", "note": "400 ft 未満の HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "400 ft 未満の V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "まだ 400 ft 未満", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": "<", "value": 400 },
    { "do": "check", "note": "HDG SEL は効かない（表 p.351）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "V/S も効かない（表 p.335）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "wait", "note": "上昇して 450 ft", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 450, "timeout": 60 },
    { "do": "cmd", "note": "400 ft より上の HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "ピッチは TO/GA のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "wait", "note": "MCP 高度 1,500 ft の捕捉（ALT）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 9, "timeout": 120 },
    { "do": "check", "note": "800 ft より上で捕まえた（表 p.335）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 800 },
    { "do": "check", "note": "ロールもピッチも TO/GA でない：旗は消える", "dref": "laminar/B747/autopilot/TOGA_status", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 5 },
    { "do": "cmd", "note": "操縦輪の A/P 解除", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "cmd", "note": "2 回目で AUTOPILOT DISC を消す", "name": "laminar/B747/autopilot/button_switch/yoke_disengage_capt" },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "全部切", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 0 },
    { "do": "set", "note": "MCP 高度 5,000 ft（今の高度のままだと G/A の直後に 800 ft より上の捕捉で ALT になる）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 5000 },
    { "do": "set", "note": "前の則の目標も（つまみなら 3 秒後に写る）", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 5000 },
    { "do": "cmd", "note": "F/D のスイッチ OFF のまま TO/GA（160 kt、フラップ 20）", "name": "sim/engines/TOGA_power" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "G/A：ロール TO/GA", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "ピッチ TO/GA", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の F/D の表示（FCOM p.661）", "dref": "laminar/B747/autopilot/fd/capt/shown", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の F/D の表示", "dref": "laminar/B747/autopilot/fd/fo/shown", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の PFD に FD（FCOM p.657）", "dref": "laminar/B747/autopilot/AFDS/status_annun_pilot", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士の PFD にも FD", "dref": "laminar/B747/autopilot/AFDS/status_annun_copilot", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD：F/D のスイッチ OFF の G/A", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_ga_auto" },
    { "do": "switch", "note": "F/D L ON", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "既定のモードにならない：G/A のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 1 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ON・OFF で全部切（FCOM p.661）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 0 },
    { "do": "check", "note": "F/D の表示も消える", "dref": "laminar/B747/autopilot/fd/capt/shown", "op": "==", "value": 0 },
    { "do": "cmd", "note": "A/P を戻す（終わりの安定のため）", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
