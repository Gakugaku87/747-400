{
  "name": "s76_eicas_compact",
  "description": "EICAS の compact の形（5-2 段 6b-2）の X-Plane での確認、地上。成田 34L にエンジン運転中で開始（機体を読み直す）。下の表示器の故障で EICAS の表示器が 1 台になると、ENG の選択で主 EICAS に compact の全表示（EPR とテープ、N1・EGT の数字、N2・FF・油・VIB の数字）、ENG で通常の形、2 番の油ポンプの故障で compact の部分表示（油の行）、故障を戻すと通常へ。下の表示器を戻し、FUEL を選んで油の逸脱：二次 EICAS は FUEL のまま、主 EICAS に compact の部分表示（FCOM p.855-857、p.874-875）。主 EICAS を撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "開始：二次 EICAS に二次エンジンの全表示", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 1 },
    { "do": "check", "note": "compact ではない", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 0 },
    { "do": "view", "note": "主 EICAS", "the": -22, "psi": 29, "fov": 22 },
    { "do": "shot", "name": "normal" },
    { "do": "set", "note": "下の表示器の故障", "dref": "laminar/B747/displays/fail[3]", "value": 1 },
    { "do": "wait", "note": "EICAS の表示器が 1 台：ENG で compact の全表示（FCOM p.874）", "cite": "FCOM p.874", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 1, "timeout": 3 },
    { "do": "check", "note": "二次 EICAS は出ていない", "dref": "laminar/B747/eicas/sec_eng", "op": "==", "value": 0 },
    { "do": "check", "note": "compact の N2", "dref": "laminar/B747/eicas/cmp_rows[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "compact の FF", "dref": "laminar/B747/eicas/cmp_rows[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "compact の油", "dref": "laminar/B747/eicas/cmp_rows[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "compact の VIB", "dref": "laminar/B747/eicas/cmp_rows[3]", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "shot", "name": "compact_full" },
    { "do": "cmd", "note": "ENG：通常の形に戻る", "name": "laminar/B747/dsp/eng_switch", "duration": 0.2 },
    { "do": "wait", "note": "compact が消える", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 0, "timeout": 3 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "shot", "name": "one_display_normal" },
    { "do": "set", "note": "2 番の油ポンプの故障", "dref": "sim/operation/failures/rel_oilpmp1", "value": 6 },
    { "do": "wait", "note": "表示器 1 台で逸脱：compact の部分表示（FCOM p.875）", "cite": "FCOM p.875", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 2, "timeout": 30 },
    { "do": "check", "note": "油の行だけ", "dref": "laminar/B747/eicas/cmp_rows[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "N2 の行は出ない", "dref": "laminar/B747/eicas/cmp_rows[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "FF の行は出ない", "dref": "laminar/B747/eicas/cmp_rows[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "逸脱の印", "dref": "laminar/B747/eicas/exceed_cue", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "shot", "name": "compact_partial" },
    { "do": "set", "note": "油ポンプの故障を戻す", "dref": "sim/operation/failures/rel_oilpmp1", "value": 0 },
    { "do": "wait", "note": "正常域に戻ると compact は消える", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 0, "timeout": 60 },
    { "do": "set", "note": "下の表示器を戻す", "dref": "laminar/B747/displays/fail[3]", "value": 0 },
    { "do": "cmd", "note": "FUEL", "name": "laminar/B747/dsp/fuel_switch", "duration": 0.2 },
    { "do": "set", "note": "2 番の油ポンプの故障", "dref": "sim/operation/failures/rel_oilpmp1", "value": 6 },
    { "do": "wait", "note": "FUEL を選んでいて逸脱：主 EICAS に compact の部分表示（FCOM p.875）", "cite": "FCOM p.875", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 2, "timeout": 30 },
    { "do": "check", "note": "二次 EICAS は FUEL のまま", "dref": "laminar/B747/dsp/synoptic_display", "op": "==", "value": 4 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "shot", "name": "fuel_compact_partial" },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "fuel_lower" },
    { "do": "set", "note": "油ポンプの故障を戻す", "dref": "sim/operation/failures/rel_oilpmp1", "value": 0 },
    { "do": "wait", "note": "compact が消える", "dref": "laminar/B747/eicas/compact", "op": "==", "value": 0, "timeout": 60, "level": "warn" },
    { "do": "view", "name": "forward" }
  ]
}
