{
  "name": "s61_nd_orientation",
  "description": "ND の向き・方位・航跡・旗（5-2 段 5a、パネルの変更）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・200 kt で開始（機体を読み直す）。西風 50 kt を入れて、方位 007 のまま航跡を右へずらす（偏流）。機長の ND：MAP（航跡が上、方位の ▽ は上から左）、VOR（方位が上：前は航跡が上）、APP、PLN（北が上と PLN の ▽、選択方位なし）、MAP CTR、VOR CTR。副操縦士の ND の VOR（副操縦士の方位で上：前は機長の航跡）。X-Plane の地図の層の向き（map_mode：VOR・APP は 0、MAP 2、PLN 4）。最後に IRU L・C・R を ATT にして、MAP・VTK・TRK の旗（MAP）と HDG の旗（VOR）。ND を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 220 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 220 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "X-Plane の天気をすぐ変える", "dref": "sim/weather/region/update_immediately", "value": 1 },
    { "do": "set", "note": "風向 270（層 0）", "dref": "sim/weather/region/wind_direction_degt[0]", "value": 270 },
    { "do": "set", "note": "風速 50 kt", "dref": "sim/weather/region/wind_speed_msc[0]", "value": 25.7 },
    { "do": "set", "note": "風向 270（層 1）", "dref": "sim/weather/region/wind_direction_degt[1]", "value": 270 },
    { "do": "set", "note": "風速 50 kt", "dref": "sim/weather/region/wind_speed_msc[1]", "value": 25.7 },
    { "do": "set", "note": "風向 270（層 2）", "dref": "sim/weather/region/wind_direction_degt[2]", "value": 270 },
    { "do": "set", "note": "風速 50 kt", "dref": "sim/weather/region/wind_speed_msc[2]", "value": 25.7 },
    { "do": "set", "note": "風向 270（層 3）", "dref": "sim/weather/region/wind_direction_degt[3]", "value": 270 },
    { "do": "set", "note": "風速 50 kt", "dref": "sim/weather/region/wind_speed_msc[3]", "value": 25.7 },
    { "do": "set", "note": "風向 270（層 4）", "dref": "sim/weather/region/wind_direction_degt[4]", "value": 270 },
    { "do": "set", "note": "風速 50 kt", "dref": "sim/weather/region/wind_speed_msc[4]", "value": 25.7 },
    { "do": "wait", "note": "西風で航跡が右へ（方位 007 のまま）", "dref": "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "op": "between", "value": [14, 40], "timeout": 90 },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "MAP", "drefs": [ "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "laminar/B747/nd/up/capt", "laminar/B747/nd/up/fo", "sim/cockpit2/EFIS/map_mode", "sim/cockpit2/EFIS/map_mode_copilot", "laminar/B747/nd/capt/hdg_ptr", "laminar/B747/nd/capt/wind_deg", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag" ] },
    { "do": "check", "note": "MAP：航跡が上（方位 007 から右）", "dref": "laminar/B747/nd/up/capt", "op": "between", "value": [12, 40] },
    { "do": "check", "note": "X-Plane の地図は MAP（2）", "dref": "sim/cockpit2/EFIS/map_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "方位の印", "dref": "laminar/B747/nd/capt/hdg_ptr", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_map" },
    { "do": "switch", "note": "機長の ND を VOR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "VOR", "drefs": [ "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "laminar/B747/nd/up/capt", "laminar/B747/nd/up/fo", "sim/cockpit2/EFIS/map_mode", "sim/cockpit2/EFIS/map_mode_copilot", "laminar/B747/nd/capt/hdg_ptr", "laminar/B747/nd/capt/wind_deg", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag" ] },
    { "do": "check", "note": "VOR：方位が上（007：前は航跡が上）", "dref": "laminar/B747/nd/up/capt", "op": "between", "value": [0, 12] },
    { "do": "check", "note": "X-Plane の地図も方位が上（0）", "dref": "sim/cockpit2/EFIS/map_mode", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_vor" },
    { "do": "switch", "note": "APP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 0, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "APP：方位が上", "dref": "laminar/B747/nd/up/capt", "op": "between", "value": [0, 12] },
    { "do": "shot", "name": "nd_app" },
    { "do": "switch", "note": "PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PLN：北が上", "dref": "laminar/B747/nd/up/capt", "op": "==", "value": 0 },
    { "do": "check", "note": "X-Plane の地図は PLN（4）", "dref": "sim/cockpit2/EFIS/map_mode", "op": "==", "value": 4 },
    { "do": "check", "note": "PLN の方位の印", "dref": "laminar/B747/nd/capt/hdg_ptr_pln", "op": "==", "value": 1 },
    { "do": "check", "note": "PLN には選択方位が無い（FCOM p.1142）", "dref": "laminar/B747/nd/capt/hdg_bug", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_pln" },
    { "do": "switch", "note": "MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "CTR（全周）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "全周", "dref": "laminar/B747/nd/map_center/capt", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_map_ctr" },
    { "do": "switch", "note": "VOR CTR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "nd_vor_ctr" },
    { "do": "switch", "note": "MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "CTR をもう一度：拡大に戻す", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "switch", "note": "副操縦士の ND を VOR", "dref": "laminar/B747/nd/mode/fo/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/fo/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/fo/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "副操縦士 VOR", "drefs": [ "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "laminar/B747/nd/up/capt", "laminar/B747/nd/up/fo", "sim/cockpit2/EFIS/map_mode", "sim/cockpit2/EFIS/map_mode_copilot", "laminar/B747/nd/capt/hdg_ptr", "laminar/B747/nd/capt/wind_deg", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag" ] },
    { "do": "check", "note": "副操縦士の VOR：副操縦士の方位が上", "dref": "laminar/B747/nd/up/fo", "op": "between", "value": [0, 12] },
    { "do": "check", "note": "X-Plane の副操縦士の地図も方位が上（0）", "dref": "sim/cockpit2/EFIS/map_mode_copilot", "op": "==", "value": 0 },
    { "do": "check", "note": "機長の ND は MAP のまま（2）", "dref": "sim/cockpit2/EFIS/map_mode", "op": "==", "value": 2 },
    { "do": "view", "note": "副操縦士の ND", "the": -19, "psi": 47, "fov": 20 },
    { "do": "shot", "name": "nd_fo_vor" },
    { "do": "switch", "note": "IRU L を ATT（空中では NAV に戻れない：FCOM p.1227。最後に置く）", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 3, "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "switch", "note": "IRU C を ATT（空中では NAV に戻れない：FCOM p.1227。最後に置く）", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 3, "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_C_dn" },
    { "do": "switch", "note": "IRU R を ATT（空中では NAV に戻れない：FCOM p.1227。最後に置く）", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[2]", "value": 3, "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_R_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_R_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "NAV の IRU が無い：MAP の旗（FMC の位置：推定）", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 1 },
    { "do": "check", "note": "VTK の旗", "dref": "laminar/B747/nd/capt/vtk_flag", "op": "==", "value": 1 },
    { "do": "check", "note": "航跡も無い：TRK の旗", "dref": "laminar/B747/nd/capt/trk_flag", "op": "==", "value": 1 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_map_flags" },
    { "do": "switch", "note": "VOR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ATT で方位を入れていない：HDG の旗", "dref": "laminar/B747/nd/capt/hdg_flag", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_hdg_flag" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
