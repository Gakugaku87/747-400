{
  "name": "s241_hyd_failures",
  "description": "故障窓のための油圧の故障入力（notes/ATA-29.md §10）。エンジン運転中の地上で、laminar/B747/hydraulics/fail/edp[0]（ENGINE pump 1 が流量を出さない：ENGINE PRESS 1・HYD PRESS ENG 1、ADP 1 が AUTO で引き継ぐ）、fail/demand_pump[1]（DEMAND 2 を ON にして故障：DEMAND PRESS 2・HYD PRESS DEM 2）、fail/leak[2]（系統 3 が 120 秒で抜ける。推定：>HYD QTY LOW 3）を入れては直す。直すと元に戻る（漏れは満タンに戻る）",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "系統 1 は約 3000 psi", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">", "value": 2800 },
    { "do": "check", "note": "ENGINE PRESS 1 消灯", "dref": "laminar/B747/hydraulics/light/eng_press[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "故障なし", "dref": "laminar/B747/hydraulics/fail/edp[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "ENGINE pump 1 の故障" },
    { "do": "set", "note": "fail/edp[0] = 1", "dref": "laminar/B747/hydraulics/fail/edp[0]", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ENGINE PRESS 1 点灯", "dref": "laminar/B747/hydraulics/light/eng_press[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "HYD PRESS ENG 1", "dref": "laminar/B747/CAS/advisory_status[210]", "op": "==", "value": 1 },
    { "do": "check", "note": "EDP 1 の圧なし", "dref": "laminar/B747/hydraulics/edp_pressure_1", "op": "<", "value": 200 },
    { "do": "check", "note": "ADP 1 が AUTO で引き継ぐ", "dref": "laminar/B747/hydraulics/dem_pressure_1", "op": ">", "value": 2800 },
    { "do": "check", "note": "系統 1 の圧は保たれる", "dref": "laminar/B747/hydraulics/pressure_1", "op": ">", "value": 2800 },
    { "do": "snapshot", "note": "EDP 1 故障", "drefs": [
      "laminar/B747/hydraulics/synoptic/edp[0]", "laminar/B747/hydraulics/synoptic/dem[0]", "laminar/B747/hydraulics/valve_1",
      "laminar/B747/hydraulics/edp_pressure_1", "laminar/B747/hydraulics/dem_pressure_1", "laminar/B747/hydraulics/pressure_1" ] },
    { "do": "cmd", "note": "HYD synoptic", "name": "laminar/B747/dsp/hyd_switch", "duration": 0.2 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "eicas_hyd_edp1_failed" },
    { "do": "cas", "note": "EDP 1 故障" },
    { "do": "set", "note": "直す", "dref": "laminar/B747/hydraulics/fail/edp[0]", "value": 0 },
    { "do": "wait", "note": "ENGINE PRESS 1 消灯", "dref": "laminar/B747/hydraulics/light/eng_press[0]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "wait", "note": "HYD PRESS ENG 1 が消える", "dref": "laminar/B747/CAS/advisory_status[210]", "op": "==", "value": 0, "timeout": 10 },

    { "do": "mark", "note": "demand pump 2 の故障" },
    { "do": "switch", "note": "DEMAND 2 ON", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[1]", "value": 2,
      "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_02_up", "cmd_down": "laminar/B747/hydraulics/sel_dial/dmd_pump_02_dn" },
    { "do": "wait", "note": "ACMP 2 が回る", "dref": "laminar/B747/hydraulics/dem_pressure_2", "op": ">", "value": 2800, "timeout": 10 },
    { "do": "set", "note": "fail/demand_pump[1] = 1", "dref": "laminar/B747/hydraulics/fail/demand_pump[1]", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "ACMP 2 の圧なし", "dref": "laminar/B747/hydraulics/dem_pressure_2", "op": "<", "value": 200 },
    { "do": "check", "note": "DEMAND PRESS 2 点灯", "dref": "laminar/B747/hydraulics/light/dem_press[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "HYD PRESS DEM 2", "dref": "laminar/B747/CAS/advisory_status[207]", "op": "==", "value": 1 },
    { "do": "check", "note": "EDP 2 が系統 2 を保つ", "dref": "laminar/B747/hydraulics/pressure_2", "op": ">", "value": 2800 },
    { "do": "shot", "name": "eicas_hyd_dem2_failed" },
    { "do": "set", "note": "直す", "dref": "laminar/B747/hydraulics/fail/demand_pump[1]", "value": 0 },
    { "do": "wait", "note": "ACMP 2 がまた回る", "dref": "laminar/B747/hydraulics/dem_pressure_2", "op": ">", "value": 2800, "timeout": 10 },
    { "do": "wait", "note": "HYD PRESS DEM 2 が消える", "dref": "laminar/B747/CAS/advisory_status[207]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "switch", "note": "DEMAND 2 AUTO", "dref": "laminar/B747/hydraulics/dmd_pump/sel_dial_pos[1]", "value": 1,
      "cmd": "laminar/B747/hydraulics/sel_dial/dmd_pump_02_up", "cmd_down": "laminar/B747/hydraulics/sel_dial/dmd_pump_02_dn" },

    { "do": "mark", "note": "系統 3 の漏れ" },
    { "do": "set", "note": "fail/leak[2] = 1", "dref": "laminar/B747/hydraulics/fail/leak[2]", "value": 1 },
    { "do": "wait", "note": "系統 3 の量が減る", "dref": "laminar/B747/hydraulics/res_3", "op": "<", "value": 0.8, "timeout": 45 },
    { "do": "check", "note": "系統 1 は減らない", "dref": "laminar/B747/hydraulics/res_1", "op": ">=", "value": 0.99 },
    { "do": "wait", "note": "LO まで（120 秒で空。推定）", "dref": "laminar/B747/hydraulics/res_3", "op": "<=", "value": 0.34, "timeout": 100 },
    { "do": "wait", "note": ">HYD QTY LOW 3", "dref": "laminar/B747/CAS/advisory_status[220]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "shot", "name": "eicas_hyd_leak3" },
    { "do": "cas", "note": "系統 3 の漏れ" },
    { "do": "set", "note": "直す（満タンに戻る）", "dref": "laminar/B747/hydraulics/fail/leak[2]", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "量は 1.00 に戻る", "dref": "laminar/B747/hydraulics/res_3", "op": ">=", "value": 0.99 },
    { "do": "wait", "note": ">HYD QTY LOW 3 が消える", "dref": "laminar/B747/CAS/advisory_status[220]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "cmd", "note": "synoptic を消す", "name": "laminar/B747/dsp/hyd_switch", "duration": 0.2 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "cas", "note": "直した後" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
