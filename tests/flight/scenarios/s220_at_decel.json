{
  "name": "s220_at_decel",
  "description": "A/T の SPD の速度の変え方（2026-11-03）。10,000 ft・指示 約 340 kt の空中開始から、A/P CMD L・ALT HOLD・HDG SEL・A/T SPD で 340 kt を保ち、MCP 速度を 250 kt にする。FCTM p.139：水平飛行でスピードブレーキなしに 340 kt から 250 kt まで約 90 秒・8 NM（レバーはほぼずっとアイドル）。前の則（K_SPD 0.002、減らす向きはいつも半分）は目標の遠くでもレバーをゆっくり戻し、フラップの抗力で減速している間はレバーを止めた（s112 の G/S の捕捉の浮き上がり、s43 の 20 秒で 220 kt から 216 kt）。その後 250 kt を 2 分保つ（s01 の 250 kt で、強い利得はレバーをアイドルから 0.3 まで 30 秒ごとに振った）。最後に 290 kt へ（増やす向きは速く：FCTM p.43）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 203 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "wait", "note": "空中開始の A/P の立ち上げ（FMC の activate_inflightAP）が MCP の速度をその時の速度へ巻き戻し終える（laminar/B747/autopilot/speed/target が -1）。2026-11-03 の 1 回目は先に入れた 340 kt が 305 kt へ巻き戻された", "dref": "laminar/B747/autopilot/speed/target", "op": "==", "value": -1, "timeout": 30 },
    { "do": "set", "note": "MCP 速度 340 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 340 },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "set", "note": "MCP 方位 347（空中開始の磁方位）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 347 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 60, "note": "空中開始の機首上げ（約 2,000 ft 上がる：1 回目は 50 秒で 12,170 ft、2 回目は 12,650 ft）が終わるまで。2 回目は下の高度の待ちが上がる前に成り立ち、12,650 ft から減速した" },
    { "do": "wait", "note": "ALT HOLD が押した高度へ戻る", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [9850, 10250], "timeout": 360 },
    { "do": "wait", "note": "水平（昇降率 ±200 fpm）", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "between", "value": [-200, 200], "timeout": 120 },
    { "do": "wait", "note": "340 kt に落ち着く", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [336, 344], "timeout": 180 },
    { "do": "sleep", "seconds": 20, "note": "340 kt の水平" },
    { "do": "check", "note": "まだ 10,000 ft（±200 ft）", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [9800, 10200] },
    { "do": "snapshot", "note": "340 kt", "drefs": [
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode",
      "laminar/B747/autopilot/ias_dial_value", "sim/cockpit2/autopilot/airspeed_dial_kts",
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "laminar/B747/engine/throttle", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "開始の速度（330 kt 以上でなければ開始の失敗）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [330, 350] },

    { "do": "mark", "note": "340 -> 250 kt" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "wait", "note": "レバーがアイドルへ（目標から遠い減速は速く戻す：FCTM p.139 の減速はほぼアイドル。15 秒は推定）", "level": "warn",
      "dref": "laminar/B747/engine/throttle[0]", "op": "<=", "value": 0.05, "timeout": 15 },
    { "do": "wait", "note": "252 kt まで（FCTM p.139：約 90 秒。X-Plane の抗力の差に 130 秒）",
      "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "<=", "value": 252, "timeout": 130 },
    { "do": "watch", "note": "250 kt を 2 分保つ：245〜255 kt（行き過ぎと揺れ：s01。推定）",
      "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "min": 245, "max": 255, "timeout": 120 },
    { "do": "watch", "note": "保持中のレバー 1（記録。A/T が動かすレバー：sim/cockpit2/engine/actuators/throttle_ratio_all は EEC の後で 0.5 のまま）", "dref": "laminar/B747/engine/throttle[0]", "timeout": 30 },
    { "do": "check", "note": "250 kt（±3 kt、推定）", "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": "between", "value": [247, 253] },
    { "do": "check", "note": "高度を保つ（±200 ft、推定）", "level": "warn",
      "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [9800, 10200] },

    { "do": "mark", "note": "250 -> 290 kt" },
    { "do": "set", "note": "MCP 速度 290 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 290 },
    { "do": "wait", "note": "288 kt まで（増やす向きは速く：FCTM p.43。60 秒は推定）",
      "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "op": ">=", "value": 288, "timeout": 60 },
    { "do": "watch", "note": "290 kt を 90 秒保つ：285〜295 kt（推定）",
      "dref": "sim/cockpit2/gauges/indicators/airspeed_kts_pilot", "min": 285, "max": 295, "timeout": 90 },
    { "do": "snapshot", "note": "終わり", "drefs": [
      "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode",
      "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/airspeed_kts_pilot",
      "laminar/B747/engine/throttle" ] },
    { "do": "cas", "note": "終わり" },
    { "do": "record_stop" }
  ]
}
