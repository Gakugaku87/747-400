{
  "name": "s274_fuel_auto_mgmt",
  "description": "シムのオプション Auto fuel management（2026-11-09、notes/ATA-28.md §13）の X-Plane での確認、空中。銚子沖の 10,000 ft で開始（燃料は CWT 2,600、主 1・4 は 10,000、主 2・3 は 10,100、STAB 750 kg。予備は 0）。オプションが OFF なら何もしない。ON にすると、Climb and Cruise Procedure の燃料の操作をスイッチのコマンドで行う（FCOM p.133-136）：FUEL PMP STB で STAB L・R ON、STAB が空になって FUEL PRES STB で OFF、CWT 1,300 kg の FUEL LOW CTR で CTR L・R OFF（O/J 2・3 が引き継ぐ：p.1467）、FUEL TANK/ENG で OVRD 2・3 の FWD・AFT と X FEED 1・4 OFF。飛行中に操縦士が動かしたスイッチ（X FEED 1 を ON）はそのまま。FUEL synoptic と頭上パネルを撮る",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 148.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weight": {
      "payload_weight_in_kilograms": [ 3901.4, 4106.8, 4928.1, 6365.5, 1232, 10287.5, 9178.6, 0, 0 ],
      "fueltank_weight_in_kilograms": [ 2600, 10000, 10100, 10100, 10000, 0, 0, 750, 0 ]
    },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "wait", "note": "空中開始の初期化が A/P を入れる", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 40 },
    { "do": "set", "note": "MCP 速度 290 kt（水平飛行のピッチを 5° 未満に：燃料のメッセージの上昇・巡航はピッチで分かれる）", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 290 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode", "duration": 0.2 },
    { "do": "check", "note": "オプションは実行役が OFF にしている（保存しない）", "dref": "laminar/B747/options/auto_fuel_mgmt", "op": "==", "value": 0 },
    { "do": "switch", "note": "STAB L OFF（巡航の FUEL PMP STB の前の状態：FCOM p.119 の始動前は MAIN と CTR だけ ON）", "dref": "laminar/B747/button_switch/position[54]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_stab_tnk_pump_L" },
    { "do": "switch", "note": "STAB R OFF", "dref": "laminar/B747/button_switch/position[55]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_stab_tnk_pump_R" },
    { "do": "switch", "note": "X FEED 2 ON", "dref": "laminar/B747/button_switch/position[49]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_2" },
    { "do": "switch", "note": "X FEED 3 ON", "dref": "laminar/B747/button_switch/position[50]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_3" },
    { "do": "set", "note": "下の EICAS を FUEL の synoptic に", "dref": "laminar/B747/dsp/synoptic_display", "value": 4 },
    { "do": "snapshot", "drefs": [ "sim/flightmodel/weight/m_fuel", "laminar/B747/button_switch/position[52]", "laminar/B747/button_switch/position[53]", "laminar/B747/button_switch/position[54]", "laminar/B747/button_switch/position[55]" ] },

    { "do": "mark", "note": "空中開始の上昇が落ち着くのを待つ（約 2 分）" },
    { "do": "sleep", "seconds": 150 },
    { "do": "wait", "note": "巡航（ピッチ 5° 未満：FCOM p.134）", "dref": "sim/flightmodel/position/theta", "op": "<", "value": 4.5, "timeout": 120 },
    { "do": "check", "note": "STAB に 500 kg 以上", "dref": "sim/flightmodel/weight/m_fuel[7]", "op": ">=", "value": 500 },
    { "do": "wait", "note": ">FUEL PMP STB L（巡航で 500 kg 以上、スイッチ OFF）", "dref": "laminar/B747/CAS/advisory_status[159]", "op": "==", "value": 1, "timeout": 20, "cite": "FCOM p.1475" },

    { "do": "mark", "note": "オプション OFF" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "オプション OFF：STAB L は OFF のまま", "dref": "laminar/B747/button_switch/position[54]", "op": "==", "value": 0 },
    { "do": "check", "note": "STAB R も", "dref": "laminar/B747/button_switch/position[55]", "op": "==", "value": 0 },

    { "do": "mark", "note": "オプション ON：FUEL PMP STB" },
    { "do": "set", "note": "オプション ON（dataref の書き込みは保存されない）", "dref": "laminar/B747/options/auto_fuel_mgmt", "value": 1 },
    { "do": "wait", "note": "メッセージの 5 秒の後、STAB L ON", "dref": "laminar/B747/button_switch/position[54]", "op": "==", "value": 1, "timeout": 20, "cite": "FCOM p.135" },
    { "do": "wait", "note": "1 秒後に STAB R ON", "dref": "laminar/B747/button_switch/position[55]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "wait", "note": ">FUEL PMP STB L が消える", "dref": "laminar/B747/CAS/advisory_status[159]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "wait", "note": "STAB L のポンプが回る", "dref": "laminar/B747/fuel/stab_tank/xfr_jett_pump_L_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cas", "note": "STAB の移送" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "fuel_stab_transfer" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "STAB が空になる：FUEL PRES STB" },
    { "do": "wait", "note": "STAB が空（4.5 t/h のポンプ 2 台で CWT へ）", "dref": "sim/flightmodel/weight/m_fuel[7]", "op": "<=", "value": 0.5, "timeout": 400 },
    { "do": "wait", "note": "FUEL PRES STB（900 kg 以下）で STAB L OFF", "dref": "laminar/B747/button_switch/position[54]", "op": "==", "value": 0, "timeout": 30, "cite": "FCOM p.135" },
    { "do": "wait", "note": "STAB R OFF", "dref": "laminar/B747/button_switch/position[55]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "wait", "note": "FUEL PRES STB L が消える", "dref": "laminar/B747/CAS/caution_status[67]", "op": "==", "value": 0, "timeout": 10 },

    { "do": "mark", "note": "CWT 1,300 kg：FUEL LOW CTR" },
    { "do": "wait", "note": "FUEL LOW CTR（巡航で約 1,300 kg）で CTR L OFF", "dref": "laminar/B747/button_switch/position[52]", "op": "==", "value": 0, "timeout": 600, "cite": "FCOM p.134" },
    { "do": "check", "note": "CWT は約 1,300 kg", "dref": "sim/flightmodel/weight/m_fuel[0]", "op": "between", "value": [ 1200, 1310 ] },
    { "do": "wait", "note": "CTR R OFF", "dref": "laminar/B747/button_switch/position[53]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "wait", "note": "O/J 2 FWD が回る（CTR が両方 OFF：FCOM p.1467）", "dref": "laminar/B747/fuel/main2_tank/ovrd_jett_pump_fwd_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "check", "note": "FUEL PRESS CTR L は出ていない", "dref": "laminar/B747/CAS/caution_status[69]", "op": "==", "value": 0 },
    { "do": "check", "note": ">FUEL LOW CTR L は消えている", "dref": "laminar/B747/CAS/advisory_status[302]", "op": "==", "value": 0 },
    { "do": "cas", "note": "CTR OFF" },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "fuel_ctr_off_oj_feed" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "主 2・3 が主 1・4 まで：FUEL TANK/ENG" },
    { "do": "wait", "note": "FUEL TANK/ENG で OVRD 2 FWD OFF", "dref": "laminar/B747/button_switch/position[64]", "op": "==", "value": 0, "timeout": 600, "cite": "FCOM p.134" },
    { "do": "wait", "note": "X FEED 4 OFF（OVRD 3 FWD、2 AFT、3 AFT、X FEED 1 の後）", "dref": "laminar/B747/button_switch/position[51]", "op": "==", "value": 0, "timeout": 20 },
    { "do": "check", "note": "OVRD 3 FWD OFF", "dref": "laminar/B747/button_switch/position[65]", "op": "==", "value": 0 },
    { "do": "check", "note": "OVRD 2 AFT OFF", "dref": "laminar/B747/button_switch/position[66]", "op": "==", "value": 0 },
    { "do": "check", "note": "OVRD 3 AFT OFF", "dref": "laminar/B747/button_switch/position[67]", "op": "==", "value": 0 },
    { "do": "check", "note": "X FEED 1 OFF", "dref": "laminar/B747/button_switch/position[48]", "op": "==", "value": 0 },
    { "do": "wait", "note": ">FUEL TANK/ENG が消える（X FEED 1・4 の弁が閉じる）", "dref": "laminar/B747/CAS/advisory_status[171]", "op": "==", "value": 0, "timeout": 15 },
    { "do": "check", "note": "エンジン 1 は主 1 から（synoptic）", "dref": "laminar/B747/fuel/engine1_status", "op": "==", "value": 1 },
    { "do": "check", "note": "エンジン 4 は主 4 から", "dref": "laminar/B747/fuel/engine4_status", "op": "==", "value": 1 },
    { "do": "cas", "note": "tank to engine" },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "fuel_tank_to_engine" },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_tank_to_engine" },

    { "do": "mark", "note": "操縦士のスイッチはそのまま" },
    { "do": "switch", "note": "操縦士が X FEED 1 を ON（均衡など：FCOM SP.12.1）", "dref": "laminar/B747/button_switch/position[48]", "value": 1, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "X FEED 1 は ON のまま", "dref": "laminar/B747/button_switch/position[48]", "op": "==", "value": 1 },
    { "do": "check", "note": ">FUEL TANK/ENG は出ている（操縦士に任せる）", "dref": "laminar/B747/CAS/advisory_status[171]", "op": "==", "value": 1 },
    { "do": "switch", "note": "X FEED 1 を OFF に戻す", "dref": "laminar/B747/button_switch/position[48]", "value": 0, "cmd": "laminar/B747/button_switch/fuel_xfeed_vlv_1" },
    { "do": "set", "note": "オプション OFF（保存しない）", "dref": "laminar/B747/options/auto_fuel_mgmt", "value": 0 },
    { "do": "cas", "note": "終わり" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
