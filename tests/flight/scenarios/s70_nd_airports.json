{
  "name": "s70_nd_airports",
  "description": "ND の出発・到着空港と滑走路（5-2 段 5c-3b）の X-Plane での確認、空中。ミュンヘン（EDDM）26R の進入路の上 14 NM・5,000 ft・160 kt・263° で開始。X-Plane の FMS に経路 EDDF・RW25C・RW26R（現用点）・EDDM を試験キットの `route` で入れる（CDU の RTE と DEP ARR で ORIGIN・DEST・RW25C・ILS26R を選んだときと同じ形：RW は閾値の名前つきの位置。読み直した直後の CDU からの入力は X-Plane の FMS のメッセージで弾かれることがあるので使わない）。40・20 NM は 26R を縮尺どおり、両端から 14.2 NM の破線、閾値に 26R（FCOM p.1149）。10 NM は滑走路は表示の外で、こちらへ延びる破線だけ。80 NM は EDDM の空港記号と 26R・滑走路に沿う線、320 NM は EDDF の記号と 25C。ARPT に関わらない。MAP CTR、VOR（出さない）、副操縦士の ND。ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 48.393705, "longitude": 12.170053, "elevation_in_meters": 1524.0, "heading_true": 263.4, "speed_in_meters_per_second": 82.3 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位は今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 0, "rel": "hdg0", "round": 1 },
    { "do": "set", "note": "MCP 速度 160 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 160 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "範囲 40 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "check", "note": "ARPT は切ってある", "dref": "laminar/B747/nd/data/capt/apt", "op": "==", "value": 0 },
    { "do": "check", "note": "経路が無いうちは空港を出さない", "dref": "laminar/B747/nd/capt/apt/rwy_show[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "記録：読み直した直後の X-Plane の FMS の scratchpad", "dref": "sim/cockpit2/radios/indicators/fms_cdu1_text_line13", "op": "!=", "value": "#" },
    { "do": "route", "note": "経路：EDDF、出発の滑走路 RW25C、到着の滑走路 RW26R（現用点）、EDDM（閾値は X-Plane の FMS が DEP ARR で入れる位置と標高）",
      "entries": ["EDDF 50.033306 8.570456 354", "RW25C 50.045128 8.586981 363", "RW26R 48.366886 11.821172 1499 ACTIVE", "EDDM 48.353783 11.786086 1483"] },
    { "do": "wait", "note": "40 NM：EDDM の 26R を縮尺どおりに（FCOM p.1149）", "dref": "laminar/B747/nd/capt/apt/rwy_show[1]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "set", "note": "範囲 10 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 0 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 0 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "10 NM：滑走路は表示の外（輪郭なし）", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "==", "value": -1 },
    { "do": "check", "note": "閾値も外（26R なし）", "dref": "laminar/B747/nd/capt/apt/thr_show[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "こちらへ延びる破線は出ている（閾値から 7 NM の 16 本目）", "dref": "laminar/B747/nd/capt/apt/dash[75]", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_rwy_10" },
    { "do": "set", "note": "範囲 40 NM に戻す", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "閾値に 26R", "dref": "laminar/B747/nd/capt/apt/rwy1", "op": "==", "value": "26R" },
    { "do": "check", "note": "閾値は表示の内", "dref": "laminar/B747/nd/capt/apt/thr_show[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "空港記号は出さない", "dref": "laminar/B747/nd/capt/apt/sym[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "選んだ閾値の端がこちら向き（進入路の上）", "dref": "laminar/B747/nd/capt/apt/dir[1]", "op": "outside", "value": [-150, 150] },
    { "do": "check", "note": "長さ 2.15 NM：25 px、6 コマ目", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "==", "value": 5 },
    { "do": "check", "note": "こちらへ延びる破線の 1 本目", "dref": "laminar/B747/nd/capt/apt/dash[60]", "op": "==", "value": 1 },
    { "do": "check", "note": "反対側の破線の 1 本目", "dref": "laminar/B747/nd/capt/apt/dash[90]", "op": "==", "value": 1 },
    { "do": "check", "note": "40 NM では 14.2 NM は 8 本（9 本目なし）", "dref": "laminar/B747/nd/capt/apt/dash[68]", "op": "==", "value": 0 },
    { "do": "check", "note": "EDDF は後ろ：出さない", "dref": "laminar/B747/nd/capt/apt/rwy_show[0]", "op": "==", "value": 0 },
    { "do": "shot", "name": "nd_rwy_40" },
    { "do": "cmd", "note": "CTR（MAP CTR）", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "MAP CTR", "dref": "laminar/B747/nd/map_center/capt", "op": "==", "value": 1 },
    { "do": "check", "note": "MAP CTR：26R（中点 13 NM）は円の内", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "==", "value": 5 },
    { "do": "shot", "name": "nd_rwy_ctr" },
    { "do": "cmd", "note": "CTR を戻す", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "set", "note": "範囲 20 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 1 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "20 NM：50 px、12 コマ目", "dref": "laminar/B747/nd/capt/apt/rwy_frame[1]", "op": "between", "value": [11, 12] },
    { "do": "shot", "name": "nd_rwy_20" },
    { "do": "set", "note": "範囲 80 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 3 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "80 NM：EDDM の空港記号", "dref": "laminar/B747/nd/capt/apt/sym[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "滑走路は出さない", "dref": "laminar/B747/nd/capt/apt/rwy_show[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "滑走路に沿う線", "dref": "laminar/B747/nd/capt/apt/line[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "識別符号 EDDM", "dref": "laminar/B747/nd/capt/apt/id1", "op": "==", "value": "EDDM" },
    { "do": "check", "note": "その下に 26R", "dref": "laminar/B747/nd/capt/apt/rwy1", "op": "==", "value": "26R" },
    { "do": "shot", "name": "nd_apt_80" },
    { "do": "set", "note": "範囲 320 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 5 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "320 NM：右前の EDDF の空港記号", "dref": "laminar/B747/nd/capt/apt/sym[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "EDDF", "dref": "laminar/B747/nd/capt/apt/id0", "op": "==", "value": "EDDF" },
    { "do": "check", "note": "25C", "dref": "laminar/B747/nd/capt/apt/rwy0", "op": "==", "value": "25C" },
    { "do": "check", "note": "EDDF の滑走路の線", "dref": "laminar/B747/nd/capt/apt/line[0]", "op": "==", "value": 1 },
    { "do": "shot", "name": "nd_apt_320" },
    { "do": "switch", "note": "機長の ND を VOR", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 1, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "VOR：滑走路を出さない（MAP、MAP CTR、PLAN だけ）", "dref": "laminar/B747/nd/capt/apt/rwy_show[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "空港記号も", "dref": "laminar/B747/nd/capt/apt/sym[1]", "op": "==", "value": 0 },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2, "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "set", "note": "副操縦士の ND を 40 NM", "dref": "laminar/B747/nd/range/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range_copilot", "value": 2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "副操縦士の ND も 26R", "dref": "laminar/B747/nd/fo/apt/rwy_show[1]", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
