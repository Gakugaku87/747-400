{
  "name": "s400_pw_takeoff_epr_fppm",
  "description": "P&W の離陸の定格を FPPM の Takeoff EPR の表に（2026-11-24、段 4 のフルレビューの ENG-2、notes/ATA-70-80.md §28）の X-Plane での確認、地上。RJAA 34L（約 140 ft）でエンジン運転中に始め（機体を読み直す）、海面 40 ℃。THRUST LIM で TO・TO 2・D-TO（SEL 55・65）を選び、基準の EPR（EICAS の REF、THRUST LIM、A/T の目標）と EEC の最大 EPR が FPPM の値か：TO 1.46（p.44 の 40 ℃ の行、前は着陸復行の表の 1.48）、最大も 1.46、TO 2 1.33（p.69、前は約 1.365）・減り 20 %、D-TO SEL 55 1.35（p.44 の 55 ℃）、SEL 65 は p.22 の 25 % 減の下限 約 1.297（前は 54 ℃ で止まって 1.38）。EICAS を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 200, "time_in_24_hours": 13.0 },
    "weather": {
      "definition": {
        "latitude_in_degrees": 35.76,
        "longitude_in_degrees": 140.39,
        "elevation_in_meters": 0,
        "visibility_in_kilometers": 40,
        "temperature_in_degrees_celsius": 40,
        "altimeter_setting_in_hpa": 1013.25,
        "precipitation_ratio": 0,
        "clouds": [],
        "wind": [
          {"altitude_in_feet_msl": 0, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0},
          {"altitude_in_feet_msl": 10000, "speed_in_knots": 0, "direction_in_degrees_true": 0, "gust_increase_in_knots": 0, "shear_in_degrees": 0, "turbulence_ratio": 0}
        ]
      },
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "P&W（EPR）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 0, "stop": true },
    { "do": "snapshot", "note": "開始", "drefs": [ "sim/cockpit2/temperature/outside_air_temp_degc", "sim/weather/temperature_ambient_c", "sim/flightmodel2/position/pressure_altitude", "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/display_EPR_max[0]" ] },
    { "do": "check", "note": "OAT は約 40 ℃（海面 40 ℃ の設定）", "dref": "sim/cockpit2/temperature/outside_air_temp_degc", "op": "between", "value": [38.5, 41], "stop": true },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "INIT REF、<INDEX、THRUST LIM", "keys": ["INITREF", "L6", "L4"] },
    { "do": "check", "note": "THRUST LIM", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "THRUST LIM" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は TO", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "TO" },
    { "do": "check", "note": "TO の基準は FPPM p.44 の 40 ℃ の 1.46（前は着陸復行の表の 1.48）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [1.455, 1.468], "cite": "FPPM p.44 (1.2.20)" },
    { "do": "check", "note": "A/T の目標と THRUST LIM の EPR も同じ", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "op": "between", "value": [1.455, 1.468], "cite": "FPPM p.44 (1.2.20)" },
    { "do": "check", "note": "EEC の最大 EPR も p.44 の 1.46（Max Takeoff EPR：p.22）", "dref": "laminar/B747/engines/display_EPR_max[0]", "op": "between", "value": [1.455, 1.468], "cite": "FPPM p.22 (1.1.4)" },
    { "do": "check", "note": "減りは 0 %", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [-0.01, 0.01] },
    { "do": "snapshot", "note": "TO", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/display_EPR_max[0]", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_S", "laminar/B747/fms3/Line03_L" ] },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_to_40c" },
    { "do": "cdu", "note": "<TO 2（L4）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は TO 2", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "TO 2" },
    { "do": "check", "note": "TO 2 の基準は FPPM p.69 の 40 ℃ の 1.33（前は約 1.365）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [1.326, 1.338], "cite": "FPPM p.69 (1.3.23)" },
    { "do": "check", "note": "TO 2 の減りは 20 %（上昇の減格の自動選択へ）", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [19.9, 20.1], "cite": "FPPM p.69 (1.3.23)" },
    { "do": "check", "note": "EEC の最大 EPR は全推力の 1.46 のまま", "dref": "laminar/B747/engines/display_EPR_max[0]", "op": "between", "value": [1.455, 1.468] },
    { "do": "snapshot", "note": "TO 2", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/to_reduction", "laminar/B747/engine/derate/CLB", "laminar/B747/fms3/Line02_S", "laminar/B747/fms3/Line03_S" ] },
    { "do": "shot", "name": "eicas_to2_40c" },
    { "do": "cdu", "note": "<TO（L2）、SEL 55（L1）", "keys": ["L2", "55", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は D-TO", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "D-TO" },
    { "do": "check", "note": "D-TO SEL 55 の基準は p.44 の 55 ℃ の 1.35（前は 54 ℃ で止まって 1.38）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [1.345, 1.356], "cite": "FPPM p.22 (1.1.4), p.44 (1.2.20)" },
    { "do": "check", "note": "減りは 20〜25 %", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [20, 24.9] },
    { "do": "snapshot", "note": "D-TO SEL 55", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/to_reduction", "laminar/B747/fms/thrlim/eicas" ] },
    { "do": "cdu", "note": "SEL 65（L1）", "keys": ["65", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "D-TO SEL 65 の基準は p.22 の 25 % 減の下限（OAT 約 40 ℃ の最大 約 1.46 から 約 1.297。p.44 の 65 ℃ の 1.29 より上）", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [1.292, 1.302], "cite": "FPPM p.22 (1.1.4); FCOM p.1273" },
    { "do": "check", "note": "減りは 25 %（最大）", "dref": "laminar/B747/engines/to_reduction", "op": "between", "value": [24.9, 25.1], "cite": "FCOM p.1273" },
    { "do": "snapshot", "note": "D-TO SEL 65", "drefs": [ "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/to_reduction", "laminar/B747/fms/thrlim/eicas" ] },
    { "do": "shot", "name": "eicas_dto65_40c" },
    { "do": "cdu", "note": "SEL を消す（DEL、L1）", "keys": ["DEL", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "推力制限は TO に戻る", "dref": "laminar/B747/engines/ref_thr_limit_mode", "op": "==", "value": "TO" },
    { "do": "check", "note": "基準は 1.46 に戻る", "dref": "laminar/B747/engines/display_EPR_ref[0]", "op": "between", "value": [1.455, 1.468] },
    { "do": "view", "name": "forward" }
  ]
}
