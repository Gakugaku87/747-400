{
  "name": "s226_cockpit_lighting",
  "description": "照明の 7-2e（操縦室照明の電源、LIGHT-07。notes/ATA-33.md §15）の X-Plane での確認、夜の地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。flood・dome・機長の計器盤照明のつまみを 0、F/O の計器盤照明を 1 にする。STORM で flood が最大になること（電池のバスの R8068：ATA33 p.20、p.72）。GEN CONT 4 と BUS TIE 4 を OFF にして AC バス 4 を失うと、機長の計器盤照明と機長の flood が main standby bus から固定の明るさで点き（つまみは 0 のまま：ATA33 p.24、p.26）、F/O の計器盤照明（AC バス 3）はつまみのままのこと。GEN CONT 1 と BUS TIE 1 で ground service bus を失うと、アイルスタンドの flood が固定抵抗で、dome が電池のバスから固定で点くこと（ATA33 p.72）。固定の明るさは推定。flood の明るさは X-Plane の HUD_brightness_ratio（夜は 0.01 ほど）に比例するので、点いたかどうかと STORM との大小だけを見る。操縦室を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 22.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "check", "note": "STORM は OFF（position 1）で始まる", "dref": "laminar/B747/toggle_switch/position[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "SPILL LIGHTS は NORM（STORM と電源が効く方）", "dref": "laminar/B747/fmc/spill_lights", "op": "==", "value": 0 },
    { "do": "check", "note": "AC バス 3 が通電", "dref": "laminar/B747/electrical/bus/ac[2]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC バス 4 が通電", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "main standby bus が通電", "dref": "laminar/B747/electrical/bus/stby_main", "op": "==", "value": 1 },
    { "do": "check", "note": "main battery bus が通電", "dref": "laminar/B747/electrical/bus/bat_main", "op": "==", "value": 1 },
    { "do": "set", "note": "機長の flood のつまみ 0", "dref": "laminar/B747/light/flood/rheostat/captain_panel", "value": 0 },
    { "do": "set", "note": "F/O の flood 0", "dref": "laminar/B747/light/flood/rheostat/first_officer_panel", "value": 0 },
    { "do": "set", "note": "グレアシールドの flood 0", "dref": "laminar/B747/light/flood/rheostat/mcp_panel", "value": 0 },
    { "do": "set", "note": "アイルスタンドの flood 0", "dref": "laminar/B747/light/flood/rheostat/aisle_stand", "value": 0 },
    { "do": "set", "note": "dome 0", "dref": "laminar/B747/light/flood/rheostat/overhead", "value": 0 },
    { "do": "set", "note": "機長の計器盤照明 0", "dref": "laminar/B747/switches/instrument_brightness_ratio[6]", "value": 0 },
    { "do": "set", "note": "F/O の計器盤照明 1", "dref": "laminar/B747/switches/instrument_brightness_ratio[8]", "value": 1 },
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "drefs": ["sim/cockpit2/electrical/HUD_brightness_ratio", "laminar/B747/light/spill/ratio/captain_panel[3]", "laminar/B747/light/spill/ratio/aisle_stand[3]", "sim/cockpit2/switches/panel_brightness_ratio[0]", "sim/cockpit2/switches/instrument_brightness_ratio[6]", "sim/cockpit2/switches/instrument_brightness_ratio[8]"] },
    { "do": "check", "note": "全部のバス：機長の flood はつまみの 0", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "全部のバス：dome はつまみの 0", "dref": "sim/cockpit2/switches/panel_brightness_ratio[0]", "op": "<", "value": 0.01 },
    { "do": "check", "note": "機長の計器盤照明はつまみの 0", "dref": "sim/cockpit2/switches/instrument_brightness_ratio[6]", "op": "<", "value": 0.02 },
    { "do": "check", "note": "F/O の計器盤照明はつまみの 1（AC バス 3）", "dref": "sim/cockpit2/switches/instrument_brightness_ratio[8]", "op": ">", "value": 0.95 },
    { "do": "check", "note": "客室灯（generic 25）：夜、地上、747 の AC バスあり（2026-11-04 から 747 の母線。前は X-Plane の発電機）", "dref": "sim/cockpit2/switches/generic_lights_switch[25]", "op": "between", "value": [0.24, 0.26] },
    { "do": "view", "note": "操縦室の前方", "the": -15, "psi": 15, "fov": 75 },
    { "do": "shot", "name": "lighting_knobs_off" },

    { "do": "mark", "note": "STORM" },
    { "do": "switch", "note": "STORM を ON（position 0）", "dref": "laminar/B747/toggle_switch/position[0]", "value": 0, "cmd": "laminar/B747/toggle_switch/storm_light" },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "drefs": ["laminar/B747/light/spill/ratio/captain_panel[3]", "laminar/B747/light/spill/ratio/aisle_stand[3]", "sim/cockpit2/switches/panel_brightness_ratio[0]"] },
    { "do": "check", "note": "STORM：機長の flood が点く（つまみは 0。最大 = 2 × HUD_brightness_ratio、夜は 0.02 ほど）", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "op": ">", "value": 0.001, "cite": "ATA33 p.20" },
    { "do": "remember", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "as": "storm_flood" },
    { "do": "check", "note": "STORM：アイルスタンドの flood も最大", "dref": "laminar/B747/light/spill/ratio/aisle_stand[3]", "op": ">", "value": 0.001, "cite": "ATA33 p.72" },
    { "do": "check", "note": "STORM：dome もつまみを越えて点く", "dref": "sim/cockpit2/switches/panel_brightness_ratio[0]", "op": ">", "value": 0.001, "cite": "ATA33 p.72" },
    { "do": "shot", "name": "lighting_storm" },
    { "do": "switch", "note": "STORM を OFF", "dref": "laminar/B747/toggle_switch/position[0]", "value": 1, "cmd": "laminar/B747/toggle_switch/storm_light" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "STORM OFF：機長の flood はつまみの 0 に戻る", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "op": "==", "value": 0 },

    { "do": "mark", "note": "AC バス 4 を失う" },
    { "do": "switch", "note": "GEN CONT 4 OFF", "dref": "laminar/B747/button_switch/position[25]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_4" },
    { "do": "switch", "note": "BUS TIE 4 OFF", "dref": "laminar/B747/button_switch/position[21]", "value": 0, "cmd": "laminar/B747/button_switch/elec_bus_tie_4" },
    { "do": "wait", "note": "AC バス 4 が無電源", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "drefs": ["laminar/B747/light/spill/ratio/captain_panel[3]", "sim/cockpit2/switches/instrument_brightness_ratio[6]", "sim/cockpit2/switches/instrument_brightness_ratio[7]", "sim/cockpit2/switches/instrument_brightness_ratio[8]"] },
    { "do": "check", "note": "main standby bus はある", "dref": "laminar/B747/electrical/bus/stby_main", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の flood は standby の固定で点く（つまみは 0）", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "op": ">", "value": 0.001, "cite": "ATA33 p.26" },
    { "do": "check", "note": "固定は STORM の最大より暗い（推定：最大の半分）", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "op": "<", "value": 0, "rel": "storm_flood" },
    { "do": "check", "note": "機長の計器盤照明は standby の固定（推定 0.3）", "dref": "sim/cockpit2/switches/instrument_brightness_ratio[6]", "op": "between", "value": [0.25, 0.35], "cite": "ATA33 p.24" },
    { "do": "check", "note": "F/O の計器盤照明はつまみのまま（AC バス 3）", "dref": "sim/cockpit2/switches/instrument_brightness_ratio[8]", "op": ">", "value": 0.95, "cite": "ATA33 p.28" },
    { "do": "shot", "name": "lighting_ac4_lost" },
    { "do": "switch", "note": "BUS TIE 4 AUTO", "dref": "laminar/B747/button_switch/position[21]", "value": 1, "cmd": "laminar/B747/button_switch/elec_bus_tie_4" },
    { "do": "switch", "note": "GEN CONT 4 ON", "dref": "laminar/B747/button_switch/position[25]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_4" },
    { "do": "wait", "note": "AC バス 4 が戻る", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 1, "timeout": 15 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "機長の flood はつまみの 0 に戻る", "dref": "laminar/B747/light/spill/ratio/captain_panel[3]", "op": "==", "value": 0 },

    { "do": "mark", "note": "ground service bus を失う（AC バス 1）" },
    { "do": "switch", "note": "GEN CONT 1 OFF", "dref": "laminar/B747/button_switch/position[22]", "value": 0, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_1" },
    { "do": "switch", "note": "BUS TIE 1 OFF", "dref": "laminar/B747/button_switch/position[18]", "value": 0, "cmd": "laminar/B747/button_switch/elec_bus_tie_1" },
    { "do": "wait", "note": "ground service bus が無電源", "dref": "laminar/B747/electrical/bus/gnd_svc", "op": "==", "value": 0, "timeout": 10 },
    { "do": "sleep", "seconds": 2 },
    { "do": "snapshot", "drefs": ["laminar/B747/light/spill/ratio/aisle_stand[3]", "sim/cockpit2/switches/panel_brightness_ratio[0]"] },
    { "do": "check", "note": "アイルスタンドの flood は固定抵抗で点く（つまみは 0）", "dref": "laminar/B747/light/spill/ratio/aisle_stand[3]", "op": ">", "value": 0.001, "cite": "ATA33 p.72" },
    { "do": "check", "note": "固定抵抗の明るさは STORM の最大より暗い", "dref": "laminar/B747/light/spill/ratio/aisle_stand[3]", "op": "<", "value": 0, "rel": "storm_flood" },
    { "do": "check", "note": "dome は電池のバスから固定（推定 0.4）", "dref": "sim/cockpit2/switches/panel_brightness_ratio[0]", "op": "between", "value": [0.35, 0.45], "cite": "ATA33 p.72" },
    { "do": "view", "note": "アイルスタンド", "the": -45, "psi": 35, "fov": 75 },
    { "do": "shot", "name": "lighting_gsb_lost" },
    { "do": "switch", "note": "BUS TIE 1 AUTO", "dref": "laminar/B747/button_switch/position[18]", "value": 1, "cmd": "laminar/B747/button_switch/elec_bus_tie_1" },
    { "do": "switch", "note": "GEN CONT 1 ON", "dref": "laminar/B747/button_switch/position[22]", "value": 1, "cmd": "laminar/B747/button_switch/elec_gen_ctrl_1" },
    { "do": "wait", "note": "ground service bus が戻る", "dref": "laminar/B747/electrical/bus/gnd_svc", "op": "==", "value": 1, "timeout": 15 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "dome はつまみの 0 に戻る", "dref": "sim/cockpit2/switches/panel_brightness_ratio[0]", "op": "<", "value": 0.01 },
    { "do": "cas", "note": "終わり" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
