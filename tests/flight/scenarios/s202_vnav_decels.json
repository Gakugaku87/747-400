  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L（ALT HOLD。A/P が入るまでの約 20 秒で上がり、1・2 回目は約 29,000 ft で始まった）", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "set", "note": "MCP 高度 25,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 25000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 25000 },
    { "do": "cmd", "note": "FLCH で FL250 へ", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "wait", "note": "FL250 に着く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [24900, 25150], "timeout": 300 },
