{
  "name": "s202_vnav_decels",
  "description": "6-1・6-2 段 LF1（試験ラインフライト s198 で見つけた降下の減速：notes/LINE_FLIGHTS.md §1）の X-Plane での確認。FL250・約 330 kt で、ATMUG の約 68 NM 西から東へ空中開始（s140 の約 38 NM 西：FL250 の T/D の手前。機体を読み直す。3 回目は s140 と同じ所で、FLCH で FL250 へ降りる間に T/D を過ぎた）。RTE RJAA→RJBB、STAR ATMUGA、ILS06LZ の遷移 ATVID（STAR とつながる）、ACTIVATE と EXEC、ATMUG へ DIRECT TO、LNAV、PERF INIT（ZFW 200、COST INDEX 100、CRZ ALT FL250）、MCP 3,000 ft で VNAV。T/D で降下の段（3）になったら、まず FL250 のまま降下速度まで水平に減速し（FCOM p.1264 の 2）、近づいてから降りる。10,000 ft の手前で目標が 240 kt になり、約 500 fpm で降りながら減速して（p.1264 の 4）、10,000 ft を 250 kt より遅く通る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 34.62, "longitude": 132.75, "elevation_in_meters": 7620, "heading_true": 97, "speed_in_meters_per_second": 230 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
