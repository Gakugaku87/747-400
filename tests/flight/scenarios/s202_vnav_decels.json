    { "do": "check", "note": "T/D から水平に減速（FCOM p.1264 の 2：VNAV の縦の速さは 0）", "dref": "laminar/B747/fms/vnav/vs", "op": "between", "value": [-100, 100] },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "15 秒後も FL250 の近く", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "between", "value": [24800, 25200] },
    { "do": "wait", "note": "降り始める", "dref": "sim/flightmodel/position/vh_ind_fpm", "op": "<", "value": -800, "timeout": 120 },
    { "do": "snapshot", "note": "降り始め", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/path_dev" ] },
    { "do": "check", "note": "降下速度の近くまで減速してから（ECON の降下速度の 16 kt 上より遅い。T/D の速さは空中開始の後の加速の行き過ぎで揺れ、アイドルの水平の減速は約 31 kt：11-10 は 339.8 kt から 308.2 kt、2026-11-11 は 341.3 kt から 310.0 kt。11-11 の 1 回目は EEC がスロットルを 25 秒かけて下げ 316 kt：FLAT IDLE で直した）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 312 },
    { "do": "wait", "note": "10,000 ft の手前で目標 240 kt（FCOM p.1264 の 4）", "dref": "laminar/B747/fms/vnav/cas", "op": "==", "value": 240, "timeout": 900 },
    { "do": "mark" },
    { "do": "snapshot", "note": "減速の始め", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms/vnav/vs", "laminar/B747/fms/vnav/path_dev", "laminar/B747/fms/vnav/at" ] },
    { "do": "check", "note": "10,000 ft より上", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 10100 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "約 500 fpm で降りながら（VNAV の縦の速さ）", "dref": "laminar/B747/fms/vnav/vs", "op": "between", "value": [-900, -250] },
    { "do": "wait", "note": "10,000 ft の下", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": "<", "value": 10000, "timeout": 300 },
    { "do": "snapshot", "note": "10,000 ft", "drefs": [ "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/fms/vnav/cas", "laminar/B747/fms/vnav/path_dev", "laminar/B747/autopilot/FMA/active_pitch_mode", "laminar/B747/autopilot/FMA/autothrottle_mode" ] },
    { "do": "check", "note": "250 kt より遅く通る（s198 は 291 kt）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": "<", "value": 250 },
    { "do": "check", "note": "VNAV PTH のまま", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "check", "note": "経路からの偏差は ±400 ft の中", "dref": "laminar/B747/fms/vnav/path_dev", "op": "between", "value": [-400, 400] },
    { "do": "record_stop" }
  ]
