{
  "name": "s169_check_alt_tgt",
  "description": "6-1/6-2 段 11c2b（CHECK ALT TGT）の X-Plane での確認。空中、成田の北の 10,000 ft（s139 と同じ所、機体を読み直す）。RJAA→RJBB を XAC・SPENS・BOKJO で、ZFW 200 t、CRZ ALT FL350、CI 100。MCP 高度を 8,000 ft（機体の下）にして VNAV を engage すると、機体は MCP 高度と FMC の目標高度（FL350）の間なので、VNAV PTH で水平を保ち CHECK ALT TGT（FCOM p.1431）。20 秒水平のまま。MCP 高度を 20,000 ft にすると VNAV SPD の上昇に戻り、メッセージは消える。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "record_start" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 35,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },

    { "do": "mark", "note": "MCP 高度は下、FMC の目標は上：CHECK ALT TGT" },
    { "do": "set", "note": "MCP 高度 8,000 ft（機体の下）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 8000 },
    { "do": "cdu", "note": "CLR（書き込み行を空に）", "keys": ["CLR", "CLR", "CLR"] },
    { "do": "sleep", "seconds": 5, "note": "MCP の高度が中へ写るのと FMC の VNAV" },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "check", "note": "FMC は上昇（1）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 1 },
    { "do": "wait", "note": "空中開始の後の ALT HOLD の揺れが収まる（2026-11-01 の 1 回目は −1,170 fpm で engage して、20 秒後は +358 fpm で戻る途中だった）", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-150, 150], "timeout": 90 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "CHECK ALT TGT の旗（DRindex 3）", "dref": "laminar/B747/fms/notification[4]", "op": "==", "value": 1, "timeout": 10 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "書き込み行に CHECK ALT TGT（FCOM p.1431）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "CHECK ALT TGT" },
    { "do": "check", "note": "FMC は VNAV PTH（2）で水平", "dref": "laminar/B747/fms/vnav/mode", "op": "==", "value": 2 },
    { "do": "check", "note": "FMA は VNAV PTH（6）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 6 },
    { "do": "snapshot", "note": "engage の時", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms/vnav/alt", "sim/cockpit2/gauges/indicators/vvi_fpm_pilot" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_check_alt_tgt" },
    { "do": "sleep", "seconds": 20, "note": "水平のまま" },
    { "do": "check", "note": "昇降率は小さい", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300] },
    { "do": "check", "note": "まだ CHECK ALT TGT", "dref": "laminar/B747/fms/notification[4]", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "20 秒後", "drefs": [ "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/fms/vnav/alt" ] },

    { "do": "mark", "note": "MCP 高度を上へ：上昇に戻る" },
    { "do": "set", "note": "MCP 高度 20,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 20000 },
    { "do": "wait", "note": "メッセージの旗は消える", "dref": "laminar/B747/fms/notification[4]", "op": "==", "value": 0, "timeout": 10 },
    { "do": "wait", "note": "VNAV SPD の上昇（4）", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 15 },
    { "do": "wait", "note": "上がり始める", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": ">", "value": 500, "timeout": 30 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
