{
  "name": "s08_autostart",
  "description": "エンジンの autostart（2-3）の X-Plane での確認。エンジン運転中の地上で開始し、パックを OFF にしてエンジン 4 を CUTOFF で止め、AUTOSTART ON で START 4 → RUN（クロスブリードの空気）。START だけでは start valve が開かないこと、RUN で motoring、所定の N2 で燃料と点火、50 % N2 で START が戻ること、idle まで。次に X-Plane の igniter の故障で同じ始動をし、light-off しないので 30 秒 motoring して両 igniter で再試行、2 回目で中止して ENG 4 AUTOSTART（caution）が出ることを見る（PW、109）。期待値は FCOM 7.13・7.20（p.859-882）、notes/ATA-70-80.md §4.6。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始直後", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/engines/type", "laminar/B747/button_switch/position[45]",
      "sim/flightmodel/engine/ENGN_N2_[3]", "sim/cockpit2/engine/actuators/igniter_on[3]",
      "sim/cockpit2/engine/actuators/auto_ignite_on[3]", "laminar/B747/engines/fuel_valve_pos[3]" ] },
    { "do": "cas", "note": "開始直後" },
    { "do": "check", "note": "X-Plane の auto-ignite は切る（点火はモデルが決める）", "dref": "sim/cockpit2/engine/actuators/auto_ignite_on[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "運転中のエンジン 4 に点火の条件なし", "dref": "sim/cockpit2/engine/actuators/igniter_on[3]", "op": "==", "value": 0 },
    { "do": "check", "note": "エンジン燃料弁 4 開", "dref": "laminar/B747/engines/fuel_valve_pos[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "運転中（RUN）は EGT の始動限界の線なし（FCOM p.838）", "dref": "laminar/B747/engines/EGT/start_limit_on[3]", "op": "==", "value": 0 },
    { "do": "switch", "note": "PACK 1 OFF（始動の空気のため。FCOM p.123）", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "switch", "note": "PACK 2 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[1]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_02/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_02/sel_dial_dn" },
    { "do": "switch", "note": "PACK 3 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[2]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_03/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_03/sel_dial_dn" },
    { "do": "switch", "note": "AUTOSTART ON", "dref": "laminar/B747/button_switch/position[45]", "value": 1, "cmd": "laminar/B747/button_switch/start_autostart" },
    { "do": "check", "note": ">AUTOSTART OFF なし", "dref": "laminar/B747/CAS/advisory_status[304]", "op": "==", "value": 0 },

    { "do": "mark", "note": "エンジン 4 を止める" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "エンジン 4 の N2 が 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180 },
    { "do": "check", "note": "CUTOFF で EGT の始動限界の線（FCOM p.838、p.879）", "dref": "laminar/B747/engines/EGT/start_limit_on[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "ほかのエンジンは線なし", "dref": "laminar/B747/engines/EGT/start_limit_on[2]", "op": "==", "value": 0 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_eng4_cutoff" },

    { "do": "mark", "note": "autostart" },
    { "do": "switch", "note": "START 4（autostart では arm だけ）", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "RUN の前は start valve を開けない（FCOM p.862、p.879）", "dref": "laminar/B747/engines/start_valve_cmd[3]", "op": "==", "value": 0 },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN（autostart の開始）", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "EEC が start valve を開く", "dref": "laminar/B747/air/engine4/bleed_start_valve_pos", "op": ">", "value": 0.9, "timeout": 10 },
    { "do": "check", "note": "motoring 中は燃料なし", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 0 },
    { "do": "wait", "note": "所定の N2 で燃料（PW 20 %：推定）", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "check", "note": "燃料と同時に点火", "dref": "sim/cockpit2/engine/actuators/igniter_on[3]", "op": "==", "value": 1 },
    { "do": "wait", "note": "light-off", "dref": "sim/flightmodel2/engines/engine_is_burning_fuel[3]", "op": "==", "value": 1, "timeout": 20 },
    { "do": "check", "note": "RUN でも始動の間は始動限界の線が残る", "dref": "laminar/B747/engines/EGT/start_limit_on[3]", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "始動中の EGT", "drefs": [
      "laminar/B747/engines/display_EGT[3]", "laminar/B747/engines/EGT/white_on[3]", "laminar/B747/engines/EGT/red_on[3]",
      "sim/flightmodel/engine/ENGN_N2_[3]" ] },
    { "do": "wait", "note": "50 % N2 で START 4 が戻る（FCOM p.879）", "dref": "laminar/B747/toggle_switch/position[19]", "op": "==", "value": 0, "timeout": 90 },
    { "do": "wait", "note": "start valve が閉じる", "dref": "laminar/B747/air/engine4/bleed_start_valve_pos", "op": "<", "value": 0.1, "timeout": 5 },
    { "do": "wait", "note": "idle（N2 60 % 以上）", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": ">=", "value": 60, "timeout": 120 },
    { "do": "sleep", "seconds": 15 },
    { "do": "check", "note": "始動が終われば点火も止まる", "dref": "sim/cockpit2/engine/actuators/igniter_on[3]", "op": "==", "value": 0 },
    { "do": "wait", "note": "アイドルで落ち着けば始動限界の線が消える（CF6：ATA70_80 p.356-357。始動モデルの始動完了：N2 の変化が 0.15 %/秒未満で 5 秒）", "dref": "laminar/B747/engines/EGT/start_limit_on[3]", "op": "==", "value": 0, "timeout": 40 },
    { "do": "check", "note": "アイドルの EGT は白", "dref": "laminar/B747/engines/EGT/white_on[3]", "op": "==", "value": 1 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_eng4_started" },
    { "do": "check", "note": "ENG 4 AUTOSTART なし", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 0 },
    { "do": "check", "note": "STARTER CUTOUT 4 なし", "dref": "laminar/B747/CAS/caution_status[64]", "op": "==", "value": 0 },
    { "do": "check", "note": "ENG 4 START VLV なし", "dref": "laminar/B747/CAS/advisory_status[141]", "op": "==", "value": 0 },
    { "do": "cas", "note": "autostart の後" },

    { "do": "mark", "note": "igniter の故障で autostart が中止する" },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "N2 10 % 未満", "dref": "sim/flightmodel/engine/ENGN_N2_[3]", "op": "<", "value": 10, "timeout": 180 },
    { "do": "set", "note": "X-Plane の故障：igniter 4（6 = 故障中）", "dref": "sim/operation/failures/rel_ignitr3", "value": 6 },
    { "do": "switch", "note": "START 4", "dref": "laminar/B747/toggle_switch/position[19]", "value": 1, "cmd": "laminar/B747/toggle_switch/engine_start4" },
    { "do": "switch", "note": "FUEL CONTROL 4 RUN", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 1, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "燃料が入る", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 1, "timeout": 60 },
    { "do": "wait", "note": "light-off しないので 20 秒で燃料を切り 30 秒 motoring（FCOM p.881）", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 0, "timeout": 25 },
    { "do": "check", "note": "motoring は続く（start valve 開）", "dref": "laminar/B747/air/engine4/bleed_start_valve_pos", "op": ">", "value": 0.9 },
    { "do": "wait", "note": "再試行で燃料", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 1, "timeout": 35 },
    { "do": "wait", "note": "2 回目も light-off せず中止（109 は 2 回）：ENG 4 AUTOSTART（FCOM p.899）", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 1, "timeout": 25 },
    { "do": "check", "note": "中止で START 4 が戻る", "dref": "laminar/B747/toggle_switch/position[19]", "op": "==", "value": 0 },
    { "do": "check", "note": "中止で燃料なし", "dref": "sim/cockpit2/engine/actuators/mixture_ratio[3]", "op": "==", "value": 0 },
    { "do": "cas", "note": "autostart の中止" },
    { "do": "set", "note": "igniter 4 の故障を戻す", "dref": "sim/operation/failures/rel_ignitr3", "value": 0 },
    { "do": "switch", "note": "FUEL CONTROL 4 CUTOFF（中止を解く）", "dref": "laminar/B747/fuel/fuel_control/toggle_sw_pos[3]", "value": 0, "cmd": "laminar/B747/fuel/fuel_control_4/toggle_switch" },
    { "do": "wait", "note": "ENG 4 AUTOSTART が消える", "dref": "laminar/B747/CAS/caution_status[22]", "op": "==", "value": 0, "timeout": 3 }
  ]
}
