{
  "name": "s29_greenband",
  "description": "離陸のグリーンバンド（4-1 段 2c）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に、FMC の離陸トリム（laminar/B747/fmc/elevator_trim）で帯が選ばれ（mid 3.35–8.15、nose up 3.35–10.15、nose down 1.35–8.15：ATA27 p.521。選び方は資料に無く推定）、安定板の指示器の 3D の帯が mid は中央、nose up は上端 10.15、nose down は下端寄りに出る（写真）。V1 を超えると mid に戻る。CONFIG STAB は選ばれた帯の外で離陸推力にすると出て（ATA27 p.729–730）、帯の中に戻すと消える。nose up 帯なら 9.5 units でも出ない。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "snapshot", "note": "開始", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/fmc/elevator_trim", "laminar/B747/flt_ctrls/elevator_trim/mid/indicator",
      "laminar/B747/flt_ctrls/stab_trim/units", "laminar/B747/airspeed/V1", "sim/cockpit2/controls/parking_brake_ratio" ] },

    { "do": "mark", "note": "帯の選択と指示器" },
    { "do": "set", "note": "FMC の離陸トリム 9（前方 CG。Web API は XTLua の dataref に小数を書けない）", "dref": "laminar/B747/fmc/elevator_trim", "value": 9 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "nose up 帯：3D の帯の上端が 10.15（指示 0.933）", "dref": "laminar/B747/flt_ctrls/elevator_trim/mid/indicator", "op": "between", "value": [0.92, 0.945] },
    { "do": "view", "the": -50, "psi": 21, "fov": 30 },
    { "do": "shot", "name": "trim_ind_nose_up" },
    { "do": "view", "the": -54, "psi": 17, "fov": 30 },
    { "do": "shot", "name": "trim_ind_nose_up_b" },
    { "do": "set", "note": "FMC の離陸トリム 2（後方 CG）", "dref": "laminar/B747/fmc/elevator_trim", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "nose down 帯：3D の帯はいちばん下（指示 0）", "dref": "laminar/B747/flt_ctrls/elevator_trim/mid/indicator", "op": "between", "value": [0, 0.01] },
    { "do": "shot", "name": "trim_ind_nose_down" },
    { "do": "set", "note": "FMC の離陸トリム 6.0", "dref": "laminar/B747/fmc/elevator_trim", "value": 6.0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "mid 帯：中央（指示 0.450）", "dref": "laminar/B747/flt_ctrls/elevator_trim/mid/indicator", "op": "between", "value": [0.44, 0.46] },
    { "do": "shot", "name": "trim_ind_mid" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "CONFIG STAB" },
    { "do": "set", "note": "V1 150 kt", "dref": "laminar/B747/airspeed/V1", "value": 150 },
    { "do": "set", "note": "安定板 9.5 units（mid 帯の外）", "dref": "sim/flightmodel2/controls/elevator_trim", "value": 0.26667 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "安定板が外からの値に合う", "dref": "laminar/B747/flt_ctrls/stab_trim/units", "op": "between", "value": [9.45, 9.55] },
    { "do": "set", "note": "推力レバー全開（パーキング・ブレーキはかけたまま）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "wait", "note": "エンジン 2・3 が離陸推力", "dref": "laminar/B747/engines/display_N1[2]", "op": ">", "value": 90, "timeout": 40 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "CONFIG STAB（ATA27 p.729–730）", "dref": "laminar/B747/CAS/warning_status[7]", "op": "==", "value": 1 },
    { "do": "cas", "note": "CONFIG STAB" },
    { "do": "set", "note": "安定板 6.0 units（mid 帯の中）", "dref": "sim/flightmodel2/controls/elevator_trim", "value": -0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "帯の中：CONFIG STAB が消える", "dref": "laminar/B747/CAS/warning_status[7]", "op": "==", "value": 0 },
    { "do": "set", "note": "FMC の離陸トリム 9（nose up 帯）", "dref": "laminar/B747/fmc/elevator_trim", "value": 9 },
    { "do": "set", "note": "安定板 9.5 units（nose up 帯の中）", "dref": "sim/flightmodel2/controls/elevator_trim", "value": 0.26667 },
    { "do": "sleep", "seconds": 1.5 },
    { "do": "check", "note": "nose up 帯なら 9.5 units でも CONFIG STAB は出ない（前は FMC トリム ±2.25 の帯）", "dref": "laminar/B747/CAS/warning_status[7]", "op": "==", "value": 0 },
    { "do": "set", "note": "推力レバーをアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "set", "note": "FMC の離陸トリムを戻す", "dref": "laminar/B747/fmc/elevator_trim", "value": 0 },
    { "do": "set", "note": "V1 を戻す（999 は未設定）", "dref": "laminar/B747/airspeed/V1", "value": 999 },
    { "do": "sleep", "seconds": 2 }
  ]
}
