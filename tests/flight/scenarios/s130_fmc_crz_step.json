{
  "name": "s130_fmc_crz_step",
  "description": "6-1/6-2 段 8b2（CRZ のページ）の X-Plane での確認、空中。FL350・M.84 で空中から始め（機体を読み直す）、RTE で RJAA→PHNL を ACTIVATE と EXEC（T/D は遠い）、CRZ ALT FL350、COST INDEX 100。CRZ のページの STEP TO（ICAO：出発前の CRZ ALT が無い空中開始は CRZ ALT の向き。FL350 は西向きで FL310・350・390…）と AT（OPT が STEP TO との中間になる重さ：FCOM p.1257）、水平飛行の EPR（PW）、OPT・MAX を記録し、期待値は記録の重量・外気温から性能 DB と `B747.68.crz_model.lua` で求めて比べる。STEP SIZE 2000 で CRZ ALT + 2,000 ft、DELETE で ICAO、乗員の STEP TO FL410、MAX を超える CRZ ALT で MAX ALT FLXXX（FMSPG p.131）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 10668, "heading_true": 90, "speed_in_meters_per_second": 249 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れと FMS の初期化" },
    { "do": "record_start" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える（機長の CDU の表示は fms3 の行）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→PHNL、ACTIVATE、EXEC", "keys": ["RTE", "RJAA", "L1", "PHNL", "R1", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "PERF INIT：COST INDEX 100", "keys": ["INITREF", "L6", "L3", "100", "L5"] },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cdu", "note": "NEXT：CRZ、CRZ ALT FL350", "keys": ["NEXT", "350", "L1"] },
    { "do": "sleep", "seconds": 6, "note": "ECON の計算" },
    { "do": "check", "note": "ACT ECON CRZ", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT ECON CRZ" },
    { "do": "check", "note": "STEP TO（ICAO の西向きの高度）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "FL(310|350|390|430)$" },
    { "do": "check", "note": "AT：最適な STEP の点の時刻と距離か NOW", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "([0-9]{4}z/ *[0-9]+NM|NOW)$" },
    { "do": "check", "note": "EPR の見出し（PW）", "dref": "laminar/B747/fms3/Line06_S", "op": "contains", "value": "EPR" },
    { "do": "check", "note": "水平飛行の EPR", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^1\\.[0-9]{2} " },
    { "do": "snapshot", "note": "CRZ のページと、期待値を求める重量・外気温・高度・風・方位・型式・経路の距離", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line06_S", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "sim/flightmodel/weight/m_total", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag", "sim/cockpit2/gauges/indicators/wind_speed_kts", "sim/flightmodel/position/mag_psi", "laminar/B747/engines/type", "laminar/B747/autopilot/dist/remaining_distance", "laminar/B747/autopilot/dist/top_of_descent", "sim/cockpit2/clock_timer/zulu_time_hours", "sim/cockpit2/clock_timer/zulu_time_minutes" ] },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_crz_icao" },
    { "do": "cdu", "note": "STEP SIZE 2000", "keys": ["2000", "L4"] },
    { "do": "check", "note": "STEP SIZE 2000", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^2000 " },
    { "do": "snapshot", "note": "CRZ ALT + 2,000 ft の倍数で OPT の上", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total" ] },
    { "do": "cdu", "note": "DELETE：ICAO に戻る", "keys": ["DEL", "L4"] },
    { "do": "check", "note": "ICAO", "dref": "laminar/B747/fms3/Line09_L", "op": "matches", "value": "^ICAO " },
    { "do": "cdu", "note": "乗員の STEP TO FL410", "keys": ["410", "R1"] },
    { "do": "check", "note": "STEP TO FL410", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "FL410$" },
    { "do": "snapshot", "note": "FL410 への AT（AVAIL AT のこともある）", "drefs": [ "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "sim/flightmodel/weight/m_total" ] },
    { "do": "shot", "name": "cdu_crz_step410" },
    { "do": "cdu", "note": "CRZ ALT FL450（MAX の上）", "keys": ["450", "L1"] },
    { "do": "check", "note": "MAX ALT FLXXX（入力は通る）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "MAX ALT FL" },
    { "do": "check", "note": "CRZ ALT は FL450 に", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^FL450" },
    { "do": "snapshot", "note": "MAX ALT のメッセージ", "drefs": [ "laminar/B747/fms3/Line14_L", "laminar/B747/fms3/Line09_L" ] },
    { "do": "shot", "name": "cdu_max_alt" },
    { "do": "cdu", "note": "CLR、CRZ ALT を FL350 に戻す", "keys": ["CLR", "350", "L1"] },
    { "do": "check", "note": "乗員の STEP TO は新しい CRZ ALT で消え、FMC のものに", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^FL350 .*FL(310|350|390|430)$|^FL350 *$" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
