{
  "name": "s192_atc_logon",
  "description": "6-1・6-2 段 12e（ATC のログオン）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。P&W の機体なので SIM CONFIG の FMC DATALINK を ON にする（最後に AUTO に戻す、保存はしない）。AutoATC の無いこの PC では DATALINK は NO COMM：ATC キーで ATC LOGON/STATUS（ATC COMM が無い：FMSPG p.277）、LOGON TO は箱、TAIL NO は X-Plane の登録記号、6R は NO COMM。LOGON TO に RJJJ、FLT NO に TEST123 を入れても NO COMM なので SEND> は出ない（FCOM p.755）。TAIL NO に JA8071 で VERIFY TAIL NUMBER（FCOM p.1436）。ADS を SELECT OFF で (OFF) と <SELECT ARM、戻す。<INDEX で ATC INDEX。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "cdu", "note": "ATC キー", "keys": ["ATC"] },
    { "do": "check", "note": "ATC COMM が無いので ATC LOGON/STATUS（FMSPG p.277）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC LOGON/STATUS" },
    { "do": "check", "note": "LOGON TO は箱、SEND なし", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "****                    " },
    { "do": "check", "note": "TAIL NO は X-Plane の登録記号（空でない）", "dref": "laminar/B747/fms3/Line07_L", "op": "matches", "value": "^[A-Z0-9]" },
    { "do": "check", "note": "DATALINK は NO COMM（AutoATC が無い）", "dref": "laminar/B747/fms3/Line13_L", "op": "==", "value": "<INDEX           NO COMM" },
    { "do": "check", "note": "ADS (ARM) <SELECT OFF と ADS EMERG SELECT ON>", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "<SELECT OFF   SELECT ON>" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_logon_status" },
    { "do": "cdu", "note": "LOGON TO に RJJJ、FLT NO に TEST123", "keys": ["RJJJ", "L1", "TEST123", "L2"] },
    { "do": "check", "note": "LOGON TO RJJJ、NO COMM なので SEND> なし（FCOM p.755）", "dref": "laminar/B747/fms3/Line03_L", "op": "==", "value": "RJJJ                    " },
    { "do": "check", "note": "FLT NO TEST123", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "TEST123" },
    { "do": "cdu", "note": "TAIL NO に JA8071", "keys": ["JA8071", "L3"] },
    { "do": "check", "note": "VERIFY TAIL NUMBER（FCOM p.1436）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "VERIFY TAIL NUMBER" },
    { "do": "check", "note": "TAIL NO JA8071", "dref": "laminar/B747/fms3/Line07_L", "op": "contains", "value": "JA8071" },
    { "do": "shot", "name": "cdu_logon_entries" },
    { "do": "cdu", "note": "CLR、ADS の SELECT OFF", "keys": ["CLR", "L5"] },
    { "do": "check", "note": "ADS (OFF) で <SELECT ARM、ADS EMERG なし", "dref": "laminar/B747/fms3/Line11_L", "op": "==", "value": "<SELECT ARM             " },
    { "do": "cdu", "note": "SELECT ARM で戻す、<INDEX", "keys": ["L5", "L6"] },
    { "do": "check", "note": "ATC INDEX", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ATC INDEX" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
