{
  "name": "s58_pfd_fpv",
  "description": "PFD の飛行経路ベクトル（FPV）と FPV・PITCH・ROLL の旗（5-2 段 4d、パネルの変更）の X-Plane での確認、空中。銚子沖の海上 10,000 ft・200 kt で開始（機体を読み直す）。FPV のスイッチは押すたびに入り切り（前はラッチしなかった：FCOM p.1037）。FPV は飛行経路角だけ地平線から上、偏流角だけ中心線から横に出て、腕は地平線と平行（バンクで回る）、足は飛行機の記号と平行（FCOM p.980）。X-Plane の副操縦士側の姿勢計の故障で旋回すると両席の姿勢が離れて ROLL の旗（3° の差：推定）。IRU L を ATT にすると FPV の旗。機長の PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 3048.0, "heading_true": 0, "speed_in_meters_per_second": 102.9 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 220 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 220 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "水平飛行", "dref": "sim/cockpit2/gauges/indicators/vvi_fpm_pilot", "op": "between", "value": [-300, 300], "timeout": 60 },
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "FPV は選んでいない", "dref": "laminar/B747/pfd/capt/fpv_show", "op": "==", "value": 0 },
    { "do": "cmd", "note": "機長の FPV スイッチ", "name": "laminar/B747/efis/fpv/capt/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "押すと選ばれる（ラッチ）", "dref": "laminar/B747/efis/fpv/capt/selected", "op": "==", "value": 1 },
    { "do": "check", "note": "機長の FPV が出る", "dref": "laminar/B747/pfd/capt/fpv_show", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士は選んでいない", "dref": "laminar/B747/pfd/fo/fpv_show", "op": "==", "value": 0 },
    { "do": "snapshot", "note": "水平飛行：FPV は迎角だけ飛行機の記号の下", "drefs": [ "laminar/B747/pfd/capt/fpv_x", "laminar/B747/pfd/capt/fpv_y", "sim/flightmodel/position/vpath",
      "sim/cockpit2/gauges/indicators/pitch_AHARS_deg_pilot", "sim/flightmodel/position/alpha", "sim/flightmodel/position/hpath", "sim/flightmodel/position/psi" ] },
    { "do": "check", "note": "水平飛行で迎角 0〜6°：飛行機の記号の 0〜41 px 下", "dref": "laminar/B747/pfd/capt/fpv_y", "op": "between", "value": [-41, 0] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_fpv_level" },
    { "do": "set", "note": "X-Plane の副操縦士側の姿勢計の故障（副操縦士の PFD の姿勢が止まる）", "dref": "sim/operation/failures/rel_cop_ahz", "value": 6 },
    { "do": "set", "note": "MCP 方位 090（右旋回）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 90 },
    { "do": "wait", "note": "両席のバンクが離れて ROLL の旗（3°：推定）", "dref": "laminar/B747/pfd/roll_flag", "op": "==", "value": 1, "timeout": 30 },
    { "do": "wait", "note": "バンクが 15° を超える", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": ">", "value": 15, "timeout": 30 },
    { "do": "snapshot", "note": "旋回中", "drefs": [ "laminar/B747/pfd/capt/fpv_x", "laminar/B747/pfd/capt/fpv_y", "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot",
      "sim/cockpit2/gauges/indicators/roll_AHARS_deg_copilot", "laminar/B747/pfd/roll_flag", "laminar/B747/pfd/pitch_flag" ] },
    { "do": "shot", "name": "pfd_fpv_bank_roll_flag" },
    { "do": "set", "dref": "sim/operation/failures/rel_cop_ahz", "value": 0 },
    { "do": "set", "note": "MCP 方位 007 に戻す", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "wait", "note": "故障を戻すと ROLL の旗が消える", "dref": "laminar/B747/pfd/roll_flag", "op": "==", "value": 0, "timeout": 60 },
    { "do": "switch", "note": "IRU L を ATT（空中で NAV を離れると、そのフライトの間は NAV に戻れない：FCOM p.1227）", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 3,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "慣性のデータが無い：FPV は消えて FPV の旗", "dref": "laminar/B747/pfd/capt/fpv_flag", "op": "==", "value": 1 },
    { "do": "check", "note": "FPV は消える", "dref": "laminar/B747/pfd/capt/fpv_show", "op": "==", "value": 0 },
    { "do": "wait", "note": "30 秒で姿勢が戻る（旗の位置を見るため）", "dref": "laminar/B747/pfd/capt/att", "op": "==", "value": 1, "timeout": 40 },
    { "do": "shot", "name": "pfd_fpv_flag" },
    { "do": "cmd", "note": "FPV スイッチをもう一度：選択を外す", "name": "laminar/B747/efis/fpv/capt/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "旗も消える", "dref": "laminar/B747/pfd/capt/fpv_flag", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
