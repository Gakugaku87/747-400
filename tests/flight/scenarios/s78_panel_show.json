{
  "name": "s78_panel_show",
  "description": "パネルの SHOW の条件の重なりの整理（5-2 段 7）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt で開始（機体を読み直す）。V スピードが無くても空中では PFD に NO V SPD が出ない（前は V1 の条件だけで出ていた：FCOM p.972）、ND の範囲の数字は MAP で出て MAP CTR では拡大の数字を出さない（2026-10-28 から MAP CTR は自分の航跡線と上下の数字：s110）、ECS のページのパックの A・B は弁が開のときだけ（パック 1 を OFF にすると OFF だけ）、上の EICAS は通常どおり。PFD・ND・EICAS を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/airspeed/V1", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/nd/mode/capt/sel_dial_pos", "laminar/B747/nd/map_center/capt", "laminar/B747/air/pack/valve_pos", "laminar/B747/air/pack/ptc" ] },
    { "do": "check", "note": "V スピードは無い（V1 = 999：NO V SPD の条件の片方）", "dref": "laminar/B747/airspeed/V1", "op": "==", "value": 999, "level": "warn" },
    { "do": "check", "note": "電波高度は 10 ft より上（空中）", "dref": "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "op": ">", "value": 10 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -21, "psi": -2, "fov": 28 },
    { "do": "shot", "name": "pfd_air" },
    { "do": "set", "note": "範囲 40 NM", "dref": "laminar/B747/nd/range/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "dref": "sim/cockpit2/EFIS/map_range", "value": 2 },
    { "do": "check", "note": "機長の ND は MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "op": "==", "value": 2 },
    { "do": "check", "note": "MAP（CTR でない）", "dref": "laminar/B747/nd/map_center/capt", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -22, "psi": 12, "fov": 28 },
    { "do": "shot", "name": "nd_map" },
    { "do": "cmd", "note": "CTR", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "wait", "note": "MAP CTR", "dref": "laminar/B747/nd/map_center/capt", "op": "==", "value": 1, "timeout": 3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "nd_ctr" },
    { "do": "cmd", "note": "CTR を戻す", "name": "laminar/B747/nd/center/capt/switch" },
    { "do": "wait", "dref": "laminar/B747/nd/map_center/capt", "op": "==", "value": 0, "timeout": 3 },
    { "do": "view", "note": "上の EICAS", "name": "eicas" },
    { "do": "shot", "name": "eicas_upper" },
    { "do": "cmd", "note": "ECS", "name": "laminar/B747/dsp/ecs_switch", "duration": 0.2 },
    { "do": "wait", "note": "ECS のページ", "dref": "laminar/B747/dsp/synoptic_display", "op": "==", "value": 5, "timeout": 3 },
    { "do": "view", "note": "下の EICAS", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "ecs_packs" },
    { "do": "switch", "note": "PACK 1 OFF", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 0,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "wait", "note": "パック 1 の弁が閉", "dref": "laminar/B747/air/pack/valve_pos[0]", "op": "<", "value": 0.5, "timeout": 20 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "ecs_pack1_off" },
    { "do": "switch", "note": "PACK 1 NORM", "dref": "laminar/B747/air/pack_ctrl/sel_dial_pos[0]", "value": 1,
      "cmd": "laminar/B747/air/pack_ctrl_01/sel_dial_up", "cmd_down": "laminar/B747/air/pack_ctrl_01/sel_dial_dn" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
