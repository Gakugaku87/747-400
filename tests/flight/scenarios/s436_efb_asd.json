{
  "name": "s436_efb_asd",
  "description": "離着陸性能の窓（notes/ATA-34-61-FMC.md §191）の滑走路長の制限の X-Plane での裏づけ 1：加速停止。RJAA 34L でエンジン運転中に始める（機体を読み直す）。約 352 t（積載 45 t・燃料 124.1 t）、フラップ 20、離陸トリム、オートブレーキ RTO。FMC の側に、この重さで滑走路長 2,600 m（滑走路の始めから 1,400 m 先から）の離陸を計算させ（FPPM の図で 352.6 t の制限：§191）、その V1 で中止する。推力レバーをアイドル、スピードブレーキのレバーを UP、逆推力は使わない（FPPM の乾いた滑走路の加速停止は逆推力を数えない）、RTO のブレーキ。ブレーキを外した所から止まった所までの距離（X-Plane の local_x・local_z）が、計算に使った 2,600 m に収まるかを、記録から見る（判定はあとで：重さの実際の値で計算し直す）。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    },
    "weight": {
      "payload_weight_in_kilograms": [4389, 4620, 5544, 7161, 1386, 11573, 10326, 0, 0],
      "fueltank_weight_in_kilograms": [12989.6, 13499.4, 38075.2, 38075.2, 13499.4, 3980.6, 3980.6, 0, 0]
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "check", "note": "機長側の IRS が整列（RTO の arm の条件）", "dref": "laminar/B747/flt_mgmt/iru/status[0]", "op": "==", "value": 2, "stop": true },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "snapshot", "note": "重さ・外気温・QNH・風", "drefs": ["sim/flightmodel/weight/m_total", "sim/weather/aircraft/temperature_ambient_deg_c", "sim/weather/barometer_sealevel_inhg", "sim/cockpit2/gauges/indicators/wind_heading_deg_mag", "sim/cockpit2/gauges/indicators/wind_speed_kts", "laminar/B747/engines/type"] },
    { "do": "set", "note": "FMC に計算させる：RJAA", "dref": "laminar/B747/efb/req_i[0]", "value": 925482 },
    { "do": "set", "note": "34L", "dref": "laminar/B747/efb/req_i[1]", "value": 1562473 },
    { "do": "set", "note": "フラップ 20", "dref": "laminar/B747/efb/req_i[2]", "value": 20 },
    { "do": "set", "note": "TO", "dref": "laminar/B747/efb/req_i[3]", "value": 0 },
    { "do": "set", "note": "assumed temperature なし", "dref": "laminar/B747/efb/req_i[4]", "value": 0 },
    { "do": "set", "note": "パック 3 台", "dref": "laminar/B747/efb/req_i[5]", "value": 3 },
    { "do": "set", "note": "防氷なし", "dref": "laminar/B747/efb/req_i[6]", "value": 0 },
    { "do": "set", "note": "乾いた滑走路", "dref": "laminar/B747/efb/req_i[7]", "value": 0 },
    { "do": "set", "note": "OAT 15 ℃（計算の条件：実際の外気温は記録）", "dref": "laminar/B747/efb/req_f[0]", "value": 15 },
    { "do": "set", "note": "QNH 1013", "dref": "laminar/B747/efb/req_f[1]", "value": 1013 },
    { "do": "set", "note": "無風", "dref": "laminar/B747/efb/req_f[2]", "value": 0 },
    { "do": "set", "note": "352,500 kg", "dref": "laminar/B747/efb/req_f[3]", "value": 352500 },
    { "do": "set", "note": "CG 22 %", "dref": "laminar/B747/efb/req_f[4]", "value": 22 },
    { "do": "set", "note": "1,400 m 先から（残り 2,600 m）", "dref": "laminar/B747/efb/req_f[5]", "value": 1400 },
    { "do": "set", "note": "長さはデータの", "dref": "laminar/B747/efb/req_f[6]", "value": 0 },
    { "do": "set", "note": "勾配はデータの", "dref": "laminar/B747/efb/req_f[7]", "value": -99 },
    { "do": "set", "note": "離陸を計算", "dref": "laminar/B747/efb/req_kind", "value": 2 },
    { "do": "set", "dref": "laminar/B747/efb/req_id", "value": 6001 },
    { "do": "wait", "note": "FMC が答える", "dref": "laminar/B747/efb/ans_id", "op": "==", "value": 6001, "timeout": 10 },
    { "do": "check", "note": "計算できた", "dref": "laminar/B747/efb/out[1]", "op": "==", "value": 1, "stop": true },
    { "do": "snapshot", "note": "計算：滑走路長・制限重量・最大・V1・VR・V2・VMBE・トリム", "drefs": ["laminar/B747/efb/out[22]", "laminar/B747/efb/out[3]", "laminar/B747/efb/out[4]", "laminar/B747/efb/out[8]", "laminar/B747/efb/out[9]", "laminar/B747/efb/out[12]", "laminar/B747/efb/out[13]", "laminar/B747/efb/out[14]", "laminar/B747/efb/out[15]", "laminar/B747/efb/out[20]", "laminar/B747/efb/msg"] },
    { "do": "remember", "dref": "laminar/B747/efb/out[12]", "as": "v1" },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s422 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "sleep", "seconds": 2 },
    { "do": "wait", "note": "フラップ 20 に着く", "dref": "laminar/B747/flt_ctrls/flap/transition_status", "op": "==", "value": 0, "timeout": 60 },
    { "do": "cmd", "note": "オートブレーキ RTO", "name": "sim/flight_controls/brakes_rto_auto" },
    { "do": "wait", "note": "セレクター RTO", "dref": "laminar/B747/gear/autobrakes/sel_dial_pos", "op": "==", "value": 0, "timeout": 5 },
    { "do": "cmd", "note": "主注意灯を消す", "name": "laminar/B747/button_switch/warn_caut_capt", "duration": 0.2 },
    { "do": "mark", "note": "ブレーキを外す（距離の始め）" },
    { "do": "snapshot", "note": "距離の始め：位置", "drefs": ["sim/flightmodel/position/local_x", "sim/flightmodel/position/local_z", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude", "sim/flightmodel/weight/m_total"] },
    { "do": "set", "note": "パーキングブレーキのレバーを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "set", "note": "推力レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "離陸の形態の警報なし", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 0, "stop": true },
    { "do": "wait", "note": "V1（窓の計算）", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 0, "rel": "v1", "timeout": 120 },
    { "do": "mark", "note": "V1：中止" },
    { "do": "set", "note": "推力レバーをアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "set", "note": "スピードブレーキのレバーを UP（逆推力なし）", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "value": 1 },
    { "do": "snapshot", "note": "中止の時：速さ・位置", "drefs": ["laminar/B747/gauges/indicators/airspeed_kts_pilot", "sim/flightmodel/position/groundspeed", "sim/flightmodel/position/local_x", "sim/flightmodel/position/local_z"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "中止の 3 秒後：ブレーキ・スピードブレーキ・逆推力", "drefs": ["sim/cockpit2/controls/left_brake_ratio", "sim/cockpit2/controls/right_brake_ratio", "laminar/B747/flt_ctrls/speedbrake_lever", "sim/flightmodel2/wing/speedbrake1_deg[0]", "sim/flightmodel2/engines/thrust_reverser_deploy_ratio[0]"] },
    { "do": "check", "note": "RTO の最大のブレーキ", "dref": "sim/cockpit2/controls/left_brake_ratio", "op": ">", "value": 0.98, "level": "warn" },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 0.5, "timeout": 90 },
    { "do": "mark", "note": "止まった（距離の終わり）" },
    { "do": "snapshot", "note": "距離の終わり：位置", "drefs": ["sim/flightmodel/position/local_x", "sim/flightmodel/position/local_z", "sim/flightmodel/position/latitude", "sim/flightmodel/position/longitude"] },
    { "do": "set", "note": "パーキングブレーキのレバー", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "cmd", "note": "オートブレーキ OFF", "name": "sim/flight_controls/brakes_off_auto" },
    { "do": "set", "note": "スピードブレーキのレバーを DN", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "value": 0 },
    { "do": "record_stop" }
  ]
}
