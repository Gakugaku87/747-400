{
  "name": "s54_pfd_sources",
  "description": "PFD の姿勢・方位・昇降率の源と旗（5-2 段 4a、パネルの変更）の X-Plane での確認、空中。銚子沖の海上 7,000 ft で開始（機体を読み直す）。方位目盛は ND のモードによらずその席の方位で回る（前は ND の上の向き：MAP なら航跡、PLN なら真北。FCOM p.997）。IRS 選択器 C でもそのまま、IRU L を ATT にすると 30 秒の再整列の間 ATT の旗、慣性の昇降率が無いので VERT の旗（推定）、方位は NAV の源の FMC L が NAV の IRU C から出す（FCOM p.1228）、NAV の源を CDU にすると選んだ IRU L（方位を入れていない ATT）で HDG の旗、IRS 選択器を C にして ADC 1 を壊すと昇降率は旗なしで消える（ATA31 p.16）。機長の PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 030", "dref": "laminar/B747/autopilot/heading/degrees", "value": 30 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "方位 030 に近づく（航跡と方位の差が見えるように、風は無いので偏流は小さい）", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [25, 35], "timeout": 90 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/pfd/capt/att", "laminar/B747/pfd/capt/hdg", "laminar/B747/pfd/capt/trk", "laminar/B747/pfd/capt/vsi", "laminar/B747/pfd/capt/vert",
      "laminar/B747/pfd/fo/att", "laminar/B747/pfd/fo/hdg", "laminar/B747/pfd/fo/vsi", "laminar/B747/pfd/fo/vert", "laminar/B747/irs/nav_valid", "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos",
      "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "sim/cockpit2/EFIS/map_mode" ] },
    { "do": "check", "note": "姿勢", "dref": "laminar/B747/pfd/capt/att", "op": "==", "value": 1 },
    { "do": "check", "note": "方位", "dref": "laminar/B747/pfd/capt/hdg", "op": "==", "value": 1 },
    { "do": "check", "note": "航跡", "dref": "laminar/B747/pfd/capt/trk", "op": "==", "value": 1 },
    { "do": "check", "note": "昇降率", "dref": "laminar/B747/pfd/capt/vsi", "op": "==", "value": 1 },
    { "do": "check", "note": "VERT の旗なし", "dref": "laminar/B747/pfd/capt/vert", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士の方位", "dref": "laminar/B747/pfd/fo/hdg", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD と ND", "the": -24, "psi": 9, "fov": 36 },
    { "do": "shot", "name": "pfd_nd_map" },
    { "do": "switch", "note": "機長の ND を PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3,
      "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "shot", "name": "pfd_nd_pln" },
    { "do": "switch", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2,
      "cmd": "laminar/B747/nd/mode/capt/sel_dial_up", "cmd_down": "laminar/B747/nd/mode/capt/sel_dial_dn" },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },

    { "do": "set", "note": "機長の IRS 選択器を C", "dref": "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "IRU C から：姿勢", "dref": "laminar/B747/pfd/capt/att", "op": "==", "value": 1 },
    { "do": "check", "note": "IRU C から：昇降率", "dref": "laminar/B747/pfd/capt/vsi", "op": "==", "value": 1 },
    { "do": "set", "note": "IRS 選択器を L に戻す", "dref": "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos", "value": 0 },

    { "do": "switch", "note": "IRU L を ATT（空中で NAV を離れると、そのフライトの間は NAV に戻れない：FCOM p.1227）", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 3,
      "cmd": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_up", "cmd_down": "laminar/B747/flt_mgmt/iru/mode_sel_dial_L_dn" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "ATT の最初の 30 秒は再整列：ATT の旗", "dref": "laminar/B747/pfd/capt/att", "op": "==", "value": 0 },
    { "do": "check", "note": "慣性の昇降率なし：VERT の旗（推定）", "dref": "laminar/B747/pfd/capt/vert", "op": "==", "value": 1 },
    { "do": "check", "note": "方位は NAV の源の FMC L が NAV の IRU C から（FCOM p.1228）", "dref": "laminar/B747/pfd/capt/hdg", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士は IRU R のまま", "dref": "laminar/B747/pfd/fo/att", "op": "==", "value": 1 },
    { "do": "shot", "name": "pfd_att_vert" },
    { "do": "wait", "note": "30 秒で姿勢が戻る", "dref": "laminar/B747/pfd/capt/att", "op": "==", "value": 1, "timeout": 40 },
    { "do": "set", "note": "機長の NAV を CDU L", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "選んだ IRU L（方位を入れていない ATT）：HDG の旗", "dref": "laminar/B747/pfd/capt/hdg", "op": "==", "value": 0 },
    { "do": "check", "note": "航跡も出ない", "dref": "laminar/B747/pfd/capt/trk", "op": "==", "value": 0 },
    { "do": "shot", "name": "pfd_hdg_flag" },
    { "do": "set", "note": "NAV を FMC L に戻す", "dref": "laminar/B747/flt_inst/nav_src/capt/sel_dial_pos", "value": 0 },
    { "do": "set", "note": "IRS 選択器を C", "dref": "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "IRU C：VERT の旗が消える", "dref": "laminar/B747/pfd/capt/vert", "op": "==", "value": 0 },
    { "do": "set", "note": "X-Plane の ADC 1 の故障", "dref": "sim/operation/failures/rel_adc_comp", "value": 6 },
    { "do": "wait", "note": "機長のエアデータが無効", "dref": "laminar/B747/airdata/valid_capt", "op": "==", "value": 0, "timeout": 10 },
    { "do": "check", "note": "昇降率は消える", "dref": "laminar/B747/pfd/capt/vsi", "op": "==", "value": 0 },
    { "do": "check", "note": "VERT の旗は出さない（ATA31 p.16）", "dref": "laminar/B747/pfd/capt/vert", "op": "==", "value": 0 },
    { "do": "shot", "name": "pfd_adc_fail" },
    { "do": "set", "dref": "sim/operation/failures/rel_adc_comp", "value": 0 },
    { "do": "set", "note": "IRS 選択器を L に戻す", "dref": "laminar/B747/flt_inst/irs_src/capt/sel_dial_pos", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
