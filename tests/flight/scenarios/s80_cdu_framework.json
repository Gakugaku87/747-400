{
  "name": "s80_cdu_framework",
  "description": "CDU の枠組み（6-1 段 2）の X-Plane での確認、空中。銚子沖の海上 7,000 ft・250 kt・北向きで開始（機体を読み直す）。ページはすぐ切り替わる（前は 0.5 秒の空白：CDU-23）。scratchpad のキー：CLR は 1 字、1 秒押し続けると全部、DEL は空のときだけ、+/- は - と + を交互に（FCOM p.1212-1213）。入力の誤りのメッセージはその CDU だけで、出ている間は打鍵を受け付けない（FMSPG p.39）。FMC のメッセージ（RESET MCP ALT の旗を立てる）は 3 台に出て >FMC MESSAGE、どれか 1 台の CLR で全部から消え、条件が続く間は出ない（FCOM p.1429-1430）。出来事のメッセージ（PERF/VNAV UNAVAILABLE）は旗が戻る。NEXT は最後のページから 1 ページ目へ（FMSPG p.42）。CDU の電源を切るとキーが効かず、戻すと MENU（FMSPG p.53）。CDU を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 2133.6, "heading_true": 0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 299, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位 360", "dref": "laminar/B747/autopilot/heading/degrees", "value": 360 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },

    { "do": "mark", "note": "ページの切替と scratchpad のキー（左の CDU：キーは fms1、画面は fms3）" },
    { "do": "cmd", "note": "MENU", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 0.2 },
    { "do": "check", "note": "0.2 秒で MENU（前は 0.5 秒の空白）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "cmd", "note": "F", "name": "laminar/B747/fms1/alphanum_key/F" },
    { "do": "cmd", "note": "L", "name": "laminar/B747/fms1/alphanum_key/L" },
    { "do": "cmd", "note": "3", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "5", "name": "laminar/B747/fms1/alphanum_key/5" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "FL35", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "FL35" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "CLR は最後の 1 字（前は全部）", "dref": "laminar/B747/fms3/Line14_L", "op": "contains", "value": "FL3" },
    { "do": "check", "note": "FL35 ではない", "dref": "laminar/B747/fms3/Line14_L", "op": "!=", "value": "FL35" },
    { "do": "cmd", "note": "CLR を 1.5 秒押し続ける", "name": "laminar/B747/fms1/key/clear", "duration": 1.5 },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "1 秒以上で全部消える", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "" },
    { "do": "cmd", "note": "1", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "note": "+/-", "name": "laminar/B747/fms1/key/minus" },
    { "do": "cmd", "note": "+/-", "name": "laminar/B747/fms1/key/minus" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "+/- の 2 回目は +（前はいつも -）", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "1+" },
    { "do": "cmd", "note": "DEL（データがある）", "name": "laminar/B747/fms1/key/del" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "データがあると DEL は効かない（前は 1 字消した）", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "1+" },
    { "do": "cmd", "note": "CLR を押し続ける", "name": "laminar/B747/fms1/key/clear", "duration": 1.2 },
    { "do": "cmd", "note": "DEL", "name": "laminar/B747/fms1/key/del" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "空のときの DEL は DELETE", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "DELETE" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },

    { "do": "mark", "note": "入力の誤りのメッセージ" },
    { "do": "cmd", "note": "INIT REF", "name": "laminar/B747/fms1/func_key/index" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "note": "PERF（L3）", "name": "laminar/B747/fms1/ls_key/L3" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "note": "A", "name": "laminar/B747/fms1/alphanum_key/A" },
    { "do": "cmd", "note": "CRZ CG へ（R4）", "name": "laminar/B747/fms1/ls_key/R4" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "左の CDU に INVALID ENTRY", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "INVALID ENTRY" },
    { "do": "check", "note": "右の CDU には出ない", "dref": "laminar/B747/fms2/Line14_L", "op": "!=", "value": "INVALID ENTRY" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "shot", "name": "cdu_invalid_entry" },
    { "do": "cmd", "note": "B（メッセージの間）", "name": "laminar/B747/fms1/alphanum_key/B" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "CLR でメッセージが消え、scratchpad の A が戻る（B は入らない）", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "A" },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },

    { "do": "mark", "note": "FMC のメッセージ" },
    { "do": "set", "note": "RESET MCP ALT の旗（laminar/B747/fms/notification[33]）", "dref": "laminar/B747/fms/notification[33]", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "左の CDU に RESET MCP ALT", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "RESET MCP ALT" },
    { "do": "check", "note": "右の CDU にも", "dref": "laminar/B747/fms2/Line14_L", "op": "==", "value": "RESET MCP ALT" },
    { "do": "check", "note": ">FMC MESSAGE", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 1 },
    { "do": "shot", "name": "cdu_fmc_alert" },
    { "do": "cmd", "note": "右の CDU の CLR", "name": "laminar/B747/fms2/key/clear" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "左の CDU からも消える", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "" },
    { "do": "check", "note": ">FMC MESSAGE も消える", "dref": "laminar/B747/CAS/advisory_status[145]", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 11, "note": "前は旗が残ると 10 秒で再び出た" },
    { "do": "check", "note": "条件が続いても再び出ない", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "" },
    { "do": "set", "note": "旗を戻す", "dref": "laminar/B747/fms/notification[33]", "value": 0 },
    { "do": "set", "note": "PERF/VNAV UNAVAILABLE の旗（出来事）", "dref": "laminar/B747/fms/notification[30]", "value": 1 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "PERF/VNAV UNAVAILABLE", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "PERF/VNAV UNAVAILABLE" },
    { "do": "check", "note": "旗は戻る（次も出るように）", "dref": "laminar/B747/fms/notification[30]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "CLR", "name": "laminar/B747/fms1/key/clear" },

    { "do": "mark", "note": "NEXT の循環" },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/fms1/func_key/des" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "note": "NEXT", "name": "laminar/B747/fms1/func_key/next_pg" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "cmd", "note": "NEXT", "name": "laminar/B747/fms1/func_key/next_pg" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "3 ページ目は DES", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "DES" },
    { "do": "cmd", "note": "NEXT", "name": "laminar/B747/fms1/func_key/next_pg" },
    { "do": "sleep", "seconds": 0.3 },
    { "do": "check", "note": "最後のページの NEXT は 1 ページ目の CLB（前は止まった）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "CLB" },

    { "do": "mark", "note": "CDU の電源" },
    { "do": "switch", "note": "STANDBY POWER を OFF（main standby bus：左の CDU の電源）", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 0,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "wait", "note": "左の CDU の電源が切れる", "dref": "laminar/B747/electrical/display_has_power[8]", "op": "==", "value": 0, "timeout": 5 },
    { "do": "cmd", "note": "Z（電源なし）", "name": "laminar/B747/fms1/alphanum_key/Z" },
    { "do": "switch", "note": "STANDBY POWER を AUTO", "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "wait", "note": "電源が戻る", "dref": "laminar/B747/electrical/display_has_power[8]", "op": ">", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "check", "note": "電源の無い間のキーは効かない", "dref": "laminar/B747/fms3/Line14_L", "op": "==", "value": "" },
    { "do": "check", "note": "電源が戻ると MENU（FMSPG p.53）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "MENU" },
    { "do": "shot", "name": "cdu_power_menu" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
