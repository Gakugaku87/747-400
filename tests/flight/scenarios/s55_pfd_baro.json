{
  "name": "s55_pfd_baro",
  "description": "PFD の気圧設定の琥珀の枠（5-2 段 4b、パネルの変更）と CDU の EFIS CONTROL の BARO の X-Plane での確認、空中。銚子沖の海上約 19,000 ft で開始（機体を読み直す）。気圧設定のまま MCP 高度が遷移高度（FMC の既定 18,000 ft）より上で、遷移高度より 300 ft 上にいると、気圧設定が枠で琥珀（FCOM p.995）。STD で消える。MCP 高度を遷移高度より下にし、遷移レベル（既定 FL180）より 300 ft 下へ機体を移すと STD が枠で琥珀。左の CDU の EFIS CONTROL（MENU の EFIS CP SELECT）で BARO SET に 2992 を入れると機長の側だけ 29.92 になり STD が外れる、1013 で hPa、S で STD（FCOM p.1064。前は両席に効いた）。機長の PFD を撮る（撮る間は操縦輪を隠す）。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 5791.2, "heading_true": 0, "speed_in_meters_per_second": 160 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 8, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "set", "note": "MCP 高度は今の高度（ALT HOLD のため）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "set", "note": "MCP 高度 25,000 ft（遷移高度より上。ALT HOLD のまま）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 25000 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "開始の状態", "drefs": [ "laminar/B747/airdata/alt_capt", "laminar/B747/airdata/alt_fo", "laminar/B747/autopilot/heading/altitude_dial_ft",
      "laminar/B747/efis/baro_std/capt/switch_pos", "laminar/B747/efis/baro_std/fo/switch_pos", "laminar/B747/pfd/capt/baro_alert", "laminar/B747/pfd/fo/baro_alert",
      "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_copilot" ] },
    { "do": "check", "note": "気圧設定・MCP 25,000 ft・約 19,000 ft：機長の気圧設定が枠で琥珀", "dref": "laminar/B747/pfd/capt/baro_alert", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士も", "dref": "laminar/B747/pfd/fo/baro_alert", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD", "the": -24, "psi": -1, "fov": 24 },
    { "do": "shot", "name": "pfd_baro_amber" },
    { "do": "cmd", "note": "機長の BARO STD", "name": "laminar/B747/efis/baro_std/capt/switch" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "STD：消える", "dref": "laminar/B747/pfd/capt/baro_alert", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士は気圧設定のまま琥珀", "dref": "laminar/B747/pfd/fo/baro_alert", "op": "==", "value": 1 },
    { "do": "shot", "name": "pfd_std" },
    { "do": "set", "note": "MCP 高度 10,000 ft（遷移高度より下）", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "STD・MCP 10,000 ft・約 19,000 ft（遷移レベルより上）：まだ出ない", "dref": "laminar/B747/pfd/capt/baro_alert", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士（気圧設定・MCP が遷移高度より下）：消える", "dref": "laminar/B747/pfd/fo/baro_alert", "op": "==", "value": 0 },
    { "do": "remember", "dref": "sim/flightmodel/position/local_y", "as": "y0" },
    { "do": "set", "note": "X-Plane の機体を 550 m（約 1,800 ft）下へ（約 17,200 ft：遷移レベルより 300 ft 以上下）", "dref": "sim/flightmodel/position/local_y", "rel": "y0", "value": -550 },
    { "do": "wait", "note": "STD・遷移レベルより 300 ft 下：STD が枠で琥珀", "dref": "laminar/B747/pfd/capt/baro_alert", "op": "==", "value": 1, "timeout": 10 },
    { "do": "snapshot", "drefs": [ "laminar/B747/airdata/alt_capt", "laminar/B747/pfd/capt/baro_alert", "laminar/B747/pfd/fo/baro_alert" ] },
    { "do": "shot", "name": "pfd_std_amber" },

    { "do": "set", "note": "機長の EFIS 操作パネルの故障（CDU の EFIS CONTROL は、そのパネルが故障したときだけ MENU に出る：FCOM p.1060–1061、5-2 段 5c-1 から）", "dref": "laminar/B747/efis/fail[0]", "value": 1 },
    { "do": "cmd", "note": "左の CDU の MENU（コマンドは func_key/fix。index は INIT/REF の索引）", "name": "laminar/B747/fms1/func_key/fix" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "note": "EFIS CP SELECT>", "name": "laminar/B747/fms1/ls_key/R1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/9" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/2" },
    { "do": "cmd", "note": "BARO SET に 2992", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の STD が外れる", "dref": "laminar/B747/efis/baro_std/capt/switch_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "機長の気圧設定 29.92", "dref": "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "op": "between", "value": [29.915, 29.925] },
    { "do": "check", "note": "機長の単位 IN", "dref": "laminar/B747/efis/baro_ref/capt/sel_dial_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "副操縦士は変わらない（前は両席に効いた）", "dref": "laminar/B747/efis/baro_std/fo/switch_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "気圧設定・MCP が遷移高度より下：枠なし", "dref": "laminar/B747/pfd/capt/baro_alert", "op": "==", "value": 0 },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/0" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/1" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/3" },
    { "do": "cmd", "note": "BARO SET に 1013", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の単位 HPA", "dref": "laminar/B747/efis/baro_ref/capt/sel_dial_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "1013 hPa = 29.91 inHg", "dref": "sim/cockpit2/gauges/actuators/barometer_setting_in_hg_pilot", "op": "between", "value": [29.905, 29.92] },
    { "do": "check", "note": "副操縦士の単位は IN のまま", "dref": "laminar/B747/efis/baro_ref/fo/sel_dial_pos", "op": "==", "value": 0 },
    { "do": "shot", "name": "pfd_hpa" },
    { "do": "cmd", "name": "laminar/B747/fms1/alphanum_key/S" },
    { "do": "cmd", "note": "BARO SET に S", "name": "laminar/B747/fms1/ls_key/L1" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長の STD", "dref": "laminar/B747/efis/baro_std/capt/switch_pos", "op": "==", "value": 1 },
    { "do": "check", "note": "副操縦士は STD にならない", "dref": "laminar/B747/efis/baro_std/fo/switch_pos", "op": "==", "value": 0 },
    { "do": "check", "note": "STD の前の値（1013 hPa）を覚えている（FCOM p.1037）", "dref": "laminar/B747/efis/baro/capt/preselect", "op": "between", "value": [29.905, 29.92] },
    { "do": "set", "note": "EFIS 操作パネルの故障を戻す", "dref": "laminar/B747/efis/fail[0]", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
