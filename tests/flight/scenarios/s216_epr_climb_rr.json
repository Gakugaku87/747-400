{
  "name": "s216_epr_climb_rr",
  "description": "RR の EPR の上昇の確認（2026-11-02、利用者の問い）、空中。s214 と同じ（銚子沖の海上 FL240・指示 290 kt・北向きで開始、A/P と A/T、FLCH の CLB 推力で FL320 へ）を、BA のリバリー（RB211-524H2、エンジン型式 2）で。RR は前の作りのコード（B747.42.xt.EEC.RR.lua）のままで、資料が無い。CLB で最大 EPR の線が基準まで上がり、EPR の表示がその線で頭打ちになる作りなので、25,000 ft より上で赤くならないかを見る。EICAS を撮る。Lua の誤りも確かめる",
  "reload": true,
  "livery": "British Airways",
  "flight": {
    "lle_air_start": { "latitude": 35.40, "longitude": 141.30, "elevation_in_meters": 7315.0, "heading_true": 0, "speed_in_meters_per_second": 205.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "check", "note": "RR（BA のリバリー：RB211-524H2）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 2 },
    { "do": "set", "note": "MCP 方位 007", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "set", "note": "MCP 速度 290 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 290 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "ALT HOLD（今の高度で落ち着かせる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "sleep", "seconds": 20 },
    { "do": "set", "note": "MCP 高度 32,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 32000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 32000 },
    { "do": "cmd", "note": "FLCH（A/T は THR REF：CLB 推力）", "name": "laminar/B747/autopilot/button_switch/flch_mode" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMA は FLCH SPD", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 8 },
    { "do": "wait", "note": "26,000 ft の上", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 26000, "timeout": 240 },
    { "do": "sleep", "seconds": 5 },
    { "do": "snapshot", "note": "CLB 推力の上昇、26,000 ft の上", "drefs": [ "laminar/B747/engines/ref_thr_limit_mode", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/EPR/red_on[0]", "laminar/B747/engines/EPR/red_on[1]", "laminar/B747/engines/EPR/red_on[2]", "laminar/B747/engines/EPR/red_on[3]", "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "laminar/B747/gauges/indicators/airspeed_kts_pilot" ] },
    { "do": "check", "note": "EPR の数字は白（エンジン 1）", "dref": "laminar/B747/engines/EPR/red_on[0]", "op": "==", "value": 0, "cite": "FCOM p.834" },
    { "do": "check", "note": "エンジン 2", "dref": "laminar/B747/engines/EPR/red_on[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "エンジン 3", "dref": "laminar/B747/engines/EPR/red_on[2]", "op": "==", "value": 0 },
    { "do": "check", "note": "エンジン 4", "dref": "laminar/B747/engines/EPR/red_on[3]", "op": "==", "value": 0 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_epr_clb_26000_rr" },
    { "do": "watch", "note": "上昇の間ずっと白（エンジン 1）、30,000 ft まで", "dref": "laminar/B747/engines/EPR/red_on[0]", "max": 0, "timeout": 300, "until": { "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "op": ">", "value": 30000 } },
    { "do": "snapshot", "note": "30,000 ft", "drefs": [ "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_EPR_ref[0]", "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/EPR/red_on[0]" ] },
    { "do": "shot", "name": "eicas_epr_clb_30000_rr" },
    { "do": "view", "name": "forward" }
  ]
}
