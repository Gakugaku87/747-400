{
  "name": "s185_vnav_wpts_clb",
  "description": "6-1・6-2 段 12b2（VNAV のページの点）の X-Plane での確認、上昇。s182 と同じ空中の 10,000 ft・約 290 kt（機体を読み直す）、RJAA→RJBB の経路、CRZ ALT FL350 で VNAV の上昇。制限の無い経路では CLB のページの AT XXXXX と ERROR は空白（前は X-Plane の FMS の脚から AT XAC FL001）。LEGS で約 20 NM 先の SULPU へ DIRECT TO にして 30000A を入れると、CLB のページに AT SULPU と /FL300A（FCOM p.1328）、予測が SULPU でその下なので ERROR に xxxLO yyLONG（p.1329）。1 回目（CRZ ALT FL170、XAC に 16500A）と 2 回目（FL350、XAC に 30000A）は、XAC（大島、約 85 NM 先）が予測の T/C の後で上昇の制限でなく、空白だった（正しい）。CDU を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 150 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10, "note": "空中開始の揺れを待つ" },
    { "do": "wait", "note": "FMS の空中の初期化で A/P CMD L", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 30 },
    { "do": "sleep", "seconds": 5, "note": "初期化の残りを待つ" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cmd", "note": "A/T SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB、DIRECT XAC・SPENS・BOKJO", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1", "NEXT", "XAC", "R1", "?SEL", "SPENS", "R2", "?SEL", "BOKJO", "R3", "?SEL"] },
    { "do": "cdu", "note": "ACTIVATE と EXEC", "keys": ["LEGS", "R6", "EXEC"] },
    { "do": "sleep", "seconds": 3 },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "check", "note": "FMC の巡航高度 35,000 ft", "dref": "laminar/B747/autopilot/dist/cruise_alt", "op": "==", "value": 35000 },
    { "do": "set", "note": "MCP 高度 36,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 36000 },
    { "do": "sleep", "seconds": 5, "note": "MCP の高度が中へ写るのを待つ（3 秒）と FMC の VNAV" },
    { "do": "check", "note": "FMC は上昇（1）", "dref": "laminar/B747/fms/vnav/phase", "op": "==", "value": 1 },
    { "do": "cmd", "note": "VNAV", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "wait", "note": "VNAV SPD で engage", "dref": "laminar/B747/autopilot/FMA/active_pitch_mode", "op": "==", "value": 4, "timeout": 10 },
    { "do": "cdu", "note": "VNAV キー：有効な CLB のページ", "keys": ["VNAV"] },
    { "do": "check", "note": "ACT ... CLB", "dref": "laminar/B747/fms3/Line01_L", "op": "matches", "value": "ACT .*CLB" },
    { "do": "cdu", "cdu": "fms2", "note": "右の CDU：MENU、<FMC、LEGS", "keys": ["MENU", "L1", "LEGS"] },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと）" },
    { "do": "check", "note": "経路に制限が無い：AT XXXXX は空白（前は X-Plane の FMS の脚から AT XAC FL001）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ CRZ ALT *$" },
    { "do": "check", "note": "ERROR の見出しも無い", "dref": "laminar/B747/fms3/Line04_S", "op": "matches", "value": "^ ECON SPD *$" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_clb_no_constraint" },
    { "do": "cdu", "note": "LEGS：1L に SULPU（約 20 NM 先：DIRECT TO）、その 1R に /30000A（T/C の前で、上昇がそこまでに届かない高さ）、EXEC（XAC は約 85 NM 先で T/C の後になり、上昇の制限でない：2 回目まで）", "keys": ["LEGS", "SULPU", "L1", "?SEL", "/30000A", "R1", "EXEC"] },
    { "do": "check", "note": "LEGS の 1 行目は SULPU と FL300A（TRANS ALT の上は FL）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "^SULPU .*FL300A" },
    { "do": "sleep", "seconds": 12, "note": "予測（10 秒ごと）" },
    { "do": "cdu", "note": "VNAV キー：CLB のページ", "keys": ["VNAV"] },
    { "do": "check", "note": "AT SULPU（FCOM p.1328）", "dref": "laminar/B747/fms3/Line02_S", "op": "contains", "value": "AT SULPU" },
    { "do": "check", "note": "制限の表示（TRANS ALT の上は FL、右寄せ）", "dref": "laminar/B747/fms3/Line03_L", "op": "matches", "value": "/FL300A$" },
    { "do": "snapshot", "note": "ERROR の行（予測が SULPU で 30,000 ft の下：xxxLO yyLONG、p.1329）", "drefs": [ "laminar/B747/fms3/Line04_S", "laminar/B747/fms3/Line05_L", "sim/cockpit2/gauges/indicators/altitude_ft_pilot" ] },
    { "do": "check", "note": "ERROR の見出し", "dref": "laminar/B747/fms3/Line04_S", "op": "contains", "value": "ERROR" },
    { "do": "check", "note": "ERROR：xxxLO yyLONG", "dref": "laminar/B747/fms3/Line05_L", "op": "matches", "value": "[0-9]+LO [0-9]+LONG" },
    { "do": "shot", "name": "cdu_clb_at_error" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
