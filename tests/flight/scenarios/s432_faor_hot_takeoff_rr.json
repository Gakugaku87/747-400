{
  "name": "s432_faor_hot_takeoff_rr",
  "description": "s430 の暑い日の版（2026-11-25：RR の作り直し、GAP_ANALYSIS.md §8、notes/ATA-70-80.md §40）：FAOR（5,559 ft）で外気温約 30 ℃（海面 48.5 ℃ を書く）、リバリー British Airways（RB211-524H2、エンジン型式 2）、270 t。手順は s430 のまま、レバーを全開の離陸を 100 kt まで見て中止する。暑く高い空港の RR：離陸の定格は RR の離陸 EPR の表（5,559 ft の 30 ℃ で 1.71。s430 の 4 ℃ では 1.766）。表示の N1 は温度で上がり（本家の式：3,600 rpm を 100 %、TCDS は 3,900：N19-ENG-23）、赤線 111.5 % の手前で EEC が抑える（推定）。確かめ：外気温、基準が 4 ℃ のより下、100 kt で表示の N1 が赤線を超えない、EPR が基準の ±0.02（N1 で抑えたら下回る：警告）。",
  "reload": true,
  "livery": "British Airways",
  "flight": {
    "runway_start": { "airport_id": "FAOR", "runway": "03L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "record_start" },
    { "do": "set", "note": "海面 48.5 ℃：FAOR（5,559 ft）で約 30 ℃（2026-11-25 の 2 回目は海面 44 ℃ で、5 分後に 26.6 ℃ で止まった：ISA の +29 ℃ が地上で +22.6 ℃）", "dref": "sim/weather/region/sealevel_temperature_c", "value": 48.5 },
    { "do": "set", "note": "フラップ 20", "dref": "sim/cockpit2/controls/flap_ratio", "value": 0.668 },
    { "do": "set", "note": "MCP 高度 15,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 15000 },
    { "do": "set", "dref": "laminar/B747/autopilot/altitude_dial_ft", "value": 15000 },
    { "do": "cmd", "note": "離陸トリム：代替トリムで機首下げを 5.2 秒（s141 と同じ）", "name": "laminar/B747/flt_ctrls/altn_stab_trim_dn", "duration": 5.2 },
    { "do": "switch", "note": "F/D L OFF", "dref": "laminar/B747/toggle_switch/position[23]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R OFF", "dref": "laminar/B747/toggle_switch/position[24]", "value": 0, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "F/D L ON（T/O）", "dref": "laminar/B747/toggle_switch/position[23]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_L" },
    { "do": "switch", "note": "F/D R ON", "dref": "laminar/B747/toggle_switch/position[24]", "value": 1, "cmd": "laminar/B747/toggle_switch/flight_dir_R" },
    { "do": "sleep", "seconds": 1 },

    { "do": "mark", "note": "CDU：FAOR→VHHH、03L、EXOB1C" },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：FAOR→VHHH、RUNWAY 03L", "keys": ["RTE", "FAOR", "L1", "VHHH", "R1", "03L", "L2"] },
    { "do": "cdu", "note": "DEP ARR（INDEX）、<DEP、2 ページ目の EXOB1C", "keys": ["DEPARR", "L1", "NEXT", "L1"] },
    { "do": "snapshot", "note": "DEPARTURES", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L" ] },
    { "do": "check", "note": "EXOB1C を選んだ", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "EXOB1C" },
    { "do": "cdu", "note": "RTE、ACTIVATE、EXEC", "keys": ["RTE", "R6", "EXEC"] },
    { "do": "check", "note": "ACT RTE 1", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "ACT RTE 1" },
    { "do": "cdu", "note": "LEGS", "keys": ["LEGS"] },
    { "do": "snapshot", "note": "LEGS", "drefs": [ "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line07_L", "laminar/B747/fms3/Line09_L", "laminar/B747/fms3/Line11_L" ] },
    { "do": "check", "note": "最初の点は OR378", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "OR378" },
    { "do": "cdu", "note": "INIT REF、<INDEX、PERF：ZFW 200、CRZ ALT FL350、COST INDEX 100", "keys": ["INITREF", "L6", "L3", "200", "L3", "350", "R1", "100", "L5"] },
    { "do": "cdu", "note": "<INDEX、<TAKEOFF、フラップ 20、V1・VR・V2 を選ぶ", "keys": ["L6", "L5", "20", "L1", "R1", "R2", "R3"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "V speeds と VNAV", "drefs": [ "laminar/B747/airspeed/V1", "laminar/B747/airspeed/Vr", "laminar/B747/airspeed/V2", "laminar/B747/fms/vnav/valid", "laminar/B747/fms/vnav/phase", "sim/flightmodel/weight/m_total" ] },
    { "do": "check", "note": "FMC の VNAV は有効", "dref": "laminar/B747/fms/vnav/valid", "op": "==", "value": 1 },
    { "do": "switch", "note": "A/T ARM", "dref": "laminar/B747/toggle_switch/position[29]", "value": 1, "cmd": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "LNAV（arm）", "name": "laminar/B747/autopilot/button_switch/LNAV" },
    { "do": "cmd", "note": "VNAV（arm）", "name": "laminar/B747/autopilot/button_switch/VNAV" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LNAV の arm", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 2 },
    { "do": "check", "note": "VNAV の arm", "dref": "laminar/B747/autopilot/FMA/armed_pitch_mode", "op": "==", "value": 4 },
    { "do": "set", "note": "パーキング・ブレーキを外す", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 0 },
    { "do": "sleep", "seconds": 3 },

    { "do": "wait", "note": "外気温が 28 ℃ を超える（X-Plane の天気は少しずつ変わる：2026-11-25 の 1 回目は書いて 15 秒後に 4 ℃、75 秒後の 100 kt で 23 ℃）", "dref": "sim/weather/aircraft/temperature_ambient_deg_c", "op": ">", "value": 28, "timeout": 300 },
    { "do": "sleep", "seconds": 20 },
    { "do": "snapshot", "note": "外気温と TO の基準", "drefs": [ "sim/weather/aircraft/temperature_ambient_deg_c", "sim/cockpit2/temperature/outside_air_temp_degc", "sim/flightmodel2/position/pressure_altitude", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR[0]", "laminar/B747/engines/display_N1[0]" ] },
    { "do": "check", "note": "外気温 28〜35 ℃（暑い日：RR の離陸 EPR の表で 1.72〜1.68）", "dref": "sim/weather/aircraft/temperature_ambient_deg_c", "op": "between", "value": [28, 35], "level": "warn" },
    { "do": "mark", "note": "離陸" },
    { "do": "set", "note": "スラスト・レバー 4 本を最前方", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 1 },
    { "do": "check", "note": "RR（BA のリバリー：RB211-524H2）の機体", "dref": "laminar/B747/engines/type", "op": "==", "value": 2 },
    { "do": "wait", "note": "100 kt", "dref": "laminar/B747/gauges/indicators/airspeed_kts_pilot", "op": ">", "value": 100, "timeout": 90 },
    { "do": "snapshot", "note": "100 kt の RR：EPR・基準・N1・N3・推力・スロットル・X-Plane の最大推力", "drefs": [ "laminar/B747/engines/display_EPR[0]", "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "laminar/B747/engines/display_EPR_max[0]", "laminar/B747/engines/display_N1[0]", "laminar/B747/engines/display_N2[0]", "laminar/B747/engines/display_N3[0]", "sim/flightmodel/engine/ENGN_N2_[0]", "sim/cockpit2/engine/indicators/thrust_dry_n[0]", "sim/flightmodel/engine/ENGN_thro_use[0]", "sim/aircraft/engine/acf_tmax", "sim/weather/aircraft/temperature_ambient_deg_c" ] },
    { "do": "remember", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "as": "epr_ref" },
    { "do": "check", "note": "100 kt の EPR が基準の ±0.02（全開のレバー：EEC の最大。N1 の赤線で抑えたら下回る：その時は警告）", "dref": "laminar/B747/engines/display_EPR[0]", "op": "between", "rel": "epr_ref", "value": [-0.02, 0.02], "level": "warn" },
    { "do": "check", "note": "表示の N1 は赤線（111.5 %）を超えない（EEC が抑える：推定）", "dref": "laminar/B747/engines/display_N1[0]", "op": "<", "value": 111.6 },
    { "do": "check", "note": "TO の基準は 4 ℃（s430：1.766）より下（RR の離陸 EPR の表の 30 ℃：1.71）", "dref": "sim/cockpit2/engine/actuators/EPR_target_bug[0]", "op": "<", "value": 1.745 },
    { "do": "set", "note": "離陸を止める：スラスト・レバー 4 本をアイドル", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "set", "note": "パーキング・ブレーキ", "dref": "laminar/B747/flt_ctrls/parking_brake_ratio", "value": 1 },
    { "do": "wait", "note": "止まる", "dref": "sim/flightmodel/position/groundspeed", "op": "<", "value": 3, "timeout": 90 },
    { "do": "record_stop" }
  ]
}
