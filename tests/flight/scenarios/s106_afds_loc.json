{
  "name": "s106_afds_loc",
  "description": "AFDS の作り直し 6-3 段 2b（LOC の捕捉と追従）の X-Plane での確認、空中。RJAA 34L の進入路の G/S のアンテナから 22 NM・2.5 NM 右、3,000 ft・200 kt・磁方位 307（コース 337 へ 30° で入る）で開始（機体を読み直す）。A/P CMD L・ALT HOLD・HDG SEL 307。ILS を同調して LOC を arm。捕捉はビームの中心より前（ATA22 p.290：対地速度・進入角・偏位）、MCP の方位はコースに、行き過ぎは 0.5 ドットまで、90 秒で 0.2 ドット以内・翼水平。右からの横風 20 kt でも 0.3 ドット以内。NAV1・NAV2 を局の無い周波数にして信号を失っても LOC のまま、慣性の経路でコースの向きを保つ（ATA22 p.358）。同調し直して 0.3 ドット以内。PFD と ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.450071, "longitude": 140.659103, "elevation_in_meters": 914.4, "heading_true": 299.6, "speed_in_meters_per_second": 107.0 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ、FMC の航法データ" },
    { "do": "set", "note": "MCP 高度 3,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 3000 },
    { "do": "set", "note": "MCP 方位 307（コース 337 の 30° 左：右から入る）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 307 },
    { "do": "set", "note": "MCP 速度 200 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 200 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "cdu", "note": "NAV RAD、111.90/337 を ILS の行（L4）へ", "keys": ["NAVRAD", "111.90/337", "L4"] },
    { "do": "sleep", "seconds": 5, "note": "受信機が落ち着く" },

    { "do": "mark", "note": "30° で入る LOC の捕捉（ATA22 p.290、p.358）" },
    { "do": "check", "note": "LOC の信号（NAV1）", "dref": "sim/cockpit2/radios/indicators/nav1_display_horizontal", "op": "==", "value": 1 },
    { "do": "check", "note": "ビームの右（ドットは負）", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "op": "<", "value": -0.5 },
    { "do": "cmd", "note": "LOC", "name": "laminar/B747/autopilot/button_switch/loc_mode" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "LOC は arm", "dref": "laminar/B747/autopilot/FMA/armed_roll_mode", "op": "==", "value": 3 },
    { "do": "wait", "note": "LOC を捕まえる（FMA のロール 3）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3, "timeout": 180 },
    { "do": "snapshot", "note": "捕捉", "drefs": [ "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "sim/cockpit2/radios/indicators/nav1_dme_distance_nm", "sim/flightmodel/position/groundspeed", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot", "laminar/B747/autopilot/roll_cmd" ] },
    { "do": "check", "note": "ビームの中心より前で捕まえる", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "op": "between", "value": [-2.5, -0.2] },
    { "do": "check", "note": "MCP の方位はコース 337", "dref": "laminar/B747/autopilot/heading/degrees", "op": "==", "value": 337 },
    { "do": "check", "note": "LOC の則（X-Plane の HDG SEL ではない）", "dref": "laminar/B747/autopilot/roll_law", "op": "==", "value": 1 },
    { "do": "watch", "note": "行き過ぎ（左、ドットは正）は 0.5 ドットまで（90 秒）", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "max": 0.5, "timeout": 90 },
    { "do": "check", "note": "LOC に乗る（0.2 ドット以内）", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "op": "between", "value": [-0.2, 0.2] },
    { "do": "check", "note": "航跡はコース（±3°）", "dref": "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "op": "between", "value": [334, 340] },
    { "do": "check", "note": "翼はほぼ水平（±5°）", "dref": "sim/cockpit2/gauges/indicators/roll_AHARS_deg_pilot", "op": "between", "value": [-5, 5] },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD と ND：LOC", "the": -22, "psi": 4, "fov": 40 },
    { "do": "shot", "name": "pfd_nd_loc" },

    { "do": "mark", "note": "右からの横風 20 kt" },
    { "do": "set", "note": "X-Plane の天気をすぐ変える", "dref": "sim/weather/region/update_immediately", "value": 1 },
    { "do": "set", "note": "風向 060（真方位：コースの右から）（層 0）", "dref": "sim/weather/region/wind_direction_degt[0]", "value": 60 },
    { "do": "set", "note": "風速 20 kt", "dref": "sim/weather/region/wind_speed_msc[0]", "value": 10.3 },
    { "do": "set", "note": "層 1", "dref": "sim/weather/region/wind_direction_degt[1]", "value": 60 },
    { "do": "set", "dref": "sim/weather/region/wind_speed_msc[1]", "value": 10.3 },
    { "do": "set", "note": "層 2", "dref": "sim/weather/region/wind_direction_degt[2]", "value": 60 },
    { "do": "set", "dref": "sim/weather/region/wind_speed_msc[2]", "value": 10.3 },
    { "do": "set", "note": "層 3", "dref": "sim/weather/region/wind_direction_degt[3]", "value": 60 },
    { "do": "set", "dref": "sim/weather/region/wind_speed_msc[3]", "value": 10.3 },
    { "do": "set", "note": "層 4", "dref": "sim/weather/region/wind_direction_degt[4]", "value": 60 },
    { "do": "set", "dref": "sim/weather/region/wind_speed_msc[4]", "value": 10.3 },
    { "do": "watch", "note": "横風でも 0.3 ドット以内（60 秒）", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "abs": true, "max": 0.3, "timeout": 60 },
    { "do": "check", "note": "航跡はコース（±2°）", "dref": "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "op": "between", "value": [335, 339] },
    { "do": "check", "note": "機首は風上（右）へ", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "op": "between", "value": [338, 348] },

    { "do": "mark", "note": "信号を失う：慣性の経路（ATA22 p.358）" },
    { "do": "set", "note": "NAV1 を局の無い 108.10 に", "dref": "sim/cockpit/radios/nav1_freq_hz", "value": 10810 },
    { "do": "set", "note": "NAV2 も", "dref": "sim/cockpit/radios/nav2_freq_hz", "value": 10810 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "LOC の信号が無い", "dref": "sim/cockpit2/radios/indicators/nav1_display_horizontal", "op": "==", "value": 0 },
    { "do": "check", "note": "LOC のまま", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 3 },
    { "do": "watch", "note": "航跡はコースのまま（20 秒、±2°）", "dref": "sim/cockpit2/gauges/indicators/ground_track_mag_pilot", "min": 335, "max": 339, "timeout": 20 },
    { "do": "set", "note": "NAV1 を 111.90 に戻す（CDU の ILS は 111.90/337 のままなので、CDU で同じ値を入れても同調し直さない）", "dref": "sim/cockpit/radios/nav1_freq_hz", "value": 11190 },
    { "do": "set", "note": "NAV2 も", "dref": "sim/cockpit/radios/nav2_freq_hz", "value": 11190 },
    { "do": "sleep", "seconds": 8 },
    { "do": "check", "note": "LOC の信号", "dref": "sim/cockpit2/radios/indicators/nav1_display_horizontal", "op": "==", "value": 1 },
    { "do": "check", "note": "まだ 0.3 ドット以内", "dref": "sim/cockpit2/radios/indicators/nav1_hdef_dots_pilot", "op": "between", "value": [-0.3, 0.3] },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
