{
  "name": "s72_hdg_ref",
  "description": "HDG REF（5-2 段 5d）の X-Plane での確認、空中。フランクフルトの南 10,000 ft・250 kt・真方位 090 で開始、HDG SEL。NORM では PFD・ND の方位は磁方位で MAG。TRUE にすると方位・航跡が真方位（磁気偏差 約 4°E の分）、PFD・ND に枠つきの TRU、AFDS は HDG SEL から HDG HOLD（FCOM p.1046）。TRU で HDG SEL：X-Plane の方位のモードは MCP の方位を磁方位に直した値。V/S −1,500 fpm で 2,000 ft 降りると ND の TRU の枠が琥珀で 10 秒点滅し、その後は琥珀（FCOM p.1110）。NORM に戻すと MAG に 10 秒の枠（FCOM p.1142）、HDG SEL ならまた HDG HOLD。PFD・ND を撮る。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 49.600000, "longitude": 8.545000, "elevation_in_meters": 3048.0, "heading_true": 90.0, "speed_in_meters_per_second": 128.6 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 12.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 5, "note": "空中開始の揺れ" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/altitude_ft_pilot", "as": "alt0" },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg0" },
    { "do": "set", "note": "MCP 高度は今の高度", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 0, "rel": "alt0", "round": 100 },
    { "do": "set", "note": "MCP 方位は今の方位", "dref": "laminar/B747/autopilot/heading/degrees", "value": 0, "rel": "hdg0", "round": 1 },
    { "do": "remember", "dref": "laminar/B747/autopilot/heading/degrees", "as": "mcp" },
    { "do": "set", "note": "MCP 速度 250 kt", "dref": "laminar/B747/autopilot/ias_dial_value", "value": 250 },
    { "do": "cmd", "note": "A/T ARM", "name": "laminar/B747/authrottle_arm" },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボ", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "cmd", "note": "SPD", "name": "laminar/B747/autopilot/button_switch/speed_mode" },
    { "do": "wait", "note": "HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "NORM：基準は磁北", "dref": "laminar/B747/efis/hdg_ref/true", "op": "==", "value": 0 },
    { "do": "check", "note": "ND は MAG", "dref": "laminar/B747/efis/hdg_ref/nd_label", "op": "==", "value": 0 },
    { "do": "check", "note": "PFD も MAG", "dref": "laminar/B747/efis/hdg_ref/pfd_label", "op": "==", "value": 0 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg1" },
    { "do": "check", "note": "機長の表示の方位は磁方位", "dref": "laminar/B747/pfd/capt/hdg_deg", "op": "between", "value": [-0.5, 0.5], "rel": "hdg1" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "機長の PFD と ND", "the": -22, "psi": 4, "fov": 40 },
    { "do": "shot", "name": "hdg_ref_mag" },
    { "do": "cmd", "note": "HDG REF を TRUE", "name": "laminar/B747/toggle_switch/heading_ref" },
    { "do": "wait", "note": "基準は真北", "dref": "laminar/B747/efis/hdg_ref/true", "op": "==", "value": 1, "timeout": 5 },
    { "do": "remember", "dref": "sim/cockpit2/gauges/indicators/heading_AHARS_deg_mag_pilot", "as": "hdg2" },
    { "do": "check", "note": "表示の方位は真方位（偏差 約 4°E の分だけ大きい）", "dref": "laminar/B747/pfd/capt/hdg_deg", "op": "between", "value": [3, 5], "rel": "hdg2" },
    { "do": "check", "note": "ND は白枠の TRU", "dref": "laminar/B747/efis/hdg_ref/nd_label", "op": "==", "value": 1 },
    { "do": "check", "note": "PFD は枠つきの TRU（FCOM p.998）", "dref": "laminar/B747/efis/hdg_ref/pfd_label", "op": "==", "value": 1 },
    { "do": "wait", "note": "HDG SEL で切り替えたので HDG HOLD（FCOM p.1046）", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7, "timeout": 5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "hdg_ref_tru" },
    { "do": "cmd", "note": "TRU で HDG SEL", "name": "laminar/B747/autopilot/button_switch/heading_select" },
    { "do": "wait", "note": "HDG SEL", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 6, "timeout": 10 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "X-Plane の方位のモードは MCP の方位（真方位）を磁方位に直した値", "dref": "sim/cockpit/autopilot/heading_mag", "op": "between", "value": [-5, -3], "rel": "mcp" },
    { "do": "set", "note": "MCP 高度を 3,000 ft 下に", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": -3000, "rel": "alt0", "round": 100 },
    { "do": "cmd", "note": "V/S", "name": "laminar/B747/autopilot/button_switch/vs_mode" },
    { "do": "sleep", "seconds": 0.5 },
    { "do": "set", "note": "V/S −1,500 fpm", "dref": "sim/cockpit2/autopilot/vvi_dial_fpm", "value": -1500 },
    { "do": "set", "dref": "laminar/B747/cockpit2/autopilot/vvi_dial_fpm", "value": -1500 },
    { "do": "wait", "note": "2,000 ft 降りると TRU の枠が琥珀で点滅（FCOM p.1110）", "dref": "laminar/B747/efis/hdg_ref/nd_label", "op": "in", "value": [2, 3], "timeout": 150 },
    { "do": "shot", "name": "hdg_ref_amber" },
    { "do": "sleep", "seconds": 11 },
    { "do": "check", "note": "10 秒の後は琥珀のまま", "dref": "laminar/B747/efis/hdg_ref/nd_label", "op": "==", "value": 2 },
    { "do": "cmd", "note": "ALT HOLD（降下をやめる）", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "cmd", "note": "HDG REF を NORM に戻す", "name": "laminar/B747/toggle_switch/heading_ref" },
    { "do": "wait", "note": "基準は磁北", "dref": "laminar/B747/efis/hdg_ref/true", "op": "==", "value": 0, "timeout": 5 },
    { "do": "check", "note": "MAG に 10 秒の枠（FCOM p.1142）", "dref": "laminar/B747/efis/hdg_ref/nd_label", "op": "==", "value": 4 },
    { "do": "wait", "note": "HDG SEL で切り替えたので HDG HOLD", "dref": "laminar/B747/autopilot/FMA/active_roll_mode", "op": "==", "value": 7, "timeout": 5 },
    { "do": "shot", "name": "hdg_ref_mag_box" },
    { "do": "sleep", "seconds": 11 },
    { "do": "check", "note": "10 秒の後は MAG だけ", "dref": "laminar/B747/efis/hdg_ref/nd_label", "op": "==", "value": 0 },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
