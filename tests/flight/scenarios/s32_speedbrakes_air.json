{
  "name": "s32_speedbrakes_air",
  "description": "飛行中のスピードブレーキ（4-1 段 3）の X-Plane での確認。10,000 ft の空中開始で A/P（ALT HOLD）にし、A/T を切って推力レバーをアイドルに。レバーを flight detent まで（空中は止まる）出しても、10,000 ft・フラップ UP・アイドルなら >SPEEDBRAKES EXT は出ない。推力レバー 2 本を speedbrake power level（resolver 40°、レバー角約 5.1°：ATA27 p.740）より前に出すと出る。1 本では出ない。飛行中に手で出したスピードブレーキは、推力レバー 1・3 を進めても DN に戻らない（アクチュエータは格納のまま）。推力レバー 2 本を上昇推力（上昇定格のレバー角 35°）より前にすると、貨物機（405・570、`laminar/B747/freighter` = 1）では空中の CONFIG SPOILERS（FCOM p.1558）、109 では出ない。",
  "reload": true,
  "flight": {
    "lle_air_start": { "latitude": 35.95, "longitude": 140.25, "elevation_in_meters": 3048, "heading_true": 340, "speed_in_meters_per_second": 130 },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 20, "note": "空中開始の揺れが収まるのを待つ" },
    { "do": "set", "note": "MCP 高度 10,000 ft", "dref": "laminar/B747/autopilot/heading/altitude_dial_ft", "value": 10000 },
    { "do": "cmd", "note": "A/P CMD L", "name": "laminar/B747/autopilot/button_switch/cmd_L" },
    { "do": "wait", "note": "A/P のサーボが入る", "dref": "laminar/B747/autopilot/servos_on", "op": "==", "value": 1, "timeout": 10 },
    { "do": "cmd", "note": "ALT HOLD", "name": "laminar/B747/autopilot/button_switch/alt_hold_mode" },
    { "do": "snapshot", "note": "開始", "drefs": [ "sim/aircraft/view/acf_relative_path", "sim/cockpit2/gauges/indicators/radio_altimeter_height_ft_pilot",
      "laminar/B747/gauges/indicators/airspeed_kts_pilot", "laminar/B747/flt_ctrls/speedbrake_stop", "laminar/B747/gear/air_ground/pri_gnd", "laminar/B747/freighter" ] },
    { "do": "cmd", "note": "A/T ARM スイッチを OFF（空中開始では A/T が SPD で働き、推力レバーを動かす）", "name": "laminar/B747/authrottle_disarm" },
    { "do": "set", "note": "推力レバーをアイドルへ（X-Plane の推力の入力。プラグインのレバーがこれに従う）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0 },
    { "do": "wait", "note": "推力レバー 1 がアイドル", "dref": "laminar/B747/engine/throttle[0]", "op": "<", "value": 0.02, "timeout": 10 },
    { "do": "wait", "note": "推力レバー 3 がアイドル", "dref": "laminar/B747/engine/throttle[2]", "op": "<", "value": 0.02, "timeout": 5 },

    { "do": "mark", "note": "flight detent" },
    { "do": "cmd", "note": "レバーを 1 段（DN → ARM）", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "空中なので ARM のまま（自動では出ない）", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": "between", "value": [0.12, 0.13] },
    { "do": "check", "note": "SPEEDBRAKE ARMED", "dref": "laminar/B747/CAS/memo_status[45]", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の比は 0（-0.5 にしない）", "dref": "sim/cockpit2/controls/speedbrake_ratio", "op": "==", "value": 0 },
    { "do": "cmd", "note": "レバーをもう 1 段（ARM → flight detent）", "name": "sim/flight_controls/speed_brakes_down_one" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "flight detent", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": "between", "value": [0.52, 0.54] },
    { "do": "check", "note": "10,000 ft・フラップ UP・アイドル：>SPEEDBRAKES EXT は出ない", "dref": "laminar/B747/CAS/caution_status[59]", "op": "==", "value": 0 },

    { "do": "mark", "note": "推力レバー" },
    { "do": "set", "note": "推力レバー 1 を進める", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[0]", "value": 0.3 },
    { "do": "wait", "note": "推力レバー 1 が speedbrake power level（0.1）より前", "dref": "laminar/B747/engine/throttle[0]", "op": ">", "value": 0.2, "timeout": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "1 本では出ない", "dref": "laminar/B747/CAS/caution_status[59]", "op": "==", "value": 0 },
    { "do": "check", "note": "飛行中に手で出したスピードブレーキは推力レバー 1 でも DN に戻らない", "dref": "laminar/B747/flt_ctrls/speedbrake_lever", "op": "between", "value": [0.52, 0.54] },
    { "do": "set", "note": "推力レバー 3 も進める", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[2]", "value": 0.3 },
    { "do": "wait", "note": "推力レバー 3 も前", "dref": "laminar/B747/engine/throttle[2]", "op": ">", "value": 0.2, "timeout": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "2 本が speedbrake power level より前：>SPEEDBRAKES EXT（FCOM p.958）", "dref": "laminar/B747/CAS/caution_status[59]", "op": "==", "value": 1 },
    { "do": "cas", "note": ">SPEEDBRAKES EXT" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_speedbrakes_ext" },
    { "do": "view", "name": "forward" },

    { "do": "mark", "note": "上昇推力" },
    { "do": "set", "note": "推力レバー 1 を上昇推力より前へ", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[0]", "value": 0.8 },
    { "do": "set", "note": "推力レバー 3 も", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[2]", "value": 0.8 },
    { "do": "wait", "note": "推力レバー 1 が上昇定格の角度（35°、0.7）より前", "dref": "laminar/B747/engine/throttle[0]", "op": ">", "value": 0.72, "timeout": 8 },
    { "do": "wait", "note": "推力レバー 3 も", "dref": "laminar/B747/engine/throttle[2]", "op": ">", "value": 0.72, "timeout": 5 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "109（貨物機でない）：空中の CONFIG SPOILERS は無い", "dref": "laminar/B747/CAS/warning_status[6]", "op": "==", "value": 0 },
    { "do": "set", "note": "貨物機（405・570）にする", "dref": "laminar/B747/freighter", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "405・570：2 本が上昇推力でスピードブレーキが ARM より後ろ、空中の CONFIG SPOILERS（FCOM p.1558）", "dref": "laminar/B747/CAS/warning_status[6]", "op": "==", "value": 1 },
    { "do": "cas", "note": "CONFIG SPOILERS" },
    { "do": "set", "note": "推力レバー 3 を戻す（上昇推力より前は 1 本）", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[2]", "value": 0.3 },
    { "do": "wait", "note": "推力レバー 3 が上昇推力より後ろ", "dref": "laminar/B747/engine/throttle[2]", "op": "<", "value": 0.68, "timeout": 6 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "3 本が上昇推力より後ろで消える", "dref": "laminar/B747/CAS/warning_status[6]", "op": "==", "value": 0 },
    { "do": "set", "note": "貨物機のフラグを戻す", "dref": "laminar/B747/freighter", "value": 0 },
    { "do": "set", "note": "推力レバー 1 も戻す", "dref": "sim/cockpit2/engine/actuators/throttle_ratio[0]", "value": 0.3 },
    { "do": "sleep", "seconds": 2 },
    { "do": "cmd", "note": "レバーを DN", "name": "sim/flight_controls/speed_brakes_up_all" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "DN で消える", "dref": "laminar/B747/CAS/caution_status[59]", "op": "==", "value": 0 },
    { "do": "set", "note": "推力レバーを 0.6 に", "dref": "sim/cockpit2/engine/actuators/throttle_ratio_all", "value": 0.6 },
    { "do": "sleep", "seconds": 2 }
  ]
}
