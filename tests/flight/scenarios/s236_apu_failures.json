{
  "name": "s236_apu_failures",
  "description": "APU の故障の入力（2026-11-04、故障の窓のため：notes/ATA-49.md §11、APU-06）の X-Plane での確認、地上。成田 34L でエンジン運転中に開始し、APU を始動する。限界の超過で即停止し APU（FCOM p.897、p.902）、selector OFF で fault が戻る（FCOM p.867）。抽気ダクトの漏れでは、START にしても始動せず APU が出たまま（FCOM p.613）、漏れが直って OFF にすると戻る",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始", "drefs": [
      "laminar/B747/electrical/apu/sel_dial_pos", "sim/cockpit2/electrical/APU_N1_percent", "laminar/B747/electrical/bus/bat_apu" ] },
    { "do": "cmd", "note": "APU selector ON", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "cmd", "note": "APU selector START（ばねで ON に戻る）", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "wait", "note": "APU N1 95 % 以上", "dref": "sim/cockpit2/electrical/APU_N1_percent", "op": ">=", "value": 95, "timeout": 150 },
    { "do": "wait", "note": "APU RUNNING memo", "dref": "laminar/B747/CAS/memo_status[1]", "op": "==", "value": 1, "timeout": 10 },

    { "do": "mark", "note": "限界の超過" },
    { "do": "set", "note": "APU の限界の超過", "dref": "laminar/B747/apu/fail/limit", "value": 1 },
    { "do": "wait", "note": "即停止：APU（FCOM p.897、p.902）", "dref": "laminar/B747/CAS/advisory_status[13]", "op": "==", "value": 1, "timeout": 3, "cite": "FCOM p.902" },
    { "do": "check", "note": "X-Plane の APU は止める指令", "dref": "sim/cockpit2/electrical/APU_starter_switch", "op": "==", "value": 0 },
    { "do": "cas", "note": "限界の超過" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/apu/fail/limit", "value": 0 },
    { "do": "wait", "note": "APU が回り終わる", "dref": "sim/cockpit2/electrical/APU_N1_percent", "op": "<", "value": 5, "timeout": 90 },
    { "do": "cmd", "note": "APU selector OFF（fault を戻す：FCOM p.867）", "name": "laminar/B747/electrical/apu/sel_dial_dn", "duration": 0.2 },
    { "do": "wait", "note": "APU が消える", "dref": "laminar/B747/CAS/advisory_status[13]", "op": "==", "value": 0, "timeout": 3 },

    { "do": "mark", "note": "抽気ダクトの漏れ" },
    { "do": "set", "note": "APU の抽気ダクトの漏れ", "dref": "laminar/B747/apu/fail/duct_leak", "value": 1 },
    { "do": "cmd", "note": "APU selector ON", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "cmd", "note": "APU selector START", "name": "laminar/B747/electrical/apu/sel_dial_up", "duration": 0.2 },
    { "do": "sleep", "seconds": 20 },
    { "do": "check", "note": "始動しない（FCOM p.613：再始動できない）", "dref": "sim/cockpit2/electrical/APU_starter_switch", "op": "==", "value": 0, "cite": "FCOM p.613" },
    { "do": "check", "note": "APU が出る（selector ON）", "dref": "laminar/B747/CAS/advisory_status[13]", "op": "==", "value": 1 },
    { "do": "check", "note": "吸気ドアは閉じたまま", "dref": "laminar/B747/electrical/apu_inlet_door", "op": "<", "value": 0.05 },
    { "do": "cas", "note": "抽気ダクトの漏れ" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "上の EICAS", "the": -22, "psi": 29, "fov": 30 },
    { "do": "shot", "name": "eicas_apu" },
    { "do": "set", "note": "故障を消す", "dref": "laminar/B747/apu/fail/duct_leak", "value": 0 },
    { "do": "cmd", "note": "APU selector OFF", "name": "laminar/B747/electrical/apu/sel_dial_dn", "duration": 0.2 },
    { "do": "wait", "note": "APU が消える", "dref": "laminar/B747/CAS/advisory_status[13]", "op": "==", "value": 0, "timeout": 3 },
    { "do": "cas", "note": "終わり" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
