{
  "name": "s22_fire_engine_apu",
  "description": "火災防護（3-4 段 1）の X-Plane での確認、地上。エンジン運転中の RJAA 34L で開始し、ボトルが満充填で何も出ていないこと。FIRE/OVHT TEST を押し続けて >TEST IN PROG と全部の火災灯、5 秒で >FIRE TEST PASS、離すと消えること（FCOM p.919）。X-Plane のエンジン 2 の火災で FIRE ENG 2 と消火スイッチの灯、火災が無ければロックされている消火スイッチ 3 が引けないこと（FCOM p.905）、スイッチ 2 を引いて A に回すとボトル L A が X-Plane の消火器で火を消し、BTL DISCH と >BTL LO L ENG A が出ること（FCOM p.905、p.916、ATA26_28 p.78）。失敗の dataref でナセル 3 の過熱（OVHT ENG 3 NAC）と、エンジン 4 の両ループ故障（>DET FIRE/OHT 4）。X-Plane の APU 火災で FIRE APU、APU の停止の指令、地上で 10 秒後に APU ボトルが自動で放出して X-Plane の火が消え、APU BTL DISCH と >BOTTLE LOW APU が出ること（FCOM p.907、p.914、ATA26_28 p.124、p.130）。期待値は notes/ATA-26.md。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 8 },
    { "do": "snapshot", "note": "開始", "drefs": [
      "sim/aircraft/view/acf_relative_path", "laminar/B747/fire/engine01_02A/ext_bottle/psi", "laminar/B747/fire/apu/ext_bottle/psi",
      "laminar/B747/electrical/bus/bat_apu", "laminar/B747/electrical/bus/hot_bat_main", "laminar/B747/annunciators/engine_fires[0]",
      "laminar/B747/fire/engine02/ext_switch/pos_arm", "sim/cockpit2/electrical/APU_N1_percent", "laminar/B747/gear/air_ground/pri_gnd" ] },
    { "do": "cas", "note": "開始" },
    { "do": "check", "note": "ボトル L A は 600 psi（ATA26_28 p.60）", "dref": "laminar/B747/fire/engine01_02A/ext_bottle/psi", "op": "==", "value": 600 },
    { "do": "check", "note": "APU ボトルは 600 psi", "dref": "laminar/B747/fire/apu/ext_bottle/psi", "op": "==", "value": 600 },
    { "do": "check", "note": "FIRE ENG 2 なし", "dref": "laminar/B747/CAS/warning_status[12]", "op": "==", "value": 0 },
    { "do": "check", "note": "消火スイッチ 2 の灯なし", "dref": "laminar/B747/annunciators/engine_fires[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "BTL DISCH L A なし", "dref": "laminar/B747/annunciator/brightness_ratio[113]", "op": "==", "value": 0 },

    { "do": "mark", "note": "FIRE/OVHT TEST" },
    { "do": "set", "note": "FIRE/OVHT TEST を押し続ける", "dref": "laminar/B747/fire/fire_ovht/button_pos", "value": 1 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": ">TEST IN PROG（FCOM p.919）", "dref": "laminar/B747/CAS/warning_status[24]", "op": "==", "value": 1 },
    { "do": "check", "note": "消火スイッチ 1 の灯", "dref": "laminar/B747/annunciators/engine_fires[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "消火スイッチ 4 の灯", "dref": "laminar/B747/annunciators/engine_fires[3]", "op": "==", "value": 1 },
    { "do": "check", "note": "APU の火災灯", "dref": "laminar/B747/annunciators/engine_fires[4]", "op": "==", "value": 1 },
    { "do": "check", "note": "試験では FIRE ENG のメッセージは出ない", "dref": "laminar/B747/CAS/warning_status[11]", "op": "==", "value": 0 },
    { "do": "check", "note": "試験では APU を止めない（ATA26_28 p.94）", "dref": "laminar/B747/fire/apu_shutdown", "op": "==", "value": 0 },
    { "do": "check", "note": "master WARNING", "dref": "laminar/B747/warning/master_warning", "op": "==", "value": 1, "level": "warn" },
    { "do": "cas", "note": "試験中" },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "5 秒で >FIRE TEST PASS（FCOM p.919）", "dref": "laminar/B747/CAS/warning_status[20]", "op": "==", "value": 1 },
    { "do": "check", "note": ">TEST IN PROG は消える", "dref": "laminar/B747/CAS/warning_status[24]", "op": "==", "value": 0 },
    { "do": "check", "note": ">FIRE TEST FAIL は出ない", "dref": "laminar/B747/CAS/warning_status[19]", "op": "==", "value": 0 },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_fire_test_pass" },
    { "do": "set", "note": "FIRE/OVHT TEST を離す", "dref": "laminar/B747/fire/fire_ovht/button_pos", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "離すと >FIRE TEST PASS が消える", "dref": "laminar/B747/CAS/warning_status[20]", "op": "==", "value": 0 },
    { "do": "check", "note": "消火スイッチの灯が消える", "dref": "laminar/B747/annunciators/engine_fires[0]", "op": "==", "value": 0 },

    { "do": "mark", "note": "エンジン 2 の火災" },
    { "do": "cmd", "note": "火災が無く RUN の消火スイッチ 3 を引く", "name": "laminar/B747/fire/engine03/ext_switch_arm", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ロックされていて入ったまま（FCOM p.905）", "dref": "laminar/B747/fire/engine03/ext_switch/pos_arm", "op": "<", "value": 0.1 },
    { "do": "set", "note": "X-Plane のエンジン 2 の火災", "dref": "sim/operation/failures/rel_engfir1", "value": 6 },
    { "do": "wait", "note": "FIRE ENG 2（FCOM p.921）", "dref": "laminar/B747/CAS/warning_status[12]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "消火スイッチ 2 の灯（FCOM p.905）", "dref": "laminar/B747/annunciators/engine_fires[1]", "op": "==", "value": 1 },
    { "do": "check", "note": "火災ベルの要求（警報のモデル）", "dref": "laminar/B747/warning/warning_bell", "op": "==", "value": 1, "level": "warn" },
    { "do": "cas", "note": "エンジン 2 の火災" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_fire_eng_2" },
    { "do": "cmd", "note": "消火スイッチ 2 を引く", "name": "laminar/B747/fire/engine02/ext_switch_arm", "duration": 0.2 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "消火スイッチ 2 が出ている", "dref": "laminar/B747/fire/engine02/ext_switch/pos_arm", "op": ">", "value": 0.9 },
    { "do": "check", "note": "発電機 2 がトリップ：GCB 2 が開（FCOM p.905、LH24 p.108）", "dref": "laminar/B747/electrical/breaker/gcb[1]", "op": "==", "value": 0 },
    { "do": "cmd", "note": "消火スイッチ 2 を A に回す（時計回り）", "name": "laminar/B747/fire/engine02/ext_switch_A", "duration": 0.2 },
    { "do": "wait", "note": "X-Plane の火が消える（ボトル L A：FCOM p.916）", "dref": "sim/operation/failures/rel_engfir1", "op": "==", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "X-Plane のエンジン 2 の火災なし", "dref": "sim/flightmodel2/engines/is_on_fire[1]", "op": "==", "value": 0 },
    { "do": "check", "note": "FIRE ENG 2 が消える", "dref": "laminar/B747/CAS/warning_status[12]", "op": "==", "value": 0 },
    { "do": "check", "note": "ボトル L A は空", "dref": "laminar/B747/fire/engine01_02A/ext_bottle/psi", "op": "==", "value": 0 },
    { "do": "check", "note": "ボトル L B は満充填のまま", "dref": "laminar/B747/fire/engine01_02B/ext_bottle/psi", "op": "==", "value": 600 },
    { "do": "check", "note": "BTL DISCH L A の灯（FCOM p.905）", "dref": "laminar/B747/annunciator/brightness_ratio[113]", "op": ">", "value": 0 },
    { "do": "check", "note": ">BTL LO L ENG A（ATA26_28 p.78）", "dref": "laminar/B747/CAS/advisory_status[47]", "op": "==", "value": 1 },
    { "do": "check", "note": "X-Plane の消火器は放出が終わって 0", "dref": "sim/cockpit2/engine/actuators/fire_extinguisher_on[1]", "op": "==", "value": 0 },
    { "do": "cas", "note": "消火の後" },

    { "do": "mark", "note": "過熱とループ故障" },
    { "do": "set", "note": "ナセル 3 の過熱", "dref": "laminar/B747/fire/fail/eng_ovht[2]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "OVHT ENG 3 NAC（FCOM p.922）", "dref": "laminar/B747/CAS/caution_status[81]", "op": "==", "value": 1 },
    { "do": "check", "note": "過熱では消火スイッチの灯は点かない", "dref": "laminar/B747/annunciators/engine_fires[2]", "op": "==", "value": 0 },
    { "do": "cas", "note": "過熱" },
    { "do": "set", "note": "過熱を戻す", "dref": "laminar/B747/fire/fail/eng_ovht[2]", "value": 0 },
    { "do": "set", "note": "エンジン 4 の火災ループ A の故障", "dref": "laminar/B747/fire/fail/loop_a[3]", "value": 1 },
    { "do": "set", "note": "エンジン 4 の火災ループ B の故障", "dref": "laminar/B747/fire/fail/loop_b[3]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": ">DET FIRE/OHT 4（FCOM p.921）", "dref": "laminar/B747/CAS/advisory_status[62]", "op": "==", "value": 1 },
    { "do": "check", "note": "OVHT ENG 3 NAC は消える", "dref": "laminar/B747/CAS/caution_status[81]", "op": "==", "value": 0 },
    { "do": "set", "note": "ループを戻す", "dref": "laminar/B747/fire/fail/loop_a[3]", "value": 0 },
    { "do": "set", "note": "ループを戻す", "dref": "laminar/B747/fire/fail/loop_b[3]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": ">DET FIRE/OHT 4 が消える", "dref": "laminar/B747/CAS/advisory_status[62]", "op": "==", "value": 0 },

    { "do": "mark", "note": "APU の火災" },
    { "do": "set", "note": "X-Plane の APU 火災", "dref": "sim/operation/failures/rel_apu_fire", "value": 6 },
    { "do": "wait", "note": "FIRE APU（FCOM p.921）", "dref": "laminar/B747/CAS/warning_status[8]", "op": "==", "value": 1, "timeout": 5 },
    { "do": "check", "note": "APU の火災灯", "dref": "laminar/B747/annunciators/engine_fires[4]", "op": "==", "value": 1 },
    { "do": "check", "note": "APU の停止の指令（FCOM p.907）", "dref": "laminar/B747/fire/apu_shutdown", "op": "==", "value": 1 },
    { "do": "check", "note": "地上：APU 火災のホーン（FCOM p.913）", "dref": "laminar/B747/fire/apu_horn", "op": "==", "value": 1 },
    { "do": "wait", "note": "地上で 10 秒後に APU ボトルが自動で放出し X-Plane の火が消える（ATA26_28 p.124）", "dref": "sim/operation/failures/rel_apu_fire", "op": "==", "value": 0, "timeout": 15 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "APU ボトルは空", "dref": "laminar/B747/fire/apu/ext_bottle/psi", "op": "==", "value": 0 },
    { "do": "check", "note": "APU BTL DISCH の灯（FCOM p.907）", "dref": "laminar/B747/annunciator/brightness_ratio[117]", "op": ">", "value": 0 },
    { "do": "check", "note": ">BOTTLE LOW APU（ATA26_28 p.130）", "dref": "laminar/B747/CAS/advisory_status[44]", "op": "==", "value": 1 },
    { "do": "check", "note": "FIRE APU が消える", "dref": "laminar/B747/CAS/warning_status[8]", "op": "==", "value": 0 },
    { "do": "cas", "note": "APU 火災の後" },
    { "do": "view", "name": "eicas" },
    { "do": "shot", "name": "eicas_after_fires" },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
