{
  "name": "s218_simbrief_fetch",
  "description": "SimBrief の最新の OFP を Pilot ID で取る（notes/ATA-34-61-FMC.md §131、2026-11-02 の利用者の依頼）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始める（機体を読み直す）。SIM CONFIG 2 ページの 5L に利用者の Pilot ID 262051 を CDU で入れ、FMC DATALINK を ON（P&W）。FMC COMM 2/2 の RTE REQUEST <SEND で、FMS ブリッジ（b747_fms_bridge）が SimBrief から最新の OFP とその X-Plane の飛行計画を取って simbrief に <出発地><目的地>.xml・.fms で置き（2026-11-02 の利用者の最新は RJFF→PANC）、FMC がそれでアップリンク（ROUTE 1 UPLINK READY）。RTE 1 の LOAD で出発地と目的地を確かめる。CDU を撮る。最後に FMC DATALINK を AUTO に戻し、取ったファイルを消す（Pilot ID は残す）。インターネットに繋がっていること。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 300, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "sleep", "seconds": 10 },
    { "do": "check", "note": "FMS ブリッジがいる", "dref": "laminar/B747/fms/xp/bridge", "op": "==", "value": 1 },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "cdu", "note": "MENU、<FMC（IDENT）", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "MENU、6R の SIM CONFIG、NEXT、4L で FMC DATALINK を ON", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "FMC DATALINK は ON", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK         ON" },
    { "do": "check", "note": "5L の見出し SIMBRIEF PILOT ID", "dref": "laminar/B747/fms3/Line10_S", "op": "contains", "value": "SIMBRIEF PILOT ID" },
    { "do": "cdu", "note": "Pilot ID 262051 を 5L に", "keys": ["2", "6", "2", "0", "5", "1", "L5"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "ブリッジの dataref に入った", "dref": "laminar/B747/options/simbrief_id", "op": "==", "value": 262051 },
    { "do": "check", "note": "5L に 262051", "dref": "laminar/B747/fms3/Line11_L", "op": "contains", "value": "262051" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 24, "fov": 18 },
    { "do": "shot", "name": "cdu_sim_config_2" },
    { "do": "remember", "dref": "laminar/B747/fms/company/simbrief_fetch", "as": "req" },
    { "do": "cdu", "note": "FMC COMM、NEXT（2/2）、RTE REQUEST <SEND", "keys": ["FMCCOMM", "NEXT", "L1"] },
    { "do": "check", "note": "SENDING", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "SENDING" },
    { "do": "check", "note": "取る要求の番号が 1 つ増える", "dref": "laminar/B747/fms/company/simbrief_fetch", "op": "==", "value": 1, "rel": "req" },
    { "do": "wait", "note": "ブリッジが取り終える（SimBrief の OFP と飛行計画）", "dref": "laminar/B747/fms/company/simbrief_done", "op": "==", "value": 1, "rel": "req", "timeout": 60 },
    { "do": "check", "note": "取れた（2）", "dref": "laminar/B747/fms/company/simbrief_status", "op": "==", "value": 2 },
    { "do": "check", "note": "最新の .fms は取ったもの（<出発地><目的地>.fms）", "dref": "laminar/B747/fms/company/fms_file", "op": "matches", "value": "RJFFPANC[.]fms" },
    { "do": "check", "note": "最新の .xml も", "dref": "laminar/B747/fms/company/ofp_file", "op": "matches", "value": "RJFFPANC[.]xml" },
    { "do": "wait", "note": "約 20 秒後にアップリンク：RTE REQUEST は空白に（FMSPG p.382）", "dref": "laminar/B747/fms3/Line02_S", "op": "matches", "value": "^ +CO ROUTE$", "timeout": 45 },
    { "do": "shot", "name": "cdu_fmc_comm_uplink" },
    { "do": "cdu", "note": "PREV（1/2）、<RTE 1", "keys": ["PREV", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "cdu_rte_uplink" },
    { "do": "cdu", "note": "<LOAD（ROUTE UPLINK）", "keys": ["L4"] },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "出発地 RJFF と目的地 PANC", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "RJFF                PANC" },
    { "do": "shot", "name": "cdu_rte_loaded" },
    { "do": "cdu", "note": "MENU、6R、NEXT、4L を 2 回で FMC DATALINK を AUTO に戻す（保存しない）", "keys": ["MENU", "R6", "NEXT", "L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "cdu", "keys": ["L4"] },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AUTO に戻る", "dref": "laminar/B747/fms3/Line09_L", "op": "contains", "value": "FMC DATALINK       AUTO" },
    { "do": "remove", "note": "取ったファイルを消す（Pilot ID は残す）", "path": "simbrief/RJFFPANC.fms" },
    { "do": "remove", "path": "simbrief/RJFFPANC.xml" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" }
  ]
}
