{
  "name": "s250_user_report_nd",
  "description": "利用者の報告（2026-11-05、別の PC のラインフライト）の X-Plane での確認。成田 34L でエンジン運転中。(1) MCP の方位を航跡の右 80° にすると、拡大の ND の選択方位のバグと破線は出ない（目盛から外れる：前は機長のバグが F/O の ND に出た）、右 30° なら出る。F/O の ND を撮る。(2) 経路の無い地上で DEP ARR：DEP/ARR INDEX の題と空港コードの桁（FCOM p.1299：題は 7 桁目、空港は 10 桁目）。(3) IRS を OFF から ALIGN にしてアライン中（位置なし）：MAP では MAP の旗、PLN では旗なし（前は PLN の真ん中に MAP の旗が残った）。ND の PLN を撮る。Lua の誤りも確かめる",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "set", "note": "機長の ND を MAP", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "F/O の ND を MAP", "dref": "laminar/B747/nd/mode/fo/sel_dial_pos", "value": 2 },
    { "do": "set", "note": "MAP CTR を外す（機長）", "dref": "laminar/B747/nd/map_center/capt", "value": 0 },
    { "do": "set", "note": "MAP CTR を外す（F/O）", "dref": "laminar/B747/nd/map_center/fo", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "snapshot", "note": "向き", "drefs": [ "laminar/B747/nd/up/capt", "laminar/B747/nd/up/fo", "laminar/B747/autopilot/heading/degrees" ] },

    { "do": "mark", "note": "(1) 選択方位のバグ" },
    { "do": "set", "note": "MCP の方位 060（航跡 337 の右 83°）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 60 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "機長：目盛の外、バグなし", "dref": "laminar/B747/nd/capt/hdg_bug", "op": "==", "value": 0 },
    { "do": "check", "note": "破線もなし", "dref": "laminar/B747/nd/capt/hdg_line", "op": "==", "value": 0 },
    { "do": "check", "note": "F/O もバグなし", "dref": "laminar/B747/nd/fo/hdg_bug", "op": "==", "value": 0 },
    { "do": "view", "note": "機長席から F/O の ND", "the": -22, "psi": 42, "fov": 22 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "fo_nd_hdg_right_83" },
    { "do": "set", "note": "MCP の方位 007（右 30°）", "dref": "laminar/B747/autopilot/heading/degrees", "value": 7 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "目盛の内：機長のバグ", "dref": "laminar/B747/nd/capt/hdg_bug", "op": "==", "value": 1 },
    { "do": "check", "note": "F/O のバグ", "dref": "laminar/B747/nd/fo/hdg_bug", "op": "==", "value": 1 },
    { "do": "shot", "name": "fo_nd_hdg_right_30" },
    { "do": "set", "note": "MCP の方位を戻す", "dref": "laminar/B747/autopilot/heading/degrees", "value": 337 },

    { "do": "mark", "note": "(2) DEP/ARR INDEX" },
    { "do": "cdu", "note": "MENU、<FMC", "keys": ["MENU", "L1"] },
    { "do": "wait", "note": "航法データを読み終える", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "AIRAC", "timeout": 120 },
    { "do": "cdu", "note": "RTE：RJAA→RJBB（ACTIVATE しない）", "keys": ["RTE", "RJAA", "L1", "RJBB", "R1"] },
    { "do": "cdu", "note": "DEP ARR（有効な経路なし：INDEX）", "keys": ["DEPARR"] },
    { "do": "snapshot", "note": "INDEX", "drefs": [ "laminar/B747/fms3/Line01_L", "laminar/B747/fms3/Line03_L", "laminar/B747/fms3/Line05_L", "laminar/B747/fms3/Line02_S" ] },
    { "do": "check", "note": "題は 7 桁目から（FCOM p.1299）", "dref": "laminar/B747/fms3/Line01_L", "op": "contains", "value": "      DEP/ARR INDEX" },
    { "do": "check", "note": "出発空港は 10 桁目から", "dref": "laminar/B747/fms3/Line03_L", "op": "contains", "value": "<DEP     RJAA" },
    { "do": "check", "note": "到着空港も 10 桁目から", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "         RJBB" },
    { "do": "view", "note": "左の CDU", "the": -34, "psi": 22, "fov": 16 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "cdu_deparr_index" },

    { "do": "mark", "note": "(3) アライン中の ND の MAP の旗" },
    { "do": "set", "note": "IRS L を OFF", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 0 },
    { "do": "set", "note": "IRS C を OFF", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 0 },
    { "do": "set", "note": "IRS R を OFF", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[2]", "value": 0 },
    { "do": "sleep", "seconds": 3 },
    { "do": "set", "note": "IRS L を ALIGN", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 1 },
    { "do": "set", "note": "IRS C を ALIGN", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 1 },
    { "do": "set", "note": "IRS R を ALIGN", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[2]", "value": 1 },
    { "do": "sleep", "seconds": 3 },
    { "do": "check", "note": "MAP：位置なしで MAP の旗", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 1 },
    { "do": "set", "note": "機長の ND を PLN", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 3 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "PLN：位置が無くても旗なし（ATA31 p.34）", "dref": "laminar/B747/nd/capt/map_flag", "op": "==", "value": 0 },
    { "do": "check", "note": "PLN：航跡の枠が無いので TRK の旗もなし（FCOM p.1142、p.1027）", "dref": "laminar/B747/nd/capt/trk_flag", "op": "==", "value": 0 },
    { "do": "view", "note": "機長の ND", "the": -24, "psi": 9, "fov": 24 },
    { "do": "sleep", "seconds": 1 },
    { "do": "shot", "name": "capt_nd_pln_aligning" },
    { "do": "set", "note": "IRS L を NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[0]", "value": 2 },
    { "do": "set", "note": "IRS C を NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[1]", "value": 2 },
    { "do": "set", "note": "IRS R を NAV", "dref": "laminar/B747/flt_mgmt/iru/mode_sel_dial_pos[2]", "value": 2 },
    { "do": "cmd", "note": "すぐにアライン（試験の近道）", "name": "laminar/B747/irs/align_now" },
    { "do": "sleep", "seconds": 2 },
    { "do": "set", "note": "機長の ND を MAP に戻す", "dref": "laminar/B747/nd/mode/capt/sel_dial_pos", "value": 2 },
    { "do": "record_stop" }
  ]
}
