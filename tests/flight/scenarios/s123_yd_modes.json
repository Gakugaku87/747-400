{
  "name": "s123_yd_modes",
  "description": "6-3 段 6a（ヨーダンパーのモード、engage と INOP）の X-Plane での確認、地上。RJAA 34L でエンジン運転中に始め（機体を読み直す）、IRS が NAV になると上下の YDM が地上の待機（ground operation：engage、指令なし）。UPPER を OFF にすると off で INOP と >YAW DAMPER UPR、ON に戻すと電源投入の試験で 5 秒 INOP、その後 engage（ATA22 p.83–85；FCOM p.931、p.958）。LOWER の故障（`flt_ctrls/fail/yaw_damper[1]`）で fault INOP、2 秒で戻すと自動復帰（5 秒未満の故障：p.84）、7 秒続けると戻しても INOP のまま、スイッチを入れ直すと試験の後に engage。頭上パネルを撮る。",
  "reload": true,
  "flight": {
    "runway_start": { "airport_id": "RJAA", "runway": "34L" },
    "engine_status": { "all_engines": { "running": true } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10, "note": "IRS の初期化（NAV）と YDM の電源投入" },
    { "do": "mark", "note": "地上の待機：両方 engage、INOP なし" },
    { "do": "check", "note": "UPPER のスイッチ ON", "dref": "laminar/B747/button_switch/position[82]", "op": ">", "value": 0.95 },
    { "do": "check", "note": "LOWER のスイッチ ON", "dref": "laminar/B747/button_switch/position[83]", "op": ">", "value": 0.95 },
    { "do": "check", "note": "UPPER は地上の待機（2）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "LOWER も", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 2 },
    { "do": "check", "note": "UPPER engage（INOP 灯なし）", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 1 },
    { "do": "check", "note": "LOWER engage", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 1 },
    { "do": "check", "note": ">YAW DAMPER UPR なし", "dref": "laminar/B747/CAS/advisory_status[301]", "op": "==", "value": 0 },
    { "do": "check", "note": ">YAW DAMPER LWR なし", "dref": "laminar/B747/CAS/advisory_status[300]", "op": "==", "value": 0 },
    { "do": "check", "note": "地上は指令なし（上の舵の YD の指令）", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr", "op": "==", "value": 0 },

    { "do": "mark", "note": "UPPER OFF：off、INOP" },
    { "do": "switch", "note": "YAW DAMPER UPPER OFF", "dref": "laminar/B747/button_switch/position[82]", "value": 0, "cmd": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "off（0）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "INOP", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 0 },
    { "do": "check", "note": ">YAW DAMPER UPR（FCOM p.958）", "dref": "laminar/B747/CAS/advisory_status[301]", "op": "==", "value": 1 },
    { "do": "check", "note": "LOWER は engage のまま", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 1 },
    { "do": "view", "name": "overhead" },
    { "do": "shot", "name": "overhead_yd_upr_off" },

    { "do": "mark", "note": "UPPER ON：電源投入の試験 5 秒（INOP）、その後 engage（ATA22 p.83）" },
    { "do": "switch", "note": "YAW DAMPER UPPER ON", "dref": "laminar/B747/button_switch/position[82]", "value": 1, "cmd": "laminar/B747/button_switch/yaw_damper_upr" },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "試験（1）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "試験の間は INOP", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 0 },
    { "do": "sleep", "seconds": 4 },
    { "do": "check", "note": "地上の待機（2）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[0]", "op": "==", "value": 2 },
    { "do": "check", "note": "engage", "dref": "laminar/B747/flt_ctrls/yaw_damper_upr_on", "op": "==", "value": 1 },
    { "do": "check", "note": ">YAW DAMPER UPR が消える", "dref": "laminar/B747/CAS/advisory_status[301]", "op": "==", "value": 0 },

    { "do": "mark", "note": "LOWER の 2 秒の故障：自動復帰（ATA22 p.84）" },
    { "do": "set", "note": "LOWER の故障", "dref": "laminar/B747/flt_ctrls/fail/yaw_damper[1]", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "fault INOP（6）", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 6 },
    { "do": "check", "note": "INOP", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 0 },
    { "do": "check", "note": ">YAW DAMPER LWR", "dref": "laminar/B747/CAS/advisory_status[300]", "op": "==", "value": 1 },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/yaw_damper[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "自動復帰で地上の待機", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 2 },
    { "do": "check", "note": "engage", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 1 },

    { "do": "mark", "note": "LOWER の 7 秒の故障：戻しても INOP、スイッチの入れ直しで戻る" },
    { "do": "set", "note": "LOWER の故障", "dref": "laminar/B747/flt_ctrls/fail/yaw_damper[1]", "value": 1 },
    { "do": "sleep", "seconds": 7 },
    { "do": "set", "note": "故障を戻す", "dref": "laminar/B747/flt_ctrls/fail/yaw_damper[1]", "value": 0 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "fault INOP のまま", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 6 },
    { "do": "check", "note": "INOP", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 0 },
    { "do": "switch", "note": "YAW DAMPER LOWER OFF", "dref": "laminar/B747/button_switch/position[83]", "value": 0, "cmd": "laminar/B747/button_switch/yaw_damper_lwr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "switch", "note": "YAW DAMPER LOWER ON", "dref": "laminar/B747/button_switch/position[83]", "value": 1, "cmd": "laminar/B747/button_switch/yaw_damper_lwr" },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "電源投入の試験", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 5 },
    { "do": "check", "note": "地上の待機", "dref": "laminar/B747/flt_ctrls/yaw_damper_mode[1]", "op": "==", "value": 2 },
    { "do": "check", "note": "engage", "dref": "laminar/B747/flt_ctrls/yaw_damper_lwr_on", "op": "==", "value": 1 },
    { "do": "check", "note": ">YAW DAMPER LWR が消える", "dref": "laminar/B747/CAS/advisory_status[300]", "op": "==", "value": 0 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
