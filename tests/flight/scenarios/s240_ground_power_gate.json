{
  "name": "s240_ground_power_gate",
  "description": "CDU の GROUND SERVICES から地上電源（GPU）をつなぐ（2026-11-04 利用者の依頼「アドオンを使わずに GPU を接続できるようにして」：notes/ATA-24.md §12、ELEC-17）。s239 と同じことを成田の T1 Gate 11（エンジン停止）で、X-Plane が電源車を呼べる場所として。電池と STANDBY POWER を入れて、CDU の MENU → GND HANDLING → GROUND SERVICES の L2（<GROUND POWER）を押す。X-Plane が電源車を呼べる場所なら X-Plane 自身の電源車が来て、呼べない場所なら電源車なしで、EXT PWR 1・2 AVAIL になる。先に輪止めがかかる。EXT PWR 1・2 を入れて AC バスに電気が来る。L2（<DISCONNECT GROUND POWER）で外す。CDU と外の写真を撮る",
  "reload": true,
  "flight": {
    "ramp_start": { "airport_id": "RJAA", "ramp": "T1 Gate 11" },
    "engine_status": { "all_engines": { "running": false } },
    "local_time": { "day_of_year": 295, "time_in_24_hours": 10.0 },
    "weather": {
      "definition": "vfr_few_clouds",
      "vertical_speed_in_thermal_in_feet_per_minute": 0,
      "wave_height_in_meters": 0.5,
      "wave_direction_in_degrees": 0,
      "terrain_state": "dry",
      "variation_across_region_percentage": 0,
      "evolution_over_time_enum": "static"
    }
  },
  "steps": [
    { "do": "record_start" },
    { "do": "sleep", "seconds": 10 },
    { "do": "switch", "note": "BATTERY ON", "dref": "laminar/B747/button_switch/position[13]", "value": 1, "cmd": "laminar/B747/button_switch/elec_battery" },
    { "do": "switch", "note": "STANDBY POWER AUTO",
      "dref": "laminar/B747/electrical/standby_power/sel_dial_pos", "value": 1,
      "cmd": "laminar/B747/electrical/standby_power/sel_dial_up", "cmd_down": "laminar/B747/electrical/standby_power/sel_dial_dn" },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "電源車を呼ぶ前", "drefs": [
      "sim/cockpit2/electrical/GPU_can_be_called_for", "sim/cockpit2/electrical/GPU_generator_on", "sim/cockpit2/electrical/GPU_generator_volts",
      "laminar/B747/gear/chocked", "laminar/B747/electrical/ext_pwr1_avail", "laminar/B747/gear/air_ground/pri_air",
      "sim/flightmodel/position/groundspeed" ] },
    { "do": "check", "note": "EXT PWR はまだ無い", "dref": "laminar/B747/electrical/ext_pwr1_avail", "op": "==", "value": 0 },
    { "do": "cdu", "note": "MENU → GND HANDLING → GROUND SERVICES", "keys": ["MENU", "R4", "L1"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L2 は <GROUND POWER（前は XP12 で空欄）", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<GROUND POWER" },
    { "do": "cdu", "note": "L2：地上電源を呼ぶ", "keys": ["L2"] },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "先に輪止め", "dref": "laminar/B747/gear/chocked", "op": "==", "value": 1 },
    { "do": "snapshot", "note": "呼んだ直後（X-Plane の電源車なら requested）", "drefs": [
      "laminar/B747/electrical/ext_pwr_requested", "laminar/B747/electrical/ext_pwr1_avail", "laminar/B747/fms3/Line05_L",
      "sim/cockpit2/electrical/GPU_generator_on", "sim/cockpit2/electrical/GPU_generator_volts" ] },
    { "do": "check", "note": "ゲートでは X-Plane が電源車を呼べる", "dref": "sim/cockpit2/electrical/GPU_can_be_called_for", "op": "==", "value": 1 },
    { "do": "check", "note": "電源車を待つ間は requested", "dref": "laminar/B747/electrical/ext_pwr_requested", "op": "==", "value": 1 },
    { "do": "check", "note": "L2 は <CANCEL GROUND POWER", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<CANCEL GROUND POWER" },
    { "do": "wait", "note": "EXT PWR 1 AVAIL（X-Plane の電源車が着いてから）", "dref": "laminar/B747/electrical/ext_pwr1_avail", "op": "==", "value": 1, "timeout": 300 },
    { "do": "check", "note": "X-Plane の電源車の電圧（つながっている）", "dref": "sim/cockpit2/electrical/GPU_generator_volts", "op": ">=", "value": 24 },
    { "do": "check", "note": "EXT PWR 2 AVAIL", "dref": "laminar/B747/electrical/ext_pwr2_avail", "op": "==", "value": 1 },
    { "do": "sleep", "seconds": 1 },
    { "do": "check", "note": "L2 は <DISCONNECT GROUND POWER", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<DISCONNECT GROUND POWER" },
    { "do": "set", "note": "操縦輪を隠す（撮影のため）", "dref": "sim/graphics/view/hide_yoke", "value": 0 },
    { "do": "view", "note": "下の EICAS と CDU", "the": -31, "psi": 33, "fov": 30 },
    { "do": "shot", "name": "cdu_ground_power" },
    { "do": "cmd", "note": "外から見る（周回のビュー）", "name": "sim/view/circle" },
    { "do": "sleep", "seconds": 3 },
    { "do": "shot", "name": "exterior_ground_power" },
    { "do": "cmd", "note": "操縦席に戻る", "name": "sim/view/3d_cockpit_cmnd_look" },

    { "do": "mark", "note": "EXT PWR を入れる" },
    { "do": "cmd", "note": "EXT PWR 1 を押す", "name": "laminar/B747/button_switch/elec_ext_pwr_1", "duration": 0.3 },
    { "do": "cmd", "note": "EXT PWR 2 を押す", "name": "laminar/B747/button_switch/elec_ext_pwr_2", "duration": 0.3 },
    { "do": "sleep", "seconds": 3 },
    { "do": "snapshot", "note": "EXT PWR を入れた後", "drefs": [
      "laminar/B747/electrical/ext_pwr1_on", "laminar/B747/electrical/ext_pwr2_on", "laminar/B747/electrical/bus/ac[0]",
      "laminar/B747/electrical/bus/ac[3]", "sim/cockpit/electrical/gpu_on" ] },
    { "do": "check", "note": "AC bus 1 に電気", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 1 },
    { "do": "check", "note": "AC bus 4 に電気", "dref": "laminar/B747/electrical/bus/ac[3]", "op": "==", "value": 1 },
    { "do": "cas", "note": "地上電源" },

    { "do": "mark", "note": "外す" },
    { "do": "cdu", "note": "L2：地上電源を外す", "keys": ["L2"] },
    { "do": "wait", "note": "EXT PWR AVAIL が消える", "dref": "laminar/B747/electrical/ext_pwr1_avail", "op": "==", "value": 0, "timeout": 5 },
    { "do": "sleep", "seconds": 2 },
    { "do": "check", "note": "AC bus 1 は電気なし（APU も無い）", "dref": "laminar/B747/electrical/bus/ac[0]", "op": "==", "value": 0 },
    { "do": "check", "note": "L2 は <GROUND POWER に戻る", "dref": "laminar/B747/fms3/Line05_L", "op": "contains", "value": "<GROUND POWER" },
    { "do": "set", "note": "操縦輪を戻す", "dref": "sim/graphics/view/hide_yoke", "value": 1 },
    { "do": "view", "name": "forward" },
    { "do": "record_stop" }
  ]
}
